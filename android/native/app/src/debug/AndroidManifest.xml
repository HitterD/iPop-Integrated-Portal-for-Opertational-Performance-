<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only QA entry point: simulate pushes without FCM (see README "Debug QA").
     Not present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugPushReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="id.co.santos.ipop.debug.PUSH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
