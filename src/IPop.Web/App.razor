@inject AuthState Auth
@inject NavigationManager Nav

@* Guard runs before the page renders: OnNavigateAsync is awaited by the Router.
   Restore happens once — after that the in-memory token answers. *@
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="Guard">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private bool restored;

    private static readonly string[] AuthPages = ["", "login", "forgot-password", "reset-password"];
    /// Open to everyone, signed in or not, and never redirected (the /app install landing).
    private static readonly string[] PublicPages = ["app"];
    public static bool IsPublic(string path) => PublicPages.Contains(path.Trim('/').ToLowerInvariant());

    private async Task Guard(NavigationContext ctx)
    {
        if (!restored)
        {
            restored = true;
            await Auth.TryRestoreAsync();
        }

        var path = ctx.Path.Trim('/').ToLowerInvariant();
        if (IsPublic(path)) return;
        var isAuthPage = AuthPages.Contains(path);

        if (!Auth.IsAuthenticated)
        {
            if (!isAuthPage) Nav.NavigateTo("/login", replace: true);
            return;
        }

        // Signed in but still on the default password: only /set-password is reachable.
        if (Auth.MustChangePassword)
        {
            if (path != "set-password") Nav.NavigateTo("/set-password", replace: true);
            return;
        }

        if (isAuthPage || path == "set-password") Nav.NavigateTo("/directory", replace: true);
    }
}
