@inject AuthState Auth
@inject NavigationManager Nav

@* Guard runs before the page renders: OnNavigateAsync is awaited by the Router.
   Restore happens once — after that the in-memory token answers. *@
<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)" OnNavigateAsync="Guard">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    private bool restored;

    private static readonly string[] AuthPages = ["", "login", "forgot-password", "reset-password"];
    /// Open to everyone, signed in or not, and never redirected (the /app install landing).
    private static readonly string[] PublicPages = ["app"];
    public static bool IsPublic(string path) => PublicPages.Contains(path.Trim('/').ToLowerInvariant());

    /// Only same-site paths ("/sso/authorize?…"), never "//host" or "https://…", so a crafted link can't send a
    /// freshly signed-in user to another site.
    public static string? SafeReturn(string? url) =>
        url is { Length: > 1 } u && u[0] == '/' && u[1] != '/' && u[1] != '\\' && !u.Contains("://") ? u : null;

    private async Task Guard(NavigationContext ctx)
    {
        if (!restored)
        {
            restored = true;
            await Auth.TryRestoreAsync();
        }

        // NavigationContext.Path can carry the query string ("login?returnUrl=…"); match on the path alone.
        var rawPath = ctx.Path.Split('?', 2)[0];
        var path = rawPath.Trim('/').ToLowerInvariant();
        if (IsPublic(path)) return;
        var isAuthPage = AuthPages.Contains(path);

        if (!Auth.IsAuthenticated)
        {
            // "Sign in with iPop" and the iPop Notifier connect card come back to their page after the login (local
            // paths only, see SafeReturn).
            if (!isAuthPage) Nav.NavigateTo(path.StartsWith("sso/") || path == "notifier/connect" ? "/login?returnUrl=" + Uri.EscapeDataString("/" + rawPath.TrimStart('/') + new Uri(Nav.Uri).Query) : "/login", replace: true);
            return;
        }

        // Signed in but still on the default password: only /set-password is reachable.
        if (Auth.MustChangePassword)
        {
            if (path != "set-password") Nav.NavigateTo("/set-password", replace: true);
            return;
        }

        // Home after sign-in is the Dashboard (fast, an overview of everything); the iPhone Home Screen app opens at "/".
        if (isAuthPage || path == "set-password") Nav.NavigateTo("/dashboard", replace: true);
    }
}
