@implements IDisposable
@inject SessionLockState Lock
@inject IJSRuntime JS

@if (Lock.Mode != SessionLockMode.None)
{
    <div class="session-lock" role="alertdialog" aria-modal="true" aria-labelledby="session-lock-title">
        <div class="session-lock-card">
            @if (Lock.Mode == SessionLockMode.Locked)
            {
                <div class="session-lock-ic"><i data-lucide="app-window"></i></div>
                <h2 id="session-lock-title">iPop is open in another tab</h2>
                <p>iPop can only be active in one browser tab. Click <strong>Use here</strong> to use iPop in this tab.</p>
                @if (Lock.EndedCallElsewhere) { <p class="session-lock-note">The call in this tab was ended.</p> }
                <div class="session-lock-actions">
                    <button type="button" class="ui-button ui-button-ghost" @onclick="Lock.CloseTabAsync">Close tab</button>
                    <button type="button" class="ui-button ui-button-primary" disabled="@Lock.IsWorking" @onclick="Lock.UseHereAsync">Use here</button>
                </div>
            }
            else
            {
                <div class="session-lock-ic call"><i data-lucide="phone-call"></i></div>
                <h2 id="session-lock-title">A call is active in another tab</h2>
                <p>iPop in another tab is in a call or meeting. If you use it here instead, that call will end.</p>
                <div class="session-lock-actions">
                    <button type="button" class="ui-button ui-button-ghost" @onclick="Lock.CloseTabAsync">Close tab</button>
                    <button type="button" class="ui-button ui-button-primary danger" disabled="@Lock.IsWorking" @onclick="Lock.ForceHereAsync">Use here anyway</button>
                </div>
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Lock.Changed += OnChanged;
    protected override void OnAfterRender(bool firstRender)
    {
        if (Lock.Mode != SessionLockMode.None) _ = JS.InvokeVoidAsync("ipop.icons").AsTask().ContinueWith(_ => { });
    }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Lock.Changed -= OnChanged;
}
