@implements IDisposable
@inject OverlayStack Overlays

@if (IsOpen || closing)
{
    <div class="modal-backdrop @(closing ? "mi-closing" : "")" @onclick="OnBackdrop">
        <div class="modal-card @(Wide ? "wide" : "")" role="dialog" aria-modal="true" @onclick:stopPropagation>
            <div class="modal-head">
                <div>
                    <div class="modal-title">@Title</div>
                    @if (!string.IsNullOrEmpty(Subtitle)) { <div class="modal-sub">@Subtitle</div> }
                </div>
                <button class="modal-x" title="Close" @onclick="Close"><i data-lucide="x"></i></button>
            </div>
            <div class="modal-body">@ChildContent</div>
            @if (Footer is not null)
            {
                <div class="modal-foot">@Footer</div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool CloseOnEscape { get; set; } = true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private IDisposable? _registration;
    // Exit animation: the markup stays for ExitMs after IsOpen turns false (see core/micro.css).
    private const int ExitMs = 180;
    private bool closing, wasOpen;
    private CancellationTokenSource? _exitCts;

    private async Task Close() => await IsOpenChanged.InvokeAsync(false);
    private async Task OnBackdrop() { if (CloseOnBackdrop) await Close(); }

    protected override void OnParametersSet()
    {
        if (IsOpen && _registration is null)
            _registration = Overlays.Push(() => CloseOnEscape ? Close() : Task.CompletedTask);
        else if (!IsOpen) { _registration?.Dispose(); _registration = null; }

        if (IsOpen) { _exitCts?.Cancel(); closing = false; }
        else if (wasOpen) _ = PlayExitAsync();
        wasOpen = IsOpen;
    }

    private async Task PlayExitAsync()
    {
        _exitCts?.Cancel();
        var cts = _exitCts = new CancellationTokenSource();
        closing = true;
        try { await Task.Delay(ExitMs, cts.Token); } catch (TaskCanceledException) { return; }
        closing = false;
        StateHasChanged();
    }

    public void Dispose() { _registration?.Dispose(); _exitCts?.Cancel(); }
}
