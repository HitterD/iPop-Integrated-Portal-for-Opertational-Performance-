@namespace IPop.Web.Components
@* Auth card header: group logos side by side, iPop wordmark underneath.
   Each logo ships a light and a dark variant; CSS shows the one matching data-theme. *@
<div class="auth-brand">
    <div class="corp">
        <img class="lg-light" src="img/brand/kapal-api.webp" alt="Kapal Api Group" width="165" height="48" />
        <img class="lg-dark" src="img/brand/kapal-api-dark.webp" alt="Kapal Api Group" width="165" height="48" loading="lazy" />
        <span class="div" aria-hidden="true"></span>
        <img class="lg-light" src="img/brand/sja.webp" alt="PT Santos Jaya Abadi" width="74" height="48" />
        <img class="lg-dark" src="img/brand/sja-dark.webp" alt="PT Santos Jaya Abadi" width="74" height="48" loading="lazy" />
    </div>
    <div class="app">
        <img class="lg-light" src="img/brand/ipop.webp" alt="iPop" width="166" height="56" />
        <img class="lg-dark" src="img/brand/ipop-dark.webp" alt="iPop" width="166" height="56" loading="lazy" />
    </div>
</div>
