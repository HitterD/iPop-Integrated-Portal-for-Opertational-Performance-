@* ⌘K / Ctrl+K. Global search across every module: one request per module, rendered as each answers. *@
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav
@inject IPop.Web.Services.PeopleLinks PLinks
@inject CommandPaletteState Palette
@inject OverlayStack Overlays
@inject IJSRuntime JS

@if (Palette.IsOpen || closing)
{
    <div class="cp-backdrop @(closing ? "mi-closing" : "")" @onclick="Palette.Close">
        <div class="cp-card" role="dialog" aria-modal="true" aria-label="Search iPop" @onclick:stopPropagation>
            <div class="cp-input @(AnySearching ? "cp-searching" : "")">
                <i data-lucide="search"></i>
                <input @ref="inputRef" placeholder="Search people, notes, chat, mail, projects, files…"
                       @oninput="OnInput" @onkeydown="OnKeyDown" data-tab-trap="@(tabTrap ? "1" : "0")" aria-label="Search" />
                @if (AnySearching) { <span class="cp-spin" aria-hidden="true"></span> }
                <span class="cp-hint">ESC</span>
            </div>
            @if (HasQuery)
            {
                <div class="cp-chips" role="tablist" aria-label="Filter by module">
                    <button type="button" class="cp-chip @(filter is null ? "on" : "")" role="tab" aria-selected="@(filter is null)" @onclick="() => SetFilter(null)">
                        All @if (TotalReady > 0) { <span class="cp-chip-n">@TotalReady</span> }
                    </button>
                    @foreach (var m in modules)
                    {
                        var key = m.Key;
                        var st = states.GetValueOrDefault(key);
                        <button type="button" class="cp-chip @(filter == key ? "on" : "") @(st?.Status ?? "")" role="tab" aria-selected="@(filter == key)"
                                title="@ChipTitle(st)" @onclick="() => SetFilter(key)">
                            @m.Label
                            @if (st is { Status: "ready" } && st.Page is not null) { <span class="cp-chip-n">@st.Page.Total</span> }
                            else if (st is { Status: "searching" }) { <span class="cp-chip-dot" aria-label="Searching"></span> }
                            else if (st is { Status: "error" }) { <span class="cp-chip-dot err" aria-label="Error"></span> }
                        </button>
                    }
                </div>
            }
            @if (HasQuery)
            {
                <div class="cp-results" @key="resultsVersion">
                    <span class="cp-sel" aria-hidden="true"></span>
                    @foreach (var m in VisibleModules)
                    {
                        var st = states.GetValueOrDefault(m.Key);
                        if (st is null) continue;
                        var rows = Rows(st);
                        if (st.Status == "ready" && rows.Count == 0) continue;
                        <div class="cp-group cp-group-h">
                            <span>@m.Label</span>
                            @if (st.Status == "searching") { <span class="cp-group-s">Searching…</span> }
                            else if (st.Page is { Status: "ready" } p && p.Total > 0) { <span class="cp-group-s">@p.Total</span> }
                        </div>
                        @foreach (var r in rows)
                        {
                            var idx = flat.IndexOf(r);
                            <button type="button" class="cp-row @(activeIdx == idx ? "active" : "") @(pickedIdx == idx ? "cp-picked" : "")" style="--i:@Math.Min(Math.Max(idx, 0), 8)"
                                    @onmousemove="() => activeIdx = idx" @onclick="() => Go(r)">
                                @if (!string.IsNullOrEmpty(r.AvatarColor) && !string.IsNullOrEmpty(r.Initials))
                                {
                                    <span class="avatar" style="background:@r.AvatarColor">@r.Initials</span>
                                }
                                else
                                {
                                    <span class="avatar" style="background:var(--accent-soft);color:var(--accent-ink)">
                                        <i data-lucide="@r.Icon" style="width:14px;height:14px"></i>
                                    </span>
                                }
                                <span class="txt">
                                    <span class="n">@IPop.Web.Components.Chat.SearchHighlight.Mark(r.Title, query)@if (r.Draft) { <span class="cp-tag">Draft</span> }</span>
                                    @if (!string.IsNullOrEmpty(r.Snippet))
                                    {
                                        <span class="s cp-snip">@IPop.Web.Components.Chat.SearchHighlight.Mark(r.Snippet, query)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(r.Subtitle))
                                    {
                                        <span class="s">@IPop.Web.Components.Chat.SearchHighlight.Mark(r.Subtitle, query)@if (StatusText(r.Status) is { } stt) { <span class="cp-free @(r.Status == "free" ? "free" : "busy")"> · @stt</span> }</span>
                                    }
                                </span>
                                @if (r.Nik is not null)
                                {
                                    <span class="cp-acts">
                                        <span class="cp-cal @(activeIdx == idx && calFocus ? "on" : "")" role="link" title="View calendar (Tab)" @onclick="() => GoCalendar(r)" @onclick:stopPropagation="true"><i data-lucide="calendar-search"></i>Calendar</span>
                                        <span class="cp-cal" role="link" title="Invite to meeting" @onclick="() => GoInvite(r)" @onclick:stopPropagation="true"><i data-lucide="calendar-plus"></i>Invite</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="cp-kind">@m.Label</span>
                                }
                            </button>
                        }
                        @if (st.Status == "error" || st.Status == "unavailable" || st.Status == "forbidden")
                        {
                            <div class="cp-note cp-@st.Status" role="status">
                                <i data-lucide="@(st.Status == "error" ? "alert-triangle" : "info")"></i>
                                <span>@(st.Page?.Message ?? st.Error ?? "Could not search this module.")</span>
                                @if (st.Status == "error")
                                {
                                    <button type="button" class="cp-link" @onclick="() => Retry(m.Key)">Retry</button>
                                }
                                else if (st.Page?.ActionUrl is { } act)
                                {
                                    <button type="button" class="cp-link" @onclick="() => GoUrl(act)">Connect</button>
                                }
                            </div>
                        }
                        else if (st.Status == "ready" && st.Page is { } pg)
                        {
                            if (!string.IsNullOrEmpty(pg.Message))
                            {
                                <div class="cp-note cp-hintline" role="note"><i data-lucide="info"></i><span>@pg.Message</span></div>
                            }
                            if (filter != m.Key && pg.Total > rows.Count)
                            {
                                <button type="button" class="cp-more" @onclick="() => SetFilter(m.Key)">View all @pg.Total in @m.Label</button>
                            }
                            else if (filter == m.Key && pg.HasMore)
                            {
                                <button type="button" class="cp-more" disabled="@st.LoadingMore" @onclick="() => LoadMore(m.Key)">@(st.LoadingMore ? "Loading…" : $"Show more ({rows.Count} of {pg.Total})")</button>
                            }
                        }
                    }
                    @if (flat.Count == 0 && !AnySearching && !AnyNote)
                    {
                        <div class="cp-empty cp-none" @key="query"><i data-lucide="search-x"></i><span>No results for "@query"@(filter is not null ? $" in {ModuleLabel(filter)}" : "").</span></div>
                    }
                </div>
            }
            else if (historyList.Count > 0)
            {
                <div class="cp-results @(clearingHistory ? "cp-clearing" : "")">
                    <div class="cp-group" style="display:flex;align-items:center;justify-content:space-between">
                        <span>Recent searches</span>
                        <button type="button" style="border:none;background:transparent;color:var(--accent-ink);font-size:11px;font-weight:600;cursor:pointer;padding:0" @onclick="ClearAllHistory">Clear all</button>
                    </div>
                    @foreach (var h in historyList)
                    {
                        var item = h;
                        <div @key="item.Id" class="cp-row @(leavingHistory == item.Id ? "mi-leaving" : "")" style="cursor:pointer;display:flex;align-items:center;justify-content:space-between" @onclick="() => SelectHistory(item.Query)">
                            <div style="display:flex;align-items:center;gap:10px;min-width:0;flex:1">
                                <span class="avatar" style="background:var(--tray);color:var(--ink-3);width:28px;height:28px">
                                    <i data-lucide="history" style="width:14px;height:14px"></i>
                                </span>
                                <span class="txt">
                                    <span class="n">@item.Query</span>
                                    <span class="s">@item.SearchedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                </span>
                            </div>
                            <button type="button" style="border:none;background:transparent;color:var(--ink-4);cursor:pointer;padding:4px;border-radius:6px;display:flex;align-items:center" @onclick="() => DeleteHistoryItem(item.Id)" @onclick:stopPropagation="true" title="Remove from history">
                                <i data-lucide="x" style="width:13px;height:13px"></i>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="cp-empty">Type at least two characters to search people, notes, chat, mail, projects, tasks, news, calendar, tickets, file names, calls and notifications.</div>
            }
        </div>
    </div>
}

@code {
    private string query = "";
    private string? filter;
    private List<SearchModuleInfoDto> modules = [];
    private readonly Dictionary<string, ModuleState> states = [];
    private List<SearchHitDto> flat = [];
    private int activeIdx;
    private ElementReference inputRef;
    /// Bumped on every input/filter/history/close; a response for an older generation is dropped.
    private int generation;
    private CancellationTokenSource? cts;
    private IDisposable? _reg;
    private List<SearchHistoryItemDto> historyList = [];
    private bool closing, clearingHistory;
    private int pickedIdx = -1, resultsVersion;
    private Guid? leavingHistory;
    private CancellationTokenSource? _exitCts;
    private const int PageSize = 5;
    private const int FilteredPageSize = 20;

    private sealed class ModuleState
    {
        public string Status = "idle";   // idle | searching | ready | error | unavailable | forbidden
        public SearchPageDto? Page;
        public List<SearchHitDto> Items = [];
        public string? Error;
        public bool LoadingMore;
    }

    private bool HasQuery => query.Trim().Length >= 2;
    private bool AnySearching => states.Values.Any(s => s.Status == "searching");
    private bool AnyNote => VisibleModules.Any(m => states.GetValueOrDefault(m.Key)?.Status is "error" or "unavailable" or "forbidden");
    private int TotalReady => states.Values.Where(s => s.Status == "ready" && s.Page is not null).Sum(s => s.Page!.Total);
    private IEnumerable<SearchModuleInfoDto> VisibleModules => filter is null ? modules : modules.Where(m => m.Key == filter);
    private List<SearchHitDto> Rows(ModuleState st) => filter is null ? st.Items.Take(PageSize).ToList() : st.Items;
    private string ModuleLabel(string key) => modules.FirstOrDefault(m => m.Key == key)?.Label ?? key;
    private static string ChipTitle(ModuleState? st) => st?.Status switch
    {
        "searching" => "Searching…", "error" => "Could not search — click to retry", "unavailable" => st.Page?.Message ?? "Not available",
        "forbidden" => "No access", _ => "",
    };

    protected override void OnInitialized()
    {
        Palette.Changed += OnPaletteChanged;
        _reg = Overlays.Push(CloseAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private void OnPaletteChanged() => _ = InvokeAsync(async () =>
    {
        if (Palette.IsOpen)
        {
            _exitCts?.Cancel(); closing = false;
            Reset();
            query = "";
            await LoadHistoryAsync();
            if (modules.Count == 0) await LoadModulesAsync();
        }
        else
        {
            // Cancel everything in flight; a late answer must not resurface in the next session.
            Reset();
            var exit = _exitCts = new CancellationTokenSource();
            closing = true;
            StateHasChanged();
            try { await Task.Delay(180, exit.Token); } catch (TaskCanceledException) { return; }
            closing = false;
        }
        StateHasChanged();
        if (Palette.IsOpen)
        {
            await Task.Yield();
            await JS.InvokeVoidAsync("ipop.cpBindInput", inputRef);
            await JS.InvokeVoidAsync("ipop.focus", inputRef);
            await JS.InvokeVoidAsync("ipop.icons");
        }
    });

    /// Drops in-flight requests and every result (new generation).
    private void Reset()
    {
        generation++;
        cts?.Cancel(); cts?.Dispose(); cts = null;
        states.Clear();
        flat = [];
        filter = null;
        activeIdx = 0; pickedIdx = -1; calFocus = false;
    }

    private async Task LoadModulesAsync()
    {
        try
        {
            modules = await Auth.GetAsync<List<SearchModuleInfoDto>>("/api/search/modules") ?? [];
        }
        catch { modules = []; }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var h = await Auth.GetAsync<List<SearchHistoryItemDto>>("/api/search/history");
            historyList = h ?? [];
        }
        catch { }
    }

    private async Task RecordHistoryAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Trim().Length < 2) return;
        try
        {
            await Auth.SendAsync(HttpMethod.Post, "/api/search/history", new { query = text.Trim() });
        }
        catch { }
    }

    private async Task SelectHistory(string q)
    {
        query = q;
        await RecordHistoryAsync(q);
        await JS.InvokeVoidAsync("ipop.cpSetValue", inputRef, q);
        StartSearch(immediate: true);
    }

    private async Task DeleteHistoryItem(Guid id)
    {
        leavingHistory = id;
        StateHasChanged();
        await Task.Delay(260);
        leavingHistory = null;
        historyList.RemoveAll(x => x.Id == id);
        try
        {
            await Auth.SendAsync(HttpMethod.Delete, $"/api/search/history/{id}");
        }
        catch { }
        StateHasChanged();
    }

    private async Task ClearAllHistory()
    {
        clearingHistory = true;
        StateHasChanged();
        await Task.Delay(220);
        clearingHistory = false;
        historyList.Clear();
        try
        {
            await Auth.SendAsync(HttpMethod.Delete, "/api/search/history");
        }
        catch { }
        StateHasChanged();
    }

    private async Task CloseAsync()
    {
        Palette.Close();
        await Task.CompletedTask;
    }

    private void OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        StartSearch(immediate: false);
    }

    /// Debounces, then fires one independent request per module; each renders as it lands.
    private void StartSearch(bool immediate)
    {
        var gen = ++generation;
        cts?.Cancel(); cts?.Dispose();
        var token = cts = new CancellationTokenSource();
        var q = query.Trim();
        states.Clear(); flat = []; activeIdx = 0; pickedIdx = -1; calFocus = false;
        if (q.Length < 2) { StateHasChanged(); return; }
        foreach (var m in VisibleModules) states[m.Key] = new ModuleState { Status = "searching" };
        StateHasChanged();
        _ = RunAsync(gen, q, token.Token, immediate);
    }

    private async Task RunAsync(int gen, string q, CancellationToken token, bool immediate)
    {
        if (!immediate)
        {
            try { await Task.Delay(160, token); } catch (TaskCanceledException) { return; }
        }
        if (token.IsCancellationRequested || gen != generation) return;
        if (modules.Count == 0)
        {
            await LoadModulesAsync();
            if (gen != generation) return;
            foreach (var m in VisibleModules) states[m.Key] = new ModuleState { Status = "searching" };
            await InvokeAsync(StateHasChanged);
        }
        // Independent requests: a slow NAS never holds up Notes or Chat.
        var tasks = VisibleModules.Select(m => FetchAsync(gen, m.Key, q, 1, token)).ToList();
        await Task.WhenAll(tasks);
    }

    private async Task FetchAsync(int gen, string module, string q, int page, CancellationToken token)
    {
        var size = filter == module ? FilteredPageSize : PageSize;
        SearchPageDto? dto = null;
        string? error = null;
        try
        {
            var r = await Auth.GetResultAsync<SearchPageDto>($"/api/search/modules/{module}?q={Uri.EscapeDataString(q)}&page={page}&pageSize={size}", token);
            if (r.IsOk) dto = r.Value;
            else error = r.Status switch
            {
                GetStatus.Unreachable => "Couldn't reach the server.",
                GetStatus.Forbidden => "No access.",
                _ => "Could not search this module.",
            };
        }
        catch (OperationCanceledException) { return; }
        catch (Exception) { error = "Could not search this module."; }
        if (token.IsCancellationRequested || gen != generation) return;
        if (!states.TryGetValue(module, out var st)) return;
        st.LoadingMore = false;
        if (dto is null)
        {
            st.Status = "error"; st.Error = error; st.Page = null;
        }
        else
        {
            st.Page = dto;
            st.Status = dto.Status == "ready" ? "ready" : dto.Status;
            if (page == 1) st.Items = dto.Items.ToList();
            else st.Items.AddRange(dto.Items.Where(i => st.Items.All(x => x.Id != i.Id)));
        }
        Rebuild();
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
        });
    }

    private void Rebuild()
    {
        flat = VisibleModules.Select(m => states.GetValueOrDefault(m.Key)).Where(s => s is not null)
            .SelectMany(s => Rows(s!)).ToList();
        if (activeIdx >= flat.Count) activeIdx = 0;
        resultsVersion++;
    }

    private void SetFilter(string? key)
    {
        if (filter == key) return;
        filter = key;
        if (!HasQuery) { StateHasChanged(); return; }
        if (key is null)
        {
            // Back to All: modules we already have stay; the ones hidden by the filter are fetched again.
            var gen = ++generation;
            cts?.Cancel(); cts?.Dispose();
            var token = cts = new CancellationTokenSource();
            var missing = modules.Where(m => !states.ContainsKey(m.Key) || states[m.Key].Status == "idle").ToList();
            foreach (var m in missing) states[m.Key] = new ModuleState { Status = "searching" };
            Rebuild(); StateHasChanged();
            foreach (var m in missing) _ = FetchAsync(gen, m.Key, query.Trim(), 1, token.Token);
            return;
        }
        StartSearch(immediate: true);
    }

    private void Retry(string module)
    {
        if (!HasQuery) return;
        var gen = ++generation;
        cts?.Cancel(); cts?.Dispose();
        var token = cts = new CancellationTokenSource();
        states[module] = new ModuleState { Status = "searching" };
        Rebuild(); StateHasChanged();
        _ = FetchAsync(gen, module, query.Trim(), 1, token.Token);
    }

    private void LoadMore(string module)
    {
        if (!states.TryGetValue(module, out var st) || st.Page is null || !st.Page.HasMore || st.LoadingMore) return;
        st.LoadingMore = true;
        StateHasChanged();
        var token = cts ??= new CancellationTokenSource();
        _ = FetchAsync(generation, module, query.Trim(), st.Page.Page + 1, token.Token);
    }

    private async Task Go(SearchHitDto r)
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            _ = RecordHistoryAsync(query);
        }
        pickedIdx = flat.IndexOf(r);
        StateHasChanged();
        await Task.Delay(140);
        Palette.Close();
        Nav.NavigateTo(r.Url);
    }

    private void GoUrl(string url) { Palette.Close(); Nav.NavigateTo(url); }

    /// Tab on a person flips Enter between their profile and their calendar.
    private bool calFocus;
    /// Only swallow Tab while a person row is active (applied in JS, ipop.cpBindInput).
    private bool tabTrap => flat.Count > 0 && flat[Math.Clamp(activeIdx, 0, flat.Count - 1)].Nik is not null;

    private static string? StatusText(string? status)
    {
        if (status == "free") return "Free now";
        if (status?.StartsWith("busy:") == true && DateTime.TryParse(status[5..], null, System.Globalization.DateTimeStyles.RoundtripKind, out var until))
            return $"In a meeting until {until.ToLocalTime():HH:mm}";
        return null;
    }

    private void GoInvite(SearchHitDto r) { Palette.Close(); Nav.NavigateTo(PLinks.Invite(r.Nik!)); }

    private async Task GoCalendar(SearchHitDto r)
    {
        if (!string.IsNullOrWhiteSpace(query)) _ = RecordHistoryAsync(query);
        pickedIdx = flat.IndexOf(r);
        StateHasChanged();
        await Task.Delay(140);
        Palette.Close();
        Nav.NavigateTo(PLinks.Calendar(r.Nik!));
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown": if (flat.Count > 0) { activeIdx = (activeIdx + 1) % flat.Count; calFocus = false; StateHasChanged(); } break;
            case "ArrowUp": if (flat.Count > 0) { activeIdx = (activeIdx - 1 + flat.Count) % flat.Count; calFocus = false; StateHasChanged(); } break;
            case "Tab":
                if (flat.Count > 0 && flat[Math.Clamp(activeIdx, 0, flat.Count - 1)].Nik is not null) { calFocus = !calFocus; StateHasChanged(); }
                break;
            case "Enter":
                if (!string.IsNullOrWhiteSpace(query))
                {
                    _ = RecordHistoryAsync(query);
                }
                if (flat.Count > 0)
                {
                    var pick = flat[Math.Clamp(activeIdx, 0, flat.Count - 1)];
                    if (calFocus && pick.Nik is not null) await GoCalendar(pick); else await Go(pick);
                }
                break;
            case "Escape": Palette.Close(); break;
        }
    }

    public void Dispose()
    {
        Palette.Changed -= OnPaletteChanged;
        _reg?.Dispose();
        cts?.Cancel(); cts?.Dispose();
        _exitCts?.Cancel();
    }

    public record SearchModuleInfoDto(string Key, string Label, string Icon, int Order);
    public record SearchHitDto(string Id, string Module, string Title, string? Subtitle, string? Snippet, string Url, string Icon,
        DateTime? UpdatedAt, string Match, bool Draft = false, string? AvatarColor = null, string? Initials = null, string? Nik = null, string? Status = null);
    public record SearchPageDto(string Module, string Status, List<SearchHitDto> Items, int Total, int Page, int PageSize, bool HasMore,
        string? Message = null, bool Partial = false, string? ActionUrl = null);
    public record SearchHistoryItemDto(Guid Id, string Query, DateTime SearchedAt);
}
