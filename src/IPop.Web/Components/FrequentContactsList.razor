@namespace IPop.Web.Components
@using IPop.Web.Models

@* Sering Dihubungi — daftar kontak yang paling sering diajak chat/surat,
   dipakai sebagai pintasan di halaman Kontak Prioritas (dan bisa dipakai
   ulang di dashboard). Items sudah diurut dari yang paling sering. *@

@if (Items.Count > 0)
{
    <div class="notif-list" role="list" aria-label="Frequently contacted">
        @foreach (var p in Items)
        {
            var person = p;
            <div class="notif-row" role="listitem" @onclick="() => OnOpen.InvokeAsync(person)">
                <div class="notif-row-ic" style="@IPop.Web.Models.AvatarPhotos.Style(person.Nik)">
                    @Initials(person.Name)
                </div>
                <div class="notif-row-main">
                    <div class="notif-row-t">
                        @person.Name
                        <span class="mono" style="font-size:11px;color:var(--ink-3)">@person.Nik</span>
                    </div>
                    <div class="notif-row-s">@(person.Position ?? "—")@(person.Department is not null ? $" · {person.Department}" : "")</div>
                </div>
                <span style="display:flex;gap:4px;flex-shrink:0">
                    @if (OnChat.HasDelegate)
                    {
                        <button type="button" class="btn-sm surface" title="Chat" @onclick="() => OnChat.InvokeAsync(person)" @onclick:stopPropagation><i data-lucide="message-circle" style="width:13px;height:13px"></i></button>
                    }
                    @if (OnMail.HasDelegate)
                    {
                        <button type="button" class="btn-sm surface" title="Mail" @onclick="() => OnMail.InvokeAsync(person)" @onclick:stopPropagation><i data-lucide="mail" style="width:13px;height:13px"></i></button>
                    }
                </span>
            </div>
        }
    </div>
}
else if (ShowEmpty)
{
    <div class="tree-empty" style="padding:24px">
        <i data-lucide="history" style="width:18px;height:18px;margin-bottom:6px"></i>
        <div class="meta" style="font-size:11.5px;color:var(--ink-3)">No frequently contacted people yet.</div>
    </div>
}

@code {
    /// Satu baris kontak sering-dihubungi.
    public sealed record FrequentContact(string Nik, string Name, string? Position, string? Department, string Status);

    [Parameter] public IReadOnlyList<FrequentContact> Items { get; set; } = [];
    [Parameter] public bool ShowEmpty { get; set; }
    [Parameter] public EventCallback<FrequentContact> OnOpen { get; set; }
    [Parameter] public EventCallback<FrequentContact> OnChat { get; set; }
    [Parameter] public EventCallback<FrequentContact> OnMail { get; set; }

    /// Contoh data tiruan untuk pratinjau/frontend wave sebelum sumber data nyata tersedia.
    public static IReadOnlyList<FrequentContact> Mock() =>
    [
        new("1999001", "Andi Prasetyo", "Staff Operasional", "Produksi", "online"),
        new("1999002", "Sari Wulandari", "Supervisor", "Produksi", "busy"),
        new("1999003", "Budi Santoso", "Manager", "Engineering", "away"),
        new("1999004", "Dewi Lestari", "Staff HR", "Human Resources", "offline"),
    ];

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
}
