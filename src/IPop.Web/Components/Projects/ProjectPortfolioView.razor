@using IPop.Application.Projects

<section class="portfolio" aria-label="All projects overview">
    <div class="portfolio-heading">
        <div>
            <h2>All projects overview</h2>
            <p>Priorities and deadlines across the projects you can see.</p>
        </div>
        <span class="portfolio-scope">@(Data?.Scope == "all" ? "All projects" : "My projects")</span>
    </div>
    @if (Loading)
    {
        <div class="portfolio-empty">Loading project summary…</div>
    }
    else if (Data is null)
    {
        <div class="portfolio-empty">Summary unavailable. <button type="button" @onclick="OnRetry">Try again</button></div>
    }
    else
    {
        <div class="portfolio-metrics">
            <div class="portfolio-metric"><span>Active projects</span><strong>@Data.ActiveProjects</strong></div>
            <div class="portfolio-metric"><span>Needs attention</span><strong>@Data.AtRiskProjects</strong></div>
            <button type="button" class="portfolio-metric" @onclick="OpenDueWeek"><span>My tasks this week</span><strong>@Data.MyDueWeek</strong></button>
            <button type="button" class="portfolio-metric" @onclick="OpenOverdue"><span>Overdue tasks</span><strong>@Data.OverdueTasks</strong></button>
        </div>
        <div class="portfolio-grid">
            <section class="portfolio-card portfolio-projects">
                <h3>Projects <small>@Data.AverageProgress% average complete</small></h3>
                @if (Data.Projects.TotalCount == 0)
                {
                    <p class="portfolio-muted">No active projects yet. Choose New to create one.</p>
                }
                @foreach (var project in Data.Projects.Items)
                {
                    <button type="button" class="portfolio-row" @onclick="() => OnOpenProject.InvokeAsync(project.ProjectId)">
                        <span class="portfolio-row-main"><b>@project.Name</b><small>@project.TaskCount tasks · @project.Progress% complete</small></span>
                        <span class="portfolio-health @project.Health">@HealthLabel(project.Health)</span>
                    </button>
                }
                @if (Data.Projects.TotalCount > Data.Projects.PageSize)
                {
                    <div class="portfolio-pages"><button type="button" disabled="@(Data.Projects.Page <= 1)" @onclick="() => OnProjectPage.InvokeAsync(Data.Projects.Page - 1)">Previous</button><span>@Data.Projects.Page / @((Data.Projects.TotalCount + Data.Projects.PageSize - 1) / Data.Projects.PageSize)</span><button type="button" disabled="@(Data.Projects.Page * Data.Projects.PageSize >= Data.Projects.TotalCount)" @onclick="() => OnProjectPage.InvokeAsync(Data.Projects.Page + 1)">Next</button></div>
                }
            </section>
            <section class="portfolio-card">
                <h3>Overdue by person</h3>
                @if (Data.OverdueByPerson.Count == 0) { <p class="portfolio-muted">No overdue tasks.</p> }
                @foreach (var person in Data.OverdueByPerson)
                {
                    <button type="button" class="portfolio-row" @onclick="() => OpenPersonTasks(person, false)"><span>@person.Name</span><b>@person.OverdueCount tasks</b></button>
                }
            </section>
            <section class="portfolio-card">
                <h3>Workload this week</h3>
                @if (Data.WorkloadByPerson.Count == 0) { <p class="portfolio-muted">No tasks scheduled this week.</p> }
                @foreach (var person in Data.WorkloadByPerson)
                {
                    <button type="button" class="portfolio-row" @onclick="() => OpenPersonTasks(person, true)">
                        <span>@person.Name</span><b>@person.OpenTaskCount tasks</b>
                    </button>
                }
            </section>
            <section class="portfolio-card">
                <h3>Upcoming project deadlines</h3>
                @if (Data.Deadlines.Count == 0) { <p class="portfolio-muted">No upcoming deadlines.</p> }
                @foreach (var deadline in Data.Deadlines)
                {
                    <button type="button" class="portfolio-row" @onclick="() => OnOpenProject.InvokeAsync(deadline.ProjectId)"><span>@deadline.Name</span><time datetime="@(deadline.Deadline.ToString("yyyy-MM-dd"))">@deadline.Deadline.ToString("dd MMM")</time></button>
                }
            </section>
        </div>
        @if (Tasks is not null)
        {
            <section class="portfolio-card portfolio-drilldown" aria-label="Related tasks">
                <div class="portfolio-drilldown-head"><h3>Related tasks</h3><button type="button" @onclick="OnCloseTasks">Close</button></div>
                @if (Tasks.Items.Count == 0) { <p class="portfolio-muted">No tasks for this selection.</p> }
                @foreach (var task in Tasks.Items)
                {
                    <button type="button" class="portfolio-row" @onclick="() => OnOpenTask.InvokeAsync((task.ProjectId, task.TaskId))">
                        <span class="portfolio-row-main"><b>@task.Title</b><small>@task.ProjectName · @string.Join(", ", task.Assignees.Select(a => a.Name))</small></span>
                        <time>@(task.DueDate?.ToString("dd MMM") ?? "—")</time>
                    </button>
                }
                @if (Tasks.TotalCount > Tasks.PageSize)
                {
                    <div class="portfolio-pages"><button type="button" disabled="@(Tasks.Page <= 1)" @onclick="() => OnTaskPage.InvokeAsync(Tasks.Page - 1)">Previous</button><span>@Tasks.Page / @((Tasks.TotalCount + Tasks.PageSize - 1) / Tasks.PageSize)</span><button type="button" disabled="@(Tasks.Page * Tasks.PageSize >= Tasks.TotalCount)" @onclick="() => OnTaskPage.InvokeAsync(Tasks.Page + 1)">Next</button></div>
                }
            </section>
        }
        <TimesheetCard ProjectId="null" Version="Data" Class="portfolio-card portfolio-timesheet" />
    }
</section>

@code {
    [Parameter] public PortfolioDto? Data { get; set; }
    [Parameter] public PagedResult<PortfolioTaskDto>? Tasks { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenProject { get; set; }
    [Parameter] public EventCallback<(string Filter, Guid? ProjectId, Guid? AssigneeId)> OnOpenTasks { get; set; }
    [Parameter] public EventCallback<(Guid ProjectId, Guid TaskId)> OnOpenTask { get; set; }
    [Parameter] public EventCallback<int> OnTaskPage { get; set; }
    [Parameter] public EventCallback<int> OnProjectPage { get; set; }
    [Parameter] public EventCallback OnCloseTasks { get; set; }

    private Task OpenDueWeek() => OnOpenTasks.InvokeAsync(("due_week", null, null));
    private Task OpenOverdue() => OnOpenTasks.InvokeAsync(("overdue", null, null));
    private Task OpenPersonTasks(PortfolioPersonDto person, bool workload) =>
        OnOpenTasks.InvokeAsync((workload ? "workload" : "overdue", null, person.UserId));

    private static string HealthLabel(string health) => health switch
    {
        "at_risk" => "Needs attention",
        "due_soon" => "Due soon",
        _ => "On track"
    };
}
