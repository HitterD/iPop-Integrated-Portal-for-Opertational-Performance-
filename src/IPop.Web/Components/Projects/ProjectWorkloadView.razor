@using IPop.Application.Projects

<section class="v6-workload" aria-labelledby="workload-heading">
    <div class="v6-workload__header">
        <div>
            <h2 id="workload-heading">Team workload</h2>
            <p>Capacity: 8 tasks per person</p>
        </div>
        @if (CanManageMembers)
        {
            <button type="button" class="v6-workload__add" @onclick="() => OnAddMember.InvokeAsync()">
                <i data-lucide="plus" aria-hidden="true"></i> Add member
            </button>
        }
    </div>

    @if (Workload is null)
    {
        <p class="v6-workload__empty" role="status">Loading team workload…</p>
    }
    else
    {
        <div class="v6-workload__scroll">
            <div class="v6-workload__table" role="table" aria-label="Team workload by member">
                <div class="v6-workload__columns" role="row">
                    <span role="columnheader">Member</span>
                    <span role="columnheader">Tasks</span>
                    <span role="columnheader">Status distribution</span>
                    <span role="columnheader">Capacity</span>
                    <span role="columnheader">Actions</span>
                </div>
                @foreach (var member in Workload.ByAssignee)
                {
                    var capacity = member.IsUnassigned ? "Needs owner" : GetCapacity(member.TaskCount - member.DoneCount);
                    var memberId = member.IsUnassigned ? (Guid?)null : member.UserId;
                    var todoWidth = GetSegmentWidth(member.TodoCount, 0);
                    var doingWidth = GetSegmentWidth(member.DoingCount, member.TodoCount);
                    var reviewWidth = GetSegmentWidth(member.ReviewCount, member.TodoCount + member.DoingCount);
                    var doneWidth = GetSegmentWidth(member.DoneCount, member.TodoCount + member.DoingCount + member.ReviewCount);
                    <div class="v6-workload__row" role="row" @key="(member.UserId, member.IsUnassigned)">
                        <div class="v6-workload__person" role="cell">
                            @if (member.IsUnassigned)
                            {
                                <span class="v6-workload__avatar" style="background:var(--tray)" aria-hidden="true"><i data-lucide="user-round-question"></i></span>
                            }
                            else
                            {
                                <PersonAvatar Nik="@member.Nik" Name="@member.Name" Size="34" Class="v6-workload__avatar" Decorative="true" />
                            }
                            <span class="v6-workload__identity">
                                <strong>@member.Name</strong>
                                <span>@(member.IsUnassigned ? "No assignee" : string.IsNullOrWhiteSpace(member.Position) ? "Team member" : member.Position)</span>
                            </span>
                        </div>
                        <div class="v6-workload__task-count" role="cell">
                            <strong>@(member.TaskCount - member.DoneCount) open · @member.TaskCount total</strong>
                            @if (member.OverdueCount > 0)
                            {
                                <span class="v6-workload__overdue">@member.OverdueCount overdue</span>
                            }
                        </div>
                        <div class="v6-workload__distribution" role="cell">
                            <div class="v6-workload__bar" role="img" aria-label="@GetDistributionLabel(member)">
                                @if (member.TaskCount > 0)
                                {
                                    <span class="v6-workload__segment v6-workload__segment--todo" style="width:@todoWidth%" title="To do: @member.TodoCount"></span>
                                    <span class="v6-workload__segment v6-workload__segment--doing" style="width:@doingWidth%" title="Doing: @member.DoingCount"></span>
                                    <span class="v6-workload__segment v6-workload__segment--review" style="width:@reviewWidth%" title="Review: @member.ReviewCount"></span>
                                    <span class="v6-workload__segment v6-workload__segment--done" style="width:@doneWidth%" title="Done: @member.DoneCount"></span>
                                }
                            </div>
                            <div class="v6-workload__status-counts" aria-hidden="true">
                                <span><i class="v6-workload__dot v6-workload__dot--todo"></i>@member.TodoCount To Do</span>
                                <span><i class="v6-workload__dot v6-workload__dot--doing"></i>@member.DoingCount In Progress</span>
                                <span><i class="v6-workload__dot v6-workload__dot--review"></i>@member.ReviewCount Review</span>
                                <span><i class="v6-workload__dot v6-workload__dot--done"></i>@member.DoneCount Done</span>
                            </div>
                        </div>
                        <div class="v6-workload__capacity" role="cell">
                            <span class="v6-workload__capacity-badge v6-workload__capacity-badge--@capacity.ToLowerInvariant()">@capacity</span>
                        </div>
                        <div class="v6-workload__actions" role="cell">
                            <button type="button" class="v6-workload__view" @onclick="() => OnViewTasks.InvokeAsync(memberId)" aria-label="View tasks for @member.Name">View tasks</button>
                            @if (CanManageMembers && !member.IsUnassigned && !OwnerIds.Contains(member.UserId))
                            {
                                <button type="button" class="v6-workload__remove" @onclick="() => OnRemoveMember.InvokeAsync(member.UserId)" aria-label="Remove @member.Name from project" title="Remove member">
                                    <i data-lucide="trash-2" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
                @if (Workload.ByAssignee.Count == 0)
                {
                    <p class="v6-workload__empty" role="status">No team members yet. Add a member to start tracking workload.</p>
                }
            </div>
        </div>
        <p class="v6-workload__note">Each bar represents up to 8 tasks; extra tasks are reflected in the total and capacity label.</p>
    }
    @if (ProjectId != Guid.Empty)
    {
        <TimesheetCard ProjectId="ProjectId" Version="Workload" Class="v6-workload__timesheet" />
    }
</section>

@code {
    private const int CapacityTasks = 8;

    [Parameter] public ProjectWorkloadDto? Workload { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public bool CanManageMembers { get; set; }
    [Parameter] public IReadOnlySet<Guid> OwnerIds { get; set; } = new HashSet<Guid>();
    [Parameter] public EventCallback OnAddMember { get; set; }
    [Parameter] public EventCallback<Guid?> OnViewTasks { get; set; }
    [Parameter] public EventCallback<Guid> OnRemoveMember { get; set; }

    private static string GetCapacity(int taskCount) => taskCount switch
    {
        >= 5 => "Overloaded",
        >= 3 => "Busy",
        _ => "Available"
    };

    private static decimal GetSegmentWidth(int statusCount, int precedingTasks) =>
        Math.Min(Math.Max(statusCount, 0), Math.Max(CapacityTasks - precedingTasks, 0)) * 100m / CapacityTasks;

    private static string GetDistributionLabel(AssigneeWorkloadDto member) =>
        $"{member.Name}: {member.TaskCount} tasks, {member.TodoCount} to do, {member.DoingCount} doing, {member.ReviewCount} in review, {member.DoneCount} done; {member.OverdueCount} overdue. Capacity: 8 tasks.";
}
