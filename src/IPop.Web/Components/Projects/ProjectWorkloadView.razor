@using IPop.Application.Projects
@using IPop.Web.Services
@inject ToastService Toasts

<div>
    @if (Workload is not null)
    {
        <div class="workload-kpis">
            <div class="workload-kpi-card">
                <div class="k-num">@Workload.TotalTasks</div>
                <div class="k-lbl">Total Tasks</div>
            </div>
            <div class="workload-kpi-card">
                <div class="k-num" style="color:#d97706">@Workload.DoingTasks</div>
                <div class="k-lbl">In Progress</div>
            </div>
            <div class="workload-kpi-card">
                <div class="k-num" style="color:#0A84FF">@Workload.ReviewTasks</div>
                <div class="k-lbl">In Review</div>
            </div>
            <div class="workload-kpi-card">
                <div class="k-num" style="color:#16a34a">@Workload.DoneTasks</div>
                <div class="k-lbl">Completed</div>
            </div>
            <div class="workload-kpi-card">
                <div class="k-num">@Workload.TotalEstimatedHours h</div>
                <div class="k-lbl">Total Estimated Hours</div>
            </div>
            <div class="workload-kpi-card">
                <div class="k-num" style="color:var(--accent-ink)">@Workload.DoneEstimatedHours h</div>
                <div class="k-lbl">Completed Hours</div>
            </div>
        </div>

        <div style="display:flex;align-items:center;justify-content:space-between;margin:24px 0 14px">
            <h3 style="font-size:15px;font-weight:700;margin:0;display:flex;align-items:center;gap:8px">
                <i data-lucide="users"></i> Workload Capacity by Team Member
            </h3>
            <span style="font-size:12px;color:var(--ink-3)">@(Workload.ByAssignee.Count) Registered Members</span>
        </div>

        @if (Workload.ByAssignee.Count == 0)
        {
            <div class="tree-empty" style="padding:32px 16px;text-align:center">
                <i data-lucide="user-x" style="width:28px;height:28px;margin-bottom:8px"></i>
                <div>No tasks assigned to team members yet.</div>
            </div>
        }
        else
        {
            <div class="workload-members-grid">
                @foreach (var a in Workload.ByAssignee)
                {
                    var pct = Workload.TotalTasks > 0 ? (a.TaskCount * 100 / Workload.TotalTasks) : 0;
                    var (capLabel, capClass, capIcon) = GetCapacityInfo(a.TaskCount, a.EstimatedHours);
                    var isExpanded = expandedAssignees.Contains(a.UserId);
                    var memberTasks = AllTasks.Where(t => t.Assignees.Any(x => x.UserId == a.UserId)).ToList();

                    <div class="workload-member-card">
                        <div class="wm-head">
                            <div class="team-avatar-circ" style="width:38px;height:38px;font-size:13px;background:@ProjectUiHelpers.GetAvatarBg(a.Name)">
                                @ProjectUiHelpers.GetInitials(a.Name)
                            </div>
                            <div style="min-width:0;flex:1">
                                <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
                                    <div style="font-weight:700;font-size:13.5px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@a.Name</div>
                                    <span class="wm-capacity-badge @capClass">
                                        <i data-lucide="@capIcon" style="width:10px;height:10px"></i>
                                        <span>@capLabel</span>
                                    </span>
                                </div>
                                <div style="font-size:11.5px;color:var(--ink-3);margin-top:2px">@a.TaskCount tasks · @a.EstimatedHours h estimate</div>
                            </div>
                        </div>

                        <div>
                            <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--ink-3);margin-bottom:4px">
                                <span>Workload Distribution</span>
                                <span>@pct% (@a.TaskCount/@Workload.TotalTasks tasks)</span>
                            </div>
                            <div class="wm-bar">
                                <div class="wm-bar-fill" style="width:@pct%"></div>
                            </div>
                        </div>

                        @if (memberTasks.Count > 0)
                        {
                            <div>
                                <button type="button" class="wm-accordion-btn" @onclick="() => ToggleMemberExpand(a.UserId)">
                                    <i data-lucide="@(isExpanded ? "chevron-up" : "chevron-down")" style="width:12px;height:12px"></i>
                                    <span>@(isExpanded ? "Hide Tasks" : $"View {memberTasks.Count} Tasks")</span>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="wm-tasks-dropdown">
                                        @foreach (var mt in memberTasks)
                                        {
                                            <div class="wm-task-row" style="display:flex;align-items:center;justify-content:space-between" @onclick="() => OnTaskClick.InvokeAsync(mt)" title="@mt.Title (Click to edit)">
                                                <div style="display:flex;align-items:center;gap:8px;min-width:0;flex:1">
                                                    <span class="col-dot @mt.Status.ToLower()" style="flex-shrink:0"></span>
                                                    <span class="wm-task-title" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@mt.Title</span>
                                                    @if (!string.IsNullOrEmpty(mt.Priority))
                                                    {
                                                        <span class="priority-badge @mt.Priority.ToLower()" style="font-size:9px;padding:1px 5px;flex-shrink:0">@mt.Priority</span>
                                                    }
                                                    <span class="status-pill @mt.Status.ToLower()" style="font-size:9px;padding:1px 6px;flex-shrink:0">@mt.Status</span>
                                                </div>
                                                <button type="button" class="btn btn-sm" style="padding:2px 6px;font-size:11px;border:none;background:transparent;color:var(--ink-3);cursor:pointer;flex-shrink:0" title="Remove assignment" @onclick="() => RemoveTaskFromMember(mt, a.UserId, a.Name)" @onclick:stopPropagation>
                                                    <i data-lucide="x" style="width:13px;height:13px"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div style="padding:40px;text-align:center">
            <i data-lucide="loader" class="spin" style="width:28px;height:28px;color:var(--accent)"></i>
            <div style="margin-top:8px;font-size:13px;color:var(--ink-2)">Loading workload metrics...</div>
        </div>
    }
</div>

@code {
    [Parameter] public ProjectWorkloadDto? Workload { get; set; }
    [Parameter] public List<ProjectTaskDto> AllTasks { get; set; } = [];
    [Parameter] public EventCallback<ProjectTaskDto> OnTaskClick { get; set; }
    [Parameter] public EventCallback<(Guid TaskId, Guid UserId)> OnUnassign { get; set; }
    [Parameter] public EventCallback<(Guid TaskId, Guid UserId)> OnReassign { get; set; }

    private HashSet<Guid> expandedAssignees = [];

    private void ToggleMemberExpand(Guid userId)
    {
        if (!expandedAssignees.Add(userId))
        {
            expandedAssignees.Remove(userId);
        }
    }

    private async Task RemoveTaskFromMember(ProjectTaskDto task, Guid userId, string memberName)
    {
        await OnUnassign.InvokeAsync((task.Id, userId));
        Toasts.ShowUndo(
            $"Unassigned \"{task.Title}\" from {memberName}",
            async () => await OnReassign.InvokeAsync((task.Id, userId)),
            "Undo",
            ms: 5000);
    }

    private static (string Label, string CssClass, string Icon) GetCapacityInfo(int count, decimal hours)
    {
        if (count >= 5 || hours >= 40)
            return ("Overloaded", "overloaded", "alert-triangle");
        if (count >= 2 || hours >= 15)
            return ("Optimal", "optimal", "check-circle-2");
        return ("Available", "available", "check");
    }
}
