@using IPop.Application.Projects
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="kanban-board-grid @(draggingTaskId.HasValue ? "is-dragging" : "")">
    @RenderKanbanCol("todo", "To Do", "todo", "col-todo", Kanban?.Todo ?? [])
    @RenderKanbanCol("doing", "In Progress", "doing", "col-doing", Kanban?.Doing ?? [])
    @RenderKanbanCol("review", "Review", "review", "col-review", Kanban?.Review ?? [])
    @RenderKanbanCol("done", "Done", "done", "col-done", Kanban?.Done ?? [])
</div>

@code {
    [Parameter] public KanbanBoardDto? Kanban { get; set; }
    [Parameter] public List<ProjectMemberDto> Members { get; set; } = [];
    [Parameter] public List<ProjectGroupDto> Groups { get; set; } = [];
    [Parameter] public EventCallback<(Guid TaskId, Guid GroupId)> OnMoveToGroup { get; set; }
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public bool MyTasksOnly { get; set; }
    [Parameter] public bool OverdueOnly { get; set; }
    [Parameter] public string PriorityFilter { get; set; } = "";
    [Parameter] public string? CurrentUserNik { get; set; }
    [Parameter] public Guid? HighlightTaskId { get; set; }

    [Parameter] public EventCallback<ProjectTaskDto> OnTaskClick { get; set; }
    [Parameter] public EventCallback<(Guid TaskId, string TargetStatus)> OnTaskMove { get; set; }
    [Parameter] public EventCallback<ProjectTaskDto> OnToggleComplete { get; set; }
    [Parameter] public EventCallback<(string Status, string Title)> OnQuickAdd { get; set; }
    [Parameter] public EventCallback<(Guid TaskId, Guid UserId, bool IsAssigned)> OnToggleAssignee { get; set; }
    [Parameter] public EventCallback<ProjectTaskDto> OnRequestExtension { get; set; }

    private Guid? draggingTaskId;
    private Guid? quickAssignTaskId;
    private string? quickAddColumn;
    private string quickColumnTitle = "";
    private Guid? justMovedTaskId;

    // The card menu and quick-assign popover are portalled to <body> (ipop.menuOpen) so the
    // scrolling lane can't clip them. Only one is open at a time; menuRef points at it.
    private ElementReference menuRef;
    private string? portalKey;
    private DotNetObjectReference<ProjectKanbanBoard>? selfRef;
    private string? OpenMenuKey => moreTaskId is { } m ? $"more:{m}" : quickAssignTaskId is { } q ? $"assign:{q}" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("ipop.initKanbanDragFollower");
            }
            catch { }
        }
        await SyncMenuPortalAsync();
    }

    private async Task SyncMenuPortalAsync()
    {
        var key = OpenMenuKey;
        try
        {
            if (key is null)
            {
                if (portalKey is not null) await JS.InvokeVoidAsync("ipop.menuClose");
            }
            else
            {
                selfRef ??= DotNetObjectReference.Create(this);
                if (key != portalKey) await JS.InvokeVoidAsync("ipop.icons");
                await JS.InvokeVoidAsync("ipop.menuSync", menuRef, selfRef, "right");
            }
            portalKey = key;
        }
        catch { /* prerender / disposed circuit */ }
    }

    [JSInvokable]
    public Task CloseMenuFromJs()
    {
        if (OpenMenuKey is null) return Task.CompletedTask;
        moreTaskId = null;
        quickAssignTaskId = null;
        portalKey = null;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (portalKey is not null)
        {
            try { await JS.InvokeVoidAsync("ipop.menuDrop"); } catch { }
        }
        selfRef?.Dispose();
    }

    private void OnDragStart(Guid taskId, DragEventArgs e)
    {
        draggingTaskId = taskId;
        try
        {
            if (e.DataTransfer != null)
            {
                e.DataTransfer.EffectAllowed = "move";
                e.DataTransfer.DropEffect = "move";
            }
        }
        catch { }
    }

    private async Task OnDrop(string targetStatus, DragEventArgs e)
    {
        if (draggingTaskId is null) return;
        var id = draggingTaskId.Value;
        draggingTaskId = null;
        justMovedTaskId = id;

        await OnTaskMove.InvokeAsync((id, targetStatus));

        var task = ClearJustMovedAfterDelay(id);
    }

    private async Task ClearJustMovedAfterDelay(Guid id)
    {
        await Task.Delay(1400);
        if (justMovedTaskId == id)
        {
            justMovedTaskId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartQuickAdd(string status)
    {
        quickAddColumn = status;
        quickColumnTitle = "";
    }

    private async Task SubmitQuickAdd(string status)
    {
        if (string.IsNullOrWhiteSpace(quickColumnTitle))
        {
            quickAddColumn = null;
            return;
        }

        var title = quickColumnTitle.Trim();
        quickAddColumn = null;
        quickColumnTitle = "";

        await OnQuickAdd.InvokeAsync((status, title));
    }

    private Guid? moreTaskId;
    private static readonly (string Key, string Label)[] MoveTargets = [("todo", "To Do"), ("doing", "In Progress"), ("review", "Review"), ("done", "Done")];

    private void ToggleMore(Guid taskId)
    {
        moreTaskId = moreTaskId == taskId ? null : taskId;
        quickAssignTaskId = null;
    }

    private async Task RunMore(Func<Task> action)
    {
        moreTaskId = null;
        await action();
    }

    private void ToggleQuickAssign(Guid taskId)
    {
        quickAssignTaskId = quickAssignTaskId == taskId ? null : taskId;
        moreTaskId = null;
    }

    private RenderFragment RenderKanbanCol(string statusKey, string title, string dotClass, string colThemeClass, IReadOnlyList<ProjectTaskDto> items)
    {
        var filteredItems = items.AsEnumerable();
        if (MyTasksOnly)
        {
            filteredItems = filteredItems.Where(t => ProjectUiHelpers.IsAssignedToUser(t, CurrentUserNik));
        }
        if (OverdueOnly)
        {
            filteredItems = filteredItems.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "done");
        }
        if (!string.IsNullOrWhiteSpace(PriorityFilter))
        {
            filteredItems = filteredItems.Where(t => string.Equals(t.Priority, PriorityFilter, StringComparison.OrdinalIgnoreCase));
        }
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            filteredItems = filteredItems.Where(t => t.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
                || (t.Tags?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        var taskList = filteredItems.ToList();

        @* Lane highlight is toggled in ipop.initKanbanDragFollower so dragover never re-renders Blazor. *@
        return @<div class="kanban-column @colThemeClass" data-lane="@statusKey"
                     @ondragover:preventDefault="true"
                     @ondrop="e => OnDrop(statusKey, e)">
            <div class="kanban-col-header">
                <span class="col-dot @dotClass"></span>
                <div class="col-title">
                    <span>@title</span>
                </div>
                <span class="col-count @dotClass">@taskList.Count</span>
                <button type="button" class="col-quick-icon" title="Add task" @onclick="() => StartQuickAdd(statusKey)">
                    <i data-lucide="plus" style="width:15px;height:15px"></i>
                </button>
            </div>

            <div class="kanban-cards-stream">
                @if (quickAddColumn == statusKey)
                {
                    <div class="kanban-quick-add-box">
                        <input class="kanban-quick-input" placeholder="Task name, then press Enter" @bind="quickColumnTitle" @bind:event="oninput"
                               @onkeydown="@(async e => { if (e.Key == "Enter") await SubmitQuickAdd(statusKey); if (e.Key == "Escape") quickAddColumn = null; })" autofocus />
                        <div class="kanban-quick-actions">
                            <button type="button" class="kanban-quick-save" @onclick="() => SubmitQuickAdd(statusKey)">Add</button>
                            <button type="button" class="kanban-quick-cancel" @onclick="() => quickAddColumn = null">Cancel</button>
                            <span class="kanban-quick-hint">Esc to close</span>
                        </div>
                    </div>
                }

                @if (taskList.Count == 0 && quickAddColumn != statusKey)
                {
                    <div class="kanban-empty-lane">Drop tasks here</div>
                }

                @foreach (var t in taskList)
                {
                    var isOverdue = t.DueDate.HasValue && t.DueDate.Value < DateTime.UtcNow && t.Status != "done";
                    var evidence = TaskEvidenceHelper.Parse(t.Description).Evidence;
                    var isJustArrived = justMovedTaskId == t.Id;
                    var isJustCreated = HighlightTaskId == t.Id;


                    <div id="task-card-@t.Id"
                         class="kanban-task-card @(t.Status == "done" ? "is-done" : "") @(isJustArrived ? "task-just-arrived" : "") @(isJustCreated ? "task-just-created" : "") @(HighlightTaskId == t.Id ? "task-highlight" : "")"
                         draggable="true"
                         @onclick="() => OnTaskClick.InvokeAsync(t)"
                         @ondragstart="e => OnDragStart(t.Id, e)"
                         @ondragover:preventDefault="true"
                         @ondragend="() => draggingTaskId = null">
                        @{ var pp = ProjectUiHelpers.GetPriorityPill(t.Priority); var dueState = ProjectUiHelpers.GetDueState(t); }
                        <div class="kc-top">
                            <button type="button" class="task-card-check @(t.Status == "done" ? "done" : "")"
                                    @onclick="() => OnToggleComplete.InvokeAsync(t)"
                                    @onclick:stopPropagation="true"
                                    aria-label="@(t.Status == "done" ? "Mark incomplete" : "Mark completed")"
                                    title="@(t.Status == "done" ? "Mark incomplete" : "Mark completed")">
                                @if (t.Status == "done")
                                {
                                    <i data-lucide="check"></i>
                                }
                            </button>
                            @if (!string.IsNullOrWhiteSpace(t.Priority))
                            {
                                <span class="v6-pri @pp.Key"><i data-lucide="@pp.Icon"></i>@pp.Label</span>
                            }
                            @if (isOverdue)
                            {
                                <span class="kc-pill danger">Overdue</span>
                            }
                            @if (evidence.IsExtended)
                            {
                                <span class="kc-pill info" title="@evidence.LatestExtension?.Reason">Extended ×@evidence.ExtensionHistory.Count</span>
                            }
                            @if (t.IsBlocked)
                            {
                                <span class="kc-pill blocked" title="Menunggu task lain selesai"><i data-lucide="lock"></i>Menunggu</span>
                            }
                            <div class="kc-spacer"></div>
                            <div class="kc-more-wrap" @onclick:stopPropagation="true">
                                <button type="button" class="kc-more" data-menu-trigger title="More" aria-label="More actions" aria-haspopup="menu" aria-expanded="@(moreTaskId == t.Id ? "true" : "false")" @onclick="() => ToggleMore(t.Id)">
                                    <i data-lucide="ellipsis"></i>
                                </button>
                                @if (moreTaskId == t.Id)
                                {
                                    <div class="kc-menu-backdrop" @onclick="() => moreTaskId = null"></div>
                                    <div class="kc-menu" role="menu" aria-label="Task actions" @ref="menuRef">
                                        <button type="button" role="menuitem" @onclick="() => RunMore(() => OnTaskClick.InvokeAsync(t))"><i data-lucide="square-pen"></i>Open details</button>
                                        <button type="button" role="menuitem" @onclick="() => { moreTaskId = null; quickAssignTaskId = t.Id; }"><i data-lucide="user-plus"></i>Assign members</button>
                                        <button type="button" role="menuitem" @onclick="() => RunMore(() => OnToggleComplete.InvokeAsync(t))"><i data-lucide="circle-check"></i>@(t.Status == "done" ? "Mark incomplete" : "Mark complete")</button>
                                        @* Touch has no drag-and-drop: phones move cards from here (hidden on desktop by css/mobile/projects.css). *@
                                        <div class="kc-move-head" aria-hidden="true">Move to…</div>
                                        @foreach (var (key, label) in MoveTargets)
                                        {
                                            if (key == t.Status) continue;
                                            <button type="button" role="menuitem" class="kc-move" aria-label="Move to @label" @onclick="() => RunMore(() => OnTaskMove.InvokeAsync((t.Id, key)))"><span class="col-dot @key"></span>@label</button>
                                        }
                                        @if (Groups.Count > 1)
                                        {
                                            <div class="kc-move-head" aria-hidden="true">Move to group…</div>
                                            @foreach (var group in Groups.Where(g => g.Id != t.GroupId))
                                            {
                                                <button type="button" role="menuitem" @onclick="() => RunMore(() => OnMoveToGroup.InvokeAsync((t.Id, group.Id)))"><span class="portfolio-group-dot" style="background:@group.Color"></span>@group.Name</button>
                                            }
                                        }
                                        @if (t.DueDate.HasValue && t.Status != "done")
                                        {
                                            <button type="button" role="menuitem" class="@(isOverdue ? "warn" : "")" @onclick="() => RunMore(() => OnRequestExtension.InvokeAsync(t))"><i data-lucide="clock-alert"></i>Request extension</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <h4 class="task-card-title">@t.Title</h4>

                        @if (!string.IsNullOrWhiteSpace(t.Tags))
                        {
                            <div class="task-card-tags">
                                @foreach (var tag in t.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="task-tag">#@tag.TrimStart('#')</span>
                                }
                            </div>
                        }

                        @if (t.SubtaskCount > 0)
                        {
                            <div class="kc-sub">
                                <div class="kc-sub-bar"><div style="width:@(t.SubtaskDoneCount * 100 / t.SubtaskCount)%"></div></div>
                                <span><i data-lucide="list-checks"></i>@t.SubtaskDoneCount/@t.SubtaskCount</span>
                            </div>
                        }

                        <div class="kc-foot">
                            @if (t.DueDate.HasValue)
                            {
                                <span class="kc-due @dueState"><i data-lucide="calendar"></i>@t.DueDate.Value.ToString("MMM d")</span>
                            }
                            @if (t.CommentCount > 0)
                            {
                                <span class="kc-meta" title="@($"{t.CommentCount} comments")"><i data-lucide="message-square"></i>@t.CommentCount</span>
                            }
                            @if (t.AttachmentCount > 0)
                            {
                                <span class="kc-meta" title="@($"{t.AttachmentCount} attachments")"><i data-lucide="paperclip"></i>@t.AttachmentCount</span>
                            }
                            @if (t.HasReminder)
                            {
                                <span class="kc-meta accent" title="Due reminder active"><i data-lucide="bell-ring"></i></span>
                            }
                            <div class="kc-spacer"></div>

                            @* Assignee Avatars & Quick Assign Button *@
                            <div class="task-card-assign-wrap">
                                @if (t.Assignees.Count > 0)
                                {
                                    <button type="button" class="kc-avs" data-menu-trigger aria-haspopup="dialog" aria-expanded="@(quickAssignTaskId == t.Id ? "true" : "false")" title="@string.Join(", ", t.Assignees.Select(a => a.Name))"
                                            @onclick="() => ToggleQuickAssign(t.Id)" @onclick:stopPropagation="true">
                                        @foreach (var a in t.Assignees.Take(3))
                                        {
                                            <span class="kc-av" style="background:@ProjectUiHelpers.GetAvatarBg(a.Name)">@ProjectUiHelpers.GetInitials(a.Name)</span>
                                        }
                                        @if (t.Assignees.Count > 3)
                                        {
                                            <span class="kc-av more">+@(t.Assignees.Count - 3)</span>
                                        }
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="kc-assign" data-menu-trigger aria-haspopup="dialog" aria-expanded="@(quickAssignTaskId == t.Id ? "true" : "false")"
                                            @onclick="() => ToggleQuickAssign(t.Id)"
                                            @onclick:stopPropagation="true"
                                            title="Assign team member">
                                        <i data-lucide="user-plus"></i>Assign
                                    </button>
                                }

                                @* Quick Assign Popover *@
                                @if (quickAssignTaskId == t.Id)
                                {
                                    <div class="kc-menu-backdrop" @onclick="() => quickAssignTaskId = null" @onclick:stopPropagation="true"></div>
                                    <div class="quick-assign-popover" role="dialog" aria-label="Assign member" @ref="menuRef" @onclick:stopPropagation="true">
                                        <div class="quick-assign-popover-head">
                                            <span>Assign Member</span>
                                            <button type="button" aria-label="Close" style="background:none;border:none;cursor:pointer;padding:2px;color:var(--ink-3);display:flex;align-items:center" @onclick="() => quickAssignTaskId = null">
                                                <i data-lucide="x" style="width:12px;height:12px"></i>
                                            </button>
                                        </div>
                                        <div class="quick-assign-popover-list">
                                            @if (Members.Count == 0)
                                            {
                                                <div class="quick-assign-empty">No team members in this project.</div>
                                            }
                                            else
                                            {
                                                @foreach (var m in Members)
                                                {
                                                    var isAssigned = t.Assignees.Any(a => a.UserId == m.UserId);
                                                    <div class="quick-assign-item @(isAssigned ? "assigned" : "")" role="menuitemcheckbox" tabindex="-1" aria-checked="@(isAssigned ? "true" : "false")"
                                                         @onclick="() => OnToggleAssignee.InvokeAsync((t.Id, m.UserId, isAssigned))">
                                                        <div class="team-avatar-circ" style="width:22px;height:22px;font-size:9.5px;background:@ProjectUiHelpers.GetAvatarBg(m.Name)">
                                                            @ProjectUiHelpers.GetInitials(m.Name)
                                                        </div>
                                                        <div class="quick-assign-item-info">
                                                            <div class="name">@m.Name</div>
                                                            <div class="role">@m.Role · @m.Nik</div>
                                                        </div>
                                                        @if (isAssigned)
                                                        {
                                                            <i data-lucide="check" style="width:13px;height:13px;color:var(--accent);flex-shrink:0"></i>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                }

            </div>

            @if (quickAddColumn != statusKey)
            {
                <div class="kanban-col-quick-add">
                    <button type="button" class="col-quick-btn" @onclick="() => StartQuickAdd(statusKey)">
                        <i data-lucide="plus" style="width:13px;height:13px"></i> Add task
                    </button>
                </div>
            }
        </div>;
    }
}
