    private static DateTime NextFriday()
    {
        var d = DateTime.Today;
        var add = ((int)DayOfWeek.Friday - (int)d.DayOfWeek + 7) % 7;
        return d.AddDays(add == 0 ? 7 : add);
    }

    private void SetPhoneEstimate(decimal? value) { editEstH = value; SaveSoon(); }
    private void SetDue(DateTime? v) { editDue = v; SaveSoon(); }
    private void SetStart(DateTime? v) { editStartDate = v; SaveSoon(); }
    private void SetPriority(string key) { editPriority = key == "" ? null : key; SaveSoon(); }

    /// Debounced: typing in the title/description saves 700 ms after the last change.
    private void SaveSoon()
    {
        if (ReadOnly || Task is null) return;
        saveCts?.Cancel();
        var cts = saveCts = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try { await System.Threading.Tasks.Task.Delay(700, cts.Token); }
            catch (OperationCanceledException) { return; }
            if (!cts.IsCancellationRequested) await SaveNowAsync();
        });
    }

    /// Saves pending edits now. False when the save failed (caller stays on this task).
    private async Task<bool> FlushAsync()
    {
        saveCts?.Cancel();
        return !IsDirty || await SaveNowAsync();
    }

    private async Task<bool> SaveNowAsync()
    {
        if (ReadOnly || Task is null || !IsDirty) return true;
        if (string.IsNullOrWhiteSpace(editTitle)) { editTitle = Task.Title; return true; }
        saveState = "saving";
        StateHasChanged();
        var model = new TaskSaveModel(Task.Id, editTitle.Trim(), TaskEvidenceHelper.Serialize(editDesc, evidence), Task.Status,
            editPriority, editStartDate, editDue, editEstH, editActH, editTags?.Trim());
        try
        {
            lastAutoSaveOk = false;
            await OnAutoSave.InvokeAsync(model);
            saveState = lastAutoSaveOk ? "saved" : "error";
        }
        catch { saveState = "error"; }
        StateHasChanged();
        return saveState == "saved";
    }

    /// The page reports the outcome of OnAutoSave here (EventCallback has no return value).
    private bool lastAutoSaveOk;
    public void ReportSaved(bool ok) => lastAutoSaveOk = ok;

    private async Task CloseDrawer()
    {
        await FlushAsync();
        await OnClose.InvokeAsync();
