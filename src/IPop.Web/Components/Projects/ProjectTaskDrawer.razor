        var finalDesc = TaskEvidenceHelper.Serialize(editDesc, evidence);
        var model = new TaskSaveModel(
            Task.Id,
            editTitle.Trim(),
            finalDesc,
            editStatus,
            editPriority,
            editStartDate,
            editDue,
            editEstH,
            editActH,
