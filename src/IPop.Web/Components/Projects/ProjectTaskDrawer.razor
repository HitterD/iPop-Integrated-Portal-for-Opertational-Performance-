    private Task DeleteFromMenu() { if (ReadOnly) return System.Threading.Tasks.Task.CompletedTask; moreOpen = false; return Task is null ? System.Threading.Tasks.Task.CompletedTask : OnDelete.InvokeAsync(Task.Id); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (focusTitle) { focusTitle = false; await titleRef.FocusAsync(); await JS.InvokeVoidAsync("ipop.selectFocused"); }
            selfRef ??= DotNetObjectReference.Create(this);
            var open = Task is not null;
            if (open != keysBound)
            {
                keysBound = open;
                await JS.InvokeVoidAsync("ipop.taskDrawerKeys", open ? selfRef : null);
            }
            var menuOpen = Task is not null && (moreOpen || assignOpen || depOpen);
            if (menuOpen) await JS.InvokeVoidAsync("ipop.menuSync", menuRef, selfRef, moreOpen ? "right" : "left");
            else if (menuPortaled) await JS.InvokeVoidAsync("ipop.menuClose");
            menuPortaled = menuOpen;
