    );

    /// A private 1-hour block an hour before the due time (or tomorrow 09:00 when there's no due date).
    private string BlockTimeLink()
    {
        var due = Task?.DueDate;
        DateTime start;
        if (due is { } d && d.TimeOfDay != TimeSpan.Zero) start = d.ToLocalTime().AddHours(-1);
        else if (due is { } dd) start = dd.Date.AddHours(9);
        else start = DateTime.Today.AddDays(1).AddHours(9);
        if (start < DateTime.Now) start = DateTime.Now.Date.AddHours(Math.Min(DateTime.Now.Hour + 1, 23));
        return CalLinks.NewMeeting($"Work on: {Task?.Title}", start: start, minutes: 60, isPrivate: true, notes: TaskNote(), from: "Focus time for a task");
    }

    private string TaskNote() => Task is null ? "" : $"Task: {Task.Title}" + Environment.NewLine + Nav.ToAbsoluteUri($"/projects/{Task.ProjectId}?task={Task.Id}");
