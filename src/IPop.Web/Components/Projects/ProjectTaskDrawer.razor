        await LoadDiscussionAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void DownloadAttachment(TaskAttachments.TaskAttachmentItem att)
    {
        if (Task is null || att.DownloadPath is null) return;
        var sep = att.DownloadPath.IndexOf(':');
        if (sep < 0) return;
        var server = att.DownloadPath[..sep];
        var path = att.DownloadPath[(sep + 1)..];
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(path)}&inline=false");
            if (res.IsSuccessStatusCode)
            {
                var bytes = await res.Content.ReadAsByteArrayAsync();
                await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), att.Name);
            }
        }
        catch { }
    }

    private async void DeleteAttachment(TaskAttachments.TaskAttachmentItem att)
    {
        if (ReadOnly) return;
        if (Task is null) return;
        try
        {
            await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/tasks/{Task.Id}/attachments/{att.Id}");
            attachmentItems.RemoveAll(a => a.Id == att.Id);
            await LoadDiscussionAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private TaskEvidenceData evidence = new();

    // The task the edit fields were last filled from. A parent re-render with the same instance
    // changes nothing; a new instance of the same task (live refresh after someone else's edit)
    // refreshes discussion and merges only the fields this user hasn't touched; a different task
    // resets the drawer.
    private ProjectTaskDto? _shownTask;

    protected override async Task OnParametersSetAsync()
    {
        if (Task is null) { _shownTask = null; return; }
        if (ReferenceEquals(Task, _shownTask)) return;
        var previous = _shownTask;
        _shownTask = Task;

        if (previous is not null && previous.Id == Task.Id)
        {
            await LoadDiscussionAsync(); // live comments, attachments and activity
            MergeRemoteTask(previous, Task);
            await RestoreEvidencePhotosAsync();
            return;
        }

        {
            moreOpen = false;
            assignOpen = false;
            depOpen = false;
            depError = recurError = null;
            LoadRecurrence(Task);
            newTag = "";
            editTitle = Task.Title;
            drawerTab = "detail";
            saveState = "";
            saveCts?.Cancel();
            optionsOpen = false;
            progressOpen = Task.Status is "doing" or "review" or "done";
            if (TakeFocusTitle) { TakeFocusTitle = false; focusTitle = true; }
            files = [];
            viewerFile = null;
            await LoadDiscussionAsync();
            await LoadRemindersAsync();
            var parsed = TaskEvidenceHelper.Parse(Task.Description);
            editDesc = parsed.CleanDescription;
            evidence = parsed.Evidence;
            editStatus = Task.Status;
            editPriority = Task.Priority;
            editStartDate = Task.StartDate;
            editDue = Task.DueDate;
            editEstH = Task.EstimatedHours;
            editActH = Task.ActualHours;
            editTags = Task.Tags;
            newStepText = "";

            await RestoreEvidencePhotosAsync();
        }
    }

    /// Field-level merge: a field still equal to the old server value takes the new one; a field
    /// the user has changed keeps their input.
    private void MergeRemoteTask(ProjectTaskDto old, ProjectTaskDto fresh)
    {
        if (editTitle == old.Title) editTitle = fresh.Title;
        editStatus = fresh.Status;
        if (editPriority == old.Priority) editPriority = fresh.Priority;
        if (editStartDate == old.StartDate) editStartDate = fresh.StartDate;
        if (editDue == old.DueDate) editDue = fresh.DueDate;
        if (editEstH == old.EstimatedHours) editEstH = fresh.EstimatedHours;
        editActH = fresh.ActualHours; // read-only: the sum of time entries
        if (editTags == old.Tags) editTags = fresh.Tags;
        if (!recurBusy) LoadRecurrence(fresh);
        var oldParsed = TaskEvidenceHelper.Parse(old.Description);
        if (TaskEvidenceHelper.Serialize(editDesc, evidence) == TaskEvidenceHelper.Serialize(oldParsed.CleanDescription, oldParsed.Evidence))
        {
            var parsed = TaskEvidenceHelper.Parse(fresh.Description);
            editDesc = parsed.CleanDescription;
            evidence = parsed.Evidence;
        }
    }

    // ── Evidence files on the shared project store (all members see them) ──

    private List<TaskFiles.TaskFileDto> files = [];
    private IPop.Application.Chat.AttachmentDto? viewerFile;
    private IReadOnlyList<IPop.Application.Chat.AttachmentDto>? viewerSiblings;

    private IReadOnlyList<TaskFiles.TaskFileDto> FilesOf(string kind) => files.Where(f => f.Kind == kind).ToList();

    private Guid? MyUserId => Auth.Me?.Nik is { } nik ? Members.FirstOrDefault(m => m.Nik == nik)?.UserId : null;
    private bool IsProjectOwner => Auth.Me?.Nik is { } nik && Members.Any(m => m.Nik == nik && m.Role == "owner");

    private async Task LoadFilesAsync()
    {
        if (Task is null) return;
        var id = Task.Id;
        var rows = await Auth.GetAsync<List<TaskFiles.TaskFileDto>>($"/api/projects/tasks/{id}/files");
        if (Task?.Id != id) return;
        files = rows ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private void OpenViewer((IPop.Application.Chat.AttachmentDto Open, IReadOnlyList<IPop.Application.Chat.AttachmentDto> All) pick)
    {
        viewerSiblings = pick.All;
        viewerFile = pick.Open;
    }

    /// Evidence saved before files moved to the server, still held in this browser.
    private static IReadOnlyList<TaskEvidenceItem> LegacyOf(List<TaskEvidenceItem> items) =>
        items.Where(i => !string.IsNullOrEmpty(i.DataUrl)).ToList();

    /// Header badge: what the task's real status says about this evidence block.
    private RenderFragment EvidenceBadge(bool completion) => __builder =>
    {
        var (css, text) = (editStatus, completion) switch
        {
            ("done", _) => ("done", "Done"),
            (_, true) when editStatus == "review" => ("doing", "In review"),
            (_, true) => ("todo", "When finished"),
            ("todo", false) => ("todo", "Not started"),
            _ => ("doing", "In progress"),
        };
        <span class="task-evidence-badge @css">@text</span>
    };

    /// Evidence that only ever lived in this browser goes to the server the first time its
    /// uploader opens the task again; after that every member sees it.
    private async Task MigrateLegacyEvidenceAsync()
    {
        if (ReadOnly) return;
        if (Task is null) return;
        var taskId = Task.Id;
        var moved = 0;
        foreach (var (list, kind) in new[] { (evidence.FieldPhotos, "field"), (evidence.CompletionDeliverables, "deliverable") })
        {
            foreach (var item in list.Where(i => !string.IsNullOrEmpty(i.DataUrl)).ToList())
            {
                var comma = item.DataUrl!.IndexOf(',');
                var semi = item.DataUrl.IndexOf(';');
                if (comma < 0 || semi < 5) continue;
                try
                {
                    var bytes = Convert.FromBase64String(item.DataUrl[(comma + 1)..]);
                    var body = new ByteArrayContent(bytes);
                    body.Headers.ContentType = new(item.DataUrl[5..semi]);
                    var form = new MultipartFormDataContent { { body, "file", item.Name } };
                    using var res = await Auth.SendMultipartAsync($"/api/projects/tasks/{taskId}/files?kind={kind}", form);
                    if (!res.IsSuccessStatusCode) continue;
                    list.Remove(item);
                    await Auth.RemoveUserSettingAsync($"ipop_evidence_{item.Id}");
                    moved++;
                }
                catch { /* stays local; retried next time */ }
                if (Task?.Id != taskId) return;
            }
        }
        if (moved == 0) return;
        // The JSON block no longer lists the moved items; save it so other members stop seeing ghosts.
        await OnSaveEvidenceOnly.InvokeAsync((taskId, TaskEvidenceHelper.Serialize(editDesc, evidence)));
        await LoadFilesAsync();
    }

    private async Task RestoreEvidencePhotosAsync()
    {
        {
            // Restore photos dataUrl from localStorage if available
            foreach (var photo in evidence.FieldPhotos)
            {
                if (string.IsNullOrEmpty(photo.DataUrl))
                {
                    try
                    {
                        photo.DataUrl = await Auth.GetUserSettingAsync($"ipop_evidence_{photo.Id}");
                    }
                    catch {}
                }
            }
            foreach (var item in evidence.CompletionDeliverables)
            {
                if (string.IsNullOrEmpty(item.DataUrl) && item.Type == "photo")
                {
                    try
                    {
                        item.DataUrl = await Auth.GetUserSettingAsync($"ipop_evidence_{item.Id}");
                    }
                    catch {}
                }
            }
        }
        await MigrateLegacyEvidenceAsync();
    }

    private void AddProgressStep()
    {
        if (ReadOnly) return;
        if (string.IsNullOrWhiteSpace(newStepText)) return;
        evidence.ProgressSteps.Add(new TaskProgressStep
        {
            Text = newStepText.Trim(),
            IsDone = false
        });
        newStepText = "";
        SaveSoon();
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    // ── Autosave (approved 2026-10-11): every edit saves itself shortly after it is made ──
    [Parameter] public EventCallback<TaskSaveModel> OnAutoSave { get; set; }
