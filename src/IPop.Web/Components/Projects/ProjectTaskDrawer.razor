    // ---- Fase 2b: dependensi ("Menunggu") dan pengulangan ("Ulangi"), disimpan langsung ----
    private bool depOpen;
    private bool depBusy;
    private string depQuery = "";
    private string? depError;

    private IEnumerable<ProjectTaskDto> DependencyCandidates
    {
        get
        {
            if (Task is null) return [];
            var taken = (Task.DependsOn ?? []).Select(d => d.Id).ToHashSet();
            var q = depQuery.Trim();
            return AllTasks.Where(t => t.Id != Task.Id && t.Id != Task.ParentTaskId && !taken.Contains(t.Id)
                    && (q.Length == 0 || t.Title.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(t => t.Status == "done").ThenBy(t => t.Title, StringComparer.OrdinalIgnoreCase);
        }
    }

    private Task AddDependency(Guid id)
    {
        depOpen = false;
        return SaveDependencies((Task?.DependsOn ?? []).Select(d => d.Id).Append(id).ToList());
    }

    private Task RemoveDependency(Guid id) =>
        SaveDependencies((Task?.DependsOn ?? []).Select(d => d.Id).Where(x => x != id).ToList());

    private async Task SaveDependencies(List<Guid> ids)
    {
        if (ReadOnly) return;
        if (Task is null || depBusy) return;
        depBusy = true;
        depError = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{Task.Id}/dependencies", new SetTaskDependenciesRequest(ids));
            if (res.IsSuccessStatusCode)
            {
                ProjectTaskDto? fresh = null;
                try { fresh = await res.Content.ReadFromJsonAsync<ProjectTaskDto>(); } catch { }
                await OnTaskChanged.InvokeAsync(fresh);
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                depError = body.Contains("dependency_cycle") ? "Not allowed: that task already waits on this one (indirectly)."
                    : body.Contains("too_many_dependencies") ? "A task can have at most 20 dependencies."
                    : body.Contains("forbidden") ? "You don't have access to change this task."
                    : "Couldn't save the dependency.";
            }
        }
        catch { depError = "Couldn't save the dependency."; }
        finally { depBusy = false; }
    }

    private static readonly (string Freq, string Label)[] RecurFreqs =
        [("", "Never"), ("DAILY", "Daily"), ("WEEKLY", "Weekly"), ("MONTHLY", "Monthly")];
    private string recurFreq = "";
    private HashSet<DayOfWeek> recurDays = [];
    private int recurMonthDay = 1;
    private bool recurBusy;
    private string? recurError;

    private void LoadRecurrence(ProjectTaskDto t)
    {
        var rule = t.IsRecurring ? TaskRecurrence.Parse(t.RecurrenceRule) : null;
        recurFreq = rule?.Freq ?? "";
        recurDays = rule?.ByDay.ToHashSet() ?? [];
        recurMonthDay = rule?.ByMonthDay ?? (t.DueDate ?? DateTime.Today).Day;
    }

    private string? CurrentRule()
    {
        if (recurFreq == "") return null;
        var rule = new TaskRecurrence(recurFreq, 1,
            recurFreq == "WEEKLY" ? recurDays.OrderBy(d => d).ToList() : [],
            recurFreq == "MONTHLY" ? recurMonthDay : null);
        return rule.ToString();
    }

    private DateTime? RecurNextPreview =>
        Task is null || CurrentRule() is not { } rule || TaskRecurrence.Parse(rule) is not { } parsed
            ? null
            : parsed.Next(Task.DueDate ?? DateTime.Today);

    private Task SetRecurFreq(string freq)
    {
        if (recurFreq == freq) return System.Threading.Tasks.Task.CompletedTask;
        recurFreq = freq;
        if (freq == "WEEKLY" && recurDays.Count == 0) recurDays = [(Task?.DueDate ?? DateTime.Today).DayOfWeek];
        return SaveRecurrence();
    }

    private Task ToggleRecurDay(DayOfWeek day)
    {
        if (!recurDays.Remove(day)) recurDays.Add(day);
        // Weekly with no day picked means "every 7 days from the due date".
        return SaveRecurrence();
    }

    private Task SetRecurMonthDay(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var d)) return System.Threading.Tasks.Task.CompletedTask;
        recurMonthDay = Math.Clamp(d, 1, 31);
        return SaveRecurrence();
    }

    private async Task SaveRecurrence()
    {
        if (ReadOnly) return;
        if (Task is null) return;
        recurBusy = true;
        recurError = null;
        try
        {
            var rule = CurrentRule();
            var req = new UpdateTaskRequest(null, null, null, null, null, null, null, null, null, null,
                rule is not null, rule ?? "", null, null);
            var res = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{Task.Id}", req);
            if (res.IsSuccessStatusCode)
            {
                ProjectTaskDto? fresh = null;
                try { fresh = await res.Content.ReadFromJsonAsync<ProjectTaskDto>(); } catch { }
                await OnTaskChanged.InvokeAsync(fresh);
            }
            else
            {
                recurError = "Couldn't save the repeat setting.";
                LoadRecurrence(Task);
            }
        }
        catch { recurError = "Couldn't save the repeat setting."; }
        finally { recurBusy = false; }
    }

