@using IPop.Application.Projects

<div class="proj-modal-backdrop" @onclick="OnClose"></div>
<div class="proj-modal v6-project-modal" role="dialog" aria-modal="true" aria-label="Edit Project">
    <div class="proj-modal-head">
        <span class="vpm-tile" style="background:@selectedColor">@ProjectUiHelpers.GetInitials(editProjName)</span>
        <span>Edit project</span>
        <button type="button" class="vpm-close" @onclick="OnClose" aria-label="Close"><i data-lucide="x"></i></button>
    </div>
    <div class="proj-modal-body">
        <div class="field"><label>Project name <span class="vpm-required">*</span></label><input class="org-input" @bind="editProjName" placeholder="Project name" /></div>
        <div class="field"><label>Description</label><textarea class="org-input" rows="2" @bind="editProjDesc" placeholder="What is this project about?"></textarea></div>
        <div class="vpm-grid">
            <div class="field"><label>Year</label><input type="number" class="org-input" @bind="editProjYear" /></div>
            <div class="field"><label>Deadline</label><AppDatePicker @bind-Value="editProjDeadline" AllowClear="true" AriaLabel="Deadline" /></div>
        </div>
        <div class="vpm-grid">
            <div class="field"><label>Status</label><AppSelect Value="@editProjStatus" ValueChanged="v => editProjStatus = v ?? editProjStatus" Options="StatusOptions" Label="Status" CssClass="proj-edit-status" Block="true" /></div>
            <div class="field"><label>Start date</label><AppDatePicker @bind-Value="editProjStartDate" AllowClear="true" AriaLabel="Start date" /></div>
        </div>
        <div class="field">
            <label>Color</label>
            <div style="display:flex;align-items:center;gap:10px;margin-top:2px">
                @foreach (var c in PaletteColors)
                {
                    var col = c;
                    var isSelected = selectedColor.Equals(col, StringComparison.OrdinalIgnoreCase);
                    <button type="button" style="width:28px;height:28px;border-radius:50%;border:none;background:@col;cursor:pointer;box-shadow:@(isSelected ? $"0 0 0 2px var(--surface), 0 0 0 4px {col}" : "none");transition:box-shadow .15s ease"
                            @onclick="() => selectedColor = col" aria-label="Choose color @col"></button>
                }
            </div>
        </div>
    </div>
    <div class="proj-modal-foot"><button type="button" class="btn-sm surface" @onclick="OnClose">Cancel</button><button type="button" class="btn-sm accent" @onclick="HandleSubmit"><i data-lucide="check"></i>Save changes</button></div>
</div>

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EditProjectModel> OnSubmit { get; set; }

    private string editProjName = "";
    private string selectedColor = "#2E9E5B";
    private string editProjStatus = "doing";
    private static List<AppOption>? statusOptions;
    private static List<AppOption> StatusOptions => statusOptions ??= [new("planning", "Planning"), new("doing", "Active / Doing"), new("on_hold", "On hold"), new("completed", "Done")];
    private int editProjYear = DateTime.UtcNow.Year;
    private DateTime? editProjStartDate;
    private DateTime? editProjDeadline;
    private string? editProjDesc;

    private static readonly string[] PaletteColors = ["#2E9E5B", "#0A84FF", "#7657C4", "#FF9F0A", "#C0513A", "#18808A"];

    // Filled once per project: live refreshes replace the Project instance and must not wipe
    // what the user is typing.
    private Guid? _initFor;

    protected override void OnParametersSet()
    {
        if (Project is not null && _initFor != Project.Id)
        {
            _initFor = Project.Id;
            editProjName = Project.Name;
            selectedColor = !string.IsNullOrWhiteSpace(Project.Color) ? Project.Color : "#2E9E5B";
            editProjStatus = Project.Status;
            editProjYear = Project.Year;
            editProjStartDate = Project.StartDate;
            editProjDeadline = Project.Deadline;
            editProjDesc = Project.Description;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(editProjName)) return;
        var model = new EditProjectModel(
            Project.Id,
            editProjName.Trim(),
            editProjStatus,
            editProjYear,
            editProjStartDate,
            editProjDeadline,
            editProjDesc?.Trim(),
            selectedColor
        );
        await OnSubmit.InvokeAsync(model);
    }

    public record EditProjectModel(
        Guid Id,
        string Name,
        string Status,
        int Year,
        DateTime? StartDate,
        DateTime? Deadline,
        string? Description,
        string? Color = null
    );
}
