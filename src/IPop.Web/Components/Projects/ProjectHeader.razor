@using IPop.Application.Projects
@inject IPop.Web.Services.CalendarLinks CalLinks
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPop.Web.Services.AuthState Auth
@inject IPop.Web.Services.ToastService Toasts

<div class="proj-canvas-head">
    <div class="proj-title-box">
        <button type="button" class="m-back" aria-label="Back" title="All projects" @onclick="OnBack"><i data-lucide="chevron-left"></i></button>
        <span class="proj-tile lg" style="background:@(!string.IsNullOrWhiteSpace(Project.Color) ? Project.Color : ProjectUiHelpers.GetAvatarBg(Project.Name))">@ProjectUiHelpers.GetInitials(Project.Name)</span>
        <div class="proj-title-col">
        <div class="proj-title-row">
        <h2 class="proj-title-text">@Project.Name</h2>
        <AppSelect Value="@Project.Status" ValueChanged="HandleStatusChange" Options="StatusOptions" Label="Project status" CssClass="@($"proj-st-select proj-st {Project.Status.ToLower()}")" />
        </div>
        <div class="proj-title-sub">
            @if (!string.IsNullOrWhiteSpace(Project.Description)) { <span class="desc">@Project.Description</span> }
            <span>@Project.Progress% complete</span>
            @if (Project.Deadline.HasValue) { <span>Due @Project.Deadline.Value.ToString("dd MMM yyyy")</span> }
        </div>
        </div>
    </div>

    @* Head Actions *@
    <div class="proj-head-actions">
        @* Team avatars pile *@
        <div class="proj-team-pile" @onclick="OnOpenTeamModal" style="cursor:pointer" title="Manage Team Members (@Members.Count members)">
            @foreach (var m in Members.Take(4))
            {
                <PersonAvatar Nik="@m.Nik" Name="@m.Name" Size="30" Class="team-avatar-circ" Title="@($"{m.Name} ({m.Role})")" />
            }
            @if (Members.Count > 4)
            {
                <div class="team-avatar-circ" style="background:var(--ink-3);font-size:9px">
                    +@(Members.Count - 4)
                </div>
            }
        </div>
        <button type="button" class="team-add-circ" title="Add Member" aria-label="Add member" @onclick="OnOpenTeamModal">
            <i data-lucide="plus"></i>
        </button>

        @* Chat Interconnect *@
        <button type="button" class="icon-btn proj-hbtn pm-fold" @onclick="OnOpenChatRoom" title="Open project chat" aria-label="Open project chat">
            <i data-lucide="message-circle"></i>
        </button>

        <button type="button" class="icon-btn proj-hbtn" title="Meeting with project members" aria-label="Meeting with project members" @onclick="ScheduleTeam"><i data-lucide="calendar-plus"></i></button>

        @* Edit Project Button *@
        <button type="button" class="icon-btn proj-hbtn pm-fold" @onclick="OnOpenEditModal" title="Edit project" aria-label="Edit project">
            <i data-lucide="pencil"></i>
        </button>

        @* Export Snapshot *@
        <button type="button" class="icon-btn proj-hbtn pm-fold" @onclick="OnExport" title="Export snapshot" aria-label="Export snapshot">
            <i data-lucide="download"></i>
        </button>

        @* More actions dropdown *@
        <div style="position:relative">
            <button type="button" class="icon-btn proj-hbtn" title="More options" aria-label="More options" @onclick="() => showMore = !showMore">
                <i data-lucide="more-horizontal"></i>
            </button>
            @if (showMore)
            {
                <div class="app-select-pop on proj-more-pop" style="right:0;top:38px;width:180px;z-index:100" @onclick:stopPropagation="true">
                    @* Phone only: the chat/edit/export buttons fold into this menu (css/mobile/projects.css). *@
                    <button type="button" class="app-select-opt pm-only" @onclick="() => Run(OnOpenChatRoom)"><i data-lucide="message-circle" style="width:13px;height:13px"></i> Open project chat</button>
                    <button type="button" class="app-select-opt pm-only" @onclick="() => Run(OnOpenEditModal)"><i data-lucide="pencil" style="width:13px;height:13px"></i> Edit project</button>
                    <button type="button" class="app-select-opt pm-only" @onclick="() => Run(OnExport)"><i data-lucide="download" style="width:13px;height:13px"></i> Export snapshot</button>
                    <button type="button" class="app-select-opt" @onclick="CopyLink"><i data-lucide="link" style="width:13px;height:13px"></i> Copy link</button>
                    <button type="button" class="app-select-opt" @onclick="OpenSaveTemplate"><i data-lucide="layout-template" style="width:13px;height:13px"></i> Save as template…</button>
                    <button type="button" class="app-select-opt" @onclick="MarkDone"><i data-lucide="check-circle" style="width:13px;height:13px"></i> Mark completed</button>
                    <button type="button" class="app-select-opt" style="color:var(--danger)" @onclick="Delete"><i data-lucide="trash-2" style="width:13px;height:13px"></i> Delete project</button>
                </div>
            }
        </div>
    </div>
</div>

@if (saveTplOpen)
{
    <div class="rep-scrim" @onclick="CloseSaveTemplate">
        <div class="rep-sheet sm" role="dialog" aria-modal="true" aria-labelledby="ph-tpl-title" @onclick:stopPropagation="true">
            <header>
                <span class="hi c-acc"><i data-lucide="layout-template"></i></span>
                <div>
                    <h3 id="ph-tpl-title">Save as template</h3>
                    <p>Reuse this project's task list for new projects. Nothing in "@Project.Name" changes.</p>
                </div>
            </header>
            <div class="bdy">
                <div class="fld @(tplShake > 0 ? "mi-shake" : "")" @key="@($"tn{tplShake}")">
                    <label for="ph-tpl-name">Template name</label>
                    <input id="ph-tpl-name" class="inp @(tplNameErr ? "err" : "")" maxlength="200" value="@tplName"
                           @oninput="e => { tplName = e.Value?.ToString() ?? string.Empty; tplNameErr = false; }" />
                </div>
                <div class="fld">
                    <label for="ph-tpl-desc">Description <span>(optional)</span></label>
                    <textarea id="ph-tpl-desc" class="inp" rows="2" maxlength="1000" placeholder="What is this template for?"
                              @oninput="e => tplDesc = e.Value?.ToString() ?? string.Empty">@tplDesc</textarea>
                </div>
                <div class="note"><i data-lucide="info"></i><span>Includes the titles, descriptions and priorities of top-level tasks. Assignees, dates, comments and files are not copied. Find it in <b>New project → Template</b>.</span></div>
            </div>
            <footer>
                <button type="button" class="rep-btn" @onclick="CloseSaveTemplate">Cancel</button>
                <button type="button" class="rep-btn pri" disabled="@tplSaving" @onclick="SaveTemplateAsync"><i data-lucide="layout-template"></i>@(tplSaving ? "Saving…" : "Save template")</button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public List<ProjectMemberDto> Members { get; set; } = [];

    [Parameter] public EventCallback OnOpenTeamModal { get; set; }
    [Parameter] public EventCallback OnOpenEditModal { get; set; }
    [Parameter] public EventCallback OnOpenChatRoom { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public EventCallback OnCopyLink { get; set; }
    [Parameter] public EventCallback OnDeleteProject { get; set; }
    [Parameter] public EventCallback OnMarkCompleted { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private bool showMore;

    // Menus/sheets in here re-render without the page: draw their Lucide icons.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void ScheduleTeam() => Nav.NavigateTo(CalLinks.NewMeeting($"{Project.Name} meeting", Members.Select(m => m.Nik), from: $"From project {Project.Name}"));

    private static List<AppOption>? statusOptions;
    private static List<AppOption> StatusOptions => statusOptions ??= [new("planning", "Planning"), new("active", "Active"), new("on_hold", "On hold"), new("completed", "Completed")];

    private async Task HandleStatusChange(string? s)
    {
        if (!string.IsNullOrEmpty(s)) await OnStatusChanged.InvokeAsync(s);
    }

    private async Task Run(EventCallback cb)
    {
        showMore = false;
        await cb.InvokeAsync();
    }

    private async Task CopyLink()
    {
        showMore = false;
        await OnCopyLink.InvokeAsync();
    }

    // ── Save as template (moved here from the old Plans & Reports tab) ──
    private bool saveTplOpen, tplSaving, tplNameErr;
    private int tplShake;
    private string tplName = "", tplDesc = "";

    private void OpenSaveTemplate()
    {
        showMore = false;
        tplName = Project.Name;
        tplDesc = string.IsNullOrWhiteSpace(Project.Description) ? "" : Project.Description!;
        tplNameErr = false; tplShake = 0;
        saveTplOpen = true;
    }

    private void CloseSaveTemplate() { if (!tplSaving) saveTplOpen = false; }

    private async Task SaveTemplateAsync()
    {
        if (tplSaving) return;
        var name = tplName.Trim();
        if (name.Length == 0) { tplNameErr = true; tplShake++; return; }
        tplSaving = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/projects/templates",
                new { name, description = string.IsNullOrWhiteSpace(tplDesc) ? null : tplDesc.Trim(), sourceProjectId = Project.Id });
            if (res.IsSuccessStatusCode)
            {
                saveTplOpen = false;
                Toasts.Show($"Template \"{name}\" saved — find it in New project.", ToastKind.Success);
            }
            else
            {
                var why = res.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "you don't have permission.",
                    System.Net.HttpStatusCode.UnprocessableEntity => "a name is required (max 200 characters).",
                    _ => $"request failed ({(int)res.StatusCode}).",
                };
                Toasts.Show($"Couldn't save the template: {why}", ToastKind.Error);
            }
        }
        catch { Toasts.Show("Couldn't save the template. Check your connection.", ToastKind.Error); }
        finally { tplSaving = false; }
    }

    private async Task MarkDone()
    {
        showMore = false;
        await OnMarkCompleted.InvokeAsync();
    }

    private async Task Delete()
    {
        showMore = false;
        await OnDeleteProject.InvokeAsync();
    }
}
