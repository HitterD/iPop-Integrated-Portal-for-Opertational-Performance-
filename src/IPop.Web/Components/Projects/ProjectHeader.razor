@using IPop.Application.Projects
@inject IPop.Web.Services.CalendarLinks CalLinks
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPop.Web.Services.AuthState Auth
@inject IPop.Web.Services.ToastService Toasts

<div class="proj-canvas-head">
    <div class="proj-title-box">
        <button type="button" class="m-back" aria-label="Back" title="All projects" @onclick="OnBack"><i data-lucide="chevron-left"></i></button>
        <span class="proj-tile lg" style="background:@(!string.IsNullOrWhiteSpace(Project.Color) ? Project.Color : ProjectUiHelpers.GetAvatarBg(Project.Name))">@ProjectUiHelpers.GetInitials(Project.Name)</span>
        <div class="proj-title-col">
        <div class="proj-title-row">
        <h2 class="proj-title-text">@Project.Name</h2>
        <AppSelect Value="@Project.Status" ValueChanged="HandleStatusChange" Options="StatusOptions" Label="Project status" CssClass="@($"proj-st-select proj-st {Project.Status.ToLower()}")" />
        </div>
        <div class="proj-title-sub">
            @if (!string.IsNullOrWhiteSpace(Project.Description)) { <span class="desc">@Project.Description</span> }
            <span>@Project.Progress% complete</span>
            @if (Project.Deadline.HasValue) { <span>Due @Project.Deadline.Value.ToString("dd MMM yyyy")</span> }
        </div>
        </div>
    </div>

    @* Head actions: three labelled buttons (Members, Chat, New task) and a labelled More menu. *@
    <div class="proj-head-actions ph-friendly">
        <button type="button" class="ph-members" @onclick="OnOpenTeamModal" title="See and add project members" aria-label="Members (@Members.Count)">
            <span class="ph-stack">
                @foreach (var m in Members.Take(3))
                {
                    <PersonAvatar Nik="@m.Nik" Name="@m.Name" Size="28" Class="ph-av" Decorative="true" />
                }
            </span>
            <span class="ph-lbl">Members</span><span class="ph-count">@Members.Count</span>
        </button>
        <button type="button" class="ph-btn" @onclick="OnOpenChatRoom" title="Open the project's chat room"><i data-lucide="message-circle"></i><span class="ph-lbl">Chat</span></button>
        @if (CanWrite)
        {
            <button type="button" class="ph-btn primary" @onclick="OnNewTask" title="Add a task to this project"><i data-lucide="plus"></i><span class="ph-lbl">New task</span></button>
        }
        <div class="ph-more-wrap">
            <button type="button" class="ph-btn ghost" aria-haspopup="menu" aria-expanded="@(showMore ? "true" : "false")" @onclick="() => showMore = !showMore"><i data-lucide="more-horizontal"></i><span class="ph-lbl">More</span></button>
            @if (showMore)
            {
                <div class="ph-menu-backdrop" @onclick="() => showMore = false"></div>
                <div class="ph-menu" role="menu" @onclick:stopPropagation="true">
                    <button type="button" role="menuitem" @onclick="() => { showMore = false; ScheduleTeam(); }"><i data-lucide="calendar-plus"></i>Schedule team meeting</button>
                    <button type="button" role="menuitem" @onclick="() => Run(OnOpenEditModal)"><i data-lucide="pencil"></i>Edit project details</button>
                    <button type="button" role="menuitem" @onclick="() => Run(OnExport)"><i data-lucide="download"></i>Export to Excel (CSV)</button>
                    <button type="button" role="menuitem" @onclick="CopyLink"><i data-lucide="link"></i>Copy link</button>
                    <button type="button" role="menuitem" @onclick="OpenSaveTemplate"><i data-lucide="layout-template"></i>Save as template…</button>
                    <div class="ph-sep"></div>
                    <button type="button" role="menuitem" @onclick="MarkDone"><i data-lucide="check-circle"></i>Mark project completed</button>
                    <button type="button" role="menuitem" class="danger" @onclick="Delete"><i data-lucide="trash-2"></i>Delete project</button>
                </div>
            }
        </div>
    </div>
</div>

@if (saveTplOpen)
{
    <div class="rep-scrim" @onclick="CloseSaveTemplate">
        <div class="rep-sheet sm" role="dialog" aria-modal="true" aria-labelledby="ph-tpl-title" @onclick:stopPropagation="true">
            <header>
                <span class="hi c-acc"><i data-lucide="layout-template"></i></span>
                <div>
                    <h3 id="ph-tpl-title">Save as template</h3>
                    <p>Reuse this project's structure for new projects. Nothing in "@Project.Name" changes.</p>
                </div>
            </header>
            <div class="bdy">
                <div class="fld @(tplShake > 0 ? "mi-shake" : "")" @key="@($"tn{tplShake}")">
                    <label for="ph-tpl-name">Template name</label>
                    <input id="ph-tpl-name" class="inp @(tplNameErr ? "err" : "")" maxlength="200" value="@tplName"
                           @oninput="e => { tplName = e.Value?.ToString() ?? string.Empty; tplNameErr = false; }" />
                </div>
                <div class="fld">
                    <label for="ph-tpl-desc">Description <span>(optional)</span></label>
                    <textarea id="ph-tpl-desc" class="inp" rows="2" maxlength="1000" placeholder="What is this template for?"
                              @oninput="e => tplDesc = e.Value?.ToString() ?? string.Empty">@tplDesc</textarea>
                </div>
                <div class="fld">
                    <label>Include</label>
                    <div class="rep-checks">
                        <label class="on-always"><input type="checkbox" checked disabled /><span>Tasks<small>Titles, descriptions and priorities of top-level tasks · due dates become relative to the new start date</small></span></label>
                        <label><input type="checkbox" checked="@tplSections" @onchange="e => tplSections = e.Value is true" /><span>Sections<small>Section names, colours and order</small></span></label>
                        <label><input type="checkbox" checked="@tplMilestones" @onchange="e => tplMilestones = e.Value is true" /><span>Milestones<small>Dates become relative to the new start date</small></span></label>
                        <label><input type="checkbox" checked="@tplAssignees" @onchange="e => tplAssignees = e.Value is true" /><span>Assignees<small>Otherwise tasks start unassigned</small></span></label>
                        <label class="off"><input type="checkbox" disabled /><span>Comments &amp; attachments<small>Not copied — they belong to this project's history</small></span></label>
                    </div>
                </div>
                <div class="fld">
                    <label>Who can use it</label>
                    <div class="rep-seg" role="radiogroup" aria-label="Who can use it">
                        <button type="button" role="radio" aria-checked="@(tplWho == "private" ? "true" : "false")" class="@(tplWho == "private" ? "on" : "")" @onclick="@(() => tplWho = "private")">Only me</button>
                        <button type="button" role="radio" aria-checked="@(tplWho == "department" ? "true" : "false")" class="@(tplWho == "department" ? "on" : "")"
                                disabled="@(tplScope is not null && tplScope.DepartmentId is null)" title="@(tplScope is not null && tplScope.DepartmentId is null ? "You are not in a department" : null)"
                                @onclick="@(() => tplWho = "department")">@DepartmentLabel</button>
                        <button type="button" role="radio" aria-checked="@(tplWho == "everyone" ? "true" : "false")" class="@(tplWho == "everyone" ? "on" : "")" @onclick="@(() => tplWho = "everyone")">Everyone</button>
                    </div>
                </div>
            </div>
            <footer>
                <button type="button" class="rep-btn" @onclick="CloseSaveTemplate">Cancel</button>
                <button type="button" class="rep-btn pri" disabled="@tplSaving" @onclick="SaveTemplateAsync"><i data-lucide="layout-template"></i>@(tplSaving ? "Saving…" : "Save template")</button>
            </footer>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProjectDto Project { get; set; } = default!;
    [Parameter] public List<ProjectMemberDto> Members { get; set; } = [];

    [Parameter] public EventCallback OnOpenTeamModal { get; set; }
    [Parameter] public EventCallback OnOpenEditModal { get; set; }
    [Parameter] public EventCallback OnOpenChatRoom { get; set; }
    [Parameter] public EventCallback OnExport { get; set; }
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }
    [Parameter] public EventCallback OnCopyLink { get; set; }
    [Parameter] public EventCallback OnDeleteProject { get; set; }
    [Parameter] public EventCallback OnMarkCompleted { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    /// Owner/manager/member: shows "New task".
    [Parameter] public bool CanWrite { get; set; }
    [Parameter] public EventCallback OnNewTask { get; set; }

    private bool showMore;

    // Menus/sheets in here re-render without the page: draw their Lucide icons.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private void ScheduleTeam() => Nav.NavigateTo(CalLinks.NewMeeting($"{Project.Name} meeting", Members.Select(m => m.Nik), from: $"From project {Project.Name}"));

    private static List<AppOption>? statusOptions;
    private static List<AppOption> StatusOptions => statusOptions ??= [new("planning", "Planning"), new("active", "Active"), new("on_hold", "On hold"), new("completed", "Completed")];

    private async Task HandleStatusChange(string? s)
    {
        if (!string.IsNullOrEmpty(s)) await OnStatusChanged.InvokeAsync(s);
    }

    private async Task Run(EventCallback cb)
    {
        showMore = false;
        await cb.InvokeAsync();
    }

    private async Task CopyLink()
    {
        showMore = false;
        await OnCopyLink.InvokeAsync();
    }

    // ── Save as template (moved here from the old Plans & Reports tab) ──
    private bool saveTplOpen, tplSaving, tplNameErr;
    private int tplShake;
    private string tplName = "", tplDesc = "";
    private bool tplSections = true, tplMilestones = true, tplAssignees;
    private string tplWho = "department";
    private TemplateScope? tplScope;

    /// GET /api/projects/templates/scope: the caller's department for "Who can use it".
    public sealed record TemplateScope(Guid? DepartmentId, string? DepartmentName);

    private string DepartmentLabel => tplScope?.DepartmentName is { Length: > 0 } d
        ? (d.Contains("department", StringComparison.OrdinalIgnoreCase) ? d : $"{d} department")
        : "My department";

    private async Task LoadScopeAsync()
    {
        try { tplScope = await Auth.GetAsync<TemplateScope>("/api/projects/templates/scope"); }
        catch { tplScope = null; }
        if (tplScope is not null && tplScope.DepartmentId is null && tplWho == "department") tplWho = "private";
        StateHasChanged();
    }

    private void OpenSaveTemplate()
    {
        showMore = false;
        tplSections = true; tplMilestones = true; tplAssignees = false;
        tplWho = tplScope is not null && tplScope.DepartmentId is null ? "private" : "department";
        if (tplScope is null) _ = LoadScopeAsync();
        tplName = Project.Name;
        tplDesc = string.IsNullOrWhiteSpace(Project.Description) ? "" : Project.Description!;
        tplNameErr = false; tplShake = 0;
        saveTplOpen = true;
    }

    private void CloseSaveTemplate() { if (!tplSaving) saveTplOpen = false; }

    private async Task SaveTemplateAsync()
    {
        if (tplSaving) return;
        var name = tplName.Trim();
        if (name.Length == 0) { tplNameErr = true; tplShake++; return; }
        tplSaving = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/projects/templates",
                new
                {
                    name, description = string.IsNullOrWhiteSpace(tplDesc) ? null : tplDesc.Trim(), sourceProjectId = Project.Id,
                    includeSections = tplSections, includeMilestones = tplMilestones, includeAssignees = tplAssignees, visibility = tplWho,
                });
            if (res.IsSuccessStatusCode)
            {
                saveTplOpen = false;
                Toasts.Show($"Template \"{name}\" saved — find it in New project.", ToastKind.Success);
            }
            else
            {
                var why = res.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => "you don't have permission.",
                    System.Net.HttpStatusCode.UnprocessableEntity => await TemplateErrorAsync(res),
                    _ => $"request failed ({(int)res.StatusCode}).",
                };
                Toasts.Show($"Couldn't save the template: {why}", ToastKind.Error);
            }
        }
        catch { Toasts.Show("Couldn't save the template. Check your connection.", ToastKind.Error); }
        finally { tplSaving = false; }
    }

    private static async Task<string> TemplateErrorAsync(HttpResponseMessage res)
    {
        string? code = null;
        try { code = (await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>()).GetProperty("code").GetString(); } catch { }
        return code switch
        {
            "no_department" => "you are not in a department — choose Only me or Everyone.",
            "invalid_visibility" => "choose who can use it.",
            _ => "a name is required (max 200 characters).",
        };
    }

    private async Task MarkDone()
    {
        showMore = false;
        await OnMarkCompleted.InvokeAsync();
    }

    private async Task Delete()
    {
        showMore = false;
        await OnDeleteProject.InvokeAsync();
    }
}
