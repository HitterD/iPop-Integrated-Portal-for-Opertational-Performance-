@using IPop.Application.Projects
@using IPop.Web.Services
@inject IJSRuntime JS
@inject AuthState Auth

<div class="ov-grid">
    @* 1. Progress ring *@
    <div class="ov-card ov-progress">
        <div class="ov-ring" style="background:@RingGradient">
            <div class="ov-ring-hole">
                <span class="ov-ring-val">@ProgressPercentage%</span>
                <span class="ov-ring-cap">complete</span>
            </div>
        </div>
        <div class="ov-progress-col">
            <span class="ov-progress-title">Progress</span>
            <span class="ov-progress-line">@DoneTasks.Count of @AllTasks.Count tasks completed</span>
            <span class="ov-progress-line"><i data-lucide="calendar"></i>@DueLabel</span>
            <span class="ov-progress-days">@DaysLeftLabel</span>
        </div>
    </div>

    @* 2. Tasks by status *@
    <div class="ov-card ov-by-status">
        <span class="ov-card-title">Tasks by status</span>
        @foreach (var c in StatusCounts)
        {
            var row = c;
            <div class="ov-status-row" role="button" tabindex="0" @onclick="() => OnOpenBoard.InvokeAsync()">
                <span class="ov-status-dot" style="background:@row.Color"></span>
                <span class="ov-status-name">@row.Name</span>
                <div class="ov-status-bar"><div style="width:@row.Width%;background:@row.Color"></div></div>
                <span class="ov-status-n">@row.Count</span>
            </div>
        }
    </div>

    @* 3. Needs attention *@
    <div class="ov-card ov-attention">
        <div class="ov-attention-head">
            <span class="ov-card-title">Needs attention</span>
            <span class="ov-attention-sub">Overdue or due in 3 days</span>
        </div>
        @if (AttentionTasks.Count == 0)
        {
            <div class="ov-caught-up">
                <i data-lucide="circle-check"></i><span>Nothing urgent. Nice work.</span>
            </div>
        }
        else
        {
            @foreach (var t in AttentionTasks.Take(5))
            {
                var task = t;
                <div class="ov-attention-row" role="button" tabindex="0" @onclick="() => OnInspectTask.InvokeAsync(task.Task)">
                    <span class="ov-attention-dot" style="background:@task.Color"></span>
                    <span class="ov-attention-title">@task.Task.Title</span>
                    <span class="ov-attention-pill" style="background:@task.Bg;color:@task.Color">@task.Note</span>
                </div>
            }
        }
    </div>

    @* 4. Recent activity *@
    <div class="ov-card ov-activity">
        <span class="ov-card-title">Recent activity</span>
        @if (activity is null)
        {
            @for (var i = 0; i < 3; i++) { <div class="skel" style="height:28px;border-radius:8px"></div> }
        }
        else if (activity.Count == 0)
        {
            <span class="ov-empty">No activity yet.</span>
        }
        else
        {
            @foreach (var a in activity)
            {
                var row = a;
                <div class="ov-activity-row">
                    <PersonAvatar Nik="@(row.ActorNik ?? Members.FirstOrDefault(m => m.Name == row.ActorName)?.Nik)" Name="@row.ActorName" Size="28" Class="ov-activity-av" Decorative="true" />
                    <span class="ov-activity-text"><b>@row.ActorName</b> @ActivityText(row)</span>
                    <span class="ov-activity-time">@FormatWhen(row.CreatedAt)</span>
                </div>
            }
        }
    </div>

    @* 5. Members + about *@
    <div class="ov-card ov-members">
        <div class="ov-members-head">
            <span class="ov-card-title">Members</span>
            <button type="button" class="ov-link" @onclick="() => OnOpenTeamModal.InvokeAsync()">Add</button>
        </div>
        @foreach (var m in Members.Take(5))
        {
            var member = m;
            <div class="ov-member-row">
                <PersonAvatar Nik="@member.Nik" Name="@member.Name" Size="30" Class="ov-member-av" Decorative="true" />
                <div class="ov-member-info">
                    <span class="ov-member-name">@member.Name</span>
                    <span class="ov-member-role">@RoleLabel(member.Role)</span>
                </div>
            </div>
        }
        <div class="ov-about">
            <span class="ov-about-label">ABOUT</span>
            <span class="ov-about-desc">@(string.IsNullOrWhiteSpace(Project?.Description) ? "No description yet." : Project!.Description)</span>
            <span class="ov-about-meta">@Project?.Year · Owner @Project?.OwnerName</span>
        </div>
    </div>
</div>

@* Evidence stream is not part of the mockup's Overview grid, but it is live field data —
   kept as a full-width card so no working feature is lost. *@
@if (RecentEvidenceList.Count > 0)
{
    <div class="ov-card ov-evidence">
        <div class="ov-attention-head">
            <span class="ov-card-title">Recent evidence &amp; field deliverables</span>
            <span class="ov-attention-sub">Stream</span>
        </div>
        <div class="exec-evidence-stream">
            @foreach (var ev in RecentEvidenceList.Take(8))
            {
                <div class="exec-evidence-item" @onclick="() => OnInspectTask.InvokeAsync(ev.Task)">
                    <div class="exec-evidence-thumb">
                        @if (!string.IsNullOrEmpty(ev.Item.DataUrl))
                        {
                            <img src="@ev.Item.DataUrl" alt="@ev.Item.Name" />
                        }
                        else
                        {
                            <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--ink-3)">
                                <i data-lucide="@(ev.Item.Type == "photo" ? "image" : "file-text")" style="width:18px;height:18px"></i>
                            </div>
                        }
                    </div>
                    <div class="exec-evidence-info">
                        <div class="task-name">@ev.Task.Title</div>
                        <div class="file-name">@ev.Item.Name</div>
                        <div class="meta">
                            <span class="badge-type @ev.Context">@(ev.Context == "progress" ? "Progress Evidence" : "Completed Deliverable")</span>
                            <span>• @ev.Item.UploadedAt.ToString("dd MMM HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ProjectDto? Project { get; set; }
    [Parameter] public List<ProjectTaskDto> AllTasks { get; set; } = [];
    [Parameter] public List<ProjectMemberDto> Members { get; set; } = [];

    [Parameter] public EventCallback<ProjectTaskDto> OnInspectTask { get; set; }
    [Parameter] public EventCallback<ProjectTaskDto> OnRequestExtension { get; set; }
    [Parameter] public EventCallback OnOpenBoard { get; set; }
    [Parameter] public EventCallback OnOpenTeamModal { get; set; }

    public record EvidenceStreamItem(ProjectTaskDto Task, TaskEvidenceItem Item, string Context);
    private record ActivityRow(Guid Id, string TaskTitle, string ActorName, string Action, string? OldValue, string? NewValue, DateTime CreatedAt, string? ActorNik = null);
    private record StatusRow(string Name, string Color, int Count, double Width);
    private record AttentionRow(ProjectTaskDto Task, string Note, string Color, string Bg);

    private List<ActivityRow>? activity;

    private List<ProjectTaskDto> TodoTasks => AllTasks.Where(t => t.Status == "todo").ToList();
    private List<ProjectTaskDto> DoingTasks => AllTasks.Where(t => t.Status == "doing").ToList();
    private List<ProjectTaskDto> ReviewTasks => AllTasks.Where(t => t.Status == "review").ToList();
    private List<ProjectTaskDto> DoneTasks => AllTasks.Where(t => t.Status == "done").ToList();

    private int ProgressPercentage => AllTasks.Count > 0 ? (DoneTasks.Count * 100 / AllTasks.Count) : 0;

    private static readonly (string Status, string Name, string Color)[] Lanes =
    [
        ("todo", "To Do", "#8E8E93"),
        ("doing", "In Progress", "#0A84FF"),
        ("review", "Review", "#FF9F0A"),
        ("done", "Done", "#34C759"),
    ];

    private List<StatusRow> StatusCounts => Lanes.Select(l =>
    {
        var n = AllTasks.Count(t => t.Status == l.Status);
        var w = AllTasks.Count > 0 ? n * 100.0 / AllTasks.Count : 0;
        return new StatusRow(l.Name, l.Color, n, w);
    }).ToList();

    /// Overdue first, then anything due within three days — mirrors the mockup's rule.
    private List<AttentionRow> AttentionTasks
    {
        get
        {
            var rows = new List<AttentionRow>();
            foreach (var t in AllTasks.Where(t => t.Status != "done" && t.DueDate.HasValue))
            {
                var due = t.DueDate!.Value;
                var days = (due.Date - DateTime.UtcNow.Date).Days;
                if (days < 0)
                {
                    var late = -days;
                    rows.Add(new AttentionRow(t, $"{late} day{(late == 1 ? "" : "s")} late", "#C4271C", "#FFEBEA"));
                }
                else if (days <= 3)
                {
                    rows.Add(new AttentionRow(t, days == 0 ? "Due today" : $"Due in {days} day{(days == 1 ? "" : "s")}", "#B25E00", "#FFF4E5"));
                }
            }
            return rows.OrderBy(r => r.Task.DueDate).ToList();
        }
    }

    private string RingColor => ProjectUiHelpers.GetAvatarBg(Project?.Name ?? "");

    private string RingGradient => AllTasks.Count == 0
        ? "conic-gradient(#EDEDF0 0deg, #EDEDF0 360deg)"
        : $"conic-gradient({RingColor} {ProgressPercentage * 3.6}deg, #EDEDF0 0deg)";

    private string DueLabel => Project?.Deadline is { } d ? $"Due {d.ToLocalTime():dd MMM yyyy}" : "No deadline set";

    private string DaysLeftLabel
    {
        get
        {
            if (Project?.Deadline is not { } d) return "Set a deadline in Edit";
            var days = (d.ToLocalTime().Date - DateTime.UtcNow.Date).Days;
            return days >= 0
                ? $"{days} day{(days == 1 ? "" : "s")} left"
                : $"{Math.Abs(days)} day{(Math.Abs(days) == 1 ? "" : "s")} past deadline";
        }
    }

    private static string RoleLabel(string role) => role.ToLowerInvariant() switch
    {
        "owner" => "Owner",
        "manager" => "Manager",
        "admin" => "Admin",
        _ => "Member",
    };

    private static string ActivityText(ActivityRow a) => a.Action switch
    {
        "status_changed" => $"moved “{a.TaskTitle}” to {StatusName(a.NewValue)}",
        "comment_added" => $"commented on “{a.TaskTitle}”",
        "attachment_added" => $"attached a file to “{a.TaskTitle}”",
        "due_changed" => $"changed the due date of “{a.TaskTitle}”",
        "assignee_added" => $"assigned someone to “{a.TaskTitle}”",
        "assignee_removed" => $"unassigned someone from “{a.TaskTitle}”",
        "created" => $"created “{a.TaskTitle}”",
        _ => $"{a.Action.Replace('_', ' ')} on “{a.TaskTitle}”",
    };

    private static string StatusName(string? s) => s?.ToLowerInvariant() switch
    {
        "todo" => "To Do",
        "doing" => "In Progress",
        "review" => "Review",
        "done" => "Done",
        _ => s ?? "—",
    };

    private static string FormatWhen(DateTime utc)
    {
        var l = DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
        var span = DateTime.Now - l;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (l.Date == DateTime.Today) return l.ToString("HH:mm");
        if (l.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return l.ToString("dd MMM");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Project is null) { activity = []; return; }
        activity = await Auth.GetAsync<List<ActivityRow>>($"/api/projects/{Project.Id}/activity?limit=8") ?? [];
    }

    private List<EvidenceStreamItem> RecentEvidenceList
    {
        get
        {
            var list = new List<EvidenceStreamItem>();
            foreach (var t in AllTasks)
            {
                var parsed = TaskEvidenceHelper.Parse(t.Description);
                foreach (var p in parsed.Evidence.FieldPhotos)
                {
                    list.Add(new EvidenceStreamItem(t, p, "progress"));
                }
                foreach (var d in parsed.Evidence.CompletionDeliverables)
                {
                    list.Add(new EvidenceStreamItem(t, d, "done"));
                }
            }
            return list.OrderByDescending(x => x.Item.UploadedAt).ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
}
