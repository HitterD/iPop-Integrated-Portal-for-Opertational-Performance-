@using IPop.Application.Projects
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section class="gantt-card" aria-label="Project task timeline">
    @{
        var bounds = ProjectUiHelpers.GetTimelinePeriodBounds(timelineScale, timelineAnchorDate);
        var columns = ProjectUiHelpers.GetGanttColumns(timelineScale, timelineAnchorDate);
        var todayPosition = ProjectUiHelpers.GetTodayPosition(bounds.start, bounds.end, DateTime.Today);
        var taskLookup = AllTasks.ToDictionary(t => t.Id);
        var displayedTasks = (Timeline?.Tasks ?? []).Where(t => MatchesSharedFilters(t, taskLookup))
            .Where(t => !criticalOnly || CriticalPathTaskIds.Contains(t.Id))
            .OrderBy(t => t.StartDate ?? t.DueDate ?? DateTime.MaxValue).ToList();
        var totalCount = Timeline?.Tasks.Count ?? 0;
    }
    <header class="gantt-toolbar">
        <div class="gantt-heading">
            <span class="gantt-eyebrow">PROJECT TIMELINE</span>
            <h3>@ProjectUiHelpers.GetTimelinePeriodLabel(timelineScale, timelineAnchorDate)</h3>
            <span class="gantt-task-count">@displayedTasks.Count @((displayedTasks.Count == 1) ? "task" : "tasks")</span>
        </div>
        <div class="gantt-actions">
            <div class="gantt-scale-switcher" role="group" aria-label="Timeline scale">
                @foreach (var scale in new[] { "weekly", "monthly", "yearly" })
                {
                    <button type="button" class="gantt-scale-btn @(timelineScale == scale ? "active" : "")"
                            aria-pressed="@(timelineScale == scale ? "true" : "false")"
                            @onclick="() => SetTimelineScale(scale)">@CultureInfo.InvariantCulture.TextInfo.ToTitleCase(scale)</button>
                }
            </div>
            <div class="gantt-nav-group" role="group" aria-label="Navigate timeline">
                <button type="button" class="gantt-nav-btn" @onclick="() => NavigateTimeline(-1)" aria-label="Previous @timelineScale period" title="Previous period">
                    <i data-lucide="chevron-left" aria-hidden="true"></i>
                </button>
                <button type="button" class="gantt-today-btn" @onclick="ResetTimelineToday">Today</button>
                <button type="button" class="gantt-nav-btn" @onclick="() => NavigateTimeline(1)" aria-label="Next @timelineScale period" title="Next period">
                    <i data-lucide="chevron-right" aria-hidden="true"></i>
                </button>
            </div>
            @if (CriticalPathTaskIds.Count > 0)
            {
                <button type="button" class="gantt-critical-toggle @(criticalOnly ? "active" : "")"
                        aria-pressed="@(criticalOnly ? "true" : "false")" @onclick="() => criticalOnly = !criticalOnly">
                    Critical Path (@CriticalPathTaskIds.Count)
                </button>
            }
        </div>
    </header>

    @if (totalCount == 0)
    {
        <div class="gantt-empty">
            <i data-lucide="calendar-x" aria-hidden="true"></i>
            <p>No tasks on this project timeline yet.</p>
            @if (!ReadOnly) { <button type="button" class="btn-sm accent" @onclick="AddTask">Add First Task</button> }
        </div>
    }
    else if (displayedTasks.Count == 0)
    {
        <div class="gantt-empty"><p>No tasks match the current filters.</p></div>
    }
    else
    {
        <div class="gantt-body-wrap" role="table" aria-label="Timeline tasks and dates">
            <div class="gantt-header-row" role="row">
                <div class="gantt-header-tasks-title" role="columnheader">Task name</div>
                <div class="gantt-header-timeline-cols" role="columnheader" aria-label="@ProjectUiHelpers.GetTimelinePeriodLabel(timelineScale, timelineAnchorDate)">
                    @foreach (var column in columns)
                    {
                        var width = (column.End - column.Start).TotalDays / (bounds.end - bounds.start).TotalDays * 100;
                        <div class="gantt-header-col @(column.IsToday ? "is-today" : "")" style="width:@Pct(width)%">
                            <span>@column.Title</span><small>@column.Sub</small>
                        </div>
                    }
                </div>
            </div>
            <div class="gantt-rows">
            @foreach (var task in displayedTasks)
            {
                var placement = ProjectUiHelpers.CalculateGanttPlacement(task, bounds.start, bounds.end);
                var isCritical = CriticalPathTaskIds.Contains(task.Id);
                taskLookup.TryGetValue(task.Id, out var fullTask);
                var assignees = fullTask?.Assignees.Select(a => a.Name).ToArray() ?? [];
                var status = NormalizedStatus(task.Status);
                <div class="gantt-task-row @(isCritical ? "is-critical" : "")" role="row">
                    <div class="gantt-task-info" role="cell">
                        <span class="gantt-status-dot @status" aria-hidden="true"></span>
                        <div class="gantt-task-details">
                            <button type="button" class="gantt-task-title @(status == "done" ? "is-done" : "")"
                                    title="Open @task.Title" @onclick="() => OnTaskClick.InvokeAsync(task)">@task.Title</button>
                            <span class="gantt-assignees">@(assignees.Length > 0 ? string.Join(", ", assignees) : "Unassigned")</span>
                        </div>
                        @if (isCritical)
                        {
                            <span class="gantt-critical-label" title="Critical path task">Critical</span>
                        }
                        @if (task.IsBlocked)
                        {
                            <span class="blocked-badge" title="Waiting on other tasks to finish"><i data-lucide="lock" aria-hidden="true"></i>Waiting</span>
                        }
                    </div>
                    <div class="gantt-track-area" role="cell" aria-label="@task.Title: @placement.Tooltip">
                        <div class="gantt-grid-lines" aria-hidden="true">
                            @foreach (var column in columns)
                            {
                                var width = (column.End - column.Start).TotalDays / (bounds.end - bounds.start).TotalDays * 100;
                                <div class="gantt-grid-col @(column.IsToday ? "is-today" : "")" style="width:@Pct(width)%"></div>
                            }
                        </div>
                        @if (todayPosition.HasValue)
                        {
                            <span class="gantt-today-line" style="left:@Pct(todayPosition.Value)%" aria-hidden="true"></span>
                        }
                        @if (placement.NeedsDates)
                        {
                            <button type="button" class="gantt-set-dates" @onclick="() => OnTaskClick.InvokeAsync(task)"
                                    aria-label="@(ReadOnly ? $"Open {task.Title}" : $"Set dates for {task.Title}")">@(ReadOnly ? "No dates" : "Set dates")</button>
                        }
                        else if (placement.OutsideNote is not null)
                        {
                            <button type="button" class="gantt-outside-note" @onclick="() => OnTaskClick.InvokeAsync(task)"
                                    title="@placement.Tooltip" aria-label="@task.Title: @placement.OutsideNote. Open task">@placement.OutsideNote</button>
                        }
                        else
                        {
                            <button type="button" class="gantt-bar-item @status @(isCritical ? "critical-bar" : "") @(placement.IsInvalid ? "invalid-bar" : "")"
                                    style="left:@Pct(placement.Left)%;width:@Pct(placement.Width)%"
                                    @onclick="() => OnTaskClick.InvokeAsync(task)" title="@placement.Tooltip"
                                    aria-label="@task.Title, @StatusLabel(status): @placement.Tooltip">
                                <span class="gantt-bar-label">@placement.Label</span>
                            </button>
                        }
                    </div>
                </div>
            }
            @{ var links = DependencyLinks(displayedTasks, bounds.start, bounds.end); }
            @if (links.Count > 0)
            {
                @* Elbow arrows predecessor end -> successor start. x in % of the track, y in row units. *@
                <div class="gantt-deps" aria-hidden="true">
                    <svg viewBox="0 0 100 @displayedTasks.Count" preserveAspectRatio="none">
                        @foreach (var l in links)
                        {
                            var mid = Math.Max(l.X1, l.X2 - 1.2);
                            var bend = l.X2 - 1.2 < l.X1 ? l.X1 + 0.8 : mid;
                            <path class="@(l.Blocking ? "blocking" : "")" vector-effect="non-scaling-stroke"
                                  d="M @Pct(l.X1) @Pct(l.Y1) H @Pct(bend) V @Pct(l.Y2) H @Pct(l.X2)" />
                        }
                    </svg>
                    @foreach (var l in links)
                    {
                        <span class="gantt-dep-head @(l.Blocking ? "blocking" : "")" style="left:@Pct(l.X2)%;top:@Pct(l.Y2 / displayedTasks.Count * 100)%"></span>
                    }
                </div>
            }
            </div>
        </div>
    }
    <footer class="gantt-legend" aria-label="Timeline legend">
        <span class="gantt-legend-item"><span class="gantt-legend-today" aria-hidden="true"></span>Today</span>
        @foreach (var status in new[] { "todo", "doing", "review", "done" })
        {
            <span class="gantt-legend-item"><span class="gantt-legend-swatch @status" aria-hidden="true"></span>@StatusLabel(status)</span>
        }
    </footer>
</section>

@code {
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public ProjectTimelineDto? Timeline { get; set; }
    [Parameter] public List<ProjectTaskDto> AllTasks { get; set; } = [];
    [Parameter] public HashSet<Guid> CriticalPathTaskIds { get; set; } = [];
    [Parameter] public string? SearchQuery { get; set; }
    [Parameter] public bool MyTasksOnly { get; set; }
    [Parameter] public bool OverdueOnly { get; set; }
    [Parameter] public string? PriorityFilter { get; set; }
    [Parameter] public string? CurrentUserNik { get; set; }
    [Parameter] public EventCallback<TimelineTaskDto> OnTaskClick { get; set; }
    [Parameter] public EventCallback OnAddTask { get; set; }

    private Task AddTask() => ReadOnly ? Task.CompletedTask : OnAddTask.InvokeAsync();

    private const string ScaleStorageKey = "ipop_projects_timeline_scale";
    private string timelineScale = "monthly";
    private DateTime timelineAnchorDate = DateTime.Today;
    private bool criticalOnly;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ScaleStorageKey);
            if (saved is "weekly" or "monthly" or "yearly" && saved != timelineScale)
            {
                timelineScale = saved;
                StateHasChanged();
            }
        }
        catch (JSException) { /* Private browsing or storage unavailable: keep the default scale. */ }
        catch (InvalidOperationException) { /* JS unavailable during prerendering. */ }
    }

    private sealed record DepLink(double X1, double Y1, double X2, double Y2, bool Blocking);

    private static List<DepLink> DependencyLinks(List<TimelineTaskDto> rows, DateTime start, DateTime end)
    {
        var index = new Dictionary<Guid, (int Row, ProjectUiHelpers.GanttPlacement Place, TimelineTaskDto Task)>();
        for (var i = 0; i < rows.Count; i++)
        {
            var place = ProjectUiHelpers.CalculateGanttPlacement(rows[i], start, end);
            if (!place.NeedsDates && place.OutsideNote is null) index[rows[i].Id] = (i, place, rows[i]);
        }
        var links = new List<DepLink>();
        foreach (var (succ, info) in index)
            foreach (var pred in info.Task.DependsOn ?? [])
                if (index.TryGetValue(pred, out var p))
                    links.Add(new DepLink(p.Place.Left + p.Place.Width, p.Row + 0.5, info.Place.Left, info.Row + 0.5, p.Task.Status != "done"));
        return links;
    }

    private static string Pct(double number) => number.ToString("0.####", CultureInfo.InvariantCulture);
    private static string NormalizedStatus(string? status) => status?.ToLowerInvariant() switch
    {
        "todo" => "todo", "doing" => "doing", "review" => "review", "done" => "done", _ => "todo"
    };
    private static string StatusLabel(string status) => status switch
    {
        "doing" => "In Progress", "review" => "Review", "done" => "Done", _ => "To Do"
    };

    private bool MatchesSharedFilters(TimelineTaskDto task, Dictionary<Guid, ProjectTaskDto> taskLookup)
    {
        taskLookup.TryGetValue(task.Id, out var fullTask);
        if (!string.IsNullOrWhiteSpace(SearchQuery) &&
            !task.Title.Contains(SearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) &&
            !(task.Tags?.Contains(SearchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)) return false;
        if (!string.IsNullOrWhiteSpace(PriorityFilter) &&
            !string.Equals(task.Priority, PriorityFilter, StringComparison.OrdinalIgnoreCase)) return false;
        if (OverdueOnly && (!task.DueDate.HasValue || task.DueDate.Value.Date >= DateTime.Today || task.Status == "done")) return false;
        if (MyTasksOnly && (fullTask is null || !ProjectUiHelpers.IsAssignedToUser(fullTask, CurrentUserNik))) return false;
        return true;
    }

    private async Task SetTimelineScale(string scale)
    {
        timelineScale = scale;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ScaleStorageKey, scale); }
        catch (JSException) { /* The selected scale remains active for this mount. */ }
        catch (InvalidOperationException) { /* JS unavailable during prerendering. */ }
    }
    private void NavigateTimeline(int direction) => timelineAnchorDate = ProjectUiHelpers.NavigateTimeline(timelineScale, timelineAnchorDate, direction);
    private void ResetTimelineToday() => timelineAnchorDate = DateTime.Today;
}
