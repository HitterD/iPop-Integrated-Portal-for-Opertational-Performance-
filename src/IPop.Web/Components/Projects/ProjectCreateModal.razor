@using IPop.Web.Services

<div class="proj-modal-backdrop" @onclick="OnClose"></div>
<div class="proj-modal" role="dialog" aria-modal="true" aria-label="Create New Project">
    <div class="proj-modal-head">
        <div style="display:flex;align-items:center;gap:8px">
            <i data-lucide="folder-plus"></i>
            <span>Create New Project</span>
        </div>
        <button class="btn-sm surface" style="padding:4px 8px" @onclick="OnClose">
            <i data-lucide="x"></i>
        </button>
    </div>

    <div class="proj-modal-body">
        <div class="field" style="margin:0">
            <label style="font-size:11.5px;font-weight:700">Project Name *</label>
            <input class="org-input" @bind="createName" placeholder="e.g. HR Portal Implementation 2026" />
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="field" style="margin:0">
                <label style="font-size:11.5px;font-weight:700">Year *</label>
                <input type="number" class="org-input" @bind="createYear" />
            </div>
            <div class="field" style="margin:0">
                <label style="font-size:11.5px;font-weight:700">Deadline</label>
                <input type="date" class="org-input" value="@(createDeadline?.ToString("yyyy-MM-dd"))" @onchange="e => createDeadline = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null" />
            </div>
        </div>

        <div class="field" style="margin:0">
            <label style="font-size:11.5px;font-weight:700">Project Owner</label>
            <IPop.Web.Components.AppMemberPicker Placeholder="Search by name or NIK for owner..." ValueChanged="r => createOwner = r" />
            @if (createOwner is not null)
            {
                <div style="margin-top:4px;font-size:12px;color:var(--accent-ink);font-weight:600">
                    Selected: @createOwner.Name (@createOwner.Nik) · @createOwner.Position
                </div>
            }
        </div>

        <div class="field" style="margin:0">
            <label style="font-size:11.5px;font-weight:700">Project Description</label>
            <textarea class="org-input" style="min-height:70px;resize:vertical;font-size:12.5px" @bind="createDescription" placeholder="Summary of project goals..."></textarea>
        </div>
    </div>

    <div class="proj-modal-foot">
        <button class="btn-sm surface" @onclick="OnClose">Cancel</button>
        <button class="btn-sm accent" @onclick="HandleSubmit">
            <i data-lucide="check"></i> Create Project
        </button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<CreateProjectModel> OnSubmit { get; set; }

    private string createName = "";
    private int createYear = DateTime.UtcNow.Year;
    private DateTime? createDeadline;
    private string? createDescription;
    private MemberSearchRow? createOwner;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(createName)) return;
        var model = new CreateProjectModel(
            createName.Trim(),
            createYear,
            createDeadline,
            createDescription?.Trim(),
            createOwner?.Nik
        );
        await OnSubmit.InvokeAsync(model);
    }

    public record CreateProjectModel(
        string Name,
        int Year,
        DateTime? Deadline,
        string? Description,
        string? OwnerNik
    );
}
