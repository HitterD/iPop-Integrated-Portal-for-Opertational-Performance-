    private int Px => GanttMath.PxPerDay(zoom);
    private DateTime TodayDate => (Today ?? DateTime.Today).Date;
    private bool filtersActive => !string.IsNullOrWhiteSpace(SearchQuery) || !string.IsNullOrWhiteSpace(localSearch) || MyTasksOnly || OverdueOnly || !string.IsNullOrWhiteSpace(PriorityFilter);
    private string NextBaselineName => $"Plan {(dto?.Baselines.Count ?? 0) + 1}";

    protected override async Task OnParametersSetAsync()
    {
        var sig = $"{SearchQuery}|{MyTasksOnly}|{OverdueOnly}|{PriorityFilter}|{CurrentUserNik}";
        var filterChanged = sig != filterSig;
        filterSig = sig;
        if (ProjectId == Guid.Empty) return;
        if (ProjectId != loadedProject || GroupId != loadedGroup)
        {
            var newProject = ProjectId != loadedProject;
            loadedProject = ProjectId; loadedGroup = GroupId; loadedVersion = Version;
            if (newProject) { dto = null; layout = null; needScroll = true; collapsed.Clear(); pendingConflicts.Clear(); }
            await LoadAsync(dto is not null);
        }
        else if (Version != loadedVersion)
        {
            loadedVersion = Version;
            await LoadAsync(true);
        }
        else if (filterChanged && dto is not null) Relayout();
    }

    private async Task LoadAsync(bool quiet)
    {
        var seq = ++loadSeq;
        if (!quiet) state = LoadState.Loading;
        var q = GroupId is { } g ? $"?groupId={g}" : "";
        GetResult<GanttV2Dto> res;
        try { res = await Auth.GetResultAsync<GanttV2Dto>($"/api/projects/{ProjectId}/gantt/v2{q}"); }
        catch (OperationCanceledException) { return; }
        if (seq != loadSeq || disposed) return;
        if (res.IsOk && res.Value is not null)
        {
            dto = res.Value;
            pendingConflicts.Clear();
            holidaySet = dto.Holidays.Select(h => h.Date.Date).ToHashSet();
            state = LoadState.Ready;
            Relayout();
        }
        else if (!quiet || dto is null)
        {
            state = LoadState.Error;
            errorText = res.Status switch
            {
                GetStatus.Forbidden or GetStatus.NotFound => "You no longer have access to this project.",
                GetStatus.Unreachable => "iPop could not reach the server. Check your connection and try again.",
                _ => "Something went wrong while loading the plan. Try again in a moment.",
            };
        }
    }

    private void Relayout()
    {
        if (dto is null) return;
        var q = (SearchQuery ?? "").Trim();
        var lq = localSearch.Trim();
        var today = TodayDate;
        bool Keep(GanttRowDto r)
        {
            if (q.Length > 0 && !r.Title.Contains(q, StringComparison.OrdinalIgnoreCase)) return false;
            if (lq.Length > 0 && !r.Title.Contains(lq, StringComparison.OrdinalIgnoreCase)) return false;
            if (MyTasksOnly && (string.IsNullOrEmpty(CurrentUserNik) || !r.Assignees.Any(a => a.Nik.Equals(CurrentUserNik, StringComparison.OrdinalIgnoreCase)))) return false;
            if (OverdueOnly && !(r.DueDate.HasValue && r.DueDate.Value.Date < today && r.StageStatus != "done")) return false;
            if (!string.IsNullOrWhiteSpace(PriorityFilter) && !string.Equals(r.Priority, PriorityFilter, StringComparison.OrdinalIgnoreCase)) return false;
            return true;
        }
        var onlyText = !MyTasksOnly && !OverdueOnly && string.IsNullOrWhiteSpace(PriorityFilter);
        bool KeepMs(GanttMilestoneDto m) => onlyText
            && (q.Length == 0 || m.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
            && (lq.Length == 0 || m.Title.Contains(lq, StringComparison.OrdinalIgnoreCase));
        layout = GanttLayout.Build(dto, Keep, KeepMs, collapsed, filtersActive);
        holidayBands = GanttMath.HolidayBands(dto.Holidays, layout.Origin, layout.TotalDays, zoom);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            await LoadPrefs();
        }
        if (state != LoadState.Ready || disposed) return;
        try
        {
            if (!jsReady) { await JS.InvokeVoidAsync("ipopPv2.ganttInit", rootRef, self); jsReady = true; }
            var px = Px;
            if (renderedPx != 0 && renderedPx != px) await JS.InvokeVoidAsync("ipopPv2.ganttRescale", rootRef, renderedPx, px);
            renderedPx = px;
            await JS.InvokeVoidAsync("ipopPv2.ganttSeg", rootRef);
            if (needScroll && layout is { HasDates: true } lay)
            {
                needScroll = false;
                await JS.InvokeVoidAsync("ipopPv2.ganttScrollTo", rootRef, TodayScrollX(lay), false);
            }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private double TodayScrollX(GanttLayout lay) => Math.Max(0, (GanttMath.DayIndex(lay.Origin, TodayDate) - 8) * Px);

    // ── preferences ──
    private async Task LoadPrefs()
    {
        if (prefsLoaded) return;
        prefsLoaded = true;
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", PrefsKey);
            if (string.IsNullOrWhiteSpace(raw)) return;
            var p = JsonSerializer.Deserialize<Prefs>(raw, new JsonSerializerOptions(JsonSerializerDefaults.Web));
            if (p is null) return;
            showCrit = p.Crit; showBase = p.Base; showSlack = p.Slack; showWbs = p.Wbs;
            if (Enum.TryParse<GanttZoom>(p.Zoom, true, out var z)) zoom = z;
            if (dto is not null) Relayout();
            StateHasChanged();
        }
        catch { /* storage blocked or bad JSON: defaults */ }
    }

    private async Task SavePrefs()
    {
        try { await JS.InvokeVoidAsync("localStorage.setItem", PrefsKey, JsonSerializer.Serialize(new Prefs(showCrit, showBase, showSlack, showWbs, zoom.ToString()), new JsonSerializerOptions(JsonSerializerDefaults.Web))); }
        catch { }
    }

    private RenderFragment Toggle(string label, bool on, Func<Task> flip) => b =>
