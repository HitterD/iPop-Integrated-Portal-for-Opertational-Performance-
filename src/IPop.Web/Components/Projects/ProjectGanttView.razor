    private void OpenPopup(string name) { linkEdit = null; popup = popup == name ? null : name; confirmDelete = null; }
    private void ClosePopup() { popup = null; confirmDelete = null; }

    // ── arrows ──
    private IEnumerable<Arrow> Arrows(DateTime origin, int px, HashSet<Guid> critical, HashSet<string> conflicts)
    {
        if (layout is null) yield break;
        GanttBox? BoxOf(GanttLine l)
        {
            if (l.Hidden || l.Start is not { } s || l.End is not { } e) return null;
            return l.Kind == GanttLineKind.Milestone
                ? new GanttBox(GanttMath.DayIndex(origin, s) * px, GanttMath.DayIndex(origin, s) * px, l.Y, true)
                : new GanttBox(GanttMath.DayIndex(origin, s) * px, (GanttMath.DayIndex(origin, e) + 1) * px, l.Y, false);
        }
        foreach (var succ in layout.Lines.Where(l => l.Kind == GanttLineKind.Task))
        {
            var sb = BoxOf(succ);
            if (sb is null) continue;
            foreach (var dep in succ.Task!.DependsOn)
            {
                if (!layout.ByTask.TryGetValue(dep.TaskId, out var pred)) continue;
                var pb = BoxOf(pred);
                if (pb is null) continue;
                var conf = conflicts.Contains(dep.TaskId + ">" + succ.Id);
                var crit = showCrit && critical.Contains(dep.TaskId) && critical.Contains(succ.Id);
                yield return new Arrow(GanttMath.ArrowPath(dep.LinkType, pb, sb), conf ? "conf" : crit ? "crit" : "", dep.TaskId, succ.Id, dep.LinkType, dep.LagDays, pred.Title, succ.Title, true);
            }
        }
        foreach (var ms in layout.Lines.Where(l => l.Kind == GanttLineKind.Milestone))
        {
            var mb = BoxOf(ms);
            if (mb is null) continue;
            foreach (var tid in ms.Milestone!.LinkedTaskIds)
            {
                if (!layout.ByTask.TryGetValue(tid, out var pred)) continue;
                var pb = BoxOf(pred);
                if (pb is null) continue;
                var crit = showCrit && ms.Milestone.IsCritical && critical.Contains(tid);
                yield return new Arrow(GanttMath.ArrowPath("FS", pb, mb), crit ? "crit" : "", tid, ms.Id, "FS", 0, pred.Title, ms.Title, false);
            }
        }
    }

    private static string FirstName(string name)
    {
        var t = name.Trim();
        var i = t.IndexOf(' ');
        return i > 0 ? t[..i] : t;
    }

    private double BaseLeft(GanttRowDto r, DateTime origin, int px)
        => GanttMath.DayIndex(origin, (r.BaselineStart ?? r.BaselineDue ?? origin)) * px;

    private double BaseWidth(GanttRowDto r, int px)
    {
        var s = r.BaselineStart ?? r.BaselineDue;
        var e = r.BaselineDue ?? r.BaselineStart;
        if (s is null || e is null) return 0;
        return Math.Max(1, (int)(e.Value.Date - s.Value.Date).TotalDays + 1) * px;
    }

    private string TipJson(GanttLine l, HashSet<Guid> critical)
    {
        if (l.Kind == GanttLineKind.Milestone)
        {
            var m = l.Milestone!;
            var linked = m.LinkedTaskIds.Select(id => layout?.ByTask.GetValueOrDefault(id)?.Title).Where(t => t is not null).ToList();
            return JsonSerializer.Serialize(new
            {
                t = "◆ " + m.Title,
                l = GanttMath.FormatLong(m.Date),
                s = new[] { m.AchievedAt is not null ? "Reached" : m.IsCritical ? "Critical" : "", linked.Count > 0 ? "Waits for: " + string.Join(", ", linked) : "" }.Where(x => x.Length > 0),
            });
        }
        var r = l.Task!;
        var owners = r.Assignees.Count == 0 ? "No owner" : string.Join(", ", r.Assignees.Select(a => FirstName(a.Name)));
        var tail = r.SlackDays is > 0 ? $"{r.SlackDays} days slack" : r.IsCritical ? "critical" : "";
        var preds = r.DependsOn.Select(d => layout?.ByTask.GetValueOrDefault(d.TaskId)?.Title).Where(t => t is not null).ToList();
        var spans = new List<string> { string.Join(" · ", new[] { owners, r.Status, tail }.Where(x => x.Length > 0)) };
        if (preds.Count > 0) spans.Add("Waits for: " + string.Join(", ", preds));
        var ct = GanttMath.ConstraintText(r.ConstraintType, r.ConstraintDate);
        if (ct.Length > 0) spans.Add(ct);
        if (r.DeadlineDate is { } dl) spans.Add("Deadline " + GanttMath.FormatShort(dl));
        var line = l.Start is { } s && l.End is { } e
            ? $"{GanttMath.FormatLong(s)} → {GanttMath.FormatLong(e)}" + (r.DurationDays > 0 ? $" · {r.DurationDays} days" : "")
            : "No dates";
        return JsonSerializer.Serialize(new { t = r.Title, l = line, s = spans });
    }

    // ── moves (called from js/projects-v2.js once per drop) ──
    [JSInvokable]
    public Task OnBarClick(string id) => InvokeAsync(async () =>
    {
        if (Guid.TryParse(id, out var g) && (layout?.ByTask.ContainsKey(g) ?? false)) await OnOpenTask.InvokeAsync(g);
        else if (Guid.TryParse(id, out var m) && (dto?.Milestones.Any(x => x.Id == m) ?? false)) { /* milestones have no drawer */ }
    });

    [JSInvokable]
    public Task OnBarMoved(string id, int days, string kind) => InvokeAsync(() => HandleMovedAsync(id, days, kind));

    private async Task HandleMovedAsync(string idText, int days, string kind)
    {
        if (ReadOnly || days == 0 || dto is null || layout is null || !Guid.TryParse(idText, out var id)) { renderKey++; StateHasChanged(); return; }
        CloseToast();
        pendingConflicts.Clear();
        if (kind == "milestone") { await MoveMilestoneAsync(id, days); return; }
        if (!layout.ByTask.TryGetValue(id, out var line) || line.Start is not { } start || line.End is not { } end) { renderKey++; return; }
        var title = line.Title;
        var resize = kind == "resize";
        var newStart = resize ? start : start.AddDays(days);
        DateTime? newDue = resize ? end.AddDays(days) : null;
        if (newDue is { } nd && nd < newStart) { renderKey++; return; }

        var single = new RescheduleRequest(id, Utc(newStart), "single", newDue is { } d1 ? Utc(d1) : null);
        var prev = await Post<ReschedulePreviewDto>($"/api/projects/{ProjectId}/gantt/reschedule/preview", single);
        if (prev.Value is null) { await Fail(prev.Code, resize ? "change the finish" : "move this task"); return; }

        var known = dto.Conflicts.Select(c => c.FromTaskId + ">" + c.ToTaskId).ToHashSet();
        var fresh = prev.Value.Conflicts.Where(c => !known.Contains(c.FromTaskId + ">" + c.ToTaskId)).ToList();
        if (fresh.Count == 0)
        {
            await ApplyAsync(single, resize ? $"Changed the finish of \"<b>{E(title)}</b>\". Nothing else had to move."
                : $"Moved \"<b>{E(title)}</b>\" {Dist(days)}. Nothing else had to move.");
            return;
        }

        var all = new RescheduleRequest(id, single.NewStart, "cascade", single.NewDue);
        var casc = await Post<ReschedulePreviewDto>($"/api/projects/{ProjectId}/gantt/reschedule/preview", all);
        var k = Math.Max(0, (casc.Value?.Changes.Count ?? 1) - 1);
        var newFinish = casc.Value?.NewProjectFinish ?? prev.Value.NewProjectFinish;
        var goLive = newFinish is { } nf && dto.ProjectFinish is { } of && nf.Date != of.Date
            ? $"Go-live moves to <b>{GanttMath.FormatLong(nf)}</b>."
            : newFinish is { } nf2 ? $"Go-live stays on <b>{GanttMath.FormatLong(nf2)}</b>." : "";
        foreach (var c in fresh) pendingConflicts.Add(c.FromTaskId + ">" + c.ToTaskId);
        var head = resize ? $"Change the finish of \"{E(title)}\"?" : $"Move \"{E(title)}\" {Dist(days)}?";
        ShowToast($"<b>{head}</b><br>{k} task{(k == 1 ? "" : "s")} waiting for it will move too. {goLive}", warn: true, persist: true,
        [
            new ToastAction("Only this task", !DependentsFollow, async () =>
            {
                await ApplyAsync(single, "Moved only this task. The dashed red links show what now overlaps.");
            }),
            new ToastAction("Move all", DependentsFollow, async () =>
            {
                var goNow = newFinish is { } f ? $" Go-live is now <b>{GanttMath.FormatLong(f)}</b>." : "";
                await ApplyAsync(all, $"Moved {{n}} task{{s}}.{goNow}");
            }),
            new ToastAction("Cancel", false, () => { pendingConflicts.Clear(); renderKey++; StateHasChanged(); return Task.CompletedTask; }),
        ]);
        StateHasChanged();
    }

    private async Task ApplyAsync(RescheduleRequest req, string message)
    {
        busy = true;
        var res = await Post<ReschedulePreviewDto>($"/api/projects/{ProjectId}/gantt/reschedule/apply", req);
        busy = false;
        if (res.Value is null) { await Fail(res.Code, "move this task"); return; }
        var undo = res.Value.Changes.Select(c => new RevertChangeDto(c.TaskId, c.OldStart, c.OldDue)).ToList();
        var n = res.Value.Changes.Count;
        message = message.Replace("{n}", n.ToString()).Replace("{s}", n == 1 ? "" : "s");
        renderKey++;
        await LoadAsync(true);
        ShowToast(message, warn: false, persist: false, [new ToastAction("Undo", false, () => UndoAsync(undo))]);
    }

    private async Task UndoAsync(List<RevertChangeDto> changes)
    {
        var res = await Post<RescheduleRevertResultDto>($"/api/projects/{ProjectId}/gantt/reschedule/revert", new RescheduleRevertRequest(changes));
        renderKey++;
        if (res.Value is null) { await Fail(res.Code, "undo that"); return; }
        await LoadAsync(true);
        ShowToast("Undone.", warn: false, persist: false, [], 1800);
    }

    private async Task MoveMilestoneAsync(Guid id, int days)
    {
        var m = dto?.Milestones.FirstOrDefault(x => x.Id == id);
        if (m is null) { renderKey++; return; }
        var from = m.Date.Date;
        var to = from.AddDays(days);
        var res = await Send(HttpMethod.Patch, $"/api/projects/{ProjectId}/milestones/{id}?localToday={TodayDate:yyyy-MM-dd}", new { DueDate = Utc(to) });
        if (!res.Ok) { await Fail(res.Code, "move this milestone"); return; }
        renderKey++;
        await LoadAsync(true);
        ShowToast($"Moved milestone \"<b>{E(m.Title)}</b>\" to <b>{GanttMath.FormatLong(to)}</b>.", warn: false, persist: false, [new ToastAction("Undo", false, async () =>
        {
            var back = await Send(HttpMethod.Patch, $"/api/projects/{ProjectId}/milestones/{id}?localToday={TodayDate:yyyy-MM-dd}", new { DueDate = Utc(from) });
            renderKey++;
            await LoadAsync(true);
            ShowToast(back.Ok ? "Undone." : "Couldn't undo that.", warn: !back.Ok, persist: false, [], 1800);
        })]);
    }

    // ── links ──
    [JSInvokable]
    public Task OnLinkDrawn(string from, string to) => InvokeAsync(async () =>
    {
        if (ReadOnly || dto is null || layout is null || !Guid.TryParse(from, out var pred) || !Guid.TryParse(to, out var succ) || pred == succ) return;
        if (!layout.ByTask.TryGetValue(succ, out var sl) || !layout.ByTask.ContainsKey(pred)) return;
        if (sl.Task!.DependsOn.Any(d => d.TaskId == pred)) { ShowToast("These two tasks are already linked.", false, false, [], 2600); return; }
        var links = sl.Task.DependsOn.Select(d => new TaskLinkRequest(d.TaskId, d.LinkType, d.LagDays)).Append(new TaskLinkRequest(pred, "FS", 0)).ToList();
        var ok = await SaveLinksAsync(succ, links);
        if (ok) ShowToast($"Linked: <b>{E(layout.ByTask[pred].Title)}</b> then <b>{E(sl.Title)}</b>.", false, false, [], 3000);
    });

    private async Task<bool> SaveLinksAsync(Guid succ, List<TaskLinkRequest> links)
    {
        busy = true;
        var res = await Send(HttpMethod.Put, $"/api/projects/tasks/{succ}/dependencies",
            new SetTaskDependenciesRequest(links.Select(l => l.DependsOnTaskId).ToList(), links));
        busy = false;
        if (!res.Ok)
        {
            if (res.Code == "dependency_cycle") ShowToast("That link would create a loop.", true, false, [], 4000);
            else await Fail(res.Code, "save that link");
            return false;
        }
        await LoadAsync(true);
        return true;
    }

    private void OpenLinkEdit(Arrow a, MouseEventArgs e)
    {
        popup = null;
        linkEdit = new LinkEdit(a.PredId, a.SuccId, a.PredTitle, a.SuccTitle, a.Type, a.Lag, e.ClientX, e.ClientY);
    }

    private static int ParseLag(object? v) => int.TryParse(v?.ToString(), out var n) ? Math.Clamp(n, -365, 365) : 0;
    private static string LinkTypeHelp(string t) => t switch
    {
        "SS" => "Start to start: starts when the other starts",
        "FF" => "Finish to finish: finishes when the other finishes",
        _ => "Finish to start: starts after the other finishes",
    };

    private async Task SaveLink()
    {
        if (linkEdit is not { } le || layout is null || !layout.ByTask.TryGetValue(le.SuccId, out var sl)) return;
        var links = sl.Task!.DependsOn.Where(d => d.TaskId != le.PredId).Select(d => new TaskLinkRequest(d.TaskId, d.LinkType, d.LagDays))
            .Append(new TaskLinkRequest(le.PredId, le.Type, le.Lag)).ToList();
        linkEdit = null;
        await SaveLinksAsync(le.SuccId, links);
    }

    private async Task DeleteLink()
    {
        if (linkEdit is not { } le || layout is null || !layout.ByTask.TryGetValue(le.SuccId, out var sl)) return;
        var links = sl.Task!.DependsOn.Where(d => d.TaskId != le.PredId).Select(d => new TaskLinkRequest(d.TaskId, d.LinkType, d.LagDays)).ToList();
        var removed = sl.Task.DependsOn.First(d => d.TaskId == le.PredId);
        linkEdit = null;
        if (await SaveLinksAsync(le.SuccId, links))
            ShowToast("Link removed.", false, false, [new ToastAction("Undo", false, async () =>
            {
                var back = sl.Task.DependsOn.Select(d => new TaskLinkRequest(d.TaskId, d.LinkType, d.LagDays)).ToList();
                if (back.All(b => b.DependsOnTaskId != removed.TaskId)) back.Add(new TaskLinkRequest(removed.TaskId, removed.LinkType, removed.LagDays));
                await SaveLinksAsync(le.SuccId, back);
            })]);
    }

    // ── baselines ──
    private async Task SaveBaseline()
    {
        busy = true;
        var name = string.IsNullOrWhiteSpace(baselineName) ? null : baselineName.Trim();
        var res = await Send(HttpMethod.Post, $"/api/projects/{ProjectId}/baselines", new CreateBaselineRequest(name));
        busy = false;
        if (!res.Ok)
        {
            await Fail(res.Code == "too_many_baselines" ? "too_many_baselines" : res.Code, "save the baseline");
            return;
        }
        baselineName = "";
        await LoadAsync(true);
        ShowToast($"Baseline saved for <b>{GanttMath.FormatLong(TodayDate)}</b>. The earlier one stays in the list.", false, false, [], 2600);
    }

    private void BaselineKey(KeyboardEventArgs e) { if (e.Key == "Enter") _ = SaveBaseline(); }

    private async Task ActivateBaseline(Guid id)
    {
        busy = true;
        var res = await Send(HttpMethod.Put, $"/api/projects/{ProjectId}/baselines/{id}/activate", null);
        busy = false;
        if (!res.Ok) { await Fail(res.Code, "switch the baseline"); return; }
        await LoadAsync(true);
    }

    private async Task DeleteBaseline(Guid id)
    {
        if (confirmDelete != id) { confirmDelete = id; return; }
        confirmDelete = null;
        busy = true;
        var res = await Send(HttpMethod.Delete, $"/api/projects/{ProjectId}/baselines/{id}", null);
        busy = false;
        if (!res.Ok) { await Fail(res.Code, "delete the baseline"); return; }
        await LoadAsync(true);
    }

    // ── export / import ──
    private async Task ExportCsv()
    {
        popup = null;
        await OnExportCsv.InvokeAsync();
    }

    private async Task ExportXml()
    {
        popup = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/projects/{ProjectId}/export/msproject");
            if (!res.IsSuccessStatusCode) { ShowToast("Couldn't export the plan.", true, false, [], 3500); return; }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var name = res.Content.Headers.ContentDisposition?.FileNameStar ?? res.Content.Headers.ContentDisposition?.FileName?.Trim('"');
            if (string.IsNullOrWhiteSpace(name)) name = $"project-{DateTime.Now:yyyyMMdd-HHmm}.xml";
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), name);
            ShowToast("Exported the plan as MS Project XML.", false, false, [], 3000);
        }
        catch (Exception) { ShowToast("Couldn't export the plan.", true, false, [], 3500); }
    }

    private void OpenImport()
    {
        popup = null;
        importOpen = true; importName = null; importError = null; importBytes = null; importPreview = null;
    }

    private void CloseImport() { importOpen = false; importBytes = null; importPreview = null; }

    private async Task OnImportFile(InputFileChangeEventArgs e)
    {
        importError = null; importPreview = null; importBytes = null; importName = e.File.Name;
        if (e.File.Name.EndsWith(".mpp", StringComparison.OrdinalIgnoreCase))
        {
            importError = "A .mpp file can't be read directly. In Microsoft Project use File → Save As → XML, then pick that file.";
            return;
        }
        try
        {
            await using var s = e.File.OpenReadStream(20L * 1024 * 1024);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            importBytes = ms.ToArray();
        }
        catch (IOException) { importError = "That file is too large. The limit is 20 MB."; return; }
        busy = true;
        var res = await PostImportAsync(true);
        busy = false;
        if (res.Value is null) importError = res.Message ?? "That file could not be read.";
        else importPreview = res.Value;
    }

    private async Task ConfirmImport()
    {
        if (importBytes is null) return;
        busy = true;
        var res = await PostImportAsync(false);
        busy = false;
        if (res.Value is null) { importError = res.Message ?? "The import failed."; return; }
        importOpen = false; importBytes = null; importPreview = null;
        renderKey++;
        await LoadAsync(true);
        ShowToast($"Imported <b>{res.Value.TaskCount}</b> tasks in {res.Value.GroupCount} phases.", false, false, [], 4000);
    }

    private sealed record ImportResult(MsProjectImportResultDto? Value, string? Message);

    private async Task<ImportResult> PostImportAsync(bool dryRun)
    {
        try
        {
            using var form = new MultipartFormDataContent();
            var file = new ByteArrayContent(importBytes!);
            file.Headers.ContentType = new MediaTypeHeaderValue("application/xml");
            form.Add(file, "file", importName ?? "plan.xml");
            var res = await Auth.SendMultipartAsync($"/api/projects/{ProjectId}/import/msproject" + (dryRun ? "?dryRun=true" : ""), form);
            if (res.IsSuccessStatusCode)
                return new ImportResult(await res.Content.ReadFromJsonAsync<MsProjectImportResultDto>(), null);
            var err = await ReadError(res);
            return new ImportResult(null, err.Message is { Length: > 0 } m && m != err.Code ? m : ImportMessage(err.Code, res.StatusCode));
        }
        catch (Exception) { return new ImportResult(null, "Couldn't reach the server. Try again."); }
    }

    private static string ImportMessage(string? code, HttpStatusCode status) => code switch
    {
        "mpp_not_supported" => "Save the plan as XML in Microsoft Project (File → Save As → XML) and import that file.",
        "invalid_file" => "That doesn't look like an MS Project XML file.",
        "file_too_large" => "That file is too large. The limit is 20 MB.",
        "too_many_tasks" => "That plan has too many tasks to import at once.",
        "forbidden" => "Only the project owner or a manager can import a plan.",
        _ => status == HttpStatusCode.Forbidden ? "Only the project owner or a manager can import a plan." : "The import failed.",
    };

    // ── helpers ──
    private sealed record Reply<T>(T? Value, string? Code, bool Ok);
    private sealed record ApiErr(string? Code, string? Message);

    private static async Task<ApiErr> ReadError(HttpResponseMessage res)
    {
        try { return await res.Content.ReadFromJsonAsync<ApiErr>() ?? new ApiErr(null, null); }
        catch { return new ApiErr(null, null); }
    }

    private async Task<Reply<T>> Post<T>(string url, object body) => await Send<T>(HttpMethod.Post, url, body);
    private async Task<Reply<object>> Send(HttpMethod m, string url, object? body) => await Send<object>(m, url, body);

    private async Task<Reply<T>> Send<T>(HttpMethod m, string url, object? body)
    {
        try
        {
            var res = await Auth.SendAsync(m, url, body);
            if (!res.IsSuccessStatusCode) return new Reply<T>(default, (await ReadError(res)).Code ?? ((int)res.StatusCode).ToString(), false);
            if (typeof(T) == typeof(object)) return new Reply<T>(default, null, true);
            var v = await res.Content.ReadFromJsonAsync<T>();
            return new Reply<T>(v, null, v is not null);
        }
        catch (Exception) { return new Reply<T>(default, "network", false); }
    }

    private async Task Fail(string? code, string what)
    {
        renderKey++;
        pendingConflicts.Clear();
        var msg = code switch
        {
            "constraint_violation" => "That task is pinned to its date, so it can't move. Change the date constraint in the task first.",
            "forbidden" or "403" => "You can view this plan but not change it.",
            "too_many_baselines" => "Too many baselines. Delete an old one first.",
            "network" => $"Couldn't {what}. Check your connection and try again.",
            _ => $"Couldn't {what}.",
        };
        ShowToast(E(msg), true, false, [], 4800);
        await LoadAsync(true);
    }

    private static DateTime Utc(DateTime d) => DateTime.SpecifyKind(d.Date, DateTimeKind.Utc);
    private static string E(string s) => WebUtility.HtmlEncode(s);
    private static string Dist(int days) => days > 0 ? $"{days} day{(days == 1 ? "" : "s")} later" : $"{-days} day{(days == -1 ? "" : "s")} earlier";

    private void ShowToast(string html, bool warn, bool persist, List<ToastAction> actions, int ms = 5200)
    {
        StopToastTimer();
        var t = new GToast(Guid.NewGuid(), html, warn, actions);
        toast = t;
        if (!persist)
        {
            var cts = toastCts = new CancellationTokenSource();
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(ms, cts.Token);
                    await InvokeAsync(() => { if (toast?.Id == t.Id) { toast = null; StateHasChanged(); } });
                }
                catch (OperationCanceledException) { }
                catch (ObjectDisposedException) { }
            });
        }
        StateHasChanged();
    }

    private void StopToastTimer()
    {
        var c = toastCts; toastCts = null;
        if (c is null) return;
        try { c.Cancel(); } catch (ObjectDisposedException) { }
        c.Dispose();
    }

    private void CloseToast() { StopToastTimer(); toast = null; }

    private async Task RunToastAction(GToast t, ToastAction a)
    {
        if (toast?.Id == t.Id) CloseToast();
        await a.Run();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        StopToastTimer();
        try { if (jsReady) await JS.InvokeVoidAsync("ipopPv2.ganttDispose", rootRef); } catch { }
        self?.Dispose();
    }
}
