@code {
    private enum LoadState { Loading, Ready, Error }

    private sealed record ToastAction(string Label, bool Primary, Func<Task> Run);
    private sealed record GToast(Guid Id, string Html, bool Warn, List<ToastAction> Actions);
    private sealed record Arrow(string Path, string Css, Guid PredId, Guid SuccId, string Type, int Lag, string PredTitle, string SuccTitle, bool Editable);
    private sealed record LinkEdit(Guid PredId, Guid SuccId, string PredTitle, string SuccTitle, string Type, int Lag, double X, double Y);
    private sealed record Prefs(bool Crit = true, bool Base = true, bool Slack = true, bool Wbs = true, string Zoom = "Week");

    public const string PrefsKey = "ipop.gantt.prefs";

    [Parameter, EditorRequired] public Guid ProjectId { get; set; }
