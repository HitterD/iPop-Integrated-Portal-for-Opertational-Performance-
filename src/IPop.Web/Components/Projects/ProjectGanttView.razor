    [Parameter] public EventCallback<Guid> OnOpenTask { get; set; }
    [Parameter] public EventCallback OnOpenTable { get; set; }
    [Parameter] public EventCallback OnExportCsv { get; set; }

    private ElementReference rootRef;
    private DotNetObjectReference<ProjectGanttView>? self;
    private LoadState state = LoadState.Loading;
    private string? errorText;
    private GanttV2Dto? dto;
    private GanttLayout? layout;
    private IReadOnlyList<GanttBand> holidayBands = [];
    private HashSet<DateTime> holidaySet = [];
    private readonly HashSet<Guid> collapsed = [];
    private readonly HashSet<string> pendingConflicts = [];
    private GanttZoom zoom = GanttZoom.Week;
