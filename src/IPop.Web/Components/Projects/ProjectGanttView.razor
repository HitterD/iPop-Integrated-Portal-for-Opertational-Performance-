@using IPop.Application.Projects
@using System.Net
@using System.Net.Http.Headers
@using System.Text.Json
@inject IPop.Web.Services.AuthState Auth
@inject IJSRuntime JS
@implements IAsyncDisposable

@* Projects v2 Gantt (docs/mockups/ipop-apple/projects-v2.html ganttView): sticky WBS table on the left, time grid on the
   right with bars, arrows, baseline, slack, deadline flags, milestones and holiday shading. Drag, resize, link and keyboard
   moves are handled in js/projects-v2.js (pointer capture) and reported here once per drop; every move goes through the
   reschedule preview/apply endpoints and has Undo. *@
<div class="pv2 pv2g" @ref="rootRef" data-px="@Px" data-ro="@(ReadOnly ? "1" : "0")" data-view="gantt">
    @if (state == LoadState.Loading)
    {
        <div class="pv2g-skel" role="status" aria-label="Loading Gantt">
            <div class="pv2g-skel-tb"></div>
            @for (var i = 0; i < 9; i++)
            {
                <div class="pv2g-skel-row"><span style="width:@(120 + (i * 37) % 80)px"></span><i style="margin-left:@(40 + (i * 53) % 220)px;width:@(70 + (i * 29) % 140)px"></i></div>
            }
        </div>
    }
    else if (state == LoadState.Error)
    {
        <div class="pv2g-empty" role="alert">
            <span class="pv2g-bigic">@GanttIcons.Svg("alert")</span>
            <h3>Couldn't load the Gantt</h3>
            <p>@errorText</p>
            <button type="button" class="pv2g-btn pri" @onclick="() => LoadAsync(false)">Retry</button>
        </div>
    }
    else if (dto is not null && layout is not null)
    {
        var px = Px;
        var origin = layout.Origin;
        var width = layout.TotalDays * px;
        var rows = layout.VisibleRows;
        var bodyH = rows * GanttMath.RowHeight;
        var cols = (showWbs ? "30px " : "") + "minmax(150px,1fr) 34px 50px 50px 38px";
        var gl = showWbs ? 400 : 366;
        var todayIdx = GanttMath.DayIndex(origin, TodayDate);
        var criticalIds = dto.CriticalPathTaskIds.ToHashSet();
        var conflictKeys = dto.Conflicts.Select(c => c.FromTaskId + ">" + c.ToTaskId).Concat(pendingConflicts).ToHashSet();
        var baselineOn = dto.Baselines.FirstOrDefault(b => b.Id == dto.BaselineId);

        <div class="pv2g-tb" role="toolbar" aria-label="Gantt tools">
            <label class="pv2g-search">@GanttIcons.Svg("search")<input type="search" placeholder="Search tasks" aria-label="Search tasks in the Gantt" value="@localSearch" @oninput="OnLocalSearch" /></label>
            <div class="pv2g-seg" role="group" aria-label="Zoom">
                @foreach (var z in new[] { GanttZoom.Day, GanttZoom.Week, GanttZoom.Month })
                {
                    var zz = z;
                    <button type="button" class="@(zoom == z ? "on" : "")" aria-pressed="@(zoom == z ? "true" : "false")" @onclick="() => SetZoom(zz)">@z</button>
                }
                <span class="pv2g-knob"></span>
            </div>
            <button type="button" class="pv2g-chip" @onclick="FitProject">@GanttIcons.Svg("max")Fit project</button>
            <button type="button" class="pv2g-chip" @onclick="ScrollToday">@GanttIcons.Svg("target")Today</button>
            <span class="pv2g-sep"></span>
            @Toggle("Critical path", showCrit, () => { showCrit = !showCrit; return SavePrefs(); })
            @Toggle("Baseline", showBase, () => { showBase = !showBase; return SavePrefs(); })
            @Toggle("Slack", showSlack, () => { showSlack = !showSlack; return SavePrefs(); })
            @Toggle("WBS", showWbs, () => { showWbs = !showWbs; return SavePrefs(); })
            <span class="pv2g-spacer"></span>
            @if (CanManage)
            {
                <button type="button" class="pv2g-chip" aria-expanded="@(popup == "baseline" ? "true" : "false")" @onclick='() => OpenPopup("baseline")'>@GanttIcons.Svg("flag")Set baseline</button>
            }
            <button type="button" class="pv2g-chip" aria-expanded="@(popup == "export" ? "true" : "false")" @onclick='() => OpenPopup("export")'>@GanttIcons.Svg("download")Export</button>
            @if (CanManage)
            {
                <button type="button" class="pv2g-chip" @onclick="OpenImport">@GanttIcons.Svg("upload")Import</button>
            }
        </div>

        @if (!layout.HasDates)
        {
            <div class="pv2g-empty">
                <span class="pv2g-bigic">@GanttIcons.Svg("gantt")</span>
                <h3>@(filtersActive ? "No tasks match these filters" : "Add dates to your tasks to see them here")</h3>
                <p>@(filtersActive ? "Clear the search or filters to see the whole plan." : "The Gantt draws every task that has a start or a finish date.")</p>
                @if (!filtersActive) { <button type="button" class="pv2g-btn pri" @onclick="() => OnOpenTable.InvokeAsync()">Open Table</button> }
            </div>
        }
        else
        {
            <div class="pv2g-wrap" style="--pv2g-gl:@(gl)px">
                <div class="pv2g-in">
                    <div class="pv2g-left">
                        <div class="pv2g-row h" style="--pv2g-cols:@cols">
                            @if (showWbs) { <span>WBS</span> }
                            <span>Task</span><span>Days</span><span>Start</span><span>Finish</span><span title="Finish compared with baseline">Var.</span>
                        </div>
                        @foreach (var l in layout.Lines)
                        {
                            if (l.Kind == GanttLineKind.Group)
                            {
                                var g = l;
                                <div class="pv2g-row g @(l.Collapsed ? "col" : "")" style="--pv2g-cols:@cols" role="button" tabindex="0" aria-expanded="@(l.Collapsed ? "false" : "true")"
                                     data-g="@l.Id" @onclick="() => ToggleGroup(g.Id)" @onkeydown="ke => GroupKey(ke, g.Id)">
                                    @if (showWbs) { <span class="w">@l.Wbs</span> }
                                    <span>@GanttIcons.Svg("chev", "pv2g-cv") @l.Title</span>
                                    <span class="w pv2g-num">@(l.SpanDays > 0 ? l.SpanDays.ToString() : "")</span>
                                    <span class="w pv2g-num">@(l.Start is { } s ? GanttMath.FormatShort(s) : "")</span>
                                    <span class="w pv2g-num">@(l.End is { } e ? GanttMath.FormatShort(e) : "")</span>
                                    <span></span>
                                </div>
                            }
                            else if (l.Kind == GanttLineKind.Milestone)
                            {
                                var m = l.Milestone!;
                                <div class="pv2g-row @(l.Hidden ? "hid" : "") @(showCrit && m.IsCritical ? "crit-row" : "")" style="--pv2g-cols:@cols" data-hid="@l.Id">
                                    @if (showWbs) { <span class="w pv2g-num">@l.Wbs</span> }
                                    <span class="pv2g-nm">◆ @l.Title</span>
                                    <span class="w pv2g-num">0</span>
                                    <span class="w pv2g-num">@GanttMath.FormatShort(m.Date)</span>
                                    <span class="w pv2g-num">@GanttMath.FormatShort(m.Date)</span>
                                    <span class="w pv2g-num"></span>
                                </div>
                            }
                            else
                            {
                                var r = l.Task!;
                                var v = showBase ? r.VarianceDays : null;
                                var tid = r.Id;
                                <div class="pv2g-row @(l.Hidden ? "hid" : "") @(showCrit && r.IsCritical ? "crit-row" : "")" style="--pv2g-cols:@cols" data-hid="@r.Id">
                                    @if (showWbs) { <span class="w pv2g-num">@l.Wbs</span> }
                                    <span class="pv2g-nm" @onclick="() => OnOpenTask.InvokeAsync(tid)" title="@r.Title">@r.Title@if (r.ConstraintType is not null && r.ConstraintDate is not null) {<text> </text><span class="pv2g-cons" title="@GanttMath.ConstraintText(r.ConstraintType, r.ConstraintDate)">@GanttIcons.Svg("pin")</span>}</span>
                                    <span class="w pv2g-num">@(r.DurationDays > 0 ? r.DurationDays.ToString() : "")</span>
                                    <span class="w pv2g-num">@(l.Start is { } s2 ? GanttMath.FormatShort(s2) : "")</span>
                                    <span class="w pv2g-num">@(l.End is { } e2 ? GanttMath.FormatShort(e2) : "")</span>
                                    <span class="pv2g-num @(v > 0 ? "var-p" : v < 0 ? "var-n" : "w")">@(v is null ? "" : v > 0 ? "+" + v + "d" : v < 0 ? v + "d" : "0")</span>
                                </div>
                            }
                        }
                    </div>

                    <div class="pv2g-right" style="width:@(width)px">
                        <div class="pv2g-head">
                            @foreach (var b in GanttMath.MonthBands(origin, layout.TotalDays, zoom))
                            {
                                <div class="mo" style="left:@(b.Day * px)px;width:@(b.Length * px)px">@b.Label</div>
                            }
                            @foreach (var b in GanttMath.SubBands(origin, layout.TotalDays, zoom))
                            {
                                if (zoom == GanttZoom.Day)
                                {
                                    <div class="wk pv2g-num" style="left:@(b.Day * px)px;width:@(px)px;padding-left:0;text-align:center;@(GanttMath.IsWeekend(origin.AddDays(b.Day)) ? "opacity:.5" : "")">@b.Label</div>
                                }
                                else
                                {
                                    <div class="wk pv2g-num" style="left:@(b.Day * px)px;width:@(7 * px)px">@if (zoom == GanttZoom.Week && b.Label.IndexOf(" · ", StringComparison.Ordinal) is var sp and > 0) { <b>@b.Label[..sp]</b><text> · @b.Label[(sp + 3)..]</text> } else { @b.Label }</div>
                                }
                            }
                        </div>
                        <div class="pv2g-bodyx" style="height:@(bodyH)px;@GanttMath.WeekendBackground(px)" @key="renderKey">
                            <div class="pv2g-gridbg">
                                @for (var i = 0; i < layout.Lines.Count; i++)
                                {
                                    var ln = layout.Lines[i];
                                    if (ln.Hidden) { continue; }
                                    <div class="pv2g-rowline @(ln.Kind == GanttLineKind.Group ? "g" : "")" style="top:@(ln.Y * GanttMath.RowHeight)px"></div>
                                }
                            </div>
                            @foreach (var hb in holidayBands)
                            {
                                <div class="pv2g-freeze" style="left:@(hb.Day * px)px;width:@(hb.Length * px)px"><span>@hb.Label</span></div>
                            }
                            @if (todayIdx >= 0 && todayIdx < layout.TotalDays)
                            {
                                <div class="pv2g-today" style="left:@(todayIdx * px)px"><span>Today · @GanttMath.FormatShort(TodayDate)</span></div>
                            }

                            <svg class="pv2g-arrows @(showCrit ? "" : "nocrit")" width="@width" height="@bodyH">
                                <defs>
                                    <marker id="pv2g-ah" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--ink-3)" /></marker>
                                    <marker id="pv2g-ahr" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 z" style="fill:var(--danger)" /></marker>
                                </defs>
                                @foreach (var a in Arrows(origin, px, criticalIds, conflictKeys))
                                {
                                    var arrow = a;
                                    <path d="@a.Path" class="@a.Css" marker-end="url(#@(a.Css.Contains("conf") || a.Css.Contains("crit") ? "pv2g-ahr" : "pv2g-ah"))" />
                                    @if (!ReadOnly && a.Editable)
                                    {
                                        <path d="@a.Path" class="pv2g-hit" @onclick="e => OpenLinkEdit(arrow, e)"><title>Edit this link</title></path>
                                    }
                                }
                            </svg>

                            @foreach (var l in layout.Lines)
                            {
                                var y = l.Y * GanttMath.RowHeight;
                                if (l.Kind == GanttLineKind.Group)
                                {
                                    if (l.Start is { } gs && l.End is { } ge)
                                    {
                                        <div class="pv2g-gsum" style="top:@(y + 12)px;left:@(GanttMath.DayIndex(origin, gs) * px)px;width:@((GanttMath.DayIndex(origin, ge) - GanttMath.DayIndex(origin, gs) + 1) * px)px"></div>
                                    }
                                    continue;
                                }
                                if (l.Kind == GanttLineKind.Milestone)
                                {
                                    var m = l.Milestone!;
                                    var mx = GanttMath.DayIndex(origin, m.Date) * px;
                                    var mcrit = showCrit && m.IsCritical;
                                    <div class="pv2g-ms @(mcrit ? "crit" : "") @(l.Hidden ? "hid" : "") @(m.AchievedAt is not null ? "done" : "")" data-gid="@m.Id" data-kind="milestone" data-start="@m.Date.ToString("yyyy-MM-dd")"
                                         data-tip="@TipJson(l, criticalIds)" tabindex="@(l.Hidden ? -1 : 0)" role="button" aria-label="Milestone @m.Title, @GanttMath.FormatLong(m.Date)"
                                         style="top:@(y + 10)px;left:@(mx - 7)px"></div>
                                    <div class="pv2g-glabel @(l.Hidden ? "hid" : "")" data-lid="@m.Id" style="top:@(y + 9)px;left:@(mx + 12)px;font-weight:700;color:var(--ink)">@m.Title · @GanttMath.FormatShort(m.Date)</div>
                                    continue;
                                }
                                var r = l.Task!;
                                if (l.Start is not { } st || l.End is not { } en)
                                {
                                    continue;
                                }
                                var sIdx = GanttMath.DayIndex(origin, st);
                                var eIdx = GanttMath.DayIndex(origin, en);
                                var bw = Math.Max((eIdx - sIdx + 1) * px, 6);
                                var crit = showCrit && r.IsCritical;
                                var pc = r.StageStatus == "done" ? 100 : Math.Clamp(r.PercentDone, 0, 100);
                                var slackDays = r.SlackDays is > 0 && !r.IsCritical ? GanttMath.SlackCalendarDays(en, r.SlackDays.Value, holidaySet) : 0;
                                var owners = string.Join(", ", r.Assignees.Select(a => FirstName(a.Name)));
                                var hid = l.Hidden;
                                <div class="pv2g-base @(showBase && r.BaselineStart is not null || showBase && r.BaselineDue is not null ? "" : "off") @(hid ? "hid" : "")" style="top:@(y + 27)px;left:@(BaseLeft(r, origin, px))px;width:@(BaseWidth(r, px))px"></div>
                                <div class="pv2g-bar @(crit ? "crit" : "") @(hid ? "hid" : "")" data-gid="@r.Id" data-kind="task" data-start="@st.ToString("yyyy-MM-dd")" data-end="@en.ToString("yyyy-MM-dd")" data-px="@px"
                                     data-tip="@TipJson(l, criticalIds)" tabindex="@(hid ? -1 : 0)" role="button" aria-label="@r.Title, @GanttMath.FormatShort(st) to @GanttMath.FormatShort(en)"
                                     style="top:@(y + 8)px;left:@(sIdx * px)px;width:@(bw)px;background:@ProjectStatusUi.SafeColor(l.Color)">
                                    <i class="pv2g-done" style="width:@(pc)%"></i><span>@(bw > 34 ? pc + "%" : "")</span>
                                    @if (!ReadOnly)
                                    {
                                        <i class="pv2g-rs" title="Drag to change the finish"></i>
                                        <i class="pv2g-hand" title="Drag to another bar to link"></i>
                                    }
                                </div>
                                <div class="pv2g-slack @(showSlack && slackDays > 0 ? "" : "off") @(hid ? "hid" : "")" style="top:@(y + 16)px;left:@((eIdx + 1) * px)px;width:@(slackDays * px)px"></div>
                                <div class="pv2g-glabel @(hid ? "hid" : "")" data-lid="@r.Id" style="top:@(y + 9)px;left:@((eIdx + 1 + (showSlack ? slackDays : 0)) * px + 6)px">@owners</div>
                                @if (r.DeadlineDate is { } dl)
                                {
                                    <div class="pv2g-dl @(hid ? "hid" : "")" style="top:@(y + 1)px;left:@(GanttMath.DayIndex(origin, dl) * px - 2)px" title="Deadline @GanttMath.FormatShort(dl)">@GanttIcons.Svg("flag")</div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="pv2g-legend">
                <span><i style="width:16px;height:8px;border-radius:3px;background:var(--danger)"></i>Critical path: a delay here delays go-live</span>
                <span><i style="width:16px;height:4px;border-radius:3px;background:var(--ink-3);opacity:.5"></i>@(baselineOn is null ? "Baseline" : $"Baseline (plan saved {GanttMath.FormatShort(baselineOn.CreatedAt)})")</span>
                <span><i style="width:16px;border-top:2px dashed var(--ink-3)"></i>Slack: days a task can slip</span>
                <span><i style="width:9px;height:9px;transform:rotate(45deg);background:var(--pv2g-violet)"></i>Milestone</span>
                <span style="color:var(--danger)">@GanttIcons.Svg("flag", "pv2g-sm")Deadline</span>
                <span style="color:var(--info)">@GanttIcons.Svg("pin", "pv2g-sm")Date constraint</span>
                <span><b style="color:var(--ink-2)">Drag a bar</b> to move it · <b style="color:var(--ink-2)">click</b> to open · hover for details</span>
            </div>
        }

        @if (popup is not null)
        {
            <div class="pv2-pick-backdrop pv2g-backdrop" @onclick="ClosePopup"></div>
        }
        @if (popup == "export")
        {
            <div class="pv2g-pop pv2g-menu" style="right:20px" role="menu">
                <h5>Export Gantt</h5>
                <button type="button" class="pv2g-mi" role="menuitem" @onclick="ExportXml">@GanttIcons.Svg("gantt")MS Project XML</button>
                <button type="button" class="pv2g-mi" role="menuitem" @onclick="ExportCsv">@GanttIcons.Svg("table")Excel (.csv)</button>
            </div>
        }
        @if (popup == "baseline")
        {
            <div class="pv2g-pop pv2g-bl" style="right:96px" role="dialog" aria-label="Baselines">
                <h5>Baseline</h5>
                <p class="pv2g-hint">Save today's plan to compare against later. Earlier baselines stay in the list.</p>
                <div class="pv2g-blnew">
                    <input type="text" maxlength="60" placeholder="@NextBaselineName" aria-label="Baseline name" @bind="baselineName" @bind:event="oninput" @onkeydown="BaselineKey" />
                    <button type="button" class="pv2g-btn pri sm" disabled="@busy" @onclick="SaveBaseline">Save</button>
                </div>
                @foreach (var b in dto.Baselines.OrderByDescending(x => x.CreatedAt))
                {
                    var bb = b;
                    <div class="pv2g-bli @(b.IsActive ? "on" : "")">
                        <span class="nm"><b>@b.Name</b><small>@GanttMath.FormatShort(b.CreatedAt) · @b.TaskCount tasks · @b.CreatedByName</small></span>
                        @if (b.IsActive) { <span class="pv2g-badge">Active</span> }
                        else { <button type="button" class="pv2g-btn sm" disabled="@busy" @onclick="() => ActivateBaseline(bb.Id)">Activate</button> }
                        <button type="button" class="pv2g-btn sm @(confirmDelete == b.Id ? "danger" : "ghost")" disabled="@busy" aria-label="Delete @b.Name" @onclick="() => DeleteBaseline(bb.Id)">@(confirmDelete == b.Id ? "Sure?" : "Delete")</button>
                    </div>
                }
                @if (dto.Baselines.Count == 0) { <p class="pv2g-hint">No baseline yet.</p> }
            </div>
        }
    }

    @if (linkEdit is { } le)
    {
        <div class="pv2-pick-backdrop pv2g-backdrop" @onclick="() => linkEdit = null"></div>
        <div class="pv2g-pop pv2g-linkpop" style="position:fixed;left:min(max(8px, @(le.X - 120)px), calc(100vw - 276px));top:min(@(le.Y + 10)px, calc(100vh - 240px))" role="dialog" aria-label="Edit link">
            <h5>Link</h5>
            <p class="pv2g-hint"><b>@le.PredTitle</b> → <b>@le.SuccTitle</b></p>
            <div class="pv2g-seg pv2g-linkseg" role="group" aria-label="Link type">
                @foreach (var t in new[] { "FS", "SS", "FF" })
                {
                    var tt = t;
                    <button type="button" class="@(le.Type == t ? "on" : "")" aria-pressed="@(le.Type == t ? "true" : "false")" title="@LinkTypeHelp(t)" @onclick="() => linkEdit = le with { Type = tt }">@t</button>
                }
            </div>
            <label class="pv2g-lag">Lag (days)<input type="number" min="-365" max="365" value="@le.Lag" @onchange="e => linkEdit = le with { Lag = ParseLag(e.Value) }" /></label>
            <div class="pv2g-blnew">
                <button type="button" class="pv2g-btn sm danger" disabled="@busy" @onclick="DeleteLink">Delete link</button>
                <span class="pv2g-spacer"></span>
                <button type="button" class="pv2g-btn pri sm" disabled="@busy" @onclick="SaveLink">Save</button>
            </div>
        </div>
    }

    @if (importOpen)
    {
        <div class="pv2 pv2-scrim" @onclick="CloseImport">
            <div class="pv2-modal" role="dialog" aria-modal="true" aria-labelledby="pv2g-imp-title" @onclick:stopPropagation="true">
                <div class="pv2-mh">
                    <h2 id="pv2g-imp-title">Import from MS Project</h2>
                    <span class="pv2-sp"></span>
                    <button type="button" class="pv2-ibtn" aria-label="Close" @onclick="CloseImport">@GanttIcons.Svg("x")</button>
                </div>
                <div class="pv2-mbody pv2g-imp">
                    <p class="pv2-mnote">Pick a Microsoft Project file saved as <b>XML</b>. A <b>.mpp</b> file can't be read directly: in Microsoft Project use <b>File → Save As → XML</b> first.</p>
                    <InputFile OnChange="OnImportFile" accept=".xml,application/xml,text/xml" class="pv2g-file" aria-label="Choose an XML file" />
                    @if (importName is not null) { <p class="pv2-note">@importName</p> }
                    @if (importError is not null) { <div class="pv2g-imp-err" role="alert">@importError</div> }
                    @if (importPreview is { } ip)
                    {
                        <div class="pv2g-imp-sum">
                            <div><b>@ip.GroupCount</b><span>phases</span></div>
                            <div><b>@ip.TaskCount</b><span>tasks</span></div>
                            <div><b>@ip.LinkCount</b><span>links</span></div>
                            <div><b>@ip.MilestoneCount</b><span>milestones</span></div>
                        </div>
                        @if (ip.Warnings.Count > 0)
                        {
                            <ul class="pv2g-imp-warn">
                                @foreach (var w in ip.Warnings.Take(12)) { <li>@w</li> }
                                @if (ip.Warnings.Count > 12) { <li>and @(ip.Warnings.Count - 12) more</li> }
                            </ul>
                        }
                        <p class="pv2-note">Nothing has been imported yet. Import adds these to this project.</p>
                    }
                </div>
                <div class="pv2-mf">
                    <span class="pv2-sp"></span>
                    <button type="button" class="pv2g-btn" @onclick="CloseImport">Cancel</button>
                    <button type="button" class="pv2g-btn pri" disabled="@(importPreview is null || busy)" @onclick="ConfirmImport">Import</button>
                </div>
            </div>
        </div>
    }

    @if (toast is { } tt2)
    {
        <div class="pv2g-toast @(tt2.Warn ? "warn" : "")" role="status" @key="tt2.Id">
            <span class="ic">@GanttIcons.Svg(tt2.Warn ? "alert" : "check")</span>
            <p>@((MarkupString)tt2.Html)</p>
            @for (var i = 0; i < tt2.Actions.Count; i++)
            {
                var a = tt2.Actions[i];
