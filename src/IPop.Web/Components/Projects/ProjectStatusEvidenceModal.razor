@using IPop.Application.Projects
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject IPop.Web.Services.AuthState Auth

@if (IsOpen && Task is not null)
{
    <div class="evidence-modal-backdrop" @onclick="HandleCancel">
        <div class="evidence-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="evidence-modal-head">
                <div style="display:flex;align-items:center;gap:8px">
                    <span class="col-dot @TargetStatus"></span>
                    <span style="font-weight:700;font-size:14px;color:var(--ink)">
                        @(TargetStatus == "doing" ? "Progress Breakdown & Field Evidence" : (TargetStatus == "review" ? "Review Notes & Field Evidence" : "Work Completion Evidence"))
                    </span>
                </div>
                <button type="button" class="btn-sm surface" style="padding:4px 8px" @onclick="HandleCancel">
                    <i data-lucide="x" style="width:14px;height:14px"></i>
                </button>
            </div>

            <div class="evidence-modal-body">
                <div style="padding:8px 12px;background:var(--tray);border-radius:10px;border:1px solid var(--line-soft)">
                    <div style="font-size:11px;color:var(--ink-3);font-weight:600;text-transform:uppercase;letter-spacing:0.04em">Task</div>
                    <div style="font-size:13.5px;font-weight:700;color:var(--ink);margin-top:2px">@Task.Title</div>
                </div>

                @if (TargetStatus == "doing")
                {
                    @* In Progress Breakdown *@
                    <div class="field" style="margin:0">
                        <label style="font-size:11.5px;font-weight:700;color:var(--ink-2);display:flex;align-items:center;justify-content:space-between">
                            <span>Current Progress Breakdown</span>
                            <span style="font-size:10.5px;color:var(--ink-3)">@(evidence.ProgressSteps.Count) steps</span>
                        </label>
                        <div style="display:flex;gap:6px;margin-top:4px">
                            <input class="org-input" style="flex:1;height:32px;font-size:12px"
                                   placeholder="e.g. Analyze schematic & check grounding cable..."
                                   @bind="newStepText"
                                   @onkeydown="@(e => { if (e.Key == "Enter") AddStep(); })" />
                            <button type="button" class="btn-sm accent" style="padding:4px 12px;font-size:11.5px" @onclick="AddStep">
                                <i data-lucide="plus" style="width:12px;height:12px"></i> Add
                            </button>
                        </div>

                        @if (evidence.ProgressSteps.Count > 0)
                        {
                            <div style="display:flex;flex-direction:column;gap:5px;margin-top:8px;max-height:140px;overflow-y:auto">
                                @foreach (var step in evidence.ProgressSteps)
                                {
                                    <div style="display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--bg);border:1px solid var(--line-soft);border-radius:8px">
                                        <input type="checkbox" checked="@step.IsDone" @onchange="() => step.IsDone = !step.IsDone" style="cursor:pointer;accent-color:var(--accent)" />
                                        <span style="flex:1;font-size:12px;color:var(--ink);text-decoration:@(step.IsDone ? "line-through" : "none")">@step.Text</span>
                                        <button type="button" style="background:none;border:none;cursor:pointer;color:var(--ink-3);padding:2px" @onclick="() => evidence.ProgressSteps.Remove(step)">
                                            <i data-lucide="x" style="width:12px;height:12px"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Field Photo Evidence: uploaded straight to the project store, shared with every member *@
                    <div class="field" style="margin:0">
                        <label style="font-size:11.5px;font-weight:700;color:var(--ink-2);display:flex;align-items:center;justify-content:space-between">
                            <span>Field photos</span>
                            <span style="font-size:10.5px;color:var(--ink-3)">@FilesOf("field").Count photos</span>
                        </label>
                        @if (Task.Id != Guid.Empty)
                        {
                        <TaskFiles TaskId="Task.Id" Kind="field" Files="@FilesOf("field")" UploadLabel="Select field photos" UploadIcon="camera" Accept="image/*"
                                   MyUserId="MyUserId" IsOwner="false" OnChanged="LoadFilesAsync" OnOpen="OpenViewer" />
                        }
                        else { <small class="cal-hint">Upload field photos from each task after the bulk update.</small> }
                    </div>
                }
                else
                {
                    @* Done Deliverables & Completion Proof *@
                    <div class="field" style="margin:0">
                        <label style="font-size:11.5px;font-weight:700;color:var(--ink-2);display:flex;align-items:center;justify-content:space-between">
                            <span>Deliverables & completion photos</span>
                            <span style="font-size:10.5px;color:var(--ink-3)">@FilesOf("deliverable").Count files</span>
                        </label>
                        @if (Task.Id != Guid.Empty)
                        {
                        <TaskFiles TaskId="Task.Id" Kind="deliverable" Files="@FilesOf("deliverable")" UploadLabel="Upload photos, PDF or documents"
                                   MyUserId="MyUserId" IsOwner="false" OnChanged="LoadFilesAsync" OnOpen="OpenViewer" />
                        }
                        else { <small class="cal-hint">Upload deliverables from each task after the bulk update.</small> }
                    </div>

                    @* Completion Notes *@
                    <div class="field" style="margin:0">
                        <label style="font-size:11.5px;font-weight:700;color:var(--ink-2)">Completion Notes (Optional)</label>
                        <textarea class="org-input" style="min-height:75px;font-size:12px"
                                  placeholder="Notes on testing results, handover, or completed deliverables..."
                                  @bind="evidence.CompletionNotes"></textarea>
                    </div>
                }
            </div>

            <div style="padding:12px 18px;border-top:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;background:var(--tray)">
                <button type="button" class="btn-sm surface" style="border-radius:999px" @onclick="HandleSkip">
                    Skip & Update Status
                </button>
                <div style="display:flex;gap:8px">
                    <button type="button" class="btn-sm surface" style="border-radius:999px" @onclick="HandleCancel">
                        Cancel
                    </button>
                    <button type="button" class="btn-sm accent" style="border-radius:999px;padding:6px 16px" @onclick="HandleConfirm">
                        <i data-lucide="check" style="width:13px;height:13px"></i>
                        <span>Save & Update</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <IPop.Web.Components.AttachmentViewer Attachment="viewerFile" Siblings="viewerSiblings"
                                          OnClose="() => viewerFile = null" OnNavigate="a => viewerFile = a" />
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ProjectTaskDto? Task { get; set; }
    [Parameter] public string TargetStatus { get; set; } = "doing";

    [Parameter] public EventCallback<(ProjectTaskDto Task, string TargetStatus, TaskEvidenceData Evidence)> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private TaskEvidenceData evidence = new();
    private string cleanDescription = "";
    private string newStepText = "";

    // Filled once per (task, target): parent re-renders (live updates) must not reset the form.
    private (Guid, string)? _initFor;

    protected override void OnParametersSet()
    {
        if (Task is not null && _initFor != (Task.Id, TargetStatus))
        {
            _initFor = (Task.Id, TargetStatus);
            var parsed = TaskEvidenceHelper.Parse(Task.Description);
            cleanDescription = parsed.CleanDescription;
            evidence = parsed.Evidence;
            newStepText = "";
            files = [];
            _ = LoadFilesAsync();
        }
    }

    private void AddStep()
    {
        if (string.IsNullOrWhiteSpace(newStepText)) return;
        evidence.ProgressSteps.Add(new TaskProgressStep
        {
            Text = newStepText.Trim(),
            IsDone = false
        });
        newStepText = "";
    }

    [Parameter] public List<ProjectMemberDto> Members { get; set; } = [];

    private List<TaskFiles.TaskFileDto> files = [];
    private IPop.Application.Chat.AttachmentDto? viewerFile;
    private IReadOnlyList<IPop.Application.Chat.AttachmentDto>? viewerSiblings;

    private IReadOnlyList<TaskFiles.TaskFileDto> FilesOf(string kind) => files.Where(f => f.Kind == kind).ToList();
    private Guid? MyUserId => Auth.Me?.Nik is { } nik ? Members.FirstOrDefault(m => m.Nik == nik)?.UserId : null;

    private async Task LoadFilesAsync()
    {
        if (Task is null || Task.Id == Guid.Empty) return;
        var id = Task.Id;
        var rows = await Auth.GetAsync<List<TaskFiles.TaskFileDto>>($"/api/projects/tasks/{id}/files");
        if (Task?.Id != id) return;
        files = rows ?? [];
        await InvokeAsync(StateHasChanged);
    }

    private void OpenViewer((IPop.Application.Chat.AttachmentDto Open, IReadOnlyList<IPop.Application.Chat.AttachmentDto> All) pick)
    {
        viewerSiblings = pick.All;
        viewerFile = pick.Open;
    }

    private async Task HandleConfirm()
    {
        if (Task is null) return;
        await OnConfirm.InvokeAsync((Task, TargetStatus, evidence));
    }

    private async Task HandleSkip()
    {
        if (Task is null) return;
        await OnConfirm.InvokeAsync((Task, TargetStatus, evidence));
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }
}
