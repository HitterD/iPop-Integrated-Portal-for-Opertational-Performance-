@using IPop.Application.Projects
@inject IJSRuntime JS

<aside class="proj-sidebar @(IsCollapsed ? "collapsed" : "")" aria-label="Project Navigator">
    <div class="proj-sidebar-head">
        @if (!IsCollapsed)
        {
            <div class="title">
                <span>Projects</span>
                <span class="badge">@Projects.Count</span>
            </div>
        }
        <div class="proj-sidebar-actions" style="@(IsCollapsed ? "margin:0 auto;display:flex;justify-content:center;width:100%" : "display:flex;align-items:center;gap:6px")">
            @if (!IsCollapsed)
            {
                <button class="proj-new-btn" @onclick="OnCreateClick" title="Create New Project">
                    <i data-lucide="plus"></i>New
                </button>
            }
        </div>
    </div>

    @* Mockup prail(): "My work" (red late badge) and "All projects" buttons on top *@
    <div class="pv2 pv2r-top">
        <button type="button" class="pv2r-btn @(MyWorkSelected ? "on" : "")" data-act="mywork" aria-current="@(MyWorkSelected ? "page" : null)" @onclick="OnSelectMyWork" title="Everything assigned to you">
            <i data-lucide="check" style="color:var(--accent)"></i><span>My work</span>
            @if (LateCount > 0) { <span class="pv2r-bd">@LateCount late</span> }
        </button>
        <button type="button" class="pv2r-btn @(PortfolioSelected ? "on" : "")" data-act="portfolio" aria-current="@(PortfolioSelected ? "page" : null)" @onclick="OnSelectPortfolio" title="All projects overview">
            <i data-lucide="layout-grid" style="color:var(--info)"></i><span>All projects</span>
        </button>
    </div>

    @* Quick search projects *@
    <div class="proj-search-wrap">
        <i data-lucide="search" style="width:14px;height:14px;color:var(--ink-3)"></i>
        <input class="proj-search-input" placeholder="Search projects" value="@SearchQuery" @oninput="HandleSearchInput" />
    </div>

    @* Year filter chips *@
    <div class="proj-year-chips">
        <button class="year-chip @(SelectedYear == null ? "active" : "")" @onclick="() => OnYearChanged.InvokeAsync(null)">All</button>
        @foreach (var y in AvailableYears)
        {
            <button class="year-chip @(SelectedYear == y ? "active" : "")" @onclick="() => OnYearChanged.InvokeAsync(y)">@y</button>
        }
    </div>

    @* Projects stream list *@
    <div class="proj-list">
        @if (Loading)
        {
            @for (var i = 0; i < 5; i++)
            {
                <div class="skel" style="height:62px;border-radius:10px;margin-bottom:6px"></div>
            }
        }
        else if (Projects.Count == 0)
        {
            <div class="tree-empty" style="padding:28px 12px;text-align:center">
                <i data-lucide="folder-x" style="width:28px;height:28px;margin-bottom:8px;color:var(--ink-3)"></i>
                <div style="font-size:12.5px;color:var(--ink-2)">No projects found.</div>
                <button class="btn-sm accent" style="margin-top:10px" @onclick="OnCreateClick">Create new project</button>
            </div>
        }
        else
        {
            @foreach (var grp in Groups)
            {
                @if (grp.Show)
                {
                    <h6 class="pv2r-h" data-group="@grp.Key">@grp.Key <span>@grp.Items.Count</span></h6>
                }
                @foreach (var p in grp.Items)
                {
                    var isSel = p.Id == SelectedProjectId && !MyWorkSelected && !PortfolioSelected;
                    var pct = Math.Clamp(p.Progress, 0, 100);
                    <div class="proj-nav-item pv2r-pi @(isSel ? "active on" : "")" role="button" tabindex="0" data-pid="@p.Id" @onclick="() => OnSelectProject.InvokeAsync(p)" title="@p.Name (@StatusLabel(p.Status))">
                        <div class="proj-nav-collapsed-icon">
                            @(string.IsNullOrWhiteSpace(p.Name) ? "P" : p.Name.Trim().Substring(0, 1).ToUpper())
                        </div>
                        <span class="pv2r-dot" style="background:@(!string.IsNullOrWhiteSpace(p.Color) ? ProjectStatusUi.SafeColor(p.Color) : ProjectUiHelpers.GetAvatarBg(p.Name))"></span>
                        <span class="pv2r-name">@p.Name</span>
                        <span class="pv2r-pc">@(p.TaskCount == 0 ? "·" : pct + "%")</span>
                    </div>
                }
            }
        }
    </div>
</aside>

@code {
    [Parameter] public List<ProjectListDto> Projects { get; set; } = [];
    [Parameter] public Guid SelectedProjectId { get; set; }
    [Parameter] public int? SelectedYear { get; set; }
    [Parameter] public List<int> AvailableYears { get; set; } = [];
    [Parameter] public string SearchQuery { get; set; } = "";
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool PortfolioSelected { get; set; }
    [Parameter] public EventCallback OnSelectPortfolio { get; set; }
    [Parameter] public bool MyWorkSelected { get; set; }
    [Parameter] public EventCallback OnSelectMyWork { get; set; }
    /// Late tasks assigned to the user (red badge on My work).
    [Parameter] public int LateCount { get; set; }

    private sealed record Group(string Key, bool Show, List<ProjectListDto> Items);

    /// Grouped by year (the list has no department); the heading only shows when more than one year is visible.
    /// There are no project favourites in iPop, so the mockup's Favourites group is not shown.
    private List<Group> Groups
    {
        get
        {
            var byYear = Projects.GroupBy(p => p.Year).OrderByDescending(g => g.Key).ToList();
            return byYear.Select(g => new Group(g.Key.ToString(), byYear.Count > 1, g.OrderBy(p => p.Name).ToList())).ToList();
        }
    }

    [Parameter] public EventCallback<ProjectListDto> OnSelectProject { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback<int?> OnYearChanged { get; set; }
    [Parameter] public EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public EventCallback OnCreateClick { get; set; }

    /// "Due Oct 9", "Due today", "3 days late"; null when there is no deadline or the project is done.
    private static (string Text, string Css)? DueLabel(DateTime? deadline, string status)
    {
        if (deadline is not { } d || status.Equals("completed", StringComparison.OrdinalIgnoreCase)) return null;
        var days = (d.ToLocalTime().Date - DateTime.Now.Date).Days;
        return days switch
        {
            < 0 => ($"{-days} {(days == -1 ? "day" : "days")} late", "late"),
            0 => ("Due today", "soon"),
            <= 7 => ($"Due {d.ToLocalTime():ddd, MMM d}", "soon"),
            _ => ($"Due {d.ToLocalTime():MMM d}", ""),
        };
    }

    private static string StatusLabel(string s) => s.ToLowerInvariant() switch
    {
        "active" => "Active",
        "on_hold" => "On hold",
        "completed" => "Done",
        "planning" => "Planning",
        _ => s,
    };

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        await OnSearchChanged.InvokeAsync(e.Value?.ToString() ?? "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }
}
