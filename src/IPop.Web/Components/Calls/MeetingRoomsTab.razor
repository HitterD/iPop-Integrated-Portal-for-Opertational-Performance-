@* Calls & Meetings → Meeting Rooms: the five SJA Hall rooms as roast-tone tiles, the room-full alert and the
   server Recordings list. Ported from docs/mockups/meeting-rooms.html ("Meeting Rooms tab", "Room full").
   Joining hands over to MeetingRoomState; MeetingRoomOverlay (MainLayout) draws the room once joined. *@
@implements IDisposable
@using System.Globalization
@using IPop.Application.Hall
@using IPop.Application.MeetingRooms
@inject AuthState Auth
@inject MeetingRoomState Rooms
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject IPop.Web.Services.CalendarLinks CalLinks

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="mrt-bean" viewBox="0 0 100 100"><path fill="#fff" d="M50 4c22 0 40 20 40 46S72 96 50 96 10 76 10 50 28 4 50 4Zm-6 10c-8 10-6 22 0 34s8 24-2 36c14-2 22-14 18-30-3-12-12-22-10-34 0-2-2-6-6-6Z"/></symbol>
</svg>

<div class="mrt">
    <div class="mrt-page">
        <div class="mrt-section-h"><h2>Rooms</h2><p>Book a room to use it. Invited people join directly; others need the meeting password.</p></div>

        @if (roomsError)
        {
            <div class="mrt-group mrt-error mrt-rooms-error" role="status">
                <i data-lucide="wifi-off"></i><span>Meeting rooms can't be reached right now.</span>
                <button type="button" class="mrt-retry" disabled="@retrying" @onclick="RetryAsync">Retry</button>
            </div>
        }
        else if (rooms is null)
        {
            <div class="mrt-rooms" aria-busy="true">
                @foreach (var (key, _) in HallBooking.Rooms) { <div class="mrt-room mrt-skeleton mrt-r-@key"></div> }
            </div>
        }
        else
        {
            <div class="mrt-rooms">
                @foreach (var room in Ordered(rooms))
                {
                    var r = room;
                    var count = r.People.Count;
                    var full = count >= r.Capacity;
                    var busy = joiningKey is not null;
                    var locked = r.Access == MeetingRoomAccess.Locked;
                    var free = r.Access == MeetingRoomAccess.Free;
                    var cap = Capsule(r);
                    <article class="mrt-room mrt-r-@r.Key @(r.Available ? "" : "mrt-off")" id="mrt-room-@r.Key" aria-label="@r.Name">
                        <svg class="mrt-bean" aria-hidden="true"><use href="#mrt-bean" /></svg>
                        <div class="mrt-room-head"><div><h3>@r.Name</h3><small>@Subtitle(r)</small></div>
                            @if (locked && r.Available) { <span class="mrt-lock"><i data-lucide="lock"></i>Locked</span> }
                            else if (cap is { } c) { <span class="mrt-cap @c.Class">@c.Text</span> }
                        </div>
                        <div class="mrt-glass">
                            @if (r.Access == MeetingRoomAccess.Starting && r.Now is { } soon && count == 0)
                            {
                                <span class="mrt-soon">Starts @Hm(soon.StartAt)</span>
                            }
                            else if (locked || (free && count == 0))
                            {
                                <div class="mrt-empty-seat"><i data-lucide="@(locked ? "users" : "armchair")"></i>@(locked ? Inside(count) : "Free now")</div>
                            }
                            else if (count == 0)
                            {
                                <div class="mrt-empty-seat"><i data-lucide="armchair"></i>Nobody here yet</div>
                            }
                            else
                            {
                                <div class="mrt-who">
                                    <div class="mrt-faces" title="@string.Join(", ", r.People.Select(p => p.Name))">
                                        @foreach (var p in r.People.Take(count > 4 ? 3 : 4)) { <b style="background:@FaceColor(p.Name)">@IPop.Web.Models.AvatarPhotos.Initials(p.Name)</b> }
                                        @if (count > 4) { <b class="mrt-more">+@(count - 3)</b> }
                                    </div>
                                    <span>@count <em>of @r.Capacity</em></span>
                                </div>
                            }
                            @{ var line = InfoLine(r); }
                            <div class="mrt-line"><i data-lucide="@line.Icon"></i><span>@line.Text</span></div>
                            @if (!r.Available)
                            {
                                <button type="button" class="mrt-join mrt-full" disabled>Unavailable</button>
                            }
                            else if (free)
                            {
                                <div class="mrt-join-row">
                                    <button type="button" class="mrt-join" disabled="@busy" @onclick="() => OpenUseNow(r)"><i data-lucide="zap"></i><text>Use now</text></button>
                                    <button type="button" class="mrt-mini" title="Book for later" aria-label="Book @r.Name for later" @onclick="() => Book(r)"><i data-lucide="calendar-plus"></i></button>
                                </div>
                            }
                            else if (full)
                            {
                                <button type="button" class="mrt-join mrt-full" disabled>Room is full</button>
                            }
                            else if (locked)
                            {
                                <button type="button" class="mrt-join mrt-ghost" disabled="@busy" @onclick="() => OpenPassword(r)"><i data-lucide="key-round"></i><text>Enter with password</text></button>
                            }
                            else
                            {
                                <button type="button" class="mrt-join" disabled="@busy" @onclick="() => JoinAsync(r.Key)">
                                    @if (joiningKey == r.Key) { <span class="mrt-spin" aria-hidden="true"></span><text>Joining…</text> }
                                    else { <i data-lucide="@(r.VideoAllowed ? "video" : "mic")"></i><text>@(r.Access == MeetingRoomAccess.Starting ? "Join early" : "Join")</text> }
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }

        <div class="mrt-section-h"><h2>Recordings</h2><p>Only people who were in the meeting can see these.</p></div>
        @if (recordingsError)
        {
            <div class="mrt-group mrt-error mrt-recs-error" role="status">
                <i data-lucide="cloud-off"></i><span>Recordings can't be loaded right now.</span>
                <button type="button" class="mrt-retry" disabled="@retrying" @onclick="RetryAsync">Retry</button>
            </div>
        }
        else if (recordings is null)
        {
            <div class="mrt-group mrt-rec-empty" aria-busy="true"><span class="mrt-spinner"></span><span>Loading recordings…</span></div>
        }
        else if (recordings.Count > 0)
        {
            <div class="mrt-group">
                @foreach (var rec in recordings)
                {
                    var x = rec;
                    var ready = x.Status == "ready";
                    <div class="mrt-rec @(x.Id == RecordingId ? "mrt-target" : "")" id="mrt-rec-@x.Id">
                        <div class="mrt-thumb mrt-r-@x.RoomKey">
                            @if (ready)
                            {
                                <button type="button" class="mrt-thumb-play" aria-label="Play @x.Title" @onclick="() => Play(x)"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg></i></button>
                                @if (x.DurationSeconds is { } secs) { <span class="mrt-dur">@Duration(secs)</span> }
                            }
                            else if (x.Status == "processing")
                            {
                                <div class="mrt-thumb-play"><span class="mrt-spinner mrt-spinner-light"></span></div>
                            }
                            else
                            {
                                <div class="mrt-thumb-play"><i data-lucide="triangle-alert"></i></div>
                            }
                        </div>
                        <div class="mrt-rec-t">
                            <b>@x.Title</b>
                            <span>@WhenLabel(x.StartedAt), recorded by @x.StartedByName@(ready ? " · Full HD" : "")</span>
                            <span class="mrt-room-chip"><i class="mrt-r-@x.RoomKey"></i>@x.RoomName, @x.PeopleCount @(x.PeopleCount == 1 ? "person" : "people")@ChatLabel(x.ChatCount)</span>
                        </div>
                        <div class="mrt-rec-a">
                            @if (ready)
                            {
                                @if (x.SizeBytes is { } size) { <span class="mrt-size">@Size(size)</span> }
                                <button type="button" class="mrt-round mrt-download" title="Download" aria-label="Download @x.Title" @onclick="() => DownloadAsync(x)"><i data-lucide="arrow-down-to-line"></i></button>
                                <button type="button" class="mrt-round mrt-play" title="Play" aria-label="Play @x.Title" @onclick="() => Play(x)"><i data-lucide="play"></i></button>
                            }
                            else if (x.Status == "processing")
                            {
                                <span class="mrt-processing"><span class="mrt-spinner"></span>Preparing video</span>
                            }
                            else
                            {
                                <span class="mrt-processing mrt-failed">Recording failed</span>
                            }
                            @if (x.CanDelete)
                            {
                                <button type="button" class="mrt-round mrt-del" title="Delete" aria-label="Delete @x.Title" @onclick="() => AskDelete(x)"><i data-lucide="trash-2"></i></button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mrt-group mrt-rec-empty"><i data-lucide="film"></i><span>No recordings yet. Server recordings you attend appear here.</span></div>
        }
        <p class="mrt-foot">@(recordings?.Any(r => r.CanDelete) == true ? "Delete shows for whoever started the recording and the meeting organizer. " : "")Recordings are deleted automatically after @RetentionDays days.</p>
    </div>
</div>

@if (fullAlert is { } fa)
{
    <div class="mrt-scrim" @onclick="CloseAlert">
        <div class="mrt-alert" role="alertdialog" aria-modal="true" aria-labelledby="mrt-full-t" @onclick:stopPropagation="true">
            <div class="mrt-alert-body">
                <div class="mrt-sym mrt-r-@fa.Room.Key"><i data-lucide="users"></i></div>
                <h3 id="mrt-full-t">@fa.Room.Name is full</h3>
                <p>All @fa.Room.Capacity places are taken. @(fa.Alternatives.Count > 0 ? "These rooms have space now." : "No other room has space right now.")</p>
                @if (fa.Alternatives.Count > 0)
                {
                    <div class="mrt-alt">
                        @foreach (var alt in fa.Alternatives)
                        {
                            var a = alt;
                            <button type="button" @onclick="() => JoinAlternativeAsync(a.Key)">
                                <span class="mrt-sw mrt-r-@a.Key"></span>
                                <span><b>@a.Name</b><small>@AltLine(a)</small></span>
                                <em>Join</em>
                            </button>
                        }
                    </div>
                }
            </div>
            <div class="mrt-alert-actions"><button type="button" class="mrt-strong" @onclick="CloseAlert">OK</button></div>
        </div>
    </div>
}

@if (playing is { } pl && playingSrc is not null)
{
    <div class="mrt-scrim mrt-scrim-dark" @onclick="ClosePlayer">
        <div class="mrt-player @(playerChat is { Count: > 0 } ? "mrt-with-chat" : "")" role="dialog" aria-modal="true" aria-label="@pl.Title" @onclick:stopPropagation="true">
            <div class="mrt-vid"><video id="mrt-player-video" controls autoplay playsinline preload="metadata" src="@playingSrc"></video></div>
            <div class="mrt-player-bar">
                <div class="mrt-player-t"><b>@pl.Title</b><small>@pl.RoomName · @WhenLabel(pl.StartedAt)@(pl.DurationSeconds is { } d ? " · " + Duration(d) : "") · Full HD 1080p</small></div>
                <a class="mrt-pill mrt-download" href="@(playingSrc + "&download=1")" download title="Download" aria-label="Download @pl.Title"><i data-lucide="arrow-down-to-line"></i><span>Download</span></a>
                @if (pl.CanDelete)
                {
                    <button type="button" class="mrt-pill mrt-pill-red mrt-del" title="Delete" aria-label="Delete @pl.Title" @onclick="() => AskDelete(pl)"><i data-lucide="trash-2"></i><span>Delete</span></button>
                }
                <button type="button" class="mrt-pill mrt-close" title="Close" aria-label="Close" @onclick="ClosePlayer"><i data-lucide="x"></i><span>Close</span></button>
            </div>
            @if (playerChat is { Count: > 0 } lines)
            {
                <aside class="mrt-side-chat" aria-label="Chat during the meeting">
                    <h4>Chat during the meeting</h4>
                    <div class="mrt-msgs">
                        @foreach (var line in lines)
                        {
                            var l = line;
                            if (l.Kind == "system")
                            {
                                <div class="mrt-sysm" @key="l.Id">@l.Text</div>
                                continue;
                            }
                            <div class="mrt-m" @key="l.Id">
                                <span class="mrt-mono" style="background:@FaceColor(l.Name)" aria-hidden="true">@IPop.Web.Models.AvatarPhotos.Initials(l.Name)</span>
                                <div class="mrt-bub">
                                    <span class="mrt-nm">@if (l.Offset is { } off) { <button type="button" class="mrt-ts" title="Play from here" aria-label="Play from @Offset(off)" @onclick="() => SeekAsync(off)">@Offset(off)</button> }@l.Name</span>
                                    <p>@foreach (var seg in l.Segments)
                                       {
                                           if (seg.Href is { } href) { <a href="@href" target="_blank" rel="noopener noreferrer">@seg.Text</a> }
                                           else { @seg.Text }
                                       }</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>
            }
        </div>
    </div>
}

@if (deleting is { } del)
{
    <div class="mrt-scrim mrt-scrim-top" @onclick="CancelDelete">
        <div class="mrt-alert" role="alertdialog" aria-modal="true" aria-labelledby="mrt-del-t" @onclick:stopPropagation="true">
            <div class="mrt-alert-body">
                <div class="mrt-sym mrt-sym-red"><i data-lucide="trash-2"></i></div>
                <h3 id="mrt-del-t">Delete this recording?</h3>
                <p>“@del.Title” and its chat will be removed for @(del.PeopleCount > 1 ? $"all {del.PeopleCount} people who were" : "everyone who was") in the meeting. This can’t be undone.</p>
            </div>
            <div class="mrt-alert-actions">
                <button type="button" @onclick="CancelDelete">Cancel</button>
                <button type="button" class="mrt-strong mrt-danger" disabled="@deleteBusy" @onclick="DeleteAsync">Delete for everyone</button>
            </div>
        </div>
    </div>
}

@if (pwRoom is { } pr)
{
    <div class="mrt-scrim" @onclick="ClosePassword">
        <form class="mrt-sheet" role="dialog" aria-modal="true" aria-labelledby="mrt-sheet-t" @onclick:stopPropagation="true" @onsubmit="SubmitPasswordAsync">
            <div class="mrt-sheet-h"><span class="mrt-sw mrt-r-@pr.Key"></span><div><b id="mrt-sheet-t">@pr.Name is booked</b>@if (pr.Now is { } b) { <small>Booked @Hm(b.StartAt)–@Hm(b.EndAt)</small> }</div></div>
            <div class="mrt-sheet-b">
                <label class="mrt-pin-wrap">
                    <span class="mrt-pin" aria-hidden="true">
                        @for (var i = 0; i < 6; i++)
                        {
                            var filled = i < pin.Length;
                            <span class="@(filled ? "f" : i == pin.Length ? "c" : "")">@(filled ? pin[i].ToString() : "·")</span>
                        }
                    </span>
                    <input class="mrt-pin-in" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" aria-label="6-digit room password"
                           id="mrt-pin-in" value="@pin" @oninput="OnPin" />
                </label>
                @if (pwError is not null) { <p class="mrt-pin-err" role="alert">@pwError</p> }
                <p class="mrt-pin-hint">Enter the 6-digit password from the iPop meeting invite.<br />Not invited? Ask the organizer for it.</p>
                <div class="mrt-actions">
                    <button type="button" class="mrt-btn mrt-btn-gray" @onclick="ClosePassword">Cancel</button>
                    <button type="submit" class="mrt-btn mrt-btn-filled mrt-pin-go" disabled="@(pin.Length != 6 || pwBusy)">@(pwBusy ? "Entering…" : "Enter")</button>
                </div>
            </div>
        </form>
    </div>
}

@if (useNow is { } un)
{
    var options = UseNowOptions(un);
    <div class="mrt-scrim" @onclick="CloseUseNow">
        <div class="mrt-sheet" role="dialog" aria-modal="true" aria-labelledby="mrt-sheet-t" @onclick:stopPropagation="true">
            <div class="mrt-sheet-h"><span class="mrt-sw mrt-r-@un.Key"></span><div><b id="mrt-sheet-t">Use @un.Name now</b><small>@FreeLabel(un), starting @Hm(DateTime.UtcNow)</small></div></div>
            <div class="mrt-sheet-b">
                <div class="mrt-field"><span class="mrt-label">How long</span>
                    @if (offerMinutes is { } offer)
                    {
                        <p class="mrt-offer">The next booking starts soon. You can use the room for @offer min.</p>
                    }
                    else if (options.Count > 0)
                    {
                        <div class="mrt-seg3" role="radiogroup" aria-label="How long">
                            @foreach (var m in options)
                            {
                                var mm = m;
                                <button type="button" role="radio" aria-checked="@(minutes == mm ? "true" : "false")" class="@(minutes == mm ? "on" : "")" @onclick="() => minutes = mm">@mm min</button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mrt-offer">The next booking starts too soon to use the room now.</p>
                    }
                </div>
                <div class="mrt-field"><label class="mrt-label" for="mrt-un-title">Title</label>
                    <input id="mrt-un-title" class="mrt-input mrt-un-title" maxlength="200" @bind="useTitle" /></div>
                <div class="mrt-field"><span class="mrt-label">Invite people (optional)</span>
                    <div class="mrt-chips">
                        @foreach (var person in invitees)
                        {
                            var pp = person;
                            <span class="mrt-chip"><b style="background:@FaceColor(pp.Name)">@pp.Initials</b>@pp.Name<button type="button" aria-label="Remove @pp.Name" @onclick="() => invitees.Remove(pp)"><i data-lucide="x"></i></button></span>
                        }
                        <AppMemberPicker Placeholder="Add a name…" ValueChanged="AddInvitee" />
                    </div>
                </div>
                <p class="mrt-note"><i data-lucide="lock"></i>The room is locked for this booking. Invited people join directly; you get a password to share with anyone else.</p>
                @if (useError is not null) { <p class="mrt-sheet-err" role="alert">@useError</p> }
                <div class="mrt-actions">
                    <button type="button" class="mrt-btn mrt-btn-gray" @onclick="CloseUseNow">Cancel</button>
                    <button type="button" class="mrt-btn mrt-btn-filled mrt-un-go" disabled="@(useBusy || (offerMinutes is null && options.Count == 0))" @onclick="UseNowAsync">@(useBusy ? "Booking…" : offerMinutes is { } o ? $"Use for {o} min" : "Book and join")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// /calls?tab=rooms&join={key}: join that room once, after the first load.
    [Parameter] public string? JoinKey { get; set; }
    /// /calls?tab=rooms&recording={id}: scroll to that recording and open the player when it is ready.
    [Parameter] public Guid? RecordingId { get; set; }
    /// How often rooms (and unfinished recordings) refresh while the tab is visible. Tests shorten it.
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(10);
    /// MeetingRoomState.Changed bursts (speaking, mic, people) collapse into at most one rooms reload per gap.
    [Parameter] public TimeSpan ChangedReloadGap { get; set; } = TimeSpan.FromSeconds(5);

    private static readonly CultureInfo En = CultureInfo.InvariantCulture;
    private const int DefaultRetentionDays = 90;

    private List<MeetingRoomDto>? rooms;
    private List<MeetingRecordingDto>? recordings;
    private string? joiningKey;
    private string? joinedDeepLink;
    private Guid? scrolledRecording;   // the deep-linked row was scrolled into view
    private Guid? openedRecording;     // the player was opened for it (only once it is ready)
    private bool roomsError;
    private bool recordingsError;
    private bool retrying;
    private bool reloading;
    private bool reloadAgain;
    private DateTime lastChangedReload = DateTime.MinValue;
    private FullAlert? fullAlert;
    private MeetingRecordingDto? playing;
    /// The open player's ticket URL: fetched once when the player opens, never rebuilt on re-render or poll.
    private string? playingSrc;
    private System.Threading.Timer? poll;
    private bool disposed;
    private Guid? pendingReveal;

    // Enter with password (v2 §1.3)
    private MeetingRoomDto? pwRoom;
    private string pin = "";
    private string? pwError;
    private bool pwBusy;
    internal const string WrongPasswordText = "That password isn’t right.";
    internal const string TooManyText = "Too many tries. Wait a few minutes and try again.";
    internal const string NoBookingText = "This room isn’t booked. Use it now or book it first.";

    // Use now (v2 §1.2)
    private MeetingRoomDto? useNow;
    private int minutes = 60;
    private int? offerMinutes;
    private string useTitle = "";
    private readonly List<MemberSearchRow> invitees = [];
    private string? useError;
    private bool useBusy;
    private static readonly int[] UseNowDurations = [30, 60, 90];

    // Recordings: delete (v2 §2.8) and the player's chat (v2 §2.10)
    private MeetingRecordingDto? deleting;
    private bool deleteBusy;
    private List<PlayerLine>? playerChat;
    /// One saved chat line with its link runs split once (never on re-render).
    private sealed record PlayerLine(Guid Id, string Name, string Kind, string Text, int? Offset, IReadOnlyList<MeetingRoomOverlay.Segment> Segments);
    private sealed record RecordingChatLine(Guid Id, Guid UserId, string Name, string Text, DateTime SentAt, string Kind, int? OffsetSeconds);

    private sealed record FullAlert(MeetingRoomDto Room, List<MeetingRoomDto> Alternatives);
    private sealed record Cap(string Text, string Class);
    private sealed record Line(string Icon, string Text);

    /// The player/download address: &lt;video src&gt; and &lt;a download&gt; cannot send the Authorization header, so the
    /// API hands out a URL with a ticket scoped to this recording and user (POST …/ticket). Null = not allowed/offline.
    private async Task<string?> TicketUrlAsync(Guid id)
    {
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Post, $"/api/meeting-rooms/recordings/{id}/ticket");
            if (!res.IsSuccessStatusCode) return null;
            var body = await System.Net.Http.Json.HttpContentJsonExtensions.ReadFromJsonAsync<TicketDto>(res.Content);
            if (string.IsNullOrEmpty(body?.Url)) return null;
            return Http.BaseAddress is null ? body.Url : new Uri(Http.BaseAddress, body.Url).ToString();
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or NotSupportedException) { return null; }
    }

    private sealed record TicketDto(string? Url);

    protected override async Task OnInitializedAsync()
    {
        Rooms.Changed += OnRoomsChanged;
        await Task.WhenAll(LoadRoomsAsync(), LoadRecordingsAsync());
        // Left the tab while the first load was still running: Dispose already ran, so start nothing.
        if (disposed) return;
        poll = new System.Threading.Timer(_ => _ = InvokeAsync(PollAsync), null, PollInterval, PollInterval);
    }

    protected override async Task OnParametersSetAsync()
    {
        // The consumed link was replaced by /calls?tab=rooms: a later link to the same room is a new request.
        if (string.IsNullOrWhiteSpace(JoinKey) && joiningKey is null) joinedDeepLink = null;
        if (rooms is not null) await HandleDeepLinksAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await HandleDeepLinksAsync();
        if (pendingReveal is { } reveal)
        {
            pendingReveal = null;
            try { await JS.InvokeVoidAsync("ipopRooms.reveal", $"mrt-rec-{reveal}"); }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        try { await JS.InvokeVoidAsync("ipop.icons"); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (InvalidOperationException) { }
    }

    private async Task HandleDeepLinksAsync()
    {
        // Callers resume after awaits (poll, Retry, first render): once the tab is gone, a link must never
        // join a room behind the user's back.
        if (disposed) return;
        if (!string.IsNullOrWhiteSpace(JoinKey) && rooms is not null && joinedDeepLink != JoinKey)
        {
            var key = joinedDeepLink = JoinKey;
            if (disposed) return;
            // Consume the link: a reload or Back must not join again. (The parent then clears JoinKey; the key is captured.)
            Nav.NavigateTo("/calls?tab=rooms", replace: true);
            await JoinAsync(key);
        }
        if (disposed) return;
        if (ApplyRecordingLink()) StateHasChanged();
    }

    /// Re-run after every recordings load: the row is scrolled to once it exists, and the player opens once
    /// the recording is ready, so a link to a recording still being prepared opens it when it finishes.
    private bool ApplyRecordingLink()
    {
        if (RecordingId is not { } id || recordings?.FirstOrDefault(r => r.Id == id) is not { } rec) return false;
        var changed = false;
        if (scrolledRecording != id) { scrolledRecording = id; pendingReveal = id; changed = true; }
        if (openedRecording != id && rec.Status == "ready") { openedRecording = id; _ = InvokeAsync(() => Play(rec)); }
        return changed;
    }

    /// The deep-linked recording is not playable yet (not listed yet, or still processing).
    private bool WaitingForLinkedRecording =>
        RecordingId is { } id && openedRecording != id
        && recordings?.FirstOrDefault(r => r.Id == id) is not { Status: "failed" };

    // ---------------------------------------------------------------- loading

    private async Task PollAsync()
    {
        if (disposed) return;
        try
        {
            // Only while someone is looking: a background tab stops polling until it is visible again.
            if (await JS.InvokeAsync<string>("ipop.visibility") is "hidden") return;
        }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
        // Rooms refresh on every tick; a failed load is simply retried on the next one.
        await LoadRoomsAsync();
        if (disposed) return;
        if (recordingsError || WaitingForLinkedRecording || recordings?.Any(r => r.Status == "processing") == true)
            await LoadRecordingsAsync();
        if (disposed) return;
        StateHasChanged();
        await HandleDeepLinksAsync();          // a join link waits for the first successful rooms load
    }

    private async Task RetryAsync()
    {
        retrying = true;
        try { await Task.WhenAll(LoadRoomsAsync(), recordingsError ? LoadRecordingsAsync() : Task.CompletedTask); }
        finally { retrying = false; }
        if (disposed) return;
        await HandleDeepLinksAsync();
    }

    /// Someone joined, left, started sharing or recording: MeetingRoomState.Changed. It fires in bursts (every
    /// speaking/mic update), so reloads are coalesced: at most one per ChangedReloadGap, and events that arrive
    /// while a reload is waiting or running schedule exactly one more after it.
    private void OnRoomsChanged() => _ = InvokeAsync(CoalescedReloadAsync);

    private async Task CoalescedReloadAsync()
    {
        if (disposed) return;
        if (reloading) { reloadAgain = true; return; }
        reloading = true;
        try
        {
            do
            {
                var wait = lastChangedReload + ChangedReloadGap - DateTime.UtcNow;
                if (wait > TimeSpan.Zero) await Task.Delay(wait);
                if (disposed) return;
                reloadAgain = false;            // this reload covers every event so far
                lastChangedReload = DateTime.UtcNow;
                await LoadRoomsAsync();
                if (!disposed) StateHasChanged();
            } while (reloadAgain && !disposed);
        }
        finally { reloading = false; }
    }

    private async Task LoadRoomsAsync()
    {
        try
        {
            var r = await Auth.GetResultAsync<List<MeetingRoomDto>>("/api/meeting-rooms");
            if (r.Status == GetStatus.Ok && r.Value is not null) { rooms = r.Value; roomsError = false; }
            else roomsError = true;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { roomsError = true; }
    }

    private async Task LoadRecordingsAsync()
    {
        try
        {
            var r = await Auth.GetResultAsync<List<MeetingRecordingDto>>("/api/meeting-rooms/recordings");
            if (r.Status is GetStatus.Ok or GetStatus.Empty)
            {
                recordings = (r.Value ?? []).OrderByDescending(x => x.StartedAt).ToList();
                recordingsError = false;
                ApplyRecordingLink();
            }
            else recordingsError = true;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { recordingsError = true; }
    }

    // ---------------------------------------------------------------- actions

    private async Task JoinAsync(string key)
    {
        if (joiningKey is not null) return;
        joiningKey = key;
        StateHasChanged();
        try
        {
            var (error, suggestions) = await Rooms.JoinAsync(key);
            switch (error)
            {
                case null: break;
                case "password_required":
                    // Not (or no longer) invited to this booking: the password sheet asks for the 6 digits.
                    if (rooms?.FirstOrDefault(r => r.Key == key) is { } locked) OpenPassword(locked);
                    else OpenPassword(Fallback(key));
                    break;
                case "no_booking": Toasts.Show(NoBookingText, ToastKind.Info); await LoadRoomsAsync(); break;
                case "too_many_attempts": Toasts.Show(TooManyText, ToastKind.Warning); break;
                case "room_full":
                    await LoadRoomsAsync();
                    var room = rooms?.FirstOrDefault(r => r.Key == key) ?? Fallback(key);
                    var alts = suggestions.Select(s => rooms?.FirstOrDefault(r => r.Key == s)).OfType<MeetingRoomDto>().ToList();
                    fullAlert = new(room, alts);
                    break;
                case "in_call": Toasts.Show("Leave your current call first.", ToastKind.Warning); break;
                case "busy": break;
                case "unknown_room": Toasts.Show("That room does not exist.", ToastKind.Error); break;
                default: Toasts.Show("The meeting server is not reachable right now.", ToastKind.Error); break;
            }
        }
        finally
        {
            joiningKey = null;
            if (!disposed) StateHasChanged();
        }
    }

    private async Task JoinAlternativeAsync(string key)
    {
        fullAlert = null;
        await JoinAsync(key);
    }

    private void CloseAlert() => fullAlert = null;
    private async Task Play(MeetingRecordingDto rec)
    {
        if (playing?.Id == rec.Id && playingSrc is not null) return;
        var url = await TicketUrlAsync(rec.Id);
        if (disposed) return;
        if (url is null) { Toasts.Show("This recording can't be opened right now.", ToastKind.Error); return; }
        playing = rec; playingSrc = url; playerChat = null;
        StateHasChanged();
        await LoadPlayerChatAsync(rec.Id);
    }

    /// The chat saved with the recording, by offset. Lines are split into text/link runs once here.
    private async Task LoadPlayerChatAsync(Guid id)
    {
        try
        {
            var r = await Auth.GetResultAsync<List<RecordingChatLine>>($"/api/meeting-rooms/recordings/{id}/chat");
            if (disposed || playing?.Id != id || r.Value is null) return;
            playerChat = r.Value
                .Where(l => l.Text is { Length: > 0 } && l.Kind is "text" or "system")
                .Select(l => new PlayerLine(l.Id, l.Name ?? "", l.Kind, l.Text, l.OffsetSeconds is { } o ? Math.Max(0, o) : null,
                    l.Kind == "text" ? MeetingRoomOverlay.Segments(l.Text) : []))
                .ToList();
            StateHasChanged();
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
    }

    private async Task SeekAsync(int seconds)
    {
        try { await JS.InvokeVoidAsync("ipopRooms.seek", "mrt-player-video", seconds); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void ClosePlayer() { playing = null; playingSrc = null; playerChat = null; }

    // ---------------------------------------------------------------- delete a recording

    private void AskDelete(MeetingRecordingDto rec) { if (rec.CanDelete) deleting = rec; }
    private void CancelDelete() { if (!deleteBusy) deleting = null; }

    private async Task DeleteAsync()
    {
        if (deleting is not { } rec || deleteBusy) return;
        deleteBusy = true;
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/meeting-rooms/recordings/{rec.Id}");
            if (disposed) return;
            if (res.IsSuccessStatusCode || res.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // 404 = already gone (someone else deleted it): the outcome is the same.
                recordings?.RemoveAll(r => r.Id == rec.Id);
                if (playing?.Id == rec.Id) { ClosePlayer(); Toasts.Show("This recording was deleted.", ToastKind.Info); }
            }
            else if (res.StatusCode == System.Net.HttpStatusCode.Conflict) Toasts.Show("Stop the recording first.", ToastKind.Warning);
            else if (res.StatusCode == System.Net.HttpStatusCode.Forbidden) Toasts.Show("Only the person who recorded it or the organizer can delete it.", ToastKind.Error);
            else Toasts.Show("The recording couldn't be deleted. Try again.", ToastKind.Error);
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException)
        {
            Toasts.Show("The recording couldn't be deleted. Try again.", ToastKind.Error);
        }
        finally
        {
            deleteBusy = false;
            deleting = null;
            if (!disposed) StateHasChanged();
        }
    }

    // ---------------------------------------------------------------- Enter with password

    private void OpenPassword(MeetingRoomDto room)
    {
        pwRoom = room; pin = ""; pwError = null; pwBusy = false;
        _ = FocusAsync(".mrt-pin-in");
    }

    private void ClosePassword() { if (!pwBusy) pwRoom = null; }

    /// Digits only, at most 6 (a pasted "123 456" becomes 123456).
    private async Task OnPin(ChangeEventArgs e)
    {
        var typed = e.Value?.ToString() ?? "";
        var digits = new string(typed.Where(char.IsAsciiDigit).ToArray());
        pin = digits.Length > 6 ? digits[..6] : digits;
        pwError = null;
        // A letter or a 7th digit leaves `pin` unchanged, so Blazor sees no diff and would keep the raw text in the field:
        // write the filtered digits back so the boxes and the field never disagree.
        if (typed != pin)
        {
            try { await JS.InvokeVoidAsync("ipopRooms.setValue", "mrt-pin-in", pin); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { }
        }
    }

    private async Task SubmitPasswordAsync()
    {
        if (pwRoom is not { } room || pin.Length != 6 || pwBusy) return;
        if (joiningKey is not null) return;
        pwBusy = true; pwError = null; joiningKey = room.Key;
        try
        {
            var (error, suggestions) = await Rooms.JoinAsync(room.Key, pin);
            if (disposed) return;
            switch (error)
            {
                case null: pwRoom = null; pin = ""; break;
                case "wrong_password" or "password_required": pwError = WrongPasswordText; pin = ""; _ = FocusAsync(".mrt-pin-in"); break;
                case "too_many_attempts": pwError = TooManyText; break;
                case "no_booking": pwError = NoBookingText; break;
                case "room_full":
                    pwRoom = null;
                    await LoadRoomsAsync();
                    var full = rooms?.FirstOrDefault(r => r.Key == room.Key) ?? room;
                    fullAlert = new(full, suggestions.Select(s => rooms?.FirstOrDefault(r => r.Key == s)).OfType<MeetingRoomDto>().ToList());
                    break;
                case "in_call": pwError = "Leave your current call first."; break;
                case "busy": break;
                default: pwError = "The meeting server is not reachable right now."; break;
            }
        }
        finally
        {
            pwBusy = false; joiningKey = null;
            if (!disposed) StateHasChanged();
        }
    }

    // ---------------------------------------------------------------- Use now

    private void OpenUseNow(MeetingRoomDto room)
    {
        useNow = room; useError = null; useBusy = false; invitees.Clear();
        useTitle = $"{room.Name} meeting";
        var options = UseNowOptions(room);
        minutes = options.Contains(60) ? 60 : options.Count > 0 ? options[^1] : 60;
        // None of 30/60/90 fit but at least 15 minutes do: offer exactly that (the server accepts 15..cap then).
        offerMinutes = options.Count == 0 && FreeMinutes(room) is >= 15 and < 30 and var free ? free : null;
    }

    /// Whole minutes until the next booking's lock window (StartAt − 10 min); null = no next booking.
    private static int? FreeMinutes(MeetingRoomDto room) =>
        room.Next is { } next ? (int)Math.Floor((ToUtc(next.StartAt).AddMinutes(-10) - DateTime.UtcNow).TotalMinutes) : null;

    private void CloseUseNow() { if (!useBusy) useNow = null; }

    /// 30/60/90 that end before the next booking's lock window (StartAt − 10 min); the server re-checks.
    private static List<int> UseNowOptions(MeetingRoomDto room)
    {
        if (room.Next is not { } next) return [.. UseNowDurations];
        var free = (ToUtc(next.StartAt).AddMinutes(-10) - DateTime.UtcNow).TotalMinutes;
        return UseNowDurations.Where(m => m <= free).ToList();
    }

    private void AddInvitee(MemberSearchRow? row)
    {
        if (row is null || invitees.Any(i => i.Nik == row.Nik)) return;
        invitees.Add(row);
    }

    private async Task UseNowAsync()
    {
        if (useNow is not { } room || useBusy) return;
        useBusy = true; useError = null;
        var key = room.Key;
        try
        {
            var body = new { minutes = offerMinutes ?? minutes, title = string.IsNullOrWhiteSpace(useTitle) ? null : useTitle.Trim(), attendeeNiks = invitees.Select(i => i.Nik).ToArray() };
            using var res = await Auth.SendAsync(HttpMethod.Post, $"/api/meeting-rooms/{key}/use-now", body);
            if (disposed) return;
            if (res.IsSuccessStatusCode)
            {
                useNow = null; useBusy = false;
                joiningKey = key;                  // the card can't open Use now again while the rooms reload
                StateHasChanged();
                try { await LoadRoomsAsync(); }
                finally { joiningKey = null; }
                if (disposed) return;
                await JoinAsync(key);
                return;
            }
            var (code, max) = await ReadUseNowErrorAsync(res);
            if (code == "room_booked" && max is >= 15 && max != offerMinutes) offerMinutes = max;
            else if (code == "room_booked") { offerMinutes = null; useError = "Someone just booked this room. Pick another room or book a later time."; }
            else if (code == "invalid_minutes") useError = "Choose 30, 60 or 90 minutes.";
            else useError = "The room couldn't be booked right now. Try again.";
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException)
        {
            useError = "The room couldn't be booked right now. Try again.";
        }
        finally
        {
            useBusy = false;
            if (!disposed) StateHasChanged();
        }
    }

    private static async Task<(string? Code, int? Max)> ReadUseNowErrorAsync(HttpResponseMessage res)
    {
        try
        {
            var err = await System.Net.Http.Json.HttpContentJsonExtensions.ReadFromJsonAsync<System.Text.Json.JsonElement>(res.Content);
            if (err.ValueKind != System.Text.Json.JsonValueKind.Object) return (null, null);
            var code = err.TryGetProperty("code", out var c) && c.ValueKind == System.Text.Json.JsonValueKind.String ? c.GetString() : null;
            int? max = err.TryGetProperty("maxMinutes", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.Number && m.TryGetInt32(out var mm) ? mm : null;
            return (code, max);
        }
        catch (Exception e) when (e is System.Text.Json.JsonException or NotSupportedException) { return (null, null); }
    }

    private async Task FocusAsync(string selector)
    {
        await Task.Yield();
        try { await JS.InvokeVoidAsync("ipopRooms.focus", selector); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task DownloadAsync(MeetingRecordingDto rec)
    {
        var url = await TicketUrlAsync(rec.Id);
        if (url is null) { Toasts.Show("This recording can't be downloaded right now.", ToastKind.Error); return; }
        try { await JS.InvokeVoidAsync("ipopRooms.download", url + "&download=1"); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private void Book(MeetingRoomDto room) =>
        Nav.NavigateTo(CalLinks.NewMeeting(location: HallBooking.Location(room.Name), from: "From Meeting Rooms"));

    // ---------------------------------------------------------------- presentation

    /// Always the hall order (Robusta … Toraja), whatever order the API answers in.
    private static IEnumerable<MeetingRoomDto> Ordered(IEnumerable<MeetingRoomDto> list) =>
        list.OrderBy(r => Array.FindIndex(HallBooking.Rooms, h => h.Key == r.Key) is var i and >= 0 ? i : int.MaxValue).ThenBy(r => r.Name);

    private static MeetingRoomDto Fallback(string key) =>
        new(key, HallBooking.Rooms.FirstOrDefault(r => r.Key == key).Name ?? key, HallLimits.RoomCapacity, true, true, [], null, null, null);

    private static Cap? Capsule(MeetingRoomDto r)
    {
        if (!r.Available) return new("Unavailable", "mrt-cap-off");
        if (r.Recording is not null || r.People.Any(p => p.RecordingToPc)) return new("Recording", "is-rec");
        if (r.People.Count >= r.Capacity) return new("Full", "");
        if (r.People.Count > 0) return new("In use", "live");
        return null;
    }

    /// Mockup "Rooms tab" copy. Non-invitees only ever get "Booked" from the API, never the title.
    private static string Subtitle(MeetingRoomDto r)
    {
        if (!r.Available) return "Not available right now";
        if (r.Access == MeetingRoomAccess.Locked) return "Booked";
        if (r.Now is { } now) return now.Title;
        return FreeLabel(r);
    }

    /// "Free until 14:00" (a booking later today) or "Free today".
    private static string FreeLabel(MeetingRoomDto r) =>
        r.Next is { } next && Local(next.StartAt).Date == DateTime.Now.Date ? $"Free until {Hm(next.StartAt)}" : "Free today";

    private static Line InfoLine(MeetingRoomDto r)
    {
        if (r.Access == MeetingRoomAccess.Locked && r.Now is { } booked)
            return new("clock", $"Booked {Hm(booked.StartAt)}–{Hm(booked.EndAt)}");
        var sharer = r.People.FirstOrDefault(p => p.Sharing);
        if (r.Now is { } n)
        {
            if (sharer is not null) return new("monitor-up", $"{FirstName(sharer.Name)} is sharing a screen. Until {Hm(n.EndAt)}.");
            var org = string.IsNullOrWhiteSpace(n.OrganizerName) ? null : FirstName(n.OrganizerName);
            var who = n.IsOrganizer ? "You’re the organizer." : org is null ? "You’re in." : "You’re invited.";
            if (r.Access == MeetingRoomAccess.Starting)
                return new("user-check", n.IsOrganizer ? "You’re the organizer" : org is null ? "You can join early" : $"You’re invited, organizer {org}");
            return new("user-check", $"{who} Until {Hm(n.EndAt)}" + (n.IsOrganizer || org is null ? "" : $", organizer {org}"));
        }
        if (sharer is not null) return new("monitor-up", $"{FirstName(sharer.Name)} is sharing a screen.");
        if (r.Next is { } next) return new("calendar", NextLabel(next, DateTime.Now));
        return new("calendar", "No bookings today");
    }

    private static string NextLabel(MeetingRoomBookingDto b, DateTime nowLocal)
    {
        var start = Local(b.StartAt);
        if (start.Date == nowLocal.Date) return $"Next: {b.Title} at {start:HH:mm}";
        if (start.Date == nowLocal.Date.AddDays(1)) return $"Next: {b.Title} tomorrow at {start:HH:mm}";
        return $"Next: {b.Title} {start.ToString("ddd d MMM", En)} at {start:HH:mm}";
    }

    private static string Hm(DateTime utc) => Local(utc).ToString("HH:mm", En);
    private static string Inside(int n) => n == 0 ? "Nobody inside yet" : n == 1 ? "1 person inside" : $"{n} people inside";
    private static string ChatLabel(int n) => n <= 0 ? "" : n == 1 ? " · 1 chat message" : $" · {n} chat messages";

    /// "00:12", "12:40", "1:02:15": the second of the video a chat line was sent at.
    internal static string Offset(int seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes:00}:{t.Seconds:00}";
    }

    private static string AltLine(MeetingRoomDto r)
    {
        var n = r.People.Count;
        var who = n == 0 ? "Empty" : n == 1 ? "1 person" : $"{n} people";
        return r.VideoAllowed ? who : $"{who}, audio only";
    }

    private int RetentionDays =>
        recordings?.Select(r => (int)Math.Round((ToUtc(r.DeleteAfter) - ToUtc(r.StartedAt)).TotalDays)).FirstOrDefault(d => d > 0) is { } d and > 0
            ? d : DefaultRetentionDays;

    private static string WhenLabel(DateTime utc)
    {
        var t = Local(utc);
        var today = DateTime.Now.Date;
        if (t.Date == today) return $"Today at {t:HH:mm}";
        if (t.Date == today.AddDays(-1)) return $"Yesterday at {t:HH:mm}";
        return t.Year == today.Year ? $"{t.ToString("dddd d MMMM", En)} at {t:HH:mm}" : $"{t.ToString("d MMMM yyyy", En)} at {t:HH:mm}";
    }

    private static string Duration(int seconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, seconds));
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}" : $"{t.Minutes}:{t.Seconds:00}";
    }

    private static string Size(long bytes)
    {
        var mb = bytes / 1024d / 1024d;
        return mb >= 1024 ? (mb / 1024).ToString("0.0", En) + " GB" : Math.Max(1, Math.Round(mb)).ToString("0", En) + " MB";
    }

    private static readonly string[] Faces = ["#c47b45", "#3f7d5a", "#5562b8", "#8a5a3c", "#b0412d", "#2f7f8a"];
    private static string FaceColor(string name)
    {
        var h = 0;
        foreach (var c in name) h = unchecked(h * 31 + c);
        return Faces[(h & int.MaxValue) % Faces.Length];
    }

    private static string FirstName(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;
    private static DateTime ToUtc(DateTime d) => d.Kind == DateTimeKind.Unspecified ? DateTime.SpecifyKind(d, DateTimeKind.Utc) : d.ToUniversalTime();
    private static DateTime Local(DateTime d) => ToUtc(d).ToLocalTime();

    public void Dispose()
    {
        disposed = true;
        Rooms.Changed -= OnRoomsChanged;
        poll?.Dispose();
    }
}
