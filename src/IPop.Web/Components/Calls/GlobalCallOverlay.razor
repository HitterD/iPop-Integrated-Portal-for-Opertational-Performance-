@implements IDisposable
@inject CallState CallSvc
@inject IJSRuntime JS
@inject ToastService Toasts
@inject HttpClient Http
@inject AuthState Auth

@* One call UI for the whole app (styles: css/v6/calls.css):
   incoming ring (Accept / Decline / Decline & message), outgoing ring and the in-call
   window (timer, connection badge, level meters, mute, devices), a minimized pill,
   and a short "call ended" toast. The Calls page only lists history.
   The window and pill are draggable (and the window resizable) by js/call-drag.js, which
   owns their inline style: never render a style attribute on the @ref="dragEl" elements. *@
@{ renderedDragKind = DragKind; }

@if (CallSvc.IsIncomingRing && CallSvc.IsGroup)
{
    var room = CallSvc.Current!;
    var starter = room.Participants.FirstOrDefault(p => p.UserId == room.CreatorId)?.Name ?? "Colleague";
    var joined = CallSvc.GroupJoinedCount;
    var inviteLine = CallSvc.InviteLine;
    <div class="callx-incoming callx-group @(busy ? "" : "mi-ringing-call")" role="alertdialog" aria-live="assertive" aria-label="@(inviteLine ?? $"Group call {CallSvc.GroupName} from {starter}")">
        <div class="callx-incoming-main">
            @GroupAvatar(room, "callx-ring")
            <div class="callx-incoming-text">
                <strong>@CallSvc.GroupName</strong>
                @if (inviteLine is not null)
                {
                    <span class="callx-invite-line"><i data-lucide="user-plus"></i> @inviteLine</span>
                }
                else
                {
                    <span><i data-lucide="users"></i> Group call from @FirstName(starter)</span>
                }
                <small class="callx-sub">@People(joined) in the call</small>
            </div>
        </div>
        @if (CallSvc.NeedsHttps)
        {
            <p class="callx-warn"><i data-lucide="shield-alert"></i> This page is on http — your microphone can't be used. You can only listen.</p>
        }
        <div class="callx-incoming-actions callx-two">
            <button type="button" class="callx-btn callx-decline" disabled="@busy" @onclick="DeclineCall"><i data-lucide="phone-off"></i> Decline</button>
            <button type="button" class="callx-btn callx-accept" disabled="@busy" @onclick="AcceptCall"><i data-lucide="phone"></i> Join</button>
        </div>
    </div>
}
else if (CallSvc.IsInGroupCall)
{
    var room = CallSvc.Current!;
    var muted = CallSvc.ActiveMe?.IsMuted == true;
    var (stateLabel, stateClass) = ConnectionBadge(false);
    var joined = CallSvc.GroupJoinedCount;
    var alone = joined <= 1 && room.EstablishedAt is null;
    @if (isMinimized)
    {
        <div @ref="dragEl" class="callx-pill" role="region" aria-label="Group call @CallSvc.GroupName">
            <button type="button" class="callx-pill-open" @onclick="() => isMinimized = false" title="Open call window">
                @GroupAvatar(room, "sm" + (AnyoneSpeaking ? " speaking" : ""))
                <span class="callx-pill-text">
                    <strong>@CallSvc.GroupName</strong>
                    <small class="callx-state-text @stateClass">Group · @People(joined) · @(alone ? "Calling…" : FormattedElapsed)</small>
                </span>
            </button>
            <button type="button" class="callx-round @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")" title="@(muted ? "Unmute microphone" : "Mute microphone")"><i data-lucide="@(muted ? "mic-off" : "mic")"></i></button>
            <button type="button" class="callx-round hangup" @onclick="EndCall" title="Leave the call"><i data-lucide="phone-off"></i></button>
        </div>
    }
    else
    {
        <div @ref="dragEl" class="callx-window callx-group-window" role="dialog" aria-label="Group call @CallSvc.GroupName">
            <span class="callx-resize" aria-hidden="true" title="Drag to resize"></span>
            <div class="callx-head callx-drag-handle" title="Drag to move">
                <span class="callx-badge @stateClass"><span class="callx-dot"></span>@stateLabel</span>
                <button type="button" class="callx-icon" @onclick="() => isMinimized = true" title="Minimize" aria-label="Minimize call window"><i data-lucide="minimize-2"></i></button>
            </div>
            <div class="callx-body callx-group-body">
                <div class="callx-group-title callx-drag-handle">
                    @GroupAvatar(room, "sm")
                    <div>
                        <h2>@CallSvc.GroupName</h2>
                        <div class="callx-timer" aria-live="off">@People(joined) · @(alone ? $"Calling members… {RingCountdown}" : FormattedElapsed)</div>
                    </div>
                </div>
                <ul class="callx-grid" aria-label="Participants">
                    @foreach (var p in GridParticipants(room))
                    {
                        var media = CallSvc.GroupMedia.GetValueOrDefault(p.Nik);
                        var inCall = p.Status == IPop.Application.Calls.CallParticipantStatus.Accepted;
                        var isMe = p.Nik == Auth.Me?.Nik;
                        var pMuted = isMe ? muted : media?.Muted == true || p.IsMuted;
                        var speaking = inCall && media?.Speaking == true && !pMuted;
                        <li class="callx-tile @(inCall ? "" : "pending") @(speaking ? "is-speaking" : "")" data-nik="@p.Nik">
                            <span class="callx-tile-av">
                                <PersonAvatar Nik="@p.Nik" Name="@p.Name" Size="48" Class="@($"callx-avatar {(speaking ? "speaking" : "")}")" Decorative="true" />
                                @if (inCall && pMuted) { <span class="callx-muted-badge" title="Microphone off"><i data-lucide="mic-off"></i></span> }
                            </span>
                            <span class="callx-tile-name">@(isMe ? "You" : FirstName(p.Name))</span>
                            <small class="callx-tile-state">@TileState(p, inCall, media)</small>
                        </li>
                    }
                </ul>
                @if (!string.IsNullOrEmpty(CallSvc.LastError))
                {
                    <p class="callx-error" role="alert"><i data-lucide="alert-circle"></i> @CallSvc.LastError</p>
                }
                else if (CallSvc.NeedsHttps)
                {
                    <p class="callx-warn"><i data-lucide="shield-alert"></i> The microphone needs HTTPS — other members can't hear you.</p>
                }
            </div>
            @if (showAddPerson)
            {
                <CallAddPerson OnClose="CloseAddPerson" />
            }
            @if (showDevices)
            {
                <div class="callx-devices">
                    <label>Microphone
                        <AppSelect Value="@inputId" ValueChanged="OnInputChanged" Options="InputOptions" Label="Microphone" Block="true" />
                    </label>
                    <label>Speaker
                        <AppSelect Value="@outputId" ValueChanged="OnOutputChanged" Options="OutputOptions" Label="Speaker" Block="true" Disabled="@(CallSvc.Support?.OutputSelect != true)" />
                    </label>
                </div>
            }
            <div class="callx-controls">
                <button type="button" class="callx-ctrl @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")">
                    <span><i data-lucide="@(muted ? "mic-off" : "mic")"></i></span>@(muted ? "Unmute" : "Mute")
                </button>
                @if (CanAddPerson)
                {
                    @AddPersonButton()
                }
                <button type="button" class="callx-ctrl @(showDevices ? "on" : "")" @onclick="ToggleDevices" aria-expanded="@(showDevices ? "true" : "false")">
                    <span><i data-lucide="settings-2"></i></span>Devices
                </button>
                <button type="button" class="callx-ctrl hangup" @onclick="EndCall">
                    <span><i data-lucide="phone-off"></i></span>Leave
                </button>
            </div>
        </div>
    }
}
else if (CallSvc.IsIncomingRing)
{
    var caller = CallSvc.RemotePeer?.Name ?? "Colleague";
    var callerNik = CallSvc.RemotePeer?.Nik;
    <div class="callx-incoming @(busy ? "" : "mi-ringing-call")" role="alertdialog" aria-live="assertive" aria-label="Incoming call from @caller">
        <div class="callx-incoming-main">
            <PersonAvatar Nik="@callerNik" Name="@caller" Size="52" Class="callx-avatar callx-ring" Decorative="true" />
            <div class="callx-incoming-text">
                <strong>@caller</strong>
                <span><i data-lucide="phone-incoming"></i> Incoming voice call…</span>
            </div>
        </div>
        @if (CallSvc.NeedsHttps)
        {
            <p class="callx-warn"><i data-lucide="shield-alert"></i> This page is on http — your microphone can't be used. You can only listen.</p>
        }
        @if (showReplies)
        {
            <div class="callx-replies" role="group" aria-label="Decline and send a message">
                @foreach (var reply in QuickReplies)
                {
                    <button type="button" disabled="@busy" @onclick="() => DeclineWithMessage(reply)">@reply</button>
                }
                <form class="callx-reply-custom" @onsubmit="() => DeclineWithMessage(customReply)" @onsubmit:preventDefault="true">
                    <input aria-label="Other message" placeholder="Write another message…" maxlength="500" @bind="customReply" @bind:event="oninput" />
                    <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(customReply))" aria-label="Decline and send"><i data-lucide="send"></i></button>
                </form>
            </div>
        }
        <div class="callx-incoming-actions">
            <button type="button" class="callx-btn callx-decline" disabled="@busy" @onclick="DeclineCall"><i data-lucide="phone-off"></i> Decline</button>
            <button type="button" class="callx-btn callx-ghost @(showReplies ? "on" : "")" aria-expanded="@(showReplies ? "true" : "false")" @onclick="() => showReplies = !showReplies"><i data-lucide="message-square-text"></i> Message</button>
            <button type="button" class="callx-btn callx-accept" disabled="@busy" @onclick="AcceptCall"><i data-lucide="phone"></i> Accept</button>
        </div>
    </div>
}
else if (CallSvc.IsOutgoingRing || CallSvc.IsActiveCall)
{
    var isOutgoing = CallSvc.IsOutgoingRing;
    var peerName = CallSvc.RemotePeer?.Name ?? "Colleague";
    var peerNik = CallSvc.RemotePeer?.Nik;
    var muted = CallSvc.ActiveMe?.IsMuted == true;
    var (stateLabel, stateClass) = ConnectionBadge(isOutgoing);

    @if (isMinimized)
    {
        <div @ref="dragEl" class="callx-pill" role="region" aria-label="Call with @peerName">
            <button type="button" class="callx-pill-open" @onclick="() => isMinimized = false" title="Open call window">
                <PersonAvatar Nik="@peerNik" Name="@peerName" Size="34" Class="@($"callx-avatar sm avatar-remote-speaker {(isOutgoing ? "callx-ring" : "")}")" Decorative="true" />
                <span class="callx-pill-text">
                    <strong>@peerName</strong>
                    <small class="callx-state-text @stateClass">@(isOutgoing ? "Calling…" : FormattedElapsed)</small>
                </span>
            </button>
            @if (CallSvc.IsActiveCall)
            {
                <button type="button" class="callx-round @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")" title="@(muted ? "Unmute microphone" : "Mute microphone")"><i data-lucide="@(muted ? "mic-off" : "mic")"></i></button>
            }
            <button type="button" class="callx-round hangup" @onclick="EndCall" title="@(isOutgoing ? "Cancel" : "End call")"><i data-lucide="phone-off"></i></button>
        </div>
    }
    else
    {
        <div @ref="dragEl" class="callx-window" role="dialog" aria-label="Voice call with @peerName">
            <span class="callx-resize" aria-hidden="true" title="Drag to resize"></span>
            <div class="callx-head callx-drag-handle" title="Drag to move">
                <span class="callx-badge @stateClass"><span class="callx-dot"></span>@stateLabel</span>
                <button type="button" class="callx-icon" @onclick="() => isMinimized = true" title="Minimize" aria-label="Minimize call window"><i data-lucide="minimize-2"></i></button>
            </div>

            <div class="callx-body">
                <PersonAvatar Nik="@peerNik" Name="@peerName" Size="96" Class="@($"callx-avatar lg avatar-remote-speaker {(isOutgoing ? "callx-ring" : "")}")" Decorative="true" />
                <h2>@peerName</h2>
                <div class="callx-timer" aria-live="off">
                    @if (isOutgoing) { <span>Calling… @RingCountdown</span> }
                    else { <span>@FormattedElapsed</span> }
                </div>

                @if (CallSvc.IsActiveCall)
                {
                    <div class="callx-meters" aria-hidden="true">
                        <div><i data-lucide="@(muted ? "mic-off" : "mic")"></i><span class="callx-meter" data-meter="local"><span></span></span><small>You</small></div>
                        <div><i data-lucide="volume-2"></i><span class="callx-meter" data-meter="remote"><span></span></span><small>@FirstName(peerName)</small></div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(CallSvc.LastError))
                {
                    <p class="callx-error" role="alert"><i data-lucide="alert-circle"></i> @CallSvc.LastError</p>
                }
                else if (CallSvc.NeedsHttps)
                {
                    <p class="callx-warn"><i data-lucide="shield-alert"></i> The microphone needs HTTPS — the other person can't hear you.</p>
                }
            </div>

            @if (showAddPerson && CanAddPerson)
            {
                <CallAddPerson OnClose="CloseAddPerson" />
            }
            @if (showDevices)
            {
                <div class="callx-devices">
                    <label>Microphone
                        <AppSelect Value="@inputId" ValueChanged="OnInputChanged" Options="InputOptions" Label="Microphone" Block="true" />
                    </label>
                    <label>Speaker
                        <AppSelect Value="@outputId" ValueChanged="OnOutputChanged" Options="OutputOptions" Label="Speaker" Block="true" Disabled="@(CallSvc.Support?.OutputSelect != true)" />
                    </label>
                    @if (CallSvc.Support?.OutputSelect != true) { <small>This browser uses the system default speaker.</small> }
                </div>
            }

            <div class="callx-controls">
                @if (CallSvc.IsActiveCall)
                {
                    <button type="button" class="callx-ctrl @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")">
                        <span><i data-lucide="@(muted ? "mic-off" : "mic")"></i></span>@(muted ? "Unmute" : "Mute")
                    </button>
                }
                @if (CanAddPerson)
                {
                    @AddPersonButton()
                }
                <button type="button" class="callx-ctrl @(showDevices ? "on" : "")" @onclick="ToggleDevices" aria-expanded="@(showDevices ? "true" : "false")">
                    <span><i data-lucide="settings-2"></i></span>Devices
                </button>
                <button type="button" class="callx-ctrl hangup" @onclick="EndCall">
                    <span><i data-lucide="phone-off"></i></span>@(isOutgoing ? "Cancel" : "End")
                </button>
            </div>
        </div>
    }
}
else if (!string.IsNullOrEmpty(CallSvc.LastEndReason))
{
    <div class="callx-toast" role="status">
        <i data-lucide="phone-off"></i>
        <span>@CallSvc.LastEndReason</span>
        <button type="button" class="callx-icon" aria-label="Close" @onclick="() => CallSvc.DismissEndReason()"><i data-lucide="x"></i></button>
    </div>
}

@code {
    private static readonly string[] QuickReplies =
    [
        "In a meeting, I'll call you back.",
        "I'll call you shortly.",
        "Can we chat instead?",
    ];

    private bool isMinimized;
    private bool showReplies;
    private bool showDevices;
    private bool showAddPerson;
    private bool busy;
    private string customReply = "";
    private AudioDevices devices = new([], []);
    private string inputId = "";
    private string outputId = "";
    private System.Threading.Timer? ticker;
    private System.Threading.CancellationTokenSource? endReasonCts;
    private Guid? lastCallId;

    // Drag/resize wiring (js/call-drag.js). renderedDragKind is captured during render so
    // OnAfterRenderAsync acts on what was actually rendered, not on newer call state.
    private ElementReference dragEl;
    private string? renderedDragKind;
    private string? attachedDragId;

    /// "window" / "pill" when the draggable in-call UI is on screen; null for rings/toasts.
    /// Mirrors the branch order of the markup above.
    private string? DragKind =>
        CallSvc.IsIncomingRing && CallSvc.IsGroup ? null
        : CallSvc.IsInGroupCall ? (isMinimized ? "pill" : "window")
        : CallSvc.IsIncomingRing ? null
        : CallSvc.IsOutgoingRing || CallSvc.IsActiveCall ? (isMinimized ? "pill" : "window")
        : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (renderedDragKind is null)
            {
                if (attachedDragId is null) return;
                attachedDragId = null;
                await JS.InvokeVoidAsync("ipopCallDrag.detach");
            }
            else if (dragEl.Id != attachedDragId)
            {
                // A new element (pill <-> window, 1:1 <-> group, a new call): re-attach.
                attachedDragId = dragEl.Id;
                await JS.InvokeVoidAsync("ipopCallDrag.attach", dragEl, renderedDragKind);
            }
        }
        catch (JSException) { /* script missing/old cache: the overlay just stays fixed */ }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }

    private string FormattedElapsed
    {
        get
        {
            var est = CallSvc.Current?.EstablishedAt;
            if (est is null) return "00:00";
            var elapsed = DateTime.UtcNow - DateTime.SpecifyKind(est.Value, DateTimeKind.Utc);
            return CallState.FormatDuration(elapsed < TimeSpan.Zero ? TimeSpan.Zero : elapsed);
        }
    }

    private string RingCountdown
    {
        get
        {
            if (CallSvc.Current is not { } c) return "";
            var left = CallSvc.RingTimeoutSeconds - (int)(DateTime.UtcNow - DateTime.SpecifyKind(c.StartedAt, DateTimeKind.Utc)).TotalSeconds;
            return left is > 0 and <= 60 ? $"({left}s)" : "";
        }
    }

    private (string Label, string Css) ConnectionBadge(bool isOutgoing)
    {
        if (isOutgoing) return ("Calling", "ringing");
        return CallSvc.WebRtcState switch
        {
            "connected" => ("Connected", "ok"),
            "reconnecting" => ("Reconnecting…", "warn"),
            "failed" => ("Audio failed to connect", "bad"),
            _ => ("Connecting audio…", "warn"),
        };
    }

    protected override void OnInitialized() => CallSvc.StateChanged += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        var id = CallSvc.Current?.Id;
        if (id != lastCallId)
        {
            // A new call starts expanded with its panels closed.
            lastCallId = id;
            isMinimized = false;
            showReplies = false;
            showDevices = false;
            showAddPerson = false;
            customReply = "";
        }
        UpdateTicker();

        if (!string.IsNullOrEmpty(CallSvc.LastEndReason) && !CallSvc.HasLiveCall)
        {
            endReasonCts?.Cancel();
            endReasonCts?.Dispose();
            endReasonCts = new();
            var token = endReasonCts.Token;
            _ = Task.Delay(4000, token).ContinueWith(t =>
            {
                if (!t.IsCanceled) _ = InvokeAsync(() => CallSvc.DismissEndReason());
            }, TaskScheduler.Default);
        }

        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    });

    /// One-second repaint while a call rings or runs; the text is derived from the
    /// server timestamps, so a missed tick never drifts the clock.
    private void UpdateTicker()
    {
        if (CallSvc.IsOutgoingRing || CallSvc.IsActiveCall || CallSvc.IsInGroupCall)
        {
            ticker ??= new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        }
        else
        {
            ticker?.Dispose();
            ticker = null;
        }
    }

    private async Task AcceptCall()
    {
        busy = true;
        try
        {
            var room = await CallSvc.AcceptCurrentAsync();
            if (room is null) Toasts.Show(CallSvc.LastError ?? "Couldn't accept the call.", ToastKind.Error);
        }
        finally { busy = false; }
    }

    private async Task DeclineCall()
    {
        busy = true;
        try { await CallSvc.DeclineCurrentAsync(); }
        finally { busy = false; }
    }

    private async Task DeclineWithMessage(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        busy = true;
        try
        {
            var sent = await CallSvc.DeclineWithMessageAsync(text);
            Toasts.Show(sent ? "Call declined, message sent." : "Call declined, but the message couldn't be sent.",
                sent ? ToastKind.Success : ToastKind.Error);
        }
        finally { busy = false; }
    }

    private bool AnyoneSpeaking => CallSvc.GroupMedia.Values.Any(m => m.Speaking && !m.Muted);

    /// In-call first (in join order), then invitees still being rung; declined/left drop out.
    private static IEnumerable<IPop.Application.Calls.CallParticipantDto> GridParticipants(IPop.Application.Calls.CallRoomDto room) =>
        room.Participants
            .Where(p => p.Status is IPop.Application.Calls.CallParticipantStatus.Accepted or IPop.Application.Calls.CallParticipantStatus.Invited)
            .OrderBy(p => p.Status == IPop.Application.Calls.CallParticipantStatus.Accepted ? 0 : 1)
            .Take(12);

    private string TileState(IPop.Application.Calls.CallParticipantDto p, bool inCall, GroupMediaParticipant? media)
    {
        if (!inCall)
            return CallSvc.IsRinging(p) ? "Calling…" : "Not joined yet";
        if (p.Nik == Auth.Me?.Nik) return CallSvc.WebRtcState == "connected" ? "Connected" : "Connecting…";
        return media is null ? "Connecting…" : media.Speaking && !media.Muted ? "Speaking" : "Connected";
    }

    /// Any accepted participant may ring someone in: a group/ad-hoc call any time, a 1:1 once answered.
    /// Not in scheduled meetings (no server call room).
    private bool CanAddPerson =>
        !CallSvc.IsMeeting && CallSvc.ActiveMe?.Status == IPop.Application.Calls.CallParticipantStatus.Accepted
        && (CallSvc.IsGroup ? CallSvc.HasLiveCall : CallSvc.IsActiveCall);

    private RenderFragment AddPersonButton() => __builder =>
    {
        <button type="button" class="callx-ctrl callx-add-person @(showAddPerson ? "on" : "")" @onclick="ToggleAddPerson"
                aria-expanded="@(showAddPerson ? "true" : "false")" title="Add person to the call">
            <span><i data-lucide="user-plus"></i></span>Add person
        </button>
    };

    private void ToggleAddPerson()
    {
        showAddPerson = !showAddPerson;
        if (showAddPerson) showDevices = false;
    }

    private void CloseAddPerson() => showAddPerson = false;

    private RenderFragment GroupAvatar(IPop.Application.Calls.CallRoomDto room, string extra) => __builder =>
    {
        if (room.Kind == IPop.Application.Calls.CallKind.AdHoc)
        {
            // Ad-hoc call: no group picture — the person who rang me in (ring) or a people glyph.
            var by = extra.Contains("callx-ring") && CallSvc.ActiveMe?.InvitedById is { } id
                ? room.Participants.FirstOrDefault(p => p.UserId == id) : null;
            if (by is not null)
            {
                <PersonAvatar Nik="@by.Nik" Name="@by.Name" Size="52" Class="@($"callx-avatar {extra}")" Decorative="true" />
            }
            else
            {
                <span class="callx-avatar callx-group-av callx-adhoc-av @extra"><i data-lucide="users"></i></span>
            }
            return;
        }
        var name = string.IsNullOrWhiteSpace(room.Title) ? "Group" : room.Title!;
        var color = string.IsNullOrWhiteSpace(room.AvatarColor) ? AvatarColor(name) : room.AvatarColor;
        <span class="callx-avatar callx-group-av @extra" style="background:@color">
            @if (!string.IsNullOrEmpty(room.AvatarUrl))
            {
                <img src="@(new Uri(Http.BaseAddress!, room.AvatarUrl))" alt="" />
            }
            else
            {
                @Initials(name)
            }
        </span>
    };

    private async Task EndCall()
    {
        if (CallSvc.IsOutgoingRing) await CallSvc.CancelCurrentAsync();
        else await CallSvc.EndCurrentAsync();
    }

    private Task ToggleMute() => CallSvc.ToggleMuteAudioAsync();

    private async Task ToggleDevices()
    {
        showDevices = !showDevices;
        if (showDevices) showAddPerson = false;
        if (showDevices) devices = await CallSvc.ListDevicesAsync();
    }

    private List<AppOption> InputOptions => devices.Inputs.Count == 0
        ? [new AppOption("", "No microphone")]
        : devices.Inputs.Select(d => new AppOption(d.Id, d.Label)).ToList();

    private List<AppOption> OutputOptions => devices.Outputs.Count == 0
        ? [new AppOption("", "System default")]
        : devices.Outputs.Select(d => new AppOption(d.Id, d.Label)).ToList();

    private async Task OnInputChanged(string? v)
    {
        inputId = v ?? "";
        if (!await CallSvc.SetInputDeviceAsync(inputId)) Toasts.Show("That microphone can't be used.", ToastKind.Error);
    }

    private async Task OnOutputChanged(string? v)
    {
        outputId = v ?? "";
        await CallSvc.SetOutputDeviceAsync(outputId);
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2)).ToUpperInvariant();

    private static string People(int n) => n == 1 ? "1 person" : $"{n} people";

    private static string FirstName(string name) => IPop.Application.PersonName.Short(name) is { Length: > 0 } s ? s : name;

    /// Same palette as the Calls history rows, so a person keeps one colour everywhere.
    public static string AvatarColor(string name)
    {
        var colors = new[] { "#197D8C", "#2E9E5B", "#824BAD", "#B85540", "#527D31" };
        var hash = 0u;
        foreach (var c in name) hash = hash * 31 + c;
        return colors[(int)(hash % (uint)colors.Length)];
    }

    public void Dispose()
    {
        CallSvc.StateChanged -= OnStateChanged;
        if (attachedDragId is not null)
        {
            attachedDragId = null;
            try { _ = JS.InvokeVoidAsync("ipopCallDrag.detach").AsTask().ContinueWith(_ => { }, TaskScheduler.Default); }
            catch (JSDisconnectedException) { }
        }
        ticker?.Dispose();
        endReasonCts?.Cancel();
        endReasonCts?.Dispose();
    }
}
