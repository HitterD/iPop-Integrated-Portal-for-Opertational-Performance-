@implements IDisposable
@inject CallState CallSvc
@inject IJSRuntime JS
@inject ToastService Toasts
@inject HttpClient Http
@inject AuthState Auth

@* One call UI for the whole app (styles: css/v6/calls.css):
   incoming ring (Accept / Decline / Decline & message), outgoing ring and the in-call
   window (timer, connection badge, level meters, mute, devices), a minimized pill,
   and a short "call ended" toast. The Calls page only lists history. *@

@if (CallSvc.IsIncomingRing && CallSvc.IsGroup)
{
    var room = CallSvc.Current!;
    var starter = room.Participants.FirstOrDefault(p => p.UserId == room.CreatorId)?.Name ?? "Rekan kerja";
    var joined = CallSvc.GroupJoinedCount;
    <div class="callx-incoming callx-group" role="alertdialog" aria-live="assertive" aria-label="Panggilan grup @CallSvc.GroupName dari @starter">
        <div class="callx-incoming-main">
            @GroupAvatar(room, "callx-ring")
            <div class="callx-incoming-text">
                <strong>@CallSvc.GroupName</strong>
                <span><i data-lucide="users"></i> Panggilan grup dari @FirstName(starter)</span>
                <small class="callx-sub">@joined orang di panggilan</small>
            </div>
        </div>
        @if (CallSvc.NeedsHttps)
        {
            <p class="callx-warn"><i data-lucide="shield-alert"></i> Halaman ini http — mikrofon Anda tidak bisa dipakai. Anda hanya bisa mendengar.</p>
        }
        <div class="callx-incoming-actions callx-two">
            <button type="button" class="callx-btn callx-decline" disabled="@busy" @onclick="DeclineCall"><i data-lucide="phone-off"></i> Tolak</button>
            <button type="button" class="callx-btn callx-accept" disabled="@busy" @onclick="AcceptCall"><i data-lucide="phone"></i> Gabung</button>
        </div>
    </div>
}
else if (CallSvc.IsInGroupCall)
{
    var room = CallSvc.Current!;
    var muted = CallSvc.ActiveMe?.IsMuted == true;
    var (stateLabel, stateClass) = ConnectionBadge(false);
    var joined = CallSvc.GroupJoinedCount;
    var alone = joined <= 1 && room.EstablishedAt is null;
    @if (isMinimized)
    {
        <div class="callx-pill" role="region" aria-label="Panggilan grup @CallSvc.GroupName">
            <button type="button" class="callx-pill-open" @onclick="() => isMinimized = false" title="Buka jendela panggilan">
                @GroupAvatar(room, "sm" + (AnyoneSpeaking ? " speaking" : ""))
                <span class="callx-pill-text">
                    <strong>@CallSvc.GroupName</strong>
                    <small class="callx-state-text @stateClass">Grup · @joined orang · @(alone ? "Memanggil…" : FormattedElapsed)</small>
                </span>
            </button>
            <button type="button" class="callx-round @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")" title="@(muted ? "Nyalakan mikrofon" : "Bisukan mikrofon")"><i data-lucide="@(muted ? "mic-off" : "mic")"></i></button>
            <button type="button" class="callx-round hangup" @onclick="EndCall" title="Keluar dari panggilan"><i data-lucide="phone-off"></i></button>
        </div>
    }
    else
    {
        <div class="callx-window callx-group-window" role="dialog" aria-label="Panggilan grup @CallSvc.GroupName">
            <div class="callx-head">
                <span class="callx-badge @stateClass"><span class="callx-dot"></span>@stateLabel</span>
                <button type="button" class="callx-icon" @onclick="() => isMinimized = true" title="Perkecil" aria-label="Perkecil jendela panggilan"><i data-lucide="minimize-2"></i></button>
            </div>
            <div class="callx-body callx-group-body">
                <div class="callx-group-title">
                    @GroupAvatar(room, "sm")
                    <div>
                        <h2>@CallSvc.GroupName</h2>
                        <div class="callx-timer" aria-live="off">@joined orang · @(alone ? $"Memanggil anggota… {RingCountdown}" : FormattedElapsed)</div>
                    </div>
                </div>
                <ul class="callx-grid" aria-label="Peserta">
                    @foreach (var p in GridParticipants(room))
                    {
                        var media = CallSvc.GroupMedia.GetValueOrDefault(p.Nik);
                        var inCall = p.Status == IPop.Application.Calls.CallParticipantStatus.Accepted;
                        var isMe = p.Nik == Auth.Me?.Nik;
                        var pMuted = isMe ? muted : media?.Muted == true || p.IsMuted;
                        var speaking = inCall && media?.Speaking == true && !pMuted;
                        <li class="callx-tile @(inCall ? "" : "pending") @(speaking ? "is-speaking" : "")" data-nik="@p.Nik">
                            <span class="callx-avatar @(speaking ? "speaking" : "")" style="background:@AvatarColor(p.Name)">
                                @Initials(p.Name)
                                @if (inCall && pMuted) { <span class="callx-muted-badge" title="Mikrofon mati"><i data-lucide="mic-off"></i></span> }
                            </span>
                            <span class="callx-tile-name">@(isMe ? "Anda" : FirstName(p.Name))</span>
                            <small class="callx-tile-state">@TileState(p, inCall, media)</small>
                        </li>
                    }
                </ul>
                @if (!string.IsNullOrEmpty(CallSvc.LastError))
                {
                    <p class="callx-error" role="alert"><i data-lucide="alert-circle"></i> @CallSvc.LastError</p>
                }
                else if (CallSvc.NeedsHttps)
                {
                    <p class="callx-warn"><i data-lucide="shield-alert"></i> Mikrofon butuh HTTPS — anggota lain tidak bisa mendengar Anda.</p>
                }
            </div>
            @if (showDevices)
            {
                <div class="callx-devices">
                    <label>Mikrofon
                        <select @onchange="OnInputChanged">
                            @foreach (var d in devices.Inputs) { <option value="@d.Id" selected="@(d.Id == inputId)">@d.Label</option> }
                            @if (devices.Inputs.Count == 0) { <option value="">Tidak ada mikrofon</option> }
                        </select>
                    </label>
                    <label>Speaker
                        <select @onchange="OnOutputChanged" disabled="@(CallSvc.Support?.OutputSelect != true)">
                            @foreach (var d in devices.Outputs) { <option value="@d.Id" selected="@(d.Id == outputId)">@d.Label</option> }
                            @if (devices.Outputs.Count == 0) { <option value="">Default sistem</option> }
                        </select>
                    </label>
                </div>
            }
            <div class="callx-controls">
                <button type="button" class="callx-ctrl @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")">
                    <span><i data-lucide="@(muted ? "mic-off" : "mic")"></i></span>@(muted ? "Nyalakan" : "Bisukan")
                </button>
                <button type="button" class="callx-ctrl @(showDevices ? "on" : "")" @onclick="ToggleDevices" aria-expanded="@(showDevices ? "true" : "false")">
                    <span><i data-lucide="settings-2"></i></span>Perangkat
                </button>
                <button type="button" class="callx-ctrl hangup" @onclick="EndCall">
                    <span><i data-lucide="phone-off"></i></span>Keluar
                </button>
            </div>
        </div>
    }
}
else if (CallSvc.IsIncomingRing)
{
    var caller = CallSvc.RemotePeer?.Name ?? "Rekan kerja";
    <div class="callx-incoming" role="alertdialog" aria-live="assertive" aria-label="Panggilan masuk dari @caller">
        <div class="callx-incoming-main">
            <span class="callx-avatar callx-ring" style="background:@AvatarColor(caller)">@Initials(caller)</span>
            <div class="callx-incoming-text">
                <strong>@caller</strong>
                <span><i data-lucide="phone-incoming"></i> Panggilan suara masuk…</span>
            </div>
        </div>
        @if (CallSvc.NeedsHttps)
        {
            <p class="callx-warn"><i data-lucide="shield-alert"></i> Halaman ini http — mikrofon Anda tidak bisa dipakai. Anda hanya bisa mendengar.</p>
        }
        @if (showReplies)
        {
            <div class="callx-replies" role="group" aria-label="Tolak dan kirim pesan">
                @foreach (var reply in QuickReplies)
                {
                    <button type="button" disabled="@busy" @onclick="() => DeclineWithMessage(reply)">@reply</button>
                }
                <form class="callx-reply-custom" @onsubmit="() => DeclineWithMessage(customReply)" @onsubmit:preventDefault="true">
                    <input aria-label="Pesan lain" placeholder="Tulis pesan lain…" maxlength="500" @bind="customReply" @bind:event="oninput" />
                    <button type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(customReply))" aria-label="Tolak dan kirim"><i data-lucide="send"></i></button>
                </form>
            </div>
        }
        <div class="callx-incoming-actions">
            <button type="button" class="callx-btn callx-decline" disabled="@busy" @onclick="DeclineCall"><i data-lucide="phone-off"></i> Tolak</button>
            <button type="button" class="callx-btn callx-ghost @(showReplies ? "on" : "")" aria-expanded="@(showReplies ? "true" : "false")" @onclick="() => showReplies = !showReplies"><i data-lucide="message-square-text"></i> Pesan</button>
            <button type="button" class="callx-btn callx-accept" disabled="@busy" @onclick="AcceptCall"><i data-lucide="phone"></i> Terima</button>
        </div>
    </div>
}
else if (CallSvc.IsOutgoingRing || CallSvc.IsActiveCall)
{
    var isOutgoing = CallSvc.IsOutgoingRing;
    var peerName = CallSvc.RemotePeer?.Name ?? "Rekan kerja";
    var muted = CallSvc.ActiveMe?.IsMuted == true;
    var (stateLabel, stateClass) = ConnectionBadge(isOutgoing);

    @if (isMinimized)
    {
        <div class="callx-pill" role="region" aria-label="Panggilan dengan @peerName">
            <button type="button" class="callx-pill-open" @onclick="() => isMinimized = false" title="Buka jendela panggilan">
                <span class="callx-avatar sm avatar-remote-speaker @(isOutgoing ? "callx-ring" : "")" style="background:@AvatarColor(peerName)">@Initials(peerName)</span>
                <span class="callx-pill-text">
                    <strong>@peerName</strong>
                    <small class="callx-state-text @stateClass">@(isOutgoing ? "Memanggil…" : FormattedElapsed)</small>
                </span>
            </button>
            @if (CallSvc.IsActiveCall)
            {
                <button type="button" class="callx-round @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")" title="@(muted ? "Nyalakan mikrofon" : "Bisukan mikrofon")"><i data-lucide="@(muted ? "mic-off" : "mic")"></i></button>
            }
            <button type="button" class="callx-round hangup" @onclick="EndCall" title="@(isOutgoing ? "Batalkan" : "Akhiri panggilan")"><i data-lucide="phone-off"></i></button>
        </div>
    }
    else
    {
        <div class="callx-window" role="dialog" aria-label="Panggilan suara dengan @peerName">
            <div class="callx-head">
                <span class="callx-badge @stateClass"><span class="callx-dot"></span>@stateLabel</span>
                <button type="button" class="callx-icon" @onclick="() => isMinimized = true" title="Perkecil" aria-label="Perkecil jendela panggilan"><i data-lucide="minimize-2"></i></button>
            </div>

            <div class="callx-body">
                <span class="callx-avatar lg avatar-remote-speaker @(isOutgoing ? "callx-ring" : "")" style="background:@AvatarColor(peerName)">@Initials(peerName)</span>
                <h2>@peerName</h2>
                <div class="callx-timer" aria-live="off">
                    @if (isOutgoing) { <span>Memanggil… @RingCountdown</span> }
                    else { <span>@FormattedElapsed</span> }
                </div>

                @if (CallSvc.IsActiveCall)
                {
                    <div class="callx-meters" aria-hidden="true">
                        <div><i data-lucide="@(muted ? "mic-off" : "mic")"></i><span class="callx-meter" data-meter="local"><span></span></span><small>Anda</small></div>
                        <div><i data-lucide="volume-2"></i><span class="callx-meter" data-meter="remote"><span></span></span><small>@FirstName(peerName)</small></div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(CallSvc.LastError))
                {
                    <p class="callx-error" role="alert"><i data-lucide="alert-circle"></i> @CallSvc.LastError</p>
                }
                else if (CallSvc.NeedsHttps)
                {
                    <p class="callx-warn"><i data-lucide="shield-alert"></i> Mikrofon butuh HTTPS — lawan bicara tidak bisa mendengar Anda.</p>
                }
            </div>

            @if (showDevices)
            {
                <div class="callx-devices">
                    <label>Mikrofon
                        <select @onchange="OnInputChanged">
                            @foreach (var d in devices.Inputs) { <option value="@d.Id" selected="@(d.Id == inputId)">@d.Label</option> }
                            @if (devices.Inputs.Count == 0) { <option value="">Tidak ada mikrofon</option> }
                        </select>
                    </label>
                    <label>Speaker
                        <select @onchange="OnOutputChanged" disabled="@(CallSvc.Support?.OutputSelect != true)">
                            @foreach (var d in devices.Outputs) { <option value="@d.Id" selected="@(d.Id == outputId)">@d.Label</option> }
                            @if (devices.Outputs.Count == 0) { <option value="">Default sistem</option> }
                        </select>
                    </label>
                    @if (CallSvc.Support?.OutputSelect != true) { <small>Browser ini memakai speaker default sistem.</small> }
                </div>
            }

            <div class="callx-controls">
                @if (CallSvc.IsActiveCall)
                {
                    <button type="button" class="callx-ctrl @(muted ? "on" : "")" @onclick="ToggleMute" aria-pressed="@(muted ? "true" : "false")">
                        <span><i data-lucide="@(muted ? "mic-off" : "mic")"></i></span>@(muted ? "Nyalakan" : "Bisukan")
                    </button>
                }
                <button type="button" class="callx-ctrl @(showDevices ? "on" : "")" @onclick="ToggleDevices" aria-expanded="@(showDevices ? "true" : "false")">
                    <span><i data-lucide="settings-2"></i></span>Perangkat
                </button>
                <button type="button" class="callx-ctrl hangup" @onclick="EndCall">
                    <span><i data-lucide="phone-off"></i></span>@(isOutgoing ? "Batalkan" : "Akhiri")
                </button>
            </div>
        </div>
    }
}
else if (!string.IsNullOrEmpty(CallSvc.LastEndReason))
{
    <div class="callx-toast" role="status">
        <i data-lucide="phone-off"></i>
        <span>@CallSvc.LastEndReason</span>
        <button type="button" class="callx-icon" aria-label="Tutup" @onclick="() => CallSvc.DismissEndReason()"><i data-lucide="x"></i></button>
    </div>
}

@code {
    private static readonly string[] QuickReplies =
    [
        "Sedang rapat, nanti saya telepon balik.",
        "Sebentar lagi saya hubungi.",
        "Bisa lewat chat saja?",
    ];

    private bool isMinimized;
    private bool showReplies;
    private bool showDevices;
    private bool busy;
    private string customReply = "";
    private AudioDevices devices = new([], []);
    private string inputId = "";
    private string outputId = "";
    private System.Threading.Timer? ticker;
    private System.Threading.CancellationTokenSource? endReasonCts;
    private Guid? lastCallId;

    private string FormattedElapsed
    {
        get
        {
            var est = CallSvc.Current?.EstablishedAt;
            if (est is null) return "00:00";
            var elapsed = DateTime.UtcNow - DateTime.SpecifyKind(est.Value, DateTimeKind.Utc);
            return CallState.FormatDuration(elapsed < TimeSpan.Zero ? TimeSpan.Zero : elapsed);
        }
    }

    private string RingCountdown
    {
        get
        {
            if (CallSvc.Current is not { } c) return "";
            var left = CallSvc.RingTimeoutSeconds - (int)(DateTime.UtcNow - DateTime.SpecifyKind(c.StartedAt, DateTimeKind.Utc)).TotalSeconds;
            return left is > 0 and <= 60 ? $"({left} dtk)" : "";
        }
    }

    private (string Label, string Css) ConnectionBadge(bool isOutgoing)
    {
        if (isOutgoing) return ("Memanggil", "ringing");
        return CallSvc.WebRtcState switch
        {
            "connected" => ("Terhubung", "ok"),
            "reconnecting" => ("Menyambung ulang…", "warn"),
            "failed" => ("Audio gagal tersambung", "bad"),
            _ => ("Menyambungkan audio…", "warn"),
        };
    }

    protected override void OnInitialized() => CallSvc.StateChanged += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(async () =>
    {
        var id = CallSvc.Current?.Id;
        if (id != lastCallId)
        {
            // A new call starts expanded with its panels closed.
            lastCallId = id;
            isMinimized = false;
            showReplies = false;
            showDevices = false;
            customReply = "";
        }
        UpdateTicker();

        if (!string.IsNullOrEmpty(CallSvc.LastEndReason) && !CallSvc.HasLiveCall)
        {
            endReasonCts?.Cancel();
            endReasonCts?.Dispose();
            endReasonCts = new();
            var token = endReasonCts.Token;
            _ = Task.Delay(4000, token).ContinueWith(t =>
            {
                if (!t.IsCanceled) _ = InvokeAsync(() => CallSvc.DismissEndReason());
            }, TaskScheduler.Default);
        }

        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    });

    /// One-second repaint while a call rings or runs; the text is derived from the
    /// server timestamps, so a missed tick never drifts the clock.
    private void UpdateTicker()
    {
        if (CallSvc.IsOutgoingRing || CallSvc.IsActiveCall || CallSvc.IsInGroupCall)
        {
            ticker ??= new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 1000, 1000);
        }
        else
        {
            ticker?.Dispose();
            ticker = null;
        }
    }

    private async Task AcceptCall()
    {
        busy = true;
        try
        {
            var room = await CallSvc.AcceptCurrentAsync();
            if (room is null) Toasts.Show(CallSvc.LastError ?? "Gagal menerima panggilan.", ToastKind.Error);
        }
        finally { busy = false; }
    }

    private async Task DeclineCall()
    {
        busy = true;
        try { await CallSvc.DeclineCurrentAsync(); }
        finally { busy = false; }
    }

    private async Task DeclineWithMessage(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        busy = true;
        try
        {
            var sent = await CallSvc.DeclineWithMessageAsync(text);
            Toasts.Show(sent ? "Panggilan ditolak, pesan terkirim." : "Panggilan ditolak, tapi pesan gagal dikirim.",
                sent ? ToastKind.Success : ToastKind.Error);
        }
        finally { busy = false; }
    }

    private bool AnyoneSpeaking => CallSvc.GroupMedia.Values.Any(m => m.Speaking && !m.Muted);

    /// In-call first (in join order), then invitees still being rung; declined/left drop out.
    private static IEnumerable<IPop.Application.Calls.CallParticipantDto> GridParticipants(IPop.Application.Calls.CallRoomDto room) =>
        room.Participants
            .Where(p => p.Status is IPop.Application.Calls.CallParticipantStatus.Accepted or IPop.Application.Calls.CallParticipantStatus.Invited)
            .OrderBy(p => p.Status == IPop.Application.Calls.CallParticipantStatus.Accepted ? 0 : 1)
            .Take(12);

    private string TileState(IPop.Application.Calls.CallParticipantDto p, bool inCall, GroupMediaParticipant? media)
    {
        if (!inCall)
        {
            var ringing = CallSvc.Current is { } c && DateTime.UtcNow - DateTime.SpecifyKind(c.StartedAt, DateTimeKind.Utc) < TimeSpan.FromSeconds(CallSvc.RingTimeoutSeconds);
            return ringing ? "Memanggil…" : "Belum bergabung";
        }
        if (p.Nik == Auth.Me?.Nik) return CallSvc.WebRtcState == "connected" ? "Terhubung" : "Menghubungkan…";
        return media is null ? "Menghubungkan…" : media.Speaking && !media.Muted ? "Berbicara" : "Terhubung";
    }

    private RenderFragment GroupAvatar(IPop.Application.Calls.CallRoomDto room, string extra) => __builder =>
    {
        var name = string.IsNullOrWhiteSpace(room.Title) ? "Grup" : room.Title!;
        var color = string.IsNullOrWhiteSpace(room.AvatarColor) ? AvatarColor(name) : room.AvatarColor;
        <span class="callx-avatar callx-group-av @extra" style="background:@color">
            @if (!string.IsNullOrEmpty(room.AvatarUrl))
            {
                <img src="@(new Uri(Http.BaseAddress!, room.AvatarUrl))" alt="" />
            }
            else
            {
                @Initials(name)
            }
        </span>
    };

    private async Task EndCall()
    {
        if (CallSvc.IsOutgoingRing) await CallSvc.CancelCurrentAsync();
        else await CallSvc.EndCurrentAsync();
    }

    private Task ToggleMute() => CallSvc.ToggleMuteAudioAsync();

    private async Task ToggleDevices()
    {
        showDevices = !showDevices;
        if (showDevices) devices = await CallSvc.ListDevicesAsync();
    }

    private async Task OnInputChanged(ChangeEventArgs e)
    {
        inputId = e.Value?.ToString() ?? "";
        if (!await CallSvc.SetInputDeviceAsync(inputId)) Toasts.Show("Mikrofon itu tidak bisa dipakai.", ToastKind.Error);
    }

    private async Task OnOutputChanged(ChangeEventArgs e)
    {
        outputId = e.Value?.ToString() ?? "";
        await CallSvc.SetOutputDeviceAsync(outputId);
    }

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2)).ToUpperInvariant();

    private static string FirstName(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? name;

    /// Same palette as the Calls history rows, so a person keeps one colour everywhere.
    public static string AvatarColor(string name)
    {
        var colors = new[] { "#197D8C", "#2E9E5B", "#824BAD", "#B85540", "#527D31" };
        var hash = 0u;
        foreach (var c in name) hash = hash * 31 + c;
        return colors[(int)(hash % (uint)colors.Length)];
    }

    public void Dispose()
    {
        CallSvc.StateChanged -= OnStateChanged;
        ticker?.Dispose();
        endReasonCts?.Cancel();
        endReasonCts?.Dispose();
    }
}
