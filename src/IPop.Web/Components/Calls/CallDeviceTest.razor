@implements IAsyncDisposable
@inject IJSRuntime JS
@inject CallState CallSvc

@* "Tes perangkat": check microphone and speaker before calling anyone. Nothing is sent to the server. *@

@if (Open)
{
    <div class="callx-dialog-backdrop" @onclick="Close"></div>
    <div class="callx-dialog" role="dialog" aria-modal="true" aria-labelledby="callx-test-title">
        <div class="callx-dialog-head">
            <h2 id="callx-test-title"><i data-lucide="headphones"></i> Test devices</h2>
            <button type="button" class="callx-icon" aria-label="Close" @onclick="Close"><i data-lucide="x"></i></button>
        </div>

        @if (support is { Secure: false })
        {
            <p class="callx-warn"><i data-lucide="shield-alert"></i> This page was opened over http. Browsers only allow the microphone on https or localhost — open the https version (port 7103).</p>
        }

        <section class="callx-test-block">
            <label>Microphone
                <AppSelect Value="@inputId" ValueChanged="OnInputChanged" Options="InputOptions" Label="Microphone" Block="true" Disabled="@(devices.Inputs.Count == 0)" />
            </label>
            <div class="callx-test-meter">
                <i data-lucide="mic"></i>
                <span class="callx-meter wide" data-meter="test"><span></span></span>
            </div>
            <small class="@(micStatus.StartsWith("✓") ? "ok" : micError ? "bad" : "")">@micStatus</small>
            <button type="button" class="callx-btn callx-ghost" @onclick="ToggleMic">
                <i data-lucide="@(micOn ? "square" : "mic")"></i> @(micOn ? "Stop microphone test" : "Test microphone")
            </button>
        </section>

        <section class="callx-test-block">
            <label>Speaker
                <AppSelect Value="@outputId" ValueChanged="v => outputId = v ?? string.Empty" Options="OutputOptions" Label="Speaker" Block="true" Disabled="@(support?.OutputSelect != true)" />
            </label>
            @if (support?.OutputSelect != true) { <small>This browser uses the system default speaker.</small> }
            <small class="@(speakerError ? "bad" : "")">@speakerStatus</small>
            <button type="button" class="callx-btn callx-ghost" @onclick="PlayTone"><i data-lucide="volume-2"></i> Play test tone</button>
        </section>

        <div class="callx-dialog-foot">
            <button type="button" class="callx-btn callx-accept" @onclick="Close">Done</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private bool wasOpen;
    private CallSupport? support;
    private AudioDevices devices = new([], []);
    private string inputId = "";
    private string outputId = "";
    private bool micOn;
    private bool micError;
    private string micStatus = "Press Test microphone, then speak — the green bar should move.";
    private bool speakerError;
    private string speakerStatus = "";

    protected override async Task OnParametersSetAsync()
    {
        if (Open && !wasOpen)
        {
            support = await JS.InvokeAsync<CallSupport>("ipopAudio.checkSupport");
            devices = await CallSvc.ListDevicesAsync();
        }
        if (!Open && wasOpen) await StopMic();
        wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open) await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task ToggleMic()
    {
        if (micOn) { await StopMic(); return; }
        var r = await JS.InvokeAsync<MicCheck>("ipopAudio.startMicTest", inputId);
        micOn = r.Ok;
        micError = !r.Ok;
        micStatus = r.Ok ? $"✓ Microphone on{(string.IsNullOrEmpty(r.Label) ? "" : $": {r.Label}")}. Speak to see the level." : r.Message ?? "Couldn't open the microphone.";
        // Labels are only visible after permission is granted — refresh the list.
        if (r.Ok) devices = await CallSvc.ListDevicesAsync();
    }

    private List<AppOption> InputOptions => devices.Inputs.Count == 0
        ? [new AppOption("", "No microphone detected yet")]
        : devices.Inputs.Select(d => new AppOption(d.Id, d.Label)).ToList();

    private List<AppOption> OutputOptions => devices.Outputs.Count == 0
        ? [new AppOption("", "System default")]
        : devices.Outputs.Select(d => new AppOption(d.Id, d.Label)).ToList();

    private async Task OnInputChanged(string? v)
    {
        inputId = v ?? "";
        if (micOn) { await StopMic(); await ToggleMic(); }
    }

    private async Task StopMic()
    {
        await JS.InvokeVoidAsync("ipopAudio.stopMicTest");
        micOn = false;
    }

    private async Task PlayTone()
    {
        var r = await JS.InvokeAsync<MicCheck>("ipopAudio.playTestTone", outputId);
        speakerError = !r.Ok;
        speakerStatus = r.Ok ? "Heard three tones? Your speaker is ready." : r.Message ?? "Couldn't play the test tone.";
    }

    private async Task Close()
    {
        await StopMic();
        await OpenChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ipopAudio.stopMicTest"); } catch (JSDisconnectedException) { }
    }
}
