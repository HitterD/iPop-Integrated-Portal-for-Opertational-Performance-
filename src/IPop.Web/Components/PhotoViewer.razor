@implements IDisposable
@inject PhotoViewerState Viewer
@inject OverlayStack Overlays
@inject IJSRuntime JS

@if (Viewer.IsOpen)
{
    <div class="photo-viewer" role="dialog" aria-modal="true" aria-label="Photo of @Viewer.Name" @onclick="Viewer.Close">
        <div class="photo-viewer-bar">
            @if (!string.IsNullOrEmpty(Viewer.Name)) { <span class="photo-viewer-name">@Viewer.Name</span> }
            <button type="button" class="photo-viewer-x" title="Close" aria-label="Close" @onclick="Viewer.Close"><i data-lucide="x"></i></button>
        </div>
        <img class="@(Viewer.Square ? "pv-square" : null)" src="@Viewer.Url" alt="Photo of @Viewer.Name" @onclick:stopPropagation="true" />
        @if (Viewer.ActionLabel is not null)
        {
            <div class="photo-viewer-foot" @onclick:stopPropagation="true">
                <button type="button" class="pv-action" @onclick="Viewer.RunActionAsync"><i data-lucide="camera"></i> @Viewer.ActionLabel</button>
            </div>
        }
    </div>
}

@code {
    private IDisposable? _registration;

    protected override void OnInitialized() => Viewer.Changed += OnChanged;

    protected override void OnAfterRender(bool firstRender)
    {
        if (Viewer.IsOpen) _ = JS.InvokeVoidAsync("ipop.icons").AsTask().ContinueWith(_ => { });
    }

    private void OnChanged()
    {
        if (Viewer.IsOpen && _registration is null)
            _registration = Overlays.Push(() => { Viewer.Close(); return Task.CompletedTask; });
        else if (!Viewer.IsOpen) { _registration?.Dispose(); _registration = null; }
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Viewer.Changed -= OnChanged;
        _registration?.Dispose();
    }
}
