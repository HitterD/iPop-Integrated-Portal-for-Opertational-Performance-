@* Calendar meeting detail, hall-room booking (meeting rooms v2 §1.4, mockup "Calendar invite"): the room password with
   Copy, and New password for the organizer. GET /api/meetings/{id} returns RoomPassword only to the organizer and
   attendees who did not decline, so nobody else ever sees the box. *@
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS

@if (Shown && password is { } pw)
{
    <div class="mrt-pw-box" aria-label="Room password">
        <div><div class="mrt-pw-k">Room password</div><div class="mrt-pw-v">@IPop.Application.Hall.RoomPasswords.Format(pw)</div></div>
        <div class="mrt-pw-acts">
            <button type="button" class="mrt-icon-b" title="Copy" aria-label="Copy the room password" @onclick="CopyAsync"><i data-lucide="copy"></i></button>
            @if (isOrganizer)
            {
                <button type="button" class="mrt-icon-b" title="New password" aria-label="Make a new room password" disabled="@busy" @onclick="RegenerateAsync"><i data-lucide="refresh-cw"></i></button>
            }
        </div>
    </div>
    <p class="mrt-pw-note"><i data-lucide="info"></i>Invited people don’t need it. Share it with a guest who isn’t on the invite. Only the organizer and invitees can see it.</p>
}

@code {
    [Parameter] public Guid? MeetingId { get; set; }
    [Parameter] public string? Location { get; set; }
    [Parameter] public string? MeetingStatus { get; set; }

    private string? password;
    private bool isOrganizer, busy, disposed;
    private Guid? loadedFor;

    private bool Shown => MeetingId is not null && MeetingStatus != "cancelled" && IPop.Application.Hall.HallBooking.RoomKey(Location) is not null;

    private sealed record MeetingPasswordDto(Guid Id, Guid OrganizerId, string? RoomPassword);
    private sealed record NewPasswordDto(string? Password);

    protected override async Task OnParametersSetAsync()
    {
        if (!Shown) { password = null; loadedFor = null; return; }
        if (loadedFor == MeetingId) return;
        loadedFor = MeetingId;
        password = null; isOrganizer = false;
        var id = MeetingId!.Value;
        try
        {
            var m = await Auth.GetAsync<MeetingPasswordDto>($"/api/meetings/{id}");
            if (disposed || loadedFor != id || m is null) return;
            password = string.IsNullOrEmpty(m.RoomPassword) ? null : m.RoomPassword;
            isOrganizer = Auth.Me?.UserId is { } me && me == m.OrganizerId;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
    }

    private async Task CopyAsync()
    {
        if (password is not { } pw) return;
        bool ok;
        try { ok = await JS.InvokeAsync<bool>("ipopLinks.copy", pw); }
        catch (Exception e) when (e is JSException or InvalidOperationException or TaskCanceledException) { ok = false; }
        Toasts.Show(ok ? "Password copied." : $"Couldn't copy. The password is {IPop.Application.Hall.RoomPasswords.Format(pw)}.", ok ? ToastKind.Success : ToastKind.Warning);
    }

    private async Task RegenerateAsync()
    {
        if (MeetingId is not { } id || busy) return;
        if (!await Confirm.AskAsync("Make a new password?", "The old one stops working for people who haven't joined yet.", "New password", danger: false)) return;
        busy = true;
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Post, $"/api/meetings/{id}/room-password");
            if (disposed) return;
            var body = res.IsSuccessStatusCode ? await System.Net.Http.Json.HttpContentJsonExtensions.ReadFromJsonAsync<NewPasswordDto>(res.Content) : null;
            if (body?.Password is { Length: 6 } next) { password = next; Toasts.Show("New password made. Share it again with your guests.", ToastKind.Success); }
            else Toasts.Show(res.StatusCode == System.Net.HttpStatusCode.Forbidden ? "Only the organizer can make a new password." : "The password couldn't be changed. Try again.", ToastKind.Error);
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            Toasts.Show("The password couldn't be changed. Try again.", ToastKind.Error);
        }
        finally
        {
            busy = false;
            if (!disposed) StateHasChanged();
        }
    }

    public void Dispose() => disposed = true;
}
