@implements IDisposable
@inject ConfirmService Confirm

@* Markup mirrors Components/Chat/ConfirmDialog so the service-driven confirm looks the same. *@
@if ((Confirm.Current ?? leaving) is { } c)
{
    <div class="backdrop on confirm-backdrop @(Confirm.Current is null ? "mi-closing" : "")" @onclick="() => Confirm.Resolve(false)"></div>
    <div class="confirm-center @(Confirm.Current is null ? "mi-closing" : "")" @onclick="() => Confirm.Resolve(false)">
        <div class="confirm-card" role="alertdialog" aria-modal="true" aria-label="@c.Title" @onclick:stopPropagation>
            <h3 class="confirm-title">@c.Title</h3>
            <p class="confirm-message">@c.Body</p>
            <div class="confirm-actions">
                <button class="comp-btn confirm-cancel" @onclick="() => Confirm.Resolve(false)">Cancel</button>
                <button class="cm-btn primary confirm-submit @(c.Danger ? "danger" : "")" @onclick="() => Confirm.Resolve(true)">@c.ConfirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    // The request that just closed, kept for the 180ms exit animation (core/micro.css).
    private ConfirmRequest? leaving, shown;
    private CancellationTokenSource? _exitCts;

    protected override void OnInitialized() => Confirm.Changed += OnChanged;
    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (Confirm.Current is { } now) { _exitCts?.Cancel(); leaving = null; shown = now; StateHasChanged(); return; }
        if (shown is null) { StateHasChanged(); return; }
        leaving = shown; shown = null;
        var cts = _exitCts = new CancellationTokenSource();
        StateHasChanged();
        try { await Task.Delay(180, cts.Token); } catch (TaskCanceledException) { return; }
        leaving = null;
        StateHasChanged();
    });
    public void Dispose() => Confirm.Changed -= OnChanged;
}
