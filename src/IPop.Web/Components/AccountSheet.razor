@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject ToastService Toasts
@inject OverlayStack Overlays
@inject NavigationManager Nav
@inject PhoneState Phone

@* Account sheet (macOS System Settings style): photo + read-only HR details + email, and a
   pushed "Change password" pane. Opened from the sidebar account menu. *@
@if (IsOpen)
{
    @if (Phone.IsPhone && pane == Pane.Profile)
    {
        <BottomSheet Open="true" OpenChanged="_ => Close()" Title="Profile" Size="SheetSize.Full" Class="m-profile">
            <Leading><button type="button" class="m-profile-close" @onclick="Close">Close</button></Leading>
            <ChildContent>
                @if (me is null) { <p role="status">Loading profile…</p> }
                else
                {
                    <section class="m-profile-hero">
                        <span class="acct-av" style="@(preview is not null ? $"background:url('{preview}') center/cover" : AvatarPhotos.Style(me.Nik))">@Initials</span>
                        <h2>@me.Name</h2><p>@me.Department</p><p>@me.Site</p>
                        <input type="file" accept="image/jpeg,image/png,image/webp" @ref="fileInput" @onchange="PickPhoto" disabled="@busyPhoto" hidden />
                        <div class="m-profile-photo-actions"><button type="button" class="m-profile-link" @onclick="OpenPicker" disabled="@busyPhoto">Change photo</button>
                        @if (HasPhoto) { <button type="button" class="m-profile-link danger" @onclick="RemovePhoto" disabled="@busyPhoto">Remove photo</button> }</div>
                    </section>
                    @if (photoError is not null) { <p role="alert">@photoError</p> }
                    <h3>Contact · you can edit</h3>
                    <div class="m-profile-group">
                        @if (editingEmail)
                        {
                            <form class="m-profile-email" @onsubmit="SaveEmail" @onsubmit:preventDefault>
                                <label>Email<input type="email" autocomplete="email" @ref="emailInput" @bind="email" @bind:event="oninput" disabled="@busyEmail" aria-label="Email" /></label>
                                <button type="button" @onclick="CancelEmail" disabled="@busyEmail">Cancel</button><button type="submit" disabled="@(busyEmail || !EmailDirty)">Save</button>
                            </form>
                        }
                        else { <button type="button" aria-label="Edit email" @onclick="EditEmail"><i data-lucide="mail"></i><span>Email<small>@me.Email</small></span><i data-lucide="pencil"></i></button> }
                        @if (editingExt)
                        {
                            <form class="m-profile-extension" @onsubmit="SaveExt" @onsubmit:preventDefault>
                                <label>Extension<input inputmode="numeric" maxlength="8" @ref="extInput" @bind="ext" @bind:event="oninput" disabled="@busyExt" aria-label="Phone extension" /></label>
                                <button type="button" @onclick="CancelExt" disabled="@busyExt">Cancel</button><button type="submit" disabled="@(busyExt || !ExtDirty)">Save</button>
                            </form>
                        }
                        else { <button type="button" aria-label="Edit extension" @onclick="EditExt"><i data-lucide="phone"></i><span>Extension<small>@(me.Extension ?? "Not set") · shown in the Directory</small></span><i data-lucide="pencil"></i></button> }
                    </div>
                    @if (emailError is not null) { <p role="alert">@emailError</p> }
                    @if (extError is not null) { <p role="alert">@extError</p> }
                    <h3>Employee details · from HRIS</h3>
                    <dl class="m-profile-group"><div><dt>Department</dt><dd>@(me.Department ?? "—")</dd></div><div><dt>Site</dt><dd>@(me.Site ?? "—")</dd></div><div><dt>Reports to</dt><dd>@(me.Manager ?? "—")</dd></div></dl>
                    <p class="m-profile-note"><i data-lucide="lock"></i>Wrong department or name? Ask Human Capital — iPop updates it from HRIS.</p>
                    <h3>Security</h3><div class="m-profile-group"><button type="button" @onclick="() => Show(Pane.Password)"><i data-lucide="key-round"></i>Change password<i data-lucide="chevron-right"></i></button></div>
                }
            </ChildContent>
        </BottomSheet>
    }
    else
    {
    @if (Phone.IsPhone) { <OverlayHook OnClose="Close" /> }
    <div class="acct-backdrop" @onclick="Close">
        <div class="acct-sheet" role="dialog" aria-modal="true" aria-label="Account" @onclick:stopPropagation>
            @if (pane == Pane.Password)
            {
                <header class="acct-bar">
                    <button type="button" class="acct-back" @onclick="() => Show(Pane.Profile)"><i data-lucide="chevron-left"></i>Account</button>
                    <span class="acct-bar-title">Change password</span>
                    <button type="button" class="acct-x" title="Close" @onclick="Close"><i data-lucide="x"></i></button>
                </header>
                <form class="acct-body" @onsubmit="SavePassword" @onsubmit:preventDefault>
                    <div class="acct-group">
                        <label class="acct-row acct-field">
                            <span class="acct-k">Current</span>
                            <input type="@(showPw ? "text" : "password")" autocomplete="current-password" placeholder="Required"
                                   @bind="currentPw" @bind:event="oninput" disabled="@busyPw" />
                        </label>
                        <label class="acct-row acct-field">
                            <span class="acct-k">New</span>
                            <input type="@(showPw ? "text" : "password")" autocomplete="new-password" placeholder="Enter password"
                                   @bind="newPw" @bind:event="oninput" disabled="@busyPw" />
                        </label>
                        <label class="acct-row acct-field">
                            <span class="acct-k">Verify</span>
                            <input type="@(showPw ? "text" : "password")" autocomplete="new-password" placeholder="Re-enter password"
                                   @bind="confirmPw" @bind:event="oninput" disabled="@busyPw" />
                        </label>
                    </div>
                    <label class="acct-show"><input type="checkbox" @bind="showPw" /> Show passwords</label>

                    <ul class="acct-req">
                        <li class="@(R1 ? "ok" : "")"><i data-lucide="@Tick(R1)"></i>At least 8 characters</li>
                        <li class="@(R2 ? "ok" : "")"><i data-lucide="@Tick(R2)"></i>One uppercase letter and one number</li>
                        <li class="@(R3 ? "ok" : "")"><i data-lucide="@Tick(R3)"></i>Both new passwords match</li>
                    </ul>

                    @if (pwError is not null) { <p class="acct-err"><i data-lucide="alert-circle"></i>@pwError</p> }
                    <p class="acct-foot-note">You'll be signed out on every device, including this one, and can sign in again with the new password.</p>

                    <div class="acct-actions">
                        <button type="button" class="ghost-btn" @onclick="() => Show(Pane.Profile)" disabled="@busyPw">Cancel</button>
                        <button type="submit" class="btn-primary" disabled="@(!PwReady || busyPw)">@(busyPw ? "Changing…" : "Change password")</button>
                    </div>
                </form>
            }
            else
            {
                <header class="acct-bar">
                    <span></span>
                    <span class="acct-bar-title">Account</span>
                    <button type="button" class="acct-x" title="Close" @onclick="Close"><i data-lucide="x"></i></button>
                </header>
                <div class="acct-body">
                    @if (me is null)
                    {
                        <div class="skel" style="height:180px;border-radius:14px"></div>
                    }
                    else
                    {
                        <section class="acct-hero">
                            <label class="acct-av-wrap @(busyPhoto ? "busy" : "")" title="Change photo">
                                <span class="acct-av" style="@(preview is not null ? $"background:url('{preview}') center/cover" : AvatarPhotos.Style(me.Nik))">
                                    @if (preview is null) { @Initials }
                                </span>
                                <span class="acct-av-edit"><i data-lucide="@(busyPhoto ? "loader-2" : "camera")"></i></span>
                                <input type="file" accept="image/jpeg,image/png,image/webp" @ref="fileInput" @onchange="PickPhoto" disabled="@busyPhoto" hidden />
                            </label>
                            <h2 class="acct-name">@me.Name</h2>
                            <p class="acct-role">@(string.Join(" · ", new[] { me.Department, me.Site }.Where(s => !string.IsNullOrWhiteSpace(s))))</p>
                            <div class="acct-photo-links">
                                <button type="button" class="acct-link" @onclick="OpenPicker" disabled="@busyPhoto">@(HasPhoto ? "Change photo" : "Add photo")</button>
                                @if (HasPhoto)
                                {
                                    <span class="acct-dot">·</span>
                                    <button type="button" class="acct-link danger" @onclick="RemovePhoto" disabled="@busyPhoto">Remove</button>
                                }
                            </div>
                            @if (photoError is not null) { <p class="acct-err center"><i data-lucide="alert-circle"></i>@photoError</p> }
                        </section>

                        <h3 class="acct-h">Contact</h3>
                        <div class="acct-group">
                            @if (editingEmail)
                            {
                                <form class="acct-row acct-field" @onsubmit="SaveEmail" @onsubmit:preventDefault>
                                    <span class="acct-k">Email</span>
                                    <input type="email" autocomplete="email" @ref="emailInput" @bind="email" @bind:event="oninput" disabled="@busyEmail" aria-label="Email" />
                                    <button type="button" class="acct-link" @onclick="CancelEmail" disabled="@busyEmail">Cancel</button>
                                    <button type="submit" class="acct-link strong" disabled="@(busyEmail || !EmailDirty)">@(busyEmail ? "Saving…" : "Save")</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="acct-row acct-nav" @onclick="EditEmail">
                                    <span class="acct-ic mail"><i data-lucide="mail"></i></span>
                                    <span class="acct-k">Email</span>
                                    <span class="acct-v">@(string.IsNullOrWhiteSpace(me.Email) ? "Not set" : me.Email)</span>
                                    <i data-lucide="pencil" class="acct-chev"></i>
                                </button>
                            }
                            @if (editingExt)
                            {
                                <form class="acct-row acct-field" @onsubmit="SaveExt" @onsubmit:preventDefault>
                                    <span class="acct-k">Ext.</span>
                                    <input type="text" inputmode="numeric" maxlength="8" placeholder="e.g. 1133" @ref="extInput" @bind="ext" @bind:event="oninput" disabled="@busyExt" aria-label="Phone extension" />
                                    <button type="button" class="acct-link" @onclick="CancelExt" disabled="@busyExt">Cancel</button>
                                    <button type="submit" class="acct-link strong" disabled="@(busyExt || !ExtDirty)">@(busyExt ? "Saving…" : "Save")</button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="acct-row acct-nav" @onclick="EditExt">
                                    <span class="acct-ic phone"><i data-lucide="phone"></i></span>
                                    <span class="acct-k">Ext.</span>
                                    <span class="acct-v">@(string.IsNullOrWhiteSpace(me.Extension) ? "Not set" : me.Extension)</span>
                                    <i data-lucide="pencil" class="acct-chev"></i>
                                </button>
                            }
                        </div>
                        @if (emailError is not null) { <p class="acct-err"><i data-lucide="alert-circle"></i>@emailError</p> }
                        @if (extError is not null) { <p class="acct-err"><i data-lucide="alert-circle"></i>@extError</p> }
                        <p class="acct-note">Email is used for notifications and password reset links. Ext. is your IP-phone number, shown in the Directory.</p>

                        <h3 class="acct-h">Security</h3>
                        <div class="acct-group">
                            <button type="button" class="acct-row acct-nav" @onclick="() => Show(Pane.Password)">
                                <span class="acct-ic key"><i data-lucide="key-round"></i></span>
                                <span class="acct-k">Change password</span>
                                <span class="acct-v"></span>
                                <i data-lucide="chevron-right" class="acct-chev"></i>
                            </button>
                        </div>

                        <h3 class="acct-h">Preferences</h3>
                        <div class="acct-group">
                            <div class="acct-row">
                                <span class="acct-ic spell"><i data-lucide="spell-check"></i></span>
                                <span class="acct-k">Spell check</span>
                                <span class="acct-v"></span>
                                <button type="button" class="apple-switch @(spellcheck ? "on" : "")" role="switch" aria-checked="@(spellcheck ? "true" : "false")"
                                        aria-label="Spell check" @onclick="ToggleSpellcheck"><span class="apple-switch-knob"></span></button>
                            </div>
                        </div>
                        <p class="acct-note">Underlines misspelled words while you type. Saved on this device only.</p>

                        <h3 class="acct-h">App</h3>
                        <div class="acct-group">
                            <div class="acct-row">
                                <span class="acct-ic install"><i data-lucide="monitor-down"></i></span>
                                <span class="acct-k">Install iPop</span>
                                @if (installState == "installed")
                                {
                                    <span class="acct-v acct-installed"><i data-lucide="check"></i> Installed</span>
                                }
                                else
                                {
                                    <span class="acct-v"></span>
                                    <button type="button" class="acct-install-btn" disabled="@(installState != "available")" @onclick="InstallAsync">Install</button>
                                }
                            </div>
                        </div>
                        <p class="acct-note">@(installState switch
                        {
                            "installed" => "iPop runs in its own window and can open when Windows starts.",
                            "available" => "Opens iPop in its own window with a taskbar icon, like a desktop app.",
                            "insecure" => "Installing needs the secure address (https). Open iPop via https to install it.",
                            _ => "Use the install icon in the address bar, or the browser menu › Apps › Install iPop.",
                        })</p>

                        <h3 class="acct-h">Employee details</h3>
                        <div class="acct-group">
                            <div class="acct-row"><span class="acct-k">Department</span><span class="acct-v">@(me.Department ?? "—")</span></div>
                        </div>
                        <p class="acct-note">Your name and placement come from HR. Ask your administrator if something is wrong.</p>
                    }
                </div>
            }
        </div>
    </div>
    }
}

@code {
    public enum Pane { Profile, Password }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    /// Which pane to show when the sheet opens.
    [Parameter] public Pane Start { get; set; }

    private Pane pane;
    private IDisposable? reg;
    private bool wasOpen;
    private DirectoryEmployeeDto? me;
    private ElementReference fileInput, emailInput, extInput;
    private string ext = "";
    private string? extError;
    private bool busyExt, editingExt, focusExt;
    private bool ExtDirty => !string.Equals(ext.Trim(), me?.Extension ?? "", StringComparison.Ordinal);
    private string email = "";
    private string? preview, photoError, emailError, pwError;
    private bool busyPhoto, busyEmail, busyPw, editingEmail, focusEmail, showPw;
    private string currentPw = "", newPw = "", confirmPw = "";

    private bool HasPhoto => AvatarPhotos.Url(me?.Nik) is not null;
    private bool EmailDirty => !string.Equals(email.Trim(), me?.Email, StringComparison.Ordinal);
    private string Initials => me is null ? "" : string.Concat(me.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => w[0]).Take(2)).ToUpperInvariant();

    // Same policy the server enforces (AuthWorkflow.ValidatePolicy).
    private bool R1 => newPw.Length >= 8;
    private bool R2 => newPw.Any(char.IsUpper) && newPw.Any(char.IsDigit);
    private bool R3 => newPw.Length > 0 && newPw == confirmPw;
    private bool PwReady => currentPw.Length > 0 && R1 && R2 && R3;
    private static string Tick(bool ok) => ok ? "check-circle-2" : "circle";

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !wasOpen)
        {
            wasOpen = true;
            if (!Phone.IsPhone) reg = Overlays.Push(Close);
            pane = Start;
            ResetForms();
            me = await Auth.LoadMeAsync();
            email = me?.Email ?? "";
            try { spellcheck = await JS.InvokeAsync<bool>("ipop.spellcheck"); } catch { }
            try { installState = await JS.InvokeAsync<string>("ipop.installState"); } catch { }
        }
        else if (!IsOpen) { wasOpen = false; reg?.Dispose(); reg = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen) return;
        await JS.InvokeVoidAsync("ipop.icons");
        if (focusEmail) { focusEmail = false; try { await emailInput.FocusAsync(); } catch { } }
        if (focusExt) { focusExt = false; try { await extInput.FocusAsync(); } catch { } }
    }

    private async Task Close()
    {
        if (busyPw || busyPhoto) return;
        await IsOpenChanged.InvokeAsync(false);
    }

    private bool spellcheck;
    private string installState = "unsupported";

    private async Task InstallAsync()
    {
        try { installState = await JS.InvokeAsync<string>("ipop.install"); } catch { }
    }

    private async Task ToggleSpellcheck()
    {
        spellcheck = !spellcheck;
        try { await JS.InvokeAsync<bool>("ipop.spellcheck", spellcheck); } catch { }
    }

    private void Show(Pane p) { pane = p; pwError = null; currentPw = newPw = confirmPw = ""; }

    private void ResetForms()
    {
        editingEmail = false; showPw = false; editingExt = false; extError = null;
        preview = photoError = emailError = pwError = null;
        currentPw = newPw = confirmPw = "";
    }

    private async Task OpenPicker() => await JS.InvokeVoidAsync("ipopProfilePhoto.open", fileInput);

    private async Task PickPhoto()
    {
        photoError = null;
        var crop = await JS.InvokeAsync<CropResult?>("ipopProfilePhoto.crop", fileInput, 256, 1024);
        if (crop is null) return;
        if (crop.Error is not null) { photoError = crop.Error; return; }

        busyPhoto = true; preview = crop.Preview;
        StateHasChanged();
        try
        {
            var ext = crop.Type == "image/webp" ? "webp" : "jpg";
            var file = new ByteArrayContent(Convert.FromBase64String(crop.Base64!));
            file.Headers.ContentType = new(crop.Type!);
            var form = new MultipartFormDataContent { { file, "file", $"avatar.{ext}" } };
            if (crop.LargeBase64 is not null && crop.LargeType is not null)
            {
                var large = new ByteArrayContent(Convert.FromBase64String(crop.LargeBase64));
                large.Headers.ContentType = new(crop.LargeType);
                form.Add(large, "large", $"avatar-large.{(crop.LargeType == "image/webp" ? "webp" : "jpg")}");
            }
            var res = await Auth.SendMultipartAsync("/api/me/photo", form);
            if (!res.IsSuccessStatusCode) { photoError = await ErrorMessage(res, "Could not upload the photo."); return; }
            await Auth.LoadPhotosAsync();
            Toasts.Show("Profile photo updated", ToastKind.Success);
        }
        catch { photoError = "Could not reach the server. Try again."; }
        finally { busyPhoto = false; preview = null; }
    }

    private async Task RemovePhoto()
    {
        busyPhoto = true; photoError = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Delete, "/api/me/photo");
            if (!res.IsSuccessStatusCode) { photoError = "Could not remove the photo."; return; }
            await Auth.LoadPhotosAsync();
            Toasts.Show("Profile photo removed", ToastKind.Success);
        }
        catch { photoError = "Could not reach the server. Try again."; }
        finally { busyPhoto = false; }
    }

    private void EditEmail() { email = me?.Email ?? ""; emailError = null; editingEmail = true; focusEmail = true; }
    private void CancelEmail() { editingEmail = false; emailError = null; email = me?.Email ?? ""; }

    private async Task SaveEmail()
    {
        if (busyEmail || !EmailDirty) return;
        busyEmail = true; emailError = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, "/api/me/email", new { email = email.Trim() });
            if (!res.IsSuccessStatusCode) { emailError = await ErrorMessage(res, "Could not save the email."); return; }
            await Auth.ReloadMeAsync();
            me = Auth.Me;
            email = me?.Email ?? email.Trim();
            editingEmail = false;
            Toasts.Show("Email updated", ToastKind.Success);
        }
        catch { emailError = "Could not reach the server. Try again."; }
        finally { busyEmail = false; }
    }

    private void EditExt() { ext = me?.Extension ?? ""; extError = null; editingExt = true; focusExt = true; }
    private void CancelExt() { editingExt = false; extError = null; ext = me?.Extension ?? ""; }

    private async Task SaveExt()
    {
        if (busyExt || !ExtDirty) return;
        busyExt = true; extError = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, "/api/me/extension", new { extension = ext.Trim() });
            if (!res.IsSuccessStatusCode) { extError = await ErrorMessage(res, "Could not save the extension."); return; }
            await Auth.ReloadMeAsync();
            me = Auth.Me;
            ext = me?.Extension ?? "";
            editingExt = false;
            Toasts.Show("Extension updated", ToastKind.Success);
        }
        catch { extError = "Could not reach the server. Try again."; }
        finally { busyExt = false; }
    }

    private async Task SavePassword()
    {
        if (!PwReady || busyPw) return;
        busyPw = true; pwError = null;
        try
        {
            var (ok, fields, message) = await Auth.ChangePasswordAsync(newPw, confirmPw, currentPw);
            if (!ok)
            {
                pwError = fields?.Values.SelectMany(v => v).FirstOrDefault() ?? message;
                return;
            }
            busyPw = false;
            await IsOpenChanged.InvokeAsync(false);
            // Signed out by the password change: reload so nothing of this session survives.
            Nav.NavigateTo("/login?changed=1", forceLoad: true, replace: true);
        }
        catch { pwError = "Could not reach the server. Try again."; }
        finally { busyPw = false; }
    }

    private static async Task<string> ErrorMessage(HttpResponseMessage res, string fallback)
    {
        try { return (await res.Content.ReadFromJsonAsync<ApiError>())?.Message ?? fallback; }
        catch { return fallback; }
    }

    public void Dispose() => reg?.Dispose();

    private record CropResult(string? Base64, string? Type, string? Preview, string? Error, string? LargeBase64 = null, string? LargeType = null);
    private record ApiError(string? Code, string? Message);
}
