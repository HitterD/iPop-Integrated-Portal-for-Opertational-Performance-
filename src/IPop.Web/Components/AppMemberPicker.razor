@* Inline combobox: type a name or NIK, suggestions load live from
   /api/directory/member-search and drop down below the input (no modal).
   Picking emits ValueChanged(MemberSearchRow). Dropdown is position:fixed
   to escape drawer overflow:auto. *@
@inject AuthState Auth
@inject IJSRuntime JS

<div class="member-picker" @ref="wrap">
    @if (Value is not null)
    {
        <div class="member-picker-selected" style="display:flex;align-items:center;gap:10px;padding:6px 12px;background:var(--tray);border:1px solid var(--line-soft);border-radius:10px;min-height:38px">
            <span class="avatar" style="background:@(Value.AvatarColor);width:28px;height:28px;font-size:11px;font-weight:700">@(Value.Initials)</span>
            <span style="font-size:13px;font-weight:600;flex:1;color:var(--ink)">
                @Value.Name
                <span style="font-size:11.5px;font-weight:400;color:var(--ink-3);margin-left:4px">(@Value.Nik)</span>
            </span>
            <button type="button" class="comp-btn" style="padding:4px;background:transparent;border:none;cursor:pointer;color:var(--ink-3);display:flex;align-items:center" @onclick="Clear" title="Clear selection">
                <i data-lucide="x" style="width:14px;height:14px"></i>
            </button>
        </div>
    }
    else
    {
        <div class="member-picker-input">
            <i data-lucide="search"></i>
            <input placeholder="@(Placeholder ?? "Type a name or NIK...")" value="@query"
                   @oninput="OnInput" @onkeydown="OnKeyDown"
                   @ref="inputRef" aria-label="Search people" aria-expanded="@(results.Count > 0 ? "true" : "false")" />
            @if (loading)
            {
                <span class="member-picker-spin"><i data-lucide="loader-2" class="spin"></i></span>
            }
        </div>
    }

    @if (results.Count > 0 && Value is null)
    {
        <div class="member-picker-pop" @ref="popRef" style="position:fixed;z-index:100" role="listbox" aria-label="People">
            @for (var i = 0; i < results.Count; i++)
            {
                var idx = i;
                var r = results[i];
                <button type="button" class="member-picker-opt @(activeIdx == idx ? "active" : "")" role="option" aria-selected="@(activeIdx == idx ? "true" : "false")"
                        @onmousemove="() => activeIdx = idx" @onmousedown="() => Pick(r)">
                    <span class="avatar" style="background:@(r.AvatarColor)">@(r.Initials)</span>
                    <span class="txt"><span class="n">@r.Name</span><span class="s">@r.PositionLabel</span></span>
                    <span class="mono" style="font-size:10.5px;color:var(--ink-3)">@r.Nik</span>
                </button>
            }
        </div>
    }
    else if (searched && query.Trim().Length >= 2 && !loading && Error is null && Value is null)
    {
        <div class="member-picker-empty" style="position:relative;z-index:100">No one matches. Try a name or ID.</div>
    }
</div>

@code {
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public MemberSearchRow? Value { get; set; }
    [Parameter] public EventCallback<MemberSearchRow?> ValueChanged { get; set; }

    private string query = "";
    private List<MemberSearchRow> results = [];
    private bool loading, searched;
    private string? Error;
    private int activeIdx;
    private ElementReference inputRef;
    private ElementReference wrap;
    private ElementReference popRef;
    private System.Threading.CancellationTokenSource? cts;
    // The trimmed query the current `results` were fetched for; Enter only picks when it matches.
    private string resultsFor = "";
    private bool refocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (refocus)
        {
            refocus = false;
            // After a pick the parent may swap the input for the selected chip (Value set); only refocus a live input.
            if (Value is null)
            {
                try { await inputRef.FocusAsync(); } catch { /* input not rendered */ }
            }
        }
        await JS.InvokeVoidAsync("ipop.icons");
        if (results.Count > 0)
        {
            await JS.InvokeVoidAsync("ipop.positionPopup", inputRef, popRef);
        }
        else
        {
            await JS.InvokeVoidAsync("ipop.closePopup");
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        cts?.Cancel();
        cts?.Dispose();
        var token = new CancellationTokenSource();
        cts = token;
        var q = query.Trim();
        // A new query invalidates the previous suggestions: never show (or Enter-pick) stale rows.
        if (q != resultsFor)
        {
            results = [];
            resultsFor = "";
            activeIdx = 0;
        }
        if (q.Length < 2)
        {
            results = [];
            resultsFor = "";
            loading = false;
            searched = false;
            StateHasChanged();
            return;
        }
        loading = true; Error = null; searched = true;
        StateHasChanged();
        try { await Task.Delay(180, token.Token); } catch (TaskCanceledException) { return; }
        if (token.IsCancellationRequested) return;
        var res = await Auth.GetAsync<MemberSearchRow[]>($"/api/directory/member-search?q={Uri.EscapeDataString(q)}");
        if (token.IsCancellationRequested) return;
        results = res?.ToList() ?? [];
        resultsFor = q;
        activeIdx = 0;
        loading = false;
        StateHasChanged();
    }

    private async Task Pick(MemberSearchRow r)
    {
        ResetSearch();
        await ValueChanged.InvokeAsync(r);
        refocus = true;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    /// Empties the box and drops any in-flight search so late results can't reappear.
    private void ResetSearch()
    {
        cts?.Cancel();
        query = "";
        results = [];
        resultsFor = "";
        loading = false;
        searched = false;
        activeIdx = 0;
    }

    private async Task Clear()
    {
        ResetSearch();
        refocus = true;
        await ValueChanged.InvokeAsync(null);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private bool CanPickOnEnter => !loading && results.Count > 0 && resultsFor.Length > 0 && resultsFor == query.Trim();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (results.Count > 0) { activeIdx = (activeIdx + 1) % results.Count; StateHasChanged(); }
                break;
            case "ArrowUp":
                if (results.Count > 0) { activeIdx = (activeIdx - 1 + results.Count) % results.Count; StateHasChanged(); }
                break;
            case "Enter":
                // Only pick what is on screen for the text as typed now — not while a search
                // is pending or when the list still belongs to an earlier query.
                if (CanPickOnEnter)
                {
                    var r = results[Math.Clamp(activeIdx, 0, results.Count - 1)];
                    await Pick(r);
                }
                break;
            case "Escape":
                ResetSearch(); refocus = true; StateHasChanged();
                break;
        }
    }
}