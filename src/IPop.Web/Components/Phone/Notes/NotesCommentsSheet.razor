<BottomSheet Open="Open" OpenChanged="OpenChanged" Title="Comments" Size="SheetSize.Tall" ScaleBack="true" Class="m-notes-comments">
    <Trailing><button type="button" class="ph-text-btn" @onclick="() => OpenChanged.InvokeAsync(false)">Done</button></Trailing>
    <ChildContent>@ChildContent</ChildContent>
</BottomSheet>
@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
