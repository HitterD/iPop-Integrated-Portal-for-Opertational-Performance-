@* Who is signed in, grouped per person with readable device names.
   Headless-browser sessions (screenshots, test runs) are labelled Automated, folded into one
   row, and can be signed out together. *@
@using System.Net.Http.Json
@using IPop.Web.Services
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS

<p class="adm-summary">
    @if (isLoading)
    {
        <span class="skel-inline"></span>
    }
    else
    {
        <span>@AdminHumanize.Plural(People.Count, "person", "people") signed in</span>
        <span>@AdminHumanize.Plural(Human.Count, "device")</span>
        @if (Automated.Count > 0)
        {
            <span>@(Capped ? $"{Automated.Count}+ automated sessions" : AdminHumanize.Plural(Automated.Count, "automated session"))</span>
        }
        <span class="adm-summary-live"><i class="adm-dot on"></i>Updates every 30 s</span>
    }
</p>

<div class="adm-card">
    <div class="adm-card-head adm-toolbar">
        <div class="adm-search">
            <i data-lucide="search"></i>
            <input placeholder="Find a person, NIK or IP" @bind="query" @bind:event="oninput" aria-label="Find a session" />
        </div>
        <div class="adm-toolbar-actions stack">
            @if (Automated.Count(s => !s.IsCurrent) > 0)
            {
                <button type="button" class="adm-btn ghost" disabled="@busy" @onclick="RevokeAutomated">
                    <i data-lucide="bot"></i><span>Sign out @AutomatedLabel</span>
                </button>
            }
            <button type="button" class="adm-btn ghost danger" disabled="@busy" @onclick="RevokeAllOthers" title="Everyone except you on this device">
                <i data-lucide="log-out"></i><span>Sign out everyone else</span>
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else if (loadError)
    {
        <div class="adm-empty">Could not load sessions. <button type="button" class="adm-link" @onclick="Reload">Retry</button></div>
    }
    else if (People.Count == 0 && Automated.Count == 0)
    {
        <div class="adm-empty">No one is signed in right now.</div>
    }
    else
    {
        <div class="adm-sess">
            @foreach (var p in People)
            {
                var first = p.Sessions[0];
                var isOpen = open.Contains(p.Nik);
                <div class="adm-sess-person @(isOpen ? "open" : "")" @key="p.Nik">
                    <button type="button" class="adm-sess-head" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => Toggle(p.Nik)">
                        <span class="adm-av" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@AdminOrgModel.Initials(p.Name)</span>
                        <span class="adm-user-txt">
                            <b>@p.Name @if (p.Sessions.Any(s => s.IsCurrent)) { <em class="adm-tag ok">You</em> }</b>
                            <small>@DeviceSummary(p.Sessions)</small>
                        </span>
                        <span class="adm-sess-when">@AdminHumanize.Ago(first.CreatedAt)</span>
                        <i data-lucide="@(isOpen ? "chevron-up" : "chevron-down")" class="adm-sess-chev"></i>
                    </button>
                    @if (isOpen)
                    {
                        <div class="adm-sess-devices">
                            @foreach (var s in p.Sessions)
                            {
                                <div class="adm-list-row" @key="s.Id">
                                    @DeviceCell(s)
                                    @if (s.IsCurrent)
                                    {
                                        <em class="adm-tag ok">This device</em>
                                    }
                                    else
                                    {
                                        <button type="button" class="adm-link danger" disabled="@busy" @onclick="() => RevokeSession(s)">Sign out</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (Automated.Count > 0)
            {
                var autoOpen = open.Contains("auto");
                <div class="adm-sess-person auto @(autoOpen ? "open" : "")">
                    <button type="button" class="adm-sess-head" aria-expanded="@(autoOpen ? "true" : "false")" @onclick='() => Toggle("auto")'>
                        <span class="adm-av vacant"><i data-lucide="bot"></i></span>
                        <span class="adm-user-txt">
                            <b>Automated sessions</b>
                            <small>Headless browsers from screenshots and test runs · @string.Join(", ", Automated.Select(s => s.Name).Distinct().Take(3))</small>
                        </span>
                        <span class="adm-sess-when">@Automated.Count</span>
                        <i data-lucide="@(autoOpen ? "chevron-up" : "chevron-down")" class="adm-sess-chev"></i>
                    </button>
                    @if (autoOpen)
                    {
                        <div class="adm-sess-devices">
                            @foreach (var s in Automated.Take(showAllAuto ? 500 : 6))
                            {
                                <div class="adm-list-row" @key="s.Id">
                                    @DeviceCell(s, withName: true)
                                    @if (s.IsCurrent)
                                    {
                                        <em class="adm-tag ok">This device</em>
                                    }
                                    else
                                    {
                                        <button type="button" class="adm-link danger" disabled="@busy" @onclick="() => RevokeSession(s)">Sign out</button>
                                    }
                                </div>
                            }
                            @if (!showAllAuto && Automated.Count > 6)
                            {
                                <button type="button" class="adm-list-row link" @onclick="() => showAllAuto = true"><span>Show @(Automated.Count - 6) more</span></button>
                            }
                        </div>
                    }
                </div>
            }
            @if (People.Count == 0 && !string.IsNullOrWhiteSpace(query))
            {
                <div class="adm-empty">No one matches “@query.Trim()”.</div>
            }
        </div>
        @if (Capped)
        {
            <p class="adm-list-hint adm-sess-cap">Showing the 200 newest sessions. Open a person in Users to see all of theirs.</p>
        }
    }
</div>

@code {
    private List<AdminSessionRowDto> sessionList = [];
    private System.Threading.Timer? _pollTimer;
    private bool isLoading = true, loadError, busy, showAllAuto;
    private string query = "";
    private readonly HashSet<string> open = [];

    private sealed record Person(string Nik, string Name, List<AdminSessionRowDto> Sessions);

    private bool IsAutomated(AdminSessionRowDto s) => AdminHumanize.ParseDevice(s.DeviceFingerprint).Automated;

    private IEnumerable<AdminSessionRowDto> Matching => string.IsNullOrWhiteSpace(query)
        ? sessionList
        : sessionList.Where(s => s.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase)
            || s.Nik.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase)
            || (s.IpAddress?.Contains(query.Trim()) ?? false));

    // The list stops at the 200 newest, but the cleanup ends every automated session server-side.
    private bool Capped => sessionList.Count >= 200;
    private string AutomatedLabel => Capped ? "all automated sessions"
        : AdminHumanize.Plural(Automated.Count(s => !s.IsCurrent), "automated session");

    private List<AdminSessionRowDto> Human => Matching.Where(s => !IsAutomated(s)).ToList();
    private List<AdminSessionRowDto> Automated => Matching.Where(IsAutomated).ToList();

    // Newest sign-in first; you stay on top so "This device" is easy to find.
    private List<Person> People => Human
        .GroupBy(s => s.Nik)
        .Select(g => new Person(g.Key, g.First().Name, g.OrderByDescending(s => s.CreatedAt).ToList()))
        .OrderByDescending(p => p.Sessions.Any(s => s.IsCurrent))
        .ThenByDescending(p => p.Sessions[0].CreatedAt)
        .ToList();

    private static string DeviceSummary(List<AdminSessionRowDto> sessions)
    {
        var labels = sessions.Select(s => AdminHumanize.ParseDevice(s.DeviceFingerprint).Label).Distinct().ToList();
        var head = labels.Count <= 2 ? string.Join(", ", labels) : $"{labels[0]}, {labels[1]} and {labels.Count - 2} more";
        return sessions.Count == 1 ? head : $"{AdminHumanize.Plural(sessions.Count, "session")} · {head}";
    }

    private RenderFragment DeviceCell(AdminSessionRowDto s, bool withName = false)
    {
        var dev = AdminHumanize.ParseDevice(s.DeviceFingerprint);
        return @<span class="adm-dev" title="@s.DeviceFingerprint"><i data-lucide="@dev.Icon"></i>
            <span><b>@(withName ? s.Name : dev.Label)</b>
            <small>@(withName ? dev.Label + " · " : "")@(s.IpAddress ?? "Unknown IP") · signed in @AdminHumanize.Ago(s.CreatedAt).ToLowerInvariant() · expires @Expires(s.ExpiresAt)</small></span>
        </span>;
    }

    private static string Expires(DateTime utc)
    {
        var d = utc - DateTime.UtcNow;
        return d.TotalHours < 1 ? $"in {Math.Max(1, (int)d.TotalMinutes)} min"
            : d.TotalDays < 1 ? $"in {(int)d.TotalHours} h"
            : $"in {(int)Math.Ceiling(d.TotalDays)} days";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
        isLoading = false;
        var me = sessionList.FirstOrDefault(s => s.IsCurrent);
        if (me is not null && !IsAutomated(me)) open.Add(me.Nik);
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadSessions();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public async Task Reload()
    {
        await LoadSessions();
        StateHasChanged();
    }

    private void Toggle(string key)
    {
        if (!open.Remove(key)) open.Add(key);
    }

    private async Task<string?> RefreshToken() => await JS.InvokeAsync<string?>("localStorage.getItem", "ipop.refresh");

    private async Task LoadSessions()
    {
        var refresh = await RefreshToken();
        var url = "/api/admin/users/sessions";
        if (!string.IsNullOrWhiteSpace(refresh))
            url += $"?refreshToken={Uri.EscapeDataString(refresh)}";
        var rows = await Auth.GetAsync<List<AdminSessionRowDto>>(url);
        loadError = rows is null;
        if (rows is not null) sessionList = rows;
    }

    private async Task RevokeSession(AdminSessionRowDto s)
    {
        var dev = AdminHumanize.ParseDevice(s.DeviceFingerprint);
        if (!await Confirm.AskAsync($"Sign out {dev.Label}?", $"{s.Name} will need to sign in again on that device.", "Sign out", false))
            return;
        busy = true;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/admin/users/sessions/{s.Id}/revoke");
        busy = false;
        if (!res.IsSuccessStatusCode)
        {
            Toasts.Show("Could not end that session.", ToastKind.Error);
            return;
        }
        Toasts.Show("Session ended", ToastKind.Success);
        await LoadSessions();
    }

    private async Task RevokeAutomated()
    {
        if (!await Confirm.AskAsync($"Sign out {AutomatedLabel}?",
                "Only headless-browser sessions end. People on real devices stay signed in.", "Sign out", false))
            return;
        await Bulk("/api/admin/users/sessions/revoke-automated", "automated session");
    }

    private async Task RevokeAllOthers()
    {
        if (!await Confirm.AskAsync("Sign out everyone else?",
                "Every session except yours on this device ends now. Everyone will need to sign in again.", "Sign out everyone"))
            return;
        await Bulk("/api/admin/users/sessions/revoke-others", "session");
    }

    private async Task Bulk(string url, string noun)
    {
        busy = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, url, new { currentRefreshToken = await RefreshToken() });
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show("Could not sign those sessions out.", ToastKind.Error);
                return;
            }
            var result = await res.Content.ReadFromJsonAsync<CountDto>();
            Toasts.Show($"Signed out {AdminHumanize.Plural(result?.Count ?? 0, noun)}", ToastKind.Success);
            showAllAuto = false;
            await LoadSessions();
        }
        finally
        {
            busy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");

    public void Dispose() => _pollTimer?.Dispose();

    private sealed record CountDto(int Count);
}
