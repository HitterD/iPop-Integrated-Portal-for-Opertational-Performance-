@* iPop Notifier versions: what is released, what the pilot group tries, how many PCs run each version, and whether the
   cluster is fetching new builds from GitHub. A git tag "notifier-v1.2.3" builds a release; the cluster brings it in
   as the pilot; "Release to everyone" here is the only step a person takes. *@
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS

<p class="adm-summary">
    @if (loadFailed) { <span role="status">Couldn't load Notifier versions. Reopen this section to try again.</span> }
    else if (data is null) { <span class="skel-inline"></span> }
    else
    {
        <span>@(data.All is { } a ? $"Everyone: {a.Version}" : "Nothing released yet")</span>
        <span>@(data.Pilot is { } p ? $"Pilot (ICT/Admin): {p.Version}" : "No pilot release")</span>
        <span>@AdminHumanize.Plural(data.Versions.Sum(v => v.Pcs), "PC") seen in the last 14 days</span>
    }
</p>

<div class="adm-card">
    <div class="adm-card-head">
        <span class="adm-card-title">Releases</span>
        @if (data?.Pilot is { } pilot)
        {
            <button type="button" class="adm-btn primary" disabled="@promoting" @onclick="PromoteAsync">
                <i data-lucide="send"></i><span>@(promoting ? "Releasing…" : $"Release {pilot.Version} to everyone")</span>
            </button>
        }
    </div>
    @if (data is not null)
    {
        <div class="adm-hol-list">
            <div class="adm-hol-row">
                <span class="adm-nf-ic all"><i data-lucide="users"></i></span>
                <span class="adm-hol-t"><b>Everyone · @(data.All?.Version ?? "—")</b><small>@ReleaseLine(data.All, "Installer and updates for every PC")</small></span>
            </div>
            <div class="adm-hol-row">
                <span class="adm-nf-ic pilot"><i data-lucide="flask-conical"></i></span>
                <span class="adm-hol-t"><b>Pilot · @(data.Pilot?.Version ?? "none")</b><small>@(data.Pilot is null ? "ICT and Admin get new versions here first" : ReleaseLine(data.Pilot, "ICT and Admin only, until it is released to everyone"))</small></span>
            </div>
            @if (data.Sync is { } s)
            {
                <div class="adm-hol-row @(s.Failures > 0 ? "warn" : "")">
                    <span class="adm-nf-ic sync"><i data-lucide="@(s.Failures > 0 ? "triangle-alert" : "refresh-cw")"></i></span>
                    <span class="adm-hol-t"><b>@SyncTitle(s)</b><small>@SyncLine(s)</small></span>
                </div>
            }
        </div>
    }
</div>

@if (data?.GpoMsi is { } msi)
{
    <div class="adm-card">
        <div class="adm-card-head">
            <span class="adm-card-title">Group Policy installer</span>
            <a class="adm-btn ghost" href="/download/notifier/@msi" download><i data-lucide="download"></i><span>Download .msi</span></a>
        </div>
        <small class="adm-hol-hint">For Computer Configuration › Software installation (Assigned). Each person gets the Notifier at their next sign-in to Windows, then it updates itself. Removing the policy removes it from the PC. The same .msi keeps working for every later version.</small>
    </div>
}

<div class="adm-card">
    <div class="adm-card-head"><span class="adm-card-title">PCs per version</span></div>
    @if (data is { Versions.Count: 0 })
    {
        <div class="adm-empty">No PC has reported in the last 14 days.</div>
    }
    else if (data is not null)
    {
        <div class="adm-hol-list">
            @foreach (var v in data.Versions)
            {
                var current = v.Version == data.All?.Version || v.Version == data.Pilot?.Version;
                <div class="adm-hol-row @(current ? "" : "past")" @key="v.Version">
                    <span class="adm-hol-date"><small>ver</small><b>@(string.IsNullOrEmpty(v.Version) ? "?" : v.Version)</b></span>
                    <span class="adm-hol-t"><b>@AdminHumanize.Plural(v.Pcs, "PC")</b><small>@v.Online online now@(current ? "" : " · updates on its next check")</small></span>
                </div>
            }
        </div>
    }
</div>
<small class="adm-hol-hint">New versions come from GitHub (tag notifier-v1.2.3): ICT and Admin get them first, everyone after "Release to everyone". Each PC asks before it restarts (Later = again in 4 hours, by itself after a day when idle).</small>

@code {
    public sealed record ReleaseDto(string Version, bool Mandatory, DateTime? PublishedAt);
    public sealed record VersionDto(string Version, int Pcs, int Online);
    public sealed record SyncDto(DateTime? LastRunAt, DateTime? LastSuccessAt, string? LastError, int Failures, string? Remote);
    public sealed record ReleasesDto(ReleaseDto? All, ReleaseDto? Pilot, List<VersionDto> Versions, SyncDto? Sync = null, string? GpoMsi = null);

    private ReleasesDto? data;
    private bool loadFailed, promoting;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        data = await Auth.GetAsync<ReleasesDto>("/api/notifier/releases");
        loadFailed = data is null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");

    private async Task PromoteAsync()
    {
        if (data?.Pilot is not { } pilot) return;
        if (!await Confirm.AskAsync($"Release {pilot.Version} to everyone?",
                "Every PC downloads it in the background and asks its user to restart the Notifier" + (pilot.Mandatory ? " (mandatory: it installs right away)." : "."),
                "Release", danger: false)) return;
        promoting = true;
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifier/releases/promote");
            if (res.IsSuccessStatusCode) Toasts.Show($"Notifier {pilot.Version} released to everyone.", ToastKind.Success);
            else Toasts.Show(await Message(res) ?? "Could not release. Try again.", ToastKind.Error);
            await LoadAsync();
        }
        catch (HttpRequestException) { Toasts.Show("Could not release. Try again.", ToastKind.Error); }
        finally { promoting = false; }
    }

    private static async Task<string?> Message(HttpResponseMessage res)
    {
        try { return System.Text.Json.JsonDocument.Parse(await res.Content.ReadAsStringAsync()).RootElement.GetProperty("message").GetString(); }
        catch { return null; }
    }

    private static string ReleaseLine(ReleaseDto? r, string what) =>
        r is null ? what : what + (r.PublishedAt is { } at ? $" · published {AdminHumanize.Ago(at)}" : "") + (r.Mandatory ? " · mandatory" : "");

    private static string SyncTitle(SyncDto s) =>
        s.LastError is { } e && e.StartsWith("GitHub token not set", StringComparison.Ordinal) ? "GitHub sync not set up"
        : s.Failures > 0 ? $"GitHub sync failing ({AdminHumanize.Plural(s.Failures, "try", "tries")})" : "GitHub sync OK";

    private static string SyncLine(SyncDto s) =>
        s.Failures > 0 || s.LastError is not null
            ? (s.LastError ?? "Unknown error") + (s.LastSuccessAt is { } ok ? $" · last success {AdminHumanize.Ago(ok)}" : "")
            : (s.Remote is { } v ? $"Newest on GitHub: {v}" : "No Notifier release on GitHub yet") + (s.LastRunAt is { } at ? $" · checked {AdminHumanize.Ago(at)}" : "");
}
