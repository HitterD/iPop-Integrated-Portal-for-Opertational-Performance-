@* Org chart — generated from unit heads: Board ▸ Division heads ▸ Department heads.
   Nothing to draw by hand; set heads in the Organization tab. (The old OrgNode editor is
   retired from the UI; its rows are left untouched.) *@
@inject AuthState Auth
@inject IJSRuntime JS
@inject ToastService Toasts

<div class="adm-card">
    <div class="adm-card-head">
        <span class="adm-card-title">Organization chart</span>
        <span class="adm-cell-sub adm-chart-hint">Built automatically from the heads set in Organization</span>
        <div class="adm-zoom" role="group" aria-label="Zoom">
            <button type="button" aria-label="Zoom out" disabled="@(zoom <= 0.6)" @onclick="() => Zoom(-0.1)"><i data-lucide="minus"></i></button>
            <button type="button" class="pct" title="Reset zoom" @onclick="() => zoom = 1">@((int)Math.Round(zoom * 100))%</button>
            <button type="button" aria-label="Zoom in" disabled="@(zoom >= 1.3)" @onclick="() => Zoom(0.1)"><i data-lucide="plus"></i></button>
        </div>
        <button type="button" class="adm-btn ghost" @onclick="Export"><i data-lucide="download"></i> Export</button>
    </div>

    @if (loadError)
    {
        <div class="adm-empty">Could not load the organization. <button type="button" class="adm-link" @onclick="Reload">Retry</button></div>
    }
    else if (org is null)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else
    {
        <div class="adm-chart-canvas">
            <div class="adm-chart" style="transform:scale(@zoom.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                <div class="adm-chart-board">
                    <b>Board of Directors</b>
                    <span>PT Santos Jaya Abadi</span>
                </div>
                @if (Branches.Count > 0)
                {
                    <div class="adm-chart-stem"></div>
                    <div class="adm-chart-row">
                        @foreach (var b in Branches)
                        {
                            <div class="adm-chart-branch" @key="b.Key">
                                @if (b.Key == "d:")
                                {
                                    @* Orphan departments: a grouping, not a unit that can have a head. *@
                                    <div class="adm-pcard lead adm-pcard-group">
                                        <span class="adm-av vacant"><i data-lucide="layers"></i></span>
                                        <span class="adm-pcard-txt"><b>No division</b><small>Set a division in Organization</small></span>
                                    </div>
                                }
                                else
                                {
                                    @PersonCard(b.HeadNik, b.HeadName, b.HeadTitle, b.Unit, true)
                                }
                                @if (b.Children.Count > 0)
                                {
                                    <div class="adm-chart-kids">
                                        @foreach (var k in b.Children)
                                        {
                                            @PersonCard(k.HeadNik, k.HeadName, k.HeadTitle, k.Unit, false)
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="adm-empty">No divisions yet. Add them in Organization → Plants &amp; divisions.</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private AdminOrgModel? org;
    private bool loadError;
    private double zoom = 1;

    private sealed record Node(string Key, string Unit, string? HeadNik, string? HeadName, string? HeadTitle, List<Node> Children);

    private List<Node> Branches = [];

    protected override Task OnInitializedAsync() => Reload();

    public async Task Reload()
    {
        var m = await AdminOrgModel.LoadAsync(Auth);
        loadError = m is null;
        if (m is not null)
        {
            org = m;
            Branches = Build(m);
        }
        StateHasChanged();
    }

    public void CloseAllDrawers() => StateHasChanged();

    private static List<Node> Build(AdminOrgModel m)
    {
        var depts = m.ActiveDepartments.ToList();
        var branches = m.ActiveDivisions
            .Select(d => new Node("d:" + d.Code, d.Name, d.HeadNik, d.HeadName, d.HeadPosition,
                depts.Where(x => x.DepartmentCode == d.Code)
                    .Select(x => new Node("t:" + x.Code, x.Name, x.HeadNik, x.HeadName, x.HeadPosition, []))
                    .ToList()))
            .ToList();
        var orphans = depts.Where(x => x.DepartmentCode is null || m.ActiveDivisions.All(d => d.Code != x.DepartmentCode)).ToList();
        if (orphans.Count > 0)
            branches.Add(new Node("d:", "No division", null, null, null,
                orphans.Select(x => new Node("t:" + x.Code, x.Name, x.HeadNik, x.HeadName, x.HeadPosition, [])).ToList()));
        return branches;
    }

    private RenderFragment PersonCard(string? nik, string? name, string? title, string unit, bool lead) => __builder =>
    {
        if (nik is null)
        {
            <button type="button" class="adm-pcard vacant @(lead ? "lead" : "")" @onclick="Vacant">
                <span class="adm-av vacant"><i data-lucide="user-x"></i></span>
                <span class="adm-pcard-txt"><b>Head vacant</b><small>@unit</small></span>
            </button>
        }
        else
        {
            <div class="adm-pcard @(lead ? "lead" : "")">
                <span class="adm-av" style="background:@AvatarPalette.For(nik)">@AdminOrgModel.Initials(name)</span>
                <span class="adm-pcard-txt"><b>@name</b><small>@(string.IsNullOrWhiteSpace(title) ? unit : $"{title} · {unit}")</small></span>
            </div>
        }
    };

    private void Vacant() => Toasts.Show("No head assigned yet · set one in Organization", ToastKind.Info);

    private void Zoom(double d) => zoom = Math.Clamp(Math.Round(zoom + d, 1), 0.6, 1.3);

    private async Task Export()
    {
        var sb = new System.Text.StringBuilder("Level,Unit,Parent,Head NIK,Head name,Head title\n");
        foreach (var b in Branches)
        {
            sb.AppendLine(Csv("Division", b.Unit, "Board of Directors", b.HeadNik, b.HeadName, b.HeadTitle));
            foreach (var k in b.Children)
                sb.AppendLine(Csv("Department", k.Unit, b.Unit, k.HeadNik, k.HeadName, k.HeadTitle));
        }
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
        await JS.InvokeVoidAsync("ipop.download", b64, $"org-chart-{DateTime.Now:yyyyMMdd}.csv");
    }

    private static string Csv(params string?[] cells) =>
        string.Join(",", cells.Select(c => $"\"{(c ?? "").Replace("\"", "\"\"")}\""));

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
}
