@* Org chart editor — positions with reporting lines, edited as a draft and published as a whole.
   The canvas (zoom, drag & drop, side panel, import) lives in js/org-chart.js; this component loads
   /api/admin/org/chart, publishes the draft and shows toasts. *@
@implements IAsyncDisposable
@inject AuthState Auth
@inject IJSRuntime JS
@inject ToastService Toasts

@if (loadError)
{
    <div class="adm-card"><div class="adm-empty">Could not load the organization chart. <button type="button" class="adm-link" @onclick="Reload">Retry</button></div></div>
}
else if (!loaded)
{
    <div class="adm-card"><div style="padding:14px"><div class="skel"></div></div></div>
}
<div class="oce" @ref="host" hidden="@(!loaded || loadError)"></div>

@code {
    private ElementReference host;
    private IJSObjectReference? module;
    private DotNetObjectReference<AdminOrgChart>? selfRef;
    private int editorId;
    private string? pending;
    private bool loaded, loadError, disposed, mounting;

    private sealed record ChartData(int Version, List<Pos> Positions, List<Unit> Units, List<Unit> Plants, List<Person> People);
    private sealed record Pos(string Id, string Title, string? ParentId, string? Unit, string? Plant, int Order, List<string> People);
    private sealed record Unit(string Code, string Name);
    private sealed record Person(string Nik, string Name, bool Active);

    protected override Task OnInitializedAsync() => Reload();

    /// Fresh published chart (first load and directoryChanged). An open draft in the editor is kept.
    public async Task Reload()
    {
        var data = await Auth.GetAsync<ChartData>("/api/admin/org/chart");
        loadError = data is null;
        if (data is null) { StateHasChanged(); return; }
        var photos = data.People.Select(p => (p.Nik, Url: AvatarPhotos.Url(p.Nik)))
            .Where(p => p.Url is not null).ToDictionary(p => p.Nik, p => p.Url!);
        pending = System.Text.Json.JsonSerializer.Serialize(new
        {
            version = data.Version,
            positions = data.Positions.Select(p => new { id = p.Id, title = p.Title, parentId = p.ParentId, unit = p.Unit, plant = p.Plant, order = p.Order, people = p.People }),
            units = data.Units.Select(u => new { code = u.Code, name = u.Name }),
            plants = data.Plants.Select(u => new { code = u.Code, name = u.Name }),
            people = data.People.Select(p => new { nik = p.Nik, name = p.Name, active = p.Active }),
            photos,
        });
        loaded = true;
        StateHasChanged();
        if (editorId != 0 && !mounting && module is not null) await PushPending();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || mounting || editorId != 0 || pending is null || !loaded || loadError) return;
        // Renders can overlap while the module loads; only the first one mounts.
        mounting = true;
        var json = pending; pending = null;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/org-chart.js?v=20261001-orgchart");
            selfRef ??= DotNetObjectReference.Create(this);
            editorId = await module.InvokeAsync<int>("mount", host, selfRef, json);
        }
        finally { mounting = false; }
        // A Reload that finished while mounting left newer data behind.
        if (pending is not null && !disposed) await PushPending();
    }

    private async Task PushPending()
    {
        var json = pending; pending = null;
        if (json is not null) await module!.InvokeVoidAsync("update", editorId, json);
    }

    /// Admin's Esc hook. The editor handles Esc itself (dialog first, then the side panel), so a
    /// second close from here would skip a level.
    public void CloseAllDrawers() { }

    [JSInvokable]
    public async Task<PublishResult> Publish(string body)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(body);
        HttpResponseMessage res;
        try { res = await Auth.SendAsync(HttpMethod.Post, "/api/admin/org/chart/publish", doc.RootElement); }
        catch (HttpRequestException) { return new(0, "Could not reach the server."); }
        using (res)
        {
            if (res.IsSuccessStatusCode) return new(200, null);
            string? message = null;
            try { message = (await res.Content.ReadFromJsonAsync<ApiError>())?.Message; } catch (System.Text.Json.JsonException) { }
            return new((int)res.StatusCode, message ?? $"Publish failed ({(int)res.StatusCode}).");
        }
    }

    [JSInvokable]
    public Task Refresh() => Reload();

    [JSInvokable]
    public void Toast(string message, string kind) =>
        Toasts.Show(message, Enum.TryParse<ToastKind>(kind, out var k) ? k : ToastKind.Info);

    public sealed record PublishResult(int Status, string? Message);
    private sealed record ApiError(string? Code, string? Message);

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try
            {
                if (editorId != 0) await module.InvokeVoidAsync("dispose", editorId);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        selfRef?.Dispose();
    }
}
