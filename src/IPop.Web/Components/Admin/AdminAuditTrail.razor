@* Audit log as sentences ("Budi reset Sari's password"), grouped by day, with repeats folded
   into one row ("signed in · 12×"). Opening a row shows the raw record: code, NIKs, IP, JSON. *@
@using IPop.Web.Services
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject IJSRuntime JS

<p class="adm-summary">
    @if (audit is null)
    {
        <span class="skel-inline"></span>
    }
    else
    {
        <span>@AdminHumanize.Plural(audit.Total, "event")@(selectedType == "all" && string.IsNullOrWhiteSpace(filterQuery) ? " recorded" : " match")</span>
        @if (Groups.FirstOrDefault() is { } latest)
        {
            <span>Latest @AdminHumanize.Ago(latest.First.CreatedAt).ToLowerInvariant()</span>
        }
    }
</p>

<div class="adm-card">
    <div class="adm-card-head adm-toolbar">
        <div class="adm-search">
            <i data-lucide="search"></i>
            <input placeholder="Search people, actions or IDs" @bind="filterQuery" @bind:event="oninput" @bind:after="OnFilterChanged" aria-label="Search the audit log" />
        </div>
        <div class="adm-toolbar-actions">
            <button type="button" class="adm-btn ghost" disabled="@exportingCsv" @onclick="ExportCsv" title="Download the filtered log as CSV">
                <i data-lucide="download"></i><span>@(exportingCsv ? "Exporting…" : "Export")</span>
            </button>
        </div>
        <div class="adm-chips" role="group" aria-label="Filter by kind">
            @foreach (var (key, label) in Types)
            {
                <button type="button" class="adm-fchip @(selectedType == key ? "on" : "")" aria-pressed="@(selectedType == key ? "true" : "false")" @onclick="() => SelectType(key)">@label</button>
            }
        </div>
    </div>

    @if (loadError)
    {
        <div class="adm-empty">Could not load the audit log. <button type="button" class="adm-link" @onclick="() => LoadAudit(false)">Retry</button></div>
    }
    else if (audit is null)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else if (Groups.Count == 0)
    {
        <div class="adm-empty">Nothing recorded@(string.IsNullOrWhiteSpace(filterQuery) ? "" : $" for “{filterQuery.Trim()}”").</div>
    }
    else
    {
        <div class="adm-log">
            @foreach (var day in Groups.GroupBy(g => AdminHumanize.Day(g.First.CreatedAt)))
            {
                <div class="adm-log-day">@day.Key</div>
                @foreach (var g in day)
                {
                    var kind = AdminHumanize.KindOf(g.First.Action);
                    var isOpen = openId == g.First.Id;
                    <div class="adm-log-item @(isOpen ? "open" : "")" @key="g.First.Id">
                        <button type="button" class="adm-log-row" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => openId = isOpen ? null : g.First.Id">
                            <span class="adm-log-ico @kind.Key"><i data-lucide="@kind.Icon"></i></span>
                            <span class="adm-log-txt">
                                @AdminHumanize.Sentence(g.First)
                                @if (g.Count > 1) { <em class="adm-tag">@g.Count×</em> }
                            </span>
                            <span class="adm-log-time">@TimeRange(g)</span>
                            <i data-lucide="@(isOpen ? "chevron-up" : "chevron-down")" class="adm-sess-chev"></i>
                        </button>
                        @if (isOpen)
                        {
                            <div class="adm-log-detail">
                                <dl>
                                    <dt>Event code</dt><dd class="mono">@g.First.Action</dd>
                                    <dt>By</dt><dd>@AdminHumanize.Actor(g.First)@(g.First.ActorNik is { } an && an != "system" ? $" ({an})" : "")</dd>
                                    @if (g.First.EntityId is not null)
                                    {
                                        <dt>@(g.First.Entity ?? "Target")</dt><dd>@(g.First.EntityName is { } en ? $"{en} ({g.First.EntityId})" : g.First.EntityId)</dd>
                                    }
                                    <dt>IP address</dt><dd class="mono">@(string.IsNullOrWhiteSpace(g.First.IpAddress) ? "Not recorded" : g.First.IpAddress)</dd>
                                    <dt>@(g.Count > 1 ? "Times" : "Time")</dt>
                                    <dd>@string.Join(", ", g.Rows.Take(12).Select(r => AdminHumanize.Local(r.CreatedAt).ToString("HH:mm:ss")))@(g.Count > 12 ? $" and {g.Count - 12} more" : "")</dd>
                                </dl>
                                @if (!string.IsNullOrWhiteSpace(g.First.DetailJson))
                                {
                                    <pre class="adm-log-json">@g.First.DetailJson</pre>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
        @if (loaded.Count < audit.Total)
        {
            <div class="adm-log-more">
                <button type="button" class="adm-btn ghost" disabled="@isLoading" @onclick="() => LoadAudit(true)">
                    @(isLoading ? "Loading…" : $"Show older ({(audit.Total - loaded.Count):N0} left)")
                </button>
            </div>
        }
    }
</div>

@code {
    private AuditPageDto? audit;
    private readonly List<AuditRowDto> loaded = [];
    private List<AdminHumanize.AuditGroup> Groups = [];
    private bool isLoading, loadError, exportingCsv;
    private int page;
    private const int pageSize = 60;
    private string filterQuery = "";
    private string selectedType = "all";
    private Guid? openId;
    private CancellationTokenSource? searchCts;

    private static readonly (string Key, string Label)[] Types =
    [
        ("all", "Everything"), ("security", "Sign-ins & sessions"), ("user", "Users"),
        ("org", "Organization"), ("sync", "HRIS sync"), ("settings", "Settings"),
    ];

    private static string TimeRange(AdminHumanize.AuditGroup g)
    {
        var last = AdminHumanize.Local(g.First.CreatedAt).ToString("HH:mm");
        var first = AdminHumanize.Local(g.Oldest).ToString("HH:mm");
        return g.Count > 1 && first != last ? $"{first}–{last}" : last;
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.AuditChanged += OnAuditChanged;
        await LoadAudit(false);
    }

    public async Task Reload()
    {
        await LoadAudit(false);
        StateHasChanged();
    }

    private async Task SelectType(string type)
    {
        selectedType = type;
        await LoadAudit(false);
    }

    private async Task OnFilterChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var t = new CancellationTokenSource();
        searchCts = t;
        try { await Task.Delay(250, t.Token); }
        catch (OperationCanceledException) { return; }
        if (t.IsCancellationRequested) return;
        await LoadAudit(false);
    }

    private string Filters()
    {
        var qs = "";
        if (!string.IsNullOrWhiteSpace(filterQuery)) qs += $"&q={Uri.EscapeDataString(filterQuery.Trim())}";
        if (selectedType != "all") qs += $"&type={Uri.EscapeDataString(selectedType)}";
        return qs;
    }

    /// more=false starts over (filters changed, live refresh); more=true appends the next page.
    private async Task LoadAudit(bool more)
    {
        isLoading = true;
        var next = more ? page + 1 : 1;
        var res = await Auth.GetAsync<AuditPageDto>($"/api/admin/audit?page={next}&pageSize={pageSize}{Filters()}");
        isLoading = false;
        loadError = res is null;
        if (res is not null)
        {
            if (!more) loaded.Clear();
            loaded.AddRange(res.Items);
            page = next;
            audit = res;
            Groups = AdminHumanize.Collapse(loaded);
        }
        StateHasChanged();
    }

    private async Task ExportCsv()
    {
        if (exportingCsv) return;
        exportingCsv = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, "/api/admin/audit/export.csv?" + Filters().TrimStart('&'));
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show($"Export failed ({(int)res.StatusCode}).", ToastKind.Error);
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"audit_trail-{stamp}.csv");
            Toasts.Show("Audit log downloaded", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export failed: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            exportingCsv = false;
        }
    }

    // Live refresh only when the newest page is showing, so "Show older" doesn't jump back.
    private void OnAuditChanged() => _ = InvokeAsync(async () =>
    {
        if (page <= 1) await LoadAudit(false);
    });

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");

    public void Dispose()
    {
        Auth.AuditChanged -= OnAuditChanged;
        searchCts?.Cancel();
        searchCts?.Dispose();
    }
}
