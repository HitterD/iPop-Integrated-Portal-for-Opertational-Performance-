@using IPop.Web.Services
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject IJSRuntime JS

@* ---- Audit Trail KPI Summary Grid ---- *@
<div class="admin-kpi-grid">
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-amber">
            <i data-lucide="scroll-text"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{audit?.Total ?? 0:N0}")</div>
            <div class="kpi-lbl">Total Log Audit</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-blue">
            <i data-lucide="file-text"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{audit?.Items.Length ?? 0:N0}")</div>
            <div class="kpi-lbl">Logs on this page</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-purple">
            <i data-lucide="user-check"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{UniqueActorsCount:N0}")</div>
            <div class="kpi-lbl">Active actors</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-green">
            <i data-lucide="shield-check"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val" style="font-size:16px">Active & Logged</div>
            <div class="kpi-lbl">Audit Trail System</div>
        </div>
    </div>
</div>

<div class="tray rise rise-2">
    <div class="core" style="padding:0;overflow:hidden">
        <div class="panel-head" style="border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between">
            <div style="display:flex;align-items:center;gap:8px">
                <i data-lucide="scroll-text" style="color:#d97706"></i>
                <span style="font-weight:700">System Activity Audit Trail</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px">
                <span class="meta">@($"{audit?.Total ?? 0:N0} total records")</span>
                <button class="org-act" title="Refresh audit log" @onclick="() => LoadAudit(currentPage)"><i data-lucide="refresh-cw"></i></button>
            </div>
        </div>

        <div style="display:flex;gap:12px;padding:12px 18px;border-bottom:1px solid var(--line-soft);align-items:center;flex-wrap:wrap">
            <div class="search" style="flex:0 1 260px;margin:0">
                <i data-lucide="search"></i>
                <input type="text" placeholder="Search actions, actors, targets…" @bind="filterQuery" @bind:event="oninput" @bind:after="OnFilterChanged" />
            </div>

            <div style="display:inline-flex;padding:2px;background:rgba(118,118,128,0.12);border-radius:10px;gap:2px">
                <button type="button" class="btn btn-sm @(selectedType == "all" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "all" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "all" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("all")'>All</button>
                <button type="button" class="btn btn-sm @(selectedType == "security" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "security" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "security" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("security")'>Security</button>
                <button type="button" class="btn btn-sm @(selectedType == "user" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "user" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "user" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("user")'>Users</button>
                <button type="button" class="btn btn-sm @(selectedType == "sync" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "sync" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "sync" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("sync")'>Sync</button>
                <button type="button" class="btn btn-sm @(selectedType == "org" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "org" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "org" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("org")'>Organization</button>
                <button type="button" class="btn btn-sm @(selectedType == "settings" ? "active" : "")" style="height:26px;padding:0 10px;font-size:11.5px;border-radius:8px;border:none;background:@(selectedType == "settings" ? "var(--surface)" : "transparent");color:var(--ink);box-shadow:@(selectedType == "settings" ? "0 1px 2px rgba(0,0,0,0.1)" : "none");font-weight:600;cursor:pointer" @onclick='() => SelectType("settings")'>Settings</button>
            </div>

            <div style="margin-left:auto">
                <button type="button" class="btn btn-sm surface" style="height:28px;padding:0 12px;font-size:12px;display:inline-flex;align-items:center;gap:6px;border-radius:8px;border:1px solid var(--line);background:var(--surface);cursor:pointer" disabled="@exportingCsv" @onclick="ExportCsv">
                    <i data-lucide="download" style="width:13px;height:13px"></i>
                    <span>@(exportingCsv ? "Exporting…" : "Export CSV")</span>
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div style="padding:14px"><div class="skel"></div></div>
        }
        else if (audit is null || audit.Items.Length == 0)
        {
            <div class="tree-empty" style="padding:28px">No matching audit activity logs.</div>
        }
        else
        {
            <table class="u-table">
                <thead>
                    <tr>
                        <th style="width:170px">Timestamp</th>
                        <th style="width:160px">Action</th>
                        <th style="width:140px">Actor</th>
                        <th style="width:130px">Entity</th>
                        <th>Target / Details</th>
                        <th style="width:130px">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in audit.Items)
                    {
                        <tr @key="row.Id">
                            <td class="mono" style="font-size:12px;color:var(--ink-2)">
                                <i data-lucide="clock" style="width:12px;height:12px;display:inline-block;vertical-align:-1px;margin-right:4px;color:var(--ink-3)"></i>
                                @row.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </td>
                            <td>
                                <span class="badge-audit @GetActionBadgeClass(row.Action)">
                                    @row.Action
                                </span>
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(row.ActorNik) || row.ActorNik.Equals("system", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge-audit system">system</span>
                                }
                                else
                                {
                                    <span class="tag">@row.ActorNik</span>
                                }
                            </td>
                            <td>
                                <span style="font-weight:600;color:var(--ink)">@(row.Entity ?? "—")</span>
                            </td>
                            <td class="mono" style="color:var(--ink-2);font-size:12px">
                                @(row.EntityId ?? "—")
                            </td>
                            <td class="mono" style="font-size:11.5px;color:var(--ink-3)">
                                @(string.IsNullOrWhiteSpace(row.IpAddress) ? "—" : row.IpAddress)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (TotalPages > 1)
            {
                <div style="display:flex;gap:10px;align-items:center;justify-content:center;padding:14px;border-top:1px solid var(--line-soft)">
                    <button class="org-act" disabled="@(currentPage <= 1)" @onclick="() => LoadAudit(currentPage - 1)"><i data-lucide="chevron-left"></i></button>
                    <span style="font-size:12px;color:var(--ink-2)">Page @currentPage of @TotalPages</span>
                    <button class="org-act" disabled="@(currentPage >= TotalPages)" @onclick="() => LoadAudit(currentPage + 1)"><i data-lucide="chevron-right"></i></button>
                </div>
            }
        }
    </div>
</div>

@code {
    private AuditPageDto? audit;
    private bool isLoading = true;
    private bool exportingCsv;
    private int currentPage = 1;
    private const int pageSize = 25;
    private string filterQuery = "";
    private string selectedType = "all";
    private CancellationTokenSource? searchCts;

    private int TotalPages => audit is null ? 1 : (int)Math.Ceiling(audit.Total / (double)pageSize);
    private int UniqueActorsCount => audit?.Items.Select(x => x.ActorNik ?? "system").Distinct().Count() ?? 0;

    protected override async Task OnInitializedAsync()
    {
        Auth.AuditChanged += OnAuditChanged;
        await LoadAudit(1);
    }

    public async Task Reload()
    {
        await LoadAudit(currentPage);
        StateHasChanged();
    }

    private async Task SelectType(string type)
    {
        selectedType = type;
        await LoadAudit(1);
    }

    private async Task OnFilterChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var t = new CancellationTokenSource();
        searchCts = t;
        try { await Task.Delay(250, t.Token); }
        catch (OperationCanceledException) { return; }
        if (t.IsCancellationRequested) return;
        await LoadAudit(1);
    }

    private async Task LoadAudit(int page)
    {
        currentPage = page;
        isLoading = true;
        var url = $"/api/admin/audit?page={page}&pageSize={pageSize}";
        if (!string.IsNullOrWhiteSpace(filterQuery)) url += $"&q={Uri.EscapeDataString(filterQuery.Trim())}";
        if (!string.IsNullOrWhiteSpace(selectedType) && selectedType != "all") url += $"&type={Uri.EscapeDataString(selectedType)}";

        audit = await Auth.GetAsync<AuditPageDto>(url);
        isLoading = false;
        StateHasChanged();
    }

    private async Task ExportCsv()
    {
        if (exportingCsv) return;
        exportingCsv = true;
        try
        {
            var url = "/api/admin/audit/export.csv?";
            if (!string.IsNullOrWhiteSpace(filterQuery)) url += $"&q={Uri.EscapeDataString(filterQuery.Trim())}";
            if (!string.IsNullOrWhiteSpace(selectedType) && selectedType != "all") url += $"&type={Uri.EscapeDataString(selectedType)}";

            var res = await Auth.SendAsync(HttpMethod.Get, url);
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show($"Export failed ({(int)res.StatusCode}).", ToastKind.Error);
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"audit_trail-{stamp}.csv");
            Toasts.ShowDetailed("Export Complete", "Audit trail CSV downloaded", ToastKind.Success, "download");
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export failed: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            exportingCsv = false;
        }
    }

    private static string GetActionBadgeClass(string action)
    {
        var lower = action.ToLowerInvariant();
        if (lower.Contains("login") || lower.Contains("auth") || lower.Contains("token") || lower.Contains("session") || lower.Contains("password"))
            return "auth";
        if (lower.Contains("create") || lower.Contains("insert") || lower.Contains("add"))
            return "create";
        if (lower.Contains("update") || lower.Contains("patch") || lower.Contains("edit") || lower.Contains("reset"))
            return "update";
        if (lower.Contains("delete") || lower.Contains("revoke") || lower.Contains("deactivate") || lower.Contains("remove"))
            return "delete";
        return "system";
    }

    private void OnAuditChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAudit(currentPage);
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        Auth.AuditChanged -= OnAuditChanged;
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    public record AuditPageDto(int Total, int Page, int PageSize, AuditRowDto[] Items);
    public record AuditRowDto(Guid Id, string? ActorNik, string Action, string? Entity,
        string? EntityId, string? DetailJson, string? IpAddress, DateTime CreatedAt);
}
