@* Organization — the one place the Plant ▸ Division ▸ Department structure is edited.
   The Directory tree and Org chart tabs are read-only views built from this data. *@
@inject AuthState Auth
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<div class="adm-kpis">
    <div class="adm-kpi"><span class="adm-kpi-ico green"><i data-lucide="factory"></i></span><div><b>@(org?.ActivePlants.Count() ?? 0)</b><span>Plants</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico violet"><i data-lucide="layers"></i></span><div><b>@(org?.ActiveDivisions.Count() ?? 0)</b><span>Divisions</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico blue"><i data-lucide="folder"></i></span><div><b>@(org?.ActiveDepartments.Count() ?? 0)</b><span>Departments</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico orange"><i data-lucide="users"></i></span><div><b>@((org?.AssignedEmployees ?? 0).ToString("N0"))</b><span>Assigned employees</span></div></div>
</div>

<div class="adm-card">
    <div class="adm-card-head">
        <span class="adm-card-title">Departments</span>
        <div class="adm-search">
            <i data-lucide="search"></i>
            <input placeholder="Search departments" @bind="query" @bind:event="oninput" aria-label="Search departments" />
        </div>
        <button type="button" class="adm-btn ghost" @onclick="() => unitsOpen = true"><i data-lucide="factory"></i> Plants &amp; divisions</button>
        <button type="button" class="adm-btn primary" @onclick="() => OpenCreate()"><i data-lucide="plus"></i> Add department</button>
    </div>

    @if (loadError)
    {
        <div class="adm-empty">Could not load the organization. <button type="button" class="adm-link" @onclick="Reload">Retry</button></div>
    }
    else if (org is null)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else
    {
        <div class="adm-grid-head adm-dept-grid">
            <span>Department</span><span>Division</span><span>Plant</span><span>Head</span><span>Employees</span><span></span>
        </div>
        @foreach (var d in Rows)
        {
            <div class="adm-grid-row adm-dept-grid @(d.IsActive ? "" : "off")" @key="d.Code" role="button" tabindex="0"
                 @onclick="() => OpenEdit(d)" @onkeydown="e => OnRowKey(e, d)">
                <span class="adm-cell-name"><i data-lucide="folder" class="adm-folder"></i> @d.Name @if (!d.IsActive) { <em class="adm-muted-tag">hidden</em> }</span>
                <span class="adm-cell-sub">@(d.DepartmentName ?? "—")</span>
                <span>@if (d.SiteName is not null) { <span class="adm-chip">@d.SiteName</span> } else { <span class="adm-cell-sub">—</span> }</span>
                <span class="adm-head-cell">
                    @if (d.HeadName is not null)
                    {
                        <span class="adm-av" style="background:@AvatarPalette.For(d.HeadNik!)">@AdminOrgModel.Initials(d.HeadName)</span>
                        <span class="adm-head-name">@d.HeadName</span>
                    }
                    else
                    {
                        <span class="adm-cell-sub">Not assigned</span>
                    }
                </span>
                <span class="adm-cell-n">@d.ActiveMemberCount</span>
                <span @onclick:stopPropagation>
                    <button type="button" class="adm-icon-btn" aria-label="More actions for @d.Name" @onclick="() => ToggleMenu(d.Code)"><i data-lucide="more-horizontal"></i></button>
                    @if (menuFor == d.Code)
                    {
                        <div class="adm-menu-scrim" @onclick="() => menuFor = null"></div>
                        <div class="adm-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => { menuFor = null; OpenEdit(d); }"><i data-lucide="pencil"></i> Edit department</button>
                            <button type="button" role="menuitem" @onclick="() => ShowInTree(d)"><i data-lucide="network"></i> View in directory tree</button>
                            <button type="button" role="menuitem" @onclick="() => ShowInTree(d)"><i data-lucide="users"></i> Show members</button>
                            <button type="button" role="menuitem" @onclick="() => ToggleHidden(d)"><i data-lucide="@(d.IsActive ? "eye-off" : "eye")"></i> @(d.IsActive ? "Hide department" : "Show department")</button>
                            <div class="adm-menu-sep"></div>
                            <button type="button" role="menuitem" class="danger" @onclick="() => Delete(d)"><i data-lucide="trash-2"></i> Delete department</button>
                        </div>
                    }
                </span>
            </div>
        }
        @if (!Rows.Any())
        {
            <div class="adm-empty">
                @(string.IsNullOrWhiteSpace(query) ? "No departments yet. Add plants and divisions, then add your first department." : "No departments match your search.")
            </div>
        }
    }
</div>

@if (editor is not null && org is not null)
{
    <AdminDeptModal Org="org" Existing="editor.Existing" PresetDivisionCode="@editor.DivisionCode" PresetPlantCode="@editor.PlantCode"
                    OnClose="() => editor = null" OnSaved="OnSaved" />
}
@if (unitsOpen && org is not null)
{
    <AdminUnitsModal Org="org" OnClose="() => unitsOpen = false" OnChanged="Reload" />
}

@code {
    /// Asks the Admin page to switch to the Directory tree with this department selected.
    [Parameter] public EventCallback<string> OnShowInTree { get; set; }

    private AdminOrgModel? org;
    private bool loadError, unitsOpen;
    private string query = "";
    private string? menuFor;
    private EditorState? editor;

    private IEnumerable<AdminDivisionRowDto> Rows => (org?.Departments ?? [])
        .Where(d => string.IsNullOrWhiteSpace(query)
            || d.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase)
            || (d.DepartmentName?.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.SiteName?.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) ?? false)
            || (d.HeadName?.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderByDescending(d => d.IsActive).ThenBy(d => d.SiteName).ThenBy(d => d.DepartmentName).ThenBy(d => d.Name);

    protected override Task OnInitializedAsync() => Reload();

    public async Task Reload()
    {
        var m = await AdminOrgModel.LoadAsync(Auth);
        loadError = m is null;
        if (m is not null) org = m;
        StateHasChanged();
    }

    /// Escape hook from the Admin page (modals also close themselves via OverlayStack).
    public void CloseAllDrawers()
    {
        menuFor = null;
        StateHasChanged();
    }

    public void OpenCreate(string? divisionCode = null, string? plantCode = null)
    {
        menuFor = null;
        editor = new EditorState(null, divisionCode, plantCode);
    }

    private void OpenEdit(AdminDivisionRowDto d) => editor = new EditorState(d, null, null);
    private void ToggleMenu(string code) => menuFor = menuFor == code ? null : code;

    private void OnRowKey(KeyboardEventArgs e, AdminDivisionRowDto d)
    {
        if (e.Key is "Enter" or " ") OpenEdit(d);
    }

    private async Task OnSaved()
    {
        editor = null;
        await Reload();
    }

    private async Task ShowInTree(AdminDivisionRowDto d)
    {
        menuFor = null;
        await OnShowInTree.InvokeAsync(d.Code);
    }

    private async Task ToggleHidden(AdminDivisionRowDto d)
    {
        menuFor = null;
        if (d.IsActive && d.ActiveMemberCount > 0
            && !await Confirm.AskAsync($"Hide “{d.Name}”?", $"{d.ActiveMemberCount} employees will move to “No division”.", "Hide"))
            return;
        var res = await Auth.SendAsync(HttpMethod.Patch, $"/api/admin/org/divisions/{Uri.EscapeDataString(d.Code)}",
            new UpsertDivisionRequest(d.Code, null, d.DepartmentCode, d.SiteCode, !d.IsActive));
        if (!res.IsSuccessStatusCode)
        {
            Toasts.Show(await AdminOrgModel.ErrorText(res, "Could not update the department."), ToastKind.Error);
            return;
        }
        await Reload();
    }

    private async Task Delete(AdminDivisionRowDto d)
    {
        menuFor = null;
        if (!await Confirm.AskAsync($"Delete “{d.Name}”?", $"{d.MemberCount} employees will move to “No division”."))
            return;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/admin/org/divisions/{Uri.EscapeDataString(d.Code)}", null);
        if (!res.IsSuccessStatusCode)
        {
            Toasts.Show(await AdminOrgModel.ErrorText(res, "Could not delete the department."), ToastKind.Error);
            return;
        }
        Toasts.Show($"Department “{d.Name}” deleted", ToastKind.Success);
        await Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");

    private sealed record EditorState(AdminDivisionRowDto? Existing, string? DivisionCode, string? PlantCode);
}
