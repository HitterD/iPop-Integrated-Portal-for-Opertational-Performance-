@* HRIS sync: one status line, a "Sync now" card, settings as plain rows, and a history that reads
   like a list of outcomes. Back-to-back runs that changed nothing fold into one row. *@
@using System.Net.Http.Json
@using System.Text.Json
@using IPop.Web.Services
@inject AuthState Auth
@inject ToastService Toasts
@inject IJSRuntime JS

<p class="adm-summary">
    @if (syncStatus is null && !loaded)
    {
        <span class="skel-inline"></span>
    }
    else
    {
        <span>@AdminHumanize.Plural(syncStatus?.EmployeeCount ?? 0, "employee") from HRIS</span>
        <span>@(syncStatus?.LastSyncedAt is { } at ? $"Last synced {AdminHumanize.Ago(at).ToLowerInvariant()}" : "Never synced")</span>
        <span>@(cronSchedule == "off" ? "Automatic sync is off" : $"Syncs {ScheduleLabel(cronSchedule).ToLowerInvariant()}")</span>
        @if (LatestFailed)
        {
            <button type="button" class="adm-summary-warn" @onclick='() => historyFilter = "failed"'>
                <i data-lucide="alert-triangle"></i>Last sync failed
            </button>
        }
    }
</p>

<div class="adm-hris-top">
    <div class="adm-card adm-hris-now">
        <span class="adm-detail-ico adm-hris-ico"><i data-lucide="@(syncing ? "loader-2" : "refresh-cw")" class="@(syncing ? "spin" : "")"></i></span>
        <div class="adm-hris-now-txt">
            <b>@(syncing ? "Syncing with HRIS…" : "Sync employee data")</b>
            <small>@(syncing ? "This can take a minute. You can leave this page." : "Pulls profiles from the HRIS server. New employees appear in the directory right away.")</small>
        </div>
        @if (syncing)
        {
            <button type="button" class="adm-btn ghost danger" @onclick="CancelSync">Cancel</button>
        }
        else
        {
            <button type="button" class="adm-btn primary" @onclick="SyncNow"><i data-lucide="refresh-cw"></i><span>Sync now</span></button>
        }
        @if (syncResult is not null)
        {
            <p class="adm-hris-result @(syncFailed ? "bad" : "")">
                <i data-lucide="@(syncFailed ? "alert-circle" : "check-circle-2")"></i><span>@syncResult</span>
            </p>
        }
    </div>

    <div class="adm-card adm-hris-settings">
        <div class="adm-set-row">
            <div class="adm-set-txt"><b>Automatic sync</b><small>How often the server pulls from HRIS</small></div>
            <AppSelect Label="Automatic sync" Value="@cronSchedule" ValueChanged="OnScheduleChanged" Options="@ScheduleOptions" CssClass="adm-set-select" />
        </div>
        <div class="adm-set-row">
            <div class="adm-set-txt"><b>Protect manual edits</b><small>Profiles edited in iPop keep their changes</small></div>
            <button type="button" class="apple-switch @(protectManualEdits ? "on" : "")" role="switch" aria-label="Protect manual edits"
                    aria-checked="@(protectManualEdits ? "true" : "false")" disabled="@updatingSettings" @onclick="ToggleProtect">
                <span class="apple-switch-knob"></span>
            </button>
        </div>
        <div class="adm-set-row">
            <div class="adm-set-txt"><b>Alert on failure</b><small>Notify IT admins when a sync fails</small></div>
            <button type="button" class="apple-switch @(notifyOnFailure ? "on" : "")" role="switch" aria-label="Alert on failure"
                    aria-checked="@(notifyOnFailure ? "true" : "false")" disabled="@updatingSettings" @onclick="ToggleNotify">
                <span class="apple-switch-knob"></span>
            </button>
        </div>
    </div>
</div>

<div class="adm-card">
    <div class="adm-card-head">
        <span class="adm-card-title">History</span>
        <div class="adm-chips" role="group" aria-label="Filter runs">
            <button type="button" class="adm-fchip @(historyFilter == "all" ? "on" : "")" @onclick='() => historyFilter = "all"'>All runs</button>
            <button type="button" class="adm-fchip @(historyFilter == "changes" ? "on" : "")" @onclick='() => historyFilter = "changes"'>With changes</button>
            <button type="button" class="adm-fchip @(historyFilter == "failed" ? "on" : "")" @onclick='() => historyFilter = "failed"'>Failed <span>@FailedCount</span></button>
        </div>
        <button type="button" class="adm-btn ghost" disabled="@exportingCsv" @onclick="ExportCsv" title="Download the sync history as CSV">
            <i data-lucide="download"></i><span>@(exportingCsv ? "Exporting…" : "Export")</span>
        </button>
    </div>

    @if (!loaded)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else if (Groups is not { Count: > 0 } groups)
    {
        <div class="adm-empty">@(historyFilter switch { "failed" => "No failed syncs.", "changes" => "No sync has changed anything yet.", _ => "No syncs have run yet." })</div>
    }
    else
    {
        <div class="adm-log">
            @foreach (var day in groups.GroupBy(g => AdminHumanize.Day(g[0].StartedAt)))
            {
                <div class="adm-log-day">@day.Key</div>
                @foreach (var g in day)
                {
                    var run = g[0];
                    var (ico, kind) = !run.Succeeded ? ("x", "bad") : IsQuiet(run) ? ("check", "quiet") : ("arrow-down-to-line", "ok");
                    <div class="adm-log-item adm-run" @key="run.Id">
                        <button type="button" class="adm-log-row" @onclick="() => OpenLog(g)">
                            <span class="adm-log-ico adm-run-ico @kind"><i data-lucide="@ico"></i></span>
                            <span class="adm-log-txt">
                                <b class="adm-run-what">@Outcome(run)</b>
                                @if (g.Count > 1) { <em class="adm-tag">@g.Count×</em> }
                                <small>@Meta(run)</small>
                            </span>
                            <span class="adm-log-time">@TimeRange(g)</span>
                            <i data-lucide="chevron-right" class="adm-sess-chev"></i>
                        </button>
                        @if (!run.Succeeded && !syncing && ReferenceEquals(g, groups[0]))
                        {
                            <button type="button" class="adm-link adm-run-retry" @onclick="SyncNow">Retry</button>
                        }
                    </div>
                }
            }
        </div>
        @if (syncHistory.Items.Length >= syncHistory.PageSize)
        {
            <p class="adm-list-hint adm-sess-cap">Showing the @syncHistory.PageSize latest runs. Export for the full history.</p>
        }
    }
</div>

<Modal IsOpen="@showLogModal" IsOpenChanged="@((val) => showLogModal = val)" Title="@(selectedRun is null ? "Sync log" : Outcome(selectedRun))"
       Subtitle="@LogSubtitle" Wide="true" Footer="@(CanRetrySelected ? RetryFooter : null)">
    <ChildContent>
        @if (selectedRun is { Succeeded: false } failed)
        {
            <p class="adm-hris-result bad">
                <i data-lucide="alert-circle"></i>
                <span>@(string.IsNullOrWhiteSpace(failed.Error) ? "The run stopped before it recorded a reason. Try again; if it keeps failing, check that the HRIS gateway is reachable." : failed.Error)</span>
            </p>
        }
        else if (selectedRun is { } r)
        {
            <div class="adm-facts adm-run-facts">
                <div><b>@r.Inserted</b><small>New</small></div>
                <div><b>@r.Updated</b><small>Updated</small></div>
                <div><b>@r.Deactivated</b><small>Removed</small></div>
                <div><b>@r.Skipped</b><small>Protected</small></div>
            </div>
        }
        <div class="adm-runlog-head">
            <span>Step log</span>
            <button type="button" class="adm-link" disabled="@(logLines.Length == 0)" @onclick="CopyLog"><i data-lucide="copy"></i>Copy</button>
        </div>
        <div class="adm-runlog">
            @if (loadingLog)
            {
                <div class="dim">Loading run log…</div>
            }
            else if (logLines.Length == 0)
            {
                <div class="dim">No step log lines recorded for this run.</div>
            }
            else
            {
                @foreach (var line in logLines)
                {
                    <div class="@(line.Contains("Failed") || line.Contains("Error") ? "err" : "")">@line</div>
                }
            }
        </div>
    </ChildContent>
</Modal>

@code {
    private bool syncing, syncFailed, loaded;
    private string? syncResult;
    private HrisSyncStatusDto? syncStatus;
    private SyncHistoryDto syncHistory = new(Array.Empty<HrisSyncRunDto>(), 1, 50);

    // Settings
    private string cronSchedule = "0 2 * * *";
    private bool protectManualEdits = true;
    private bool notifyOnFailure = true;
    private bool updatingSettings;

    // Filters and log modal
    private string historyFilter = "all";
    private bool showLogModal;
    private bool loadingLog;
    private bool exportingCsv;
    private HrisSyncRunDto? selectedRun;
    private int selectedCount;
    private string[] logLines = [];

    private static readonly List<AppOption> ScheduleOptions =
    [
        new("off", "Off"), new("0 * * * *", "Every hour"), new("0 */6 * * *", "Every 6 hours"), new("0 2 * * *", "Daily at 02:00"),
    ];

    private bool LatestFailed => syncHistory.Items.FirstOrDefault() is { Succeeded: false };
    private int FailedCount => syncHistory.Items.Count(r => !r.Succeeded);

    private static bool IsQuiet(HrisSyncRunDto r) =>
        r.Succeeded && r.Inserted + r.Updated + r.Deactivated + r.Skipped == 0;

    // Newest first. A quiet run joins the group above it when that group is also quiet and on the same day.
    private List<List<HrisSyncRunDto>> Groups
    {
        get
        {
            var runs = historyFilter switch
            {
                "failed" => syncHistory.Items.Where(r => !r.Succeeded),
                "changes" => syncHistory.Items.Where(r => r.Succeeded && !IsQuiet(r)),
                _ => syncHistory.Items.AsEnumerable(),
            };
            var groups = new List<List<HrisSyncRunDto>>();
            foreach (var r in runs)
            {
                var last = groups.LastOrDefault();
                if (last is not null && IsQuiet(r) && IsQuiet(last[0])
                    && AdminHumanize.Local(last[0].StartedAt).Date == AdminHumanize.Local(r.StartedAt).Date)
                    last.Add(r);
                else
                    groups.Add([r]);
            }
            return groups;
        }
    }

    private static string Outcome(HrisSyncRunDto r)
    {
        if (!r.Succeeded) return "Sync failed";
        if (IsQuiet(r)) return "No changes";
        var parts = new List<string>();
        if (r.Inserted > 0) parts.Add($"{r.Inserted:N0} new");
        if (r.Updated > 0) parts.Add($"{r.Updated:N0} updated");
        if (r.Deactivated > 0) parts.Add($"{r.Deactivated:N0} removed");
        if (r.Skipped > 0) parts.Add($"{r.Skipped:N0} protected");
        return string.Join(", ", parts);
    }

    private static string Meta(HrisSyncRunDto r) => Who(r) + (!r.Succeeded
        ? " · " + (string.IsNullOrWhiteSpace(r.Error) ? "open for details" : r.Error)
        : "");

    private static string Who(HrisSyncRunDto r)
    {
        var who = r.TriggeredBy is { Length: > 0 } t ? $"Started by {t}" : "Scheduled";
        var took = r.FinishedAt > r.StartedAt ? $" · took {Duration(r.FinishedAt - r.StartedAt)}" : "";
        return who + took;
    }

    private static string Duration(TimeSpan d) =>
        d.TotalSeconds < 60 ? $"{d.TotalSeconds:0.#} s" : $"{(int)d.TotalMinutes} min {d.Seconds} s";

    private static string TimeRange(List<HrisSyncRunDto> g)
    {
        var last = AdminHumanize.Local(g[0].StartedAt).ToString("HH:mm");
        var first = AdminHumanize.Local(g[^1].StartedAt).ToString("HH:mm");
        return g.Count > 1 && first != last ? $"{first}–{last}" : last;
    }

    private string LogSubtitle => selectedRun is null ? ""
        : $"{AdminHumanize.Local(selectedRun.StartedAt):dddd d MMM, HH:mm} · {Who(selectedRun)}"
          + (selectedCount > 1 ? $" · latest of {selectedCount} runs with no changes" : "");

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    public async Task Reload()
    {
        await Task.WhenAll(ReloadSyncStatus(), LoadSyncHistory(), LoadSettings());
        loaded = true;
        StateHasChanged();
    }

    private async Task ReloadSyncStatus()
        => syncStatus = await Auth.GetAsync<HrisSyncStatusDto>("/api/admin/hris/status");

    private async Task LoadSyncHistory()
        => syncHistory = await Auth.GetAsync<SyncHistoryDto>("/api/admin/hris/history?page=1&pageSize=50") ?? new([], 1, 50);

    private async Task LoadSettings()
    {
        try
        {
            var cronRes = await Auth.GetAsync<SettingDto>("/api/admin/settings/hris.autoSync.cron");
            if (cronRes is not null && cronRes.Value.ValueKind == JsonValueKind.String)
                cronSchedule = cronRes.Value.GetString() ?? "0 2 * * *";

            var protectRes = await Auth.GetAsync<SettingDto>("/api/admin/settings/hris.protectManualEdits");
            if (protectRes is not null && (protectRes.Value.ValueKind == JsonValueKind.True || protectRes.Value.ValueKind == JsonValueKind.False))
                protectManualEdits = protectRes.Value.GetBoolean();

            var notifyRes = await Auth.GetAsync<SettingDto>("/api/admin/settings/hris.notifyOnFailure");
            if (notifyRes is not null && (notifyRes.Value.ValueKind == JsonValueKind.True || notifyRes.Value.ValueKind == JsonValueKind.False))
                notifyOnFailure = notifyRes.Value.GetBoolean();
        }
        catch { /* best effort fallback to defaults */ }
    }

    private async Task OnScheduleChanged(string? value)
    {
        var val = value ?? "off";
        if (val == cronSchedule) return;
        updatingSettings = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, "/api/admin/settings/hris.autoSync.cron", val);
            if (res.IsSuccessStatusCode)
            {
                cronSchedule = val;
                Toasts.Show(val == "off" ? "Automatic sync turned off" : $"HRIS will sync {ScheduleLabel(val).ToLowerInvariant()}", ToastKind.Success);
            }
            else
            {
                Toasts.Show("Could not change the sync schedule.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Could not save: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            updatingSettings = false;
        }
    }

    private static string ScheduleLabel(string cron) =>
        ScheduleOptions.FirstOrDefault(o => o.Value == cron)?.Label ?? cron;

    private async Task ToggleProtect()
    {
        if (updatingSettings) return;
        updatingSettings = true;
        var next = !protectManualEdits;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, "/api/admin/settings/hris.protectManualEdits", next);
            if (res.IsSuccessStatusCode)
            {
                protectManualEdits = next;
                Toasts.Show(next ? "Manual edits are protected" : "HRIS can now overwrite manual edits", ToastKind.Success);
            }
            else
            {
                Toasts.Show("Could not change that setting.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Could not save: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            updatingSettings = false;
        }
    }

    private async Task ToggleNotify()
    {
        if (updatingSettings) return;
        updatingSettings = true;
        var next = !notifyOnFailure;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Put, "/api/admin/settings/hris.notifyOnFailure", next);
            if (res.IsSuccessStatusCode)
            {
                notifyOnFailure = next;
                Toasts.Show(next ? "IT admins will be alerted when a sync fails" : "Failure alerts turned off", ToastKind.Success);
            }
            else
            {
                Toasts.Show("Could not change that setting.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Could not save: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            updatingSettings = false;
        }
    }

    private async Task OpenLog(List<HrisSyncRunDto> group)
    {
        var run = group[0];
        selectedRun = run;
        selectedCount = group.Count;
        showLogModal = true;
        loadingLog = true;
        logLines = [];
        try
        {
            var dto = await Auth.GetAsync<RunLogDto>($"/api/admin/hris/runs/{run.Id}/log");
            logLines = dto?.Lines ?? [];
        }
        catch
        {
            logLines = ["Failed to load log for this run."];
        }
        finally
        {
            loadingLog = false;
        }
    }

    // Retry only makes sense for the latest run; an older failure has already been superseded.
    private bool CanRetrySelected => !syncing && selectedRun is { Succeeded: false }
        && ReferenceEquals(selectedRun, syncHistory.Items.FirstOrDefault());

    private RenderFragment RetryFooter => @<button type="button" class="adm-btn primary" @onclick="RetryFromLog"><i data-lucide="refresh-cw"></i><span>Try again</span></button>;

    private async Task RetryFromLog()
    {
        showLogModal = false;
        await SyncNow();
    }

    private async Task CopyLog()
    {
        if (logLines.Length == 0) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", string.Join("\n", logLines));
        Toasts.Show("Log copied", ToastKind.Success);
    }

    private async Task ExportCsv()
    {
        if (exportingCsv) return;
        exportingCsv = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, "/api/admin/hris/history.csv");
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show($"Export failed ({(int)res.StatusCode}).", ToastKind.Error);
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"hris_sync_history-{stamp}.csv");
            Toasts.Show("Sync history downloaded", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export failed: {ex.Message}", ToastKind.Error);
        }
        finally
        {
            exportingCsv = false;
        }
    }

    private CancellationTokenSource? syncCts;

    private async Task SyncNow()
    {
        syncing = true;
        syncResult = null;
        syncFailed = false;
        syncCts?.Dispose();
        syncCts = new CancellationTokenSource();
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/admin/hris/sync", ct: syncCts.Token);
            if (res.IsSuccessStatusCode)
            {
                var r = await res.Content.ReadFromJsonAsync<SyncResultDto>();
                syncResult = r is null ? "Sync finished."
                    : r.Inserted + r.Updated + r.Deactivated == 0 ? "Sync finished. Everything was already up to date."
                    : $"Sync finished: {r.Inserted:N0} new, {r.Updated:N0} updated, {r.Deactivated:N0} removed.";
                Toasts.Show(syncResult, ToastKind.Success);
            }
            else
            {
                syncFailed = true;
                syncResult = "Sync failed. The HRIS gateway may be busy; try again in a moment.";
                Toasts.Show(syncResult, ToastKind.Error);
            }
        }
        catch (OperationCanceledException)
        {
            syncResult = "Sync cancelled.";
            Toasts.Show(syncResult, ToastKind.Info);
        }
        catch
        {
            syncFailed = true;
            syncResult = "Sync failed: could not reach the server.";
            Toasts.Show(syncResult, ToastKind.Error);
        }
        finally
        {
            syncing = false;
            syncCts?.Dispose();
            syncCts = null;
        }
        await ReloadSyncStatus();
        await LoadSyncHistory();
    }

    private void CancelSync()
    {
        try { syncCts?.Cancel(); } catch { }
        syncing = false;
        syncResult = "Sync cancelled.";
        Toasts.Show(syncResult, ToastKind.Info);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public record SyncHistoryDto(HrisSyncRunDto[] Items, int Page, int PageSize);
    public record HrisSyncRunDto(Guid Id, DateTime StartedAt, DateTime FinishedAt, int Inserted,
        int Updated, int Deactivated, int Skipped, bool Succeeded, string? Error, string? TriggeredBy);
    public record SyncResultDto(int Inserted, int Updated, int Deactivated, DateTime SyncedAt);
    public record SettingDto(string Key, JsonElement Value);
    public record RunLogDto(Guid Id, string[] Lines);
}
