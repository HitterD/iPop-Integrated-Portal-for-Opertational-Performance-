@using System.Net.Http.Json
@using IPop.Web.Services
@inject AuthState Auth
@inject IJSRuntime JS

@* ---- HRIS Sync KPI Summary Grid ---- *@
<div class="admin-kpi-grid">
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-teal">
            <i data-lucide="users"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{syncStatus?.EmployeeCount ?? 0:N0}")</div>
            <div class="kpi-lbl">HRIS Employees</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-cyan">
            <i data-lucide="clock"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val" style="font-size:16px">@(syncStatus?.LastSyncedAt is not null ? syncStatus.LastSyncedAt.Value.ToLocalTime().ToString("dd MMM HH:mm") : "Never")</div>
            <div class="kpi-lbl">Last Synced</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-blue">
            <i data-lucide="history"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{syncHistory.Items.Length:N0}")</div>
            <div class="kpi-lbl">Sync History</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap @(syncing ? "kpi-amber" : "kpi-green")">
            <i data-lucide="@(syncing ? "loader-2" : "database-zap")" class="@(syncing ? "spin" : "")"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val" style="font-size:16px">@(syncing ? "Processing..." : "Ready to Sync")</div>
            <div class="kpi-lbl">Gateway Status</div>
        </div>
    </div>
</div>

<div class="tray rise rise-1">
    <div class="core" style="padding:0;overflow:hidden">
        <div class="panel-head" style="border-bottom:1px solid var(--line-soft)">
            <div style="display:flex;align-items:center;gap:8px">
                <i data-lucide="refresh-cw" style="color:#0d9488"></i>
                <span style="font-weight:700">HRIS Data Synchronization</span>
            </div>
            <span class="meta">@SyncCaption</span>
        </div>
        <div style="display:flex;align-items:center;gap:14px;padding:16px 20px">
            <div style="flex:1">
                <p style="margin:0;color:var(--ink);font-size:13px;line-height:1.5;font-weight:500">
                    Pull and synchronize employee profiles directly from the company's centralized HRIS server.
                </p>
                <div style="color:var(--ink-3);font-size:12px;margin-top:4px">
                    New employees are automatically registered in the directory. Manual modifications to units/departments are protected from sync overwrites.
                </div>
            </div>
            <button class="btn btn-teal" style="width:auto;margin:0;padding:10px 22px;border-radius:10px;font-weight:600;display:inline-flex;align-items:center;gap:8px" disabled="@syncing" @onclick="SyncNow">
                @if (syncing)
                {
                    <i data-lucide="loader-2" class="spin" style="width:16px;height:16px"></i>
                    <span>Synchronizing...</span>
                }
                else
                {
                    <i data-lucide="download" style="width:16px;height:16px"></i>
                    <span>Start Sync</span>
                }
            </button>
        </div>
        @if (syncResult is not null)
        {
            <div class="note" style="margin:0 18px 16px;border-radius:10px;background:rgba(13,148,136,0.08);border:1px solid rgba(13,148,136,0.25)">
                <i data-lucide="check-circle-2" style="color:#0d9488"></i>
                <span style="color:var(--ink);font-weight:500">@syncResult</span>
            </div>
        }
    </div>
</div>

<div class="tray rise rise-2" style="margin-top:16px">
    <div class="core" style="padding:0;overflow:hidden">
        <div class="panel-head" style="border-bottom:1px solid var(--line-soft)">
            <div style="display:flex;align-items:center;gap:8px">
                <i data-lucide="history" style="color:#0d9488"></i>
                <span style="font-weight:700">Sync Execution History</span>
            </div>
            <span class="meta">@syncHistory.Items.Length runs recorded</span>
        </div>
        <table class="u-table">
            <thead>
                <tr>
                    <th style="width:170px">Start Time</th>
                    <th style="width:120px">New Employees</th>
                    <th style="width:120px">Updated</th>
                    <th style="width:120px">Deactivated</th>
                    <th style="width:120px">Status</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in syncHistory.Items)
                {
                    <tr>
                        <td class="mono" style="font-size:12px">
                            <i data-lucide="calendar" style="width:12px;height:12px;display:inline-block;vertical-align:-1px;margin-right:4px;color:var(--ink-3)"></i>
                            @run.StartedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </td>
                        <td>
                            <span class="badge-audit create">+@run.Inserted</span>
                        </td>
                        <td>
                            <span class="badge-audit auth">~@run.Updated</span>
                        </td>
                        <td>
                            <span class="badge-audit delete">-@run.Deactivated</span>
                        </td>
                        <td>
                            @if (run.Succeeded)
                            {
                                <span class="badge-active-yes"><i data-lucide="check" style="width:11px;height:11px"></i> Success</span>
                            }
                            else
                            {
                                <span class="badge-active-no"><i data-lucide="x" style="width:11px;height:11px"></i> Failed</span>
                            }
                        </td>
                        <td style="font-size:12px;color:var(--ink-2)">
                            @(string.IsNullOrEmpty(run.Error) ? "Completed without issues" : run.Error)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (syncHistory.Items.Length == 0)
        {
            <div class="tree-empty" style="padding:28px">No recorded HRIS sync history.</div>
        }
    </div>
</div>

@code {
    private bool syncing;
    private string? syncResult;
    private HrisSyncStatusDto? syncStatus;
    private SyncHistoryDto syncHistory = new(Array.Empty<HrisSyncRunDto>(), 1, 20);

    private string SyncCaption => syncStatus?.LastSyncedAt is null
        ? "Never synchronized"
        : $"{syncStatus.EmployeeCount:N0} employees · last {syncStatus.LastSyncedAt.Value.ToLocalTime():dd MMM HH:mm}";

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    public async Task Reload()
    {
        await Task.WhenAll(ReloadSyncStatus(), LoadSyncHistory());
        StateHasChanged();
    }

    private async Task ReloadSyncStatus()
        => syncStatus = await Auth.GetAsync<HrisSyncStatusDto>("/api/admin/hris/status");

    private async Task LoadSyncHistory()
        => syncHistory = await Auth.GetAsync<SyncHistoryDto>("/api/admin/hris/history?page=1&pageSize=20") ?? new([], 1, 20);

    private async Task SyncNow()
    {
        syncing = true;
        syncResult = null;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/admin/hris/sync");
            if (res.IsSuccessStatusCode)
            {
                var r = await res.Content.ReadFromJsonAsync<SyncResultDto>();
                syncResult = r is null ? "Synchronization completed."
                    : $"Synchronization completed: {r.Inserted} new, {r.Updated} updated, {r.Deactivated} deactivated.";
            }
            else
            {
                syncResult = "Synchronization failed — gateway may be busy or rate-limited. Please try again shortly.";
            }
        }
        catch
        {
            syncResult = "Synchronization failed — cannot reach server.";
        }
        finally
        {
            syncing = false;
        }
        await ReloadSyncStatus();
        await LoadSyncHistory();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public record SyncHistoryDto(HrisSyncRunDto[] Items, int Page, int PageSize);
    public record HrisSyncRunDto(Guid Id, DateTime StartedAt, DateTime FinishedAt, int Inserted,
        int Updated, int Deactivated, bool Succeeded, string? Error);
    public record SyncResultDto(int Inserted, int Updated, int Deactivated, DateTime SyncedAt);
}
