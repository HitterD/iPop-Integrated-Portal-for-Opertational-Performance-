@using IPop.Web.Services
@using IPop.Web.Components
@implements IDisposable
@inject AuthState Auth
@inject IJSRuntime JS
@inject ToastService Toasts
@inject ConfirmService Confirm

<div class="adm-kpis">
    <div class="adm-kpi"><span class="adm-kpi-ico green"><i data-lucide="user-check"></i></span><div><b>@((stats?.Active ?? 0).ToString("N0"))</b><span>Active</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico red"><i data-lucide="lock"></i></span><div><b>@((stats?.Locked ?? 0).ToString("N0"))</b><span>Locked</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico gray"><i data-lucide="user-x"></i></span><div><b>@((stats?.Inactive ?? 0).ToString("N0"))</b><span>Inactive</span></div></div>
    <div class="adm-kpi"><span class="adm-kpi-ico blue"><i data-lucide="shield"></i></span><div><b>@((stats?.Admins ?? 0).ToString("N0"))</b><span>Admins</span></div></div>
</div>

<div class="adm-card">
    <div class="adm-card-head">
        <div class="adm-search">
            <i data-lucide="search"></i>
            <input placeholder="Search by name or NIK" @bind="query" @bind:event="oninput" @bind:after="OnUserSearchInput" aria-label="Search users" />
        </div>
        <div class="adm-chips" role="group" aria-label="Filter">
            @foreach (var (key, label, count) in Chips)
            {
                <button type="button" class="adm-fchip @(filter == key ? "on" : "")" aria-pressed="@(filter == key ? "true" : "false")" @onclick="() => SetFilter(key)">
                    @label <span>· @count.ToString("N0")</span>
                </button>
            }
        </div>
        <button type="button" class="adm-btn ghost" @onclick="ExportUsersCsv"><i data-lucide="download"></i> Export</button>
        <button type="button" class="adm-btn primary" @onclick="OpenCreate"><i data-lucide="user-plus"></i> Add user</button>
    </div>

    @if (usersError is not null)
    {
        <div class="adm-empty">@usersError <button type="button" class="adm-link" @onclick="() => ReloadUsers(1)">Retry</button></div>
    }
    else if (userPage is null)
    {
        <div style="padding:14px"><div class="skel"></div></div>
    }
    else
    {
        <div class="adm-grid-head adm-user-grid">
            <span>User</span><span>NIK</span><span>Role</span><span>Status</span><span>Last sign-in</span><span></span>
        </div>
        @foreach (var u in userPage.Items)
        {
            var role = PrimaryRole(u.Roles);
            <div class="adm-grid-row adm-user-grid @(u.IsActive ? "" : "off")" @key="u.Nik">
                <span class="adm-user-cell">
                    <span class="adm-av" style="background:@AvatarPalette.For(u.Nik)">@AdminOrgModel.Initials(u.Name)</span>
                    <span class="adm-user-txt">
                        <b>@u.Name</b>
                        <small>@UnitLine(u)</small>
                    </span>
                </span>
                <span class="adm-mono">@u.Nik</span>
                <span class="adm-pop-anchor">
                    <button type="button" class="adm-role @RoleClass(role)" aria-haspopup="menu" aria-label="Role: @role. Change role"
                            @onclick="() => ToggleMenu(u.Nik, MenuKind.Role)">
                        @role <i data-lucide="chevron-down"></i>
                    </button>
                    @if (menuNik == u.Nik && menuKind == MenuKind.Role)
                    {
                        <div class="adm-menu-scrim" @onclick="CloseMenu"></div>
                        <div class="adm-menu narrow" role="menu">
                            @foreach (var opt in RoleOptions)
                            {
                                var r = opt.Value;
                                <button type="button" role="menuitemradio" aria-checked="@(role == r ? "true" : "false")" title="@RoleHint(r)" @onclick="() => SetRole(u, r)"><span class="adm-role @RoleClass(r)">@r</span> @if (role == r) { <i data-lucide="check" class="tick"></i> }</button>
                            }
                        </div>
                    }
                </span>
                <span><span class="adm-status @StatusClass(u)">@StatusLabel(u)</span></span>
                <span class="adm-cell-sub" title="@(u.LastSignInAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))">@Ago(u.LastSignInAt)</span>
                <span class="adm-pop-anchor">
                    <button type="button" class="adm-icon-btn" aria-haspopup="menu" aria-label="More actions for @u.Name" @onclick="() => ToggleMenu(u.Nik, MenuKind.More)"><i data-lucide="more-horizontal"></i></button>
                    @if (menuNik == u.Nik && menuKind == MenuKind.More)
                    {
                        <div class="adm-menu-scrim" @onclick="CloseMenu"></div>
                        <div class="adm-menu" role="menu">
                            <button type="button" role="menuitem" @onclick="() => { CloseMenu(); OpenEdit(u); }"><i data-lucide="pencil"></i> Edit profile</button>
                            <button type="button" role="menuitem" @onclick="() => ResetPassword(u)"><i data-lucide="key-round"></i> Reset password</button>
                            <button type="button" role="menuitem" @onclick="() => SignOutAll(u)"><i data-lucide="log-out"></i> Sign out all sessions</button>
                            <div class="adm-menu-sep"></div>
                            <button type="button" role="menuitem" @onclick="() => ToggleLock(u)"><i data-lucide="@(u.IsLocked ? "unlock" : "lock")"></i> @(u.IsLocked ? "Unlock account" : "Lock account")</button>
                            <button type="button" role="menuitem" class="@(u.IsActive ? "danger" : "")" @onclick="() => ToggleActive(u)"><i data-lucide="@(u.IsActive ? "user-x" : "user-check")"></i> @(u.IsActive ? "Deactivate" : "Activate")</button>
                        </div>
                    }
                </span>
            </div>
        }
        @if (userPage.Items.Length == 0)
        {
            <div class="adm-empty">No users match.</div>
        }
        @if (TotalPages > 1)
        {
            <div class="adm-pager">
                <button type="button" class="adm-icon-btn" aria-label="Previous page" disabled="@(userPage.Page <= 1)" @onclick="() => ReloadUsers(userPage.Page - 1)"><i data-lucide="chevron-left"></i></button>
                <span>Page @userPage.Page of @TotalPages · @userPage.Total.ToString("N0") users</span>
                <button type="button" class="adm-icon-btn" aria-label="Next page" disabled="@(userPage.Page >= TotalPages)" @onclick="() => ReloadUsers(userPage.Page + 1)"><i data-lucide="chevron-right"></i></button>
            </div>
        }
    }
</div>

@* ---- user drawer: create / edit share one shell ---- *@
<div class="backdrop @(drawer is not null ? "on" : "")" @onclick="CloseDrawer"></div>
<div class="drawer @(drawer is not null ? "on" : "")" role="dialog" aria-label="User">
    <div class="tray">
        <div class="core">
            <div class="drawer-head">
                @(drawer?.IsCreate == true ? "Add user" : $"Edit {drawer?.Name}")
                <button class="drawer-close" aria-label="Close" @onclick="CloseDrawer"><i data-lucide="x"></i></button>
            </div>
            @if (drawer is not null)
            {
                <div class="drawer-body">
                    @if (drawer.IsCreate)
                    {
                        <div class="field"><label>Employee ID (NIK)</label><input @bind="drawer.Nik" placeholder="e.g. 20140312" /></div>
                    }
                    <div class="field"><label>Name</label><input @bind="drawer.Name" /></div>
                    <div class="field"><label>Email</label><input @bind="drawer.Email" /></div>
                    <div class="field"><label>Position</label><input @bind="drawer.Position" /></div>
                    <div class="field">
                        <label>Department</label>
                        <AppSelect Label="Department" Value="@drawer.UnitCode" ValueChanged='v => drawer.UnitCode = v ?? ""' Options="@UnitOptions" />
                        <small class="adm-field-hint">Plant and division follow the department. Manage units in the Organization tab.</small>
                    </div>
                    @if (!drawer.IsCreate)
                    {
                        <div class="field">
                            <label>Role</label>
                            <AppSelect Label="Role" Value="@drawer.Role" ValueChanged='v => drawer.Role = v ?? "Employee"'
                                       Options="@RoleOptions" />
                            <small class="adm-field-hint">@RoleHint(drawer.Role)</small>
                        </div>
                    }
                    <div class="note">
                        <i data-lucide="info"></i>
                        <span>@(drawer.IsCreate
                            ? "The new user signs in with the default password 1234 and must set their own at first login."
                            : "Profile edits are protected from the next HRIS sync.")</span>
                    </div>
                    @if (drawer.Error is not null)
                    {
                        <div class="note err"><i data-lucide="alert-circle"></i><span>@drawer.Error</span></div>
                    }
                    <button class="btn" style="margin-top:14px" disabled="@drawer.Saving" @onclick="SaveDrawer">
                        @(drawer.Saving ? "Saving..." : drawer.IsCreate ? "Create user" : "Save changes")
                        <span class="orb"><i data-lucide="check"></i></span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private enum MenuKind { None, Role, More }

    private string query = "";
    private string filter = "all";
    private string? usersError;
    private AdminUserPageDto? userPage;
    private AdminUserStatsDto? stats;
    private AdminOrgModel? org;
    private DrawerState? drawer;
    private string? menuNik;
    private MenuKind menuKind;
    private CancellationTokenSource? userSearchCts;

    private static readonly List<AppOption> RoleOptions = [new("Employee", "Employee"), new("HR", "HR"), new("Admin", "Admin")];
    // Roles the picker owns; any other stored role (e.g. a custom RBAC role) is preserved on change.
    private static readonly string[] PickerRoles = ["Admin", "HR", "Employee"];

    private static string PrimaryRole(IEnumerable<string> roles) =>
        roles.Contains("Admin") ? "Admin" : roles.Contains("HR") ? "HR" : "Employee";

    private static string RoleClass(string role) => role switch { "Admin" => "admin", "HR" => "hr", _ => "emp" };

    private static string RoleHint(string role) => role switch
    {
        "Admin" => "Full access, including Administration.",
        "HR" => "Can post, edit, pin and delete News & Memos and track acknowledgements.",
        _ => "Reads news and memos; no publishing rights."
    };

    private static string[] WithRole(IEnumerable<string> current, string role) =>
        current.Where(r => !PickerRoles.Contains(r)).Append(role).Distinct().ToArray();

    private IEnumerable<(string Key, string Label, int Count)> Chips =>
    [
        ("all", "All", stats?.Total ?? 0),
        ("admin", "Admin", stats?.Admins ?? 0),
        ("hr", "HR", stats?.Hr ?? 0),
        ("employee", "Employee", Math.Max(0, (stats?.Total ?? 0) - (stats?.Admins ?? 0) - (stats?.Hr ?? 0))),
        ("locked", "Locked", stats?.Locked ?? 0),
        ("inactive", "Inactive", stats?.Inactive ?? 0),
    ];

    private List<AppOption> UnitOptions => [new("", "Not assigned"),
        .. (org?.ActiveDepartments ?? []).OrderBy(d => d.SiteName).ThenBy(d => d.DepartmentName).ThenBy(d => d.Name)
            .Select(d => new AppOption(d.Code, string.Join(" · ", new[] { d.SiteName, d.DepartmentName, d.Name }.Where(x => !string.IsNullOrEmpty(x)))))];

    private int TotalPages => userPage is null ? 1 : (int)Math.Ceiling(userPage.Total / (double)userPage.PageSize);

    private string FilterQuery => filter switch
    {
        "admin" => "&role=Admin",
        "hr" => "&role=HR",
        "employee" => "&role=Employee",
        "locked" => "&locked=true",
        "inactive" => "&active=false",
        _ => ""
    };

    protected override Task OnInitializedAsync() => Reload();

    public async Task Reload()
    {
        org = await AdminOrgModel.LoadAsync(Auth) ?? org;
        await ReloadStats();
        await ReloadUsers(userPage?.Page ?? 1);
    }

    private async Task ReloadStats() => stats = await Auth.GetAsync<AdminUserStatsDto>("/api/admin/users/stats") ?? stats;

    private async Task SetFilter(string key)
    {
        filter = key;
        await ReloadUsers(1);
    }

    private async Task OnUserSearchInput()
    {
        userSearchCts?.Cancel();
        userSearchCts?.Dispose();
        var t = new CancellationTokenSource();
        userSearchCts = t;
        try { await Task.Delay(250, t.Token); }
        catch (OperationCanceledException) { return; }
        if (t.IsCancellationRequested) return;
        await ReloadUsers(1);
    }

    private async Task ReloadUsers(int p)
    {
        var key = query + filter;
        var url = $"/api/admin/users?page={p}&pageSize=50" + FilterQuery
            + (string.IsNullOrWhiteSpace(query) ? "" : $"&q={Uri.EscapeDataString(query.Trim())}");
        var res = await Auth.GetAsync<AdminUserPageDto>(url);
        if (key != query + filter) return;
        userPage = res ?? userPage;
        usersError = res is null ? "Could not load users." : null;
        StateHasChanged();
    }

    private async Task Refresh()
    {
        await ReloadStats();
        await ReloadUsers(userPage?.Page ?? 1);
    }

    private static string UnitLine(AdminUserRowDto u)
    {
        var parts = new[] { u.Position, u.Division ?? u.Department }.Where(x => !string.IsNullOrWhiteSpace(x));
        var s = string.Join(" · ", parts);
        return s.Length > 0 ? s : u.Email;
    }

    private static string StatusLabel(AdminUserRowDto u) => !u.IsActive ? "Inactive" : u.IsLocked ? "Locked" : "Active";
    private static string StatusClass(AdminUserRowDto u) => !u.IsActive ? "inactive" : u.IsLocked ? "locked" : "active";

    private static string Ago(DateTime? at)
    {
        if (at is null) return "Never";
        var d = DateTime.UtcNow - DateTime.SpecifyKind(at.Value, DateTimeKind.Utc);
        if (d.TotalMinutes < 1) return "Just now";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes} min ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours} h ago";
        if (d.TotalDays < 2) return "Yesterday";
        if (d.TotalDays < 30) return $"{(int)d.TotalDays} days ago";
        return at.Value.ToLocalTime().ToString("dd MMM yyyy");
    }

    private void ToggleMenu(string nik, MenuKind kind)
    {
        if (menuNik == nik && menuKind == kind) { CloseMenu(); return; }
        menuNik = nik;
        menuKind = kind;
    }

    private void CloseMenu()
    {
        menuNik = null;
        menuKind = MenuKind.None;
    }

    private async Task SetRole(AdminUserRowDto u, string role)
    {
        CloseMenu();
        if (PrimaryRole(u.Roles) == role) return;
        var roles = WithRole(u.Roles, role);
        var res = await Auth.SendAsync(HttpMethod.Put, $"/api/admin/users/{Uri.EscapeDataString(u.Nik)}/roles", new { roles });
        if (!res.IsSuccessStatusCode)
        {
            Toasts.Show(await AdminOrgModel.ErrorText(res, "Could not change the role."), ToastKind.Error);
            return;
        }
        Toasts.Show($"{u.Name} is now {(role == "Employee" ? "an Employee" : role == "Admin" ? "an Admin" : "HR")}", ToastKind.Success);
        await Refresh();
    }

    private async Task ResetPassword(AdminUserRowDto u)
    {
        CloseMenu();
        if (!await Confirm.AskAsync($"Reset {u.Name}'s password?",
                "The password becomes 1234 and they are signed out everywhere. They must choose a new one at next sign-in.",
                "Reset password"))
            return;
        await Run(u, "reset-password", $"Password for {u.Name} reset to 1234");
    }

    private async Task SignOutAll(AdminUserRowDto u)
    {
        CloseMenu();
        if (!await Confirm.AskAsync($"Sign {u.Name} out everywhere?", "All their active sessions end now. They can sign in again.", "Sign out", false))
            return;
        await Run(u, "sessions/revoke-all", $"{u.Name} was signed out of all sessions");
    }

    private async Task ToggleLock(AdminUserRowDto u)
    {
        CloseMenu();
        if (u.IsLocked)
        {
            await Run(u, "unlock", $"{u.Name}'s account unlocked");
            return;
        }
        if (!await Confirm.AskAsync($"Lock {u.Name}'s account?", "They will be signed out and cannot sign in until unlocked.", "Lock"))
            return;
        await Run(u, "lock", $"{u.Name}'s account locked");
    }

    private async Task ToggleActive(AdminUserRowDto u)
    {
        CloseMenu();
        if (u.IsActive && !await Confirm.AskAsync($"Deactivate {u.Name}?",
                "They are signed out, hidden from the directory, and cannot sign in. You can activate them again later.", "Deactivate"))
            return;
        await Run(u, u.IsActive ? "deactivate" : "reactivate", u.IsActive ? $"{u.Name} deactivated" : $"{u.Name} activated");
    }

    private async Task Run(AdminUserRowDto u, string action, string ok)
    {
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/admin/users/{Uri.EscapeDataString(u.Nik)}/{action}");
        if (!res.IsSuccessStatusCode)
        {
            Toasts.Show(await AdminOrgModel.ErrorText(res, "The action failed. Try again."), ToastKind.Error);
            return;
        }
        Toasts.Show(ok, ToastKind.Success);
        await Refresh();
    }

    private async Task ExportUsersCsv()
    {
        try
        {
            var url = "/api/admin/users?page=1&pageSize=5000" + FilterQuery
                + (string.IsNullOrWhiteSpace(query) ? "" : $"&q={Uri.EscapeDataString(query.Trim())}");
            var res = await Auth.GetAsync<AdminUserPageDto>(url);
            var rows = res?.Items ?? userPage?.Items ?? [];
            if (rows.Length == 0) return;
            var sb = new System.Text.StringBuilder("NIK,Name,Email,Position,Plant,Division,Department,Role,Status,Last sign-in\n");
            foreach (var u in rows)
                sb.AppendLine(string.Join(",", new[] { u.Nik, u.Name, u.Email, u.Position, u.Site, u.Department, u.Division,
                        PrimaryRole(u.Roles), StatusLabel(u), u.LastSignInAt?.ToString("u") }
                    .Select(c => $"\"{(c ?? "").Replace("\"", "\"\"")}\"")));
            var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(sb.ToString()));
            await JS.InvokeVoidAsync("ipop.download", b64, $"users-{DateTime.Now:yyyyMMdd-HHmm}.csv");
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export failed: {ex.Message}", ToastKind.Error);
        }
    }

    private void OpenCreate() => drawer = new DrawerState { IsCreate = true, UnitCode = "" };

    private void OpenEdit(AdminUserRowDto u) => drawer = new DrawerState
    {
        Nik = u.Nik, Name = u.Name, Email = u.Email, Position = u.Position ?? "",
        DepartmentCode = u.DepartmentCode, SiteCode = u.SiteCode,
        UnitCode = u.DivisionCode ?? "", OriginalUnitCode = u.DivisionCode ?? "",
        Role = PrimaryRole(u.Roles), Roles = u.Roles,
    };

    /// Escape hook from the Admin page.
    public void CloseDrawer()
    {
        drawer = null;
        CloseMenu();
        StateHasChanged();
    }

    private async Task SaveDrawer()
    {
        if (drawer is null) return;
        drawer.Saving = true;
        drawer.Error = null;

        // The chosen department carries its plant and division; otherwise keep the user's current ones.
        var unit = org?.Departments.FirstOrDefault(d => d.Code == drawer.UnitCode);
        var deptCode = unit is not null ? unit.DepartmentCode : drawer.DepartmentCode;
        var siteCode = unit is not null ? unit.SiteCode : drawer.SiteCode;

        var res = drawer.IsCreate
            ? await Auth.SendAsync(HttpMethod.Post, "/api/admin/users",
                new { nik = drawer.Nik, name = drawer.Name, email = drawer.Email, position = drawer.Position,
                    location = (string?)null, departmentCode = deptCode, siteCode })
            : await Auth.SendAsync(HttpMethod.Patch, $"/api/admin/users/{Uri.EscapeDataString(drawer.Nik)}",
                new { name = drawer.Name, email = drawer.Email, position = drawer.Position,
                    location = (string?)null, departmentCode = deptCode, siteCode });
        if (!res.IsSuccessStatusCode)
        {
            drawer.Error = await AdminOrgModel.ErrorText(res, "Save failed — check the fields.");
            drawer.Saving = false;
            return;
        }

        var nik = drawer.Nik.Trim();
        if (drawer.UnitCode != drawer.OriginalUnitCode)
        {
            var unitRes = string.IsNullOrEmpty(drawer.UnitCode)
                ? await Auth.SendAsync(HttpMethod.Delete, $"/api/admin/org/users/{Uri.EscapeDataString(nik)}/division", null)
                : await Auth.SendAsync(HttpMethod.Put, $"/api/admin/org/users/{Uri.EscapeDataString(nik)}/division",
                    new { divisionCode = drawer.UnitCode });
            if (!unitRes.IsSuccessStatusCode)
            {
                drawer.Error = "User saved, but the department could not be set.";
                drawer.Saving = false;
                await Refresh();
                return;
            }
        }

        if (!drawer.IsCreate && drawer.Role != PrimaryRole(drawer.Roles))
        {
            var roles = WithRole(drawer.Roles, drawer.Role);
            var roleRes = await Auth.SendAsync(HttpMethod.Put, $"/api/admin/users/{Uri.EscapeDataString(nik)}/roles", new { roles });
            if (!roleRes.IsSuccessStatusCode)
            {
                drawer.Error = await AdminOrgModel.ErrorText(roleRes, "User saved, but the role change failed.");
                drawer.Saving = false;
                await Refresh();
                return;
            }
        }

        Toasts.Show(drawer.IsCreate ? $"{drawer.Name} added" : "Changes saved", ToastKind.Success);
        drawer = null;
        await Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");

    public void Dispose()
    {
        userSearchCts?.Cancel();
        userSearchCts?.Dispose();
    }

    private sealed class DrawerState
    {
        public bool IsCreate, Saving;
        public string Role = "Employee";
        public string Nik = "", Name = "", Email = "", Position = "";
        public string? DepartmentCode, SiteCode, Error;
        public string UnitCode = "", OriginalUnitCode = "";
        public string[] Roles = [];
    }
}
