@using Microsoft.AspNetCore.Components.Rendering
@using IPop.Web.Services
@using IPop.Web.Components
@inject AuthState Auth
@inject IJSRuntime JS

@* ---- Directory Tree KPI Summary Grid ---- *@
<div class="admin-kpi-grid">
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-cyan">
            <i data-lucide="folder-tree"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{dirGroups.Length:N0}")</div>
            <div class="kpi-lbl">Total Grup</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-blue">
            <i data-lucide="folder"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{dirGroups.Count(g => g.ParentId == null):N0}")</div>
            <div class="kpi-lbl">Grup Induk</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-purple">
            <i data-lucide="git-fork"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{dirGroups.Count(g => g.ParentId != null):N0}")</div>
            <div class="kpi-lbl">Sub-grup</div>
        </div>
    </div>
    <div class="admin-kpi-card">
        <div class="kpi-icon-wrap kpi-teal">
            <i data-lucide="users"></i>
        </div>
        <div class="kpi-body">
            <div class="kpi-val">@($"{dirGroups.Sum(g => g.Members.Length):N0}")</div>
            <div class="kpi-lbl">Linked Members</div>
        </div>
    </div>
</div>

<div class="tray rise rise-2">
    <div class="core" style="padding:0;overflow:hidden">
        <div class="panel-head" style="border-bottom:1px solid var(--line-soft)">
            <div style="display:flex;align-items:center;gap:8px">
                <i data-lucide="folder-tree" style="color:#0284c7"></i>
                <span style="font-weight:700">Company Directory Tree</span>
            </div>
            <span class="meta">@(dirGroupsLoading ? "Loading..." : $"{dirGroups.Length} directory groups")</span>
            @if (Auth.IsAdmin)
            {
                <button class="btn btn-sm" style="margin-left:auto;background:#0284c7;color:#fff;border:none;padding:7px 14px;border-radius:8px;font-weight:600" @onclick="() => OpenGroupEditor(null)">
                    <i data-lucide="plus" style="width:13px;height:13px"></i> Add Group
                </button>
            }
        </div>
        @if (dirGroupsLoading)
        {
            <div style="padding:14px"><div class="skel"></div></div>
        }
        else if (dirGroups.Length == 0)
        {
            <div class="tree-empty" style="padding:28px">No directory groups yet.@(Auth.IsAdmin ? " Create a new group above." : "")</div>
        }
        else
        {
            <div class="tree">
                @RenderDirTree(dirGroups.Where(g => g.ParentId == null).OrderBy(g => g.SortOrder).ToArray(), 0)
            </div>
        }
    </div>
</div>

@if (groupEditor is not null)
{
    <div class="backdrop on" @onclick="CloseGroupEditor"></div>
    <div class="drawer on" role="dialog" aria-label="Edit group">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                @(groupEditor.IsCreate ? "New group" : $"Edit {groupEditor.Name}")
                <button class="drawer-close" @onclick="CloseGroupEditor"><i data-lucide="x"></i></button>
            </div>
            <div class="drawer-body">
                <div class="field"><label>Name</label><input @bind="groupEditor.Name" placeholder="e.g. Engineering" /></div>
                <div class="field">
                    <label>Parent group</label>
                    <AppSelect Label="Parent" Value="@groupEditor.ParentIdString" ValueChanged="v => groupEditor.ParentIdString = v"
                               Options="@GroupParentOptions(groupEditor.Id)" />
                </div>
                @if (groupEditor.Error is not null)
                {
                    <div class="note err"><i data-lucide="alert-circle"></i><span>@groupEditor.Error</span></div>
                }
                @if (!groupEditor.IsCreate && groupEditor.Members.Length > 0)
                {
                    <div class="field">
                        <label>Members (@groupEditor.Members.Length)</label>
                        <div class="member-list">
                            @foreach (var m in groupEditor.Members)
                            {
                                <div class="member-row">
                                    <span>@m.Name <span class="mono" style="opacity:0.6">@m.Nik</span></span>
                                    <button class="org-act" title="Remove member" @onclick="() => RemoveMember(groupEditor, m.Nik)"><i data-lucide="x"></i></button>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="field">
                    <label>Add member</label>
                    <AppMemberPicker Placeholder="Search by name or NIK..." ValueChanged="r => OnPickMember(r)" />
                </div>
                @if (!groupEditor.IsCreate)
                {
                    <button class="btn" style="margin-top:14px;width:100%;background:var(--danger-soft);color:var(--danger);border:1px solid var(--danger-soft)" @onclick="() => DeleteGroup(groupEditor)">
                        Delete group
                    </button>
                }
                <button class="btn" style="margin-top:14px;width:100%" disabled="@groupEditor.Saving" @onclick="SaveGroup">
                    @(groupEditor.Saving ? "Saving..." : groupEditor.IsCreate ? "Create group" : "Save changes")
                    <span class="orb"><i data-lucide="check"></i></span>
                </button>
            </div>
        </div></div>
    </div>
}

<ProfileDrawer Person="selectedDirMember" OnClose="() => selectedDirMember = null" />

@code {
    private DirGroupDto[] dirGroups = [];
    private bool dirGroupsLoading = true;
    private GroupEditorState? groupEditor;
    private Employee? selectedDirMember;
    private Guid? DragGroupId;
    private Guid? DragTarget;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    public async Task Reload()
    {
        dirGroupsLoading = true;
        dirGroups = await Auth.GetAsync<DirGroupDto[]>("/api/directory/dir-groups") ?? [];
        dirGroupsLoading = false;
        StateHasChanged();
    }

    private static Employee MapMember(DirGroupMemberDto m) => new(
        m.Name, m.Position ?? "—", m.Nik, "—", m.Department ?? "—", m.Department ?? "—", null,
        m.Site ?? "—", null, "—", null, m.Status,
        AvatarPalette.For(m.Nik), null);

    private RenderFragment RenderDirTree(DirGroupDto[] nodes, int depth) => builder =>
    {
        foreach (var g in nodes)
        {
            var children = dirGroups.Where(x => x.ParentId == g.Id).OrderBy(x => x.SortOrder).ToArray();
            var hasChildren = children.Length > 0;
            var key = g.Id.ToString("N");

            builder.OpenElement(0, "details");
            if (hasChildren) builder.AddAttribute(1, "open", true);
            builder.AddAttribute(2, "data-group-id", key);

            builder.OpenElement(3, "summary");
            builder.AddAttribute(4, "class", DragTarget == g.Id ? "drag-over" : "");
            builder.AddAttribute(5, "ondragover", EventCallback.Factory.Create<DragEventArgs>(this, e => OnGroupDragOver(e, g)));
            builder.AddAttribute(6, "ondragover:preventDefault", true);
            builder.AddAttribute(7, "ondrop", EventCallback.Factory.Create<DragEventArgs>(this, e => OnGroupDrop(e, g)));
            if (hasChildren)
            {
                builder.OpenElement(6, "i");
                builder.AddAttribute(7, "data-lucide", "chevron-right");
                builder.AddAttribute(8, "class", "chev");
                builder.CloseElement();
            }
            builder.AddContent(9, $" {g.Name}");
            builder.AddContent(10, (MarkupString)$"<span class=\"meta\" style=\"margin-left:8px;font-size:10.5px\">{g.Members.Length} members</span>");
            if (Auth.IsAdmin)
            {
                builder.OpenElement(11, "span");
                builder.AddAttribute(12, "class", "tree-actions");
                builder.AddAttribute(13, "onclick", EventCallback.Factory.Create(this, e => { }));
                builder.OpenElement(14, "button");
                builder.AddAttribute(15, "type", "button");
                builder.AddAttribute(16, "class", "org-act");
                builder.AddAttribute(17, "title", "Edit group");
                builder.AddAttribute(18, "onclick", EventCallback.Factory.Create(this, () => OpenGroupEditor(g)));
                builder.AddAttribute(19, "onclick:stopPropagation", true);
                builder.AddAttribute(20, "onmousedown:preventDefault", true);
                builder.OpenElement(21, "i");
                builder.AddAttribute(21, "data-lucide", "pencil");
                builder.CloseElement();
                builder.CloseElement();
                builder.OpenElement(22, "button");
                builder.AddAttribute(23, "type", "button");
                builder.AddAttribute(24, "class", "org-act");
                builder.AddAttribute(25, "title", "Drag to move");
                builder.AddAttribute(26, "draggable", "true");
                builder.AddAttribute(27, "ondragstart", EventCallback.Factory.Create<DragEventArgs>(this, e => OnGroupDragStart(e, g)));
                builder.AddAttribute(28, "ondragend", EventCallback.Factory.Create<DragEventArgs>(this, e => OnGroupDragEnd()));
                builder.AddAttribute(29, "onclick", EventCallback.Factory.Create(this, e => { }));
                builder.AddAttribute(30, "onmousedown:preventDefault", true);
                builder.OpenElement(31, "i");
                builder.AddAttribute(32, "data-lucide", "grip-vertical");
                builder.CloseElement();
                builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();

            builder.OpenElement(33, "div");
            builder.AddAttribute(34, "class", "children");

            foreach (var m in g.Members)
            {
                var emp = MapMember(m);
                builder.OpenElement(35, "div");
                builder.AddAttribute(36, "class", "emp-card");
                builder.AddAttribute(37, "tabindex", "0");
                builder.AddAttribute(38, "role", "button");
                builder.AddAttribute(39, "onclick", EventCallback.Factory.Create(this, () => selectedDirMember = emp));
                builder.AddAttribute(40, "aria-label", $"View profile of {m.Name}");
                builder.AddContent(41, (MarkupString)$"<div class=\"top\"><div class=\"avatar\" style=\"background:{emp.Color}\">{emp.Initials}</div><div><div class=\"n\">{m.Name}</div><div class=\"p\">{m.Position ?? "—"}</div></div></div>");
                builder.AddContent(42, (MarkupString)$"<div class=\"foot\"><span class=\"mono\">ID {m.Nik}</span><span class=\"dot {m.Status}\">{m.Status switch { "on" => "Online", "away" => "Away", "busy" => "Busy", _ => "Offline" }}</span></div>");
                builder.CloseElement();
            }

            if (hasChildren) builder.AddContent(43, RenderDirTree(children, depth + 1));
            builder.CloseElement();
            builder.CloseElement();
        }
    };

    private void OnGroupDragStart(DragEventArgs e, DirGroupDto g) { DragGroupId = g.Id; DragTarget = null; StateHasChanged(); }
    private void OnGroupDragEnd() { DragGroupId = null; DragTarget = null; StateHasChanged(); }
    private void OnGroupDragOver(DragEventArgs e, DirGroupDto g)
    {
        if (DragGroupId is { } id && id != g.Id && DragTarget != g.Id) { DragTarget = g.Id; StateHasChanged(); }
    }
    private Task OnGroupDrop(DragEventArgs e, DirGroupDto g) => MoveGroup(g.Id, DragGroupId);
    private async Task MoveGroup(Guid targetId, Guid? draggedId)
    {
        if (draggedId is null || draggedId == targetId) return;
        DragGroupId = null; DragTarget = null;
        var res = await Auth.SendAsync(HttpMethod.Patch, $"/api/admin/dir-groups/{draggedId.Value}", new UpsertDirGroupRequest(null, targetId, null, null));
        if (res.IsSuccessStatusCode) await Reload();
    }

    private List<AppOption> GroupParentOptions(Guid selfId) =>
        [new("", "(root)"), .. dirGroups.Where(x => x.Id != selfId).OrderBy(x => x.Name).Select(g => new AppOption(g.Id.ToString(), g.Name))];

    private void OpenGroupEditor(DirGroupDto? g)
    {
        groupEditor = new GroupEditorState
        {
            IsCreate = g is null,
            Id = g?.Id ?? Guid.Empty,
            Name = g?.Name ?? "",
            ParentIdString = g?.ParentId?.ToString() ?? "",
            Members = g?.Members.Select(m => new AdminDirGroupMemberDto(m.Nik, m.Name, m.Position, m.Department, m.Site)).ToArray() ?? [],
        };
        StateHasChanged();
    }

    private void CloseGroupEditor() => groupEditor = null;

    private async Task SaveGroup()
    {
        if (groupEditor is null) return;
        groupEditor.Saving = true; groupEditor.Error = null;
        Guid? parent = Guid.TryParse(groupEditor.ParentIdString, out var p) ? p : null;
        var url = groupEditor.IsCreate ? "/api/admin/dir-groups" : $"/api/admin/dir-groups/{groupEditor.Id}";
        var method = groupEditor.IsCreate ? HttpMethod.Post : HttpMethod.Patch;
        var res = await Auth.SendAsync(method, url, new UpsertDirGroupRequest(groupEditor.Name, parent, null, null));
        if (!res.IsSuccessStatusCode) { groupEditor.Error = "Could not save the group."; groupEditor.Saving = false; StateHasChanged(); return; }
        groupEditor.Saving = false;
        CloseGroupEditor();
        await Reload();
    }

    private async Task DeleteGroup(GroupEditorState g)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete \"{g.Name}\"? Its sub-groups are moved up one level.");
        if (!ok) return;
        g.Saving = true; g.Error = null;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/admin/dir-groups/{g.Id}", null);
        if (!res.IsSuccessStatusCode) { g.Error = "Could not delete the group."; g.Saving = false; StateHasChanged(); return; }
        g.Saving = false;
        CloseGroupEditor();
        await Reload();
    }

    private async Task RemoveMember(GroupEditorState g, string nik)
    {
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/admin/dir-groups/{g.Id}/members/{Uri.EscapeDataString(nik)}", null);
        if (res.IsSuccessStatusCode) await RefreshGroupMembers(g);
        else { g.Error = "Could not remove member."; StateHasChanged(); }
    }

    private async Task RefreshGroupMembers(GroupEditorState g)
    {
        var groups = await Auth.GetAsync<AdminDirGroupRowDto[]>("/api/admin/dir-groups") ?? [];
        var updated = groups.FirstOrDefault(x => x.Id == g.Id);
        if (updated is not null) g.Members = updated.Members;
        StateHasChanged();
    }

    private async Task OnPickMember(MemberSearchRow r)
    {
        if (groupEditor is not null)
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/admin/dir-groups/{groupEditor.Id}/members/by-name", new DirGroupMemberRequest(r.Name));
            if (res.IsSuccessStatusCode) await RefreshGroupMembers(groupEditor);
            else groupEditor.Error = "Could not add that person.";
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void CloseAllDrawers()
    {
        groupEditor = null;
        selectedDirMember = null;
        StateHasChanged();
    }

    private sealed class GroupEditorState
    {
        public bool IsCreate, Saving;
        public Guid Id;
        public string Name = "", ParentIdString = "";
        public string? Error;
        public AdminDirGroupMemberDto[] Members = [];
    }
}
