@* Directory tree — a read-only view of Plant ▸ Division ▸ Department built from the Organization
   data. "Add unit" and edits open the same department modal the Organization tab uses.
   (The old free-form DirGroup editor is retired from the UI; its rows are left untouched.) *@
@inject AuthState Auth
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="adm-tree-layout">
    <div class="adm-card adm-tree-card">
        <div class="adm-card-head">
            <span class="adm-card-title">PT Santos Jaya Abadi</span>
            <span class="adm-tree-links">
                <button type="button" class="adm-link" @onclick="ExpandAll">Expand all</button> ·
                <button type="button" class="adm-link" @onclick="CollapseAll">Collapse</button>
            </span>
        </div>
        @if (loadError)
        {
            <div class="adm-empty">Could not load the organization. <button type="button" class="adm-link" @onclick="Reload">Retry</button></div>
        }
        else if (org is null)
        {
            <div style="padding:14px"><div class="skel"></div></div>
        }
        else
        {
            <div class="adm-tree" role="tree">
                @foreach (var plant in Tree)
                {
                    var pKey = "p:" + plant.Code;
                    <button type="button" role="treeitem" class="adm-tnode lvl0 @(sel == pKey ? "on" : "")" aria-expanded="@(open.Contains(pKey) ? "true" : "false")"
                            @onclick="() => Select(pKey, true)">
                        <i data-lucide="@(open.Contains(pKey) ? "chevron-down" : "chevron-right")" class="adm-chev"></i>
                        <i data-lucide="factory"></i><span class="lbl">@plant.Name</span><span class="adm-tn">@plant.Count</span>
                    </button>
                    @if (open.Contains(pKey))
                    {
                        @foreach (var div in plant.Divisions)
                        {
                            var dKey = $"d:{plant.Code}|{div.Code}";
                            <button type="button" role="treeitem" class="adm-tnode lvl1 @(sel == dKey ? "on" : "")" aria-expanded="@(open.Contains(dKey) ? "true" : "false")"
                                    @onclick="() => Select(dKey, true)">
                                <i data-lucide="@(open.Contains(dKey) ? "chevron-down" : "chevron-right")" class="adm-chev"></i>
                                <i data-lucide="layers"></i><span class="lbl">@div.Name</span><span class="adm-tn">@div.Count</span>
                            </button>
                            @if (open.Contains(dKey))
                            {
                                @foreach (var dept in div.Departments)
                                {
                                    var tKey = "t:" + dept.Code;
                                    <button type="button" role="treeitem" class="adm-tnode lvl2 @(sel == tKey ? "on" : "")" @onclick="() => Select(tKey, false)">
                                        <i data-lucide="folder"></i><span class="lbl">@dept.Name</span><span class="adm-tn">@dept.ActiveMemberCount</span>
                                    </button>
                                }
                            }
                        }
                    }
                }
                @if (Tree.Count == 0)
                {
                    <div class="adm-empty">No units yet. Build the structure in the Organization tab.</div>
                }
            </div>
        }
    </div>

    <div class="adm-card adm-tree-detail">
        @if (Current is { } c)
        {
            <div class="adm-detail-head">
                <div>
                    <div class="adm-detail-title">@c.Label</div>
                    <div class="adm-cell-sub">@c.Count.ToString("N0") employees · @c.Departments.Count departments</div>
                </div>
                @if (c.Single is { } one)
                {
                    <button type="button" class="adm-btn ghost" @onclick="() => editing = one"><i data-lucide="pencil"></i> Edit</button>
                }
                else
                {
                    <button type="button" class="adm-btn primary" @onclick="() => creating = true"><i data-lucide="plus"></i> Add unit</button>
                }
            </div>
            @if (c.Single is null)
            {
                <div class="adm-dept-list">
                    @foreach (var d in c.Departments)
                    {
                        <button type="button" class="adm-dept-item" @onclick='() => Select("t:" + d.Code, false)'>
                            <i data-lucide="folder" class="adm-folder"></i>
                            <span class="adm-dept-item-name">@d.Name
                                <small>@(d.HeadName is null ? "No head assigned" : $"Head: {d.HeadName}")</small>
                            </span>
                            <span class="adm-cell-n">@d.ActiveMemberCount</span>
                        </button>
                    }
                    @if (c.Departments.Count == 0)
                    {
                        <div class="adm-empty">No departments here yet.</div>
                    }
                </div>
            }
            else
            {
                <div class="adm-dept-facts">
                    <div><span>Division</span><b>@(c.Single.DepartmentName ?? "—")</b></div>
                    <div><span>Plant</span><b>@(c.Single.SiteName ?? "—")</b></div>
                    <div><span>Head</span><b>@(c.Single.HeadName ?? "Not assigned")</b></div>
                </div>
            }
            <div class="adm-section-label">People in this unit @(people.Length < c.Count ? "(sample)" : "")</div>
            <div class="adm-people">
                @foreach (var p in people)
                {
                    <div class="adm-person" @key="p.Nik">
                        <span class="adm-av" style="background:@AvatarPalette.For(p.Nik)">@AdminOrgModel.Initials(p.Name)</span>
                        <span><b>@p.Name</b><small>@(p.Position ?? p.Nik)</small></span>
                    </div>
                }
                @if (people.Length == 0)
                {
                    <div class="adm-cell-sub">No one assigned yet — set a person's department in the Users tab.</div>
                }
            </div>
            @if (c.Count > people.Length)
            {
                <button type="button" class="adm-link" style="margin-top:10px" @onclick='() => Nav.NavigateTo("/directory")'>Open in Directory →</button>
            }
        }
        else
        {
            <div class="adm-empty">Select a plant, division or department.</div>
        }
    </div>
</div>

@if (org is not null && (creating || editing is not null) && Current is { } cur)
{
    <AdminDeptModal Org="org" Existing="editing" PresetPlantCode="@cur.PlantCode" PresetDivisionCode="@cur.DivisionCode"
                    OnClose="CloseModal" OnSaved="OnSaved" />
}

@code {
    /// Department code to select on first load (from Organization's "View in directory tree").
    [Parameter] public string? InitialDepartmentCode { get; set; }

    private AdminOrgModel? org;
    private bool loadError, creating;
    private AdminDivisionRowDto? editing;
    private string? sel;
    private readonly HashSet<string> open = [];
    private AdminUserRowDto[] people = [];
    private List<PlantNode> Tree = [];

    private sealed record PlantNode(string Code, string Name, int Count, List<DivisionNode> Divisions);
    private sealed record DivisionNode(string Code, string Name, int Count, List<AdminDivisionRowDto> Departments);
    private sealed record Selection(string Label, int Count, List<AdminDivisionRowDto> Departments,
        AdminDivisionRowDto? Single, string? PlantCode, string? DivisionCode, string UsersFilter);

    private Selection? Current => Resolve(sel);

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        if (InitialDepartmentCode is { } code && org?.Departments.FirstOrDefault(d => d.Code == code) is { } d)
        {
            open.Add("p:" + (d.SiteCode ?? ""));
            open.Add($"d:{d.SiteCode ?? ""}|{d.DepartmentCode ?? ""}");
            await Select("t:" + code, false);
        }
        else if (Tree.Count > 0)
        {
            open.Add("p:" + Tree[0].Code);
            await Select("p:" + Tree[0].Code, false);
        }
    }

    public async Task Reload()
    {
        var m = await AdminOrgModel.LoadAsync(Auth);
        loadError = m is null;
        if (m is not null)
        {
            org = m;
            Tree = Build(m);
            await LoadPeople();
        }
        StateHasChanged();
    }

    public void CloseAllDrawers() => StateHasChanged();

    private static List<PlantNode> Build(AdminOrgModel m)
    {
        var plantNames = m.Plants.ToDictionary(p => p.Code, p => p.Name);
        var divNames = m.Divisions.ToDictionary(d => d.Code, d => d.Name);
        return m.ActiveDepartments
            .GroupBy(d => d.SiteCode ?? "")
            .OrderBy(g => g.Key == "" ? 1 : 0).ThenBy(g => plantNames.GetValueOrDefault(g.Key, g.Key))
            .Select(pg => new PlantNode(pg.Key, pg.Key == "" ? "No plant" : plantNames.GetValueOrDefault(pg.Key, pg.Key),
                pg.Sum(d => d.ActiveMemberCount),
                pg.GroupBy(d => d.DepartmentCode ?? "")
                    .OrderBy(g => g.Key == "" ? 1 : 0).ThenBy(g => divNames.GetValueOrDefault(g.Key, g.Key))
                    .Select(dg => new DivisionNode(dg.Key, dg.Key == "" ? "No division" : divNames.GetValueOrDefault(dg.Key, dg.Key),
                        dg.Sum(d => d.ActiveMemberCount), dg.OrderBy(d => d.Name).ToList()))
                    .ToList()))
            .ToList();
    }

    private Selection? Resolve(string? key)
    {
        if (key is null || org is null) return null;
        if (key.StartsWith("p:"))
        {
            var p = Tree.FirstOrDefault(x => "p:" + x.Code == key);
            if (p is null) return null;
            return new Selection(p.Name, p.Count, p.Divisions.SelectMany(d => d.Departments).ToList(), null,
                p.Code == "" ? null : p.Code, null, p.Code == "" ? "" : $"siteCode={Uri.EscapeDataString(p.Code)}");
        }
        if (key.StartsWith("d:"))
        {
            var parts = key[2..].Split('|');
            var p = Tree.FirstOrDefault(x => x.Code == parts[0]);
            var d = p?.Divisions.FirstOrDefault(x => x.Code == parts[1]);
            if (p is null || d is null) return null;
            // Users only link to the Department entity (our "Division") and Site, so filter by both.
            var filter = string.Join("&", new[]
            {
                d.Code == "" ? null : $"departmentCode={Uri.EscapeDataString(d.Code)}",
                p.Code == "" ? null : $"siteCode={Uri.EscapeDataString(p.Code)}"
            }.Where(x => x is not null));
            return new Selection(d.Name, d.Count, d.Departments, null, p.Code == "" ? null : p.Code, d.Code == "" ? null : d.Code, filter);
        }
        var dept = org.Departments.FirstOrDefault(x => "t:" + x.Code == key);
        return dept is null ? null
            : new Selection(dept.Name, dept.ActiveMemberCount, [dept], dept, dept.SiteCode, dept.DepartmentCode,
                $"divisionCode={Uri.EscapeDataString(dept.Code)}");
    }

    private async Task Select(string key, bool toggle)
    {
        if (toggle)
        {
            if (sel == key && !open.Remove(key)) open.Add(key);
            else if (sel != key) open.Add(key);
        }
        sel = key;
        await LoadPeople();
    }

    private async Task LoadPeople()
    {
        var c = Current;
        if (c is null || c.UsersFilter == "") { people = []; return; }
        var res = await Auth.GetAsync<AdminUserPageDto>($"/api/admin/users?pageSize=8&active=true&{c.UsersFilter}");
        people = res?.Items ?? [];
        StateHasChanged();
    }

    private void ExpandAll()
    {
        foreach (var p in Tree)
        {
            open.Add("p:" + p.Code);
            foreach (var d in p.Divisions) open.Add($"d:{p.Code}|{d.Code}");
        }
    }

    private void CollapseAll() => open.Clear();

    private void CloseModal()
    {
        creating = false;
        editing = null;
    }

    private async Task OnSaved()
    {
        CloseModal();
        await Reload();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
}
