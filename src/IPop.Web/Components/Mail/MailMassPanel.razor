@using IPop.Web.Services
@inject IPop.Web.Services.MailService MailSvc
@inject IJSRuntime JS

@* Mass mail in the reading pane. Recipients get a banner explaining why Reply all is off;
   the sender gets sent/delivered/read counts with a paged read / not-read list (50 a page)
   and the inactive people who were skipped. Nothing here loads every recipient at once. *@
@if (!IsSender)
{
    if (Detail.IsMass || Detail.HideRecipients)
    {
        <div class="mm-banner" role="note">
            <i data-lucide="info"></i>
            <span>
                @if (Detail.HideRecipients)
                {
                    <text>The recipient list of this mail is hidden. Replies go to <b>@Detail.SenderName only</b>.</text>
                }
                else
                {
                    <text>This was sent to <b>@Detail.RecipientTotal.ToString("N0") @(Detail.RecipientTotal == 1 ? "person" : "people")</b>. To avoid flooding inboxes, replies go to <b>@Detail.SenderName only</b>.</text>
                }
            </span>
        </div>
    }
}
else if (stats is { } s)
{
    var unread = Math.Max(0, s.Sent - s.Read);
    var readPct = s.Sent == 0 ? 0 : s.Read * 100.0 / s.Sent;
    <section class="mm-stats" aria-label="Delivery and read statistics">
        <div class="mm-stats-h">
            <div><b>@s.Sent.ToString("N0")</b>sent</div>
            <div><b>@s.Delivered.ToString("N0")</b>delivered</div>
            <div><b>@s.Read.ToString("N0")</b>read</div>
            <div><b>@unread.ToString("N0")</b>not yet read</div>
        </div>
        <div class="mm-bar" role="img" aria-label="@($"{readPct:0}% read")">
            <i style="width:@(readPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i>
        </div>
        <div class="mm-tabs" role="tablist">
            <button type="button" role="tab" class="@(showRead ? "on" : "")" aria-selected="@(showRead ? "true" : "false")" @onclick="() => SetTab(true)">Read (@s.Read.ToString("N0"))</button>
            <button type="button" role="tab" class="@(!showRead ? "on" : "")" aria-selected="@(!showRead ? "true" : "false")" @onclick="() => SetTab(false)">Not read (@unread.ToString("N0"))</button>
        </div>
        <div class="mm-list" role="list">
            @if (readers is null)
            {
                <div class="mm-empty">Loading…</div>
            }
            else if (readers.Items.Count == 0)
            {
                <div class="mm-empty">@(showRead ? "Nobody has read it yet." : "Everyone has read it.")</div>
            }
            else
            {
                @foreach (var r in readers.Items)
                {
                    <div class="mm-row" role="listitem">
                        <PersonAvatar Nik="@r.Nik" Name="@r.Name" Size="24" Decorative="true" />
                        <span class="nm">@r.Name</span>
                        @if (r.ReadAt is { } at) { <small>Read @Stamp(at)</small> }
                    </div>
                }
            }
        </div>
        @if (readers is { } pg && pg.TotalCount > PageSize)
        {
            var from = (pg.Page - 1) * PageSize + 1;
            var to = Math.Min(pg.TotalCount, pg.Page * PageSize);
            <div class="mm-pager">
                <span>@from.ToString("N0")–@to.ToString("N0") of @pg.TotalCount.ToString("N0")</span>
                <span>
                    <button type="button" class="mm-link muted" disabled="@(pg.Page <= 1 || busy)" @onclick="() => LoadPageAsync(pg.Page - 1)">‹ Prev</button>
                    <button type="button" class="mm-link" disabled="@(to >= pg.TotalCount || busy)" @onclick="() => LoadPageAsync(pg.Page + 1)">Next ›</button>
                </span>
            </div>
        }
    </section>
    @if (s.Skipped.Count > 0)
    {
        <div class="mm-skip" role="note">
            <i data-lucide="user-x"></i>
            <span><b>@s.Skipped.Count @(s.Skipped.Count == 1 ? "person was" : "people were") skipped</b> because their accounts are inactive:
                @string.Join(", ", s.Skipped.Take(20).Select(x => x.Name))@(s.Skipped.Count > 20 ? $" and {s.Skipped.Count - 20} more" : "").</span>
        </div>
    }
}

@code {
    private const int PageSize = 50;

    [Parameter, EditorRequired] public MailDetail Detail { get; set; } = default!;
    /// The signed-in user sent this mail (stats are sender-only on the server too).
    [Parameter] public bool IsSender { get; set; }

    private Guid loadedFor;
    private MailStats? stats;
    private MailPaged<MailReader>? readers;
    private bool showRead = true;
    private bool busy;

    /// Stats only matter for big mail; ordinary sent mail keeps its per-person receipts.
    private bool WantsStats => IsSender && Detail.IsMass && Detail.SentAt is not null;

    protected override async Task OnParametersSetAsync()
    {
        if (!WantsStats) { stats = null; readers = null; loadedFor = Guid.Empty; return; }
        if (loadedFor == Detail.Id) return;
        loadedFor = Detail.Id;
        stats = null;
        readers = null;
        showRead = true;
        var id = Detail.Id;
        var s = await MailSvc.GetStatsAsync(id);
        if (loadedFor != id) return;
        stats = s;
        // Open on the tab that has people in it.
        if (s is not null && s.Read == 0) showRead = false;
        await LoadPageAsync(1);
    }

    private async Task SetTab(bool read)
    {
        if (showRead == read) return;
        showRead = read;
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        var id = Detail.Id;
        var read = showRead;
        busy = true;
        readers = page == 1 ? null : readers;
        try
        {
            var res = await MailSvc.GetReadersAsync(id, read, page);
            if (id != Detail.Id || read != showRead) return;
            readers = res ?? new MailPaged<MailReader>([], 0, page, PageSize);
        }
        finally { busy = false; }
    }

    private static string Stamp(DateTime t)
    {
        var local = t.ToLocalTime();
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM HH:mm");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }
}
