@using IPop.Web.Services
@inject IPop.Web.Services.MailService MailSvc
@inject IJSRuntime JS
@inject IPop.Web.Services.MailReceiptsStore Store
@inject HttpClient Http
@implements IDisposable

@* Mass mail in the reading pane. Recipients get a banner explaining why Reply all is off;
   the sender gets sent/delivered/read counts (read = really seen, from /receipts) with a read / not-read list (50 a page)
   and the inactive people who were skipped. Nothing here loads every recipient at once. *@
@if (!IsSender)
{
    if (Detail.IsMass || Detail.HideRecipients)
    {
        <div class="mm-banner" role="note">
            <i data-lucide="info"></i>
            <span>
                @if (Detail.HideRecipients)
                {
                    <text>The recipient list of this mail is hidden. Replies go to <b>@Detail.SenderName only</b>.</text>
                }
                else
                {
                    <text>This was sent to <b>@Detail.RecipientTotal.ToString("N0") @(Detail.RecipientTotal == 1 ? "person" : "people")</b>. To avoid flooding inboxes, replies go to <b>@Detail.SenderName only</b>.</text>
                }
            </span>
        </div>
    }
}
else if (rc is { } r)
{
    var unread = Math.Max(0, r.Total - r.Read);
    var readPct = r.Total == 0 ? 0 : r.Read * 100.0 / r.Total;
    var list = r.People.Where(p => (p.SeenAt is not null) == showRead)
        .OrderBy(p => showRead ? p.SeenAt : null).ThenBy(p => p.Name, StringComparer.OrdinalIgnoreCase).ToList();
    var pages = Math.Max(1, (list.Count + PageSize - 1) / PageSize);
    var pg = Math.Clamp(page, 1, pages);
    <section class="mm-stats" aria-label="Delivery and read statistics">
        <div class="mm-stats-h">
            <div><b>@N(r.Total)</b>sent</div>
            <div><b>@N(r.Delivered)</b>delivered</div>
            <div><b>@N(r.Read)</b>read</div>
            <div><b>@N(unread)</b>not yet read</div>
        </div>
        <div class="mm-bar" role="img" aria-label="@($"{readPct:0}% read")">
            <i style="width:@(readPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></i>
        </div>
        @if (!r.Tracked)
        {
            <div class="mm-empty">Read status is not tracked for mail sent before @(r.TrackedSince?.ToLocalTime().ToString("d MMM yyyy") ?? "receipts started").</div>
        }
        <div class="mm-tabs" role="tablist">
            <button type="button" role="tab" class="@(showRead ? "on" : "")" aria-selected="@(showRead ? "true" : "false")" @onclick="() => SetTab(true)">Read (@N(r.Read))</button>
            <button type="button" role="tab" class="@(!showRead ? "on" : "")" aria-selected="@(!showRead ? "true" : "false")" @onclick="() => SetTab(false)">Not read (@N(unread))</button>
        </div>
        <div class="mm-list" role="list">
            @if (list.Count == 0)
            {
                <div class="mm-empty">@(showRead ? "Nobody has read it yet." : "Everyone has read it.")</div>
            }
            else
            {
                @foreach (var p in list.Skip((pg - 1) * PageSize).Take(PageSize))
                {
                    <div class="mm-row" role="listitem">
                        <PersonAvatar Nik="@p.UserKey" Name="@MailReceiptView.TitleCase(p.Name)" Photo="@PhotoUrl(p.PhotoId)" Size="24" Decorative="true" />
                        <span class="nm">@MailReceiptView.TitleCase(p.Name)</span>
                        @if (p.SeenAt is { } at) { <small>Read @Stamp(at)</small> }
                        else if (!p.Delivered) { <small>Not delivered</small> }
                    </div>
                }
            }
        </div>
        @if (list.Count > PageSize)
        {
            var from = (pg - 1) * PageSize + 1;
            var to = Math.Min(list.Count, pg * PageSize);
            <div class="mm-pager">
                <span>@N(from)–@N(to) of @N(list.Count)</span>
                <span>
                    <button type="button" class="mm-link muted" disabled="@(pg <= 1)" @onclick="() => page = pg - 1">‹ Prev</button>
                    <button type="button" class="mm-link" disabled="@(to >= list.Count)" @onclick="() => page = pg + 1">Next ›</button>
                </span>
            </div>
        }
    </section>
    @if (skipped.Count > 0)
    {
        <div class="mm-skip" role="note">
            <i data-lucide="user-x"></i>
            <span><b>@skipped.Count @(skipped.Count == 1 ? "person was" : "people were") skipped</b> because their accounts are inactive:
                @string.Join(", ", skipped.Take(20).Select(x => x.Name))@(skipped.Count > 20 ? $" and {skipped.Count - 20} more" : "").</span>
        </div>
    }
}

@code {
    private const int PageSize = 50;

    [Parameter, EditorRequired] public MailDetail Detail { get; set; } = default!;
    /// The signed-in user sent this mail (names are sender-only on the server too).
    [Parameter] public bool IsSender { get; set; }

    // Counts and names come from /receipts (SeenAt: the message was really seen), never from the recipients'
    // unread badge (IsRead/ReadAt). /stats is read only for the inactive accounts that were skipped.
    private Guid loadedFor;
    private MailReceipts? rc;
    private IReadOnlyList<SkippedRecipient> skipped = [];
    private bool showRead = true;
    private int page = 1;

    private static string N(int n) => n.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    /// Stats only matter for big mail; ordinary sent mail has the receipts row under its header.
    private bool WantsStats => IsSender && Detail.IsMass && Detail.SentAt is not null;

    protected override void OnInitialized() => Store.Changed += OnChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (!WantsStats) { rc = null; skipped = []; loadedFor = Guid.Empty; return; }
        if (loadedFor == Detail.Id) return;
        loadedFor = Detail.Id;
        rc = null;
        skipped = [];
        showRead = true;
        page = 1;
        var id = Detail.Id;
        var r = await Store.GetAsync(id);
        if (loadedFor != id) return;
        rc = r;
        // Open on the tab that has people in it.
        if (r is { Read: 0 }) showRead = false;
        var s = await MailSvc.GetStatsAsync(id);
        if (loadedFor == id && s is not null) skipped = s.Skipped;
    }

    private void OnChanged(Guid id)
    {
        if (id != loadedFor || id == Guid.Empty) return;
        _ = InvokeAsync(async () => { var r = await Store.GetAsync(id); if (id == loadedFor) { rc = r; StateHasChanged(); } });
    }

    private void SetTab(bool read)
    {
        if (showRead == read) return;
        showRead = read;
        page = 1;
    }

    private string? PhotoUrl(string? photoId)
        => string.IsNullOrEmpty(photoId) ? null : new Uri(Http.BaseAddress ?? new Uri("http://localhost/"), $"/api/photos/{Uri.EscapeDataString(photoId)}").ToString();

    private static string Stamp(DateTime t)
    {
        var local = t.ToLocalTime();
        return local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM HH:mm");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
