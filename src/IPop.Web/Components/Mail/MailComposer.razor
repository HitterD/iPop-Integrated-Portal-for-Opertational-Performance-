    /// Empty body → apply straight away; otherwise ask Replace vs Insert at cursor.
    private async Task PickTemplate(TemplateRow tpl)
    {
        if (IsBodyEmpty(body)) { await ApplyTemplate(tpl, replace: true); return; }
        pendingTemplate = tpl;
    }

    public static bool IsBodyEmpty(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return true;
        if (System.Text.RegularExpressions.Regex.IsMatch(html, "<(img|table|hr|iframe|video)\\b", System.Text.RegularExpressions.RegexOptions.IgnoreCase)) return false;
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "");
        text = System.Net.WebUtility.HtmlDecode(text).Replace(' ', ' ').Replace("​", "");
        return string.IsNullOrWhiteSpace(text);
    }

    private async Task ApplyTemplate(TemplateRow tpl, bool replace)
    {
        headPop = null;
        pendingTemplate = null;
        // Recipients are never touched; the subject only fills in when still blank.
        if (string.IsNullOrWhiteSpace(subject)) subject = tpl.Subject;
        if (replace)
        {
            body = tpl.Body;
            // Keeps undo history, so Ctrl+Z brings back what was there before the template.
            if (rteRef is not null) await rteRef.ReplaceHtml(tpl.Body);
        }
        else if (rteRef is not null)
        {
            // Goes in at the saved caret (undoable); the editor pushes the new body back via ValueChanged.
            await rteRef.InsertHtml(tpl.Body);
        }
        OnContentChanged();
    }

    private void CancelAutosave()
    {
        autosaveCts?.Cancel();
        autosaveCts?.Dispose();
        autosaveCts = null;
    }

    /// When the first change not yet in Drafts was made; null = everything is saved.
    private DateTime? dirtySince;
    /// Bumped on every open, so a save still in flight never writes its id into the next message.
    private int session;
    /// One save at a time: two concurrent first saves would create two drafts.
    private readonly SemaphoreSlim saveGate = new(1, 1);
    private bool dropBound;

    private void OnContentChanged()
    {
        if (!IsOpen || sending) return;
        dirtySince ??= DateTime.UtcNow;
        CancelAutosave();
        autosaveCts = new CancellationTokenSource();
        // 2 s after the last change, but never more than 20 s after the first unsaved one.
        var wait = TimeSpan.FromSeconds(2);
        var cap = dirtySince.Value.AddSeconds(20) - DateTime.UtcNow;
        if (cap < wait) wait = cap > TimeSpan.Zero ? cap : TimeSpan.Zero;
        _ = AutosaveDebouncedAsync(wait, autosaveCts.Token);
        _ = StashForUnloadAsync();
    }

    private MailSendRequest BuildRequest(DateTime? scheduledAt = null) => new(
        Subject: subject,
        Body: body,
        To: toRows.Select(r => r.Nik).ToList(),
        Cc: ccRows.Select(r => r.Nik).ToList(),
        Bcc: bccRows.Select(r => r.Nik).ToList(),
        AttachmentIds: composerAtts.Select(a => a.Id).ToList(),
        InReplyToId: inReplyToId,
        ThreadRootId: threadRootId,
        ScheduledAt: scheduledAt,
        Importance: importance,
        LabelIds: selectedLabelIds.Count > 0 ? selectedLabelIds.ToList() : null,
        ForwardAttachmentIds: IsForward ? forwardAtts.Select(a => a.Id).ToList() : null,
        DraftExtra: WriteExtras(),
        Groups: GroupCount > 0 ? GroupRefs() : null,
        HideRecipients: hideRecipients);

    private async Task AutosaveDebouncedAsync(TimeSpan wait, CancellationToken ct)
    {
        try { await Task.Delay(wait, ct); }
        catch (OperationCanceledException) { return; }
        await SaveDraftCoreAsync();
    }

    private async Task SaveNowAsync()
    {
        CancelAutosave();
        if (dirtySince is not null) await SaveDraftCoreAsync();
    }

    /// Saves the current message to Drafts. Everything is captured before the first await, so a
    /// save started just before the composer switches messages still saves the old one.
    private async Task SaveDraftCoreAsync()
    {
        var since = dirtySince;
        if (since is null) return;
        if (string.IsNullOrWhiteSpace(subject) && IsBodyEmpty(body) && toRows.Count + ccRows.Count + bccRows.Count + GroupCount == 0 && composerAtts.Count == 0)
        {
            dirtySince = null;
            return;
        }
        var req = BuildRequest();
        var sess = session;
        var id = editingDraftId;
        draftSaving = true;
        StateHasChanged();
        await saveGate.WaitAsync();
        try
        {
            // The HTTP calls are never cancelled: a POST dropped mid-flight may still have
            // created the draft, and the next save would then create a second one.
            if (sess == session && editingDraftId is { } current) id = current;
            var ok = false;
            if (id is { } draftId)
                ok = (await MailSvc.UpdateDraftAsync(draftId, req))?.Success == true;
            else if (await MailSvc.SaveDraftAsync(req) is { Success: true } res)
            {
                ok = true;
                if (sess == session) editingDraftId = res.MailId;
            }
            if (ok && sess == session)
            {
                if (dirtySince == since) { dirtySince = null; await ClearUnloadStashAsync(); }
                draftSavedAt = DateTime.Now;
            }
        }
        catch { /* stays dirty; the next change or leave retries */ }
        finally
        {
            saveGate.Release();
            if (sess == session) draftSaving = false;
            StateHasChanged();
        }
    }

    /// Waits for a save in flight (so a first save has its draft id before send/discard).
    private async Task WaitForSaveAsync()
    {
        await saveGate.WaitAsync();
        saveGate.Release();
    }

    /// Closing or reloading the tab gives no time for an await: JS keeps the latest unsaved
    /// request and sends it with fetch keepalive from beforeunload.
    private async Task StashForUnloadAsync()
    {
        try
        {
            var url = new Uri(Http.BaseAddress!, editingDraftId is { } id ? $"/api/mail/drafts/{id}" : "/api/mail/drafts").ToString();
            var json = System.Text.Json.JsonSerializer.Serialize(BuildRequest(), new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web));
            await JS.InvokeVoidAsync("ipop.mailDraftStash", url, editingDraftId is null ? "POST" : "PUT", json, Auth.AccessToken);
        }
        catch { }
    }

    private async Task ClearUnloadStashAsync()
    {
        try { await JS.InvokeVoidAsync("ipop.mailDraftStash", null, null, null, null); } catch { }
    }

    private async Task SendNow()
    {
        sendDropdownOpen = false;
        await DoSendAsync(null);
    }

    private async Task ScheduleSendPreset(int preset)
    {
        sendDropdownOpen = false;
        var tomorrow = DateTime.Today.AddDays(1);
        var targetTime = preset == 1 ? tomorrow.AddHours(8) : tomorrow.AddHours(13);
        await DoSendAsync(targetTime.ToUniversalTime());
    }

