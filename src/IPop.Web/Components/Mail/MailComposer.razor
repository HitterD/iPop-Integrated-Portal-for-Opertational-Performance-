    public void OpenDraft(MailDetail draft)
    {
        // Already open (e.g. the pill's draft clicked in the list): keep the local, newer copy.
        if (IsOpen && editingDraftId == draft.Id)
        {
            dockState = ComposerDockState.Docked;
            Show();
            return;
        }
        ResetState();
        editingDraftId = draft.Id;
        inReplyToId = draft.InReplyToId;
        threadRootId = draft.ThreadRootId;
        subject = draft.Subject ?? "";
        body = draft.Body ?? "";
        importance = draft.Importance ?? "normal";
        toRows = draft.Recipients.Where(r => r.RecipientType == "to").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        ccRows = draft.Recipients.Where(r => r.RecipientType == "cc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        bccRows = draft.Recipients.Where(r => r.RecipientType == "bcc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        toGroups = DraftGroups(draft, "to");
        ccGroups = DraftGroups(draft, "cc");
        bccGroups = DraftGroups(draft, "bcc");
        hideRecipients = draft.HideRecipients;
        showCc = ccRows.Count + ccGroups.Count > 0;
        showBcc = bccRows.Count + bccGroups.Count > 0;
        SchedulePreview();
        composerAtts = draft.Attachments.ToList();
        selectedLabelIds = draft.LabelIds.ToHashSet();
        if (ReadExtras(draft.DraftExtra) is { } x)
        {
            isMeeting = x.Meeting;
            if (x.Start is { } s) meetingStart = s;
            if (x.End is { } e) meetingEnd = e;
            meetingReminderMin = x.Reminder;
            meetingLocation = x.Location ?? "";
            forwardOfId = x.ForwardOf;
            forwardAtts = x.ForwardAtts ?? [];
        }
        Show();
    }

    /// Composer-only state a draft carries (the server stores it as-is).
    private sealed record DraftExtras(bool Meeting, DateTime? Start, DateTime? End, int Reminder, string? Location,
        Guid? ForwardOf, List<MailAttachment>? ForwardAtts);

    private string? WriteExtras() => !isMeeting && forwardOfId is null ? null
        : System.Text.Json.JsonSerializer.Serialize(new DraftExtras(isMeeting, isMeeting ? meetingStart : null, isMeeting ? meetingEnd : null,
            meetingReminderMin, isMeeting ? meetingLocation : null, forwardOfId, forwardOfId is null ? null : forwardAtts));

    private static DraftExtras? ReadExtras(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return System.Text.Json.JsonSerializer.Deserialize<DraftExtras>(json); }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private void Minimize() { headPop = null; dockState = ComposerDockState.Minimized; }
    private void Maximize() => dockState = ComposerDockState.Maximized;
    private void Restore() => dockState = ComposerDockState.Docked;

    private void OnHeadClick()
    {
        if (dockState == ComposerDockState.Minimized) Restore();
    }

    private void OnSheetKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || dockState == ComposerDockState.Minimized) return;
        // Esc first closes whichever menu is open; with none open it tucks the sheet away (nothing is lost).
        if (headPop is not null || sendDropdownOpen || attDropdownOpen)
        {
            headPop = null; sendDropdownOpen = false; attDropdownOpen = false;
            return;
        }
        if (rteRef?.ConsumeEscape() == true) return;
        Minimize();
    }

