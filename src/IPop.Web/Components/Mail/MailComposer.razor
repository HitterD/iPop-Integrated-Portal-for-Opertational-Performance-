    private void OnSheetKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || dockState == ComposerDockState.Minimized) return;
        // Esc first closes whichever menu is open; with none open it tucks the sheet away (nothing is lost).
        if (headPop is not null || sendDropdownOpen || attDropdownOpen)
        {
            headPop = null; sendDropdownOpen = false; attDropdownOpen = false;
            return;
        }
        if (rteRef?.ConsumeEscape() == true) return;
        Minimize();
    }

