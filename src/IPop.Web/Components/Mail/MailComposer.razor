@inject IJSRuntime JS
@inject IPop.Web.Services.MailService MailSvc
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.AuthState Auth
@using IPop.Web.Components
@using IPop.Web.Services
@implements IDisposable

@if (IsOpen)
{
    @if (dockState == ComposerDockState.Maximized)
    {
        <div class="composer-backdrop" @onclick="Restore"></div>
    }

    <div class="outlook-composer @GetStateClass()" role="dialog" aria-label="Mail Composer">
        @* Header *@
        <div class="composer-head" @onclick="OnHeadClick">
            <span class="title">
                <i data-lucide="mail"></i>
                @(string.IsNullOrWhiteSpace(subject) ? "New message" : subject)
            </span>
            <span class="draft-status">@(draftSaving ? "Saving draft…" : draftSaved ? "Draft saved" : "")</span>
            <div class="head-actions" @onclick:stopPropagation>
                @if (dockState == ComposerDockState.Minimized)
                {
                    <button class="icon-btn" title="Restore" aria-label="Restore" @onclick="Restore">
                        <i data-lucide="maximize-2"></i>
                    </button>
                }
                else
                {
                    <button class="icon-btn" title="Minimize" aria-label="Minimize" @onclick="Minimize">
                        <i data-lucide="minus"></i>
                    </button>
                    @if (dockState == ComposerDockState.Maximized)
                    {
                        <button class="icon-btn" title="Restore size" aria-label="Restore size" @onclick="Restore">
                            <i data-lucide="minimize-2"></i>
                        </button>
                    }
                    else
                    {
                        <button class="icon-btn" title="Maximize" aria-label="Maximize" @onclick="Maximize">
                            <i data-lucide="square"></i>
                        </button>
                    }
                }
                <button class="icon-btn" title="Close" aria-label="Close" @onclick="Close">
                    <i data-lucide="x"></i>
                </button>
            </div>
        </div>

        @* Body — drag-drop files zone (Phase 2) *@
        <div class="composer-body-wrap" @ref="dropZoneRef">
            <div class="composer-drop-hint">
                <i data-lucide="upload-cloud"></i> Drop files here to attach
            </div>
            <div class="recipients-block">
                @* To Row *@
                <div class="recipient-row">
                    <span class="recipient-label">To</span>
                    <div class="recipient-input-wrap">
                        <AppMemberPicker ValueChanged="OnToPick" Placeholder="Add recipients…" />
                        <div class="chips">
                            @foreach (var r in toRows)
                            {
                                <span class="chip">
                                    @r.Name
                                    <button type="button" class="chip-x" title="Remove" aria-label="Remove" @onclick="() => toRows.Remove(r)">
                                        <i data-lucide="x"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="cc-bcc-toggles">
                        @if (!showCc) { <button type="button" @onclick="() => showCc = true">Cc</button> }
                        @if (!showBcc) { <button type="button" @onclick="() => showBcc = true">Bcc</button> }
                    </div>
                </div>

                @* Cc Row *@
                @if (showCc)
                {
                    <div class="recipient-row">
                        <span class="recipient-label">Cc</span>
                        <div class="recipient-input-wrap">
                            <AppMemberPicker ValueChanged="OnCcPick" Placeholder="Add Cc recipients…" />
                            <div class="chips">
                                @foreach (var r in ccRows)
                                {
                                    <span class="chip">
                                        @r.Name
                                        <button type="button" class="chip-x" title="Remove" aria-label="Remove" @onclick="() => ccRows.Remove(r)">
                                            <i data-lucide="x"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* Bcc Row *@
                @if (showBcc)
                {
                    <div class="recipient-row">
                        <span class="recipient-label">Bcc</span>
                        <div class="recipient-input-wrap">
                            <AppMemberPicker ValueChanged="OnBccPick" Placeholder="Add Bcc recipients…" />
                            <div class="chips">
                                @foreach (var r in bccRows)
                                {
                                    <span class="chip">
                                        @r.Name
                                        <button type="button" class="chip-x" title="Remove" aria-label="Remove" @onclick="() => bccRows.Remove(r)">
                                            <i data-lucide="x"></i>
                                        </button>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Subject and Importance *@
            <div class="subject-row">
                <input type="text"
                       class="subject-input"
                       placeholder="Add a subject"
                       @bind="subject"
                       @bind:event="oninput"
                       @bind:after="OnContentChanged" />

                <select class="importance-select" @bind="importance" title="Message Importance">
                    <option value="normal">Normal Priority</option>
                    <option value="high">❗ High Importance</option>
                    <option value="low">↓ Low Importance</option>
                </select>
            </div>

            @* Template + mail label (Phase 2) — template populates subject+body; label for classification *@
            @if (templates.Count > 0 || labels.Count > 0)
            {
                <div class="composer-tpl-row">
                    @if (templates.Count > 0)
                    {
                        <i data-lucide="layout-template" style="width:13px;height:13px;color:var(--ink-3)"></i>
                        <select class="filter-select composer-tpl-select" value="" @onchange="ApplyTemplate" title="Use email template" aria-label="Use email template">
                            <option value="">Use template…</option>
                            @foreach (var tpl in templates)
                            {
                                <option value="@tpl.Name">@tpl.Name</option>
                            }
                        </select>
                    }
                    @if (labels.Count > 0)
                    {
                        <i data-lucide="tag" style="width:13px;height:13px;color:var(--ink-3)"></i>
                        <select class="filter-select composer-tpl-select" value="" @onchange="ApplyLabel" title="Tag with label" aria-label="Tag with label">
                            <option value="">Label…</option>
                            @foreach (var l in labels)
                            {
                                <option value="@l.Id">@l.Name</option>
                            }
                        </select>
                        @foreach (var lid in selectedLabelIds)
                        {
                            var lbl = labels.FirstOrDefault(x => x.Id == lid);
                            if (lbl is not null)
                            {
                                <span class="chip" style="background:@(lbl.Color ?? "var(--accent-soft)")">
                                    @lbl.Name
                                    <button type="button" class="chip-x" title="Remove" aria-label="Remove" @onclick="() => selectedLabelIds.Remove(lid)"><i data-lucide="x"></i></button>
                                </span>
                            }
                        }
                    }
                </div>
            }

            @* Attachments Tray — reorder up/down + delete *@
            @if (composerAtts.Count > 0)
            {
                <div class="composer-atts">
                    <div class="composer-atts-head">
                        <i data-lucide="paperclip"></i>
                        <span>@composerAtts.Count attachment@(composerAtts.Count == 1 ? "" : "s")</span>
                        <span class="meta" style="font-size:10.5px;color:var(--ink-3)">order used when sent</span>
                    </div>
                    @foreach (var (a, i) in composerAtts.Select((x, idx) => (x, idx)))
                    {
                        <span class="composer-att-chip">
                            <i data-lucide="paperclip"></i>
                            <span class="name">@a.FileName</span>
                            <span class="size">(@HumanSize(a.FileSize))</span>
                            <button type="button" class="act-mini" title="Move up" aria-label="Move up" disabled="@(i == 0)" @onclick="() => MoveAtt(a, -1)">
                                <i data-lucide="arrow-up"></i>
                            </button>
                            <button type="button" class="act-mini" title="Move down" aria-label="Move down" disabled="@(i == composerAtts.Count - 1)" @onclick="() => MoveAtt(a, 1)">
                                <i data-lucide="arrow-down"></i>
                            </button>
                            <button type="button" class="del-btn" title="Remove attachment" aria-label="Remove attachment" @onclick="() => RemoveAtt(a)">
                                <i data-lucide="x"></i>
                            </button>
                        </span>
                    }
                </div>
            }

            @* Meeting invitation (Phase 2) — schedule, location/link, reminder; sent as email *@
            <div class="composer-meeting-toggle">
                <label class="notif-pref-toggle" style="cursor:pointer">
                    <input type="checkbox" @bind="isMeeting" /> <i data-lucide="calendar-clock" style="width:13px;height:13px"></i> Turn into meeting invite
                </label>
            </div>
            @if (isMeeting)
            {
                <div class="composer-meeting">
                    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                        <label style="font-size:11.5px;color:var(--ink-3)">Start</label>
                        <input type="datetime-local" class="org-input" style="height:30px;font-size:12px" @bind="meetingStart" />
                        <label style="font-size:11.5px;color:var(--ink-3)">End</label>
                        <input type="datetime-local" class="org-input" style="height:30px;font-size:12px" @bind="meetingEnd" />
                        <label style="font-size:11.5px;color:var(--ink-3)">Reminder</label>
                        <select class="filter-select" style="height:30px;font-size:12px" @bind="meetingReminderMin">
                            <option value="10">10 minutes</option>
                            <option value="30">30 minutes</option>
                            <option value="60">1 hour</option>
                            <option value="1440">1 day</option>
                        </select>
                    </div>
                    <input class="org-input" style="height:30px;font-size:12px" placeholder="Meeting location or link…" @bind="meetingLocation" />
                    <div style="font-size:11px;color:var(--ink-3)">Attendees = email recipients (To/Cc). Meeting is created when email is sent.</div>
                </div>
            }

            @* Rich Text Editor *@
            <MailRteEditor @ref="rteRef" Value="@body" ValueChanged="OnBodyChanged" />
        </div>

        @* Footer & Actions *@
        <div class="composer-foot">
            @* Split Send Button *@
            <div class="split-send">
                <button type="button" class="send-main" @onclick="SendNow" disabled="@sending">
                    <i data-lucide="send"></i>
                    @(sending ? "Sending…" : "Send")
                </button>
                <button type="button" class="send-arrow" @onclick="() => sendDropdownOpen = !sendDropdownOpen" title="Send options" aria-label="Send options">
                    <i data-lucide="chevron-down"></i>
                </button>

                @* Dropdown for Schedule Send *@
                @if (sendDropdownOpen)
                {
                    <div class="send-dropdown" @onclick:stopPropagation>
                        <button type="button" class="send-dropdown-item" @onclick="SendNow">
                            <i data-lucide="send"></i>
                            <span>Send now</span>
                        </button>
                        <button type="button" class="send-dropdown-item" @onclick="() => ScheduleSendPreset(1)">
                            <i data-lucide="clock"></i>
                            <span>Tomorrow morning</span>
                            <span class="hint">08:00</span>
                        </button>
                        <button type="button" class="send-dropdown-item" @onclick="() => ScheduleSendPreset(2)">
                            <i data-lucide="clock"></i>
                            <span>Tomorrow afternoon</span>
                            <span class="hint">13:00</span>
                        </button>
                        <button type="button" class="send-dropdown-item" @onclick="OpenCustomSchedule">
                            <i data-lucide="calendar-clock"></i>
                            <span>Custom date & time…</span>
                        </button>
                    </div>
                }
            </div>

            @* Attachments Button & Dropdown *@
            <div class="att-split-wrap">
                <button type="button" class="att-btn" @onclick="() => attDropdownOpen = !attDropdownOpen">
                    <i data-lucide="paperclip"></i>
                    <span>Attach</span>
                    <i data-lucide="chevron-down" style="width:12px;height:12px;margin-left:2px"></i>
                </button>
                <InputFile @ref="fileInputRef" OnChange="OnLocalFileSelected" style="display:none" multiple />

                @if (attDropdownOpen)
                {
                    <div class="att-dropdown" @onclick:stopPropagation>
                        <button type="button" @onclick="TriggerLocalUpload">
                            <i data-lucide="laptop"></i>
                            <span>Upload from Computer</span>
                        </button>
                        <button type="button" @onclick="OpenSynologyPicker">
                            <i data-lucide="hard-drive"></i>
                            <span>Browse iPop Files</span>
                        </button>
                    </div>
                }
            </div>

            <div style="flex:1"></div>

            <button type="button" class="comp-btn danger" @onclick="DiscardDraft" title="Discard draft">
                <i data-lucide="trash-2"></i>
                <span>Discard</span>
            </button>
        </div>
    </div>
}

@* Custom Schedule Datetime Modal *@
@if (showCustomScheduleModal)
{
    <div class="syno-modal-overlay" @onclick="() => showCustomScheduleModal = false">
        <div class="syno-picker-dialog" style="max-width:420px" @onclick:stopPropagation>
            <div class="syno-picker-head">
                <span class="title"><i data-lucide="calendar-clock"></i> Schedule Send</span>
                <button type="button" class="icon-btn" title="Close" aria-label="Close" @onclick="() => showCustomScheduleModal = false"><i data-lucide="x"></i></button>
            </div>
            <div class="syno-picker-body" style="min-height:auto;padding:20px">
                <p style="font-size:12.5px;color:var(--ink-2);margin-bottom:12px">
                    Choose when this email should be sent. It will be stored in your <b>Scheduled</b> folder until the delivery time.
                </p>
                <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--ink)">
                    Select Date & Time:
                    <input type="datetime-local"
                           @bind="customScheduleTime"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           style="padding:8px 10px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--ink);font-size:13px;" />
                </label>
            </div>
            <div class="syno-picker-foot">
                <button type="button" class="comp-btn" @onclick="() => showCustomScheduleModal = false">Cancel</button>
                <button type="button" class="btn" style="width:auto;margin:0" @onclick="ConfirmCustomSchedule">Set Schedule</button>
            </div>
        </div>
    </div>
}

@* Synology File Picker Dialog *@
<SynologyFilePickerDialog IsOpen="@showSynologyPicker"
                          IsOpenChanged="v => showSynologyPicker = v"
                          OnFilesSelected="OnSynologyFilesSelected" />

@code {
    public enum ComposerDockState { Docked, Minimized, Maximized }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSent { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }

    private ComposerDockState dockState = ComposerDockState.Docked;
    private MailRteEditor? rteRef;
    private InputFile? fileInputRef;

    private string subject = "";
    private string body = "";
    private string importance = "normal";
    private bool showCc;
    private bool showBcc;
    private List<MemberSearchRow> toRows = [];
    private List<MemberSearchRow> ccRows = [];
    private List<MemberSearchRow> bccRows = [];
    private List<MailAttachment> composerAtts = [];

    private Guid? editingDraftId;
    private Guid? inReplyToId;
    private Guid? threadRootId;

    private bool sending;
    private bool draftSaving;
    private bool draftSaved;
    private bool sendDropdownOpen;
    private bool attDropdownOpen;
    private bool showCustomScheduleModal;
    private bool showSynologyPicker;
    private DateTime customScheduleTime = DateTime.Now.AddHours(2);
    private CancellationTokenSource? autosaveCts;

    // Zona seret-lepas berkas (Fase 2)
    private ElementReference dropZoneRef;

    // Undangan rapat (Fase 2)
    private bool isMeeting;
    private DateTime meetingStart = DateTime.Now.Date.AddDays(1).AddHours(9);
    private DateTime meetingEnd = DateTime.Now.Date.AddDays(1).AddHours(10);
    private int meetingReminderMin = 30;
    private string meetingLocation = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen)
        {
            await JS.InvokeVoidAsync("ipop.icons");
            await JS.InvokeVoidAsync("ipop.mailBindDropZone", dropZoneRef, "input[type=file]");
        }
        else
        {
            await JS.InvokeVoidAsync("ipop.mailUnbindDropZone", dropZoneRef);
        }
    }

    private string GetStateClass() => dockState switch
    {
        ComposerDockState.Minimized => "minimized",
        ComposerDockState.Maximized => "maximized",
        _ => "docked"
    };

    public void OpenNew(
        Guid? inReplyTo = null,
        Guid? threadRoot = null,
        string? initialSubject = null,
        string? initialBody = null,
        List<MemberSearchRow>? initialTo = null)
    {
        editingDraftId = null;
        inReplyToId = inReplyTo;
        threadRootId = threadRoot;
        subject = initialSubject ?? "";
        body = initialBody ?? "";
        importance = "normal";
        toRows = initialTo ?? [];
        ccRows = [];
        bccRows = [];
        composerAtts = [];
        showCc = false;
        showBcc = false;
        dockState = ComposerDockState.Docked;
        IsOpen = true;
        IsOpenChanged.InvokeAsync(true);
        StateHasChanged();
    }

    public void OpenDraft(MailDetail draft)
    {
        editingDraftId = draft.Id;
        inReplyToId = draft.InReplyToId;
        threadRootId = draft.ThreadRootId;
        subject = draft.Subject ?? "";
        body = draft.Body ?? "";
        importance = draft.Importance ?? "normal";
        toRows = draft.Recipients.Where(r => r.RecipientType == "to").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        ccRows = draft.Recipients.Where(r => r.RecipientType == "cc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        bccRows = draft.Recipients.Where(r => r.RecipientType == "bcc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        showCc = ccRows.Count > 0;
        showBcc = bccRows.Count > 0;
        composerAtts = draft.Attachments.ToList();
        dockState = ComposerDockState.Docked;
        IsOpen = true;
        IsOpenChanged.InvokeAsync(true);
        StateHasChanged();
    }

    private void Minimize() => dockState = ComposerDockState.Minimized;
    private void Maximize() => dockState = ComposerDockState.Maximized;
    private void Restore() => dockState = ComposerDockState.Docked;

    private void OnHeadClick()
    {
        if (dockState == ComposerDockState.Minimized) Restore();
    }

    public void Close()
    {
        IsOpen = false;
        IsOpenChanged.InvokeAsync(false);
    }

    private void OnToPick(MemberSearchRow r) { if (!toRows.Any(x => x.Nik == r.Nik)) toRows.Add(r); }
    private void OnCcPick(MemberSearchRow r) { if (!ccRows.Any(x => x.Nik == r.Nik)) ccRows.Add(r); }
    private void OnBccPick(MemberSearchRow r) { if (!bccRows.Any(x => x.Nik == r.Nik)) bccRows.Add(r); }

    private void OnBodyChanged(string newBody)
    {
        body = newBody;
        OnContentChanged();
    }

    // ---- Template surat (Fase 3) ----
    private sealed record TemplateRow(string Name, string Subject, string Body);
    private List<TemplateRow> templates = [];

    // ---- Label surat (Fase 2) — klasifikasi yang diterapkan saat kirim ----
    private sealed record LabelRow(Guid Id, string Name, string? Color);
    private List<LabelRow> labels = [];
    private HashSet<Guid> selectedLabelIds = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadTemplatesAsync();
        await LoadLabelsAsync();
    }

    private async Task LoadTemplatesAsync()
    {
        try
        {
            templates = await Auth.GetAsync<List<TemplateRow>>("/api/mail/templates") ?? [];
        }
        catch { templates = []; }
    }

    private async Task LoadLabelsAsync()
    {
        try
        {
            labels = await Auth.GetAsync<List<LabelRow>>("/api/mail/labels") ?? [];
        }
        catch { labels = []; }
    }

    private void ApplyLabel(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
            selectedLabelIds.Add(id);
        StateHasChanged();
    }

    private void ApplyTemplate(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (string.IsNullOrEmpty(name)) return;
        var tpl = templates.FirstOrDefault(t => t.Name == name);
        if (tpl is null) return;
        subject = tpl.Subject;
        body = tpl.Body; // RTE tersinkron lewat Value ↔ lastSyncedValue pada render berikutnya
        OnContentChanged();
    }

    private void OnContentChanged()
    {
        draftSaved = false;
        autosaveCts?.Cancel();
        autosaveCts = new CancellationTokenSource();
        _ = AutosaveDebouncedAsync(autosaveCts.Token);
    }

    private async Task AutosaveDebouncedAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(15000, ct);
            if (string.IsNullOrWhiteSpace(subject) && string.IsNullOrWhiteSpace(body) && toRows.Count == 0) return;

            draftSaving = true;
            StateHasChanged();

            var req = new MailSendRequest(
                Subject: subject,
                Body: body,
                To: toRows.Select(r => r.Nik).ToList(),
                Cc: ccRows.Select(r => r.Nik).ToList(),
                Bcc: bccRows.Select(r => r.Nik).ToList(),
                AttachmentIds: composerAtts.Select(a => a.Id).ToList(),
                InReplyToId: inReplyToId,
                ThreadRootId: threadRootId,
                Importance: importance);

            if (editingDraftId.HasValue)
            {
                await MailSvc.UpdateDraftAsync(editingDraftId.Value, req, ct);
            }
            else
            {
                var res = await MailSvc.SaveDraftAsync(req, ct);
                if (res?.Success == true) editingDraftId = res.MailId;
            }

            draftSaving = false;
            draftSaved = true;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch { draftSaving = false; }
    }

    private async Task SendNow()
    {
        sendDropdownOpen = false;
        await DoSendAsync(null);
    }

    private async Task ScheduleSendPreset(int preset)
    {
        sendDropdownOpen = false;
        var tomorrow = DateTime.Today.AddDays(1);
        var targetTime = preset == 1
            ? tomorrow.AddHours(8) // 08:00
            : tomorrow.AddHours(13); // 13:00

        await DoSendAsync(targetTime.ToUniversalTime());
    }

    private void OpenCustomSchedule()
    {
        sendDropdownOpen = false;
        customScheduleTime = DateTime.Now.AddHours(2);
        showCustomScheduleModal = true;
    }

    private async Task ConfirmCustomSchedule()
    {
        showCustomScheduleModal = false;
        await DoSendAsync(customScheduleTime.ToUniversalTime());
    }

    private async Task DoSendAsync(DateTime? scheduledAt)
    {
        if (toRows.Count == 0 && ccRows.Count == 0 && bccRows.Count == 0)
        {
            Toasts.Show("Please add at least one recipient.");
            return;
        }

        sending = true;
        StateHasChanged();
        try
        {
            var req = new MailSendRequest(
                Subject: subject,
                Body: body,
                To: toRows.Select(r => r.Nik).ToList(),
                Cc: ccRows.Select(r => r.Nik).ToList(),
                Bcc: bccRows.Select(r => r.Nik).ToList(),
                AttachmentIds: composerAtts.Select(a => a.Id).ToList(),
                InReplyToId: inReplyToId,
                ThreadRootId: threadRootId,
                ScheduledAt: scheduledAt,
                Importance: importance);

            var res = await MailSvc.SendAsync(req);
            if (res?.Success == true)
            {
                // If this was editing an existing draft, remove old draft
                if (editingDraftId.HasValue)
                {
                    _ = MailSvc.DiscardDraftAsync(editingDraftId.Value);
                }

                // Undangan rapat (Fase 2): buat Meeting setelah surat terkirim — peserta
                // adalah penerima (To/Cc). Ditunggu agar kegagalan terlihat; rapat dihubungkan
                // ke surat undangan lewat SourceMailId.
                if (isMeeting && res.MailId.HasValue)
                {
                    await CreateMeetingAsync(res.MailId.Value);
                }

                Toasts.Show(scheduledAt.HasValue
                    ? $"Email scheduled for {scheduledAt.Value.ToLocalTime():dd MMM yyyy HH:mm}."
                    : isMeeting ? "Meeting invitation sent." : "Email sent successfully.");

                Close();
                await OnSent.InvokeAsync();
            }
            else
            {
                Toasts.Show(res?.Error ?? "Failed to send email.");
            }
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message);
        }
        finally
        {
            sending = false;
            StateHasChanged();
        }
    }

    // Meeting invitation: create Meeting from email recipients (To+Cc → attendee, send NIK),
    // linked to email via SourceMailId. Failure reported to user.
    private async Task CreateMeetingAsync(Guid mailId)
    {
        var attendeeNiks = toRows.Concat(ccRows).Select(r => r.Nik).Distinct().ToList();
        if (attendeeNiks.Count == 0) return;

        var res = await Auth.SendAsync(HttpMethod.Post, "/api/meetings", new
        {
            title = string.IsNullOrWhiteSpace(subject) ? "Meeting" : subject,
            startAt = meetingStart.ToUniversalTime(),
            endAt = meetingEnd.ToUniversalTime(),
            timeZone = (string?)null,
            location = string.IsNullOrWhiteSpace(meetingLocation) ? null : meetingLocation,
            link = (string?)null,
            attendeeIds = (IReadOnlyList<Guid>?)null,
            requiredIds = (IReadOnlyList<Guid>?)null,
            attendeeNiks,
            reminderMinutes = meetingReminderMin,
            roomId = (Guid?)null,
            sourceMailId = mailId,
        });
        if (!res.IsSuccessStatusCode)
            Toasts.Show("Email sent, but meeting creation failed.", ToastKind.Error);
    }

    private async Task DiscardDraft()
    {
        if (editingDraftId.HasValue)
        {
            await MailSvc.DiscardDraftAsync(editingDraftId.Value);
        }
        Close();
        await OnDiscard.InvokeAsync();
    }

    private async Task TriggerLocalUpload()
    {
        attDropdownOpen = false;
        await JS.InvokeVoidAsync("ipop.triggerFileInput");
    }

    private void OpenSynologyPicker()
    {
        attDropdownOpen = false;
        showSynologyPicker = true;
    }

    private async Task OnLocalFileSelected(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(5);
        if (files.Count == 0) return;

        using var content = new MultipartFormDataContent();
        foreach (var file in files)
        {
            var streamContent = new StreamContent(file.OpenReadStream(50 * 1024 * 1024));
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType ?? "application/octet-stream");
            content.Add(streamContent, "files", file.Name);
        }

        var uploaded = await MailSvc.UploadAsync(content);
        if (uploaded != null)
        {
            composerAtts.AddRange(uploaded);
            StateHasChanged();
        }
    }

    private void OnSynologyFilesSelected(List<MailAttachment> files)
    {
        composerAtts.AddRange(files);
        StateHasChanged();
    }

    // Panel kelola lampiran: geser urutan (atas/bawah).
    private void MoveAtt(MailAttachment a, int delta)
    {
        var i = composerAtts.IndexOf(a);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= composerAtts.Count) return;
        (composerAtts[i], composerAtts[j]) = (composerAtts[j], composerAtts[i]);
        StateHasChanged();
    }

    // Hapus lampiran: dari UI + server (orphan milik uploader). Gagal server tetap
    // menghapus dari UI agar tidak menghalangi — berkas orphan dibersihkan worker.
    private async Task RemoveAtt(MailAttachment a)
    {
        composerAtts.Remove(a);
        StateHasChanged();
        try
        {
            await Auth.SendAsync(HttpMethod.Delete, $"/api/mail/attachments/{a.Id}");
        }
        catch { /* best-effort */ }
    }

    private static string HumanSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    public void Dispose()
    {
        autosaveCts?.Cancel();
        autosaveCts?.Dispose();
        if (dropZoneRef.Id is not null)
            _ = JS.InvokeVoidAsync("ipop.mailUnbindDropZone", dropZoneRef);
    }
