    }

    private async Task DoSendAsync(DateTime? scheduledAt)
    {
        if (sending) return;
        if (toRows.Count == 0 && ccRows.Count == 0 && bccRows.Count == 0 && GroupCount == 0)
        {
            Toasts.Show("Please add at least one recipient.", ToastKind.Warning);
            return;
        }
        if (isMeeting && meetingEnd <= meetingStart)
        {
            Toasts.Show("The meeting must end after it starts.", ToastKind.Warning);
            return;
        }

        CancelAutosave();
        sending = true;
        StateHasChanged();
        await WaitForSaveAsync();
        try
        {
            var req = BuildRequest(scheduledAt);
            SendMailResult? res = null;
            // Big or group mail: the server counts (deduped, groups expanded) and the user confirms
            // that exact number. If it changed in between, the server asks again.
            var needsCount = GroupCount > 0 || TypedCount > MailLimits.ConfirmAbove;
            for (var attempt = 0; attempt < 3; attempt++)
            {
                int? confirmed = null;
                if (needsCount || res?.Code == "confirm_required")
                {
                    var p = await MailSvc.PreviewRecipientsAsync(req);
                    if (p is null) { Toasts.Show("Couldn't count the recipients. Try again.", ToastKind.Error); return; }
                    preview = p;
                    if (p.Invalid.Count > 0)
                    {
                        Toasts.Show(p.Invalid.Any(i => i.StartsWith("group:"))
                            ? "One of the groups no longer exists. Remove it and try again."
                            : "Some recipients don't exist or are no longer active. Remove them and try again.", ToastKind.Error);
                        return;
                    }
                    if (p.Total == 0) { Toasts.Show("Nobody to send to: everyone in these groups is inactive.", ToastKind.Warning); return; }
                    if (p.Total > p.Limit)
                    {
                        Toasts.Show($"This mail would go to {p.Total:N0} people. The limit is {p.Limit:N0} per mail. Remove {p.Total - p.Limit:N0} or split it into several mails.", ToastKind.Error);
                        return;
                    }
                    if (p.NeedsConfirm)
                    {
                        if (!await AskConfirmAsync(p, scheduledAt.HasValue)) return;
                        confirmed = p.Total;
                    }
                }
                var sendReq = req with { ConfirmedRecipientCount = confirmed };
                res = forwardOfId is { } fwd
                    ? await MailSvc.ForwardAsync(fwd, sendReq)
                    : await MailSvc.SendAsync(sendReq);
                if (res?.Code != "confirm_required") break;
            }
            if (res?.Success == true)
            {
                if (editingDraftId.HasValue)
                    _ = MailSvc.DiscardDraftAsync(editingDraftId.Value);

                // Awaited so a failure is visible; the meeting links back through SourceMailId.
                var meetingCreated = !isMeeting;
                if (isMeeting && res.MailId.HasValue)
                    meetingCreated = await CreateMeetingAsync(res.MailId.Value);
                else if (isMeeting)
                    Toasts.Show("Email sent, but meeting creation failed.", ToastKind.Error);

                if (meetingCreated)
                    Toasts.Show(scheduledAt.HasValue
                        ? $"Email scheduled for {scheduledAt.Value.ToLocalTime():dd MMM yyyy HH:mm}."
                        : isMeeting ? "Meeting invitation sent." : "Email sent.", ToastKind.Success);

                sending = false;
                dirtySince = null;
                _ = ClearUnloadStashAsync();
                Close();
                await OnSent.InvokeAsync();
            }
            else
            {
                Toasts.Show(res?.Error ?? "Failed to send email.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show(ex.Message, ToastKind.Error);
        }
        finally
        {
            sending = false;
            StateHasChanged();
        }
    }

    private async Task<bool> CreateMeetingAsync(Guid mailId)
    {
        try
        {
            // Resolve current To/Cc group membership, not stale chip counts. Bcc remains private.
            var attendeeNiks = toRows.Concat(ccRows).Select(r => r.Nik).ToList();
            foreach (var group in toGroups.Concat(ccGroups).DistinctBy(g => (g.Kind, g.Id)))
            {
                var detail = await MailSvc.GetGroupAsync(group.Kind, group.Id);
                if (detail is null)
                {
                    Toasts.Show("Email sent, but meeting creation failed.", ToastKind.Error);
                    return false;
                }
                attendeeNiks.AddRange(detail.Members.Where(m => m.IsActive).Select(m => m.Nik));
            }
            attendeeNiks = attendeeNiks.Distinct().ToList();

            using var res = await Auth.SendAsync(HttpMethod.Post, "/api/meetings", new
            {
                title = string.IsNullOrWhiteSpace(subject) ? "Meeting" : subject,
                startAt = meetingStart.ToUniversalTime(),
                endAt = meetingEnd.ToUniversalTime(),
                timeZone = (string?)null,
                location = string.IsNullOrWhiteSpace(meetingLocation) ? null : meetingLocation,
                link = (string?)null,
                attendeeIds = (IReadOnlyList<Guid>?)null,
                requiredIds = (IReadOnlyList<Guid>?)null,
                attendeeNiks,
                reminderMinutes = meetingReminderMin,
                roomId = (Guid?)null,
                sourceMailId = mailId,
            });
            if (!res.IsSuccessStatusCode)
                Toasts.Show("Email sent, but meeting creation failed.", ToastKind.Error);
            return res.IsSuccessStatusCode;
        }
        catch (Exception ex)
        {
            // Mail is already sent: close normally so retry cannot send it a second time.
            Toasts.Show($"Email sent, but meeting creation failed. {ex.Message}", ToastKind.Error);
            return false;
        }
    }

    private async Task DiscardDraft()
    {
        CancelAutosave();
        dirtySince = null;
        _ = ClearUnloadStashAsync();
        await WaitForSaveAsync();
        if (editingDraftId.HasValue)
            await MailSvc.DiscardDraftAsync(editingDraftId.Value);
        Close();
        await OnDiscard.InvokeAsync();
    }

    private async Task TriggerLocalUpload()
    {
        attDropdownOpen = false;
        await JS.InvokeVoidAsync("ipop.triggerFileInput", ".outlook-composer .mc-file-input");
    }

    private void OpenSynologyPicker()
    {
        attDropdownOpen = false;
        showSynologyPicker = true;
    }

    private async Task OnLocalFileSelected(InputFileChangeEventArgs e)
    {
        const int maxFiles = 5; // server limit per upload
        if (e.FileCount > maxFiles) Toasts.Show($"Only the first {maxFiles} files were attached.", ToastKind.Warning);
        var files = e.GetMultipleFiles(maxFiles);
        if (files.Count == 0) return;

        uploading = true;
        StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in files)
            {
                var streamContent = new StreamContent(file.OpenReadStream(50 * 1024 * 1024));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(streamContent, "files", file.Name);
            }
            var (uploaded, error) = await MailSvc.UploadWithErrorAsync(content);
            if (uploaded != null)
            {
                composerAtts.AddRange(uploaded);
                MarkJustAdded(uploaded);
                OnContentChanged();
            }
            else Toasts.Show($"Upload failed: {error ?? "unknown error"}", ToastKind.Error);
        }
        catch (Exception ex) { Toasts.Show(ex.Message, ToastKind.Error); }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    // #13: a freshly uploaded chip pops its icon once; the mark clears after the animation.
    private readonly HashSet<Guid> justAdded = [];
    private void MarkJustAdded(IEnumerable<MailAttachment> added)
    {
        var ids = added.Select(a => a.Id).ToList();
        foreach (var id in ids) justAdded.Add(id);
        _ = Task.Delay(700).ContinueWith(_ => InvokeAsync(() => { foreach (var id in ids) justAdded.Remove(id); StateHasChanged(); }));
    }

    private void OnSynologyFilesSelected(List<MailAttachment> files)
    {
        composerAtts.AddRange(files);
        MarkJustAdded(files);
        OnContentChanged();
        StateHasChanged();
    }

    private void MoveAtt(MailAttachment a, int delta)
    {
        var i = composerAtts.IndexOf(a);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= composerAtts.Count) return;
        (composerAtts[i], composerAtts[j]) = (composerAtts[j], composerAtts[i]);
    }

    // Removed from the UI even if the server call fails; the worker cleans up orphans.
    private async Task RemoveAtt(MailAttachment a)
    {
        composerAtts.Remove(a);
        OnContentChanged();
        StateHasChanged();
        try { await Auth.SendAsync(HttpMethod.Delete, $"/api/mail/attachments/{a.Id}"); }
        catch { /* best-effort */ }
    }

    internal static string FileIcon(MailAttachment a)
    {
        var mime = a.MimeType ?? "";
        var ext = Path.GetExtension(a.FileName ?? "").ToLowerInvariant();
        if (mime.StartsWith("image/")) return "file-image";
        if (mime == "application/pdf" || ext == ".pdf") return "file-text";
        if (ext is ".xls" or ".xlsx" or ".csv") return "file-spreadsheet";
        if (ext is ".zip" or ".rar" or ".7z") return "file-archive";
        if (mime.StartsWith("video/")) return "file-video";
        return "file";
    }

    internal static string HumanSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        CancelAutosave();
        previewCts?.Cancel();
        confirmTcs?.TrySetResult(false);
        if (dropZoneRef.Id is not null)
            _ = JS.InvokeVoidAsync("ipop.mailUnbindDropZone", dropZoneRef);
    }
