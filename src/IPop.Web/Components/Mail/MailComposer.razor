    private async Task OnLocalFileSelected(InputFileChangeEventArgs e)
    {
        const int maxFiles = 5; // server limit per upload
        if (e.FileCount > maxFiles) Toasts.Show($"Only the first {maxFiles} files were attached.", ToastKind.Warning);
        var files = e.GetMultipleFiles(maxFiles);
        if (files.Count == 0) return;

        uploading = true;
        StateHasChanged();
        try
        {
            using var content = new MultipartFormDataContent();
            foreach (var file in files)
            {
                var streamContent = new StreamContent(file.OpenReadStream(50 * 1024 * 1024));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(streamContent, "files", file.Name);
            }
            var (uploaded, error) = await MailSvc.UploadWithErrorAsync(content);
            if (uploaded != null)
            {
                composerAtts.AddRange(uploaded);
                OnContentChanged();
            }
            else Toasts.Show($"Upload failed: {error ?? "unknown error"}", ToastKind.Error);
        }
        catch (Exception ex) { Toasts.Show(ex.Message, ToastKind.Error); }
        finally
        {
            uploading = false;
            StateHasChanged();
        }
    }

    private void OnSynologyFilesSelected(List<MailAttachment> files)
    {
        composerAtts.AddRange(files);
        OnContentChanged();
        StateHasChanged();
    }

    private void MoveAtt(MailAttachment a, int delta)
    {
        var i = composerAtts.IndexOf(a);
        var j = i + delta;
        if (i < 0 || j < 0 || j >= composerAtts.Count) return;
        (composerAtts[i], composerAtts[j]) = (composerAtts[j], composerAtts[i]);
    }

    // Removed from the UI even if the server call fails; the worker cleans up orphans.
    private async Task RemoveAtt(MailAttachment a)
    {
        composerAtts.Remove(a);
        OnContentChanged();
        StateHasChanged();
        try { await Auth.SendAsync(HttpMethod.Delete, $"/api/mail/attachments/{a.Id}"); }
        catch { /* best-effort */ }
    }

    internal static string FileIcon(MailAttachment a)
    {
        var mime = a.MimeType ?? "";
        var ext = Path.GetExtension(a.FileName ?? "").ToLowerInvariant();
        if (mime.StartsWith("image/")) return "file-image";
        if (mime == "application/pdf" || ext == ".pdf") return "file-text";
        if (ext is ".xls" or ".xlsx" or ".csv") return "file-spreadsheet";
        if (ext is ".zip" or ".rar" or ".7z") return "file-archive";
        if (mime.StartsWith("video/")) return "file-video";
        return "file";
    }

    internal static string HumanSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        CancelAutosave();
        if (dropZoneRef.Id is not null)
            _ = JS.InvokeVoidAsync("ipop.mailUnbindDropZone", dropZoneRef);
    }
