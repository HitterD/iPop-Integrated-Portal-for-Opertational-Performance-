    private AddressBookDialog? addressBook;

    private async Task OpenBookAsync(List<MemberSearchRow> target)
    {
        if (addressBook is null) return;
        var label = target == ccRows ? "Cc" : target == bccRows ? "Bcc" : "To";
        var groups = GroupsFor(label);
        var picked = await addressBook.PickWithGroupsAsync($"Add to {label}", target.Select(r => r.Nik), groups.Select(g => g.Id));
        var added = false;
        foreach (var r in picked.People)
            if (!target.Any(x => x.Nik == r.Nik)) { target.Add(r); added = true; }
        foreach (var g in picked.Groups)
            if (!groups.Any(x => x.Id == g.Id)) { groups.Add(g); added = true; }
        if (added) OnRecipientsChanged();
        StateHasChanged();
    }

    private void AddRecipient(List<MemberSearchRow> list, MemberSearchRow? r)
    {
        if (r is null || list.Any(x => x.Nik == r.Nik)) return;
        list.Add(r);
        OnRecipientsChanged();
    }

    private void RemoveRecipient(List<MemberSearchRow> list, MemberSearchRow r)
    {
        list.Remove(r);
        OnRecipientsChanged();
    }

    // ── Long recipient lists ─────────────────────────────────────────────────
    // Address book "Select all" can add hundreds of people. A row with more than
    // CollapseAfter chips shows only the first CollapsedChips plus a "+N more" chip, so the
    // Subject row and the editor keep their space and only a handful of chips render.
    // Expanding turns the row into a capped, scrollable list (one row at a time).
    internal const int CollapseAfter = 6;
    internal const int CollapsedChips = 4;
    private string? expandedRecipientRow;

    private void ExpandRecipients(string row) => expandedRecipientRow = row;
    private void CollapseRecipients() => expandedRecipientRow = null;

    private void RemoveAllRecipients(List<MemberSearchRow> list)
    {
        if (list.Count == 0) return;
        list.Clear();
        expandedRecipientRow = null;
        OnRecipientsChanged();
    }

    private RenderFragment RecipientField(string row, List<MemberSearchRow> rows, List<MailGroupSummary> groups, string placeholder) => __builder =>
    {
        var overflowing = rows.Count > CollapseAfter;
        var expanded = overflowing && expandedRecipientRow == row;
        var collapsed = overflowing && !expanded;
        var shown = collapsed ? rows.Take(CollapsedChips) : rows;
        <div class="recipient-input-wrap @(collapsed ? "rcpt-collapsed" : "") @(expanded ? "rcpt-expanded" : "")">
            @foreach (var g in groups)
            {
                var isOpen = peek is { } pk && pk.Row == row && pk.Id == g.Id;
                <span class="chip mc-grp-chip @(isOpen ? "open" : "")">
                    <button type="button" class="mc-grp-btn" aria-expanded="@(isOpen ? "true" : "false")"
                            title="@($"{g.Name}: {g.Count:N0} people ({(g.Kind == "personal" ? "my group" : "shared group")})")"
                            aria-label="@($"Group {g.Name}, {g.Count} people. Show members")" @onclick="() => TogglePeekAsync(row, g)">
                        <i data-lucide="users"></i>@g.Name <span class="n">· @g.Count.ToString("N0")</span><i data-lucide="chevron-down" class="cv"></i>
                    </button>
                    <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove group {g.Name}")" @onclick="() => RemoveGroup(groups, g)"><i data-lucide="x"></i></button>
                </span>
            }
            @if (expanded)
            {
                <div class="rcpt-list" role="list" aria-label="@($"{row} recipients ({rows.Count})")">
                    @foreach (var r in rows)
                    {
                        <span class="chip" role="listitem">@r.Name
                            <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove {r.Name}")" @onclick="() => RemoveRecipient(rows, r)"><i data-lucide="x"></i></button>
                        </span>
                    }
                </div>
            }
            else
            {
                @foreach (var r in shown)
                {
                    <span class="chip">@r.Name
                        <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove {r.Name}")" @onclick="() => RemoveRecipient(rows, r)"><i data-lucide="x"></i></button>
                    </span>
                }
                @if (collapsed)
                {
                    <button type="button" class="chip rcpt-more" title="Show all @rows.Count recipients" aria-expanded="false"
                            aria-label="@($"Show all {rows.Count} {row} recipients")" @onclick="() => ExpandRecipients(row)">
                        +@(rows.Count - CollapsedChips) more
                    </button>
                }
            }
            <AppMemberPicker ValueChanged="(MemberSearchRow? r) => AddRecipient(rows, r)" Placeholder="@(rows.Count + groups.Count == 0 ? placeholder : "")" />
            @if (expanded)
            {
                <span class="rcpt-acts">
                    <span class="rcpt-count">@rows.Count recipients</span>
                    <button type="button" class="rcpt-act danger" @onclick="() => RemoveAllRecipients(rows)">Remove all</button>
                    <button type="button" class="rcpt-act" aria-expanded="true" @onclick="CollapseRecipients">Show less</button>
                </span>
            }
        </div>
    };

    // ── Groups, live count and the >50 confirmation ─────────────────────────
    private sealed record PeekState(string Row, Guid Id, MailGroupDetail? Detail, bool Failed);
    private PeekState? peek;
    private RecipientPreview? preview;
    private bool previewLoading;
    private CancellationTokenSource? previewCts;
    private RecipientPreview? confirmPreview;
    private bool confirmScheduled;
    private TaskCompletionSource<bool>? confirmTcs;
    private ElementReference confirmCancelRef;
    private bool focusConfirm;

    private List<MailGroupSummary> GroupsFor(string row) => row switch { "Cc" => ccGroups, "Bcc" => bccGroups, _ => toGroups };
    private List<MemberSearchRow> RowsFor(string row) => row switch { "Cc" => ccRows, "Bcc" => bccRows, _ => toRows };
    private int GroupCount => toGroups.Count + ccGroups.Count + bccGroups.Count;
    private int TypedCount => toRows.Concat(ccRows).Concat(bccRows).Select(r => r.Nik).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    /// The count row appears once a mail gets big (or uses groups); small mail looks unchanged.
    private bool ShowMassRow => GroupCount > 0 || TypedCount >= 10 || hideRecipients;
    private int RecipientEstimate => preview?.Total ?? TypedCount + toGroups.Concat(ccGroups).Concat(bccGroups).Sum(g => g.Count);
    private bool IsMassMail => GroupCount > 0 || RecipientEstimate > MailLimits.ConfirmAbove;
    private bool CountOverLimit => RecipientEstimate > MailLimits.MaxRecipients;

    private string RecipientCountLabel()
    {
        if (preview is null) return previewLoading ? "Counting…" : $"{RecipientEstimate:N0} recipients";
        var text = $"{preview.Total:N0} {(preview.Total == 1 ? "recipient" : "recipients")}";
        if (preview.Duplicates > 0) text += $" ({preview.Duplicates:N0} duplicate{(preview.Duplicates == 1 ? "" : "s")} removed)";
        if (preview.Total > preview.Limit) text += $" · max {preview.Limit:N0}";
        return text;
    }

    private void ResetMassState()
    {
        peek = null;
        preview = null;
        previewLoading = false;
        previewCts?.Cancel();
        previewCts = null;
        ResolveConfirm(false);
    }

    private static List<MailGroupSummary> DraftGroups(MailDetail draft, string field)
        => draft.RecipientGroups.Where(g => g.Field == field).Select(g => new MailGroupSummary(g.Id, g.Kind, g.Name, g.Count)).ToList();

    private IReadOnlyList<MailGroupRef> GroupRefs()
        => toGroups.Select(g => new MailGroupRef("to", g.Kind, g.Id))
            .Concat(ccGroups.Select(g => new MailGroupRef("cc", g.Kind, g.Id)))
            .Concat(bccGroups.Select(g => new MailGroupRef("bcc", g.Kind, g.Id)))
            .ToList();

    private void OnRecipientsChanged()
    {
        OnContentChanged();
        SchedulePreview();
    }

    private void ToggleHideRecipients(ChangeEventArgs e)
    {
        hideRecipients = e.Value is true;
        OnContentChanged();
    }

    /// The server's de-duplicated count (groups expanded, inactive skipped), debounced.
    private void SchedulePreview()
    {
        previewCts?.Cancel();
        if (GroupCount == 0 && TypedCount < 10)
        {
            preview = null;
            previewLoading = false;
            return;
        }
        var cts = previewCts = new CancellationTokenSource();
        previewLoading = true;
        _ = RunPreviewAsync(cts.Token);
    }

    private async Task RunPreviewAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(500, ct);
            var res = await MailSvc.PreviewRecipientsAsync(BuildRequest(), ct);
            if (ct.IsCancellationRequested) return;
            preview = res;
        }
        catch (OperationCanceledException) { return; }
        catch { if (ct.IsCancellationRequested) return; preview = null; }
        previewLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveGroup(List<MailGroupSummary> groups, MailGroupSummary g)
    {
        groups.Remove(g);
        if (peek?.Id == g.Id) peek = null;
        OnRecipientsChanged();
    }

    private async Task TogglePeekAsync(string row, MailGroupSummary g)
    {
        if (peek is { } p && p.Row == row && p.Id == g.Id) { peek = null; return; }
        peek = new PeekState(row, g.Id, null, false);
        var detail = await MailSvc.GetGroupAsync(g.Kind, g.Id);
        if (peek is null || peek.Id != g.Id || peek.Row != row) return;
        peek = peek with { Detail = detail, Failed = detail is null };
        StateHasChanged();
    }

    /// Swaps the chip for its active members as ordinary recipients in the same field.
    private void ExpandGroup(string row)
    {
        if (peek?.Detail is not { } d || peek.Row != row) return;
        var rows = RowsFor(row);
        foreach (var m in d.Members.Where(m => m.IsActive))
            if (!rows.Any(x => string.Equals(x.Nik, m.Nik, StringComparison.OrdinalIgnoreCase)))
                rows.Add(new MemberSearchRow(m.Nik, m.Name, null, m.Department));
        GroupsFor(row).RemoveAll(x => x.Id == d.Id);
        peek = null;
        OnRecipientsChanged();
    }

    private RenderFragment GroupPeek(string row) => __builder =>
    {
        if (peek is not { } p || p.Row != row) return;
        var g = GroupsFor(row).FirstOrDefault(x => x.Id == p.Id);
        if (g is null) return;
        <div class="mc-grp-peek" role="region" aria-label="@($"Members of {g.Name}")">
            <div class="mc-grp-peek-h">
                <span><b>@g.Name</b> · @g.Count.ToString("N0") @(g.Count == 1 ? "person" : "people")</span>
                @if (p.Detail is not null)
                {
                    <button type="button" class="rcpt-act" @onclick="() => ExpandGroup(row)">Expand to individuals</button>
                }
                <button type="button" class="rcpt-act mc-grp-close" @onclick="() => peek = null">Close</button>
            </div>
            @if (p.Failed) { <div class="mc-grp-ppl">Couldn't load the members.</div> }
            else if (p.Detail is null) { <div class="mc-grp-ppl">Loading…</div> }
            else
            {
                var active = p.Detail.Members.Where(m => m.IsActive).ToList();
                var inactive = p.Detail.Members.Count - active.Count;
                <div class="mc-grp-ppl">
                    @foreach (var m in active.Take(24)) { <span>@m.Name</span> }
                    @if (active.Count > 24) { <span class="more">+@(active.Count - 24) more</span> }
                    @if (inactive > 0) { <span class="warn">@inactive inactive, will be skipped</span> }
                </div>
            }
        </div>
    };

    /// Shows the "Send to N people?" dialog; resolves false on Cancel/Esc/backdrop.
    private Task<bool> AskConfirmAsync(RecipientPreview p, bool scheduled)
    {
        confirmTcs?.TrySetResult(false);
        confirmTcs = new TaskCompletionSource<bool>();
        confirmPreview = p;
        confirmScheduled = scheduled;
        focusConfirm = true;
        StateHasChanged();
        return confirmTcs.Task;
    }

    private void ResolveConfirm(bool ok)
    {
        confirmPreview = null;
        var t = confirmTcs;
        confirmTcs = null;
        t?.TrySetResult(ok);
    }

    private void OnConfirmKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") ResolveConfirm(false);
    }

    private async Task InsertSignature()
    {
        string? customSig = null;
        try { customSig = await Auth.GetUserSettingAsync("ipop.mail.signature"); } catch { }
        var sigHtml = !string.IsNullOrWhiteSpace(customSig)
            ? $"<p><br></p><p>--<br>{System.Net.WebUtility.HtmlEncode(customSig).Replace("\n", "<br>")}</p>"
            : $"<p><br></p><p>--<br><b>{Enc(Auth.Me?.Name)}</b><br>{Enc(Auth.Me?.Department)}<br>PT Santos Jaya Abadi</p>";
        // At the cursor and undoable, instead of replacing the whole body.
        if (rteRef is not null) await rteRef.InsertHtml(sigHtml);
