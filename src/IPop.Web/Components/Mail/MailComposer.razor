@inject IJSRuntime JS
@inject IPop.Web.Services.MailService MailSvc
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.AuthState Auth
@inject NavigationManager Nav
@inject HttpClient Http
@using IPop.Web.Components
@using IPop.Web.Services
@implements IDisposable

@if (IsOpen)
{
    @if (dockState == ComposerDockState.Maximized)
    {
        <div class="composer-backdrop" @onclick="Restore"></div>
    }

    <div class="outlook-composer mc-sheet @GetStateClass()" role="dialog" aria-label="@(IsForward ? "Forward message" : "New message")" @onkeydown="OnSheetKey">
        @* Header: title echo, message options, window buttons *@
        <div class="composer-head" @onclick="OnHeadClick">
            <span class="title">
                <i data-lucide="@(IsForward ? "forward" : "mail")"></i>
                <span class="title-text">@(dockState == ComposerDockState.Minimized ? $"Draft: {HeaderTitle}" : HeaderTitle)</span>
            </span>
            @if (dockState != ComposerDockState.Minimized)
            {
                <div class="mc-opts" @onclick:stopPropagation>
                    <div class="mrte-pop-wrap">
                        <button type="button" class="mc-opt @(importance != "normal" ? "on" : "") @(importance == "high" ? "high" : "")" title="Priority" aria-label="Priority"
                                aria-haspopup="true" aria-expanded="@(headPop == "prio" ? "true" : "false")" @onclick='() => ToggleHead("prio")'>
                            <i data-lucide="@(importance == "low" ? "arrow-down" : "flag")"></i>
                        </button>
                        @if (headPop == "prio")
                        {
                            <div class="mrte-pop mc-head-pop">
                                <div class="mrte-pop-title">Priority</div>
                                @foreach (var (val, label, icon) in Priorities)
                                {
                                    <button type="button" class="mrte-menu-item @(importance == val ? "on" : "")" @onclick="() => SetImportance(val)">
                                        <i data-lucide="@icon"></i> @label @if (importance == val) { <i data-lucide="check" class="mc-check"></i> }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    @if (labels.Count > 0)
                    {
                        <div class="mrte-pop-wrap">
                            <button type="button" class="mc-opt @(selectedLabelIds.Count > 0 ? "on" : "")" title="Labels" aria-label="Labels"
                                    aria-haspopup="true" aria-expanded="@(headPop == "label" ? "true" : "false")" @onclick='() => ToggleHead("label")'>
                                <i data-lucide="tag"></i>
                                @if (selectedLabelIds.Count > 0) { <span class="mc-opt-count">@selectedLabelIds.Count</span> }
                            </button>
                            @if (headPop == "label")
                            {
                                <div class="mrte-pop mc-head-pop">
                                    <div class="mrte-pop-title">Label your copy</div>
                                    @foreach (var l in labels)
                                    {
                                        var on = selectedLabelIds.Contains(l.Id);
                                        <button type="button" class="mrte-menu-item @(on ? "on" : "")" role="menuitemcheckbox" aria-checked="@(on ? "true" : "false")" @onclick="() => ToggleLabel(l.Id)">
                                            <span class="mc-label-dot" style="background:@(l.Color ?? "var(--accent)")"></span> @l.Name
                                            @if (on) { <i data-lucide="check" class="mc-check"></i> }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <button type="button" class="mc-opt @(isMeeting ? "on" : "")" title="Meeting invite" aria-label="Meeting invite" aria-pressed="@(isMeeting ? "true" : "false")"
                            @onclick="ToggleMeeting"><i data-lucide="calendar-clock"></i></button>
                    <div class="mrte-pop-wrap">
                        <button type="button" class="mc-opt mc-opt-text" title="Insert a saved template" aria-label="Template"
                                aria-haspopup="true" aria-expanded="@(headPop == "tpl" ? "true" : "false")" @onclick="ToggleTemplates">
                            <i data-lucide="layout-template"></i><span>Template</span>
                        </button>
                        @if (headPop == "tpl")
                        {
                            <div class="mrte-pop mc-head-pop mc-tpl-pop">
                                @if (pendingTemplate is { } pending)
                                {
                                    <div class="mrte-pop-title">Use “@pending.Name”</div>
                                    <div class="mc-tpl-note">Your message already has text. What should the template do?</div>
                                    <button type="button" class="mrte-menu-item" @onclick="() => ApplyTemplate(pending, replace: true)"><i data-lucide="replace"></i> Replace message</button>
                                    <button type="button" class="mrte-menu-item" @onclick="() => ApplyTemplate(pending, replace: false)"><i data-lucide="text-cursor-input"></i> Insert at cursor</button>
                                    <button type="button" class="mrte-menu-item" @onclick="() => pendingTemplate = null"><i data-lucide="arrow-left"></i> Back</button>
                                }
                                else
                                {
                                    <div class="mrte-pop-title">Templates</div>
                                    @if (templates.Count == 0)
                                    {
                                        <div class="mc-tpl-note">No templates yet. Save emails you send often and reuse them here.</div>
                                        <button type="button" class="mrte-menu-item" @onclick="OpenTemplateSettings"><i data-lucide="settings-2"></i> Create a template</button>
                                    }
                                    else
                                    {
                                        @foreach (var tpl in templates)
                                        {
                                            <button type="button" class="mrte-menu-item" @onclick="() => PickTemplate(tpl)"><i data-lucide="file-text"></i> @tpl.Name</button>
                                        }
                                        <button type="button" class="mrte-menu-item mc-tpl-manage" @onclick="OpenTemplateSettings"><i data-lucide="settings-2"></i> Manage templates</button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            <div class="head-actions" @onclick:stopPropagation>
                @if (dockState == ComposerDockState.Minimized)
                {
                    <button type="button" class="icon-btn" title="Restore" aria-label="Restore" @onclick="Restore"><i data-lucide="chevron-up"></i></button>
                }
                else
                {
                    <button type="button" class="icon-btn" title="Minimise (Esc)" aria-label="Minimise" @onclick="Minimize"><i data-lucide="minus"></i></button>
                    @if (dockState == ComposerDockState.Maximized)
                    {
                        <button type="button" class="icon-btn" title="Exit full screen" aria-label="Exit full screen" @onclick="Restore"><i data-lucide="minimize-2"></i></button>
                    }
                    else
                    {
                        <button type="button" class="icon-btn" title="Full screen" aria-label="Full screen" @onclick="Maximize"><i data-lucide="maximize-2"></i></button>
                    }
                }
                <button type="button" class="icon-btn" title="Close" aria-label="Close" @onclick="Close"><i data-lucide="x"></i></button>
            </div>
        </div>
        @if (headPop is not null)
        {
            <div class="mrte-pop-scrim" @onclick="() => headPop = null"></div>
        }

        <div class="composer-body-wrap" @ref="dropZoneRef">
            <div class="composer-drop-hint">
                <i data-lucide="upload-cloud"></i> Drop files here to attach
            </div>
            <div class="recipients-block">
                <div class="recipient-row">
                    <span class="recipient-label">To:</span>
                    <div class="recipient-input-wrap">
                        @foreach (var r in toRows)
                        {
                            <span class="chip">@r.Name
                                <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove {r.Name}")" @onclick="() => RemoveRecipient(toRows, r)"><i data-lucide="x"></i></button>
                            </span>
                        }
                        <AppMemberPicker ValueChanged="OnToPick" Placeholder="@(toRows.Count == 0 ? "Add recipients…" : "")" />
                    </div>
                    <button type="button" class="mc-book" title="Address book" aria-label="Address book (To)" @onclick="() => OpenBookAsync(toRows)"><i data-lucide="book-user"></i></button>
                    <div class="cc-bcc-toggles">
                        @if (!showCc) { <button type="button" @onclick="() => showCc = true">Cc</button> }
                        @if (!showBcc) { <button type="button" @onclick="() => showBcc = true">Bcc</button> }
                    </div>
                </div>
                @if (showCc)
                {
                    <div class="recipient-row">
                        <span class="recipient-label">Cc:</span>
                        <div class="recipient-input-wrap">
                            @foreach (var r in ccRows)
                            {
                                <span class="chip">@r.Name
                                    <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove {r.Name}")" @onclick="() => RemoveRecipient(ccRows, r)"><i data-lucide="x"></i></button>
                                </span>
                            }
                            <AppMemberPicker ValueChanged="OnCcPick" Placeholder="@(ccRows.Count == 0 ? "Add Cc…" : "")" />
                        </div>
                        <button type="button" class="mc-book" title="Address book" aria-label="Address book (Cc)" @onclick="() => OpenBookAsync(ccRows)"><i data-lucide="book-user"></i></button>
                    </div>
                }
                @if (showBcc)
                {
                    <div class="recipient-row">
                        <span class="recipient-label">Bcc:</span>
                        <div class="recipient-input-wrap">
                            @foreach (var r in bccRows)
                            {
                                <span class="chip">@r.Name
                                    <button type="button" class="chip-x" title="Remove" aria-label="@($"Remove {r.Name}")" @onclick="() => RemoveRecipient(bccRows, r)"><i data-lucide="x"></i></button>
                                </span>
                            }
                            <AppMemberPicker ValueChanged="OnBccPick" Placeholder="@(bccRows.Count == 0 ? "Add Bcc…" : "")" />
                        </div>
                        <button type="button" class="mc-book" title="Address book" aria-label="Address book (Bcc)" @onclick="() => OpenBookAsync(bccRows)"><i data-lucide="book-user"></i></button>
                    </div>
                }
                <div class="recipient-row subject-row">
                    <span class="recipient-label">Subject:</span>
                    <input type="text" class="subject-input" aria-label="Subject" @bind="subject" @bind:event="oninput" @bind:after="OnContentChanged" />
                    @if (importance == "high") { <span class="mc-badge high" title="High importance"><i data-lucide="flag"></i> High</span> }
                    else if (importance == "low") { <span class="mc-badge" title="Low importance"><i data-lucide="arrow-down"></i> Low</span> }
                </div>
            </div>

            @if (selectedLabelIds.Count > 0)
            {
                <div class="mc-label-row">
                    @foreach (var lid in selectedLabelIds.ToList())
                    {
                        var lbl = labels.FirstOrDefault(x => x.Id == lid);
                        if (lbl is null) continue;
                        <span class="chip mc-label-chip"><span class="mc-label-dot" style="background:@(lbl.Color ?? "var(--accent)")"></span>@lbl.Name
                            <button type="button" class="chip-x" title="Remove label" aria-label="@($"Remove label {lbl.Name}")" @onclick="() => ToggleLabel(lid)"><i data-lucide="x"></i></button>
                        </span>
                    }
                </div>
            }

            @if (isMeeting)
            {
                <div class="composer-meeting">
                    <div class="mc-meet-grid">
                        <label>Start<AppDateTimePicker @bind-Value="meetingStart" @bind-Value:after="OnContentChanged" AriaLabel="Meeting start" /></label>
                        <label>End<AppDateTimePicker @bind-Value="meetingEnd" @bind-Value:after="OnContentChanged" AriaLabel="Meeting end" /></label>
                        <label>Reminder
                            <select class="mc-field" @bind="meetingReminderMin" @bind:after="OnContentChanged">
                                <option value="10">10 minutes</option>
                                <option value="30">30 minutes</option>
                                <option value="60">1 hour</option>
                                <option value="1440">1 day</option>
                            </select>
                        </label>
                    </div>
                    <input class="mc-field" placeholder="Location or meeting link" aria-label="Meeting location" @bind="meetingLocation" @bind:after="OnContentChanged" />
                    <div class="mc-hint">Attendees are the To and Cc recipients. The meeting is created when the email is sent.</div>
                </div>
            }

            @if (composerAtts.Count > 0 || forwardAtts.Count > 0)
            {
                <div class="composer-atts">
                    @foreach (var a in forwardAtts)
                    {
                        <span class="composer-att-chip fwd" title="From the original message">
                            <i data-lucide="@FileIcon(a)"></i>
                            <span class="name">@a.FileName</span>
                            <span class="size">@HumanSize(a.FileSize)</span>
                            <button type="button" class="del-btn" title="Don't forward this file" aria-label="@($"Remove {a.FileName}")" @onclick="() => forwardAtts.Remove(a)"><i data-lucide="x"></i></button>
                        </span>
                    }
                    @foreach (var (a, i) in composerAtts.Select((x, idx) => (x, idx)))
                    {
                        <span class="composer-att-chip">
                            <i data-lucide="@FileIcon(a)"></i>
                            <span class="name">@a.FileName</span>
                            <span class="size">@HumanSize(a.FileSize)</span>
                            @if (composerAtts.Count > 1)
                            {
                                <button type="button" class="act-mini" title="Move earlier" aria-label="Move earlier" disabled="@(i == 0)" @onclick="() => MoveAtt(a, -1)"><i data-lucide="chevron-left"></i></button>
                                <button type="button" class="act-mini" title="Move later" aria-label="Move later" disabled="@(i == composerAtts.Count - 1)" @onclick="() => MoveAtt(a, 1)"><i data-lucide="chevron-right"></i></button>
                            }
                            <button type="button" class="del-btn" title="Remove attachment" aria-label="@($"Remove {a.FileName}")" @onclick="() => RemoveAtt(a)"><i data-lucide="x"></i></button>
                        </span>
                    }
                    @if (uploading) { <span class="composer-att-chip uploading"><i data-lucide="loader"></i> Uploading…</span> }
                </div>
            }

            <MailRteEditor @ref="rteRef" Value="@body" ValueChanged="OnBodyChanged" OnSubmit="SendNow" OnNotice="OnEditorNotice"
                           Placeholder="Write your message…" />
        </div>

        <div class="composer-foot">
            <div class="split-send">
                <button type="button" class="send-main" @onclick="SendNow" disabled="@sending" title="Send (Ctrl+Enter)">
                    <i data-lucide="send"></i>
                    @(sending ? "Sending…" : "Send")
                </button>
                <button type="button" class="send-arrow" @onclick="() => { sendDropdownOpen = !sendDropdownOpen; attDropdownOpen = false; }" title="Schedule send" aria-label="Schedule send" aria-haspopup="true" aria-expanded="@(sendDropdownOpen ? "true" : "false")">
                    <i data-lucide="chevron-down"></i>
                </button>
                @if (sendDropdownOpen)
                {
                    <div class="send-dropdown" @onclick:stopPropagation>
                        <button type="button" class="send-dropdown-item" @onclick="() => ScheduleSendPreset(1)">
                            <i data-lucide="sunrise"></i><span>Tomorrow morning</span><span class="hint">08:00</span>
                        </button>
                        <button type="button" class="send-dropdown-item" @onclick="() => ScheduleSendPreset(2)">
                            <i data-lucide="sun"></i><span>Tomorrow afternoon</span><span class="hint">13:00</span>
                        </button>
                        <button type="button" class="send-dropdown-item" @onclick="OpenCustomSchedule">
                            <i data-lucide="calendar-clock"></i><span>Pick date & time…</span>
                        </button>
                    </div>
                }
            </div>

            <div class="att-split-wrap">
                <button type="button" class="comp-btn" title="Attach files" @onclick="() => { attDropdownOpen = !attDropdownOpen; sendDropdownOpen = false; }" aria-haspopup="true" aria-expanded="@(attDropdownOpen ? "true" : "false")">
                    <i data-lucide="paperclip"></i><span>Attach</span><i data-lucide="chevron-down" class="mc-caret"></i>
                </button>
                <InputFile @ref="fileInputRef" OnChange="OnLocalFileSelected" class="mc-file-input" style="display:none" multiple />
                @if (attDropdownOpen)
                {
                    <div class="att-dropdown" @onclick:stopPropagation>
                        <button type="button" @onclick="TriggerLocalUpload"><i data-lucide="laptop"></i><span>From this computer</span></button>
                        <button type="button" @onclick="OpenSynologyPicker"><i data-lucide="hard-drive"></i><span>From iPop Files</span></button>
                    </div>
                }
            </div>

            <button type="button" class="comp-btn" @onclick="InsertSignature" title="Insert signature at the cursor">
                <i data-lucide="signature"></i><span>Signature</span>
            </button>

            <div style="flex:1"></div>

            <span class="draft-status" aria-live="polite">@DraftStatus</span>

            <button type="button" class="comp-btn icon-only danger" @onclick="DiscardDraft" title="Discard" aria-label="Discard">
                <i data-lucide="trash-2"></i>
            </button>
        </div>
        @if (sendDropdownOpen || attDropdownOpen)
        {
            <div class="mrte-pop-scrim" @onclick="() => { sendDropdownOpen = false; attDropdownOpen = false; }"></div>
        }
    </div>
}

@if (showCustomScheduleModal)
{
    <div class="syno-modal-overlay" @onclick="() => showCustomScheduleModal = false">
        <div class="syno-picker-dialog" style="max-width:420px" @onclick:stopPropagation>
            <div class="syno-picker-head">
                <span class="title"><i data-lucide="calendar-clock"></i> Schedule Send</span>
                <button type="button" class="icon-btn" title="Close" aria-label="Close" @onclick="() => showCustomScheduleModal = false"><i data-lucide="x"></i></button>
            </div>
            <div class="syno-picker-body" style="min-height:auto;padding:20px">
                <p style="font-size:12.5px;color:var(--ink-2);margin-bottom:12px">
                    Choose when this email should be sent. It will be stored in your <b>Scheduled</b> folder until the delivery time.
                </p>
                <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--ink)">
                    Select Date & Time:
                    <AppDateTimePicker @bind-Value="customScheduleTime" Min="DateTime.Now" Class="dp-block" AriaLabel="Send at" />
                </label>
            </div>
            <div class="syno-picker-foot">
                <button type="button" class="comp-btn" @onclick="() => showCustomScheduleModal = false">Cancel</button>
                <button type="button" class="btn" style="width:auto;margin:0" @onclick="ConfirmCustomSchedule">Set Schedule</button>
            </div>
        </div>
    </div>
}

<AddressBookDialog @ref="addressBook" />

<SynologyFilePickerDialog IsOpen="@showSynologyPicker"
                          IsOpenChanged="v => showSynologyPicker = v"
                          OnFilesSelected="OnSynologyFilesSelected" />

@code {
    public enum ComposerDockState { Docked, Minimized, Maximized }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback OnSent { get; set; }
    [Parameter] public EventCallback OnDiscard { get; set; }
    /// Opens Mail settings on the Templates section (the composer tucks itself away first).
    [Parameter] public EventCallback OnOpenTemplates { get; set; }

    private static readonly (string Val, string Label, string Icon)[] Priorities =
        [("high", "High importance", "flag"), ("normal", "Normal", "minus"), ("low", "Low importance", "arrow-down")];

    private ComposerDockState dockState = ComposerDockState.Docked;
    private MailRteEditor? rteRef;
    private InputFile? fileInputRef;

    private string subject = "";
    private string body = "";
    private string importance = "normal";
    private bool showCc;
    private bool showBcc;
    private List<MemberSearchRow> toRows = [];
    private List<MemberSearchRow> ccRows = [];
    private List<MemberSearchRow> bccRows = [];
    private List<MailAttachment> composerAtts = [];

    private Guid? editingDraftId;
    private Guid? inReplyToId;
    private Guid? threadRootId;
    // Forward mode: the original's attachments travel server-side; the user may drop some.
    private Guid? forwardOfId;
    private List<MailAttachment> forwardAtts = [];
    private bool IsForward => forwardOfId.HasValue;

    private bool sending;
    private bool uploading;
    private bool draftSaving;
    private DateTime? draftSavedAt;
    private bool sendDropdownOpen;
    private bool attDropdownOpen;
    private string? headPop;
    private bool showCustomScheduleModal;
    private bool showSynologyPicker;
    private DateTime customScheduleTime = DateTime.Now.AddHours(2);
    private CancellationTokenSource? autosaveCts;

    private ElementReference dropZoneRef;

    private bool isMeeting;
    private DateTime meetingStart;
    private DateTime meetingEnd;
    private int meetingReminderMin = 30;
    private string meetingLocation = "";

    private string HeaderTitle => !string.IsNullOrWhiteSpace(subject) ? subject : IsForward ? "Forward" : inReplyToId.HasValue ? "Reply" : "New Message";
    private string DraftStatus => draftSaving ? "Saving…" : draftSavedAt is { } t ? $"Saved {t:HH:mm}" : "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen)
        {
            await JS.InvokeVoidAsync("ipop.icons");
            await JS.InvokeVoidAsync("ipop.mailBindDropZone", dropZoneRef, ".mc-file-input");
            dropBound = true;
        }
        else if (dropBound)
        {
            // Rendered by MainLayout, so this runs on every shell render: unbind only once.
            dropBound = false;
            await JS.InvokeVoidAsync("ipop.mailUnbindDropZone", dropZoneRef);
        }
    }

    private string GetStateClass() => dockState switch
    {
        ComposerDockState.Minimized => "minimized",
        ComposerDockState.Maximized => "maximized",
        _ => "docked"
    };

    /// Every open path starts from here, so nothing from the previous message leaks in.
    private void ResetState()
    {
        // One composer at a time: whatever was unsaved goes to Drafts before it is replaced.
        if (IsOpen && dirtySince is not null) _ = SaveDraftCoreAsync();
        CancelAutosave();
        session++;
        dirtySince = null;
        _ = ClearUnloadStashAsync();
        editingDraftId = null;
        inReplyToId = null;
        threadRootId = null;
        forwardOfId = null;
        forwardAtts = [];
        subject = "";
        body = "";
        importance = "normal";
        toRows = [];
        ccRows = [];
        bccRows = [];
        composerAtts = [];
        showCc = false;
        showBcc = false;
        selectedLabelIds = [];
        isMeeting = false;
        meetingStart = DateTime.Now.Date.AddDays(1).AddHours(9);
        meetingEnd = meetingStart.AddHours(1);
        meetingReminderMin = 30;
        meetingLocation = "";
        draftSaving = false;
        draftSavedAt = null;
        sending = false;
        sendDropdownOpen = false;
        attDropdownOpen = false;
        headPop = null;
        dockState = ComposerDockState.Docked;
    }

    private void Show()
    {
        if (labels.Count == 0) _ = ReloadLabelsAsync();
        IsOpen = true;
        IsOpenChanged.InvokeAsync(true);
        StateHasChanged();
    }

    public void OpenNew(
        Guid? inReplyTo = null,
        Guid? threadRoot = null,
        string? initialSubject = null,
        string? initialBody = null,
        List<MemberSearchRow>? initialTo = null)
    {
        ResetState();
        inReplyToId = inReplyTo;
        threadRootId = threadRoot;
        subject = initialSubject ?? "";
        body = initialBody ?? "";
        toRows = initialTo ?? [];
        Show();
    }

    public void OpenForward(MailDetail original, string initialSubject, string initialBody)
    {
        ResetState();
        forwardOfId = original.Id;
        forwardAtts = original.Attachments.ToList();
        subject = initialSubject;
        body = initialBody;
        Show();
    }

    public void SetCcRows(List<MemberSearchRow> cc)
    {
        ccRows = cc;
        showCc = ccRows.Count > 0;
        StateHasChanged();
    }

    public void OpenDraft(MailDetail draft)
    {
        // Already open (e.g. the pill's draft clicked in the list): keep the local, newer copy.
        if (IsOpen && editingDraftId == draft.Id)
        {
            dockState = ComposerDockState.Docked;
            Show();
            return;
        }
        ResetState();
        editingDraftId = draft.Id;
        inReplyToId = draft.InReplyToId;
        threadRootId = draft.ThreadRootId;
        subject = draft.Subject ?? "";
        body = draft.Body ?? "";
        importance = draft.Importance ?? "normal";
        toRows = draft.Recipients.Where(r => r.RecipientType == "to").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        ccRows = draft.Recipients.Where(r => r.RecipientType == "cc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        bccRows = draft.Recipients.Where(r => r.RecipientType == "bcc").Select(r => new MemberSearchRow(r.Nik, r.Name, null, null)).ToList();
        showCc = ccRows.Count > 0;
        showBcc = bccRows.Count > 0;
        composerAtts = draft.Attachments.ToList();
        selectedLabelIds = draft.LabelIds.ToHashSet();
        if (ReadExtras(draft.DraftExtra) is { } x)
        {
            isMeeting = x.Meeting;
            if (x.Start is { } s) meetingStart = s;
            if (x.End is { } e) meetingEnd = e;
            meetingReminderMin = x.Reminder;
            meetingLocation = x.Location ?? "";
            forwardOfId = x.ForwardOf;
            forwardAtts = x.ForwardAtts ?? [];
        }
        Show();
    }

    /// Composer-only state a draft carries (the server stores it as-is).
    private sealed record DraftExtras(bool Meeting, DateTime? Start, DateTime? End, int Reminder, string? Location,
        Guid? ForwardOf, List<MailAttachment>? ForwardAtts);

    private string? WriteExtras() => !isMeeting && forwardOfId is null ? null
        : System.Text.Json.JsonSerializer.Serialize(new DraftExtras(isMeeting, isMeeting ? meetingStart : null, isMeeting ? meetingEnd : null,
            meetingReminderMin, isMeeting ? meetingLocation : null, forwardOfId, forwardOfId is null ? null : forwardAtts));

    private static DraftExtras? ReadExtras(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return System.Text.Json.JsonSerializer.Deserialize<DraftExtras>(json); }
        catch (System.Text.Json.JsonException) { return null; }
    }

    private void Minimize() { headPop = null; dockState = ComposerDockState.Minimized; }
