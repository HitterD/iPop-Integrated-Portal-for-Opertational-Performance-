@using IPop.Web.Services
@inject IPop.Web.Services.MailService MailSvc
@inject IJSRuntime JS
@inject IPop.Web.Services.AuthState Auth
@inject HttpClient Http

@*
    Conversation stack: every message in the thread, NEWEST first, so the latest reply is at the
    top and older history sits below it. The server pages newest-first (50 per page); older
    messages come in with "Load older messages" at the bottom. The opened message stays expanded
    with the "This message" badge and is scrolled into view when it is not the newest.

    Two facts drive this component:
      • The thread ROOT has ThreadRootId == null — only replies carry it. Testing ThreadRootId
        for null therefore hides the conversation on the very first message. The signal is
        ThreadCount; the thread key is (ThreadRootId ?? Id). See MailServiceTests
        Root_message_has_null_ThreadRootId_but_still_reports_its_replies.
      • MailSummary carries only a Snippet. Full bodies are fetched per message on expand
        (GET /api/mail/{id}), which reuses the endpoint that already enforces BCC visibility.
*@

<div class="thr-stack">
    @foreach (var msg in stack)
    {
        var m = msg;
        var isCurrent = m.Id == Detail.Id;
        var isOpen = expanded.Contains(m.Id);
        var body = isCurrent ? Detail : (bodies.TryGetValue(m.Id, out var b) ? b : null);

        <article class="thr-msg @(isOpen ? "open" : "collapsed") @(isCurrent ? "current" : "")"
                 data-thr-id="@m.Id" @key="m.Id"
                 aria-expanded="@(isOpen ? "true" : "false")">

            <header class="thr-head" role="button" tabindex="0"
                    @onclick="() => Toggle(m.Id)"
                    @onkeydown="e => OnHeadKey(e, m.Id)">
                <PersonAvatar Nik="@m.SenderNik" Name="@m.SenderName" Size="28" Class="thr-avatar" Decorative="true" />

                <div class="thr-who">
                    <span class="thr-name">@m.SenderName</span>
                    @if (isOpen && body is not null)
                    {
                        <span class="thr-to">to @RecipientsOf(body)</span>
                    }
                    else
                    {
                        <span class="thr-snip">@m.Snippet</span>
                    }
                </div>

                @if (m.HasAttachment)
                {
                    <i data-lucide="paperclip" class="thr-clip" title="Has attachment"></i>
                }
                @if (isCurrent)
                {
                    <span class="thr-badge-current">This message</span>
                }
                <time class="thr-time" title="@FullStamp(m.ReceivedAt)">@ShortStamp(m.ReceivedAt)</time>
                <i data-lucide="@(isOpen ? "chevron-up" : "chevron-down")" class="thr-caret"></i>
            </header>

            @if (isOpen)
            {
                <div class="thr-body mail-body-links">
                    @if (body is null)
                    {
                        <div class="thr-loading"><span class="skeleton"></span><span class="skeleton"></span></div>
                    }
                    else
                    {
                        @((MarkupString)body.Body)

                        <MailAttachmentCards Attachments="body.Attachments" />

                        <div class="thr-acts">
                            <button type="button" class="comp-btn" @onclick="() => OnReply.InvokeAsync(body)">
                                <i data-lucide="reply"></i> Reply
                            </button>
                            <button type="button" class="comp-btn" @onclick="() => OnForward.InvokeAsync(body)">
                                <i data-lucide="forward"></i> Forward
                            </button>
                        </div>
                    }
                </div>
            }
        </article>
    }

    @if (HasOlder)
    {
        <button type="button" class="thr-older comp-btn" disabled="@loadingOlder" @onclick="LoadOlderAsync">
            <i data-lucide="history"></i>
            @(loadingOlder ? "Loading…" : $"Load older messages ({totalCount - stack.Count})")
        </button>
    }
</div>

@code {
    /// The message the user opened from the list. Always rendered expanded, and its body is
    /// reused directly rather than re-fetched.
    [Parameter, EditorRequired] public MailDetail Detail { get; set; } = default!;

    [Parameter] public EventCallback<MailDetail> OnReply { get; set; }
    [Parameter] public EventCallback<MailDetail> OnForward { get; set; }

    private const int PageSize = 50;
    // Safety cap when paging back to reach an old opened message (50 × 20 = 1000 messages).
    private const int MaxAutoPages = 20;

    private List<MailSummary> stack = [];
    private readonly HashSet<Guid> expanded = [];
    private readonly Dictionary<Guid, MailDetail> bodies = [];
    private Guid loadedFor;
    private Guid threadKey;
    private int pagesLoaded;
    private int totalCount;
    private bool loadingOlder;
    private Guid? scrollTo;

    private bool HasOlder => threadKey != Guid.Empty && stack.Count < totalCount;

    protected override async Task OnParametersSetAsync()
    {
        if (Detail.Id == loadedFor) return;
        await LoadStackAsync(expandLatest: false);
    }

    public async Task ReloadAsync(bool expandLatest = false)
    {
        loadedFor = Guid.Empty;
        await LoadStackAsync(expandLatest);
    }

    private async Task LoadStackAsync(bool expandLatest)
    {
        var openedId = Detail.Id;
        loadedFor = openedId;
        expanded.Clear();
        bodies.Clear();
        threadKey = Guid.Empty;
        pagesLoaded = 0;
        totalCount = 0;
        scrollTo = null;

        // A message belongs to a conversation if it has replies (ThreadCount > 0) OR if it is
        // itself a reply (ThreadRootId != null or InReplyToId != null). The root message of a
        // thread has ThreadRootId == null, while a reply has ThreadCount == 0.
        var hasThread = Detail.ThreadCount > 0 || Detail.ThreadRootId is not null || Detail.InReplyToId is not null;
        if (hasThread)
        {
            var key = Detail.ThreadRootId ?? Detail.Id;
            var page = await MailSvc.GetThreadAsync(key, 1, PageSize);
            if (loadedFor != openedId) return;   // a different mail was opened while we waited
            stack = page?.Items?.ToList() ?? [];
            threadKey = key;
            pagesLoaded = 1;
            totalCount = page?.TotalCount ?? stack.Count;

            // The opened message may be older than the newest page: page back until it is in
            // the stack, so it can be shown expanded with its badge.
            while (!expandLatest && stack.Count < totalCount && stack.All(x => x.Id != openedId) && pagesLoaded < MaxAutoPages)
            {
                if (!await FetchNextPageAsync(openedId)) return;
            }
        }
        else
        {
            stack = [];
        }

        // Fall back to a stack of one so a standalone mail renders through the same path.
        if (stack.Count == 0) stack = [SelfAsSummary()];

        if (expandLatest && stack.Count > 0)
        {
            // Newest first: the reply just sent is at the top.
            var newest = stack[0];
            expanded.Add(newest.Id);
            if (newest.Id != Detail.Id) _ = FetchBodyAsync(newest.Id);
        }
        else
        {
            expanded.Add(Detail.Id);
            // Not the newest? Bring it into view inside the reading pane after render.
            if (stack.Count > 1 && stack[0].Id != Detail.Id) scrollTo = Detail.Id;
        }

        await JS.InvokeVoidAsync("ipop.icons");
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollTo is { } id)
        {
            scrollTo = null;
            await JS.InvokeAsync<bool>("ipop.scrollIntoView", $".thr-msg[data-thr-id=\"{id}\"]");
        }
        // Pasted images stored on the NAS are fetched with the token (see ipop.mailImages).
        if (HasStoredImages(Detail) || bodies.Values.Any(HasStoredImages))
            await JS.InvokeVoidAsync("ipop.mailImages.hydrate", ".thr-stack", Http.BaseAddress?.ToString() ?? "", Auth.AccessToken);
    }

    private static bool HasStoredImages(MailDetail? d) => d?.Body?.Contains("data-ipop-att", StringComparison.Ordinal) == true;

    /// Appends the next (older) page. Returns false when the opened mail changed meanwhile.
    private async Task<bool> FetchNextPageAsync(Guid openedId)
    {
        var page = await MailSvc.GetThreadAsync(threadKey, pagesLoaded + 1, PageSize);
        if (loadedFor != openedId) return false;
        var items = page?.Items ?? [];
        pagesLoaded++;
        if (page is not null) totalCount = page.TotalCount;
        var seen = stack.Select(x => x.Id).ToHashSet();
        stack.AddRange(items.Where(x => seen.Add(x.Id)));
        // An empty page means the count moved under us: stop offering more.
        if (items.Count == 0) totalCount = stack.Count;
        return true;
    }

    private async Task LoadOlderAsync()
    {
        if (loadingOlder || !HasOlder) return;
        loadingOlder = true;
        StateHasChanged();
        try
        {
            await FetchNextPageAsync(loadedFor);
        }
        finally
        {
            loadingOlder = false;
        }
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task FetchBodyAsync(Guid id)
    {
        if (bodies.ContainsKey(id)) return;
        var full = await MailSvc.GetAsync(id);
        if (full is not null) bodies[id] = full;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task Toggle(Guid id)
    {
        if (!expanded.Add(id)) expanded.Remove(id);
        StateHasChanged();

        // Bodies are fetched once, on first expand.
        if (expanded.Contains(id) && id != Detail.Id && !bodies.ContainsKey(id))
        {
            var full = await MailSvc.GetAsync(id);
            if (full is not null) bodies[id] = full;
            StateHasChanged();
        }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task OnHeadKey(KeyboardEventArgs e, Guid id)
    {
        if (e.Key is "Enter" or " ") await Toggle(id);
    }

    private MailSummary SelfAsSummary() => new(
        Detail.Id, Detail.SenderId, Detail.SenderName, Detail.SenderNik,
        Detail.Subject, "", Detail.SentAt,
        Detail.IsRead, Detail.IsStarred, Detail.Attachments.Count > 0,
        Detail.ThreadCount, false, Detail.ThreadRootId,
        Detail.IsPinned, Detail.Importance, Detail.ScheduledAt);

    private static string RecipientsOf(MailDetail d)
    {
        var names = d.RecipientGroups.Where(g => g.Field != "bcc").Select(g => g.Name)
            .Concat(d.Recipients.Where(r => r.RecipientType is "to" or "cc").Select(r => r.Name)).ToList();
        if (names.Count == 0) return d.HideRecipients ? "undisclosed recipients" : "—";
        // RecipientTotal counts people (a mass mail lists only the first few names).
        var more = Math.Max(names.Count - 1, d.RecipientTotal - 1);
        return names.Count <= 2 && d.RecipientTotal <= names.Count ? string.Join(", ", names) : $"{names[0]} +{more:N0}";
    }

    private static string ShortStamp(DateTime? t)
    {
        if (t is null) return "";
        var local = t.Value.ToLocalTime();
        if (local.Date == DateTime.Today) return local.ToString("HH:mm");
        if (local.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return local.ToString("dd MMM");
    }

    private static string FullStamp(DateTime? t)
        => t is null ? "" : t.Value.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm");

    private static string HumanSize(long b)
        => b switch { < 1024 => $"{b} B", < 1024 * 1024 => $"{b / 1024.0:0.#} KB", _ => $"{b / 1024.0 / 1024.0:0.#} MB" };

}
