@using IPop.Application.Chat
@using IPop.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject ChatState ChatSvc
@inject ChatAttachments Att
@inject OverlayStack Overlays

@* Sticker editor modal. The canvas work lives in wwwroot/js/sticker-editor.js; this component owns
   the chrome, talks to the module by id, and uploads the exported 512×512 image. *@
@if (isOpen)
{
    <div class="sticker-editor-backdrop">
        <div class="sticker-editor" role="dialog" aria-modal="true" aria-label="Create sticker">
            <div class="se-head">
                <div class="se-title">Create sticker</div>
                <button type="button" class="se-x" title="Close" aria-label="Close" @onclick="Close"><i data-lucide="x"></i></button>
            </div>

            <div class="se-body">
                <div class="se-stage-col">
                    <div class="se-stage @(source == "image" ? "has-image" : "") @(state.Tool == "draw" ? "drawing" : "")">
                        <canvas @ref="stageRef" width="512" height="512" aria-label="Sticker preview"></canvas>
                        @if (source != "image")
                        {
                            <div class="se-drop">
                                @if (source == "animated")
                                {
                                    <i data-lucide="film"></i>
                                    <strong>Animated stickers are uploaded as-is</strong>
                                    <span>It is resized to fit the sticker square on the server. Editing is available for still images only.</span>
                                }
                                else if (source == "loading")
                                {
                                    <i data-lucide="loader" class="spin"></i>
                                    <span>Opening image…</span>
                                }
                                else
                                {
                                    <i data-lucide="image-plus"></i>
                                    <strong>Choose a photo</strong>
                                    <span>or paste an image with Ctrl+V</span>
                                    <button type="button" class="btn-primary se-choose" @onclick="ChooseFile"><i data-lucide="upload"></i> Choose image</button>
                                    <small>JPG, PNG, WebP or GIF · up to 10 MB</small>
                                }
                            </div>
                        }
                    </div>
                    @if (source == "image")
                    {
                        <p class="se-status" data-seg="@state.Seg">
                            @switch (state.Seg)
                            {
                                case "loading": <span><i data-lucide="loader" class="spin"></i> Looking for a person…</span> break;
                                case "person": <span><i data-lucide="user-check"></i> Person found: background removed.</span> break;
                                case "none": <span><i data-lucide="info"></i> No person found. Drag to position, scroll or pinch to zoom.</span> break;
                                case "failed": <span><i data-lucide="info"></i> Background removal isn't available here. Drag to position, scroll or pinch to zoom.</span> break;
                            }
                        </p>
                        <div class="se-toolbar" role="toolbar" aria-label="Image tools">
                            <button type="button" title="Undo (Ctrl+Z)" aria-label="Undo" disabled="@(!state.CanUndo)" @onclick='() => Call("undo")'><i data-lucide="undo-2"></i></button>
                            <button type="button" title="Redo (Ctrl+Y)" aria-label="Redo" disabled="@(!state.CanRedo)" @onclick='() => Call("redo")'><i data-lucide="redo-2"></i></button>
                            <span class="se-sep"></span>
                            <button type="button" title="Rotate 90°" aria-label="Rotate" @onclick='() => Call("rotate")'><i data-lucide="rotate-cw"></i></button>
                            <button type="button" title="Flip" aria-label="Flip" @onclick='() => Call("flip")'><i data-lucide="flip-horizontal-2"></i></button>
                            <button type="button" title="Fit" aria-label="Fit" @onclick='() => Call("resetView")'><i data-lucide="maximize"></i></button>
                            <span class="se-sep"></span>
                            <button type="button" title="Another image" aria-label="Choose another image" @onclick="ChooseFile"><i data-lucide="image"></i></button>
                        </div>
                    }
                </div>

                @if (source == "image")
                {
                    <div class="se-side">
                        <div class="se-toggles">
                            <label class="se-switch @(PersonFound ? "" : "disabled")">
                                <input type="checkbox" checked="@state.RemoveBg" disabled="@(!PersonFound)" @onchange='e => CallArg("setRemoveBg", e.Value is true)' />
                                <span>Remove background</span>
                            </label>
                            <label class="se-switch @(PersonFound && state.RemoveBg ? "" : "disabled")">
                                <input type="checkbox" checked="@state.Outline" disabled="@(!PersonFound || !state.RemoveBg)" @onchange='e => CallArg("setOutline", e.Value is true)' />
                                <span>Outline</span>
                            </label>
                        </div>

                        <div class="se-tabs" role="tablist">
                            @foreach (var (key, label, icon) in Panels)
                            {
                                var k = key;
                                <button type="button" role="tab" class="@(panel == k ? "on" : "")" @onclick="() => SetPanel(k)"><i data-lucide="@icon"></i> @label</button>
                            }
                        </div>

                        @if (panel == "text")
                        {
                            <div class="se-panel">
                                <input class="se-text" type="text" maxlength="60" placeholder="Type a caption" @bind="textDraft" @bind:event="oninput" @onkeydown="TextKey" aria-label="Caption text" />
                                <div class="se-swatches" role="radiogroup" aria-label="Text color">
                                    @foreach (var c in Palette)
                                    {
                                        var col = c;
                                        <button type="button" role="radio" aria-checked="@(textColor == col ? "true" : "false")" class="se-swatch @(textColor == col ? "on" : "")" style="--sw:@col" title="@col" @onclick="() => SetTextColor(col)"></button>
                                    }
                                </div>
                                <label class="se-check"><input type="checkbox" checked="@textStroke" @onchange="e => SetTextStroke(e.Value is true)" /> Outline text</label>
                                <div class="se-row">
                                    @if (SelectedText)
                                    {
                                        <button type="button" class="btn-primary" disabled="@string.IsNullOrWhiteSpace(textDraft)" @onclick="UpdateText">Update text</button>
                                        <button type="button" class="se-ghost" @onclick="NewText">New text</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-primary" disabled="@string.IsNullOrWhiteSpace(textDraft)" @onclick="AddText"><i data-lucide="type"></i> Add text</button>
                                    }
                                </div>
                            </div>
                        }
                        else if (panel == "emoji")
                        {
                            <div class="se-panel se-emoji-grid">
                                @foreach (var em in Emoji)
                                {
                                    var e = em;
                                    <button type="button" class="se-emoji" @onclick='() => CallArg("addEmoji", e)'>@e</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="se-panel">
                                <div class="se-swatches" role="radiogroup" aria-label="Brush color">
                                    @foreach (var c in Palette)
                                    {
                                        var col = c;
                                        <button type="button" role="radio" aria-checked="@(brushColor == col ? "true" : "false")" class="se-swatch @(brushColor == col ? "on" : "")" style="--sw:@col" title="@col" @onclick="() => SetBrush(col, brushWidth)"></button>
                                    }
                                </div>
                                <label class="se-range">Thickness
                                    <input type="range" min="3" max="40" value="@brushWidth" @onchange='e => SetBrush(brushColor, int.TryParse(e.Value?.ToString(), out var w) ? w : 10)' />
                                </label>
                                <p class="se-hint">Draw on the sticker with your finger or mouse. Undo removes the last stroke.</p>
                            </div>
                        }

                        @if (state.Selected is not null)
                        {
                            <div class="se-selected">
                                <span>@(state.Selected.Kind == "emoji" ? "Emoji selected" : "Text selected") · drag to move, use the handle or pinch to resize and rotate</span>
                                <button type="button" class="se-ghost danger" @onclick='() => Call("deleteSelected")'><i data-lucide="trash-2"></i> Delete</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(error)) { <p class="se-error" role="alert">@error</p> }

            <div class="se-foot">
                <button type="button" class="se-ghost" @onclick="Close">Cancel</button>
                <span class="se-foot-sp"></span>
                <button type="button" class="se-ghost" disabled="@(!CanSave || busy)" @onclick="() => Save(false)">Save to my stickers</button>
                <button type="button" class="btn-primary" disabled="@(!CanSave || busy)" @onclick="() => Save(true)">
                    <i data-lucide="@(busy ? "loader" : "send")" class="@(busy ? "spin" : "")"></i> Save &amp; send
                </button>
            </div>
            <input @ref="fileRef" type="file" class="hidden-input" accept=".png,.jpg,.jpeg,.gif,.webp,image/png,image/jpeg,image/gif,image/webp" />
        </div>
    </div>
}

@code {
    /// Saved: the new sticker id, and whether the user asked to send it right away.
    [Parameter] public EventCallback<(Guid Id, bool Send)> OnSaved { get; set; }

    private static readonly string[] Palette = ["#FFFFFF", "#111111", "#FF3B30", "#FF9F0A", "#FFD60A", "#34C759", "#0A84FF", "#BF5AF2", "#FF2D55"];
    private static readonly string[] Emoji =
    [
        "😂", "🤣", "😍", "🥰", "😘", "😎", "🤩", "🥳", "🤔", "🫡", "🤗", "🤭", "😜", "🙃", "😬", "🙄",
        "😴", "🥺", "😭", "😡", "🤯", "😱", "🤓", "👻", "💀", "👍", "👎", "👏", "🙏", "👋", "👌", "✌️",
        "💪", "🙌", "❤️", "🔥", "✨", "🎉", "💯", "🚀", "🏆", "☕", "🎂", "✅", "💡", "👀", "⭐", "💬",
    ];
    private static readonly (string, string, string)[] Panels = [("text", "Text", "type"), ("emoji", "Emoji", "smile"), ("draw", "Draw", "pencil")];

    private bool isOpen;
    private ElementReference stageRef, fileRef;
    private IJSObjectReference? module;
    private DotNetObjectReference<StickerEditor>? selfRef;
    private int editorId;
    private bool mounting;
    private IDisposable? overlay;
    /// none | loading | image | animated | unsupported | error | too_large
    private string source = "none";
    private Guid? attachmentId;
    private string? pendingUrl;
    private EditorState state = new();
    private string panel = "text";
    private string textDraft = "", textColor = "#FFFFFF";
    private bool textStroke = true;
    private string brushColor = "#FFFFFF";
    private int brushWidth = 10;
    private string? lastSelectedKey;
    private bool busy;
    private string? error;

    private bool PersonFound => state.Seg == "person";
    private bool SelectedText => state.Selected?.Kind == "text";
    private bool CanSave => source is "image" or "animated";

    /// Opens empty: the user picks a file or pastes.
    public void Open() => OpenCore(null, null);

    /// "Make sticker" from a chat image: loads the attachment into the editor.
    public void OpenAttachment(Guid id) => OpenCore(id, null);

    private void OpenCore(Guid? attachment, string? url)
    {
        if (isOpen) return;
        isOpen = true;
        attachmentId = attachment;
        source = attachment is null ? "none" : "loading";
        pendingUrl = url;
        state = new();
        panel = "text"; textDraft = ""; error = null; busy = false; lastSelectedKey = null;
        overlay = Overlays.Push(() => { CloseCore(); StateHasChanged(); return Task.CompletedTask; });
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isOpen)
        {
            try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
        }
        if (!isOpen || editorId != 0 || mounting) return;
        mounting = true;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/sticker-editor.js?v=20261001-seg");
            selfRef ??= DotNetObjectReference.Create(this);
            editorId = await module.InvokeAsync<int>("mount", stageRef, selfRef, fileRef);
            await module.InvokeVoidAsync("call", editorId, "setBrush", brushColor, brushWidth);
            if (attachmentId is { } id)
            {
                var url = await Att.GetAsync(id, false);
                if (url is null) { source = "error"; error = "Couldn't open that image."; StateHasChanged(); return; }
                await module.InvokeVoidAsync("loadUrl", editorId, url, "image");
            }
        }
        catch (JSException) { error = "The sticker editor couldn't start in this browser."; StateHasChanged(); }
        finally { mounting = false; }
    }

    [JSInvokable]
    public Task OnSourceLoaded(string kind)
    {
        error = kind switch
        {
            "unsupported" => "This image format isn't supported. Use JPG, PNG, WebP or GIF.",
            "too_large" => "Image is too large (max 10 MB).",
            "error" => "Couldn't open that image.",
            _ => null,
        };
        source = kind is "image" or "animated" ? kind : (source == "image" ? "image" : "none");
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnEditorState(EditorState s)
    {
        state = s;
        // A text overlay was just selected on the canvas: load it into the caption controls.
        var key = s.Selected is { Kind: "text" } sel ? $"{sel.Text}|{sel.Color}|{sel.Stroke}" : null;
        if (key != lastSelectedKey && s.Selected is { Kind: "text" } t)
        {
            textDraft = t.Text ?? ""; textColor = t.Color ?? textColor; textStroke = t.Stroke;
            panel = "text";
        }
        lastSelectedKey = key;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ChooseFile() { if (module is not null) await module.InvokeVoidAsync("chooseFile", editorId); }
    private async Task Call(string method) { if (module is not null) await module.InvokeVoidAsync("call", editorId, method); }
    private async Task CallArg(string method, object arg) { if (module is not null) await module.InvokeVoidAsync("call", editorId, method, arg); }

    private async Task SetPanel(string p)
    {
        panel = p;
        if (module is not null) await module.InvokeVoidAsync("call", editorId, "setTool", p == "draw" ? "draw" : "move");
    }

    private async Task SetBrush(string color, int width)
    {
        brushColor = color; brushWidth = width;
        if (module is not null) await module.InvokeVoidAsync("call", editorId, "setBrush", color, width);
    }

    private async Task AddText()
    {
        if (module is null || string.IsNullOrWhiteSpace(textDraft)) return;
        await module.InvokeVoidAsync("call", editorId, "addText", textDraft, textColor, textStroke);
    }

    private async Task UpdateText()
    {
        if (module is not null) await module.InvokeVoidAsync("call", editorId, "updateSelected", textDraft, textColor, textStroke);
    }

    private async Task NewText()
    {
        textDraft = "";
        if (module is not null) await module.InvokeVoidAsync("call", editorId, "deselect");
    }

    private async Task SetTextColor(string c)
    {
        textColor = c;
        if (SelectedText && module is not null) await module.InvokeVoidAsync("call", editorId, "updateSelected", null, c, null);
    }

    private async Task SetTextStroke(bool on)
    {
        textStroke = on;
        if (SelectedText && module is not null) await module.InvokeVoidAsync("call", editorId, "updateSelected", null, null, on);
    }

    private async Task TextKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        if (SelectedText) await UpdateText(); else await AddText();
    }

    private async Task Save(bool send)
    {
        if (module is null || busy) return;
        busy = true; error = null;
        StateHasChanged();
        try
        {
            string? code;
            Guid? newId = null;
            if (source == "animated" && attachmentId is { } att)
            {
                // Keep the frames: the server converts the chat attachment itself.
                (code, newId) = await PostAsync(() => Auth.SendAsync(HttpMethod.Post, $"/api/chat/stickers/from-attachment/{att}"));
            }
            else
            {
                var animated = source == "animated";
                var bytes = await module.InvokeAsync<byte[]?>(animated ? "original" : "exportSticker", editorId);
                if (bytes is null || bytes.Length == 0) { error = "Couldn't create the sticker image."; return; }
                if (bytes.Length > StickerLimits.MaxUploadBytes) { error = "Image is too large (max 10 MB)."; return; }
                var mime = animated ? GuessMime(bytes) : await module.InvokeAsync<string>("exportMime", editorId);
                var name = "sticker" + (mime switch { "image/webp" => ".webp", "image/gif" => ".gif", "image/jpeg" => ".jpg", _ => ".png" });
                (code, newId) = await PostAsync(() =>
                {
                    var form = new MultipartFormDataContent();
                    var part = new ByteArrayContent(bytes);
                    part.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(mime);
                    form.Add(part, "file", name);
                    return Auth.SendMultipartAsync("/api/chat/stickers", form);
                });
            }
            if (code is not null) { error = ErrorText(code); return; }
            await ChatSvc.LoadStickersAsync(force: true);
            CloseCore();
            if (newId is { } nid) await OnSaved.InvokeAsync((nid, send));
        }
        catch (Exception) { error = "Couldn't save the sticker. Try again."; }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private static async Task<(string? Code, Guid? Id)> PostAsync(Func<Task<HttpResponseMessage>> call)
    {
        using var res = await call();
        if (res.IsSuccessStatusCode)
        {
            var dto = await System.Net.Http.Json.HttpContentJsonExtensions.ReadFromJsonAsync<StickerDto>(res.Content);
            return (null, dto?.Id);
        }
        try { return ((await System.Net.Http.Json.HttpContentJsonExtensions.ReadFromJsonAsync<ErrorBody>(res.Content))?.Code ?? "failed", null); }
        catch { return ("failed", null); }
    }

    private sealed record ErrorBody(string? Code);

    private static string GuessMime(byte[] b) =>
        b.Length > 3 && b[0] == 'G' && b[1] == 'I' && b[2] == 'F' ? "image/gif"
        : b.Length > 11 && b[8] == 'W' && b[9] == 'E' && b[10] == 'B' && b[11] == 'P' ? "image/webp"
        : "image/png";

    public static string ErrorText(string code) => code switch
    {
        "too_large" => "Image is too large (max 10 MB).",
        "not_an_image" or "invalid_image" => "The file must be a PNG, JPG, GIF or WebP image.",
        "limit_reached" => "My stickers is full (max 200). Remove a few first.",
        "not_found" => "Sticker or image not found.",
        _ => "Couldn't process the sticker. Try again.",
    };

    private void Close() => CloseCore();

    private void CloseCore()
    {
        if (!isOpen) return;
        isOpen = false;
        overlay?.Dispose(); overlay = null;
        var id = editorId; editorId = 0;
        if (id != 0 && module is not null) _ = module.InvokeVoidAsync("unmount", id).AsTask().ContinueWith(_ => { });
    }

    public async ValueTask DisposeAsync()
    {
        overlay?.Dispose();
        if (module is not null)
        {
            try
            {
                if (editorId != 0) await module.InvokeVoidAsync("unmount", editorId);
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        selfRef?.Dispose();
    }

    public sealed class EditorState
    {
        public bool HasImage { get; set; }
        public string Seg { get; set; } = "idle";
        public bool RemoveBg { get; set; }
        public bool Outline { get; set; }
        public bool CanUndo { get; set; }
        public bool CanRedo { get; set; }
        public string Tool { get; set; } = "move";
        public SelectedOverlay? Selected { get; set; }
    }

    public sealed class SelectedOverlay
    {
        public string Kind { get; set; } = "";
        public string? Text { get; set; }
        public string? Color { get; set; }
        public bool Stroke { get; set; }
    }
}
