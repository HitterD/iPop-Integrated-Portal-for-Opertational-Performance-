@using IPop.Application.Chat
@using IPop.Web.Models
@using IPop.Web.Services
@inject AuthState Auth
@inject ChatState ChatSvc

@if (shouldShow)
{
    <div class="seen-wrap" @onkeydown="OnKey">
        <button type="button" class="seen-by seen-clickable @(allRead ? "seen-all" : "")" aria-haspopup="dialog" aria-expanded="@(listOpen ? "true" : "false")"
                title="Message info" @onclick="ToggleList" @onclick:stopPropagation>
            @if (allRead)
            {
                @* Inline SVG (lucide check-check): data-lucide placeholders aren't re-hydrated on re-render. *@
                <svg class="seen-all-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 7 17l-5-5" /><path d="m22 10-7.5 7.5L13 16" /></svg>
            }
            else
            {
                @foreach (var r in (Message.ReadPreview ?? visibleAvatars))
                {
                    var reader = r;
                    <PersonAvatar Nik="@NikOf(reader.UserId)" Name="@reader.UserName" Size="16" Class="seen-avatar avatar" Decorative="true" />
                }
            }
            <span class="seen-label">@SummaryLabel</span>
        </button>
        @if (listOpen)
        {
            <div class="seen-backdrop" @onclick="Close" @onclick:stopPropagation></div>
            <div class="seen-pop" role="dialog" aria-label="Message info" @onclick:stopPropagation>
                <div class="seen-pop-head">
                    <span class="seen-pop-title">Message info</span>
                    <span class="seen-pop-count">@readers.Count / @activeMemberCount</span>
                    <button type="button" class="seen-close" aria-label="Close" @onclick="Close"><i data-lucide="x"></i></button>
                </div>
                @if (loading && readers.Count == 0) { <div class="seen-state">Loading…</div> }
                else if (!string.IsNullOrEmpty(listError)) { <div class="seen-state seen-error">@listError</div> }
                else
                {
                    <div class="seen-pop-body">
                        <div class="seen-section"><i data-lucide="check-check"></i> Read by <b>@readers.Count</b></div>
                        @foreach (var r in readers)
                        {
                            @Row(r, r.ReadAt is { } at ? at.ToLocalTime().ToString("d MMM, HH:mm") : null)
                        }
                        @if (pending.Count > 0)
                        {
                            <div class="seen-section"><i data-lucide="check"></i> Not read yet <b>@pending.Count</b></div>
                            @foreach (var r in pending)
                            {
                                @Row(r, r.DeliveredAt is not null ? "Delivered" : "Not delivered")
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@implements IDisposable

@code {
    [Parameter] public MessageDto Message { get; set; } = default!;
    [Parameter] public string? CurrentUserNik { get; set; }
    [Parameter] public string? RoomType { get; set; }
    private bool listOpen;
    private bool loading;
    private string? listError;
    private List<SeenByDto> readers = [];
    private List<SeenByDto> pending = [];
    private List<SeenByDto> visibleAvatars = [];
    private int activeMemberCount;
    private Guid? loadedFor;

    // Summary comes from the message itself (ChatState patches ReadCount/ReadPreview on seenUpdate),
    // so every own bubble can show it without one request per message; the full list loads on click.
    private int readCount => Message.ReadCount ?? readers.Count;
    private int readTotal => Message.ReadTotal ?? activeMemberCount;
    private bool allRead => readTotal > 0 && readCount >= readTotal;

    private string SummaryLabel => allRead ? "Read all" : $"Seen by {readCount} of {readTotal}";

    private bool shouldShow =>
        RoomType == "group"
        && Message.SenderNik == CurrentUserNik
        && Message.Type != "system"
        && readCount > 0;

    private RenderFragment Row(SeenByDto r, string? meta) => __builder =>
    {
        <div class="seen-row">
            <PersonAvatar Nik="@NikOf(r.UserId)" Name="@r.UserName" Size="24" Class="avatar avatar-24" Decorative="true" />
            <span class="seen-name" title="@r.UserName">@r.UserName</span>
            @if (meta is not null) { <span class="seen-time">@meta</span> }
        </div>
    };

    protected override async Task OnParametersSetAsync()
    {
        ChatSvc.SeenUpdated -= OnSeenUpdate;
        if (RoomType != "group" || Message.SenderNik != CurrentUserNik || Message.Type == "system") return;
        ChatSvc.SeenUpdated += OnSeenUpdate;
        if (Message.ReadCount is not null || loadedFor == Message.Id) return;
        loadedFor = Message.Id;
        await RefreshReaders();
    }

    private async Task RefreshReaders()
    {
        try
        {
            var detail = await Auth.GetAsync<SeenListDto>($"/api/chat/messages/{Message.Id}/seen");
            if (detail != null)
            {
                readers = detail.Readers.ToList();
                pending = detail.Pending?.ToList() ?? [];
                activeMemberCount = detail.ActiveMemberCount;
                visibleAvatars = readers.Take(3).ToList();
                listError = null;
            }
        }
        catch (Exception ex)
        {
            listError = ex.Message;
        }
    }

    private async void OnSeenUpdate(SeenUpdateDto u)
    {
        if (u.MessageId != Message.Id || (!listOpen && Message.ReadCount is not null)) return;
        await RefreshReaders();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleList()
    {
        listOpen = !listOpen;
        if (listOpen) { loading = true; await RefreshReaders(); loading = false; }
    }

    private void Close() => listOpen = false;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") listOpen = false;
    }

    // SeenByDto carries no NIK; the active room's member list maps the user id to one.
    private string? NikOf(Guid userId) => ChatSvc.ActiveRoom?.Members.FirstOrDefault(m => m.UserId == userId)?.Nik;

    public void Dispose() => ChatSvc.SeenUpdated -= OnSeenUpdate;
}
