@using IPop.Web.Services
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IPop.Web.Services.NotificationState Notifs
@inject IJSRuntime JS
@implements IDisposable

@* ToastHost: macOS-style glass cards for feedback on the user's own actions (saved,
   failed, undo). Incoming notifications use GlobalNotificationBanner instead; a toast
   that still carries a NotificationId follows the notification preferences.
   Hover or focus pauses the countdown. Styles live in css/components/overlays.css. *@
<div class="toast-host" aria-live="polite" aria-relevant="additions">
    @foreach (var t in Toasts.Active)
    {
        var toast = t;
        if (toast.IsIncoming && !Notifs.CurrentEnableNotifications) continue;
        var clickable = !string.IsNullOrEmpty(toast.TargetUrl);
        var kind = toast.Kind.ToString().ToLowerInvariant();
        var title = toast.Title;
        <div @key="toast.Id"
             class="toast @kind @(clickable ? "clickable" : "") @(toast.IsExiting ? "exiting" : "") @(toast.IsPaused ? "paused" : "") @(toast.Undo is not null ? "has-undo" : "")"
             style="@(toast.Undo is not null ? $"--mi-undo-ms:{toast.UndoMs}ms" : null)"
             role="@(toast.Kind is ToastKind.Error or ToastKind.Warning ? "alert" : "status")"
             tabindex="-1"
             @onmouseenter="() => Toasts.Pause(toast.Id)"
             @onmouseleave="() => Toasts.Resume(toast.Id)"
             @onfocusin="() => Toasts.Pause(toast.Id)"
             @onfocusout="() => Toasts.Resume(toast.Id)"
             @onclick="() => OnToastClick(toast)">
            <span class="toast-icon" aria-hidden="true"><i data-lucide="@(toast.Icon ?? DefaultIcon(toast.Kind))"></i></span>
            <span class="toast-body">
                @if (title is null)
                {
                    @* A one-line toast reads best as its own headline. *@
                    <span class="toast-title">@toast.Message</span>
                }
                else
                {
                    <span class="toast-title">@title</span>
                    @if (!toast.IsIncoming || Notifs.CurrentShowPreview)
                    {
                        <span class="toast-msg">@toast.Message</span>
                    }
                }
            </span>
            @if (toast.Undo is not null || !string.IsNullOrEmpty(toast.NotificationId) || clickable)
            {
                <span class="toast-actions">
                    @if (toast.Undo is not null)
                    {
                        <button type="button" class="toast-action" @onclick="() => Toasts.RunUndoAsync(toast.Id)" @onclick:stopPropagation>@(toast.UndoLabel ?? "Undo")</button>
                    }
                    @if (!string.IsNullOrEmpty(toast.NotificationId))
                    {
                        <button type="button" class="toast-action" @onclick="() => MarkAsRead(toast)" @onclick:stopPropagation>Mark read</button>
                    }
                    @if (clickable)
                    {
                        <span class="toast-go" aria-hidden="true"><i data-lucide="chevron-right"></i></span>
                    }
                </span>
            }
            <button type="button" class="toast-close" aria-label="Dismiss notification" title="Dismiss"
                    @onclick="() => Toasts.Dismiss(toast.Id)" @onclick:stopPropagation>
                <i data-lucide="x"></i>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Toasts.Changed += OnChanged;
        Notifs.PreferencesChanged += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Toasts.Active.Count == 0) return;
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }

    // Bare glyphs: the coloured circle behind them is drawn by .toast-icon.
    internal static string DefaultIcon(ToastKind kind) => kind switch
    {
        ToastKind.Success => "check",
        ToastKind.Error => "x",
        ToastKind.Warning => "alert-triangle",
        _ => "info",
    };

    private void OnToastClick(Toast toast)
    {
        if (string.IsNullOrEmpty(toast.TargetUrl)) return;
        Toasts.Dismiss(toast.Id);
        Nav.NavigateTo(toast.TargetUrl);
    }

    private async Task MarkAsRead(Toast toast)
    {
        if (Guid.TryParse(toast.NotificationId, out var nid))
        {
            try { await Notifs.MarkReadAsync(nid); } catch { }
        }
        Toasts.Dismiss(toast.Id);
    }

    public void Dispose()
    {
        Toasts.Changed -= OnChanged;
        Notifs.PreferencesChanged -= OnChanged;
    }
}
