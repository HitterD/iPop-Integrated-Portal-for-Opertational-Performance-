@using IPop.Application.Chat
@using IPop.Application.Chat.Mentions
@using IPop.Web.Models
@using IPop.Web.Services
@inject ChatState ChatSvc
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav

<div class="@(Bare ? "msg-inner" : FullMessageClass)" @oncontextmenu="(e) => OnCtx.InvokeAsync((Message.Id, e))" @oncontextmenu:preventDefault>
    @if (!isSent && Message.Type != "system" && Message.Type != "emergency" && ChatSvc.ActiveRoom?.Type == "group")
    {
        <button type="button" class="msg-avatar avatar avatar-btn hover-lift" style="@AvatarPhotos.Style(Message.SenderNik)" @onclick="() => OnProfile.InvokeAsync(Message.SenderNik)">
            @Initials(Message.SenderName)
            <span class="avatar-ring"></span>
        </button>
    }
    <div class="bubble-wrap">
        @if (!isSent && Message.Type != "system" && Message.Type != "emergency" && ChatSvc.ActiveRoom?.Type == "group")
        {
            var senderMember = ChatSvc.ActiveRoom?.Members.FirstOrDefault(m => m.Nik == Message.SenderNik);
            <div class="sender">
                <span class="sender-name" style="color:@Color(Message.SenderNik)">@IPop.Application.PersonName.Display(Message.SenderName)</span>
                @if (senderMember?.Role is "owner")
                {
                    <span class="role-badge owner">Owner</span>
                }
                else if (senderMember?.Role is "admin")
                {
                    <span class="role-badge admin">Admin</span>
                }
            </div>
        }
        <div class="bubble @BubbleModifierClass @(MentionsMe ? "mention-me" : "") @(Message.IsDeleted ? "deleted" : "")">
            @if (Message.Type == "emergency") { <i data-lucide="alert-triangle"></i> }
            @if (Message.Type == "system") { <i data-lucide="@SystemIcon" class="sys-icon"></i> }
            @if (IsForwarded)
            {
                @if (OnForwardOpen.HasDelegate && !Message.IsDeleted)
                {
                    @* Opens the chat the message came from and jumps to the original (server decides what this viewer may open). *@
                    <button type="button" class="forwarded-tag fwd-link" title="View the original message"
                            @onclick="() => OnForwardOpen.InvokeAsync(Message.Id)" @onclick:stopPropagation="true">
                        <i data-lucide="forward"></i> Forwarded@(string.IsNullOrEmpty(Message.ForwardedFromSenderName) ? "" : $" · {Message.ForwardedFromSenderName}")
                    </button>
                }
                else
                {
                    <div class="forwarded-tag" title="@(string.IsNullOrEmpty(Message.ForwardedFromSenderName) ? "This message was forwarded from another conversation" : $"Forwarded from {Message.ForwardedFromSenderName}")">
                        <i data-lucide="forward"></i> Forwarded@(string.IsNullOrEmpty(Message.ForwardedFromSenderName) ? "" : $" · {Message.ForwardedFromSenderName}")
                    </div>
                }
            }
            @if (Message.ReplyPreview is not null)
            {
                @if (Message.ReplyToId is { } replyTo && OnReplyOpen.HasDelegate)
                {
                    @* stopPropagation: the row's own click toggles the mobile tools. *@
                    <button type="button" class="reply-quote rq-link" title="Go to the original message"
                            @onclick="() => OnReplyOpen.InvokeAsync(replyTo)" @onclick:stopPropagation="true">
                        <span class="rq-name">@IPop.Application.PersonName.Display(Message.ReplyPreview.SenderName)</span>@Message.ReplyPreview.Content
                    </button>
                }
                else
                {
                    <div class="reply-quote"><div class="rq-name">@IPop.Application.PersonName.Display(Message.ReplyPreview.SenderName)</div>@Message.ReplyPreview.Content</div>
                }
            }
            @if (Message.IsDeleted) { <em class="deleted-text"><i data-lucide="ban"></i> @Message.Content</em>@Meta(true) }
            else if (Message.Type == "sticker")
            {
                @if (StickerLimits.CustomId(Message.Type, Message.Content) is { } stickerId)
                {
                    <div class="sticker-msg custom"><img class="sticker-img" src="@ChatSvc.StickerImageUrl(stickerId)" alt="Sticker" loading="lazy" draggable="false" /></div>
                }
                else if (FluentStickers.Find(StickerLimits.FluentSlug(Message.Type, Message.Content)) is { } fluent)
                {
                    <div class="sticker-msg custom fluent"><img class="sticker-img" src="@fluent.ImagePath" alt="@fluent.Label" title="@fluent.Label" loading="lazy" draggable="false" /></div>
                }
                else
                {
                    <div class="sticker-msg"><div class="sticker-big"><i data-lucide="@Message.Content"></i></div></div>
                }
            }
            else if (Message.Type == "event")
            {
                <div class="msg-event-card hover-lift" @onclick="() => OnEventOpen.InvokeAsync(Message.Id)" @onclick:stopPropagation>
                    <div class="ev-icon">
                        <i data-lucide="calendar-clock"></i>
                    </div>
                    <div class="ev-t">
                        <div class="ev-title">@Message.Content</div>
                        <div class="ev-when">@Message.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                    <i data-lucide="chevron-right" class="ev-chev"></i>
                </div>
            }
            else if (NoteCard(Message) is { } note)
            {
                <button type="button" class="notecard" style="--pc:@NoteAccentHex(note.Accent)" @onclick='() => Nav.NavigateTo("/notes/" + note.Id)' @onclick:stopPropagation>
                    <div class="nc-cover" style='@(note.Cover is null ? "" : "--cover:var(--cv-" + note.Cover + ")")'><span class="nc-emo">@(note.Emoji ?? "📄")</span></div>
                    <div class="nc-body">
                        <div class="nc-kind"><i data-lucide="notebook-pen"></i>Note</div>
                        <div class="nc-title">@(string.IsNullOrWhiteSpace(note.Title) ? "Untitled" : note.Title)</div>
                        @if (!string.IsNullOrWhiteSpace(note.Excerpt)) { <div class="nc-ex">@note.Excerpt</div> }
                    </div>
                    <div class="nc-foot"><span>Open note</span><span class="perm"><i data-lucide="@(note.Level == "edit" ? "pencil" : note.Level == "comment" ? "message-square" : "eye")"></i>@(note.Level == "edit" ? "Can edit" : note.Level == "comment" ? "Can comment" : "Can view")</span></div>
                </button>
            }
            else if (IsPollMessage(Message))
            {
                <PollView PollJson="@ExtractPollJson(Message.Content)" MessageId="Message.Id" />
            }
            else
            {
                @if (Attachments.Count > 0)
                {
                    <div class="msg-attachments">
                        @foreach (var attachment in Attachments)
                        {
                            var currentAttachment = attachment;
                            <ChatAttachment Attachment="currentAttachment" OnOpen="OnAttachmentOpen" />
                        }
                    </div>
                }
                @if (PreviewUrl is { } previewUrl)
                {
                    @* One bubble: preview on top, the message (with its link) underneath. *@
                    <LinkPreviewCard @key="previewUrl" Url="@previewUrl" InBubble="true" />
                }
                @if (!string.IsNullOrWhiteSpace(Message.Content) && !IsAttachmentPlaceholder(Message))
                {
                    <div class="message-text">
                        @((MarkupString)RenderedContent)@if (MetaMode == "text") { @Meta(true) }
                    </div>
                }
            }
            @if (Message.Type != "system") { @Meta(false) }
        </div>
        @if (Reactions.Count > 0)
        {
            <div class="reactions">
                @foreach (var r in Reactions)
                {
                    var reaction = r;
                    var moved = _reactionMoves.TryGetValue(reaction.Emoji, out var dir) ? dir : 0;
                    @* Micro #11: only a reaction that just appeared or changed count animates; the keyed
                       spans are re-created per count, so the roll replays on every change. *@
                    <span @key="reaction.Emoji" class="pill @(reaction.CurrentUserReacted ? "mine" : "") hover-pop @(moved > 0 ? "mi-react-up" : moved < 0 ? "mi-react-down" : "")" @onclick="() => OnReact.InvokeAsync((Message.Id, reaction.Emoji))" @onclick:stopPropagation>
                        <span @key="@("e" + reaction.Count)" class="emoji">@reaction.Emoji</span>
                        <span @key="@("c" + reaction.Count)" class="count">@reaction.Count</span>
                    </span>
                }
            </div>
        }
        @if (Message.ThreadReplyCount > 0)
        {
            <div class="thread-link hover-lift" @onclick="() => OnThread.InvokeAsync(Message.Id)" @onclick:stopPropagation>
                <i data-lucide="messages-square"></i>
                <span>@Message.ThreadReplyCount replies</span>
                <i data-lucide="chevron-right" class="thread-arrow"></i>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public MessageDto Message { get; set; } = default!;
    [Parameter] public EventCallback<(Guid, Microsoft.AspNetCore.Components.Web.MouseEventArgs)> OnCtx { get; set; }
    [Parameter] public EventCallback<string> OnProfile { get; set; }
    [Parameter] public EventCallback<(Guid, string)> OnReact { get; set; }
    [Parameter] public EventCallback<Guid> OnThread { get; set; }
    [Parameter] public EventCallback<AttachmentDto> OnAttachmentOpen { get; set; }
    [Parameter] public EventCallback<Guid> OnEventOpen { get; set; }
    /// Click on "Forwarded · Name": the host looks up where it leads for this viewer.
    [Parameter] public EventCallback<Guid> OnForwardOpen { get; set; }
    /// Click on the reply quote: the host scrolls to the replied-to message (by its id).
    [Parameter] public EventCallback<Guid> OnReplyOpen { get; set; }
    /// Group rooms show a receipt on every own message: "Read by 2 of 5" / "Read by all".
    [Parameter] public bool IsGroup { get; set; }
    /// When true, renders .msg-inner instead of .msg.{sent|recv} because the parent loop already wraps the row in .msg.
    [Parameter] public bool Bare { get; set; }

    /// Where the time + ticks sit inside the bubble (WhatsApp-style):
    /// "text" — bottom-right on the last line (a hidden copy in the text reserves its room);
    /// "media" — dark overlay on an image; "float" — small pill beside a sticker / big emoji;
    /// "block" — own right-aligned row under cards (event, note, poll, files).
    private string MetaMode
    {
        get
        {
            if (isMediaOnly) return hasOnlyImages ? "media" : "block";
            if (JumboCount > 0 || IsImageSticker) return "float";
            if (Message.IsDeleted) return "text";
            if (Message.Type is "sticker" or "event" || NoteCard(Message) is not null || IsPollMessage(Message)) return "block";
            return !string.IsNullOrWhiteSpace(Message.Content) && !IsAttachmentPlaceholder(Message) ? "text" : "block";
        }
    }

    /// pin · HH:mm · edited · delivery ticks. <paramref name="ghost"/> renders an invisible copy
    /// inline at the end of the text so the real (absolute) one never covers the last words.
    private RenderFragment Meta(bool ghost) => __builder =>
    {
        var ds = Message.DeliveryStatus;
        var (statusCls, statusLabel) = isPending ? ("pending", "Sending") : isFailed ? ("failed", "Not sent")
            : ds == "read" ? ("read", "Read") : ds == "delivered" ? ("delivered", "Delivered") : ("sent", "Sent");
        <span class="bmeta @(ghost ? "ghost" : MetaMode)" aria-hidden="@(ghost ? "true" : null)">
            @if (IsPinned) { <svg class="meta-pin" viewBox="0 0 24 24" aria-label="Pinned"><path d="M12 17v5" /><path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z" /></svg> }
            @if (Message.EditedAt is not null) { <span class="edited">edited</span> }
            <span class="t">@Message.CreatedAt.ToLocalTime().ToString("HH:mm")</span>
            @if (isSent)
            {
                @* Inline SVG ticks: data-lucide placeholders aren't re-hydrated when the status changes. *@
                @* Micro #18: keyed by state so sent → delivered → read re-creates the tick and it pops once. *@
                <span @key="statusCls" class="msg-status @statusCls @(!ghost && _tickPop ? "mi-tick" : "")" title="@statusLabel" aria-label="@statusLabel">
                    @switch (statusCls)
                    {
                        case "pending":
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                            break;
                        case "failed":
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 8v4" /><path d="M12 16h.01" /></svg>
                            break;
                        case "sent":
                            <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                            break;
                        default:
                            <svg class="dbl" viewBox="0 0 24 24"><path d="M18 6 7 17l-5-5" /><path d="m22 10-7.5 7.5L13 16" /></svg>
                            break;
                    }
                </span>
            }
        </span>
    };
    [Parameter] public bool IsPinned { get; set; }

    /// Orange v6 ring on received messages that mention the viewer (directly or via @all).
    private bool MentionsMe =>
        !isSent && !Message.IsDeleted && Auth.Me?.Nik is { Length: > 0 } me
        && (Message.MentionsAll || (Message.MentionedNiks?.Contains(me) ?? false));

    private IReadOnlyList<AttachmentDto> Attachments => Message.Attachments ?? Array.Empty<AttachmentDto>();
    private IReadOnlyList<ReactionGroupDto> Reactions => Message.Reactions ?? Array.Empty<ReactionGroupDto>();
    private bool isSent => Message.SenderNik == Auth.Me?.Nik;

    private bool IsForwarded =>
        Message.ForwardedFromSenderName is not null ||
        Message.Content?.StartsWith("[forwarded]") == true;

    private string FullMessageClass
    {
        get
        {
            var classes = msgClass;
            if (isPending) classes += " pending";
            if (isFailed) classes += " failed";
            return classes;
        }
    }
    private string msgClass => Message.Type switch { "system" => "msg system", "emergency" => "msg emergency", _ => isSent ? "msg sent" : "msg recv" };

    private bool isPending => ChatSvc.IsPending(Message.Id);
    private bool isFailed => ChatSvc.IsFailed(Message.Id);

    private static bool IsAttachmentPlaceholder(MessageDto m) =>
        (m.Attachments?.Count ?? 0) > 0 &&
        (string.IsNullOrWhiteSpace(m.Content) || m.Content.Trim() == "(attachment)");

    private bool isMediaOnly =>
        Attachments.Count > 0 &&
        IsAttachmentPlaceholder(Message) &&
        Message.ReplyPreview is null &&
        Message.Type != "emergency" &&
        Message.Type != "sticker";

    /// 1–3 emoji and nothing else (plain text message, no reply/forward/attachments) → big emoji.
    private int JumboCount =>
        Message.Type is null or "" or "text" && !Message.IsDeleted && Attachments.Count == 0 && Message.ReplyPreview is null && !IsForwarded
            ? ChatFormatters.JumboEmojiCount(Message.Content) : 0;

    /// Custom and Fluent stickers float without a bubble; legacy Lucide stickers keep their tray card.
    private bool IsImageSticker =>
        !Message.IsDeleted && Message.ReplyPreview is null && !IsForwarded
        && (StickerLimits.CustomId(Message.Type, Message.Content) is not null
            || FluentStickers.Find(StickerLimits.FluentSlug(Message.Type, Message.Content)) is not null);

    private bool hasOnlyImages => Attachments.Count > 0 && Attachments.All(ChatAttachments.IsImage);

    private string BubbleModifierClass
    {
        get
        {
            if (isMediaOnly)
                return hasOnlyImages ? "media-only media-image-only" : "media-only media-card-only";
            if (JumboCount > 0) return $"jumbo-emoji jumbo-{JumboCount}";
            if (IsImageSticker) return "sticker-only";
            if (Attachments.Count > 0 && !string.IsNullOrWhiteSpace(Message.Content) && !IsAttachmentPlaceholder(Message))
                return hasOnlyImages ? "has-media-and-text media-captioned" : "has-media-and-text";
            return PreviewUrl is not null ? "has-link-preview" : "";
        }
    }

    // Mention + markdown rendering is the costliest part of a bubble; reuse it until the
    // text or the room's member directory actually changes.
    private string? _htmlFor;
    private ChatRoomDto? _htmlRoom;
    private string _html = "";

    private string RenderedContent
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Message.Content) || IsAttachmentPlaceholder(Message))
                return "";
            var room = ChatSvc.ActiveRoom;
            if (ReferenceEquals(_htmlFor, Message.Content) && ReferenceEquals(_htmlRoom, room)) return _html;
            var text = Message.Content.StartsWith("[forwarded]") ? Message.Content.Substring("[forwarded]".Length).TrimStart() : Message.Content;
            var dir = new SimpleDir(room);
            var html = MentionRenderer.ToHtml(text, dir, room?.Type == "group", Auth.Me?.Nik, LegacyMentionNames(room));
            (_htmlFor, _htmlRoom, _html) = (Message.Content, room, ChatFormatters.FormatMarkdown(html));
            return _html;
        }
    }

    // First web link of a plain text message gets one preview card, unless the sender removed it.
    private string? _previewFor;
    private string? _previewUrl;
    private string? PreviewUrl
    {
        get
        {
            if (Message.IsDeleted || Message.LinkPreviewOff || Message.Type is "system" or "sticker" or "event" or "emergency"
                || string.IsNullOrWhiteSpace(Message.Content) || IsAttachmentPlaceholder(Message)
                || Message.Content.StartsWith("[note]") || IsPollMessage(Message)) return null;
            if (!ReferenceEquals(_previewFor, Message.Content))
                (_previewFor, _previewUrl) = (Message.Content, MentionRenderer.FirstWebLink(Message.Content));
            return _previewUrl;
        }
    }

    // ---- Micro-interactions (#11 reaction pop, #18 tick pop) ----
    // Only changes seen by this live bubble animate; a bubble painted from history never does.
    private Guid _motionFor;
    private Dictionary<string, int>? _lastReactionCounts;
    private Dictionary<string, int> _reactionMoves = new();
    private string? _lastStatus;
    private bool _tickPop;

    private string StatusClass
    {
        get
        {
            var ds = Message.DeliveryStatus;
            return isPending ? "pending" : isFailed ? "failed" : ds == "read" ? "read" : ds == "delivered" ? "delivered" : "sent";
        }
    }

    protected override void OnParametersSet()
    {
        var counts = Reactions.ToDictionary(r => r.Emoji, r => r.Count);
        var status = isSent ? StatusClass : null;
        if (_motionFor != Message.Id)
        {
            // First paint of this bubble. The confirmed echo of our own send replaces the optimistic
            // bubble (new id, new component), so a just-sent message still pops its first tick.
            _motionFor = Message.Id;
            _reactionMoves = new();
            _tickPop = status is "sent" or "delivered" or "read" && DateTime.UtcNow - Message.CreatedAt.ToUniversalTime() < TimeSpan.FromSeconds(15);
        }
        else
        {
            if (ReferenceEquals(_drawnReactions, Message.Reactions)) _reactionMoves = new();
            else if (_lastReactionCounts is not null)
            {
                var moves = new Dictionary<string, int>();
                foreach (var (emoji, count) in counts)
                {
                    var before = _lastReactionCounts.TryGetValue(emoji, out var b) ? b : 0;
                    if (count != before) moves[emoji] = count > before ? 1 : -1;
                }
                _reactionMoves = moves;
            }
            _tickPop = status is not null && _lastStatus is not null && status != _lastStatus && status is "sent" or "delivered" or "read";
        }
        _lastReactionCounts = counts;
        _drawnReactions = Message.Reactions;
        _lastStatus = status;
    }
    private IReadOnlyList<ReactionGroupDto>? _drawnReactions;

    /// The chat page re-renders on every hub event (typing, presence, other rooms); a bubble
    /// only needs to when something it draws changed. MessageDto is an immutable record that
    /// ChatState swaps on edit/delete/reaction/receipt, so a reference check covers the message.
    private (MessageDto, bool, bool, bool, bool, bool, ChatRoomDto?, string)? _drawn;

    protected override bool ShouldRender()
    {
        var now = (Message, IsPinned, IsGroup, Bare, isPending, isFailed, ChatSvc.ActiveRoom, AvatarPhotos.Style(Message.SenderNik));
        if (_drawn is { } d && d.Equals(now)) return false;
        _drawn = now;
        return true;
    }

    // Icon for the centred system pill, keyed off the server's fixed templates (ChatService).
    private string SystemIcon => Message.Content switch
    {
        var c when c.EndsWith(" left the group") => "log-out",
        var c when c.Contains(" added ") => "user-plus",
        var c when c.Contains(" removed ") => "user-minus",
        var c when c.Contains("'s role to ") => "shield",
        var c when c.EndsWith(" unpinned a message") => "pin-off",
        var c when c.EndsWith(" pinned a message") => "pin",
        var c when c.Contains("created") => "sparkles",
        _ => "info",
    };

    private static IPop.Application.Notes.NoteCardDto? NoteCard(MessageDto m)
    {
        if (string.IsNullOrEmpty(m.Content) || !m.Content.StartsWith("[note]")) return null;
        try { return System.Text.Json.JsonSerializer.Deserialize<IPop.Application.Notes.NoteCardDto>(m.Content[6..], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)); }
        catch (System.Text.Json.JsonException) { return null; }
    }
    private static string NoteAccentHex(string? k) => k switch
    {
        "indigo" => "#5856D6", "purple" => "#AF52DE", "pink" => "#FF2D55", "red" => "#FF3B30", "orange" => "#FF9500",
        "yellow" => "#FFCC00", "green" => "#34C759", "teal" => "#30B0C7", "gray" => "#8E8E93", _ => "#0A84FF",
    };
    private static bool IsPollMessage(MessageDto m) => !string.IsNullOrEmpty(m.Content) && m.Content.StartsWith("[poll]");
    private static string ExtractPollJson(string? content) => string.IsNullOrEmpty(content) ? "" : content.StartsWith("[poll]") ? content.Substring(6) : "";

    /// Room members' full names, so legacy plain-text "@Full Name" highlights as one unit.
    /// Only needed when the message actually has a loose '@' that is not a token.
    private IReadOnlyList<(string Nik, string Name)>? LegacyMentionNames(ChatRoomDto? room)
        => room?.MentionDirectory is { Count: > 0 } dir && Message.Content.Replace("@[", "").Contains('@')
            ? dir.Select(d => (d.Nik, d.Name)).ToList()
            : null;

    private sealed class SimpleDir : IMentionDirectory
    {
        private readonly Dictionary<Guid, (string nik, string name, bool active)> _map;
        public SimpleDir(ChatRoomDto? room)
        {
            var map = new Dictionary<Guid, (string nik, string name, bool active)>();
            if (room?.MentionDirectory is not null)
            {
                foreach (var x in room.MentionDirectory)
                {
                    map[x.UserId] = (x.Nik, x.Name, x.IsActive);
                }
            }
            _map = map;
        }
        public bool TryResolve(Guid userId, out string nik, out string name, out bool isActive)
        {
            if (_map.TryGetValue(userId, out var v)) { nik = v.nik; name = v.name; isActive = v.active; return true; }
            nik = ""; name = ""; isActive = false; return false;
        }
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "—";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
    private static string Color(string? nik) => AvatarPalette.For(nik);
}
