@using IPop.Application.Chat
@using IPop.Web.Services
@using IPop.Web.Models
@inject IJSRuntime JS

@if (isOpen)
{
    <div class="mention-popup" role="listbox" aria-label="Mention suggestions" @ref="listRef">
        @for (int i = 0; i < displayItems.Count; i++)
        {
            var idx = i;
            var item = displayItems[idx];
            var sel = idx == selectedIndex;
            <div id="mention-opt-@idx" role="option" aria-selected="@sel.ToString().ToLowerInvariant()" class="mi @(sel ? "sel" : "")" @onmousedown:preventDefault @onclick="() => Pick(idx)">
                @if (item.IsAll)
                {
                    <div class="avatar mention-avatar mention-all">@@</div>
                    <div class="mi-text"><div class="name">@@all</div><div class="role">Notify everyone in this group (@item.AllCount)</div></div>
                }
                else
                {
                    <PersonAvatar Nik="@item.Member!.Nik" Name="@item.Member.Name" Size="30" Class="avatar mention-avatar" Decorative="true" />
                    <div class="mi-text"><div class="name">@item.Member.Name</div><div class="role">@RoleLabel(item.Member)</div></div>
                }
            </div>
        }
        <span class="visually-hidden" aria-live="polite">@AriaLiveText</span>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public IReadOnlyList<MemberDto> Candidates { get; set; } = [];
    [Parameter] public string CurrentUserNik { get; set; } = "";
    [Parameter] public bool ShowAll { get; set; }
    [Parameter] public int AllCount { get; set; }
    [Parameter] public EventCallback<PopupPick> OnPick { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int selectedIndex = 0;
    private List<PopupItem> displayItems = [];
    private bool isOpen => IsOpen && displayItems.Count > 0;

    private string AriaLiveText => displayItems.Count == 0 ? "No results" : $"{displayItems.Count} results, selected {displayItems[selectedIndex].Label}";

    private bool IsAllQuery => string.IsNullOrEmpty(Query) || "all".StartsWith(Query, StringComparison.OrdinalIgnoreCase);

    private ElementReference listRef;
    private string? lastKey;
    private bool scrollPending;

    protected override void OnParametersSet()
    {
        BuildItems();
        // Only a new query resets the highlight; unrelated parent re-renders (typing
        // indicators, incoming messages) must not yank the keyboard selection back.
        var key = $"{Query}|{ShowAll}|{string.Join(",", displayItems.Select(d => d.Label))}";
        if (key != lastKey) { selectedIndex = 0; lastKey = key; }
        if (selectedIndex >= displayItems.Count) selectedIndex = 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollPending || !isOpen) return;
        scrollPending = false;
        try { await JS.InvokeVoidAsync("ipop.scrollItemIntoView", listRef, $"mention-opt-{selectedIndex}"); } catch { }
    }

    private void BuildItems()
    {
        displayItems = [];
        if (ShowAll && IsAllQuery) displayItems.Add(new PopupItem { IsAll = true, AllCount = AllCount, Label = "@all" });
        var filtered = ComposerMentionModel.Filter(Candidates.Where(c => c.Nik != CurrentUserNik).ToList(), Query, 10);
        foreach (var m in filtered) displayItems.Add(new PopupItem { Member = m, Label = m.Name });
    }

    public void MoveDown() { if (displayItems.Count == 0) return; selectedIndex = (selectedIndex + 1) % displayItems.Count; scrollPending = true; StateHasChanged(); }
    public void MoveUp() { if (displayItems.Count == 0) return; selectedIndex = (selectedIndex - 1 + displayItems.Count) % displayItems.Count; scrollPending = true; StateHasChanged(); }

    private async Task Pick(int idx)
    {
        if (idx < 0 || idx >= displayItems.Count) return;
        var item = displayItems[idx];
        await OnPick.InvokeAsync(new PopupPick(item.Member, item.IsAll));
    }

    public async Task PickSelected() => await Pick(selectedIndex);

    private sealed class PopupItem { public MemberDto? Member; public bool IsAll; public int AllCount; public string Label = ""; }
    public sealed record PopupPick(MemberDto? Member, bool IsAll);


    private static string RoleLabel(MemberDto m) => m.Role switch
    {
        "owner" => "Group owner",
        "admin" => "Group admin",
        _ => m.Nik,
    };
}
