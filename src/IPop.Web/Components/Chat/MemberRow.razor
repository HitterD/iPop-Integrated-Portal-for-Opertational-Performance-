@using IPop.Application.Chat
@using IPop.Web.Models
@using IPop.Web.Services

<div class="grp-member member-row-clickable" @onclick="HandleClick" @onclick:stopPropagation>
    <div class="avatar member-row-avatar" style="background:@GetColor(Member.Nik)">@Initials(Member.Name)</div>
    <div class="member-row-copy">
        <div class="name">@Member.Name</div>
        <div class="role">@(IsSelf ? "You" : PresenceLabel(Member.PresenceStatus))</div>
    </div>
    @if (Member.Role is "owner" or "admin")
    {
        <span class="tag @Member.Role">@DisplayRole(Member.Role)</span>
    }
    @if (ShowActions && (CanRemove || CanChangeRole))
    {
        <div class="member-menu-wrap" @onclick:stopPropagation>
            <button type="button" class="member-action member-more" aria-label="Manage @Member.Name" aria-haspopup="menu"
                    aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">
                <i data-lucide="ellipsis"></i>
            </button>
            @if (menuOpen)
            {
                <div class="member-menu-backdrop" @onclick="() => menuOpen = false"></div>
                <div class="member-menu" role="menu">
                    @if (CanChangeRole && Member.Role == "member")
                    {
                        <button type="button" role="menuitem" @onclick="() => Act(OnChangeRole.InvokeAsync((Member, ChatMemberRole.Admin)))">
                            <i data-lucide="shield-plus"></i> Make admin
                        </button>
                    }
                    else if (CanChangeRole && Member.Role == "admin")
                    {
                        <button type="button" role="menuitem" @onclick="() => Act(OnChangeRole.InvokeAsync((Member, ChatMemberRole.Member)))">
                            <i data-lucide="shield-minus"></i> Remove admin
                        </button>
                    }
                    @if (CanRemove)
                    {
                        <button type="button" role="menuitem" class="danger" @onclick="() => Act(OnRemove.InvokeAsync(Member))">
                            <i data-lucide="user-minus"></i> Remove from group
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public MemberDto Member { get; set; } = default!;
    [Parameter] public string CurrentUserRole { get; set; } = "member";
    [Parameter] public string CurrentUserNik { get; set; } = "";
    [Parameter] public EventCallback<MemberDto> OnRemove { get; set; }
    [Parameter] public EventCallback<(MemberDto, ChatMemberRole)> OnChangeRole { get; set; }
    [Parameter] public bool ShowActions { get; set; } = true;

    private bool menuOpen;

    private async Task Act(Task action)
    {
        menuOpen = false;
        await action;
    }

    private bool IsSelf => Member.Nik == CurrentUserNik;
    private bool IsOwner => Member.Role == "owner";
    private bool CanRemove => !IsSelf && !IsOwner && (CurrentUserRole == "owner" || (CurrentUserRole == "admin" && Member.Role == "member"));
    private bool CanChangeRole => !IsSelf && !IsOwner && CurrentUserRole == "owner";

    [Parameter] public EventCallback<string> OnProfile { get; set; }

    private async Task HandleClick()
    {
        if (OnProfile.HasDelegate)
            await OnProfile.InvokeAsync(Member.Nik);
    }

    private static string PresenceLabel(string? status) => status switch
    {
        "on" or "online" => "Online",
        "away" => "Away",
        "busy" => "Busy",
        _ => "Offline"
    };

    private static string DisplayRole(string? role) => role switch
    {
        "owner" => "Owner",
        "admin" => "Admin",
        "member" => "Member",
        _ => role ?? ""
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }
    private static string GetColor(string nik) => AvatarPalette.For(nik);
}
