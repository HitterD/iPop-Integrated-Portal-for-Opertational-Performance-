@* 24-hour time field with a scrolling slot list. Bind TimeOnly, TimeOnly?, TimeSpan or TimeSpan?.
   Any HH:mm can be typed; the list offers Step-minute slots (default 15). *@
@typeparam TValue

<DatePickerCore Mode="DatePickerMode.Time" Value="PickerValue.ToCore(Value)" ValueChanged="OnChanged"
                Nullable="PickerValue.IsNullable<TValue>()" Step="Step"
                Placeholder="@Placeholder" Disabled="Disabled" AllowClear="AllowClear" Compact="Compact"
                Id="@Id" Pill="Pill" IsTimeDisabled="IsTimeDisabled" AriaLabel="@AriaLabel" Class="@Class" Style="@Style" />

@code {
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public int Step { get; set; } = 15;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    [Parameter] public bool Compact { get; set; }
    /// Meeting sheets (v3): a pill button ("Today, 13 Oct ▾" / "13:00") that opens the popover instead of a typed field.
    [Parameter] public bool Pill { get; set; }
    /// Slots that can't be picked (e.g. before now, or past the room limits).
    [Parameter] public Func<TimeOnly, bool>? IsTimeDisabled { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    protected override void OnInitialized() => PickerValue.EnsureSupported<TValue>(typeof(TimeOnly), typeof(TimeSpan));

    private Task OnChanged(DateTime? v) => ValueChanged.InvokeAsync(PickerValue.FromCore<TValue>(v));
}
