@namespace IPop.Web.Components.News
@using IPop.Web.Models
@using IPop.Web.Services
@inject AuthState Auth
@inject HttpClient Http
@inject ToastService Toasts
@inject IPop.Web.Services.PeopleLinks PLinks

@{
    var isCondolence = Detail.Type is "condolence" or "duka";
    var isMemo = Detail.Type == "memo";
    var isPublished = Detail.Status == "published";
    var isScheduled = isPublished && Detail.PublishAt > DateTime.UtcNow;
    var overdue = Detail.AckDueAt is { } due && due < DateTime.UtcNow;
}

@if (!Inline) { <div class="backdrop on" @onclick="OnClose"></div> }
<div class="@(Inline ? "news-inline-reader" : "drawer on")" role="@(Inline ? "region" : "dialog")" aria-label="News detail" aria-modal="@(!Inline ? "true" : "false")">
    <div class="tray"><div class="core" style="display:flex;flex-direction:column;height:100%;padding:0;overflow:hidden">
        <div class="drawer-head">
            <span style="display:flex;align-items:center;gap:8px;min-width:0">
                @if (Inline && (OnPrev is not null || OnNext is not null))
                {
                    <span class="reader-nav">
                        <button type="button" class="org-act" title="Previous post (K)" aria-label="Previous post" disabled="@(OnPrev is null)" @onclick="() => OnPrev!()"><i data-lucide="chevron-up"></i></button>
                        <button type="button" class="org-act" title="Next post (J)" aria-label="Next post" disabled="@(OnNext is null)" @onclick="() => OnNext!()"><i data-lucide="chevron-down"></i></button>
                    </span>
                }
                <span class="cat-chip @Detail.Type">@NewsUiHelper.GetCategoryLabel(Detail.Type)</span>
                @if (!isPublished) { <span class="status-pill draft">Draft</span> }
                else if (isScheduled) { <span class="status-pill scheduled"><i data-lucide="clock-3"></i>Scheduled</span> }
            </span>
            <span class="reader-acts">
                <span class="size-seg" role="group" aria-label="Text size">
                    <button type="button" class="@(FontSize < 16 ? "on" : "")" title="Smaller text" aria-label="Smaller text" @onclick="() => FontSize = 14">A</button>
                    <button type="button" class="big @(FontSize >= 16 ? "on" : "")" title="Larger text" aria-label="Larger text" @onclick="() => FontSize = 17">A</button>
                </span>
                @if (isPublished)
                {
                    <button type="button" class="org-act @(isSaved ? "on" : "")" title="@(isSaved ? "Saved" : "Save for later")" aria-pressed="@(isSaved ? "true" : "false")" @onclick="OnToggleSave"><i data-lucide="bookmark"></i></button>
                    <button type="button" class="org-act" title="Copy link" aria-label="Copy link" @onclick="OnCopyLink"><i data-lucide="link"></i></button>
                }
                <button type="button" class="org-act" title="Print" aria-label="Print" @onclick="Print"><i data-lucide="printer"></i></button>
                <span class="reader-more">
                    <button type="button" class="org-act" title="More actions" aria-label="More actions" aria-haspopup="menu" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen"><i data-lucide="ellipsis"></i></button>
                    @if (menuOpen)
                    {
                        <div class="reader-menu-scrim" @onclick="() => menuOpen = false"></div>
                        <div class="reader-menu" role="menu">
                            @if (isPublished)
                            {
                                <button type="button" role="menuitem" @onclick="() => Run(OnMarkUnread)"><i data-lucide="mail"></i>Mark as unread</button>
                                @if (OnSchedule.HasDelegate) { <button type="button" role="menuitem" @onclick="() => Run(OnSchedule)"><i data-lucide="calendar-plus"></i>Schedule follow-up</button> }
                            }
                            @if (Detail.CanEdit)
                            {
                                <button type="button" role="menuitem" @onclick="() => Run(OnEdit)"><i data-lucide="pencil"></i>Edit post</button>
                            }
                            @if (Detail.CanPublish)
                            {
                                <button type="button" role="menuitem" @onclick="() => Run(OnTogglePin)"><i data-lucide="@(Detail.IsPinned ? "pin-off" : "pin")"></i>@(Detail.IsPinned ? "Unpin" : "Pin to top")</button>
                                @if (isPublished)
                                {
                                    <button type="button" role="menuitem" @onclick="() => Run(OnUnpublish)"><i data-lucide="undo-2"></i>Unpublish</button>
                                }
                                else
                                {
                                    <button type="button" role="menuitem" @onclick="() => Run(OnPublish)"><i data-lucide="send"></i>Publish now</button>
                                }
                            }
                            @if (Detail.CanDelete)
                            {
                                <div class="sep"></div>
                                <button type="button" role="menuitem" class="danger" @onclick="() => Run(OnDelete)"><i data-lucide="trash-2"></i>Delete post</button>
                            }
                        </div>
                    }
                </span>
                @if (!Inline) { <button class="drawer-close" @onclick="OnClose" aria-label="Close"><i data-lucide="x"></i></button> }
            </span>
        </div>

        <div class="drawer-body reader-scroll @(isCondolence ? "is-condolence" : "")" style="flex:1;overflow:auto;padding:20px">
            <div class="reader-measure">
            @if (Detail.IsPinned)
            {
                <div class="reader-kicker"><span><i data-lucide="pin"></i>Pinned announcement</span></div>
            }

            @if (isCondolence)
            {
                <div class="reader-condolence-banner">
                    <div class="condolence-banner-icon"><i data-lucide="flower-2" style="width:24px;height:24px"></i></div>
                    <div>
                        <div class="condolence-primary-headline" lang="id">Turut Berduka Cita</div>
                        <div class="condolence-banner-desc" lang="id">Semoga keluarga yang ditinggalkan diberi kekuatan dan ketabahan.</div>
                    </div>
                </div>
            }
            else if (isMemo)
            {
                <div class="reader-memo-letterhead">
                    <div class="memo-head-title">INTERNAL MEMORANDUM</div>
                    <div class="memo-head-grid">
                        <div class="memo-row"><span class="lbl">TO:</span><span class="val">@AudienceText</span></div>
                        <div class="memo-row"><span class="lbl">FROM:</span><span class="val"><strong>@Detail.AuthorName</strong></span></div>
                        <div class="memo-row"><span class="lbl">DATE:</span><span class="val">@NewsUiHelper.FormatDate(Detail.PublishedAt ?? Detail.CreatedAt)</span></div>
                        <div class="memo-row full"><span class="lbl">SUBJECT:</span><span class="val perihal">@Detail.Title</span></div>
                    </div>
                </div>
            }

            <h1 class="reader-article-title">@Detail.Title</h1>

            <div class="reader-author">
                <PersonAvatar Nik="@Detail.AuthorNik" Name="@Detail.AuthorName" Size="38" Class="av" Decorative="true" />
                <span class="who">
                    <span class="n">@Detail.AuthorName</span>
                    <span class="m">
                        @NewsUiHelper.FormatDate(Detail.PublishedAt ?? Detail.PublishAt ?? Detail.CreatedAt) · @NewsUiHelper.ReadTime(Detail.Body) min read
                        @if (isPublished) { <text> · @Detail.ViewCount @(Detail.ViewCount == 1 ? "view" : "views")</text> }
                        @if (Detail.EditedAt is { } edited) { <text> · </text><span class="edited" title="Edited @NewsUiHelper.FormatDate(edited)">Edited</span> }
                    </span>
                </span>
            </div>

            <div class="reader-audience"><i data-lucide="users"></i>@AudienceText</div>

            @if (isScheduled)
            {
                <div class="note" style="margin-top:12px"><i data-lucide="clock-3"></i><span>Scheduled to go live on @NewsUiHelper.FormatDate(Detail.PublishAt). Readers can't see it yet.</span></div>
            }
            else if (!isPublished)
            {
                <div class="note" style="margin-top:12px"><i data-lucide="file-pen-line"></i><span>This is a draft. Only its author, HR and Admin can see it.</span></div>
            }

            @if (Detail.RequiresAcknowledgement && isPublished && !Detail.IsAcknowledged)
            {
                <div class="reader-ack-callout @(overdue ? "overdue" : "")">
                    <i data-lucide="clipboard-check"></i>
                    <div>
                        <div class="t">Your acknowledgement is required</div>
                        <div class="s">Read the full post, then confirm at the bottom.@(Detail.AckDueAt is { } d ? $" Due {NewsUiHelper.FormatDate(d)}{(overdue ? " (overdue)" : "")}." : "")</div>
                    </div>
                </div>
            }

            @if (Detail.Video is { } video) { <NewsVideoBlock Video="@video" /> }

            <div class="reader-body-content @(isCondolence ? "condolence-body" : isMemo ? "memo-body" : "")" style="font-size:@(FontSize)px">
                <NewsBody Html="@Detail.Body" BodyFormat="@Detail.BodyFormat" PostId="@Detail.Id" AriaLabel="Post content" />
            </div>

            @if (Detail.Attachments is { Count: > 0 } files)
            {
                <div class="reader-files">
                    <div class="lbl"><i data-lucide="paperclip"></i>@files.Count @(files.Count == 1 ? "attachment" : "attachments")</div>
                    @foreach (var f in files)
                    {
                        var file = f;
                        <button type="button" class="file-chip" title="Download @file.FileName" @onclick="() => Download(file)">
                            <i data-lucide="@NewsUiHelper.FileIcon(file.FileName)"></i>
                            <span class="fn">@file.FileName</span>
                            <span class="fs">@NewsUiHelper.FileSize(file.Size)</span>
                            <i data-lucide="download" class="dl"></i>
                        </button>
                    }
                </div>
            }

            @if (Detail.RequiresAcknowledgement && isPublished)
            {
                <div class="reader-ack-box @(Detail.IsAcknowledged ? "done" : "req")">
                    @if (Detail.IsAcknowledged)
                    {
                        <div class="ack-done">@if (ackJustDone) { <span class="mi-check-draw" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span> } else { <i data-lucide="check-circle-2"></i> }<span>You acknowledged this @(isMemo ? "memo" : "post")@(Detail.AcknowledgedAt is { } at ? $" on {NewsUiHelper.FormatDate(at)}" : "").</span></div>
                    }
                    else
                    {
                        <div class="ack-card">
                            <span class="ack-ic"><i data-lucide="clipboard-check"></i></span>
                            <span class="ack-tx">
                                <b>Please confirm you've read this @(isMemo ? "memo" : "post")</b>
                                <small>@(Detail.AckDueAt is { } d ? $"{(overdue ? "Was due" : "Due")} {NewsUiHelper.FormatDate(d)} · " : "")@Detail.AckCount of @Detail.AckTotal colleagues done</small>
                            </span>
                            <button type="button" class="btn-primary ack-confirm" @onclick="OnAcknowledge" disabled="@AckBusy">
                                <i data-lucide="check"></i>@(AckBusy ? "Recording…" : "I've read it")
                            </button>
                        </div>
                    }
                </div>
            }

            @if (Detail.CanManage && Detail.RequiresAcknowledgement && isPublished)
            {
                <div class="ack-panel">
                    <div class="ack-panel-head">
                        <span class="t"><i data-lucide="clipboard-list"></i>Acknowledgement tracking</span>
                        <span class="mono n">@Detail.AckCount / @Detail.AckTotal · @NewsUiHelper.AckPercent(Detail)%</span>
                    </div>
                    <div class="ack-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@NewsUiHelper.AckPercent(Detail)" aria-label="Acknowledged">
                        <div class="ack-progress-fill" style="width:@NewsUiHelper.AckPercent(Detail)%"></div>
                    </div>
                    <div class="ack-panel-acts">
                        <button type="button" class="ghost-btn" @onclick="ToggleAckList"><i data-lucide="@(ackOpen ? "chevron-up" : "list")"></i>@(ackOpen ? "Hide list" : "View list")</button>
                        <button type="button" class="ghost-btn" @onclick="ExportAcks" disabled="@ackLoading"><i data-lucide="file-spreadsheet"></i>Export Excel</button>
                        @if (Detail.AckTotal > Detail.AckCount)
                        {
                            <button type="button" class="ghost-btn" @onclick="OnRemindAck"><i data-lucide="bell-ring"></i>Send reminder</button>
                        }
                    </div>
                    @if (ackOpen)
                    {
                        @if (ackReport is null)
                        {
                            <div class="skel" style="height:80px;margin-top:10px;border-radius:8px"></div>
                        }
                        else
                        {
                            <div class="ack-filter">
                                <div class="v6-search"><i data-lucide="search"></i><input type="search" placeholder="Search name or department" aria-label="Search acknowledgements" @bind="ackQuery" @bind:event="oninput" /></div>
                                <div class="seg" role="group" aria-label="Filter">
                                    <button type="button" class="@(ackFilter == "all" ? "on" : "")" @onclick='() => ackFilter = "all"'>All</button>
                                    <button type="button" class="@(ackFilter == "pending" ? "on" : "")" @onclick='() => ackFilter = "pending"'>Pending @(ackReport.Total - ackReport.Acknowledged)</button>
                                    <button type="button" class="@(ackFilter == "done" ? "on" : "")" @onclick='() => ackFilter = "done"'>Done @ackReport.Acknowledged</button>
                                </div>
                            </div>
                            <div class="ack-list">
                                @{ var rows = FilteredAcks().ToList(); }
                                @if (rows.Count == 0) { <div class="tree-empty" style="padding:12px">No matching employees.</div> }
                                @foreach (var e in rows.Take(200))
                                {
                                    <div class="ack-row">
                                        <PersonAvatar Nik="@e.Nik" Name="@e.Name" Size="28" Class="av sm" Decorative="true" />
                                        <span class="who"><span class="n">@e.Name</span><span class="m">@(e.Department ?? "")</span></span>
                                        @if (e.AcknowledgedAt is { } at) { <span class="ack ok" title="@NewsUiHelper.FormatDate(at)"><i data-lucide="check"></i>@at.ToLocalTime().ToString("dd MMM, HH:mm")</span> }
                                        else { <span class="ack req">Pending</span> }
                                    </div>
                                }
                                @if (rows.Count > 200) { <div class="tree-empty" style="padding:8px">Showing 200 of @rows.Count — refine the search or export to Excel.</div> }
                            </div>
                        }
                    }
                </div>
            }

            @if (isPublished)
            {
                <div class="news-v6-discussion">
                    @if (isCondolence)
                    {
                        <button type="button" class="ghost-btn like-btn condo @(Discussion?.IsLiked == true ? "on" : "")" @onclick="ToggleLikeWithPop" aria-pressed="@(Discussion?.IsLiked == true ? "true" : "false")" aria-label="Send condolences">
                            <i data-lucide="hand-heart"></i> Turut berduka · @(Discussion?.LikeCount ?? 0)
                        </button>
                        <small class="condo-hint">@(Discussion?.IsLiked == true ? "Your condolences were sent." : "Your name is added to the colleagues who sent condolences.")</small>
                        <strong>@(Discussion?.Comments.Count ?? 0) condolence @((Discussion?.Comments.Count ?? 0) == 1 ? "message" : "messages")</strong>
                    }
                    else
                    {
                        <button type="button" class="ghost-btn like-btn @(Discussion?.IsLiked == true ? "on" : "")" @onclick="ToggleLikeWithPop" aria-label="@(Discussion?.IsLiked == true ? "Unlike post" : "Like post")">
                            <i data-lucide="thumbs-up"></i> @(Discussion?.IsLiked == true ? "Liked" : "Like") · @(Discussion?.LikeCount ?? 0)
                        </button>
                        <strong>@(Discussion?.Comments.Count ?? 0) comments</strong>
                    }
                    @foreach (var comment in Discussion?.Comments ?? [])
                    {
                        <p><b>@comment.AuthorName</b> <span>@comment.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span><br />@comment.Body</p>
                    }
                    <div class="news-v6-comment-form"><input value="@CommentText" @oninput="HandleCommentInput" placeholder="@(isCondolence ? "Write a condolence message…" : "Add a comment…")" maxlength="2000" aria-label="@(isCondolence ? "Write a condolence message" : "Add a comment")" /><button type="button" class="btn-primary" @onclick="OnComment" disabled="@(string.IsNullOrWhiteSpace(CommentText))">Post</button></div>
                </div>
            }

            @if (Detail.CanEdit || Detail.CanDelete || Detail.CanPublish)
            {
                <div class="reader-workflow">
                    @if (Detail.CanEdit)
                    {
                        <button type="button" class="ghost-btn" @onclick="OnEdit"><i data-lucide="pencil"></i>Edit</button>
                    }
                    @if (Detail.CanPublish)
                    {
                        @if (isPublished)
                        {
                            <button type="button" class="ghost-btn" @onclick="OnUnpublish"><i data-lucide="undo-2"></i>Unpublish</button>
                        }
                        else
                        {
                            <button type="button" class="btn-primary" @onclick="OnPublish"><i data-lucide="send"></i>Publish now</button>
                        }
                        <button type="button" class="ghost-btn" @onclick="OnTogglePin"><i data-lucide="@(Detail.IsPinned ? "pin-off" : "pin")"></i>@(Detail.IsPinned ? "Unpin" : "Pin")</button>
                    }
                    @if (Detail.CanDelete)
                    {
                        <button type="button" class="icon-btn danger push-right" title="Delete post" aria-label="Delete post" @onclick="OnDelete"><i data-lucide="trash-2"></i></button>
                    }
                </div>
            }

            @if (Detail.CanManage)
            {

                <details class="reader-audit">
                    <summary><i data-lucide="history"></i>Activity history</summary>
                    @if (Audits is null) { <div class="skel" style="height:60px"></div> }
                    else if (Audits.Count == 0) { <div class="tree-empty" style="padding:14px">No audit records yet.</div> }
                    else
                    {
                        <div style="display:grid;gap:8px;margin-top:10px">
                            @foreach (var a in Audits)
                            {
                                <div class="audit-row-item">
                                    <span class="audit-icon"><i data-lucide="activity" style="width:13px;height:13px"></i></span>
                                    <div style="min-width:0;flex:1">
                                        <div style="font-size:12.5px;font-weight:600">@NewsUiHelper.FormatAuditAction(a.Action) <span style="font-weight:400;color:var(--ink-3)">by @a.ActorName</span></div>
                                        <div style="font-size:11px;color:var(--ink-3);margin-top:2px">@a.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </details>
            }

            @if (!string.IsNullOrEmpty(DetailError))
            {
                <div class="note err" style="margin-top:14px"><i data-lucide="alert-circle"></i><span>@DetailError</span></div>
            }
            </div>
        </div>
    </div></div>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private int FontSize = 14;
    private bool menuOpen;
    private bool ackOpen;
    private bool ackLoading;
    private string ackQuery = "";
    private string ackFilter = "all";
    private NewsAckReportDto? ackReport;
    private Guid loadedFor;
    private int loadedAckCount = -1;

    private bool isSaved => Detail.IsSaved;

    [Parameter] public bool Inline { get; set; }
    [Parameter] public NewsDiscussionDto? Discussion { get; set; }
    [Parameter] public string CommentText { get; set; } = "";
    [Parameter] public EventCallback<string> OnCommentTextChanged { get; set; }
    [Parameter] public EventCallback OnToggleLike { get; set; }
    [Parameter] public EventCallback OnComment { get; set; }
    [Parameter] public NewsDetailDto Detail { get; set; } = default!;
    [Parameter] public IReadOnlyList<NewsAuditDto>? Audits { get; set; }
    [Parameter] public bool AckBusy { get; set; }
    [Parameter] public string? DetailError { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCopyLink { get; set; }
    [Parameter] public EventCallback OnSchedule { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnPublish { get; set; }
    [Parameter] public EventCallback OnUnpublish { get; set; }
    [Parameter] public EventCallback OnTogglePin { get; set; }
    [Parameter] public EventCallback OnToggleSave { get; set; }
    [Parameter] public EventCallback OnMarkUnread { get; set; }
    [Parameter] public EventCallback OnAcknowledge { get; set; }
    [Parameter] public EventCallback OnRemindAck { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    /// Inline reader only: jump to the previous / next post in the list (null at either end).
    [Parameter] public Func<Task>? OnPrev { get; set; }
    [Parameter] public Func<Task>? OnNext { get; set; }

    private string AudienceText => Detail.Targets.Count == 0 || Detail.Targets.Any(t => t.Kind == "all")
        ? "All employees"
        : string.Join(", ", Detail.Targets.Select(t => t.Kind switch
        {
            "department" => $"Dept. {t.Value}",
            "role" => $"Role {t.Value}",
            "user" => userNames.GetValueOrDefault(t.Value ?? "", "Employee"),
            "project" => "Project members",
            _ => t.Value ?? t.Kind
        }));

    private readonly Dictionary<string, string> userNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        foreach (var t in Detail.Targets.Where(t => t.Kind == "user" && t.Value is not null && !userNames.ContainsKey(t.Value)).ToList())
            userNames[t.Value!] = await PLinks.NameAsync(Auth, t.Value!);
    }

    protected override void OnParametersSet()
    {
        TrackAck();
        // A different post, or a new acknowledgement on this one, invalidates the loaded report.
        if (Detail.Id != loadedFor || Detail.AckCount != loadedAckCount)
        {
            if (Detail.Id != loadedFor) { ackOpen = false; ackQuery = ""; ackFilter = "all"; menuOpen = false; }
            loadedFor = Detail.Id;
            loadedAckCount = Detail.AckCount;
            ackReport = null;
            if (ackOpen) _ = LoadAcks();
        }
    }

    // ── Micro-interactions: #3 like / condolence pop, #19 drawn check on acknowledge ──
    private Guid ackSeenFor;
    private bool ackSeenDone;
    private bool ackJustDone;

    private void TrackAck()
    {
        // Only a change on the same post draws the check; opening an already-acknowledged post does not.
        if (Detail.Id == ackSeenFor && !ackSeenDone && Detail.IsAcknowledged) ackJustDone = true;
        else if (Detail.Id != ackSeenFor) ackJustDone = false;
        ackSeenFor = Detail.Id;
        ackSeenDone = Detail.IsAcknowledged;
    }

    private async Task ToggleLikeWithPop()
    {
        // Pop only when adding the reaction; the parent re-renders the "on" state itself.
        var adding = Discussion?.IsLiked != true;
        await OnToggleLike.InvokeAsync();
        if (adding)
        {
            try { await JS.InvokeVoidAsync("ipopMicro.popSelector", ".news-v6-discussion .like-btn > i"); }
            catch (JSException) { /* decoration only */ }
        }
    }

    private async Task Run(EventCallback cb)
    {
        menuOpen = false;
        await cb.InvokeAsync();
    }

    private async Task<NewsAckReportDto?> LoadAcks()
    {
        var id = Detail.Id;
        ackLoading = true;
        var report = await Auth.GetAsync<NewsAckReportDto>($"/api/news/{id}/acks");
        ackLoading = false;
        if (id != Detail.Id) return null;
        ackReport = report;
        if (report is null) Toasts.Show("Could not load the acknowledgement list.", ToastKind.Error);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
        return report;
    }

    private async Task ToggleAckList()
    {
        ackOpen = !ackOpen;
        if (ackOpen && ackReport is null) await LoadAcks();
    }

    private IEnumerable<NewsAckEntryDto> FilteredAcks()
    {
        var rows = ackReport?.Entries ?? [];
        var q = ackQuery.Trim();
        return rows
            .Where(e => ackFilter switch { "pending" => e.AcknowledgedAt is null, "done" => e.AcknowledgedAt is not null, _ => true })
            .Where(e => q.Length == 0
                || e.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (e.Department?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
    }

    private async Task ExportAcks()
    {
        var report = ackReport ?? await LoadAcks();
        if (report is null) return;
        var rows = new List<object?[]> { new object?[] { "Name", "Department", "Status", "Acknowledged at" } };
        rows.AddRange(report.Entries.Select(e => new object?[]
        {
            e.Name, e.Department ?? "",
            e.AcknowledgedAt is null ? "Pending" : "Acknowledged",
            e.AcknowledgedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? ""
        }));
        var safe = new string(Detail.Title.Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-').ToArray()).Trim();
        if (safe.Length > 60) safe = safe[..60];
        await JS.InvokeVoidAsync("ipop.exportXlsx", rows, "Acknowledgements", $"Ack - {(safe.Length == 0 ? "post" : safe)} - {DateTime.Now:yyyyMMdd}.xlsx");
    }

    private async Task Download(NewsAttachmentDto file)
    {
        var url = new Uri(Http.BaseAddress!, $"/api/attachments/{file.Id}").ToString();
        await JS.InvokeVoidAsync("ipop.authDownload", url, Auth.AccessToken, file.FileName);
    }

    private async Task Print() => await JS.InvokeVoidAsync("print");
    private Task HandleCommentInput(ChangeEventArgs e) => OnCommentTextChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
