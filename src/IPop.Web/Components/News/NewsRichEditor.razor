    /// Uploads one host-picked file through the configured endpoint and inserts it at the caret.
    /// `OnUploadProgress` reports the usual uploading/done/failed states, so the page needs no
    /// progress UI of its own.
    public async Task UploadAndInsertAsync(IBrowserFile file, string kind)
    {
        if (file is null) return;
        var isVideo = kind == "video";
        var limit = isVideo ? MaxVideoBytes : MaxImageBytes;
        if (file.Size > limit)
        {
            var message = $"{file.Name} is {NewsUiHelper.FileSize(file.Size)} — the limit is {NewsUiHelper.FileSize(limit)}.";
            await Report(message, kind, file.Name, "failed", 0, "Too large");
            return;
        }
        if (string.IsNullOrWhiteSpace(UploadUrl))
        {
            await Report("Uploads are not available in this editor yet.", kind, file.Name, "failed", 0, "No endpoint");
            return;
        }
        await OnUploadProgressJs(new NewsUploadProgress(kind, file.Name, "uploading", 0));
        try
        {
            using var content = new MultipartFormDataContent();
            var stream = new StreamContent(file.OpenReadStream(limit));
            stream.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrEmpty(file.ContentType) ? (isVideo ? "video/mp4" : "image/png") : file.ContentType);
            content.Add(stream, "file", file.Name);
            var res = await Auth.SendMultipartAsync(UploadUrl!, content);
            if (!res.IsSuccessStatusCode)
            {
                string? reason = null;
                try { if ((await res.Content.ReadFromJsonAsync<Dictionary<string, string>>())?.TryGetValue("message", out var m) == true) reason = m; } catch { }
                var text = res.StatusCode == System.Net.HttpStatusCode.UnprocessableEntity || reason is "blocked_type"
                    ? (isVideo ? "this video format isn't supported. Use MP4 or WebM (on iPhone: Settings › Camera › Formats › Most Compatible)."
                               : "this image format isn't supported. Use JPEG, PNG, GIF or WebP (on iPhone: Settings › Camera › Formats › Most Compatible).")
                    : reason ?? "the server refused the upload.";
                await Report($"{file.Name}: {text}", kind, file.Name, "failed", 0, reason);
                return;
            }
            var dto = await res.Content.ReadFromJsonAsync<MediaResponse>();
            if (dto?.MediaId is not { } mediaId || mediaId == Guid.Empty)
            {
                await Report($"{file.Name}: the server did not return a media id.", kind, file.Name, "failed", 0, "No media id");
                return;
            }
            // The API returns `streamUrl` relative to its own origin; resolve before previewing.
            var preview = AbsoluteUrl(dto.StreamUrl);
            var media = new NewsMediaRef(mediaId, kind, preview, dto.FileName ?? file.Name,
                NewsUiHelper.FileSize(dto.Size > 0 ? dto.Size : file.Size), file.ContentType, file.Size);
            await OnUploadProgressJs(new NewsUploadProgress(kind, file.Name, "done", 100));
            await InsertMediaAsync(media, new Dictionary<Guid, string> { [mediaId] = preview ?? "" });
            if (OnMediaUploaded.HasDelegate) await OnMediaUploaded.InvokeAsync(media);
        }
        catch (Exception ex)
        {
            await Report($"{file.Name}: {ex.Message}", kind, file.Name, "failed", 0, ex.Message);
        }
    }

    /// One place for "the author must see this" — the inline notice, the host hook and the
    /// progress row all get the same story.
    private async Task Report(string message, string kind, string name, string state, int percent, string? reason)
    {
        await OnNoticeJs(message);
        await OnUploadProgressJs(new NewsUploadProgress(kind, name, state, percent, reason));
    }

    /// Shape of the composer media endpoint's JSON. Field names are matched case-insensitively.
    private sealed record MediaResponse(Guid MediaId, string? StreamUrl, string? FileName, long Size, string? ContentType);

    private async Task InsertYouTube()
    {
        var vid = YouTubeId(ytUrl);
        if (vid is null) { popError = "That doesn't look like a YouTube video link."; return; }
        pop = null;
        await JS.InvokeVoidAsync("ipop.newsEditor.insertYouTube", id, new { videoId = vid, title = "YouTube video" });
    }

    /// Strict, mirrored in the module: only watch/short/live/embed/youtu.be produce an id.
    public static string? YouTubeId(string? raw)
    {
        var s = (raw ?? "").Trim();
        if (System.Text.RegularExpressions.Regex.IsMatch(s, "^[A-Za-z0-9_-]{11}$")) return s;
        if (!Uri.TryCreate(s, UriKind.Absolute, out var uri)) return null;
        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps) return null;
        var host = uri.Host.ToLowerInvariant();
        if (host.StartsWith("www.") || host.StartsWith("m.") || host.StartsWith("music.")) host = host[(host.IndexOf('.') + 1)..];
        string id = "";
        if (host == "youtu.be") id = uri.AbsolutePath.TrimStart('/');
        else if (host is "youtube.com" or "youtube-nocookie.com")
        {
            if (uri.AbsolutePath == "/watch") id = QueryValue(uri.Query, "v");
            else if (uri.AbsolutePath.StartsWith("/embed/") || uri.AbsolutePath.StartsWith("/shorts/") || uri.AbsolutePath.StartsWith("/live/"))
            {
                var parts = uri.AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 1) id = parts[1];
            }
        }
        id = id.Split(['?', '&', '#', '/'])[0];
        return System.Text.RegularExpressions.Regex.IsMatch(id, "^[A-Za-z0-9_-]{11}$") ? id : null;
    }

    /// First value of `key` in a query string (no System.Web dependency in wasm).
    private static string QueryValue(string query, string key)
    {
        foreach (var pair in (query ?? "").TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            var k = eq < 0 ? pair : pair[..eq];
            if (!k.Equals(key, StringComparison.OrdinalIgnoreCase)) continue;
            return eq < 0 ? "" : Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return "";
    }

    private async Task InsertVideoLink()
    {
        var url = NormalizeUrl(vidUrl);
        if (url is null || !IsDirectVideo(url))
        {
            popError = "Direct video links must be an https:// address ending in .mp4 or .webm";
            return;
        }
        pop = null;
        await JS.InvokeVoidAsync("ipop.newsEditor.insertVideoUrl", id, new { url });
    }

    /// Direct HTTPS + .mp4/.webm — matches the sanitizer's allow-list and JS `directVideoUrl`.
    public static bool IsDirectVideo(string url)
        => url.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
           && System.Text.RegularExpressions.Regex.IsMatch(url, @"\.(mp4|webm)([?#].*)?$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (created) await JS.InvokeVoidAsync("ipop.newsEditor.unmount", id);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
        selfRef?.Dispose();
    }
