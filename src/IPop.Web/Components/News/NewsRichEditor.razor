    {
        pop = pop == name ? null : name;
        popError = null;
        popJustOpened = pop is not null;
    }

    private async Task OpenLink()
    {
        if (pop == "link") { pop = null; return; }
        var info = await JS.InvokeAsync<LinkInfo?>("ipop.newsEditor.linkInfo", id);
        linkUrl = info?.Href ?? "";
        pop = "link";
        popError = null;
        popJustOpened = true;
        StateHasChanged();
    }

    internal sealed record LinkInfo(string Href, string Text);

    private async Task OnPopKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (pop == "link") await ApplyLink();
            else if (pop == "video") await InsertVideoLink();
        }
        else if (e.Key == "Escape") pop = null;
    }

    private async Task ApplyLink()
    {
        var url = NormalizeUrl(linkUrl);
        if (url is null) { popError = "That address can't be used."; return; }
        pop = null;
        await JS.InvokeVoidAsync("ipop.newsEditor.link", id, url, null);
    }

    /// Reuses MailRteEditor's rules: bare hosts get https://, bare addresses get mailto:,
    /// script schemes are refused. External links open in a new tab (target set by Jodit).
    public static string? NormalizeUrl(string? raw)
    {
        var u = (raw ?? "").Trim();
        if (u.Length == 0) return null;
        if (u.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase) || u.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || u.StartsWith("vbscript:", StringComparison.OrdinalIgnoreCase)) return null;
        if (u.Contains('@') && !u.Contains(':') && !u.Contains('/')) return "mailto:" + u;
        if (!System.Text.RegularExpressions.Regex.IsMatch(u, "^[a-zA-Z][a-zA-Z0-9+.-]*:")) return "https://" + u;
        return u;
    }

