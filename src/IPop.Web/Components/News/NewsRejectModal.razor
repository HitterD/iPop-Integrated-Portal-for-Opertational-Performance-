@namespace IPop.Web.Components.News

<div class="backdrop on" @onclick="OnClose"></div>
<div style="position:fixed;inset:0;z-index:70;display:flex;align-items:center;justify-content:center;padding:20px" @onclick="OnClose">
    <div role="dialog" aria-modal="true" aria-label="Reject post" style="width:440px;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow-lg)" @onclick:stopPropagation>
        <h3 style="font-size:15px;font-weight:700;margin-bottom:8px;color:var(--danger)">Reject Post</h3>
        <p style="font-size:12.5px;color:var(--ink-2);margin-bottom:14px">Provide a rejection reason so the author can revise the post before resubmitting.</p>
        <div class="field">
            <label>Rejection Reason</label>
            <input placeholder="e.g. Needs revision in date and targeting section…"
                   @bind="reason" />
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
            <button type="button" class="comp-btn" style="width:auto;padding:8px 16px;font-size:12.5px" @onclick="OnClose">Cancel</button>
            <button type="button" class="btn" style="width:auto;margin:0;padding:8px 16px;font-size:12.5px;background:var(--danger);color:#fff;border:none" @onclick="Confirm">Reject Post</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnConfirmReject { get; set; }

    private string reason = "";

    private async Task Confirm()
    {
        await OnConfirmReject.InvokeAsync(reason);
        reason = "";
    }
}
