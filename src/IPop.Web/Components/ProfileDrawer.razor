@using IPop.Web.Models
@inject IJSRuntime JS

<div class="profile-sheet-backdrop @(Person is not null ? "on" : "")" @onclick="Close"></div>
<aside class="profile-sheet @(Person is not null ? "on" : "")" role="dialog" aria-label="Profile">
    <div class="profile-sheet-card">
        <div class="profile-sheet-head">
            <div class="profile-sheet-title">Profile</div>
            <button type="button" class="profile-sheet-close" @onclick="Close" title="Close" aria-label="Close">
                <i data-lucide="x"></i>
            </button>
        </div>
        @if (Person is not null)
        {
            <div class="profile-sheet-body" @key="Person.Nik">
                <ContactCard Person="Person" OnClose="Close" />
            </div>
        }
    </div>
</aside>

@code {
    [Parameter] public Employee? Person { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
        => await JS.InvokeVoidAsync("ipop.icons");
}
