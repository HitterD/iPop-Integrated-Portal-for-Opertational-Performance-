@* Date field with a macOS-style month popover. Bind DateTime, DateTime?, DateOnly or DateOnly?.
   Example: <AppDatePicker @bind-Value="dueDate" AllowClear Min="DateTime.Today" /> *@
@typeparam TValue

<DatePickerCore Mode="DatePickerMode.Date" Value="PickerValue.ToCore(Value)" ValueChanged="OnChanged"
                Nullable="PickerValue.IsNullable<TValue>()" Min="Min" Max="Max" IsDateDisabled="IsDateDisabled"
                Placeholder="@Placeholder" Disabled="Disabled" AllowClear="AllowClear" Compact="Compact"
                Id="@Id" AriaLabel="@AriaLabel" Class="@Class" Style="@Style" />

@code {
    [Parameter] public TValue Value { get; set; } = default!;
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public DateTime? Min { get; set; }
    [Parameter] public DateTime? Max { get; set; }
    [Parameter] public Func<DateOnly, bool>? IsDateDisabled { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; }
    /// Dense variant for table cells and tight toolbars.
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    protected override void OnInitialized() => PickerValue.EnsureSupported<TValue>(typeof(DateTime), typeof(DateOnly));

    private Task OnChanged(DateTime? v) => ValueChanged.InvokeAsync(PickerValue.FromCore<TValue>(v));
}
