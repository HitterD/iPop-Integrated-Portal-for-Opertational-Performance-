@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject AuthState Auth
@inject ChatState Chat
@inject IPop.Web.Services.NotificationState Notifs
@inject IPop.Web.Services.CallState CallSvc
@inject CommandPaletteState Palette
@inject BadgeState Badges
@inject TimerState Timer
@inject OverlayStack Overlays
@inject TutorialState Tutorials
@inject IPop.Web.Services.PushState Push
@inject IPop.Web.Services.SessionLockState SessionLock
@inject NotificationSettingsState NotifSettings
@inject IPop.Web.Services.MailComposerHost ComposerHost

<div class="shell @(collapsed ? "collapsed" : "")" id="shell">
    <aside class="sidebar">
        <div class="side-head">
            <a class="brand" href="/dashboard" title="iPop">
                <img class="mark" src="img/brand/ipop-mark.webp" alt="iPop" width="34" height="34" />
                <span class="txt"><img class="word lg-light" src="img/brand/ipop-word.webp" alt="iPop" height="22" /><img class="word lg-dark" src="img/brand/ipop-word-dark.webp" alt="" height="22" /></span>
            </a>
            <button class="collapse-btn" title="Collapse sidebar ( [ )" @onclick="ToggleSidebar"><i data-lucide="panel-left"></i></button>
        </div>
        @foreach (var group in NavGroups)
        {
            var items = group.Items.Where(i => !i.AdminOnly || Auth.IsAdmin).ToList();
            @if (items.Count > 0)
            {
                <div class="nav-group">
                    <div class="nav-label">@group.Label</div>
                    @foreach (var item in items)
                    {
                        <NavLink class="nav-item" href="@item.Href" data-tip="@item.Tip"
                                 Match="@(item.Href == "/dashboard" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                            <i data-lucide="@item.Icon"></i><span class="lbl">@item.Label</span>
                            @if (item.BadgeKey is { } key && Badges.Any(key))
                            {
                                <span class="nav-count">@(Badges[key] > 99 ? "99+" : Badges[key].ToString())</span>
                            }
                        </NavLink>
                    }
                </div>
            }
        }
        <div class="sidebar-foot">
            <button type="button" class="me-card" title="Your account" aria-haspopup="menu" aria-expanded="@(meMenuOpen ? "true" : "false")"
                    @onclick="ToggleMeMenu" @onclick:stopPropagation>
                <span class="avatar" style="@AvatarPhotos.Style(Auth.Me?.Nik)">@Initials<span class="sdot @Auth.MyStatus"></span></span>
                <span class="who"><span class="n">@UserName</span><span class="r">@UserRole</span></span>
                <i data-lucide="chevrons-up-down" class="chev"></i>
            </button>
            @if (meMenuOpen)
            {
                <div class="me-menu" role="menu" @onclick:stopPropagation>
                    <button role="menuitem" @onclick="() => OpenAccount(AccountSheet.Pane.Profile)"><i data-lucide="user-round-pen"></i>Edit profile</button>
                    <button role="menuitem" @onclick="() => OpenAccount(AccountSheet.Pane.Password)"><i data-lucide="key-round"></i>Change password</button>
                    <div class="sep"></div>
                    <button role="menuitem" class="danger" @onclick="SignOut"><i data-lucide="log-out"></i>Sign out</button>
                </div>
            }
        </div>
    </aside>

    <div class="main">
        <header class="topbar v6-topbar">
            @* v6 header: stacked title + subtitle, spacer, global search, presence, theme, bell. *@
            <img class="tb-mark" src="img/brand/ipop-mark.webp" alt="iPop" width="28" height="28" />
            <div class="tb-title">
                <h1>@PageTitle</h1>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <div class="tb-sub">@Subtitle</div>
                }
            </div>
            @if (IsProjectsPage && Auth.ConnectionState == DirectoryConnectionState.Live)
            {
                <span class="tb-live"><span class="d"></span>Live</span>
            }
            <div class="tb-spacer"></div>
            <SectionOutlet SectionName="topbar-actions" />
            <button class="search-trigger" @onclick="Palette.Open" title="Search iPop (Ctrl+K)" aria-label="Search iPop">
                <i data-lucide="search"></i><span>Search iPop</span><kbd>@SearchShortcut</kbd>
            </button>
            <div class="topbar-right">
                @if (Auth.Me is not null)
                {
                    <TopbarTimer />
                    <div class="status-wrap">
                        <button class="presence-toggle" title="Set your status" @onclick="ToggleStatusMenu" @onclick:stopPropagation>
                            <span class="sdot @Auth.MyStatus"></span>
                            <span class="status-lbl">@StatusLabel</span>
                            <i data-lucide="chevron-down" class="chev"></i>
                        </button>
                        @if (statusMenuOpen)
                        {
                            <div class="status-menu" @onclick:stopPropagation>
                                <button @onclick="() => SetStatus(false)"><span class="sdot on"></span><span class="l">Online<small>Automatic</small></span>@if (Auth.MyStatus != "busy") {<i data-lucide="check"></i>}</button>
                                <button @onclick="() => SetStatus(true)"><span class="sdot busy"></span><span class="l">Busy<small>Mute calls &amp; banners</small></span>@if (Auth.MyStatus == "busy") {<i data-lucide="check"></i>}</button>
                                <div class="status-sep"></div>
                                @if (!Push.Secure || Push.Permission == "unsupported")
                                {
                                    <div class="status-note"><i data-lucide="bell-off"></i><span class="l">Windows notifications unavailable<small>Open iPop via https://ipop.santos.co.id</small></span></div>
                                }
                                else if (Push.Permission == "denied")
                                {
                                    <button class="status-alerts" @onclick="() => { statusMenuOpen = false; NotifSettings.Open(); }"><i data-lucide="bell-off"></i><span class="l">Windows notifications blocked<small>See how to allow them</small></span></button>
                                }
                                else if (Push.Permission == "default" || !Push.Subscribed || Push.Idle == "prompt")
                                {
                                    <button class="status-alerts" @onclick="EnableDesktopAlerts"><i data-lucide="bell-ring"></i><span class="l">Turn on Windows notifications<small>Windows toasts + idle detection (Away)</small></span></button>
                                }
                                else
                                {
                                    <div class="status-note"><i data-lucide="bell-ring"></i><span class="l">Windows notifications on<small>Shown when you're not looking at iPop</small></span></div>
                                }
                            </div>
                        }
                    </div>
                }
                <button class="theme-btn tut-help-btn @(TutorialPulse ? "pulse" : "")" title="Help for this page" aria-label="Help" @onclick="Tutorials.ToggleHelp">?</button>
                <button class="theme-btn" title="@(IsDark ? "Switch to light mode" : "Switch to dark mode")" @onclick="ToggleTheme">
                    <i data-lucide="@(IsDark ? "sun" : "moon")"></i>
                </button>
                <div class="bell-wrap">
                    <button class="bell-btn" title="Notifications" @onclick="ToggleNotif" @onclick:stopPropagation>
                        <i data-lucide="bell"></i>
                        @if (NotifUnread > 0 && NotifPrefs.ShowBadge)
                        {
                            <span class="badge">@NotifUnread</span>
                        }
                    </button>
                    @* Apple Notification Center popover tray *@
                    <div class="notif-pop @(notifOpen ? "on" : "")" @onclick:stopPropagation>
                        <div class="apple-notif-pop-card">
                            <div class="apple-notif-header">
                                <div class="apple-notif-title-group">
                                    <span class="apple-notif-title">Notifications</span>
                                    @if (NotifUnread > 0)
                                    {
                                        <span class="apple-notif-unread-badge">@NotifUnread new</span>
                                    }
                                </div>
                                @if (NotifUnread > 0)
                                {
                                    <button type="button" class="apple-notif-readall-btn" @onclick="MarkAllNotifsRead" title="Mark all read">
                                        Mark all read
                                    </button>
                                }
                            </div>

                            <div class="apple-notif-body">
                                @if (Notifs.IsLoading && Notifs.RecentNotifications.Count == 0)
                                {
                                    <div class="apple-notif-loading">
                                        <div class="skel" style="height:54px;border-radius:12px;margin-bottom:8px"></div>
                                        <div class="skel" style="height:54px;border-radius:12px"></div>
                                    </div>
                                }
                                else if (Notifs.RecentNotifications.Count == 0)
                                {
                                    <div class="apple-notif-empty">
                                        <div class="apple-notif-empty-icon">
                                            <i data-lucide="bell-off"></i>
                                        </div>
                                        <div class="apple-notif-empty-title">You are all caught up.</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="apple-notif-list">
                                        @foreach (var item in Notifs.RecentNotifications)
                                        {
                                            var notif = item;
                                            var mod = NotificationModules.For(notif);
                                            var timeText = FormatNotifTime(notif.At);

                                            <div class="apple-notif-row @(notif.IsRead ? "read" : "unread")"
                                                 @onclick="() => OnNotifClicked(notif)">
                                                <div class="apple-notif-ic nb-tile nb-m-@mod.Key">
                                                    <i data-lucide="@mod.Icon"></i>
                                                </div>
                                                <div class="apple-notif-info nb-m-@mod.Key">
                                                    <span class="apple-notif-mod">@mod.Label</span>
                                                    <div class="apple-notif-row-top">
                                                        <span class="apple-notif-row-title">@notif.Title</span>
                                                        <span class="apple-notif-row-time">@timeText</span>
                                                    </div>
                                                    <div class="apple-notif-row-desc">@notif.Body</div>
                                                </div>
                                                @if (!notif.IsRead)
                                                {
                                                    <span class="apple-notif-dot" title="Unread"></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <button type="button" class="apple-notif-footer" @onclick="OpenInbox">
                                <span>Open Notification Center</span>
                                <i data-lucide="arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <IPop.Web.Components.Tutorial.PracticeBar />
        @if (Push.BannerVisible)
        {
            <div class="push-banner" role="status">
                <i data-lucide="bell-ring"></i>
                <span><b>Turn on Windows notifications</b><span class="long"> — messages, calls, and iPop notifications still appear when the tab is closed</span></span>
                <span class="sp"></span>
                <button type="button" class="p" @onclick="EnableDesktopAlerts">Turn on</button>
                <button type="button" @onclick="Push.DismissBannerAsync">Later</button>
            </div>
        }

        <CascadingValue Value="this">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div style="padding:48px 24px;text-align:center;max-width:480px;margin:60px auto;background:var(--surface);border:1px solid var(--line);border-radius:18px;box-shadow:var(--sh-card)">
                        <div style="width:48px;height:48px;border-radius:50%;background:rgba(255,59,48,0.12);color:#ff3b30;display:inline-flex;align-items:center;justify-content:center;margin-bottom:14px">
                            <i data-lucide="alert-circle" style="width:24px;height:24px"></i>
                        </div>
                        <h2 style="font-size:16px;font-weight:650;margin-bottom:6px;color:var(--ink)">An error occurred in this view</h2>
                        <p style="font-size:12.5px;color:var(--ink-3);margin-bottom:18px;line-height:1.4">
                            @(ex.Message)
                        </p>
                        <div style="display:flex;gap:10px;justify-content:center">
                            <button type="button" class="btn-primary" @onclick="() => errorBoundary?.Recover()">Try again</button>
                            <button type="button" class="ghost-btn" @onclick='() => Nav.NavigateTo(Nav.Uri, forceLoad: true)'>Reload</button>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </CascadingValue>
        <CommandPalette />
        <IPop.Web.Components.Tutorial.TutorialHost />
        <IPop.Web.Components.News.AnnouncementPopup />
        <NotificationSettingsDialog />
        <ConfirmHost />
        <PhotoViewer />
        <SessionLockHost />
        <AccountSheet @bind-IsOpen="accountOpen" Start="accountPane" />
        @* Session-wide so a draft survives leaving /mail; Mail.razor drives it via MailComposerHost. *@
        <IPop.Web.Components.Mail.MailComposer @ref="ComposerHost.Instance"
                                               IsOpenChanged="ComposerHost.RaiseOpenChanged"
                                               OnSent="ComposerHost.RaiseSent"
                                               OnDiscard="ComposerHost.RaiseDiscarded"
                                               OnOpenTemplates="ComposerHost.RaiseOpenTemplates" />
        <IPop.Web.Components.Calls.GlobalCallOverlay />
        @* One floating column: incoming-notification banners above action toasts, so they never overlap. *@
        <div class="float-stack">
            <IPop.Web.Components.Notifications.GlobalNotificationBanner />
            <IPop.Web.Components.Chat.ToastHost />
        </div>
    </div>

    @* Phone tab bar + "More" sheet. Rendered once; css/mobile/shell.css hides both above 767px. *@
    <nav class="m-tabbar" aria-label="Main">
        @foreach (var item in TabItems)
        {
            <NavLink class="m-tab" href="@item.Href" Match="@(item.Href == "/dashboard" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="CloseMore">
                <span class="m-tab-ic"><i data-lucide="@item.Icon"></i>
                    @if (item.BadgeKey is { } key && Badges.Any(key))
                    {
                        <span class="m-tab-badge">@(Badges[key] > 99 ? "99+" : Badges[key].ToString())</span>
                    }
                </span>
                <span class="m-tab-lbl">@item.Label</span>
            </NavLink>
        }
        <button type="button" class="m-tab @(moreOpen || IsMoreRoute ? "active" : "")" aria-haspopup="dialog" aria-expanded="@(moreOpen ? "true" : "false")" @onclick="ToggleMore">
            <span class="m-tab-ic"><i data-lucide="ellipsis"></i>
                @if (MoreBadgeTotal > 0)
                {
                    <span class="m-tab-badge dot"></span>
                }
            </span>
            <span class="m-tab-lbl">More</span>
        </button>
    </nav>
    @if (moreOpen)
    {
        <div class="m-sheet-backdrop" @onclick="CloseMore"></div>
        <div class="m-sheet m-more" role="dialog" aria-modal="true" aria-label="More">
            <div class="m-sheet-grip"></div>
            <div class="m-more-user">
                <div class="avatar">@Initials<span class="sdot @Auth.MyStatus"></span></div>
                <div class="who"><div class="n">@UserName</div><div class="r">@UserRole@(string.IsNullOrEmpty(UserRole) ? "" : " · ")@StatusLabel</div></div>
            </div>
            <div class="m-more-list">
                @foreach (var item in MoreItems.Where(i => !i.AdminOnly || Auth.IsAdmin))
                {
                    <NavLink class="m-more-item" href="@item.Href" Match="NavLinkMatch.Prefix" @onclick="CloseMore">
                        <span class="m-more-ic"><i data-lucide="@item.Icon"></i></span>
                        <span class="m-more-lbl">@item.Label</span>
                        @if (item.BadgeKey is { } key && Badges.Any(key))
                        {
                            <span class="nav-count">@(Badges[key] > 99 ? "99+" : Badges[key].ToString())</span>
                        }
                        <i data-lucide="chevron-right" class="m-more-chev"></i>
                    </NavLink>
                }
            </div>
            <button type="button" class="m-more-signout" @onclick="SignOut"><i data-lucide="log-out"></i><span>Sign out</span></button>
        </div>
    }
</div>

@code {
    private bool collapsed, notifOpen, statusMenuOpen, meMenuOpen;
    private DotNetObjectReference<MainLayout>? selfRef;
    private ErrorBoundary? errorBoundary;

    private bool IsProjectsPage
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
            return path == "/projects" || path.StartsWith("/projects/");
        }
    }

    private record NavItem(string Label, string Icon, string Href, string? BadgeKey = null, bool AdminOnly = false, string? Tip = null)
    {
        public string Tip { get; init; } = Tip ?? Label;
    }
    private record NavGroup(string Label, NavItem[] Items);

    /// One table drives the sidebar (v6 grouped nav). Devices stays hidden until it has a design.
    private static readonly NavGroup[] NavGroups =
    [
        new("Workspace", [
            new("Dashboard", "layout-grid", "/dashboard"),
            new("Directory", "users", "/directory"),
            new("Projects", "kanban", "/projects"),
            new("Notes", "notebook-pen", "/notes"),
        ]),
        new("Communication", [
            new("Chat", "message-circle", "/chat", BadgeKey: "chat"),
            new("Mail", "mail", "/mail", BadgeKey: "mail"),
            new("News & Memos", "newspaper", "/news", BadgeKey: "news"),
            new("Calls", "phone", "/calls", BadgeKey: "calls"),
        ]),
        new("Resources", [
            new("Files", "folder", "/files"),
            new("Calendar", "calendar", "/calendar"),
        ]),
        new("Administration", [
            new("Administration", "sliders-horizontal", "/admin", AdminOnly: true),
            new("Notifications", "bell", "/notifications", BadgeKey: "notif"),
        ]),
    ];

    /// Phone tab bar (<= 767px): four primary modules plus "More", which lists the rest.
    /// Both lists are drawn from NavGroups so labels, icons and badge keys stay in sync.
    private static readonly string[] TabHrefs = ["/dashboard", "/chat", "/mail", "/projects"];
    private static readonly NavItem[] TabItems =
        TabHrefs.Select(h => NavGroups.SelectMany(g => g.Items).First(i => i.Href == h)).ToArray();
    private static readonly NavItem[] MoreItems =
        NavGroups.SelectMany(g => g.Items).Where(i => !TabHrefs.Contains(i.Href)).ToArray();

    private bool moreOpen;
    private IDisposable? moreReg;

    private bool IsMoreRoute
    {
        get
        {
            var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
            return MoreItems.Any(i => path == i.Href || path.StartsWith(i.Href + "/"));
        }
    }

    private int MoreBadgeTotal => MoreItems.Where(i => i.BadgeKey is not null && (!i.AdminOnly || Auth.IsAdmin))
                                           .Sum(i => Badges[i.BadgeKey!]);

    private void ToggleMore()
    {
        if (moreOpen) { CloseMore(); return; }
        moreOpen = true; notifOpen = false; statusMenuOpen = false;
        moreReg = Overlays.Push(() => { CloseMore(); StateHasChanged(); return Task.CompletedTask; });
    }

    private void CloseMore()
    {
        if (!moreOpen) return;
        moreOpen = false;
        moreReg?.Dispose(); moreReg = null;
    }

    private string SearchShortcut { get; set; } = "Ctrl K";
    private string UserName => Auth.Me is null ? "…" : IPop.Application.PersonName.Display(Auth.Me.Name);
    private string UserRole => Auth.Me is null ? "" : Auth.IsAdmin ? "Super admin" : (Auth.Me.Department ?? "");
    /// Unread count behind the bell badge (NotificationState; mock count until backend).
    private int NotifUnread => Notifs.UnreadCount;
    private NotificationLocalPrefs NotifPrefs { get; set; } = new();
    private string Initials => Auth.Me is null
        ? "·"
        : string.Concat(Auth.Me.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Select(w => w[0]).Take(2)).ToUpperInvariant();

    private string SyncCaption => syncedAt is null
        ? "Waiting for the first sync"
        : $"{syncCount} records · {syncedAt:HH:mm}";

    private bool PresenceConnected => Auth.ConnectionState != DirectoryConnectionState.Connecting;
    private string PresenceLabel => Auth.ConnectionState switch
    {
        DirectoryConnectionState.Live => "Live",
        DirectoryConnectionState.Reconnecting => "Reconnecting...",
        _ => "Connecting..."
    };

    private DateTime? syncedAt;
    private int syncCount;

    public string PageTitle { get; private set; } = "Dashboard";
    public string Crumb { get; private set; } = "";
    public bool ShowSearch { get; private set; }
    public string? SearchQuery { get; set; }
    public event Action? SearchChanged;

    /// ipop-25: page-supplied placeholder so the shell search stops lying about what
    /// it searches (it said "people" on News). Defaults keep existing callers unchanged.
    public string SearchPlaceholder { get; private set; } = "Search people by name or ID";

    /// Raised when Escape is pressed anywhere. Pages use it to close overlays.
    public event Action? EscapePressed;

    /// Toolbar summary under the title (e.g. "6 unread · 142 messages"). Only rendered on
    /// toolbar pages; every SetHeader clears it so it never leaks across navigation.
    public string Subtitle { get; private set; } = "";

    public void SetHeader(string title, string crumb = "", bool showSearch = false, string? searchPlaceholder = null)
    {
        PageTitle = title; Crumb = crumb; ShowSearch = showSearch;
        SearchPlaceholder = searchPlaceholder ?? "Search people by name or ID";
        // v6 has no crumb pill — the second argument is the subtitle under the title until
        // the page replaces it with live counts via SetSubtitle.
        Subtitle = crumb;
        StateHasChanged();
    }

    public void SetSubtitle(string subtitle)
    {
        if (Subtitle == subtitle) return;
        Subtitle = subtitle;
        StateHasChanged();
    }

    private void NotifySearchChanged() => SearchChanged?.Invoke();

    /// v6 puts module search boxes in the page toolbar, not the header; they feed the same
    /// SearchQuery/SearchChanged contract the pages already listen to.
    public void SetSearch(string? q) { SearchQuery = q; SearchChanged?.Invoke(); }

    private void OnPresenceChanged(string nik, string status)
        => _ = InvokeAsync(StateHasChanged);

    private void OnConnectionStateChanged() => _ = InvokeAsync(StateHasChanged);

    /// The refresh token was refused — the session is genuinely over. Send the user to sign in
    /// rather than leaving them on a shell whose every request 401s behind a red error bar.
    /// forceLoad: the whole component tree holds state tied to the old session, and a clean
    /// document is both simpler and safer than unwinding it page by page.
    private void OnSessionEnded() => _ = InvokeAsync(() => Nav.NavigateTo("/login", forceLoad: true));

    private void OnChatUnreadChanged() { Badges.Set("chat", Chat.TotalUnread); _ = InvokeAsync(StateHasChanged); }
    private void OnChatIncoming(IncomingChatMessage m)
        => _ = InvokeAsync(() => Notifs.ShowChatMessage(m, "/" + Nav.ToBaseRelativePath(Nav.Uri)));
    private void OnChatRoomOpened(Guid roomId) => _ = InvokeAsync(() => Notifs.ClearChatBanner(roomId));

    private void OnNotifUnreadChanged() { Badges.Set("notif", Notifs.UnreadCount); _ = InvokeAsync(StateHasChanged); }

    /// Preferensi berubah (disimpan dari halaman settings) — muat ulang localStorage
    /// lalu render ulang agar badge lonceng langsung mengikuti ShowBadge terbaru.
    private void OnNotifPreferencesChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", "notification-preferences");
            if (!string.IsNullOrEmpty(json))
            {
                var p = System.Text.Json.JsonSerializer.Deserialize<NotificationLocalPrefs>(json);
                if (p is not null) NotifPrefs = p;
            }
        }
        catch { }
        StateHasChanged();
    });

    private void OnNotificationsChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { }
    });

    private void ToggleSidebar() => collapsed = !collapsed;

    private async Task ToggleNotif()
    {
        notifOpen = !notifOpen;
        if (notifOpen)
        {
            await Notifs.LoadRecentAsync();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    private async Task MarkAllNotifsRead()
    {
        await Notifs.MarkAllReadAsync();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task OnNotifClicked(ShellNotificationItem item)
    {
        notifOpen = false;
        var targetUrl = NotificationState.GetRedirectUrl(item);
        await Notifs.MarkReadAsync(item.Id);
        Nav.NavigateTo(targetUrl);
    }

    private static string FormatNotifTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalSeconds < 60) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m";
        if (diff.TotalHours < 24) return dt.ToString("HH:mm");
        return dt.ToString("dd/MM");
    }

    /// Bell tray "Open inbox" — jump to the personal notification inbox.
    private void OpenInbox()
    {
        notifOpen = false;
        Nav.NavigateTo("/notifications/inbox");
    }

    private bool IsDark { get; set; }

    private async Task ToggleTheme()
    {
        IsDark = await JS.InvokeAsync<string>("ipop.toggleTheme") == "dark";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private string StatusLabel => Auth.MyStatus switch
    {
        "on" => "Online",
        "away" => "Away",
        "busy" => "Busy",
        _ => "Offline"
    };

    private async Task ToggleStatusMenu()
    {
        statusMenuOpen = !statusMenuOpen;
        notifOpen = false; meMenuOpen = false;
        if (statusMenuOpen) await Push.RefreshAsync();
    }

    /// Browsers only grant notification/idle permission from a click, hence the banner and menu item.
    private async Task EnableDesktopAlerts()
    {
        statusMenuOpen = false;
        await Push.EnableAsync();
        if (Push.Permission == "denied") NotifSettings.Open();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private void OnPushChanged() => _ = InvokeAsync(async () => { StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); });

    /// "Jawab" on the call toast opens /calls?answer={id}: accept that ring if it is still ringing here.
    private async Task AnswerFromToastAsync()
    {
        var m = System.Text.RegularExpressions.Regex.Match(Nav.Uri, @"[?&]answer=([0-9a-fA-F-]{36})");
        if (!m.Success || !Guid.TryParse(m.Groups[1].Value, out var callId)) return;
        Nav.NavigateTo("/calls", replace: true);
        if (CallSvc.Current?.Id != callId) await CallSvc.RefreshAsync();
        if (CallSvc.Current?.Id == callId && CallSvc.IsIncomingRing) await CallSvc.AcceptCurrentAsync();
    }

    /// "(3) Messages — IPop": unread chat + mail in the tab title so a background tab still says so.
    private int _titleCount = -1;
    private void SyncTitleBadge()
    {
        var n = Badges["chat"] + Badges["mail"];
        if (n == _titleCount) return;
        _titleCount = n;
        _ = JS.InvokeVoidAsync("ipop.setTitleBadge", n).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
    }

    private void ToggleMeMenu() { meMenuOpen = !meMenuOpen; notifOpen = false; statusMenuOpen = false; }

    private bool accountOpen;
    private AccountSheet.Pane accountPane;

    /// The account sheet is a popup over whatever page is open; /profile opens it too.
    public void OpenAccount(AccountSheet.Pane pane)
    {
        meMenuOpen = false;
        accountPane = pane;
        accountOpen = true;
        StateHasChanged();
    }

    private void OnMeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnPhotosChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnDirectoryChanged() => _ = InvokeAsync(Auth.LoadPhotosAsync);

    private async Task SetStatus(bool busy)
    {
        statusMenuOpen = false;
        if ((Auth.MyStatus == "busy") != busy) await Auth.SetBusyAsync(busy);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SignOut()
    {
        meMenuOpen = false;
        await Push.SignOutAsync();
        Badges.Stop(); Badges.Clear();
        Timer.Stop();
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login", replace: true);
    }

    [JSInvokable]
    public async Task OnEscape()
    {
        // Top-most overlay first (palette, confirm, modal, context menu), then page overlays.
        if (await Overlays.CloseTopAsync()) { StateHasChanged(); return; }
        EscapePressed?.Invoke();
        notifOpen = false; statusMenuOpen = false; meMenuOpen = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnCommandPalette() { Palette.Toggle(); StateHasChanged(); }

    [JSInvokable]
    public void OnToggleSidebar() { collapsed = !collapsed; StateHasChanged(); }

    [JSInvokable]
    public void OnClickAway()
    {
        if (!notifOpen && !statusMenuOpen && !meMenuOpen) return;
        notifOpen = false; statusMenuOpen = false; meMenuOpen = false;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        Tutorials.ResumePractice();
        Auth.PresenceChanged += OnPresenceChanged;
        Auth.ConnectionStateChanged += OnConnectionStateChanged;
        Auth.SessionEnded += OnSessionEnded;
        Chat.RoomListChanged += OnChatUnreadChanged;
        Chat.IncomingMessage += OnChatIncoming;
        Chat.RoomOpened += OnChatRoomOpened;
        Notifs.UnreadChanged += OnNotifUnreadChanged;
        Notifs.NotificationsChanged += OnNotificationsChanged;
        Notifs.PreferencesChanged += OnNotifPreferencesChanged;
        Nav.LocationChanged += OnLocationChanged;
        Badges.Changed += OnBadgesChanged;
        Auth.MeChanged += OnMeChanged;
        Auth.DirectoryChanged += OnDirectoryChanged;
        AvatarPhotos.Changed += OnPhotosChanged;
        await Auth.LoadMeAsync();
        Tutorials.Changed += OnTutorialsChanged;
        _ = Tutorials.LoadAsync();
        await Auth.LoadPhotosAsync();
        // Another tab in a call keeps the session: this one shows the yield prompt and the
        // hub connects below all no-op (Auth.IsSuspended) until "Tetap gunakan di sini".
        await SessionLock.StartAsync();
        await Auth.StartPresenceAsync();
        await Badges.StartAsync();
        await Timer.StartAsync();
        await Chat.ConnectAsync();
        // Connect notification SignalR AFTER auth so the token provider has a token.
        await Notifs.ConnectAsync();
        await Notifs.LoadRecentAsync(6);
        await CallSvc.ConnectAsync();
        Push.Changed += OnPushChanged;
        await Push.StartAsync();
        await AnswerFromToastAsync();
        var s = await Auth.GetAsync<SyncStatusDto>("/api/admin/hris/status");
        if (s is not null) { syncedAt = s.LastSyncedAt?.ToLocalTime(); syncCount = s.EmployeeCount; }
    }

    // Re-render so the toolbar/standard header switch follows the route.
    /// The "?" pulses until this module's tour has been seen once.
    private bool TutorialPulse => TutorialRegistry.ForPath(Nav.ToBaseRelativePath(Nav.Uri)) is { } m && !Tutorials.IsSeen(m.Key);
    private void OnTutorialsChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnBadgesChanged() => _ = InvokeAsync(() => { SyncTitleBadge(); StateHasChanged(); });

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        errorBoundary?.Recover();
        CloseMore();
        if (e.Location.Contains("answer=")) _ = InvokeAsync(AnswerFromToastAsync);
        _ = InvokeAsync(StateHasChanged);
    }

    private class NotificationLocalPrefs
    {
        public bool EnableNotifications { get; set; } = true;
        public bool PlaySound { get; set; } = true;
        public bool ShowBadge { get; set; } = true;
        public bool ShowPreview { get; set; } = true;
    }

    private record SyncStatusDto(DateTime? LastSyncedAt, int EmployeeCount);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Muat preferensi notifikasi lokal (ShowBadge) dari localStorage.
            try
            {
                var json = await JS.InvokeAsync<string>("localStorage.getItem", "notification-preferences");
                if (!string.IsNullOrEmpty(json))
                {
                    var p = System.Text.Json.JsonSerializer.Deserialize<NotificationLocalPrefs>(json);
                    if (p is not null) { NotifPrefs = p; }
                }
            }
            catch { }

            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ipop.shortcuts", selfRef);
            IsDark = await JS.InvokeAsync<string>("ipop.theme") == "dark";
            // Label follows the OS (both Ctrl+K and ⌘K always open the palette).
            try
            {
                var mac = await JS.InvokeAsync<bool>("eval", "/mac|iphone|ipad/i.test(navigator.userAgentData?.platform || navigator.platform || '')");
                SearchShortcut = mac ? "⌘K" : "Ctrl K";
            }
            catch { }
            StateHasChanged();
        }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        selfRef?.Dispose();
        moreReg?.Dispose();
        Auth.PresenceChanged -= OnPresenceChanged;
        Auth.ConnectionStateChanged -= OnConnectionStateChanged;
        Auth.SessionEnded -= OnSessionEnded;
        Push.Changed -= OnPushChanged;
        Chat.RoomListChanged -= OnChatUnreadChanged;
        Chat.IncomingMessage -= OnChatIncoming;
        Chat.RoomOpened -= OnChatRoomOpened;
        Notifs.UnreadChanged -= OnNotifUnreadChanged;
        Notifs.NotificationsChanged -= OnNotificationsChanged;
        Notifs.PreferencesChanged -= OnNotifPreferencesChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Tutorials.Changed -= OnTutorialsChanged;
        Badges.Changed -= OnBadgesChanged;
        Auth.MeChanged -= OnMeChanged;
        Auth.DirectoryChanged -= OnDirectoryChanged;
        AvatarPhotos.Changed -= OnPhotosChanged;
        Badges.Stop();
        Timer.Stop();
        _ = JS.InvokeVoidAsync("ipop.shortcutsOff");
    }
}
