@page "/dashboard"
@using IPop.Web.Models
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IPop.Web.Services.CallState CallSvc

<PageTitle>Dashboard — IPop</PageTitle>

<div class="dash">
    <div class="dash-hero">
        <div class="dash-hello">
            <span class="dash-date">@DateTime.Now.ToString("dddd, d MMMM yyyy")</span>
            <span class="dash-greet">@Greeting, @(data?.FirstName ?? Auth.Me?.Name?.Split(' ')[0] ?? "there")</span>
        </div>
        <div class="dash-quick">
            <a class="dash-pill" href="/chat"><i data-lucide="square-pen"></i>New message</a>
            <a class="dash-pill" href="/mail?compose=1"><i data-lucide="mail-plus"></i>Compose</a>
            <a class="dash-pill" href="/projects"><i data-lucide="list-plus"></i>New task</a>
            <a class="dash-pill" href="/calls?tab=scheduled&amp;new=1"><i data-lucide="calendar-plus"></i>Schedule</a>
            <a class="dash-pill" href="/news?new=1"><i data-lucide="megaphone"></i>New post</a>
        </div>
    </div>

    <div class="dash-kpis">
        @if (data is null)
        {
            @for (var i = 0; i < 4; i++) { <div class="dash-kpi"><div class="skel" style="height:64px;border-radius:10px"></div></div> }
        }
        else
        {
            var k = data.Kpis;
            <a class="dash-kpi" href="/mail">
                <div class="dash-kpi-head"><span class="dash-kpi-ic tone-accent"><i data-lucide="mail"></i></span><span class="dash-kpi-label">Unread mail</span><i data-lucide="chevron-right" class="dash-chev"></i></div>
                <div class="dash-kpi-body"><span class="dash-kpi-val">@k.MailUnread</span><span class="dash-kpi-sub">@k.MailInbox in inbox</span></div>
            </a>
            <a class="dash-kpi" href="/chat">
                <div class="dash-kpi-head"><span class="dash-kpi-ic tone-teal"><i data-lucide="message-circle"></i></span><span class="dash-kpi-label">Unread chats</span><i data-lucide="chevron-right" class="dash-chev"></i></div>
                <div class="dash-kpi-body"><span class="dash-kpi-val">@k.ChatUnread</span><span class="dash-kpi-sub">@k.ChatRooms conversations</span></div>
            </a>
            <a class="dash-kpi" href="/projects">
                <div class="dash-kpi-head"><span class="dash-kpi-ic tone-violet"><i data-lucide="list-checks"></i></span><span class="dash-kpi-label">My open tasks</span><i data-lucide="chevron-right" class="dash-chev"></i></div>
                <div class="dash-kpi-body"><span class="dash-kpi-val">@k.OpenTasks</span>
                    <span class="dash-kpi-sub @(k.OverdueTasks > 0 ? "is-bad" : "is-ok")">@(k.OverdueTasks > 0 ? $"{k.OverdueTasks} overdue" : "On track")</span></div>
            </a>
            <a class="dash-kpi" href="@(k.NextMeetingId is { } mid ? $"/calls?tab=scheduled&meeting={mid}" : "/calls?tab=scheduled")">
                <div class="dash-kpi-head"><span class="dash-kpi-ic tone-blue"><i data-lucide="calendar-clock"></i></span><span class="dash-kpi-label">Next meeting</span><i data-lucide="chevron-right" class="dash-chev"></i></div>
                <div class="dash-kpi-body"><span class="dash-kpi-val">@(k.NextMeetingAt is { } nm ? Local(nm).ToString("HH:mm") : "—")</span>
                    <span class="dash-kpi-sub">@(k.NextMeetingTitle ?? "Nothing scheduled")</span></div>
            </a>
        }
    </div>

    <div class="dash-row dash-row-2">
        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Today</span><span class="dash-card-meta">@DateTime.Now.ToString("ddd, d MMM")</span><a class="dash-link" href="/calendar">Calendar</a></header>
            @if (data is not null)
            {
                @foreach (var a in data.Agenda)
                {
                    <div class="dash-agenda @(a.Ended ? "is-ended" : "")">
                        <span class="dash-agenda-time">@AgendaTime(a)</span>
                        <span class="dash-agenda-bar @(a.Kind == "task" ? "is-task" : a.Ended ? "is-ended" : "")"></span>
                        <div class="dash-main"><span class="dash-t">@a.Title</span><span class="dash-s">@AgendaSub(a)</span></div>
                        @if (a.Kind == "meeting" && !a.Ended && a.RoomName is not null)
                        {
                            <a class="dash-btn primary" href="/meet/@a.RoomName"><i data-lucide="video"></i>Join</a>
                        }
                        else
                        {
                            <a class="dash-btn" href="@a.Url">@(a.Kind == "task" ? "Open" : "Details")</a>
                        }
                    </div>
                }
                @if (data.Agenda.Count == 0) { <span class="dash-empty">Nothing scheduled today.</span> }
            }
        </section>

        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Needs your attention</span><span class="dash-card-meta">@(data?.Attention.Count > 0 ? $"{data.Attention.Count} items" : "")</span><a class="dash-link" href="/notifications">All</a></header>
            @if (data is not null)
            {
                @foreach (var a in data.Attention.Take(5))
                {
                    <div class="dash-item" role="button" tabindex="0" @onclick="() => OpenAttention(a)">
                        <span class="dash-att-ic @AttTone(a.Kind)"><i data-lucide="@AttIcon(a.Kind)"></i></span>
                        <div class="dash-main"><span class="dash-t">@a.Title</span><span class="dash-s">@a.Sub</span></div>
                        <span class="dash-cta">@a.Cta</span>
                    </div>
                }
                @if (data.Attention.Count == 0) { <div class="dash-caught-up"><i data-lucide="circle-check"></i>You're all caught up.</div> }
            }
        </section>
    </div>

    <div class="dash-row dash-row-3">
        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">My tasks</span><a class="dash-link" href="/projects">View all</a></header>
            @if (data is not null)
            {
                @foreach (var t in data.MyTasks)
                {
                    <div class="dash-item" role="button" tabindex="0" @onclick="@(() => Nav.NavigateTo($"/projects/{t.ProjectId}?task={t.Id}"))">
                        <button class="dash-check" title="Complete" @onclick="() => CompleteTask(t)" @onclick:stopPropagation="true"></button>
                        <div class="dash-main"><span class="dash-t">@t.Title</span><span class="dash-s dash-proj"><span class="dash-swatch" style="background:@AvatarPalette.For(t.ProjectId.ToString())"></span>@t.ProjectName</span></div>
                        <span class="dash-due @(t.Overdue ? "is-bad" : "")">@(t.DueDate is { } d ? d.ToString("d MMM") : "No date")</span>
                    </div>
                }
                @if (data.MyTasks.Count == 0) { <span class="dash-empty">No open tasks assigned to you.</span> }
            }
        </section>

        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Projects</span><a class="dash-link" href="/projects">View all</a></header>
            @if (data is not null)
            {
                @foreach (var p in data.Projects)
                {
                    var pct = p.Total > 0 ? (int)Math.Round(p.Done * 100.0 / p.Total) : p.Progress;
                    var color = AvatarPalette.For(p.Id.ToString());
                    <a class="dash-proj-row" href="/projects/@p.Id">
                        <div class="dash-proj-top">
                            <span class="dash-proj-tile" style="background:@color">@Initials(p.Name)</span>
                            <div class="dash-main"><span class="dash-t">@p.Name</span><span class="dash-s">@p.Done/@p.Total tasks · @StatusLabel(p.Status)</span></div>
                            <span class="dash-pct">@pct%</span>
                        </div>
                        <div class="dash-meter"><i style="width:@(pct)%;background:@color"></i></div>
                    </a>
                }
                @if (data.Projects.Count == 0) { <span class="dash-empty">No active projects.</span> }
            }
        </section>

        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Recent messages</span><a class="dash-link" href="/chat">Open Chat</a></header>
            @if (data is not null)
            {
                @foreach (var c in data.Chats)
                {
                    <a class="dash-item" href="/chat/@c.Id">
                        <span class="dash-av @(c.Type == "group" ? "is-group" : "")" style="background:@(c.AvatarColor ?? AvatarPalette.For(c.Name))">@Initials(c.Name)</span>
                        <div class="dash-main"><span class="dash-t strong">@c.Name</span><span class="dash-s">@(c.LastMessage ?? "No messages")</span></div>
                        <div class="dash-chat-meta"><span class="dash-s">@(c.LastMessageAt is { } lm ? When(lm) : "")</span><span class="dash-dot @(c.Unread > 0 ? "is-on" : "")"></span></div>
                    </a>
                }
                @if (data.Chats.Count == 0) { <span class="dash-empty">No conversations yet.</span> }
            }
        </section>
    </div>

    <div class="dash-row dash-row-news">
        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Latest news</span><a class="dash-link" href="/news">News &amp; Memos</a></header>
            @if (data is not null)
            {
                @foreach (var n in data.News)
                {
                    <a class="dash-item" href="/news?post=@n.Id">
                        <span class="dash-cat @(n.Type == "memo" ? "is-memo" : "")">@(n.Type == "memo" ? "Memo" : "News")</span>
                        <span class="dash-t dash-main">@n.Title</span>
                        <span class="dash-s">@(n.PublishedAt is { } pd ? Local(pd).ToString("d MMM") : "")</span>
                    </a>
                }
                @if (data.News.Count == 0) { <span class="dash-empty">No posts yet.</span> }
            }
        </section>

        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">Team online</span><span class="dash-card-meta">@(data?.OnlineCount ?? 0) online</span><a class="dash-link" href="/directory">Directory</a></header>
            @if (data is not null)
            {
                <div class="dash-team">
                    @foreach (var p in data.Online)
                    {
                        <a class="dash-person" href="/directory/person/@p.Nik" title="@p.Name">
                            <span class="dash-av round" style="background:@AvatarPalette.For(p.Nik)">@Initials(p.Name)<span class="dash-presence st-@p.Status"></span></span>
                            <span class="dash-first">@p.Name.Split(' ')[0]</span>
                        </a>
                    }
                </div>
                @if (data.Online.Count == 0) { <span class="dash-empty">Nobody else is online right now.</span> }
            }
        </section>

        <section class="dash-card">
            <header class="dash-card-head"><span class="dash-card-title">System status</span></header>
            @if (data is not null)
            {
                @foreach (var x in data.Status)
                {
                    <div class="dash-status"><span class="dash-dot is-@x.State"></span><span class="dash-t">@x.Label</span><span class="dash-s">@x.Note</span></div>
                }
            }
        </section>
    </div>
</div>

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    private DashboardDto? data;

    private record DashboardDto(string FirstName, KpisDto Kpis, List<AgendaDto> Agenda, List<AttentionDto> Attention,
        List<TaskDto> MyTasks, List<ProjectDto> Projects, List<ChatDto> Chats, List<NewsDto> News,
        List<PersonDto> Online, int OnlineCount, List<StatusDto> Status);
    private record KpisDto(int MailUnread, int MailInbox, int ChatUnread, int ChatRooms, int OpenTasks, int OverdueTasks,
        DateTime? NextMeetingAt, string? NextMeetingTitle, Guid? NextMeetingId, int AckPending);
    private record AgendaDto(string Kind, Guid Id, string Title, string Sub, DateTime? StartAt, DateTime? EndAt,
        bool Ended, bool Overdue, string Url, string? RoomName);
    private record AttentionDto(string Kind, string Title, string Sub, string Cta, string Url, string? PeerNik);
    private record TaskDto(Guid Id, Guid ProjectId, string Title, string ProjectName, DateTime? DueDate, bool Overdue);
    private record ProjectDto(Guid Id, string Name, string Status, int Done, int Total, int Progress);
    private record ChatDto(Guid Id, string Type, string Name, string? LastMessage, DateTime? LastMessageAt, int Unread, string? AvatarColor);
    private record NewsDto(Guid Id, string Type, string Title, DateTime? PublishedAt, bool NeedsAck);
    private record PersonDto(string Nik, string Name, string Status);
    private record StatusDto(string Label, string State, string Note);

    private static string Greeting => DateTime.Now.Hour switch
    {
        < 11 => "Good morning",
        < 15 => "Good afternoon",
        < 19 => "Good evening",
        _ => "Good night",
    };

    protected override void OnInitialized() => Layout.SetHeader("Dashboard", "Overview");

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        data = await Auth.GetAsync<DashboardDto>("/api/dashboard");
        if (data is null) Toasts.Show("Couldn't load the dashboard.");
    }

    private async Task CompleteTask(TaskDto t)
    {
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/projects/tasks/{t.Id}/move", new { status = "done" });
        if (!res.IsSuccessStatusCode) { Toasts.Show("Couldn't complete the task."); return; }
        Toasts.Show($"“{t.Title}” completed", ToastKind.Success);
        await LoadAsync();
    }

    private async Task OpenAttention(AttentionDto a)
    {
        if (a.Kind == "missed-call" && !string.IsNullOrEmpty(a.PeerNik))
        {
            var room = await CallSvc.CreateAsync(a.PeerNik);
            if (room is not null) Nav.NavigateTo("/calls");
            return;
        }
        Nav.NavigateTo(a.Url);
    }

    private static DateTime Local(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();

    private static string AgendaTime(AgendaDto a) =>
        a.Kind == "task" ? (a.Overdue ? "Overdue" : "Today")
        : a.StartAt is { } s ? Local(s).ToString("HH:mm") : "";

    private static string AgendaSub(AgendaDto a) =>
        a.Kind == "meeting" && a.StartAt is { } s && a.EndAt is { } e
            ? $"{Local(s):HH:mm} – {Local(e):HH:mm} · {a.Sub}"
            : a.Sub;

    private static string When(DateTime utc)
    {
        var l = Local(utc);
        return l.Date == DateTime.Today ? l.ToString("HH:mm")
            : l.Date == DateTime.Today.AddDays(-1) ? "Yesterday"
            : l.ToString("d MMM");
    }

    private static string AttIcon(string kind) => kind switch
    {
        "ack" => "clipboard-check",
        "missed-call" => "phone-missed",
        "mention" => "at-sign",
        _ => "alarm-clock",
    };

    private static string AttTone(string kind) => kind switch
    {
        "ack" or "mention" => "tone-warn",
        _ => "tone-bad",
    };

    private static string StatusLabel(string s) => s switch
    {
        "planning" => "Planning",
        "active" => "Active",
        "on_hold" or "on-hold" => "On hold",
        _ => string.IsNullOrEmpty(s) ? "" : char.ToUpperInvariant(s[0]) + s[1..],
    };

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
        => await JS.InvokeVoidAsync("ipop.icons");
}
