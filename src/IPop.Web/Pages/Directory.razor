    private async Task AddNodeMember(NodeEditorState n)
    {
        var nik = n.NewMemberNik.Trim();
        if (nik.Length == 0) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/admin/org-nodes/{n.Id}/members", new DirGroupMemberRequest(nik));
