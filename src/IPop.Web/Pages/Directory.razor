    private async Task Reload(int requestedPage, bool replace)
    {
        loading = true;
        var url = $"/api/directory/employees?page={requestedPage}&pageSize={PageSize}&q={Uri.EscapeDataString(search.Trim())}&departmentCode={Uri.EscapeDataString(departmentCode)}&siteCode={Uri.EscapeDataString(siteCode)}&presence={Uri.EscapeDataString(presence)}";
        var result = await Auth.GetAsync<DirectoryPageDto>(url);
        loading = false;
        if (result is null) { loadError = "Could not load the directory."; return; }
        total = result.Total; page = result.Page;
        var mapped = result.Items.Select(Map).ToList();
        if (replace) people = mapped; else people.AddRange(mapped);
        selected = selected is null ? null : people.FirstOrDefault(p => p.Nik == selected.Nik);
        loadError = null;
        StateHasChanged();
    }

    private async Task ResetQuery()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var cts = new System.Threading.CancellationTokenSource();
        searchCts = cts;
        try { await Task.Delay(240, cts.Token); } catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;
        await Reload(1, replace: true);
    }
    private Task LoadMore() => Reload(page + 1, replace: false);
    private void OnDirectoryChanged() => _ = InvokeAsync(() => Reload(1, replace: true));

    private void OnPresenceChanged(string nik, string status) => _ = InvokeAsync(() =>
    {
        var index = people.FindIndex(p => p.Nik == nik);
        if (index < 0) return;
        var updated = people[index] with { Status = status };
        people[index] = updated;
        if (selected?.Nik == nik) selected = updated;
        StateHasChanged();
    });

    private void CloseDrawer() { selected = null; selectedDirMember = null; }
    private void OnCardKey(KeyboardEventArgs e, Employee p) { if (e.Key is "Enter" or " ") selected = p; }
    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
    public void Dispose() { searchCts?.Cancel(); searchCts?.Dispose(); Layout.EscapePressed -= CloseDrawer; Auth.PresenceChanged -= OnPresenceChanged; Auth.DirectoryChanged -= OnDirectoryChanged; }

