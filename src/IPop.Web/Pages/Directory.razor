@page "/directory"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav
@inject IPop.Web.Services.CallState CallSvc
@inject IPop.Web.Services.FavoriteContacts Favorites
@inject ToastService Toasts
@inject IPop.Web.Services.PeopleLinks PLinks
@inject IPop.Web.Services.CalendarLinks CalLinks

<PageTitle>Directory — IPop</PageTitle>

@inject PhoneState Phone
@using IPop.Web.Components.Phone.Directory

@if (Phone.IsPhone)
{
    @if (selected is not null)
    {
        <PersonPhone Person="selected" Favorite="Favorites.IsFavorite(selected.Nik)" OnFavorite="() => ToggleFavorite(selected.Nik)"
            CalendarUrl="@PLinks.Calendar(selected.Nik)" MeetingUrl="@CalLinks.NewMeeting(niks: [selected.Nik], from: $"Meeting with {selected.Name}")"
            OnBack="() => selected = null" OnChat="() => OpenChatWith(selected.Nik)" OnCall="() => StartCallWith(selected.Nik)" OnMail="() => OpenMailWith(selected.Nik)">
            <Organization><a href="@PLinks.Profile(selected.Nik)">View organization &amp; direct reports<i data-lucide="chevron-right"></i></a></Organization>
        </PersonPhone>
    }
    <div class="m-directory-list-root" style="@(selected is not null ? "display:none" : "display:contents")">
        <PhoneScreen Title="@(phoneDepartmentDetail ? selection?.Name ?? "Department" : "Directory")" BackLabel="Departments" OnBack="@(phoneDepartmentDetail ? EventCallback.Factory.Create(this, ClosePhoneDepartment) : default)" Class="m-directory-screen">
            <Trailing><button type="button" class="m-directory-icon" aria-label="@(phoneSelecting ? "Done selecting" : "Select people")" @onclick="() => phoneSelecting = !phoneSelecting"><i data-lucide="@(phoneSelecting ? "check" : "list-checks")"></i></button><button type="button" class="m-directory-icon" aria-label="Directory options" @onclick="() => phoneOptions = true"><i data-lucide="more-horizontal"></i></button></Trailing>
            <Below>
                <div class="m-directory-search"><i data-lucide="search"></i><input type="search" aria-label="Search name, department, site" placeholder="Search name, department, site" value="@phoneQuery" @oninput="PhoneSearch" />@if (phoneQuery.Length > 0) { <button type="button" @onclick="ClearPhoneSearch">Cancel</button> }</div>
                @if (!phoneDepartmentDetail)
                {
                    <SegmentedControl Items="phoneTabs" Value="@phoneTab" ValueChanged="SetPhoneTab" />
                }
            </Below>
            <ChildContent>
                @if (phoneDepartmentDetail)
                {
                    <OverlayHook OnClose="ClosePhoneDepartment" />
                    <nav class="m-directory-breadcrumb" aria-label="Organization path">@string.Join(" › ", navigation.Path(navigation.Selected).Select(n => n.Name))</nav>
                    <p class="m-directory-note">@total members · @people.Count(p => p.Status == "on") online in @people.Count loaded</p>
                    <div class="m-directory-actions">
                        <button type="button" disabled="@(loading || people.Count == 0)" @onclick='() => PhoneDepartmentAction("chat")'>Chat with all</button>
                        <button type="button" disabled="@(loading || people.Count == 0)" @onclick='() => PhoneDepartmentAction("mail")'>Email all</button>
                        <button type="button" disabled="@(loading || people.Count == 0)" @onclick='() => PhoneDepartmentAction("meeting")'>Meeting</button>
                    </div>
                    <PeoplePhone People="people" OnOpen="p => selected = p" OnChat="p => OpenChatWith(p.Nik)" OnCall="p => StartCallWith(p.Nik)" Jump="PhoneJump" />
                    @if (page < TotalPages) { <button type="button" class="m-directory-more" @onclick="() => Reload(page + 1, replace: false)">Load more members</button> }
                }
                else if (phoneTab == "departments" && phoneQuery.Length == 0)
                {
                    <DepartmentsPhone Navigation="navigation" OnToggle="ToggleNode" OnSelect="OpenPhoneDepartment" />
                }
                else
                {
                    @if (phoneQuery.Length == 0 && FavoritePeople.Count > 0)
                    {
                        <h2 class="m-directory-section">Favorites</h2><div class="m-directory-favorites">@foreach (var favorite in FavoritePeople) { <button type="button" @onclick="() => selected = favorite"><PersonAvatar Nik="@favorite.Nik" Name="@favorite.Name" Size="48" Decorative="true" /><span>@IPop.Application.PersonName.Display(favorite.Name)</span></button> }</div>
                    }
                    @if (phoneQuery.Length > 0)
                    {
                        <div class="m-directory-chips" aria-label="Search scope">
                            @foreach (var scope in new[] { "All", "People", "Departments", "Sites" }) { <button type="button" aria-pressed="@(phoneScope == scope ? "true" : "false")" @onclick="() => phoneScope = scope">@scope @PhoneScopeCount(scope)</button> }
                        </div>
                    }
                    @if (phoneLoading) { <p class="m-directory-note" role="status">Loading people…</p> }
                    else if (phoneLoadError) { <div class="m-directory-note" role="alert">Could not load people. <button type="button" @onclick="LoadPhonePeople">Retry</button></div> }
                    else
                    {
                        @if (phoneScope is "All" or "People")
                        {
                            <PeoplePhone People="PhonePeople" Query="phoneQuery" Selecting="phoneSelecting" Selected="selectedNiks" OnSelect="p => TogglePersonSelection(p.Nik)" OnOpen="p => selected = p" OnChat="p => OpenChatWith(p.Nik)" OnCall="p => StartCallWith(p.Nik)" Jump="PhoneJump" />
                            @if (phoneLoadingMore) { <p class="m-directory-note" role="status">Loading everyone else…@(phoneQuery.Length > 0 ? " Results so far are shown." : "")</p> }
                        }
                        @if (phoneQuery.Length > 0 && phoneScope is "All" or "Departments" or "Sites")
                        {
                            @foreach (var node in PhoneNodes) { <button type="button" class="m-directory-result" @onclick="() => OpenPhoneDepartment(node)"><span>@node.Name<small>@string.Join(" › ", navigation.Path(node).SkipLast(1).Select(n => n.Name))</small></span><small>@node.Count people</small></button> }
                        }
                        @if (PhoneScopeCount(phoneScope) == 0)
                        {
                            <div class="m-directory-empty"><i data-lucide="search"></i><h2>No results for “@phoneQuery”</h2><p>Check the spelling, or search by department or site instead.</p>
                                @if (DirectorySuggest.Find(phoneQuery, phonePeople.Select(p => p.Name)) is { } suggestion) { <button type="button" @onclick="() => phoneQuery = suggestion">Did you mean @IPop.Application.PersonName.Display(suggestion)?</button> }
                            </div>
                        }
                    }
                }
                @if (selectedNiks.Count > 0)
                {
                    <div class="m-directory-options"><b>@selectedNiks.Count selected</b><button type="button" @onclick="BulkMessage">Message</button><button type="button" @onclick="BulkCreateGroup">Create group</button><button type="button" @onclick="BulkEmail">Email</button><button type="button" @onclick="BulkFavorite">Favorite</button><button type="button" @onclick="BulkExport">Export selected</button><button type="button" @onclick="() => selectedNiks.Clear()">Clear selection</button></div>
                }
                @if (notice is not null) { <p class="m-directory-note" role="status">@notice</p> }
            </ChildContent>
        </PhoneScreen>
        <BottomSheet Open="phoneOptions" OpenChanged="v => phoneOptions = v" Title="Directory options">
            <div class="m-directory-options">
                @foreach (var status in new[] { "", "on", "busy", "away", "off" }) { <button type="button" aria-pressed="@(presenceFilter == status ? "true" : "false")" @onclick="() => SetPhonePresence(status)">@(status == "" ? "All statuses" : PresenceFilterLabel(status))</button> }
                <button type="button" aria-pressed="@(favOnly ? "true" : "false")" @onclick="ToggleFavOnly">Favorites only</button>
                <button type="button" disabled="@exporting" @onclick="ExportCsv">Export CSV (current desktop filters)</button>
                <button type="button" @onclick='() => { phoneOptions = false; Nav.NavigateTo("/chat?new=group"); }'>Create group</button>
                <button type="button" @onclick="CollapseAll">Collapse departments</button>
            </div>
        </BottomSheet>
    </div>
}
else
{
<div class="toolbar dir-toolbar">
    <div class="apple-segmented">
        <button type="button" class="seg-btn @(presenceFilter == "" ? "active" : "")" @onclick='() => SetPresenceFilter("")'>
            <span>All</span>
            <span class="seg-count">@PresenceCounts.All.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "on" ? "active" : "")" @onclick='() => SetPresenceFilter("on")'>
            <span class="seg-dot on"></span>
            <span>Online</span>
            <span class="seg-count">@PresenceCounts.Online.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "busy" ? "active" : "")" @onclick='() => SetPresenceFilter("busy")'>
            <span class="seg-dot busy"></span>
            <span>Busy</span>
            <span class="seg-count">@PresenceCounts.Busy.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "away" ? "active" : "")" @onclick='() => SetPresenceFilter("away")'>
            <span class="seg-dot away"></span>
            <span>Away</span>
            <span class="seg-count">@PresenceCounts.Away.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "off" ? "active" : "")" @onclick='() => SetPresenceFilter("off")'>
            <span class="seg-dot off"></span>
            <span>Offline</span>
            <span class="seg-count">@PresenceCounts.Offline.ToString("N0")</span>
        </button>
    </div>
    <div class="push flex center gap-8">
        <div class="v6-search">
            <i data-lucide="search"></i>
            <input type="search" placeholder="Search name or ext." aria-label="Search people" value="@Layout.SearchQuery" @oninput="e => Layout.SetSearch(e.Value?.ToString())" />
        </div>
        <div class="apple-segmented view-seg">
            <button type="button" class="seg-btn @(!isGridView ? "active" : "")" title="List view" aria-label="List view" @onclick="() => isGridView = false"><i data-lucide="list"></i></button>
            <button type="button" class="seg-btn @(isGridView ? "active" : "")" title="Grid view" aria-label="Grid view" @onclick="() => isGridView = true"><i data-lucide="layout-grid"></i></button>
        </div>
        <div class="dir-sort">
            <button type="button" class="ghost-btn" @onclick="() => sortOpen = !sortOpen" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" aria-haspopup="menu" aria-expanded="@(sortOpen ? "true" : "false")">
                <i data-lucide="arrow-up-down"></i>@SortLabel(selectedSort)<i data-lucide="chevron-down" class="chev"></i>
            </button>
            @if (sortOpen)
            {
                <div class="menu-backdrop" @onclick="() => sortOpen = false"></div>
                <div class="dir-sort-menu" role="menu">
                    @foreach (var opt in SortOptions)
                    {
                        var o = opt;
                        <button type="button" role="menuitemradio" aria-checked="@(selectedSort == o ? "true" : "false")" @onclick="() => PickSort(o)">
                            <span>@SortLabel(o)</span>
                            @if (selectedSort == o) { <i data-lucide="check"></i> }
                        </button>
                    }
                </div>
            }
        </div>
        <button type="button" class="ghost-btn @(favOnly ? "on" : "")" title="Show favorites only" aria-pressed="@(favOnly ? "true" : "false")" @onclick="ToggleFavOnly">
            <i data-lucide="star"></i>Favorites <span class="cnt">@FavoritePeople.Count</span>
        </button>
        <button type="button" class="ghost-btn" title="Export search/filter results to CSV" disabled="@exporting" @onclick="ExportCsv"><i data-lucide="download"></i>@(exporting ? "Exporting…" : "Export")</button>
    </div>
</div>

<div class="body dir-body @(treeOpen ? "m-tree-open" : "")">
    @* Phone only: the Structure/Favorites column collapses behind this toggle. *@
    <button type="button" class="m-dir-filter @(selection is not null ? "on" : "")" aria-label="Departments" aria-expanded="@(treeOpen ? "true" : "false")" @onclick="ToggleTree">
        <i data-lucide="network"></i>
        <span class="lbl">Departments</span>
        <span class="v6-count-pill">@DisplayedPeople.Count</span>
        <i data-lucide="@(treeOpen ? "chevron-up" : "chevron-down")" class="chev"></i>
    </button>
    @if (notice is not null)
    {
        <div class="module-notice" style="margin:0 0 10px">
            <div class="note @(noticeIsError ? "err" : "")">
                <i data-lucide="info"></i><span>@notice</span>
                <button class="note-x" @onclick="DismissNotice" aria-label="Dismiss">
                    <i data-lucide="x"></i>
                </button>
            </div>
        </div>
    }

    <div class="cols dir-cols">
        @if (treeOpen) { <div class="dir-tree-backdrop" @onclick="CloseTree"></div> }
        <div class="col gap-14 dir-side" id="directory-departments" tabindex="-1" @onkeydown="OnTreeKey">
        <div class="dir-sheet-head"><strong>Departments</strong><button type="button" aria-label="Close departments" @onclick="CloseTree"><i data-lucide="x"></i></button></div>
        <!-- Structure: Plant ▸ Division ▸ Department (Site ▸ Department ▸ Division entities) -->
        <div class="card dir-structure">
            <div class="card-head"><div class="card-title">Organization</div><button type="button" class="ghost-btn" title="Collapse all" aria-label="Collapse all" @onclick="CollapseAll"><i data-lucide="fold-vertical"></i></button></div>
            <div class="v6-search dir-tree-search"><i data-lucide="search"></i><input type="search" aria-label="Find a department" placeholder="Find a department…" value="@navigation.Search" @oninput="e => navigation.Search = e.Value?.ToString() ?? string.Empty" /></div>
            @if (structureLoading)
            {
                <div style="padding:14px">
                    @for (var i = 0; i < 6; i++) { <div class="skel" style="height:28px;margin-bottom:6px;border-radius:8px"></div> }
                </div>
            }
            else if (dirStructure is null)
            {
                <div class="tree-empty">Could not load the directory structure.</div>
            }
            else
            {
                <div class="tree">
                    <button type="button" class="tree-node @(selection is null ? "on" : "")" @onclick="ClearDivisionFilter">
                        <i data-lucide="users"></i>
                        <span class="lbl">All people</span>
                        <span class="tree-n">@allPeopleCount.ToString("N0")</span>
                    </button>
                    @foreach (var node in navigation.Visible())
                    {
                        var open = navigation.IsOpen(node);
                        var hasKids = navigation.HasChildren(node);
                        <div class="tree-row @(node.ParentKey is not null && node.ParentKey == justExpandedKey ? "tree-in" : "")" style="--lv:@node.Depth" @key="node.Key">
                            <button type="button" class="tree-twist" disabled="@(!hasKids)" aria-expanded="@(open ? "true" : "false")" aria-label="@(open ? "Collapse" : "Expand") @node.Name" @onclick="() => ToggleNode(node)">
                                @if (hasKids) { <i data-lucide="chevron-right"></i> }
                            </button>
                            <button type="button" class="tree-node @(navigation.SelectedKey == node.Key ? "on" : "")" title="@node.Name" aria-pressed="@(navigation.SelectedKey == node.Key ? "true" : "false")" @onclick="() => SelectOccurrence(node)">
                                <i data-lucide="@(node.Kind == "site" ? "factory" : node.Kind == "div" ? "users" : node.Depth == 1 ? "network" : "folder-tree")"></i><span class="lbl">@node.Name</span><span class="tree-n">@node.Count</span>
                            </button>
                        </div>
                    }
                </div>
            }
            <label class="dir-show-empty"><input type="checkbox" checked="@navigation.ShowEmpty" @onchange="SetShowEmpty" /> Show empty</label>
        </div>

        @if (FavoritePeople.Count > 0)
        {
            <div class="card dir-favs">
                <div class="card-head">
                    <div class="card-title">Favorites</div>
                    <span class="card-meta" style="margin-left:auto">@FavoritePeople.Count</span>
                </div>
                <div class="fav-list">
                    @foreach (var p in FavoritePeople)
                    {
                        <div class="fav-row" tabindex="0" @onkeydown="e => OnCardKey(e, p)" @onclick="() => selected = p">
                            <div class="av-wrap">
                                <div class="av" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials</div>
                                <span class="presence @p.Status"></span>
                            </div>
                            <span class="n">@p.Name</span>
                            <button type="button" class="act" title="Chat" aria-label="Chat with @p.Name" @onclick="() => OpenChatWith(p.Nik)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><i data-lucide="message-circle"></i></button>
                        </div>
                    }
                </div>
            </div>
        }
        </div>

        <!-- People Section -->
        <div class="col gap-14" style="min-width:0">
            <nav class="dir-breadcrumb" aria-label="Organization path"><button type="button" @onclick="ClearDivisionFilter">All people</button>@foreach (var node in navigation.Path(navigation.Selected)) { <i data-lucide="chevron-right"></i><button type="button" @onclick="() => SelectOccurrence(node)" aria-current="@(node.Key == navigation.SelectedKey ? "page" : null)">@node.Name</button> }</nav>
            <div class="card dir-people">
                @if (selectedNiks.Count > 0)
                {
                    <div class="dir-bulk-bar">
                        <button type="button" class="v6-cb on" role="checkbox" aria-checked="true" aria-label="Clear selection" @onclick="() => selectedNiks.Clear()">
                            <i data-lucide="minus"></i>
                        </button>
                        <span class="dbb-count">@selectedNiks.Count selected</span>
                        <div style="flex:1"></div>
                        <button type="button" class="dbb-btn" @onclick="BulkMessage"><i data-lucide="message-circle"></i>Message</button>
                        <button type="button" class="dbb-btn" @onclick="BulkCreateGroup"><i data-lucide="users"></i>Create group</button>
                        <button type="button" class="dbb-btn" @onclick="BulkEmail"><i data-lucide="mail"></i>Email</button>
                        <button type="button" class="dbb-btn fav" @onclick="BulkFavorite"><i data-lucide="star"></i>Favorite</button>
                        <button type="button" class="dbb-btn plain" @onclick="BulkExport"><i data-lucide="download"></i>Export</button>
                        <button type="button" class="dbb-clear" @onclick="() => selectedNiks.Clear()">Clear</button>
                    </div>
                }
                else
                {
                    <div class="card-head">
                        <span class="card-title">@(favOnly ? "Favorites" : selection?.Name ?? "All people")</span>
                        <span class="v6-count-pill">@DisplayedPeople.Count shown</span>
                        <span class="card-meta" style="margin-left:auto">Click a person to open their profile</span>
                    </div>
                }
                <div class="dir-scroll">
                @if (isGridView)
                {
                    @if (loading || structureLoading)
                    {
                        <div style="padding:16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px">
                            @for (var i = 0; i < 8; i++)
                            {
                                <div class="skel" style="height:140px;border-radius:14px"></div>
                            }
                        </div>
                    }
                    else if (DisplayedPeople.Count == 0)
                    {
                        <div style="text-align:center;padding:32px;color:var(--ink-3)">@(loadError ?? "No one found.")</div>
                    }
                    else
                    {
                        <div class="emp-grid">
                            @foreach (var p in DisplayedPeople)
                            {
                                @if (selection is not null && IsGroupStart(p)) { <div class="dir-unit-heading">@GroupLabel(p) <span>@GroupLoaded(p) loaded</span></div> }
                                var isFav = Favorites.IsFavorite(p.Nik);
                                var isChecked = selectedNiks.Contains(p.Nik);
                                <div class="dir-card @(isFav ? "fav" : "") @(isChecked ? "checked" : "")" tabindex="0" @onkeydown="e => OnCardKey(e, p)" @onclick="() => selected = p">
                                    <div class="dc-top" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                        <button type="button" class="v6-cb @(isChecked ? "on" : "")"
                                                role="checkbox" aria-checked="@(isChecked ? "true" : "false")"
                                                aria-label="Select @p.Name" @onclick="() => TogglePersonSelection(p.Nik)">
                                            @if (isChecked) { <i data-lucide="check"></i> }
                                        </button>
                                        <button type="button" class="dc-star @(isFav ? "on" : "")" data-fav-nik="@p.Nik" title="@(isFav ? "Remove favorite" : "Add favorite")" @onclick="() => ToggleFavorite(p.Nik)">
                                            <i data-lucide="star"></i>
                                        </button>
                                    </div>
                                    <div class="dc-av" data-fav-av="@p.Nik" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials<span class="presence @p.Status"></span></div>
                                    <span class="dc-name" title="@p.Name">@Highlight(p.Name)</span>
                                    <span class="dc-pos" title="@p.Placement">@p.Placement</span>
                                    <span class="dc-meta">@(p.HasExtension ? $"Ext. {p.Extension}" : p.Site)</span>
                                    <div class="dc-acts" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                        <button type="button" class="dc-msg" @onclick="() => OpenChatWith(p.Nik)"><i data-lucide="message-circle"></i>Message</button>
                                        <button type="button" class="dc-ic" title="Call" aria-label="Call @p.Name" @onclick="() => StartCallWith(p.Nik)"><i data-lucide="phone"></i></button>
                                        <button type="button" class="dc-ic" title="Email" aria-label="Email @p.Name" @onclick="() => OpenMailWith(p.Nik)"><i data-lucide="mail"></i></button>
                                        <a class="dc-ic" href="@PLinks.Calendar(p.Nik)" title="Calendar" aria-label="View @p.Name's calendar"><i data-lucide="calendar-search"></i></a>
                                        <a class="dc-ic" href="@CalLinks.NewMeeting(niks: [p.Nik], from: $"Meeting with {p.Name}")" title="Invite to meeting" aria-label="Invite @p.Name to a meeting"><i data-lucide="calendar-plus"></i></a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    var allSelected = DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count;
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th style="width:32px">
                                    <button type="button" class="v6-cb @(allSelected ? "on" : "")"
                                            role="checkbox" aria-checked="@(allSelected ? "true" : "false")"
                                            aria-label="Select all" @onclick="ToggleSelectAllPeople">
                                        @if (allSelected)
                                        {
                                            <i data-lucide="check"></i>
                                        }
                                    </button>
                                </th>
                                <th>Name</th>
                                <th>Department</th>
                                <th>Ext.</th>
                                <th>Status</th>
                                <th class="th-acts">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loading || structureLoading)
                            {
                                @for (var i = 0; i < 7; i++)
                                {
                                    <tr>
                                        <td colspan="6"><div class="skel" style="height:26px;border-radius:6px"></div></td>
                                    </tr>
                                }
                            }
                            else if (DisplayedPeople.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" style="text-align:center;padding:32px;color:var(--ink-3)">@(loadError ?? "No one in this department yet.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in DisplayedPeople)
                                {
                                    @if (selection is not null && IsGroupStart(p)) { <tr class="dir-unit-row"><td colspan="6">@GroupLabel(p) <span>@GroupLoaded(p) loaded</span></td></tr> }
                                    var isFav = Favorites.IsFavorite(p.Nik);
                                    var isSel = (selected?.Nik ?? people.FirstOrDefault()?.Nik) == p.Nik;
                                    var isChecked = selectedNiks.Contains(p.Nik);
                                    <tr class="@(isSel ? "sel" : "")" tabindex="0" @onkeydown="e => OnCardKey(e, p)" @onclick="() => selected = p">
                                        <td @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                            <button type="button" class="v6-cb @(isChecked ? "on" : "")"
                                                    role="checkbox" aria-checked="@(isChecked ? "true" : "false")"
                                                    aria-label="Select @p.Name" @onclick="() => TogglePersonSelection(p.Nik)">
                                                @if (isChecked) { <i data-lucide="check"></i> }
                                            </button>
                                        </td>
                                        <td>
                                            <div class="cell-person">
                                                <div class="av-wrap">
                                                    <div class="av" data-fav-av="@p.Nik" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials</div>
                                                    <span class="presence @p.Status"></span>
                                                </div>
                                                <div class="cp-text">
                                                    <div class="n" title="@p.Name">@Highlight(p.Name)</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="td-dept">@if (p.Department != "—") { <span class="div-chip" title="@p.Placement">@p.Placement</span> } else { <span class="dim">—</span> }</td>
                                        <td class="td-ext">@if (p.HasExtension) { <span class="ext-num" title="IP phone extension"><i data-lucide="phone"></i>@p.Extension</span> } else { <span class="dim">—</span> }</td>
                                        <td>
                                            <span class="st-pill @p.Status"><span class="d"></span>@p.StatusLabel</span>
                                        </td>
                                        <td>
                                            <div class="row-acts">
                                                <button type="button" class="ra" title="Chat" aria-label="Chat with @p.Name" @onclick="() => OpenChatWith(p.Nik)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    <i data-lucide="message-circle"></i>
                                                </button>
                                                <button type="button" class="ra" title="Call" aria-label="Call @p.Name" @onclick='() => StartCallWith(p.Nik)' @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    <i data-lucide="phone"></i>
                                                </button>
                                                <a class="ra" href="@PLinks.Calendar(p.Nik)" title="Calendar" aria-label="View @p.Name's calendar" @onclick:stopPropagation="true">
                                                    <i data-lucide="calendar-search"></i>
                                                </a>
                                                <a class="ra" href="@CalLinks.NewMeeting(niks: [p.Nik], from: $"Meeting with {p.Name}")" title="Invite to meeting" aria-label="Invite @p.Name to a meeting" @onclick:stopPropagation="true">
                                                    <i data-lucide="calendar-plus"></i>
                                                </a>
                                                <button type="button" class="ra fav @(isFav ? "on" : "")" data-fav-nik="@p.Nik"
                                                        title="@(isFav ? "Remove from favorites" : "Add to favorites")"
                                                        @onclick="() => ToggleFavorite(p.Nik)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    <i data-lucide="star"></i>
                                                </button>
                                                @* Phone only: calendar, invite and favourite live in the contact card. *@
                                                <button type="button" class="ra ra-more" title="More" aria-label="More for @p.Name" @onclick="() => selected = p" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                                    <i data-lucide="more-horizontal"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
                @if (!loading && page < TotalPages)
                {
                    <div style="padding:14px 20px;text-align:center">
                        <button type="button" class="ghost-btn" style="margin:0 auto" @onclick="LoadMore">Show more (@(total - people.Count) remaining)</button>
                    </div>
                }
                </div>
                <div class="dir-foot">
                    <span>Showing @DisplayedPeople.Count.ToString("N0") of @total.ToString("N0") · @(string.IsNullOrEmpty(presenceFilter) ? "All statuses" : PresenceFilterLabel(presenceFilter))</span>
                    <span>Sorted by @SortLabel(selectedSort)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<ProfileDrawer Person="selected" OnClose="() => selected = null" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    private const int PageSize = 120;
    private bool loading = true;
    private string? loadError;
    private int page = 1, total;
    private Employee? selected;
    private List<Employee> people = [];
    private bool isGridView;
    private bool favOnly;
    private string selectedSort = "name-asc";
    private bool sortOpen;
    private static readonly string[] SortOptions = ["name-asc", "name-desc", "status-asc"];
    private static string SortLabel(string key) => key switch
    {
        "name-desc" => "Name Z–A",
        "status-asc" => "Online first",
        _ => "Name A–Z",
    };
    private async Task PickSort(string key)
    {
        sortOpen = false;
        if (selectedSort == key) return;
        selectedSort = key;
        await OnSortChanged();
    }
    private int allPeopleCount => (dirStructure?.Sites.Sum(s => s.MemberCount) ?? 0) + (dirStructure?.NoDivisionCount ?? 0);
    private HashSet<string> selectedNiks = [];
    private IReadOnlyList<Employee> DisplayedPeople => people;

    private void TogglePersonSelection(string nik)
    {
        if (!selectedNiks.Add(nik)) selectedNiks.Remove(nik);
    }

    private void ToggleSelectAllPeople()
    {
        if (DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count)
            selectedNiks.Clear();
        else
            selectedNiks = DisplayedPeople.Select(p => p.Nik).ToHashSet();
    }

    private async Task ToggleFavOnly()
    {
        favOnly = !favOnly;
        selectedNiks.Clear();
        await Reload(1, replace: true);
    }

    private async Task OnSortChanged()
    {
        await Reload(1, replace: true);
    }

    private void BulkMessage()
    {
        if (selectedNiks.Count == 1) OpenChatWith(selectedNiks.First());
        else Nav.NavigateTo("/chat");
    }

    private void BulkCreateGroup()
    {
        Nav.NavigateTo($"/chat?new=group&members={PLinks.Tokens(selectedNiks)}");
    }

    private void BulkEmail()
    {
        Nav.NavigateTo($"/mail?to={PLinks.Tokens(selectedNiks)}&compose=1");
    }

    private async Task BulkFavorite()
    {
        foreach (var nik in selectedNiks.ToArray()) await Favorites.ToggleAsync(nik);
        Toasts.Show($"Updated favorites for {selectedNiks.Count} people.", ToastKind.Success);
        selectedNiks.Clear();
    }

    // Selection is always drawn from loaded rows, so the CSV is built client-side
    // rather than round-tripping NIKs through the filter-based export endpoint.
    private async Task BulkExport()
    {
        var rows = people.Concat(favoritePeople).Concat(phonePeople)
            .Where(p => selectedNiks.Contains(p.Nik))
            .DistinctBy(p => p.Nik)
            .ToList();
        static string Q(string? v) => "\"" + (v ?? "").Replace("\"", "\"\"") + "\"";
        var sb = new System.Text.StringBuilder("Name,Email,Department,Section,Ext.,Status\n");
        foreach (var p in rows)
            sb.AppendLine(string.Join(",", Q(p.Name), Q(p.Email), Q(p.Department), Q(p.Section),
                Q(p.HasExtension ? p.Extension : ""), Q(p.StatusLabel)));
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
        await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"directory-selected-{DateTime.Now:yyyyMMdd-HHmm}.csv");
        Toasts.Show($"Exported {rows.Count} people to CSV.", ToastKind.Success);
    }

    private void OpenMailWith(string nik)
        => Nav.NavigateTo(PLinks.Mail(nik));

    private DirectoryConnectionState ConnectionState => Auth.ConnectionState;
    private int TotalPages => total == 0 ? 1 : (int)Math.Ceiling(total / (double)PageSize);

    // Master-detail tree state
    private DirectoryStructureNodeDto? dirStructure;
    private bool structureLoading = true;
    // Tree selection: a Plant (site), a Division/sub-division (department subtree) or a
    // Department (division) — each filters the list through its own employees query param.
    private sealed record TreeSelection(string Kind, string Code, string Name, string SiteCode);
    private TreeSelection? selection;
    private bool treeOpen;
    private string? notice;
    private bool noticeIsError;

    // People search is independent from the local organization-name search.
    private string? searchQ;

    /// Header tab counts come from the server, not the loaded page: the list is paged, so
    /// counting `people` reported 0 online whenever nobody on the current page was online.
    /// Falls back to the loaded page until the structure call lands.
    private DirectoryPresenceCountsDto PresenceCounts => dirStructure?.PresenceCounts ?? new DirectoryPresenceCountsDto(
        total,
        people.Count(p => p.Status == "on"),
        people.Count(p => p.Status == "busy"),
        people.Count(p => p.Status == "away"),
        people.Count(p => p.Status == "off"));

    private string ConnectionLabel => ConnectionState switch { DirectoryConnectionState.Live => "Live", DirectoryConnectionState.Reconnecting => "Reconnecting...", DirectoryConnectionState.Connecting => "Connecting...", _ => "Offline" };

    protected override void OnInitialized()
    {
        // ipop-25: make the shell search's placeholder explicit here too, so the
        // default in SetHeader stays a fallback rather than Directory-specific copy.
        Layout.SetHeader("Directory", "People");
        Phone.Changed += PhoneChanged;
        Layout.SearchChanged += OnSearchChanged;
        Auth.PresenceChanged += OnPresenceChanged;
        Auth.DirectoryChanged += OnDirectoryChanged;
        Auth.MeChanged += OnAccountChanged;
        Auth.ConnectionStateChanged += OnConnectionStateChanged;
        Favorites.Changed += OnFavoritesChanged;
    }

    // Kontak Prioritas: kartu favorit di atas grid, dari NIK yang disimpan per
    // pengguna (frontend wave). Kosong = bagian disembunyikan.
    private List<Employee> favoritePeople = [];
    private List<Employee> FavoritePeople => favoritePeople;

    private void OnFavoritesChanged() => _ = InvokeAsync(async () =>
    {
        await LoadFavoritesAsync();
        if (favOnly) await Reload(1, replace: true);
        StateHasChanged();
    });

    private async Task LoadFavoritesAsync()
    {
        await Favorites.EnsureLoadedAsync();
        var generation = ++favoriteGeneration;
        var account = Auth.Me?.Nik;
        var loaded = new List<Employee>();
        for (var p = 1; ; p++)
        {
            var result = await Auth.GetAsync<DirectoryPageDto>($"/api/directory/employees?favorites=true&page={p}&pageSize=120");
            if (generation != favoriteGeneration || account != Auth.Me?.Nik) return;
            if (result is null) return;
            loaded.AddRange(result.Items.Select(Map));
            if (loaded.Count >= result.Total || result.Items.Length == 0) break;
        }
        favoritePeople = loaded.DistinctBy(p => p.Nik).ToList();
    }

    private async Task Unfavorite(string nik) => await Favorites.ToggleAsync(nik);

    private async Task ToggleFavorite(string nik)
    {
        var nowFav = await Favorites.ToggleAsync(nik);
        StateHasChanged();
        // #3 star pops; #36 a new favorite's avatar arcs into the Favorites panel (only when it is on screen).
        try { await JS.InvokeVoidAsync("ipopDirMotion.favorite", nik, nowFav); } catch (JSException) { }
    }

    // #38: wrap the part of a name that matches the people search in <mark>.
    private RenderFragment Highlight(string text) => builder =>
    {
        var q = searchQ;
        var at = string.IsNullOrWhiteSpace(q) || q.Length < 2 ? -1 : text.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (at < 0) { builder.AddContent(0, text); return; }
        builder.AddContent(1, text[..at]);
        builder.OpenElement(2, "mark");
        builder.AddAttribute(3, "class", "dir-hl");
        builder.AddContent(4, text.Substring(at, q!.Length));
        builder.CloseElement();
        builder.AddContent(5, text[(at + q.Length)..]);
    };

    // ---- Ekspor CSV (hasil pencarian/filter saat ini) ----
    private bool exporting;

    private async Task ExportCsv()
    {
        if (exporting) return;
        exporting = true;
        try
        {
            // Ekspor server-side: filter yang sama (divisi + kata kunci + kehadiran)
            // berlaku untuk SELURUH himpunan hasil, bukan satu halaman yang terlihat.
            // Diunduh via fetch ber-Bearer (window.open tak membawa header auth).
            var url = $"/api/directory/employees/export.csv?{QueryParameters}";
            var res = await Auth.SendAsync(HttpMethod.Get, url);
            if (!res.IsSuccessStatusCode)
            {
                notice = $"Export failed ({(int)res.StatusCode}).";
                noticeIsError = true;
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"directory-{stamp}.csv");
            notice = $"Downloaded CSV for the current scope ({total:N0} matching people).";
            noticeIsError = false;
        }
        catch (Exception ex)
        {
            notice = $"Export failed: {ex.Message}";
            noticeIsError = true;
        }
        finally
        {
            exporting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStructure();
        await RestoreNavigation();
        _ = LoadFavoritesAsync();
        await Reload(1, replace: true);
        await SelectFromQuery();
        Nav.LocationChanged += OnLocationChanged;
    }

    // Old ⌘K links (/directory?nik=…) — filter to that person by name and select them.
    private async Task SelectFromQuery()
    {
        var nik = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["nik"];
        if (string.IsNullOrWhiteSpace(nik)) return;
        // Legacy link: search by the person's name, never put the NIK in the search box.
        DirectoryEmployeeDto? d = null;
        try { d = await Auth.GetAsync<DirectoryEmployeeDto>($"/api/chat/users/{Uri.EscapeDataString(nik)}"); } catch { }
        if (d is null) return;
        searchQ = d.Name;
        await Reload(1, replace: true);
        selected = people.FirstOrDefault(p => string.Equals(p.Nik, nik, StringComparison.OrdinalIgnoreCase)) ?? selected;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(SelectFromQuery);

    private async Task LoadStructure()
    {
        structureLoading = true;
        dirStructure = await Auth.GetAsync<DirectoryStructureNodeDto>("/api/directory/structure");
        structureLoading = false;
        if (dirStructure is not null) { navigation.Load(dirStructure); SyncSelection(); }
        if (dirStructure is not null) Layout.SetSubtitle($"{allPeopleCount:N0} people · {PresenceCounts.Online:N0} online");
        StateHasChanged();
    }

    private string SelectionParam => selection switch
    {
        { Kind: "site" } s => $"siteCode={Uri.EscapeDataString(s.SiteCode)}",
        { Kind: "dept" } s => $"siteCode={Uri.EscapeDataString(s.SiteCode)}&departmentCode={Uri.EscapeDataString(s.Code)}",
        { } s => $"siteCode={Uri.EscapeDataString(s.SiteCode)}&divisionCode={Uri.EscapeDataString(s.Code)}",
        null => "divisionCode=",
    };
    private async Task ClearDivisionFilter()
    {
        navigation.SelectedKey = null; selection = null;
        await CloseTree(); await SaveNavigation(); await Reload(1, replace: true);
    }

    // ipop-35: void handler + InvokeAsync so an exception inside the await surfaces via
    // the module notice instead of vanishing as an async-void unhandled error.
    private void OnSearchChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            searchQ = string.IsNullOrWhiteSpace(Layout.SearchQuery) ? null : Layout.SearchQuery.Trim();
            await Reload(1, replace: true);
        }
        catch (Exception ex)
        {
            noticeIsError = true;
            notice = $"Search failed: {ex.Message}";
            StateHasChanged();
        }
    });


    private void DismissNotice() => notice = null;

    // Filter kehadiran — diteruskan ke endpoint employees (presence=on|busy|away|off).
    private string presenceFilter = "";

    private static string PresenceFilterLabel(string status) => status switch
    {
        "on" => "Online",
        "busy" => "Busy",
        "away" => "Away",
        "off" => "Offline",
        _ => "All"
    };

    private async Task SetPresenceFilter(string status)
    {
        if (presenceFilter == status) return;
        presenceFilter = status;
        await Reload(1, replace: true);
    }
    private void ShowModuleNotice(string module)
    {
        notice = $"{module} isn't available yet — it activates as the module ships.";
        noticeIsError = false;
    }

    private void OpenChatWith(string nik)
        => Nav.NavigateTo(PLinks.Chat(nik));

    private async Task StartCallWith(string nik)
    {
        if (string.IsNullOrWhiteSpace(nik)) return;
        var room = await CallSvc.CreateAsync(nik);
        if (room is not null)
        {
            Nav.NavigateTo("/calls");
        }
    }

    private static Employee Map(DirectoryEmployeeDto d) => new(d.Name, d.Position ?? "—", d.Nik, d.Extension ?? "—", d.Location ?? "—", d.Department ?? "—", d.DepartmentCode, d.Site ?? "—", d.SiteCode, d.Manager ?? "—", d.Email, d.Status, AvatarPalette.For(d.Nik), d.PhotoPath, d.ManagerNik, d.Section, d.LastSeenAt, d.UnitKey, d.UnitName);

    private async Task Reload(int requestedPage, bool replace)
    {
        var generation = ++requestGeneration;
        var account = Auth.Me?.Nik;
        var query = QueryParameters;
        loading = true;
        var result = await Auth.GetAsync<DirectoryPageDto>($"/api/directory/employees?page={requestedPage}&pageSize={PageSize}&{query}");
        if (disposed || generation != requestGeneration || account != Auth.Me?.Nik || query != QueryParameters) return;
        loading = false;
        if (result is null) { loadError = "Could not load the directory."; return; }
        total = result.Total; page = result.Page;
        var mapped = result.Items.Select(Map).ToList();
        if (replace) people = mapped; else people = people.Concat(mapped).DistinctBy(p => p.Nik).ToList();
        selected = selected is null ? null : people.FirstOrDefault(p => p.Nik == selected.Nik);
        loadError = null;
        StateHasChanged();
    }

    private Task LoadMore() => Reload(page + 1, replace: false);
    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
        await LoadStructure();
        await Reload(1, replace: true);
        if (phoneLoaded) await LoadPhonePeople();
    });

    private void OnPresenceChanged(string nik, string status) => _ = InvokeAsync(() =>
    {
        var phoneIndex = phonePeople.FindIndex(p => p.Nik == nik);
        if (phoneIndex >= 0) { phonePeople[phoneIndex] = phonePeople[phoneIndex] with { Status = status }; if (selected?.Nik == nik) selected = phonePeople[phoneIndex]; StateHasChanged(); }
        var index = people.FindIndex(p => p.Nik == nik);
        if (index >= 0)
        {
            var updated = people[index] with { Status = status, LastSeenAt = status == "off" ? DateTime.UtcNow : people[index].LastSeenAt };
            people[index] = updated;
            if (selected?.Nik == nik) selected = updated;
            StateHasChanged();
        }
        SchedulePresenceRefresh();
    });

    // The tab counts and "N online" subtitle come from /api/directory/structure, and a
    // presence-filtered list gains/loses people as statuses change — re-read both, debounced
    // so a burst of logins is one round-trip. Quiet: no skeleton, loaded list kept otherwise.
    private CancellationTokenSource? _presenceRefresh;

    private void SchedulePresenceRefresh()
    {
        _presenceRefresh?.Cancel();
        var cts = _presenceRefresh = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(1000, cts.Token); } catch (OperationCanceledException) { return; }
            var fresh = await Auth.GetAsync<DirectoryStructureNodeDto>("/api/directory/structure");
            if (cts.IsCancellationRequested) return;
            if (fresh is not null)
            {
                dirStructure = fresh;
                navigation.Load(fresh); SyncSelection();
                Layout.SetSubtitle($"{allPeopleCount:N0} people · {PresenceCounts.Online:N0} online");
            }
            if (!string.IsNullOrEmpty(presenceFilter) || selectedSort == "status-asc") await Reload(1, replace: true);
            else StateHasChanged();
        });
    }

    private void OnConnectionStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCardKey(KeyboardEventArgs e, Employee p) { if (e.Key is "Enter" or " ") selected = p; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
        await SyncMobileDetailAsync();
        if (!Phone.IsPhone) await SyncDepartmentSheet();
        if (Phone.IsPhone && !phoneLoaded && !phoneLoading) await LoadPhonePeople();
    }

    // ── Phone layout (<= 767px): the profile sheet is a full-screen detail; phone Back closes it.
    //    `selected` is set from many click handlers, so history is synced after render. ──
    private DotNetObjectReference<Directory>? _selfRef;
    private bool _mobileDetailPushed;

    private async Task SyncMobileDetailAsync()
    {
        try
        {
            if (selected is not null && !_mobileDetailPushed)
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                _mobileDetailPushed = await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _selfRef, nameof(MobileBack));
            }
            else if (selected is null && _mobileDetailPushed)
            {
                _mobileDetailPushed = false;
                await JS.InvokeVoidAsync("ipop.mobile.popDetail");
            }
        }
        catch (JSException) { }
    }

    [JSInvokable]
    public Task MobileBack() => InvokeAsync(() =>
    {
        _mobileDetailPushed = false; // the browser already popped the entry
        selected = null;
        StateHasChanged();
    });

    public void Dispose() { Phone.Changed -= PhoneChanged; phoneGeneration++; disposed = true; requestGeneration++; favoriteGeneration++; _ = JS.InvokeVoidAsync("ipop.mobile.clearDetail").AsTask().ContinueWith(_ => { }); _selfRef?.Dispose(); Nav.LocationChanged -= OnLocationChanged; Layout.SearchChanged -= OnSearchChanged; Auth.PresenceChanged -= OnPresenceChanged; _presenceRefresh?.Cancel(); Auth.DirectoryChanged -= OnDirectoryChanged; Auth.MeChanged -= OnAccountChanged; _ = CleanupSheet(); Auth.ConnectionStateChanged -= OnConnectionStateChanged; Favorites.Changed -= OnFavoritesChanged; }
}