    private static Employee Map(DirectoryEmployeeDto d) => new(d.Name, d.Position ?? "—", d.Nik, d.Extension ?? "—", d.Location ?? "—", d.Department ?? "—", d.DepartmentCode, d.Site ?? "—", d.SiteCode, d.Manager ?? "—", d.Email, d.Status, AvatarPalette.For(d.Nik), d.PhotoPath, d.ManagerNik, d.Section);

    private async Task Reload(int requestedPage, bool replace)
    {
        var qAtStart = searchQ;
        loading = true;
        var q = searchQ is null ? "" : $"&q={Uri.EscapeDataString(searchQ)}";
        var presence = string.IsNullOrEmpty(presenceFilter) ? "" : $"&presence={presenceFilter}";
        var sortParts = selectedSort.Split('-');
        var sort = sortParts[0];
        var desc = sortParts.Length > 1 && sortParts[1] == "desc";
        var sortParam = $"&sort={sort}&desc={desc}";
        var url = $"/api/directory/employees?page={requestedPage}&pageSize={PageSize}&{SelectionParam}{q}{presence}{sortParam}";
        var result = await Auth.GetAsync<DirectoryPageDto>(url);
        if (qAtStart != searchQ) return; // superseded by a keystroke or clear
        loading = false;
        if (result is null) { loadError = "Could not load the directory."; return; }
        total = result.Total; page = result.Page;
        var mapped = result.Items.Select(Map).ToList();
        if (replace) people = mapped; else people.AddRange(mapped);
        selected = selected is null ? null : people.FirstOrDefault(p => p.Nik == selected.Nik);
        loadError = null;
        StateHasChanged();
    }

    private Task LoadMore() => Reload(page + 1, replace: false);
    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
        await LoadStructure();
        await Reload(1, replace: true);
    });

    private void OnPresenceChanged(string nik, string status) => _ = InvokeAsync(() =>
    {
        var index = people.FindIndex(p => p.Nik == nik);
        if (index >= 0)
        {
            var updated = people[index] with { Status = status };
            people[index] = updated;
            if (selected?.Nik == nik) selected = updated;
            StateHasChanged();
        }
        SchedulePresenceRefresh();
    });

    // The tab counts and "N online" subtitle come from /api/directory/structure, and a
    // presence-filtered list gains/loses people as statuses change — re-read both, debounced
    // so a burst of logins is one round-trip. Quiet: no skeleton, loaded list kept otherwise.
    private CancellationTokenSource? _presenceRefresh;

    private void SchedulePresenceRefresh()
    {
        _presenceRefresh?.Cancel();
        var cts = _presenceRefresh = new CancellationTokenSource();
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(1000, cts.Token); } catch (OperationCanceledException) { return; }
            var fresh = await Auth.GetAsync<DirectoryStructureNodeDto>("/api/directory/structure");
            if (cts.IsCancellationRequested) return;
            if (fresh is not null)
            {
                dirStructure = fresh;
                Layout.SetSubtitle($"{allPeopleCount:N0} people · {PresenceCounts.Online:N0} online");
            }
            if (!string.IsNullOrEmpty(presenceFilter)) await Reload(1, replace: true);
            else StateHasChanged();
        });
    }

    private void OnConnectionStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCardKey(KeyboardEventArgs e, Employee p) { if (e.Key is "Enter" or " ") selected = p; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
        await SyncMobileDetailAsync();
    }

    // ── Phone layout (<= 767px): the profile sheet is a full-screen detail; phone Back closes it.
    //    `selected` is set from many click handlers, so history is synced after render. ──
    private DotNetObjectReference<Directory>? _selfRef;
    private bool _mobileDetailPushed;

    private async Task SyncMobileDetailAsync()
    {
        try
        {
            if (selected is not null && !_mobileDetailPushed)
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                _mobileDetailPushed = await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _selfRef, nameof(MobileBack));
            }
            else if (selected is null && _mobileDetailPushed)
            {
                _mobileDetailPushed = false;
                await JS.InvokeVoidAsync("ipop.mobile.popDetail");
            }
        }
        catch (JSException) { }
    }

    [JSInvokable]
    public Task MobileBack() => InvokeAsync(() =>
    {
        _mobileDetailPushed = false; // the browser already popped the entry
        selected = null;
        StateHasChanged();
    });

    public void Dispose() { _ = JS.InvokeVoidAsync("ipop.mobile.clearDetail").AsTask().ContinueWith(_ => { }); _selfRef?.Dispose(); Nav.LocationChanged -= OnLocationChanged; Layout.SearchChanged -= OnSearchChanged; Auth.PresenceChanged -= OnPresenceChanged; _presenceRefresh?.Cancel(); Auth.DirectoryChanged -= OnDirectoryChanged; Auth.ConnectionStateChanged -= OnConnectionStateChanged; Favorites.Changed -= OnFavoritesChanged; }
}