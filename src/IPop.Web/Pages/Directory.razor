@page "/directory"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav
@inject IPop.Web.Services.CallState CallSvc
@inject IPop.Web.Services.FavoriteContacts Favorites
@inject ToastService Toasts

<PageTitle>Directory — IPop</PageTitle>

<div class="toolbar">
    <div class="apple-segmented">
        <button type="button" class="seg-btn @(presenceFilter == "" ? "active" : "")" @onclick='() => SetPresenceFilter("")'>
            <span>All</span>
            <span class="seg-count">@PresenceCounts.All.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "on" ? "active" : "")" @onclick='() => SetPresenceFilter("on")'>
            <span class="seg-dot on"></span>
            <span>Online</span>
            <span class="seg-count">@PresenceCounts.Online.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "busy" ? "active" : "")" @onclick='() => SetPresenceFilter("busy")'>
            <span class="seg-dot busy"></span>
            <span>Busy</span>
            <span class="seg-count">@PresenceCounts.Busy.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "away" ? "active" : "")" @onclick='() => SetPresenceFilter("away")'>
            <span class="seg-dot away"></span>
            <span>Away</span>
            <span class="seg-count">@PresenceCounts.Away.ToString("N0")</span>
        </button>
        <button type="button" class="seg-btn @(presenceFilter == "off" ? "active" : "")" @onclick='() => SetPresenceFilter("off")'>
            <span class="seg-dot off"></span>
            <span>Offline</span>
            <span class="seg-count">@PresenceCounts.Offline.ToString("N0")</span>
        </button>
    </div>
    <div class="push flex center gap-8">
        <div class="v6-search">
            <i data-lucide="search"></i>
            <input type="search" placeholder="Search name, NIK or email" aria-label="Search people" value="@Layout.SearchQuery" @oninput="e => Layout.SetSearch(e.Value?.ToString())" />
        </div>
        <div class="apple-segmented view-seg">
            <button type="button" class="seg-btn @(!isGridView ? "active" : "")" title="List view" aria-label="List view" @onclick="() => isGridView = false"><i data-lucide="list"></i></button>
            <button type="button" class="seg-btn @(isGridView ? "active" : "")" title="Grid view" aria-label="Grid view" @onclick="() => isGridView = true"><i data-lucide="layout-grid"></i></button>
        </div>
        <div class="dir-sort">
            <button type="button" class="ghost-btn" @onclick="() => sortOpen = !sortOpen" @onclick:stopPropagation="true" aria-haspopup="menu" aria-expanded="@sortOpen">
                <i data-lucide="arrow-up-down"></i>@SortLabel(selectedSort)<i data-lucide="chevron-down" class="chev"></i>
            </button>
            @if (sortOpen)
            {
                <div class="menu-backdrop" @onclick="() => sortOpen = false"></div>
                <div class="dir-sort-menu" role="menu">
                    @foreach (var opt in SortOptions)
                    {
                        var o = opt;
                        <button type="button" role="menuitemradio" aria-checked="@(selectedSort == o)" @onclick="() => PickSort(o)">
                            <span>@SortLabel(o)</span>
                            @if (selectedSort == o) { <i data-lucide="check"></i> }
                        </button>
                    }
                </div>
            }
        </div>
        <button type="button" class="ghost-btn @(favOnly ? "on" : "")" title="Show favorites only" aria-pressed="@favOnly" @onclick="ToggleFavOnly">
            <i data-lucide="star"></i>Favorites <span class="cnt">@FavoritePeople.Count</span>
        </button>
        <button type="button" class="ghost-btn" title="Export search/filter results to CSV" disabled="@exporting" @onclick="ExportCsv"><i data-lucide="download"></i>@(exporting ? "Exporting…" : "Export")</button>
        <button type="button" class="ghost-btn" title="Priority contacts: favorites & frequent" @onclick='() => Nav.NavigateTo("/directory/priority")'><i data-lucide="sparkles"></i>Priority contacts</button>
    </div>
</div>

<div class="body">
    @if (notice is not null)
    {
        <div class="module-notice" style="margin:0 0 10px">
            <div class="note @(noticeIsError ? "err" : "")">
                <i data-lucide="info"></i><span>@notice</span>
                <button class="note-x" @onclick="DismissNotice" aria-label="Dismiss">
                    <i data-lucide="x"></i>
                </button>
            </div>
        </div>
    }

    <div class="cols dir-cols">
        <div class="col gap-14 dir-side">
        <!-- Structure: Site ▸ Department ▸ Division -->
        <div class="card dir-structure">
            <div class="card-head">
                <div>
                    <div class="card-title">Structure</div>
                    <div class="card-meta">@(structureLoading ? "Loading…" : TotalDivisions > 0 ? $"{allPeopleCount:N0} people · {TotalDivisions:N0} divisions" : $"{allPeopleCount:N0} people")</div>
                </div>
            </div>
            @if (structureLoading)
            {
                <div style="padding:14px">
                    @for (var i = 0; i < 6; i++) { <div class="skel" style="height:28px;margin-bottom:6px;border-radius:8px"></div> }
                </div>
            }
            else if (dirStructure is null)
            {
                <div class="tree-empty">Could not load the directory structure.</div>
            }
            else
            {
                <div class="tree">
                    <button type="button" class="tree-node @(selectedDivision is null ? "on" : "")" @onclick="ClearDivisionFilter">
                        <i data-lucide="users"></i>
                        <span class="lbl">All people</span>
                        <span class="tree-n">@allPeopleCount.ToString("N0")</span>
                    </button>
                    @foreach (var site in dirStructure.Sites)
                    {
                        <div class="tree-site">@site.Name</div>
                        @foreach (var dept in site.Departments)
                        {
                            <button type="button" class="tree-node lv2">
                                <i data-lucide="chevron-down"></i>
                                <span class="lbl">@dept.Name</span>
                                <span class="tree-n">@dept.MemberCount</span>
                            </button>
                            @foreach (var div in dept.Divisions)
                            {
                                var isSel = selectedDivision?.Code == div.Code;
                                <button type="button" class="tree-node lv3 @(isSel ? "on" : "")"
                                        @onclick="() => SelectDivision(div)">
                                    <span class="lbl">@div.Name</span>
                                    <span class="tree-n">@div.MemberCount</span>
                                </button>
                            }
                        }
                    }
                    @if (dirStructure.NoDivisionCount > 0)
                    {
                        <div class="tree-foot"><i data-lucide="circle-dashed"></i><span class="lbl">No division</span><span class="tree-n">@dirStructure.NoDivisionCount.ToString("N0")</span></div>
                    }
                </div>
            }
        </div>

        @if (FavoritePeople.Count > 0)
        {
            <div class="card dir-favs">
                <div class="card-head">
                    <div class="card-title">Favorites</div>
                    <span class="card-meta" style="margin-left:auto">@FavoritePeople.Count</span>
                </div>
                <div class="fav-list">
                    @foreach (var p in FavoritePeople)
                    {
                        <div class="fav-row" @onclick="() => selected = p">
                            <div class="av-wrap">
                                <div class="av" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials</div>
                                <span class="presence @p.Status"></span>
                            </div>
                            <span class="n">@p.Name</span>
                            <button type="button" class="act" title="Chat" aria-label="Chat with @p.Name" @onclick="() => OpenChatWith(p.Nik)" @onclick:stopPropagation="true"><i data-lucide="message-circle"></i></button>
                        </div>
                    }
                </div>
            </div>
        }
        </div>

        <!-- People Section -->
        <div class="col gap-14" style="min-width:0">
            @if (selectedNiks.Count > 0)
            {
                <div class="dir-bulk-bar">
                    <button type="button" class="v6-cb on" role="checkbox" aria-checked="true" aria-label="Clear selection" @onclick="() => selectedNiks.Clear()">
                        <i data-lucide="minus"></i>
                    </button>
                    <span class="dbb-count">@selectedNiks.Count selected</span>
                    <div style="flex:1"></div>
                    <button type="button" class="dbb-btn" @onclick="BulkMessage"><i data-lucide="message-circle"></i>Message</button>
                    <button type="button" class="dbb-btn" @onclick="BulkCreateGroup"><i data-lucide="users"></i>Create group</button>
                    <button type="button" class="dbb-btn" @onclick="BulkEmail"><i data-lucide="mail"></i>Email</button>
                    <button type="button" class="dbb-btn" @onclick="BulkFavorite"><i data-lucide="star"></i>Favorite</button>
                    <button type="button" class="dbb-clear" @onclick="() => selectedNiks.Clear()">Clear</button>
                </div>
            }

            <div class="card dir-people">
                <div class="card-head">
                    <span class="card-title">@(favOnly ? "Favorites" : selectedDivision?.Name ?? "All people")</span>
                    <span class="v6-count-pill">@DisplayedPeople.Count shown</span>
                    <span class="card-meta" style="margin-left:auto">Click a person to open their profile</span>
                </div>
                <div class="dir-scroll">
                @if (isGridView)
                {
                    @if (loading || structureLoading)
                    {
                        <div style="padding:16px;display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px">
                            @for (var i = 0; i < 8; i++)
                            {
                                <div class="skel" style="height:140px;border-radius:14px"></div>
                            }
                        </div>
                    }
                    else if (DisplayedPeople.Count == 0 && FavoritePeople.Count == 0)
                    {
                        <div style="text-align:center;padding:32px;color:var(--ink-3)">@(loadError ?? "No one found.")</div>
                    }
                    else
                    {
                        <div class="emp-grid">
                            @foreach (var p in DisplayedPeople)
                            {
                                var isFav = Favorites.IsFavorite(p.Nik);
                                var isChecked = selectedNiks.Contains(p.Nik);
                                <div class="emp-card @(isFav ? "fav" : "")" @onclick="() => selected = p">
                                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px" @onclick:stopPropagation="true">
                                        <button type="button" class="v6-cb @(isChecked ? "on" : "")"
                                                role="checkbox" aria-checked="@isChecked"
                                                aria-label="Select @p.Name" @onclick="() => TogglePersonSelection(p.Nik)">
                                            @if (isChecked) { <i data-lucide="check"></i> }
                                        </button>
                                        <button type="button" class="icon-btn" style="border:none;background:transparent;width:24px;height:24px" title="@(isFav ? "Remove favorite" : "Add favorite")" @onclick="() => ToggleFavorite(p.Nik)">
                                            <i data-lucide="star" style="width:14px;height:14px;color:@(isFav ? "var(--warn)" : "var(--ink-4)");fill:@(isFav ? "currentColor" : "none")"></i>
                                        </button>
                                    </div>
                                    <div class="top">
                                        <div class="av-wrap">
                                            <div class="avatar" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials</div>
                                            <span class="presence @p.Status"></span>
                                        </div>
                                        <div style="min-width:0;flex:1">
                                            <div class="n" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Name</div>
                                            <div class="p" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@p.Position</div>
                                        </div>
                                    </div>
                                    <div class="foot">
                                        <span>@(p.Department) · @p.Nik</span>
                                        <span class="badge @(p.Status == "on" ? "ok" : p.Status == "busy" ? "bad" : p.Status == "away" ? "warn" : "mute")">@p.StatusLabel</span>
                                    </div>
                                    <div style="display:flex;gap:6px;margin-top:10px;border-top:1px solid var(--line-soft);padding-top:8px" @onclick:stopPropagation="true">
                                        <button type="button" class="ghost-btn" style="flex:1;height:28px;font-size:11px;padding:0 6px" title="Chat" @onclick="() => OpenChatWith(p.Nik)"><i data-lucide="message-circle" style="width:12px;height:12px"></i>Chat</button>
                                        <button type="button" class="ghost-btn" style="flex:1;height:28px;font-size:11px;padding:0 6px" title="Call" @onclick="() => StartCallWith(p.Nik)"><i data-lucide="phone" style="width:12px;height:12px"></i>Call</button>
                                        <button type="button" class="ghost-btn" style="flex:1;height:28px;font-size:11px;padding:0 6px" title="Email" @onclick="() => OpenMailWith(p.Nik)"><i data-lucide="mail" style="width:12px;height:12px"></i>Mail</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th style="width:32px">
                                    <button type="button" class="v6-cb @(DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count ? "on" : "")"
                                            role="checkbox" aria-checked="@(DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count)"
                                            aria-label="Select all" @onclick="ToggleSelectAllPeople">
                                        @if (DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count)
                                        {
                                            <i data-lucide="check"></i>
                                        }
                                    </button>
                                </th>
                                <th>Name</th>
                                <th>NIK</th>
                                <th>Position</th>
                                <th>Division</th>
                                <th>Status</th>
                                <th style="width:76px"><span class="sr-only">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loading || structureLoading)
                            {
                                @for (var i = 0; i < 7; i++)
                                {
                                    <tr>
                                        <td colspan="7"><div class="skel" style="height:26px;border-radius:6px"></div></td>
                                    </tr>
                                }
                            }
                            else if (DisplayedPeople.Count == 0 && FavoritePeople.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" style="text-align:center;padding:32px;color:var(--ink-3)">@(loadError ?? "No one in this division yet.")</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in DisplayedPeople)
                                {
                                    var isFav = Favorites.IsFavorite(p.Nik);
                                    var isSel = (selected?.Nik ?? people.FirstOrDefault()?.Nik) == p.Nik;
                                    var isChecked = selectedNiks.Contains(p.Nik);
                                    <tr class="@(isSel ? "sel" : "")" @onclick="() => selected = p">
                                        <td @onclick:stopPropagation="true">
                                            <button type="button" class="v6-cb @(isChecked ? "on" : "")"
                                                    role="checkbox" aria-checked="@isChecked"
                                                    aria-label="Select @p.Name" @onclick="() => TogglePersonSelection(p.Nik)">
                                                @if (isChecked) { <i data-lucide="check"></i> }
                                            </button>
                                        </td>
                                        <td>
                                            <div class="cell-person">
                                                <div class="av-wrap">
                                                    <div class="av" style="@IPop.Web.Models.AvatarPhotos.Style(p.Nik)">@p.Initials</div>
                                                    <span class="presence @p.Status"></span>
                                                </div>
                                                <div>
                                                    <div class="n">@p.Name</div>
                                                    <div class="s">@p.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="num dim">@p.Nik</td>
                                        <td class="dim">@p.Position</td>
                                        <td>@if (p.Department != "—") { <span class="div-chip">@p.Department</span> } else { <span class="dim">—</span> }</td>
                                        <td>
                                            <span class="st-pill @p.Status"><span class="d"></span>@p.StatusLabel</span>
                                        </td>
                                        <td>
                                            <div class="row-acts">
                                                <button type="button" class="ra" title="Chat" aria-label="Chat with @p.Name" @onclick="() => OpenChatWith(p.Nik)" @onclick:stopPropagation="true">
                                                    <i data-lucide="message-circle"></i>
                                                </button>
                                                <button type="button" class="ra" title="Call" aria-label="Call @p.Name" @onclick='() => StartCallWith(p.Nik)' @onclick:stopPropagation="true">
                                                    <i data-lucide="phone"></i>
                                                </button>
                                                <button type="button" class="ra fav @(isFav ? "on" : "")"
                                                        title="@(isFav ? "Remove from favorites" : "Add to favorites")"
                                                        @onclick="() => ToggleFavorite(p.Nik)" @onclick:stopPropagation="true">
                                                    <i data-lucide="star"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
                @if (!loading && page < TotalPages)
                {
                    <div style="padding:14px 20px;text-align:center">
                        <button type="button" class="ghost-btn" style="margin:0 auto" @onclick="LoadMore">Show more (@(total - people.Count) remaining)</button>
                    </div>
                }
                </div>
                <div class="dir-foot">
                    <span>Showing @DisplayedPeople.Count.ToString("N0") of @total.ToString("N0") · @(string.IsNullOrEmpty(presenceFilter) ? "All statuses" : PresenceFilterLabel(presenceFilter))</span>
                    <span>Sorted by @SortLabel(selectedSort)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<ProfileDrawer Person="selected" OnClose="() => selected = null" />

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    private const int PageSize = 120;
    private bool loading = true;
    private string? loadError;
    private int page = 1, total;
    private Employee? selected;
    private List<Employee> people = [];
    private bool isGridView;
    private bool favOnly;
    private string selectedSort = "name-asc";
    private bool sortOpen;
    private static readonly string[] SortOptions = ["name-asc", "name-desc", "nik-asc", "status-asc"];
    private static string SortLabel(string key) => key switch
    {
        "name-desc" => "Name Z–A",
        "nik-asc" => "NIK",
        "status-asc" => "Online first",
        _ => "Name A–Z",
    };
    private async Task PickSort(string key)
    {
        sortOpen = false;
        if (selectedSort == key) return;
        selectedSort = key;
        await OnSortChanged();
    }
    private int allPeopleCount => (dirStructure?.Sites.Sum(s => s.MemberCount) ?? 0) + (dirStructure?.NoDivisionCount ?? 0);
    private HashSet<string> selectedNiks = [];
    private IReadOnlyList<Employee> DisplayedPeople => favOnly ? people.Where(p => Favorites.IsFavorite(p.Nik)).ToList() : people;

    private void TogglePersonSelection(string nik)
    {
        if (!selectedNiks.Add(nik)) selectedNiks.Remove(nik);
    }

    private void ToggleSelectAllPeople()
    {
        if (DisplayedPeople.Count > 0 && selectedNiks.Count == DisplayedPeople.Count)
            selectedNiks.Clear();
        else
            selectedNiks = DisplayedPeople.Select(p => p.Nik).ToHashSet();
    }

    private void ToggleFavOnly()
    {
        favOnly = !favOnly;
        selectedNiks.Clear();
    }

    private async Task OnSortChanged()
    {
        await Reload(1, replace: true);
    }

    private void BulkMessage()
    {
        if (selectedNiks.Count == 1) OpenChatWith(selectedNiks.First());
        else Nav.NavigateTo("/chat");
    }

    private void BulkCreateGroup()
    {
        Nav.NavigateTo($"/chat?new=group&members={string.Join(",", selectedNiks)}");
    }

    private void BulkEmail()
    {
        Nav.NavigateTo($"/mail?to={string.Join(",", selectedNiks)}&compose=1");
    }

    private async Task BulkFavorite()
    {
        foreach (var nik in selectedNiks) await Favorites.ToggleAsync(nik);
        Toasts.Show($"Updated favorites for {selectedNiks.Count} people.", ToastKind.Success);
        selectedNiks.Clear();
    }

    private void OpenMailWith(string nik)
        => Nav.NavigateTo($"/mail?to={Uri.EscapeDataString(nik)}&compose=1");

    private DirectoryConnectionState ConnectionState => Auth.ConnectionState;
    private int TotalPages => total == 0 ? 1 : (int)Math.Ceiling(total / (double)PageSize);

    // Master-detail tree state
    private DirectoryStructureNodeDto? dirStructure;
    private bool structureLoading = true;
    private DirectoryDivisionNodeDto? selectedDivision;
    private bool treeOpen;
    private string? notice;
    private bool noticeIsError;

    // Topbar search: non-empty trimmed query → fetch division matches for tree badges, then
    // reload the grid with q so only matching cards show. Blank query → restore pre-search state.
    private string? searchQ;
    private Dictionary<string, int> divMatches = []; // division code → match count
    private bool IsSearching => searchQ is not null;
    private int TotalDivisions => dirStructure?.Sites.Sum(s => s.Departments.Sum(d => d.Divisions.Length)) ?? 0;

    /// Header tab counts come from the server, not the loaded page: the list is paged, so
    /// counting `people` reported 0 online whenever nobody on the current page was online.
    /// Falls back to the loaded page until the structure call lands.
    private DirectoryPresenceCountsDto PresenceCounts => dirStructure?.PresenceCounts ?? new DirectoryPresenceCountsDto(
        total,
        people.Count(p => p.Status == "on"),
        people.Count(p => p.Status == "busy"),
        people.Count(p => p.Status == "away"),
        people.Count(p => p.Status == "off"));

    private string ConnectionLabel => ConnectionState switch { DirectoryConnectionState.Live => "Live", DirectoryConnectionState.Reconnecting => "Reconnecting...", DirectoryConnectionState.Connecting => "Connecting...", _ => "Offline" };

    protected override void OnInitialized()
    {
        // ipop-25: make the shell search's placeholder explicit here too, so the
        // default in SetHeader stays a fallback rather than Directory-specific copy.
        Layout.SetHeader("Directory", "People");
        Layout.SearchChanged += OnSearchChanged;
        Auth.PresenceChanged += OnPresenceChanged;
        Auth.DirectoryChanged += OnDirectoryChanged;
        Auth.ConnectionStateChanged += OnConnectionStateChanged;
        Favorites.Changed += OnFavoritesChanged;
    }

    // Kontak Prioritas: kartu favorit di atas grid, dari NIK yang disimpan per
    // pengguna (frontend wave). Kosong = bagian disembunyikan.
    private List<Employee> favoritePeople = [];
    private List<Employee> FavoritePeople => favoritePeople;

    private void OnFavoritesChanged() => _ = InvokeAsync(async () =>
    {
        await LoadFavoritesAsync();
        StateHasChanged();
    });

    private async Task LoadFavoritesAsync()
    {
        await Favorites.EnsureLoadedAsync();
        if (Favorites.All.Count == 0) { favoritePeople = []; return; }
        var wanted = Favorites.All.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var loaded = new List<Employee>();
        var p = 1;
        while (wanted.Count > 0 && p <= 20)
        {
            var result = await Auth.GetAsync<DirectoryPageDto>($"/api/directory/employees?page={p}&pageSize=120");
            if (result is null || result.Items.Length == 0) break;
            foreach (var d in result.Items)
            {
                if (!wanted.Remove(d.Nik)) continue;
                loaded.Add(Map(d));
            }
            if (wanted.Count == 0 || result.Items.Length < 120) break;
            p++;
        }
        favoritePeople = loaded.OrderBy(e => e.Name).ToList();
    }

    private async Task Unfavorite(string nik) => await Favorites.ToggleAsync(nik);

    private async Task ToggleFavorite(string nik) => await Favorites.ToggleAsync(nik);

    // ---- Ekspor CSV (hasil pencarian/filter saat ini) ----
    private bool exporting;

    private async Task ExportCsv()
    {
        if (exporting) return;
        exporting = true;
        try
        {
            // Ekspor server-side: filter yang sama (divisi + kata kunci + kehadiran)
            // berlaku untuk SELURUH himpunan hasil, bukan satu halaman yang terlihat.
            // Diunduh via fetch ber-Bearer (window.open tak membawa header auth).
            var divCode = selectedDivision?.Code ?? "";
            var url = $"/api/directory/employees/export.csv?divisionCode={Uri.EscapeDataString(divCode)}"
                + (searchQ is null ? "" : $"&q={Uri.EscapeDataString(searchQ)}")
                + (string.IsNullOrEmpty(presenceFilter) ? "" : $"&presence={presenceFilter}");
            var res = await Auth.SendAsync(HttpMethod.Get, url);
            if (!res.IsSuccessStatusCode)
            {
                notice = $"Export failed ({(int)res.StatusCode}).";
                noticeIsError = true;
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"directory-{stamp}.csv");
            notice = "Directory CSV file downloaded.";
            noticeIsError = false;
        }
        catch (Exception ex)
        {
            notice = $"Export failed: {ex.Message}";
            noticeIsError = true;
        }
        finally
        {
            exporting = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStructure();
        _ = LoadFavoritesAsync();
        await Reload(1, replace: true);
        await SelectFromQuery();
        Nav.LocationChanged += OnLocationChanged;
    }

    // ⌘K "People" results link to /directory?nik=… — filter to that person and select them.
    private async Task SelectFromQuery()
    {
        var nik = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query)["nik"];
        if (string.IsNullOrWhiteSpace(nik)) return;
        searchQ = nik;
        await Reload(1, replace: true);
        selected = people.FirstOrDefault(p => string.Equals(p.Nik, nik, StringComparison.OrdinalIgnoreCase)) ?? selected;
        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(SelectFromQuery);

    private async Task LoadStructure()
    {
        structureLoading = true;
        dirStructure = await Auth.GetAsync<DirectoryStructureNodeDto>("/api/directory/structure");
        structureLoading = false;
        if (dirStructure is not null) Layout.SetSubtitle(TotalDivisions > 0 ? $"{allPeopleCount:N0} people · {TotalDivisions:N0} divisions" : $"{allPeopleCount:N0} people");
        StateHasChanged();
    }

    private async Task SelectDivision(DirectoryDivisionNodeDto? d)
    {
        if (selectedDivision?.Code == d?.Code && d is not null)
            selectedDivision = null;
        else
            selectedDivision = d;
        treeOpen = false;
        await Reload(1, replace: true);
    }

    private async Task ClearDivisionFilter()
    {
        selectedDivision = null;
        treeOpen = false;
        await Reload(1, replace: true);
    }

    private int? divHitCount(DirectoryDivisionNodeDto div)
        => IsSearching && divMatches.TryGetValue(div.Code, out var n) ? n : null;

    // ipop-35: void handler + InvokeAsync so an exception inside the await surfaces via
    // the module notice instead of vanishing as an async-void unhandled error.
    private void OnSearchChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            var q = Layout.SearchQuery?.Trim();
            if (string.IsNullOrEmpty(q))
            {
                searchQ = null;
                divMatches = [];
                await Reload(page, replace: true);
                return;
            }
            searchQ = q;
            var matches = await Auth.GetAsync<DirectoryDivisionMatchDto[]>($"/api/directory/divisions?q={Uri.EscapeDataString(q)}");
            if (searchQ != q) return; // superseded by a newer keystroke or a clear
            divMatches = matches?.ToDictionary(m => m.Code, m => m.MatchCount) ?? [];
            await Reload(1, replace: true);
        }
        catch (Exception ex)
        {
            noticeIsError = true;
            notice = $"Search failed: {ex.Message}";
            StateHasChanged();
        }
    });

    private void ToggleTree() => treeOpen = !treeOpen;
    private void DismissNotice() => notice = null;

    // Filter kehadiran — diteruskan ke endpoint employees (presence=on|busy|away|off).
    private string presenceFilter = "";

    private static string PresenceFilterLabel(string status) => status switch
    {
        "on" => "Online",
        "busy" => "Busy",
        "away" => "Away",
        "off" => "Offline",
        _ => "All"
    };

    private async Task SetPresenceFilter(string status)
    {
        if (presenceFilter == status) return;
        presenceFilter = status;
        await Reload(1, replace: true);
    }
    private void ShowModuleNotice(string module)
    {
        notice = $"{module} isn't available yet — it activates as the module ships.";
        noticeIsError = false;
    }

    private void OpenChatWith(string nik)
        => Nav.NavigateTo($"/chat?nik={Uri.EscapeDataString(nik)}");

    private async Task StartCallWith(string nik)
    {
        if (string.IsNullOrWhiteSpace(nik)) return;
        var room = await CallSvc.CreateAsync(nik);
        if (room is not null)
        {
            Nav.NavigateTo("/calls");
        }
    }

    private static Employee Map(DirectoryEmployeeDto d) => new(d.Name, d.Position ?? "—", d.Nik, d.Extension ?? "—", d.Location ?? "—", d.Department ?? "—", d.DepartmentCode, d.Site ?? "—", d.SiteCode, d.Manager ?? "—", d.Email, d.Status, AvatarPalette.For(d.Nik), d.PhotoPath);

    private async Task Reload(int requestedPage, bool replace)
    {
        var qAtStart = searchQ;
        loading = true;
        var divCode = selectedDivision?.Code ?? "";
        var q = searchQ is null ? "" : $"&q={Uri.EscapeDataString(searchQ)}";
        var presence = string.IsNullOrEmpty(presenceFilter) ? "" : $"&presence={presenceFilter}";
        var sortParts = selectedSort.Split('-');
        var sort = sortParts[0];
        var desc = sortParts.Length > 1 && sortParts[1] == "desc";
        var sortParam = $"&sort={sort}&desc={desc}";
        var url = $"/api/directory/employees?page={requestedPage}&pageSize={PageSize}&divisionCode={Uri.EscapeDataString(divCode)}{q}{presence}{sortParam}";
        var result = await Auth.GetAsync<DirectoryPageDto>(url);
        if (qAtStart != searchQ) return; // superseded by a keystroke or clear
        loading = false;
        if (result is null) { loadError = "Could not load the directory."; return; }
        total = result.Total; page = result.Page;
        var mapped = result.Items.Select(Map).ToList();
        if (replace) people = mapped; else people.AddRange(mapped);
        selected = selected is null ? null : people.FirstOrDefault(p => p.Nik == selected.Nik);
        loadError = null;
        StateHasChanged();
    }

    private Task LoadMore() => Reload(page + 1, replace: false);
    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
        await LoadStructure();
        await Reload(1, replace: true);
    });

    private void OnPresenceChanged(string nik, string status) => _ = InvokeAsync(() =>
    {
        var index = people.FindIndex(p => p.Nik == nik);
        if (index < 0) return;
        var updated = people[index] with { Status = status };
        people[index] = updated;
        if (selected?.Nik == nik) selected = updated;
        StateHasChanged();
    });

    private void OnConnectionStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCardKey(KeyboardEventArgs e, Employee p) { if (e.Key is "Enter" or " ") selected = p; }
    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
    public void Dispose() { Nav.LocationChanged -= OnLocationChanged; Layout.SearchChanged -= OnSearchChanged; Auth.PresenceChanged -= OnPresenceChanged; Auth.DirectoryChanged -= OnDirectoryChanged; Auth.ConnectionStateChanged -= OnConnectionStateChanged; Favorites.Changed -= OnFavoritesChanged; }
}