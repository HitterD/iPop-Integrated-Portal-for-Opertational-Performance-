@page "/notifier/connect"
@implements IDisposable
@using IPop.Application.Notifier
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

@* iPop Notifier "Sign in with browser" (1.4.3, OAuth loopback; flow in NotifierLoopback). Only ever reached as the
   one tab the app itself opened (?state&challenge&redirect&pc); nothing pushes this card to other tabs. Authorize mints
   a code bound to the app's PKCE challenge and this account, then the tab goes back to the app on 127.0.0.1. When the
   browser can't reach the app, "Not connected?" shows a short code to paste into the app (useless without the app's
   verifier). *@
<PageTitle>Connect iPop Notifier — iPop</PageTitle>

<div class="nc-wrap">
    <div class="nc-card" role="dialog" aria-labelledby="nc-title" aria-live="polite">
        @switch (view)
        {
            case View.Loading:
                <div class="nc-spinner" aria-hidden="true"></div>
                <p class="nc-sub">Loading…</p>
                break;
            case View.Invalid:
                <div class="nc-badge warn"><i data-lucide="link-2-off"></i></div>
                <h2 id="nc-title">This link can't be used</h2>
                <p class="nc-sub">It didn't come from iPop Notifier on this PC. To connect, choose <b>Sign in with browser</b> in iPop Notifier.</p>
                <div class="nc-actions"><button type="button" class="nc-btn secondary" @onclick="ToIPop">Back to iPop</button></div>
                break;
            case View.Sent:
                <div class="nc-spinner" aria-hidden="true"></div>
                <h2 id="nc-title">Connecting iPop Notifier…</h2>
                <p class="nc-sub">Handing over to iPop Notifier on @Pc. This only takes a moment.</p>
                @if (showCode && shortCode is not null)
                {
                    <details class="nc-more" open="@codeOpen">
                        <summary>Not connected?</summary>
                        <p class="nc-hint">In iPop Notifier, click <b>Paste code from browser</b> and enter this code. It works once, for 2 minutes, and only in the iPop Notifier that opened this page. Never give it to anyone.</p>
                        <div class="nc-code" aria-label="Code for iPop Notifier">@shortCode</div>
                        <button type="button" class="nc-btn secondary nc-copy" @onclick="CopyAsync"><i data-lucide="@(copied ? "check" : "copy")"></i>@(copied ? "Copied" : "Copy code")</button>
                    </details>
                }
                break;
            case View.Declined:
                <div class="nc-badge"><i data-lucide="x"></i></div>
                <h2 id="nc-title">Not connected</h2>
                <p class="nc-sub">iPop Notifier was not connected. You can close this tab.</p>
                break;
            default:
                <div class="nc-badge"><i data-lucide="bell-ring"></i></div>
                <h2 id="nc-title">iPop Notifier wants to connect</h2>
                <p class="nc-sub">iPop Notifier asks to sign in with your iPop account.</p>
                <dl class="nc-rows">
                    <div class="nc-row"><dt><i data-lucide="monitor"></i>PC</dt><dd>@Pc</dd></div>
                    <div class="nc-row"><dt><i data-lucide="user-round"></i>Account</dt><dd>as @Display(Auth.Me?.Name)</dd></div>
                </dl>
                <p class="nc-note"><i data-lucide="shield-check"></i><span>Only continue if you just chose <b>Sign in with browser</b> in iPop Notifier on this PC.</span></p>
                @if (error is not null) { <p class="nc-note warn"><i data-lucide="triangle-alert"></i><span>@error</span></p> }
                <div class="nc-actions">
                    <button type="button" class="nc-btn primary" @onclick="AuthorizeAsync" disabled="@busy">@(busy ? "Authorizing…" : "Authorize")</button>
                    <button type="button" class="nc-btn secondary" @onclick="Decline" disabled="@busy">Decline</button>
                </div>
                break;
        }
    </div>
</div>

<style>
    /* Apple-like sheet on the v6 tokens; dark mode follows tokens.css. */
    .nc-wrap { min-height: calc(100dvh - 140px); display: grid; place-items: center; padding: 32px 16px; }
    .nc-card { width: min(440px, 100%); text-align: center; padding: 32px 28px 26px; border-radius: 22px; background: var(--surface, #fff);
               border: 1px solid var(--line, #e7e5e4); box-shadow: var(--shadow-lg, 0 8px 32px -8px rgba(0,0,0,.16)); color: var(--ink, #1c1917);
               animation: nc-in .32s var(--ease-spring, cubic-bezier(.2,.9,.3,1.2)); }
    .nc-card h2 { font-size: 21px; font-weight: 680; letter-spacing: -.01em; margin: 14px 0 6px; line-height: 1.25; }
    .nc-sub { font-size: 14.5px; color: var(--ink-3, #78716c); line-height: 1.5; margin: 0 auto 18px; max-width: 36ch; }
    .nc-sub b, .nc-note b, .nc-hint b { color: var(--ink, #1c1917); font-weight: 650; }
    .nc-badge { width: 60px; height: 60px; margin: 0 auto; border-radius: 18px; display: grid; place-items: center;
                background: var(--accent-soft, #e4f4ea); color: var(--accent-ink, #1c7a44); }
    .nc-badge svg { width: 28px; height: 28px; }
    .nc-badge.warn { background: var(--danger-soft, #fdecea); color: var(--danger, #c0392b); }
    .nc-rows { margin: 0 0 14px; border-radius: 14px; background: var(--surface-sunken, #f5f5f4); text-align: left; overflow: hidden; }
    .nc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; font-size: 14px; }
    .nc-row + .nc-row { border-top: 1px solid var(--line, #e7e5e4); }
    .nc-row dt { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-3, #78716c); flex: none; }
    .nc-row dt svg { width: 16px; height: 16px; }
    .nc-row dd { margin: 0; font-weight: 620; color: var(--ink, #1c1917); text-align: right; overflow-wrap: anywhere; min-width: 0; }
    .nc-note { display: flex; align-items: flex-start; gap: 8px; text-align: left; font-size: 13.5px; line-height: 1.45; padding: 10px 12px;
               border-radius: 12px; margin: 0 0 16px; background: var(--surface-sunken, #f5f5f4); color: var(--ink-2, #44403c); }
    .nc-note.warn { background: var(--danger-soft, #fdecea); color: var(--danger, #c0392b); }
    .nc-note svg { width: 16px; height: 16px; flex: none; margin-top: 2px; }
    .nc-actions { display: flex; flex-direction: column; gap: 10px; }
    .nc-btn { height: 46px; border-radius: 12px; font-size: 15px; font-weight: 650; border: 0; cursor: pointer; transition: transform .15s var(--ease-spring, ease-out), background .15s, opacity .15s; }
    .nc-btn:active { transform: scale(.98); }
    .nc-btn:disabled { opacity: .6; cursor: default; }
    .nc-btn.primary { background: var(--accent, #2e9e5b); color: #fff; }
    .nc-btn.primary:hover:not(:disabled) { background: var(--accent-hover, #278a4f); }
    .nc-btn.secondary { background: var(--surface-sunken, #f5f5f4); color: var(--ink, #1c1917); border: 1px solid var(--line, #e7e5e4); }
    .nc-btn.secondary:hover:not(:disabled) { background: var(--surface-3, #f4f2ef); }
    .nc-btn:focus-visible { outline: 2px solid var(--accent, #2e9e5b); outline-offset: 2px; }
    .nc-more { margin-top: 6px; text-align: left; border-top: 1px solid var(--line, #e7e5e4); padding-top: 14px; }
    .nc-more summary { cursor: pointer; font-size: 14px; font-weight: 650; color: var(--ink-2, #44403c); text-align: center; list-style: none; }
    .nc-more summary::-webkit-details-marker { display: none; }
    .nc-hint { font-size: 13px; line-height: 1.45; color: var(--ink-3, #78716c); margin: 10px 0 12px; }
    .nc-code { font: 700 28px/1.2 ui-monospace, "Cascadia Mono", Consolas, monospace; letter-spacing: .14em; text-align: center; padding: 14px 10px;
               border-radius: 14px; background: var(--surface-sunken, #f5f5f4); color: var(--ink, #1c1917); user-select: all; margin-bottom: 10px; }
    .nc-copy { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
    .nc-copy svg { width: 16px; height: 16px; }
    .nc-spinner { width: 34px; height: 34px; margin: 6px auto 4px; border-radius: 50%; border: 3px solid var(--line, #e7e5e4); border-top-color: var(--accent, #2e9e5b); animation: nc-spin .8s linear infinite; }
    @@keyframes nc-spin { to { transform: rotate(360deg); } }
    @@keyframes nc-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
    @@media (prefers-reduced-motion: reduce) { .nc-card { animation: none; } .nc-spinner { animation-duration: 2.4s; } }
</style>

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    [SupplyParameterFromQuery(Name = "challenge")] public string? Challenge { get; set; }
    [SupplyParameterFromQuery(Name = "redirect")] public string? Redirect { get; set; }
    [SupplyParameterFromQuery(Name = "pc")] public string? PcParam { get; set; }

    private enum View { Loading, Card, Invalid, Sent, Declined }
    private sealed record Authorized(string Code, string ShortCode, int ExpiresIn);
    private sealed record Saved(string ShortCode, DateTime ExpiresAt);

    /// "Not connected?" appears this long after the tab was sent back to the app.
    public static readonly TimeSpan CodeDelay = TimeSpan.FromSeconds(4);
    private View view = View.Loading;
    private bool busy, showCode, codeOpen, copied;
    private string? error, shortCode;
    private readonly CancellationTokenSource gone = new();

    private string Pc => NotifierLoopback.CleanPc(PcParam);
    private string StoreKey => "ipop.notifierConnect." + State;

    /// The link must be exactly what the app builds: a 43-character state and challenge and a 127.0.0.1 callback.
    public static bool ValidRequest(string? state, string? challenge, string? redirect) =>
        NotifierLoopback.IsSecret(state) && NotifierLoopback.IsSecret(challenge) && NotifierLoopback.IsValidRedirect(redirect);

    protected override async Task OnInitializedAsync()
    {
        Layout?.SetHeader("iPop Notifier");
        if (!ValidRequest(State, Challenge, Redirect)) { view = View.Invalid; return; }
        // Back from a browser error page (the app wasn't reachable): show the code again instead of a second Authorize.
        var saved = await ReadSavedAsync();
        if (saved is not null && saved.ExpiresAt > DateTime.UtcNow)
        {
            shortCode = saved.ShortCode; view = View.Sent; showCode = codeOpen = true;
            return;
        }
        await Auth.LoadMeAsync();
        view = View.Card;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }

    private static string Display(string? name) => IPop.Application.PersonName.Display(name ?? "");

    private async Task AuthorizeAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifier/link/authorize", new { challenge = Challenge, state = State, redirect = Redirect, pc = Pc });
            if (res.StatusCode == System.Net.HttpStatusCode.BadRequest) { view = View.Invalid; return; }
            if (!res.IsSuccessStatusCode) { error = "Couldn't authorize right now. Try again."; return; }
            var a = await res.Content.ReadFromJsonAsync<Authorized>();
            if (a is null || a.Code.Length == 0) { error = "Couldn't authorize right now. Try again."; return; }
            shortCode = a.ShortCode;
            await SaveAsync(new Saved(a.ShortCode, DateTime.UtcNow.AddSeconds(a.ExpiresIn)));
            view = View.Sent;
            StateHasChanged();
            _ = RevealCodeLaterAsync();
            Nav.NavigateTo(NotifierLoopback.CallbackUrl(Redirect!, State!, code: a.Code), forceLoad: true);
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = "Couldn't reach iPop. Check your connection and try again.";
        }
        finally { busy = false; }
    }

    private void Decline()
    {
        if (busy) return;
        view = View.Declined;
        Nav.NavigateTo(NotifierLoopback.CallbackUrl(Redirect!, State!, error: "access_denied"), forceLoad: true, replace: true);
    }

    private async Task RevealCodeLaterAsync()
    {
        try { await Task.Delay(CodeDelay, gone.Token); } catch (OperationCanceledException) { return; }
        await InvokeAsync(() => { showCode = true; StateHasChanged(); });
    }

    private async Task CopyAsync()
    {
        if (shortCode is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", shortCode); copied = true; }
        catch { copied = false; }
    }

    private async Task SaveAsync(Saved s)
    {
        try { await JS.InvokeVoidAsync("sessionStorage.setItem", StoreKey, System.Text.Json.JsonSerializer.Serialize(s)); } catch { }
    }

    private async Task<Saved?> ReadSavedAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", StoreKey);
            return json is { Length: > 0 } ? System.Text.Json.JsonSerializer.Deserialize<Saved>(json) : null;
        }
        catch { return null; }
    }

    private void ToIPop() => Nav.NavigateTo("/dashboard", replace: true);

    public void Dispose() => gone.Cancel();
}
