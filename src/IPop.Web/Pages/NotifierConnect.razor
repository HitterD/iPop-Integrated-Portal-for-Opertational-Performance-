@page "/notifier/connect"
@implements IDisposable
@inject AuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts
@inject IPop.Web.Services.NotifierLink Link

@* iPop Notifier "Sign in with browser" (1.4.2): the app on this PC asked to connect. The person confirms with a real
   click on Connect; the app collects the one-time code by polling and redeems it with the verifier only it holds.
   Reached in-app from an open tab (NotifierLink claims the request) or as the one tab the app opens (&opened=1). *@
<PageTitle>Connect iPop Notifier — iPop</PageTitle>

<div class="nc-wrap">
    <div class="nc-card" role="dialog" aria-labelledby="nc-title" aria-live="polite">
        @switch (state)
        {
            case View.Loading:
                <div class="nc-spinner" aria-hidden="true"></div>
                <p class="nc-sub">Loading…</p>
                break;
            case View.Connected:
                <div class="nc-badge ok"><i data-lucide="check"></i></div>
                <h2 id="nc-title">Connected</h2>
                <p class="nc-sub">Signed in as <b>@Display(connectedName ?? Auth.Me?.Name)</b>. Notifications will appear on @(info?.PcName ?? "this PC").</p>
                @if (closing)
                {
                    <span class="nc-pill">Closing this tab in 2 s…</span>
                }
                break;
            case View.Waiting:
                <div class="nc-spinner" aria-hidden="true"></div>
                <h2 id="nc-title">Connecting…</h2>
                <p class="nc-sub">iPop Notifier on @(info?.PcName ?? "this PC") is signing in. This only takes a moment.</p>
                break;
            case View.Message:
                <div class="nc-badge @(messageWarn ? "warn" : "")"><i data-lucide="@messageIcon"></i></div>
                <h2 id="nc-title">@messageTitle</h2>
                <p class="nc-sub">@messageText</p>
                <div class="nc-actions">
                    <button type="button" class="nc-btn secondary" @onclick="Leave">@(opened ? "Close this tab" : "Back to iPop")</button>
                </div>
                break;
            default:
                <div class="nc-badge"><i data-lucide="bell-ring"></i></div>
                <h2 id="nc-title">@(info?.Switching == true ? $"Connect as {Display(Auth.Me?.Name)}?" : "Connect iPop Notifier on this PC?")</h2>
                <p class="nc-sub">iPop Notifier asked to sign in with your iPop account. Only continue if you just chose <b>Sign in with browser</b> in the app.</p>
                <dl class="nc-rows">
                    <div class="nc-row"><dt><i data-lucide="monitor"></i>PC</dt><dd>@info?.PcName</dd></div>
                    <div class="nc-row"><dt><i data-lucide="user-round"></i>Account</dt><dd>as @Display(Auth.Me?.Name)</dd></div>
                    <div class="nc-row"><dt><i data-lucide="clock"></i>Requested</dt><dd>@Ago()</dd></div>
                </dl>
                @if (info?.SameAddress == false)
                {
                    <p class="nc-note warn"><i data-lucide="triangle-alert"></i>Open this page on the PC where iPop Notifier is waiting.</p>
                    <div class="nc-actions">
                        <button type="button" class="nc-btn secondary" @onclick="Leave">@(opened ? "Close this tab" : "Back to iPop")</button>
                    </div>
                }
                else
                {
                    @if (error is not null) { <p class="nc-note warn"><i data-lucide="triangle-alert"></i>@error</p> }
                    <div class="nc-actions">
                        <button type="button" class="nc-btn primary" @onclick="Connect" disabled="@busy">@(busy ? "Connecting…" : "Connect")</button>
                        <button type="button" class="nc-btn secondary" @onclick="Cancel" disabled="@busy">Cancel</button>
                    </div>
                }
                break;
        }
    </div>
</div>

<style>
    /* Apple-like sheet on the v6 tokens; dark mode follows tokens.css. */
    .nc-wrap { min-height: calc(100dvh - 140px); display: grid; place-items: center; padding: 32px 16px; }
    .nc-card { width: min(440px, 100%); text-align: center; padding: 32px 28px 26px; border-radius: 22px; background: var(--surface, #fff);
               border: 1px solid var(--line, #e7e5e4); box-shadow: var(--shadow-lg, 0 8px 32px -8px rgba(0,0,0,.16)); color: var(--ink, #1c1917);
               animation: nc-in .32s var(--ease-spring, cubic-bezier(.2,.9,.3,1.2)); }
    .nc-card h2 { font-size: 21px; font-weight: 680; letter-spacing: -.01em; margin: 14px 0 6px; line-height: 1.25; }
    .nc-sub { font-size: 14.5px; color: var(--ink-3, #78716c); line-height: 1.5; margin: 0 auto 18px; max-width: 36ch; }
    .nc-sub b { color: var(--ink, #1c1917); font-weight: 650; }
    .nc-badge { width: 60px; height: 60px; margin: 0 auto; border-radius: 18px; display: grid; place-items: center;
                background: var(--accent-soft, #e4f4ea); color: var(--accent-ink, #1c7a44); }
    .nc-badge svg { width: 28px; height: 28px; }
    .nc-badge.ok { border-radius: 50%; background: var(--success-soft, #f0f9f4); color: var(--success, #2e9d6b); animation: nc-pop .45s var(--ease-spring, ease-out); }
    .nc-badge.warn { background: var(--danger-soft, #fdecea); color: var(--danger, #c0392b); }
    .nc-rows { margin: 0 0 18px; border-radius: 14px; background: var(--surface-sunken, #f5f5f4); text-align: left; overflow: hidden; }
    .nc-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 14px; font-size: 14px; }
    .nc-row + .nc-row { border-top: 1px solid var(--line, #e7e5e4); }
    .nc-row dt { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-3, #78716c); }
    .nc-row dt svg { width: 16px; height: 16px; }
    .nc-row dd { margin: 0; font-weight: 620; color: var(--ink, #1c1917); text-align: right; overflow-wrap: anywhere; }
    .nc-note { display: flex; align-items: flex-start; gap: 8px; text-align: left; font-size: 13.5px; line-height: 1.45; padding: 10px 12px;
               border-radius: 12px; margin: 0 0 16px; background: var(--surface-sunken, #f5f5f4); color: var(--ink-2, #44403c); }
    .nc-note.warn { background: var(--danger-soft, #fdecea); color: var(--danger, #c0392b); }
    .nc-note svg { width: 16px; height: 16px; flex: none; margin-top: 2px; }
    .nc-actions { display: flex; flex-direction: column; gap: 10px; }
    .nc-btn { height: 46px; border-radius: 12px; font-size: 15px; font-weight: 650; border: 0; cursor: pointer; transition: transform .15s var(--ease-spring, ease-out), background .15s, opacity .15s; }
    .nc-btn:active { transform: scale(.98); }
    .nc-btn:disabled { opacity: .6; cursor: default; }
    .nc-btn.primary { background: var(--accent, #2e9e5b); color: #fff; }
    .nc-btn.primary:hover:not(:disabled) { background: var(--accent-hover, #278a4f); }
    .nc-btn.secondary { background: var(--surface-sunken, #f5f5f4); color: var(--ink, #1c1917); border: 1px solid var(--line, #e7e5e4); }
    .nc-btn.secondary:hover:not(:disabled) { background: var(--surface-3, #f4f2ef); }
    .nc-btn:focus-visible { outline: 2px solid var(--accent, #2e9e5b); outline-offset: 2px; }
    .nc-pill { display: inline-block; font-size: 13px; color: var(--ink-3, #78716c); padding: 6px 12px; border-radius: 999px; background: var(--surface-sunken, #f5f5f4); }
    .nc-spinner { width: 34px; height: 34px; margin: 6px auto 4px; border-radius: 50%; border: 3px solid var(--line, #e7e5e4); border-top-color: var(--accent, #2e9e5b); animation: nc-spin .8s linear infinite; }
    @@keyframes nc-spin { to { transform: rotate(360deg); } }
    @@keyframes nc-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
    @@keyframes nc-pop { from { transform: scale(.6); opacity: 0; } }
    @@media (prefers-reduced-motion: reduce) { .nc-card, .nc-badge.ok { animation: none; } .nc-spinner { animation-duration: 2.4s; } }
</style>

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    [SupplyParameterFromQuery(Name = "request")] public string? Request { get; set; }

    public sealed record RequestInfo(string PcName, DateTime CreatedAt, int AgeSeconds, bool SameAddress, bool Expired, string State, bool Switching);
    private sealed record LinkStatus(bool Connected, string? Name, bool Known);
    private enum View { Loading, Card, Waiting, Connected, Message }

    /// The tab waits this long for the app to confirm after Connect.
    private static readonly TimeSpan AppAnswer = TimeSpan.FromSeconds(60);
    private View state = View.Loading;
    private RequestInfo? info;
    private DateTime loadedAt;
    private bool busy, opened, closing, messageWarn;
    private string? error, connectedName, messageTitle, messageText;
    private string messageIcon = "info";
    private readonly CancellationTokenSource gone = new();
    private Timer? tick;

    protected override async Task OnInitializedAsync()
    {
        Layout?.SetHeader("iPop Notifier");
        try { opened = await JS.InvokeAsync<bool>("ipop.notifierLink.openedTab"); } catch { opened = false; }
        if (Request is not { Length: 43 })
        {
            Show("Link incomplete", "This link is incomplete. Click Sign in with browser in iPop Notifier again.", "link-2-off", warn: true);
            return;
        }
        await Auth.LoadMeAsync();
        var r = await Auth.GetResultAsync<RequestInfo>("/api/notifier/link/request/" + Uri.EscapeDataString(Request));
        if (r.IsGone) { ShowExpired(); return; }
        if (!r.IsOk || r.Value is null)
        {
            Show("Couldn't load", "iPop couldn't load this request. Check your connection, then click Sign in with browser in iPop Notifier again.", "wifi-off", warn: true);
            return;
        }
        info = r.Value;
        loadedAt = DateTime.UtcNow;
        switch (info.State)
        {
            case "expired": ShowExpired(); return;
            case "denied": Show("Cancelled", "This request was cancelled. Click Sign in with browser in iPop Notifier to try again.", "x"); return;
            case "used": Show("Already answered", "This request was already answered. Click Sign in with browser in iPop Notifier again.", "info"); return;
            case "approved": state = View.Waiting; _ = WaitConnectedAsync(); return;
        }
        state = View.Card;
        // "Requested 1 min ago" moves on, and the card turns into "expired" at 2 minutes.
        tick = new Timer(_ => InvokeAsync(() =>
        {
            if (state == View.Card && info is not null && info.AgeSeconds + (DateTime.UtcNow - loadedAt).TotalSeconds > 120 && !busy) ShowExpired();
            StateHasChanged();
        }), null, 10_000, 10_000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try { await JS.InvokeVoidAsync("ipop.icons"); } catch { }
    }

    private string Ago()
    {
        if (info is null) return "";
        var s = info.AgeSeconds + (int)(DateTime.UtcNow - loadedAt).TotalSeconds;
        return s < 45 ? "just now" : s < 90 ? "1 min ago" : $"{Math.Max(2, s / 60)} min ago";
    }

    private static string Display(string? name) => IPop.Application.PersonName.Display(name ?? "");

    private void ShowExpired() =>
        Show("Request expired", "This request expired. Click Sign in with browser in iPop Notifier again.", "clock", warn: true);

    private void Show(string title, string text, string icon, bool warn = false)
    {
        tick?.Dispose(); tick = null;
        state = View.Message; messageTitle = title; messageText = text; messageIcon = icon; messageWarn = warn;
    }

    private async Task Connect()
    {
        if (busy || Request is null) return;
        busy = true; error = null;
        try
        {
            using var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifier/link/approve", new { request = Request });
            if (res.IsSuccessStatusCode) { tick?.Dispose(); tick = null; state = View.Waiting; StateHasChanged(); await WaitConnectedAsync(); return; }
            switch ((int)res.StatusCode)
            {
                case 410: case 404: ShowExpired(); break;
                case 403: error = "Open this page on the PC where iPop Notifier is waiting."; break;
                case 409: Show("Already answered", "This request was already answered. Click Sign in with browser in iPop Notifier again.", "info"); break;
                default: error = "Couldn't connect right now. Try again."; break;
            }
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException) { error = "Couldn't reach iPop. Check your connection and try again."; }
        finally { busy = false; }
    }

    private async Task Cancel()
    {
        if (busy || Request is null) return;
        busy = true;
        try { using var _ = await Auth.SendAsync(HttpMethod.Post, "/api/notifier/link/deny", new { request = Request }); }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException) { }
        finally { busy = false; }
        if (opened) { Show("Cancelled", "iPop Notifier was not connected. You can close this tab.", "x"); return; }
        Toasts.Show("iPop Notifier was not connected", ToastKind.Info);
        GoBack();
    }

    /// The app redeems the code and confirms with its new session (after its own "Switch account?" prompt, if any).
    private async Task WaitConnectedAsync()
    {
        var until = DateTime.UtcNow + AppAnswer;
        try
        {
            while (DateTime.UtcNow < until && !gone.IsCancellationRequested)
            {
                await Task.Delay(1000, gone.Token);
                var st = await Auth.GetAsync<LinkStatus>("/api/notifier/link/status?request=" + Uri.EscapeDataString(Request!), gone.Token);
                if (st is not { Connected: true }) continue;
                connectedName = st.Name;
                await DoneAsync();
                return;
            }
        }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            Show("Not confirmed", "iPop Notifier didn't confirm the sign-in. Check the app on this PC; if it asked to switch accounts and you chose No, nothing changed.", "circle-help", warn: true);
            StateHasChanged();
        });
    }

    private async Task DoneAsync()
    {
        if (!opened)
        {
            // A tab the person was already using: back to where they were, with a small toast.
            Toasts.Show("iPop Notifier connected", ToastKind.Success);
            GoBack();
            return;
        }
        state = View.Connected; closing = true;
        await InvokeAsync(StateHasChanged);
        try { await Task.Delay(2000, gone.Token); } catch (OperationCanceledException) { return; }
        var closed = false;
        try { closed = await JS.InvokeAsync<bool>("ipop.notifierLink.close"); } catch { }
        if (closed) return;
        // The browser keeps tabs a script didn't open (e.g. after the login redirect): back to iPop instead.
        await Task.Delay(400);
        Nav.NavigateTo("/dashboard", replace: true);
    }

    private async Task Leave()
    {
        if (!opened) { GoBack(); return; }
        var closed = false;
        try { closed = await JS.InvokeAsync<bool>("ipop.notifierLink.close"); } catch { }
        if (!closed) Nav.NavigateTo("/dashboard", replace: true);
    }

    private void GoBack() => Nav.NavigateTo(Link.TakeBackUrl() ?? "/dashboard", replace: true);

    public void Dispose()
    {
        gone.Cancel();
        tick?.Dispose();
    }
}
