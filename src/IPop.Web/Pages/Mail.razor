                                {
                                    <span class="badge mute" style="font-size:10px;padding:2px 7px">Low Importance</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* Quick reply: hidden until the user picks Quick Reply; sits above the thread, right under the subject *@
                @if (replyOpen)
                {
                    <div class="inline-reply-box qr-top" id="mail-quick-reply">
