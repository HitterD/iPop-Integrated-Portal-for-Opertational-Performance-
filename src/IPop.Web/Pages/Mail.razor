    // ── Search & Keyboard ──
    private async Task OnSearch(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        cts?.Cancel(); cts?.Dispose();
        var t = new CancellationTokenSource(); cts = t;
        await Task.Delay(250);
        if (t.IsCancellationRequested) return;
        await LoadPage(1);
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (moreMenuOpen && e.Key is "Escape")
        {
            moreMenuOpen = false;
            StateHasChanged();
            return;
        }
        if (composerOpen) return;
        if (e.Key is "c" or "C")
        {
            OpenComposer();
        }
    }

    // ── Composer & Quick Reply ──
    private void OpenComposer(
        Guid? inReplyTo = null,
        Guid? threadRoot = null,
        string? initialSubject = null,
        string? initialBody = null,
        List<MemberSearchRow>? initialTo = null)
    {
        composerRef?.OpenNew(inReplyTo, threadRoot, initialSubject, initialBody, initialTo);
        composerOpen = true;
    }

    private void ReplyMessage(MailDetail d)
    {
        var to = new List<MemberSearchRow> { new(d.SenderNik, d.SenderName, null, null) };
        var subj = d.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? d.Subject : $"Re: {d.Subject}";
        var bodyQuote = $"<p><br/></p>{QuoteOf(d)}";
        OpenComposer(inReplyTo: d.Id, threadRoot: d.ThreadRootId ?? d.Id, initialSubject: subj, initialBody: bodyQuote, initialTo: to);
    }

    private void ReplyAllMessage(MailDetail d)
    {
        var myNik = Auth.Me?.Nik ?? "";
        var to = new List<MemberSearchRow> { new(d.SenderNik, d.SenderName, null, null) };
        foreach (var r in d.Recipients.Where(r => r.RecipientType == "to" && !r.Nik.Equals(myNik, StringComparison.OrdinalIgnoreCase) && !r.Nik.Equals(d.SenderNik, StringComparison.OrdinalIgnoreCase)))
        {
            to.Add(new(r.Nik, r.Name, null, null));
        }

        var cc = d.Recipients
            .Where(r => r.RecipientType == "cc" && !r.Nik.Equals(myNik, StringComparison.OrdinalIgnoreCase))
            .Select(r => new MemberSearchRow(r.Nik, r.Name, null, null))
            .ToList();

        var subj = d.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? d.Subject : $"Re: {d.Subject}";
        var bodyQuote = $"<p><br/></p>{QuoteOf(d)}";
        composerRef?.OpenNew(inReplyTo: d.Id, threadRoot: d.ThreadRootId ?? d.Id, initialSubject: subj, initialBody: bodyQuote, initialTo: to);
        if (composerRef != null && cc.Count > 0)
        {
            // set CC rows
            composerRef.SetCcRows(cc);
        }
        composerOpen = true;
    }

    private async Task ToggleMuteThread(Guid mailId)
    {
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/mail/{mailId}/mute");
        if (res.IsSuccessStatusCode)
        {
            var r = await res.Content.ReadFromJsonAsync<MuteResponseDto>();
            if (detail != null && detail.Id == mailId)
            {
                detail = detail with { IsMuted = r?.Muted ?? !detail.IsMuted };
            }
            Toasts.Show((r?.Muted ?? false) ? "Thread notifications muted." : "Thread notifications unmuted.", ToastKind.Success);
            await LoadPage(page);
        }
    }

