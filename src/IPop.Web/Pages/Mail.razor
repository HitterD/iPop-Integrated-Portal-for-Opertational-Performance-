@page "/mail"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@using IPop.Web.Components
@using IPop.Web.Components.Mail
@using IPop.Web.Services

@inject NavigationManager Nav
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.ConfirmService Confirm
@inject HttpClient Http
@inject IPop.Web.Services.MailService MailSvc

<PageTitle>Mail — IPop</PageTitle>


<div class="mail-page" @onkeydown="OnKeyDown" tabindex="0">
    @* ============ TOOLBAR (Segmented Filter + Ghost Actions) ============ *@
    <div class="toolbar">
        <div class="tabs">
            <button type="button" class="tab @(tabFilter == "all" ? "active" : "")" @onclick='() => SetTabFilter("all")'>
                <i data-lucide="inbox"></i>
                <span>All</span>
                <span class="n">@AllCount</span>
            </button>
            <button type="button" class="tab @(tabFilter == "unread" ? "active" : "")" @onclick='() => SetTabFilter("unread")'>
                <i data-lucide="mail"></i>
                <span>Unread</span>
                <span class="n">@UnreadCount</span>
            </button>
            <button type="button" class="tab @(tabFilter == "starred" ? "active" : "")" @onclick='() => SetTabFilter("starred")'>
                <i data-lucide="star"></i>
                <span>Starred</span>
                <span class="n">@StarredCount</span>
            </button>
        </div>

        <div class="actions" style="margin-left:auto;display:flex;align-items:center;gap:8px">
            @* Bulk actions only while messages are checked — the reader carries per-message actions. *@
            @if (selected.Count > 0)
            {
            <button type="button" class="ghost-btn" disabled="@(!CanArchive)" @onclick="ToolbarArchive" title="Archive">
                <i data-lucide="archive"></i>
                <span>Archive</span>
            </button>
            <button type="button" class="ghost-btn" disabled="@(!CanDelete)" @onclick="ToolbarDelete" title="Delete">
                <i data-lucide="trash-2"></i>
                <span>Delete</span>
            </button>
            <button type="button" class="ghost-btn" disabled="@(!CanMarkRead)" @onclick="ToolbarMarkRead" title="Mark read">
                <i data-lucide="check-check"></i>
                <span>Mark read</span>
            </button>
            }
            <div class="v6-search">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search mail or sender" aria-label="Search mail or sender" value="@search" @oninput="OnSearch" />
            </div>
            <button type="button" class="icon-btn" title="Sync mailbox" aria-label="Sync mailbox" @onclick="ReloadAll">
                <i data-lucide="refresh-cw"></i>
            </button>
            <button type="button" class="btn-dark" @onclick="() => OpenComposer()">
                <i data-lucide="square-pen"></i>
                <span>Compose</span>
            </button>
        </div>
    </div>

    @* ============ 3-PANE CARDS LAYOUT ============ *@
    <div class="mail-area">
        @* ============ PANE 1: FOLDERS CARD ============ *@
        <div class="card mail-card mail-folders">
            <div class="card-head">
                <div>
                    <div class="card-title">Mailboxes</div>
                    <div class="card-meta">@(Auth.Me?.Email ?? $"{Folders.Length} folders")</div>
                </div>
            </div>

            <div class="tree">
                @foreach (var f in Folders)
                {
                    var folder = f;
                    var badge = FolderBadge(folder);
                    <button type="button"
                            class="tree-node @(activeFolder == folder ? "on" : "")"
                            aria-current="@(activeFolder == folder ? "page" : null)"
                            title="@FolderLabel(folder)"
                            aria-label="@FolderLabel(folder)"
                            @onclick="() => SelectFolder(folder)">
                        <i data-lucide="@(FolderIcon(folder))"></i>
                        <span class="lbl">@FolderLabel(folder)</span>
                        @if (badge > 0)
                        {
                            <span class="tree-n @(folder == MailFolder.Inbox ? "unread-accent" : "")">@badge</span>
                        }
                    </button>
                }

                <div class="tree-site" style="margin-top:10px">Labels</div>
                @if (DisplayLabels.Count == 0)
                {
                    <div class="empty-labels" style="padding:4px 10px;font-size:11.5px;color:var(--ink-4)">No labels</div>
                }
                else
                {
                    @foreach (var l in DisplayLabels)
                    {
                        var lbl = l;
                        var isLabelActive = labelFilter == lbl.Name;
                        <button type="button"
                                class="tree-node @(isLabelActive ? "on" : "")"
                                title="@lbl.Name"
                                aria-label="@lbl.Name"
                                @onclick="() => ToggleLabelFilter(lbl.Name)">
                            <span class="label-dot" style="background:@lbl.Color"></span>
                            <span class="lbl">@lbl.Name</span>
                            @if (lbl.Count > 0)
                            {
                                <span class="tree-n">@lbl.Count</span>
                            }
                        </button>
                    }
                }
            </div>

            <div class="folders-foot">
                <button type="button" class="ghost-btn" style="width:100%;justify-content:center;font-size:12px" @onclick='() => Nav.NavigateTo("/mail/advanced")' title="Mail settings">
                    <i data-lucide="settings"></i>
                    <span class="lbl">Mail settings</span>
                </button>
            </div>
        </div>

        @* ============ PANE 2: MESSAGES LIST CARD ============ *@
        <div class="card mail-card mail-list-card">
            <div class="card-head" style="justify-content:space-between">
                <div class="flex center gap-8">
                    <span class="cbx @(allSelected ? "on" : "")"
                          @onclick="ToggleSelectAll"
                          role="checkbox"
                          aria-checked="@allSelected"
                          tabindex="0"
                          title="Select all"
                          aria-label="Select all">
                        <i data-lucide="check"></i>
                    </span>
                    <span class="card-title">@FolderLabel(activeFolder)</span>
                    @if (NewCount > 0)
                    {
                        <span class="v6-new-pill">@NewCount new</span>
                    }
                </div>
                <div class="flex center gap-6">
                    @if (activeFolder == MailFolder.Trash && Items.Count > 0)
                    {
                        <button type="button" class="btn btn-sm surface" style="color:var(--danger);font-size:11.5px;padding:3px 8px" @onclick="ConfirmEmptyTrash">
                            <i data-lucide="trash-2" style="width:12px;height:12px"></i> Empty Trash
                        </button>
                    }
                    <button type="button" class="icon-btn @(advSearchOpen ? "on" : "")" title="Advanced filter" aria-label="Advanced filter" @onclick="() => advSearchOpen = !advSearchOpen">
                        <i data-lucide="list-filter"></i>
                    </button>
                </div>
            </div>

            @* Filter banner (Active query or label filter) *@
            @if (AdvancedActive || !string.IsNullOrWhiteSpace(search) || labelFilter is not null)
            {
                <div class="mail-search-banner">
                    <i data-lucide="search" style="width:13px;height:13px;color:var(--accent-ink)"></i>
                    <span>
                        Showing @Items.Count results
                        @if (!string.IsNullOrWhiteSpace(search)) { <text> for "@search"</text> }
                        @if (labelFilter is not null) { <span class="label-chip" style="margin-left:4px"><span class="label-dot" style="background:@LabelInk(labelFilter)"></span>@labelFilter</span> }
                    </span>
                    <button type="button" class="btn-sm surface" style="margin-left:auto;padding:2px 10px;font-size:11px" @onclick="ResetAdvancedSearch">
                        <i data-lucide="rotate-ccw" style="width:11px;height:11px"></i> Reset
                    </button>
                </div>
            }

            @* Advanced Filter Panel *@
            @if (advSearchOpen)
            {
                <div class="mail-adv-panel">
                    <div class="mail-adv-grid">
                        <input class="org-input" placeholder="From (name/NIK)…" @bind="advFrom" />
                        <input class="org-input" placeholder="Subject or content keywords…" @bind="advQuery" />
                        <div class="mail-adv-row">
                            <label>From date</label>
                            <input type="date" class="org-input" @bind="advDateFrom" />
                        </div>
                        <div class="mail-adv-row">
                            <label>To date</label>
                            <input type="date" class="org-input" @bind="advDateTo" />
                        </div>
                        <label class="mail-adv-check"><input type="checkbox" @bind="advHasAttachment" /> Has attachment</label>
                        <select class="filter-select" @bind="advLabel">
                            <option value="">(All labels)</option>
                            @foreach (var lbl in AvailableLabels)
                            {
                                <option value="@lbl">@lbl</option>
                            }
                        </select>
                    </div>
                    <div class="mail-adv-actions">
                        <button type="button" class="btn-sm accent" @onclick="ApplyAdvancedSearch"><i data-lucide="search" style="width:12px;height:12px"></i> Apply</button>
                        <button type="button" class="btn-sm surface" @onclick="ResetAdvancedSearch"><i data-lucide="rotate-ccw" style="width:12px;height:12px"></i> Reset</button>
                    </div>
                </div>
            }

            @* Bulk Selection Bar *@
            @if (Items.Count > 0 && selected.Count > 0)
            {
                <div class="bulk-bar" aria-label="Bulk actions">
                    <span class="bulk-count">@selected.Count selected</span>
                    <button type="button" class="comp-btn" title="Export selected as PDF" disabled="@bulkExporting" @onclick="BulkExportPdf"><i data-lucide="file-down"></i></button>
                    @if (activeFolder == MailFolder.Trash)
                    {
                        <button type="button" class="comp-btn" title="Restore to inbox" @onclick="BulkRestore"><i data-lucide="inbox"></i> Restore</button>
                        <button type="button" class="comp-btn danger" title="Delete permanently" @onclick="BulkPermanent"><i data-lucide="trash"></i> Delete permanently</button>
                    }
                    else
                    {
                        <button type="button" class="comp-btn" title="Archive" @onclick="() => BulkMove(MailFolder.Archive)"><i data-lucide="archive"></i></button>
                        <button type="button" class="comp-btn" title="Trash" @onclick="() => BulkMove(MailFolder.Trash)"><i data-lucide="trash-2"></i></button>
                        <button type="button" class="comp-btn" title="Star" @onclick="BulkStar" @onclick:stopPropagation><i data-lucide="star"></i></button>
                    }
                </div>
            }

            @* Messages List *@
            <div class="mail-rows" role="list" aria-label="Mail list">
                @if (loading && Items.Count == 0)
                {
                    <div class="list-skeleton"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div>
                }
                else if (Items.Count == 0)
                {
                    <div class="empty-state" style="padding:40px 20px;text-align:center;color:var(--ink-3);">
                        <i data-lucide="@(FolderEmptyIcon(activeFolder))" style="width:36px;height:36px;margin-bottom:10px;opacity:0.5"></i>
                        <div class="title" style="font-weight:700;font-size:14px;color:var(--ink);">Nothing in @FolderLabel(activeFolder)</div>
                        <div class="sub" style="font-size:12px;margin-top:4px;">Messages land here. Press C to compose a new message.</div>
                    </div>
                }
                else
                {
                    @foreach (var it in Items)
                    {
                        var item = it;
                        var isSel = selected.Contains(item.Id);
                        <div class="mail-row @(item.IsRead ? "" : "unread") @(item.IsPinned ? "pinned" : "") @(selectedMail == item.Id ? "sel" : "")"
                             role="listitem"
                             aria-selected="@isSel"
                             @onclick="() => OpenDetail(item.Id)">

                            @* Line 1: Checkbox, Importance, Pin, Sender, Time, Quick Actions *@
                            <div class="m-l1">
                                <span class="cbx @(isSel ? "on" : "")"
                                      @onclick="() => ToggleSelect(item.Id)"
                                      @onclick:stopPropagation
                                      role="checkbox"
                                      aria-checked="@isSel"
                                      tabindex="0"
                                      title="Select message"
                                      aria-label="Select message">
                                    <i data-lucide="check"></i>
                                </span>

                                @if (item.IsPinned)
                                {
                                    <span class="pin-badge" title="Pinned to top"><i data-lucide="pin"></i></span>
                                }
                                @if (item.IsMuted)
                                {
                                    <span class="mute-badge" title="Thread muted" style="color:var(--ink-3);margin-right:4px"><i data-lucide="bell-off" style="width:12px;height:12px"></i></span>
                                }

                                @if (item.Importance == "high")
                                {
                                    <span class="imp-tag high" title="High Importance"><i data-lucide="alert-circle"></i></span>
                                }
                                else if (item.Importance == "low")
                                {
                                    <span class="imp-tag low" title="Low Importance"><i data-lucide="arrow-down"></i></span>
                                }

                                <span class="m-from">@item.SenderName</span>
                                <span class="m-time">@FormatTime(item.ReceivedAt)</span>

                                @* Hover quick actions *@
                                <div class="mail-row-actions" @onclick:stopPropagation>
                                    @if (activeFolder == MailFolder.Sent)
                                    {
                                        <button type="button" title="Recall message" aria-label="Recall message" @onclick="() => ConfirmRecall(item.Id)">
                                            <i data-lucide="undo-2"></i>
                                        </button>
                                    }
                                    <button type="button" title="Delete" aria-label="Delete" @onclick="() => QuickDelete(item.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                    <button type="button" class="@(item.IsPinned ? "active" : "")" title="@(item.IsPinned ? "Unpin" : "Pin")" aria-label="@(item.IsPinned ? "Unpin" : "Pin")" @onclick="() => TogglePin(item.Id)">
                                        <i data-lucide="pin"></i>
                                    </button>
                                    <button type="button" class="@(item.IsStarred ? "active" : "")" title="@(item.IsStarred ? "Unstar" : "Star")" aria-label="@(item.IsStarred ? "Unstar" : "Star")" @onclick="() => ToggleStar(item.Id)">
                                        <i data-lucide="star"></i>
                                    </button>
                                    <button type="button" title="@(item.IsRead ? "Mark unread" : "Mark read")" aria-label="@(item.IsRead ? "Mark unread" : "Mark read")" @onclick="() => QuickToggleRead(item)">
                                        <i data-lucide="@(item.IsRead ? "mail-x" : "mail-check")"></i>
                                    </button>
                                </div>
                            </div>

                            @* Line 2: Subject *@
                            <div class="m-l2">
                                <span class="m-subj">@item.Subject</span>
                            </div>

                            @* Line 3: Snippet & Labels & Attachment clip *@
                            <div class="m-l3">
                                <span class="m-snip">@item.Snippet</span>
                                @if (item.Labels is { Count: > 0 })
                                {
                                    @foreach (var lbl in item.Labels.Take(3))
                                    {
                                        <span class="label-chip"><span class="label-dot" style="background:@LabelInk(lbl)"></span>@lbl</span>
                                    }
                                }
                                @if (item.HasAttachment)
                                {
                                    <span class="m-clip" title="Has attachment"><i data-lucide="paperclip"></i></span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* Pager replacement: Load more footer *@
            <div class="list-foot">
                <span class="foot-count">Showing @Items.Count of @pageTotal messages</span>
                @if (HasMore)
                {
                    <span class="foot-sep">·</span>
                    <button type="button" class="load-more-btn" @onclick="LoadMore" disabled="@loadingMore">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                }
            </div>
        </div>

        @* ============ PANE 3: READING CARD ============ *@
        <div class="card mail-card mail-detail-card">
            @if (detail is null)
            {
                <div class="empty-state">
                    <i data-lucide="mail-open"></i>
                    <div class="empty-title">Select a message</div>
                    <div class="empty-sub">Choose an email from the list to read it, reply, or forward.</div>
                </div>
            }
            else
            {
                @* Reading pane action bar *@
                <div class="card-head detail-actions-bar">
                    <button type="button" class="icon-btn mobile-back-btn" title="Back to messages" aria-label="Back to messages" @onclick="BackToList">
                        <i data-lucide="arrow-left"></i>
                    </button>
                    <button type="button" class="btn-primary-reply" @onclick="() => ReplyMessage(detail)">
                        <i data-lucide="reply"></i>
                        <span>Reply</span>
                    </button>
                    <button type="button" class="ghost-btn" @onclick="() => ReplyAllMessage(detail)">
                        <i data-lucide="reply-all"></i>
                        <span>Reply all</span>
                    </button>
                    <button type="button" class="ghost-btn" @onclick="() => ForwardMessage(detail)">
                        <i data-lucide="forward"></i>
                        <span>Forward</span>
                    </button>
                    <button type="button" class="icon-btn" title="Archive" aria-label="Archive" @onclick="() => MoveDetail(MailFolder.Archive)">
                        <i data-lucide="archive"></i>
                    </button>
                    <button type="button" class="icon-btn" title="Delete" aria-label="Delete" @onclick="() => MoveDetail(MailFolder.Trash)">
                        <i data-lucide="trash-2"></i>
                    </button>
                    <button type="button" class="icon-btn @(detail.IsStarred ? "star-active" : "")" title="@(detail.IsStarred ? "Starred" : "Star")" aria-label="@(detail.IsStarred ? "Starred" : "Star")" @onclick="() => ToggleStar(detail.Id)">
                        <i data-lucide="star"></i>
                    </button>
                    <button type="button" class="icon-btn" title="Export PDF" aria-label="Export PDF" @onclick="ExportPdf">
                        <i data-lucide="file-down"></i>
                    </button>
                    <button type="button" class="icon-btn" title="Print" aria-label="Print" disabled="@printing" @onclick="PrintDirect">
                        <i data-lucide="printer"></i>
                    </button>

                    @* More options menu (Pin, Mark unread, Move to Junk, Previews) *@
                    <div class="more-menu-wrap" style="position:relative;margin-left:auto">
                        <button type="button" class="icon-btn @(moreMenuOpen ? "on" : "")" title="More options" aria-label="More options" @onclick="ToggleMoreMenu">
                            <i data-lucide="more-horizontal"></i>
                        </button>
                        @if (moreMenuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => moreMenuOpen = false"></div>
                            <div class="more-dropdown" role="menu" @onclick:stopPropagation>
                                <button type="button" class="more-item" @onclick="async () => { moreMenuOpen = false; await TogglePin(detail.Id); }">
                                    <i data-lucide="pin"></i>
                                    <span>@(detail.IsPinned ? "Unpin" : "Pin")</span>
                                </button>
                                <button type="button" class="more-item" @onclick="async () => { moreMenuOpen = false; await ToggleMuteThread(detail.Id); }">
                                    <i data-lucide="@(detail.IsMuted ? "bell" : "bell-off")"></i>
                                    <span>@(detail.IsMuted ? "Unmute thread" : "Mute thread")</span>
                                </button>
                                <button type="button" class="more-item" @onclick="async () => { moreMenuOpen = false; await MarkUnread(detail.Id); }">
                                    <i data-lucide="mail-x"></i>
                                    <span>Mark as unread</span>
                                </button>
                                <button type="button" class="more-item" @onclick="async () => { moreMenuOpen = false; await MoveToJunk(); }">
                                    <i data-lucide="trash"></i>
                                    <span>Move to Junk</span>
                                </button>
                                <button type="button" class="more-item" @onclick="async () => { moreMenuOpen = false; await PreviewPdf(); }">
                                    <i data-lucide="file-search"></i>
                                    <span>Preview PDF</span>
                                </button>
                                <button type="button" class="more-item" @onclick="() => { moreMenuOpen = false; ToggleHtmlPreview(); }">
                                    <i data-lucide="eye"></i>
                                    <span>Preview as recipient</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @* Sender info block *@
                <div class="detail-sender-block">
                    <div class="sender-top">
                        <div class="av-wrap">
                            <div class="av @AvatarClass(detail.SenderNik)">
                                @Initials(detail.SenderName)
                            </div>
                            <span class="presence @SenderPresence(detail.SenderNik)"></span>
                        </div>
                        <div class="sender-details">
                            <div class="sender-row">
                                <span class="sender-name">
                                    @detail.SenderName
                                    <span class="mono sender-id">ID @detail.SenderNik</span>
                                </span>
                                <span class="sender-date">@FormatDetailDate(detail.SentAt ?? detail.ScheduledAt)</span>
                            </div>
                            <div class="sender-to">
                                To: <span class="recipients-names">@RecipientsShort</span>
                                @if (!string.IsNullOrWhiteSpace(CcShort))
                                {
                                    <text> · Cc: <span class="recipients-names">@CcShort</span></text>
                                }
                                @if (detail.IsRead)
                                {
                                    <span class="read-marker"> · read</span>
                                }
                            </div>
                            <div class="sender-subject-row">
                                <h2 class="detail-subject">@detail.Subject</h2>
                                @if (detail.Importance == "high")
                                {
                                    <span class="badge bad" style="font-size:10px;padding:2px 7px">High Importance</span>
                                }
                                else if (detail.Importance == "low")
                                {
                                    <span class="badge mute" style="font-size:10px;padding:2px 7px">Low Importance</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* Scheduled Send Alert Banner *@
                @if (detail.Folder == "scheduled" || (detail.ScheduledAt.HasValue && detail.SentAt == null))
                {
                    <div class="scheduled-banner">
                        <div class="sched-info">
                            <i data-lucide="calendar-clock"></i>
                            <span>Scheduled for delivery on <b>@(detail.ScheduledAt?.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm") ?? "Scheduled")</b></span>
                        </div>
                        <div class="sched-actions">
                            <button type="button" class="sched-btn primary" @onclick="() => SendScheduledNow(detail.Id)">Send now</button>
                            <button type="button" class="sched-btn" @onclick="() => PromptReschedule(detail.Id)">Reschedule</button>
                            <button type="button" class="sched-btn" @onclick="() => CancelScheduleAndEdit(detail)">Cancel &amp; Edit</button>
                            <button type="button" class="sched-btn" @onclick="() => MoveDetail(MailFolder.Trash)">Delete</button>
                        </div>
                    </div>
                }

                @* Meeting RSVP Banner *@
                @if (meetingForDetail is not null)
                {
                    <MeetingRsvpPanel
                        Meeting="@(new MeetingRsvpPanel.MeetingModel(meetingForDetail.Id, meetingForDetail.Title, meetingForDetail.StartAt, meetingForDetail.EndAt, meetingForDetail.Location, meetingForDetail.Link))"
                        CurrentResponse="@meetingForDetail.MyResponse"
                        ShowSummary="@(meetingForDetail.OrganizerNik == Auth.Me?.Nik)"
                        Attendees="@(meetingForDetail.Attendees.Select(a => new MeetingRsvpPanel.AttendeeModel(a.Name, a.RsvpStatus)).ToList())"
                        OnRespond="OnRsvpRespond" />
                }

                @* Detail Scroll Area: Body + Attachments or Conversation Stack *@
                <div class="detail-scroll-area">
                    @* Linked Projects chip row if any *@
                    @if (detail.LinkedProjects.Count > 0)
                    {
                        <div class="linked-projects-row">
                            <span class="linked-title"><i data-lucide="kanban"></i> Projects:</span>
                            @foreach (var p in detail.LinkedProjects)
                            {
                                <span class="badge info" title="Progress: @p.Progress%">@p.Name</span>
                            }
                        </div>
                    }

                    @if (hasConversation)
                    {
                        <MailThreadStack @ref="threadStackRef"
                                         Detail="detail"
                                         OnReply="ReplyMessage"
                                         OnForward="ForwardMessage" />
                    }
                    else
                    {
                        <div class="body">@((MarkupString)detail.Body)</div>

                        @if (detail.Attachments.Count > 0)
                        {
                            <div class="detail-att-section">
                                <div class="att-head">Attachments (@detail.Attachments.Count @(detail.Attachments.Count == 1 ? "file" : "files"))</div>
                                <div class="att-chips">
                                    @foreach (var a in detail.Attachments)
                                    {
                                        var att = a;
                                        <button type="button" class="att" @onclick="() => Download(att)">
                                            <i data-lucide="paperclip"></i>
                                            <span class="name">@att.FileName</span>
                                            <span class="size">@HumanSize(att.FileSize)</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>

                @* Inline Quick Reply Box *@
                <div class="inline-reply-box">
                    <div class="rh">
                        <i data-lucide="reply"></i>
                        <span class="title">Reply to @detail.SenderName</span>
                        <button type="button" class="icon-btn" style="margin-left:auto;width:24px;height:24px" title="Open in composer" aria-label="Open in composer" @onclick="() => ReplyMessage(detail)">
                            <i data-lucide="maximize-2" style="width:13px;height:13px"></i>
                        </button>
                    </div>
                    <textarea rows="2"
                              placeholder="Write a reply…"
                              @bind="quickReplyText"></textarea>
                    <div class="ra">
                        <button type="button" class="btn-primary" @onclick="SendQuickReply" disabled="@(quickReplySending || string.IsNullOrWhiteSpace(quickReplyText))">
                            <i data-lucide="send"></i>
                            @(quickReplySending ? "Sending…" : "Send")
                        </button>
                        <button type="button" class="ghost-btn" title="Attach files in the full composer" @onclick="() => ReplyMessage(detail)">
                            <i data-lucide="paperclip"></i>
                            <span>Attach</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ============ FLOATING DOCKED COMPOSER ============ *@
<MailComposer @ref="composerRef"
              IsOpen="@composerOpen"
              IsOpenChanged="v => composerOpen = v"
              OnSent="OnComposerSent"
              OnDiscard="ReloadAll" />

