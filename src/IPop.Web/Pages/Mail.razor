            <i data-lucide="file-search"></i> <span>PDF Preview — @detail?.Subject</span>
            <span style="margin-left:auto;display:flex;gap:6px">
                <button type="button" class="btn-sm surface" disabled="@(pdfPreviewUrl is null)" @onclick="DownloadPdfPreview"><i data-lucide="download" style="width:13px;height:13px"></i> Download</button>
                <button type="button" class="btn-sm surface" disabled="@(pdfPreviewUrl is null)" @onclick="PrintPdfPreview"><i data-lucide="printer" style="width:13px;height:13px"></i> Print</button>
                <button type="button" class="btn-sm accent" @onclick="ExportPdf"><i data-lucide="file-down" style="width:13px;height:13px"></i> Export</button>
                <button type="button" class="btn-sm surface" @onclick="ClosePdfPreview"><i data-lucide="x" style="width:13px;height:13px"></i> Close</button>
            </span>
        </div>
        @if (pdfPreviewLoading)
        {
            <div class="pdf-preview-body" style="display:flex;align-items:center;justify-content:center;color:var(--ink-3);font-size:13px">
                <i data-lucide="loader-circle" style="width:18px;height:18px;margin-right:8px"></i> Preparing preview…
            </div>
        }
        else if (pdfPreviewUrl is not null)
        {
            <iframe id="preview-frame" class="pdf-preview-body" src="@($"{pdfPreviewUrl}#page={pdfPage}")" title="PDF preview"></iframe>
            <div class="pdf-preview-nav">
                <button type="button" class="btn-sm surface" disabled="@(pdfPage <= 1)" @onclick="() => pdfPage--" title="Previous page" aria-label="Previous page">
                    <i data-lucide="chevron-left" style="width:13px;height:13px"></i>
                </button>
                <span style="font-size:12px;color:var(--ink-2)">Page @pdfPage</span>
                <button type="button" class="btn-sm surface" @onclick="() => pdfPage++" title="Next page" aria-label="Next page">
                    <i data-lucide="chevron-right" style="width:13px;height:13px"></i>
                </button>
            </div>
        }
        else
        {
            <div class="pdf-preview-body" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--ink-3)">
                <i data-lucide="file-x" style="width:22px;height:22px"></i>
                <span style="font-size:13px">Preview unavailable — message may be empty or failed to render.</span>
            </div>
        }
    </div>
}

@* ---- HTML Preview Overlay ---- *@
@if (htmlPreviewOpen && detail is not null)
{
    <div class="backdrop on" @onclick="CloseHtmlPreview"></div>
    <div class="pdf-preview-overlay" role="dialog" aria-modal="true" aria-label="HTML preview">
        <div class="pdf-preview-bar">
            <i data-lucide="eye"></i> <span>HTML Preview — @detail.Subject</span>
            <span style="margin-left:auto;display:flex;gap:6px">
                <button type="button" class="btn-sm surface" @onclick="CloseHtmlPreview"><i data-lucide="x" style="width:13px;height:13px"></i> Close</button>
            </span>
        </div>
        <div class="pdf-preview-body mail-html-preview">
            <div class="mail-html-card">
                <div class="mail-html-head">
                    <div class="subj">@(string.IsNullOrWhiteSpace(detail.Subject) ? "(no subject)" : detail.Subject)</div>
                    <div class="meta">
                        <span><strong>From:</strong> @detail.SenderName</span>
                        <span><strong>To:</strong> @string.Join(", ", detail.Recipients.Where(r => r.RecipientType == "to").Select(r => r.Name))</span>
