    /// true = every selected message has it, false = none, null = some.
    private bool? BulkLabelState(MailLabel lbl)
    {
        var rows = Items.Where(m => selected.Contains(m.Id)).ToList();
        if (rows.Count == 0) return false;
        var n = rows.Count(m => m.Labels?.Contains(lbl.Name, StringComparer.OrdinalIgnoreCase) == true);
        return n == 0 ? false : n == rows.Count ? true : null;
    }

    private async Task BulkToggleLabel(MailLabel lbl)
    {
        if (selected.Count == 0 || labelBusy) return;
        // Mixed or none → apply to all; all → remove from all.
        var on = BulkLabelState(lbl) != true;
        labelBusy = true;
        try
        {
            var failed = 0;
            foreach (var id in selected.ToList())
                if (!await MailSvc.SetLabelAsync(id, lbl.Id, on)) failed++;
            if (failed > 0) Toasts.Show($"The label could not be changed on {failed} message(s).", ToastKind.Error);
            else Toasts.Show(on ? $"Labelled \"{lbl.Name}\"." : $"Removed label \"{lbl.Name}\".", ToastKind.Success);
            if (detail is not null && selected.Contains(detail.Id)) await ReloadDetail();
            await AfterLabelsChanged();
        }
        finally { labelBusy = false; StateHasChanged(); }
    }

