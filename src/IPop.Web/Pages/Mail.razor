@page "/mail"
@implements IDisposable
@inject IJSRuntime JS
@inject NotificationState Notifs
@inject AuthState Auth
@inject IPop.Web.Services.MailSeen MailSeenReporter
@using IPop.Web.Components
@using IPop.Web.Components.Mail
@using IPop.Web.Services

@inject NavigationManager Nav
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.ConfirmService Confirm
@inject HttpClient Http
@inject IPop.Web.Services.MailService MailSvc
@inject IPop.Web.Services.MailComposerHost ComposerHost
@inject IPop.Web.Services.PeopleLinks PLinks
@inject IPop.Web.Services.CalendarLinks CalLinks
@inject IPop.Web.Services.PageCache Cache
@inject IPop.Web.Services.MailReadingPrefs Prefs

<PageTitle>Mail — IPop</PageTitle>


<div class="mail-page mlx @(detail is not null ? "m-detail" : "") @(mFolderSheet ? "m-folders-open" : "")">
    @* Outlook-style surface (mockup docs/mockups/mail-layout-outlook.html v3): Mailboxes | list | reading pane joined
       as one sheet under the topbar, hairline splitters between them (js/mail-layout.js owns widths + the rail). *@
    <div class="mlx-surf @(selected.Count > 0 ? "has-selection" : "")" data-mlx-surf>
        @if (mFolderSheet)
        {
            <div class="mlx-sheetdim" @onclick="() => mFolderSheet = false"></div>
        }

        @* ============ PANE 1: MAILBOXES (full + icon rail) ============ *@
        <section class="mlx-pane mlx-box" aria-label="Mailboxes">
            <div class="mlx-full">
                <button type="button" class="mlx-compose" @onclick="() => { mFolderSheet = false; OpenComposer(); }">
                    <i data-lucide="square-pen"></i><span>New mail</span>
                </button>
                <div class="mlx-bxh">
                    <div class="mlx-bxt"><b>Mailboxes</b><small>@(Auth.Me?.Email ?? "")</small></div>
                    <button type="button" class="mlx-ib mlx-collapse" data-mlx-act="collapse" title="Collapse mailboxes" aria-label="Collapse mailboxes"><i data-lucide="chevron-left"></i></button>
                    <button type="button" class="mlx-ib m-sheet-x" title="Close" aria-label="Close mailboxes" @onclick="() => mFolderSheet = false"><i data-lucide="x"></i></button>
                </div>
                <div class="mlx-tree">
                    @foreach (var f in Folders)
                    {
                        var folder = f;
                        var badge = FolderBadge(folder);
                        <button type="button" class="mlx-tn @(activeFolder == folder && labelFilter is null ? "on" : "")"
                                aria-current="@(activeFolder == folder && labelFilter is null ? "page" : null)" title="@FolderLabel(folder)"
                                @onclick="() => SelectFolder(folder)">
                            <i data-lucide="@(FolderIcon(folder))"></i>
                            <span class="lbl">@FolderLabel(folder)</span>
                            @if (badge > 0) { <span class="mlx-n @(folder == MailFolder.Inbox ? "acc" : "")">@badge.ToString("N0")</span> }
                        </button>
                    }
                    <div class="mlx-tsec">Labels
                        <button type="button" class="mlx-ib" title="New label" aria-label="New label" @onclick='() => OpenSettings("labels")'><i data-lucide="plus"></i></button>
                    </div>
                    @if (DisplayLabels.Count == 0)
                    {
                        <div class="mlx-empty">No labels</div>
                    }
                    @foreach (var l in DisplayLabels)
                    {
                        var lbl = l;
                        var isEpop = MailEpop.IsImported([lbl.Name]);
                        <button type="button" class="mlx-tn @(labelFilter == lbl.Name ? "on" : "")" title="@lbl.Name" @onclick="() => ToggleLabelFilter(lbl.Name)">
                            @if (isEpop) { <i data-lucide="archive"></i> } else { <span class="mlx-ldot" style="background:@lbl.Color"></span> }
                            <span class="lbl">@lbl.Name</span>
                            @if (lbl.Count > 0) { <span class="mlx-n">@lbl.Count.ToString("N0")</span> }
                        </button>
                    }
                </div>
                <div class="mlx-foot">
                    @SettingsMenu
                    <button type="button" class="mlx-setbtn @(settingsMenuOpen ? "on" : "")" aria-haspopup="menu" aria-expanded="@(settingsMenuOpen ? "true" : "false")" @onclick="() => settingsMenuOpen = !settingsMenuOpen">
                        <i data-lucide="settings"></i><span>Mail settings</span>
                    </button>
                </div>
            </div>
            <div class="mlx-rail">
                <button type="button" class="mlx-rb" data-mlx-act="expand" title="Show mailboxes" aria-label="Show mailboxes"><i data-lucide="chevron-right"></i></button>
                <button type="button" class="mlx-rc" title="New mail" aria-label="New mail" @onclick="() => OpenComposer()"><i data-lucide="square-pen"></i></button>
                @foreach (var f in Folders)
                {
                    var folder = f;
                    var badge = FolderBadge(folder);
                    <button type="button" class="mlx-rb @(activeFolder == folder && labelFilter is null ? "on" : "")" title="@RailTitle(folder, badge)" aria-label="@FolderLabel(folder)" @onclick="() => SelectFolder(folder)">
                        <i data-lucide="@(FolderIcon(folder))"></i>
                        @if (badge > 0 && folder is MailFolder.Inbox or MailFolder.Draft) { <span class="mlx-rbd">@(badge > 99 ? "99+" : badge.ToString())</span> }
                    </button>
                }
                @if (DisplayLabels.Count > 0) { <hr /> }
                @foreach (var l in DisplayLabels.Where(x => !MailEpop.IsImported([x.Name])).Take(6))
                {
                    var lbl = l;
                    <button type="button" class="mlx-rl @(labelFilter == lbl.Name ? "on" : "")" title="Label · @lbl.Name" aria-label="Label @lbl.Name" @onclick="() => ToggleLabelFilter(lbl.Name)"><span class="mlx-ldot" style="background:@lbl.Color"></span></button>
                }
                <span class="mlx-sp"></span>
                <span class="mlx-railset">
                    @SettingsMenu
                    <button type="button" class="mlx-rb @(settingsMenuOpen ? "on" : "")" title="Mail settings" aria-label="Mail settings" aria-haspopup="menu" @onclick="() => settingsMenuOpen = !settingsMenuOpen"><i data-lucide="settings"></i></button>
                </span>
            </div>
        </section>

        @* ============ PANE 2: MESSAGE LIST ============ *@
        <section class="mlx-pane mlx-list" aria-label="Messages">
            <div class="mlx-lh">
                <div class="mlx-tt">
                    <span class="cbx mlx-all @(allSelected ? "on" : selected.Count > 0 ? "mid" : "")" @onclick="ToggleSelectAll" @onkeydown="OnCheckKey"
                          role="checkbox" aria-checked="@(allSelected ? "true" : selected.Count > 0 ? "mixed" : "false")" tabindex="0" title="Select all" aria-label="Select all">
                        <i data-lucide="check"></i>
                    </span>
                    @* Phone: the Mailboxes column is a sheet; this opens it. *@
                    <button type="button" class="mlx-fbtn" aria-haspopup="dialog" aria-expanded="@(mFolderSheet ? "true" : "false")" @onclick="() => mFolderSheet = true">
                        <i data-lucide="chevron-left"></i><span>Mailboxes</span>
                    </button>
                    <b class="mlx-title">@ListTitle</b>
                    <small class="mlx-count">@AllCount.ToString("N0")</small>
                    @if (NewCount > 0 && activeFolder == MailFolder.Inbox) { <span class="mlx-new">@NewCount new</span> }
                </div>
                <div class="mlx-search-wrap">
                    <label class="mlx-search" @onkeydown="OnSearchKey">
                        <i data-lucide="search"></i>
                        <input type="search" placeholder="Search mail" aria-label="Search mail" value="@search" @oninput="OnSearch" />
                        <button type="button" class="mlx-fl @(advSearchOpen || AdvancedActive || tabFilter != "all" ? "on" : "")" title="Filters" aria-label="Filters" aria-expanded="@(advSearchOpen ? "true" : "false")" @onclick="() => advSearchOpen = !advSearchOpen">
                            <i data-lucide="list-filter"></i>
                            @if (AdvancedCount + (tabFilter != "all" ? 1 : 0) > 0) { <span class="v6-search-filter-n">@(AdvancedCount + (tabFilter != "all" ? 1 : 0))</span> }
                        </button>
                    </label>
                    @if (advSearchOpen)
                    {
                        <div class="mlx-catch" @onclick="() => advSearchOpen = false"></div>
                        <div class="mail-filter-pop" role="dialog" aria-label="Filter mail" @onkeydown="OnFilterKey">
                            <div class="mfp-head">
                                <span>Filter</span>
                                <button type="button" class="mfp-x" aria-label="Close" @onclick="() => advSearchOpen = false"><i data-lucide="x"></i></button>
                            </div>
                            <div class="mfp-field">
                                <span>Show</span>
                                <div class="mfp-chips">
                                    <button type="button" class="mfp-chip @(tabFilter == "all" ? "on" : "")" @onclick='() => SetTabFilter("all")'>All <small>@AllCount</small></button>
                                    <button type="button" class="mfp-chip @(tabFilter == "unread" ? "on" : "")" @onclick='() => SetTabFilter("unread")'>Unread <small>@UnreadCount</small></button>
                                    <button type="button" class="mfp-chip @(tabFilter == "starred" ? "on" : "")" @onclick='() => SetTabFilter("starred")'>Starred <small>@StarredCount</small></button>
                                </div>
                            </div>
                            <label class="mfp-field">
                                <span>From</span>
                                <input type="text" placeholder="Name of the sender" @bind="advFrom" @bind:event="oninput" />
                            </label>
                            <label class="mfp-field">
                                <span>Contains</span>
                                <input type="text" placeholder="Subject or words in the message" @bind="advQuery" @bind:event="oninput" />
                            </label>
                            <div class="mfp-field">
                                <span>Date</span>
                                <div class="mfp-chips">
                                    <button type="button" class="mfp-chip @(DatePreset == "7" ? "on" : "")" @onclick='() => SetDatePreset("7")'>Last 7 days</button>
                                    <button type="button" class="mfp-chip @(DatePreset == "30" ? "on" : "")" @onclick='() => SetDatePreset("30")'>Last 30 days</button>
                                    <button type="button" class="mfp-chip @(DatePreset == "year" ? "on" : "")" @onclick='() => SetDatePreset("year")'>This year</button>
                                </div>
                                <div class="mfp-dates">
                                    <AppDatePicker @bind-Value="advDateFrom" AllowClear="true" AriaLabel="From date" />
                                    <span class="mfp-to">to</span>
                                    <AppDatePicker @bind-Value="advDateTo" AllowClear="true" AriaLabel="To date" />
                                </div>
                            </div>
                            <div class="mfp-field">
                                <span>Show only</span>
                                <div class="mfp-chips">
                                    <button type="button" class="mfp-chip @(advHasAttachment ? "on" : "")" aria-pressed="@(advHasAttachment ? "true" : "false")" @onclick="() => advHasAttachment = !advHasAttachment">
                                        <i data-lucide="paperclip"></i> Has attachment
                                    </button>
                                </div>
                            </div>
                            @if (DisplayLabels.Count > 0)
                            {
                                <div class="mfp-field">
                                    <span>Label</span>
                                    <div class="mfp-chips">
                                        @foreach (var l in DisplayLabels)
                                        {
                                            var name = l.Name;
                                            <button type="button" class="mfp-chip @(advLabel == name ? "on" : "")" aria-pressed="@(advLabel == name ? "true" : "false")" @onclick='() => advLabel = advLabel == name ? "" : name'>
                                                <span class="label-dot" style="background:@l.Color"></span>@name
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="mfp-foot">
                                <button type="button" class="mfp-link" disabled="@(!AdvancedActive && string.IsNullOrWhiteSpace(search) && tabFilter == "all")" @onclick="ClearFilters">Clear all</button>
                                <button type="button" class="mfp-apply" @onclick="ApplyFilters">Show results</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" class="mlx-ib mlx-refresh" title="Sync mailbox" aria-label="Sync mailbox" @onclick="ReloadAll"><i data-lucide="refresh-cw"></i></button>

                @if (Items.Count > 0 && selected.Count > 0)
                {
                    <div class="mlx-lsel" aria-label="Bulk actions">
                        <b>@selected.Count selected</b>
                        <button type="button" title="Mark read" @onclick="ToolbarMarkRead"><i data-lucide="mail-open"></i><span>Mark read</span></button>
                        @if (activeFolder == MailFolder.Trash)
                        {
                            <button type="button" title="Restore to Inbox" @onclick="BulkRestore"><i data-lucide="inbox"></i><span>Restore</span></button>
                            <button type="button" class="danger" title="Delete forever (cannot be undone)" @onclick="BulkPermanent"><i data-lucide="trash"></i><span>Delete forever</span></button>
                        }
                        else
                        {
                            @if (activeFolder == MailFolder.Archive)
                            {
                                <button type="button" title="Move to Inbox" @onclick="() => BulkMove(MailFolder.Inbox)"><i data-lucide="inbox"></i><span>Inbox</span></button>
                            }
                            else
                            {
                                <button type="button" title="Archive" aria-label="Archive" @onclick="() => BulkMove(MailFolder.Archive)"><i data-lucide="archive"></i><span>Archive</span></button>
                            }
                            <button type="button" title="Move to Trash" aria-label="Move to Trash" @onclick="() => BulkMove(MailFolder.Trash)"><i data-lucide="trash-2"></i><span>Delete</span></button>
                            <button type="button" title="Star" aria-label="Star" @onclick="BulkStar" @onclick:stopPropagation><i data-lucide="star"></i></button>
                            <span class="mlx-lblwrap">
                                <button type="button" class="@(bulkLabelOpen ? "on" : "")" title="Label" aria-label="Label" aria-haspopup="menu"
                                        aria-expanded="@(bulkLabelOpen ? "true" : "false")" @onclick="() => { bulkLabelOpen = !bulkLabelOpen; labelMenuOpen = false; }"><i data-lucide="tag"></i></button>
                                @if (bulkLabelOpen)
                                {
                                    <div class="mlx-catch" @onclick="() => bulkLabelOpen = false"></div>
                                    <div class="mlx-pop mlx-lpop mlx-bulklpop" role="menu" aria-label="Label selected messages" @onclick:stopPropagation>
                                        <div class="mlx-mhd">Label @selected.Count selected</div>
                                        @foreach (var l in serverLabels.Where(x => !MailEpop.IsImported([x.Name])))
                                        {
                                            var lbl = l;
                                            var state = BulkLabelState(lbl);
                                            <button type="button" class="mlx-lo" role="menuitemcheckbox" aria-checked="@(state == true ? "true" : state is null ? "mixed" : "false")"
                                                    disabled="@labelBusy" @onclick="() => BulkToggleLabel(lbl)">
                                                <span class="cbx @(state == true ? "on" : state is null ? "mid" : "")"><i data-lucide="check"></i></span>
                                                <span class="mlx-ldot" style="background:@lbl.Color"></span><span>@lbl.Name</span>
                                            </button>
                                        }
                                        <button type="button" class="mlx-nl" @onclick='() => { bulkLabelOpen = false; OpenSettings("labels"); }'><i data-lucide="plus"></i>New label…</button>
                                    </div>
                                }
                            </span>
                            <button type="button" title="Export selected as PDF" aria-label="Export selected as PDF" disabled="@bulkExporting" @onclick="BulkExportPdf"><i data-lucide="file-down"></i></button>
                        }
                    </div>
                }
            </div>

            @if (activeFolder == MailFolder.Trash)
            {
                <div class="mlx-trash" role="note">
                    <i data-lucide="info"></i>
                    <span>Deleting a message from Trash removes it forever. Use Restore to move it back to Inbox.</span>
                    @if (Items.Count > 0)
                    {
                        <button type="button" class="mlx-linkbtn" @onclick="ConfirmEmptyTrash">Empty Trash</button>
                    }
                </div>
            }

            @if (AdvancedActive || !string.IsNullOrWhiteSpace(search) || labelFilter is not null || tabFilter != "all")
            {
                <div class="mlx-banner">
                    <i data-lucide="search"></i>
                    <span>
                        Showing @Items.Count of @pageTotal @(pageTotal == 1 ? "result" : "results")
                        @if (!string.IsNullOrWhiteSpace(search)) { <text> for "@search"</text> }
                        @if (tabFilter != "all") { <text> · @(tabFilter == "unread" ? "Unread" : "Starred")</text> }
                        @if (labelFilter is not null) { <span class="mlr-chip k1" style="--c:@LabelColor(labelFilter);margin-left:4px"><i></i><span>@labelFilter</span></span> }
                    </span>
                    <button type="button" class="mlx-linkbtn" @onclick="ResetAdvancedSearch"><i data-lucide="rotate-ccw"></i> Reset</button>
                </div>
            }

            <div class="mlx-rows @(density == MailListDensity.Comfortable ? "mlx-comfy" : "")" role="list" aria-label="@ListTitle">
                @if (loading && Items.Count == 0)
                {
                    <div class="list-skeleton"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div>
                }
                else if (Items.Count == 0)
                {
                    <div class="mlx-empty-list">
                        <i data-lucide="@(FolderEmptyIcon(activeFolder))"></i>
                        <b>Nothing in @ListTitle</b>
                        <span>Messages land here. Press C to write a new mail.</span>
                    </div>
                }
                else
                {
                    string? lastDay = null;
                    @foreach (var it in Items)
                    {
                        var item = it;
                        var day = DayGroup(item.ReceivedAt ?? item.ScheduledAt);
                        if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="mlx-day" @key="@("day-" + day)">@day</div>
                        }
                        <MailListRow @key="item.Id" Item="item" Comfortable="@(density == MailListDensity.Comfortable)"
                                     Selected="@(selectedMail == item.Id)" Checked="@selected.Contains(item.Id)"
                                     ExtraClass="@(returningIds.Contains(item.Id) ? "mi-returning" : null)"
                                     Time="@FormatTime(item.ReceivedAt ?? item.ScheduledAt)" LabelColor="LabelColor" Highlight="Hl"
                                     OnOpen="OpenDetail" OnCheck="ToggleSelect" Actions="RowActions(item)" />
                    }
                }
            </div>

            @* Phone: write a new mail from the list (the Mailboxes column is a sheet there). *@
            <button type="button" class="mlx-fab" title="New mail" aria-label="New mail" @onclick="() => OpenComposer()"><i data-lucide="square-pen"></i></button>
            <div class="mlx-lfoot">
                <span>Showing @Items.Count of @pageTotal.ToString("N0")</span>
                @if (HasMore)
                {
                    <button type="button" class="mlx-more" @onclick="LoadMore" disabled="@loadingMore">@(loadingMore ? "Loading…" : "Load more")</button>
                }
                <span class="mlx-synced">Synced @lastSyncedTime</span>
            </div>
        </section>

        @* ============ PANE 3: READING PANE ============ *@
        <section class="mlx-pane mlx-read" aria-label="Reading pane">
            @if (detail is null)
            {
                <div class="mlx-noread">
                    <i data-lucide="mail-open"></i>
                    <b>Select a message</b>
                    <span>Choose a mail from the list to read it, reply or forward.</span>
                </div>
            }
            else
            {
                var target = ActionTarget;
                var canReply = detail.Folder is not ("draft" or "scheduled");
                @* Phone: back + prev/next + archive/delete on top; Reply · Reply all · Forward · More at the bottom. *@
                <div class="mlx-phead">
                    <button type="button" class="mlx-back" aria-label="Back to @ListTitle" @onclick="MobileBackClick"><i data-lucide="chevron-left"></i><span>@ListTitle</span></button>
                    <span class="mlx-sp"></span>
                    <button type="button" class="mlx-pb" aria-label="Previous message" disabled="@(SelectedIndex <= 0)" @onclick="() => StepDetail(-1)"><i data-lucide="chevron-up"></i></button>
                    <button type="button" class="mlx-pb" aria-label="Next message" disabled="@(SelectedIndex < 0 || SelectedIndex >= Items.Count - 1)" @onclick="() => StepDetail(1)"><i data-lucide="chevron-down"></i></button>
                    @if (DetailFolder != "trash")
                    {
                        <button type="button" class="mlx-pb" aria-label="Archive" @onclick="() => MoveDetail(MailFolder.Archive)"><i data-lucide="archive"></i></button>
                    }
                    <button type="button" class="mlx-pb" aria-label="@(DetailFolder == "trash" ? "Delete forever" : "Delete")" @onclick="() => MoveDetail(MailFolder.Trash)"><i data-lucide="trash-2"></i></button>
                </div>

                <div class="mlx-rbar" role="toolbar" aria-label="Message actions">
                    @if (canReply)
                    {
                        <button type="button" class="mlx-pbtn" title="Reply (R)" @onclick="() => ToolbarReply(false)"><i data-lucide="reply"></i><span class="mlx-lb">Reply</span></button>
                        <button type="button" class="mlx-pbtn all" title="@(target.CanReplyAll ? "Reply all (A)" : "Reply all is turned off for mass mail")" @onclick="() => ToolbarReply(true)"><i data-lucide="reply-all"></i><span class="mlx-lb">Reply all</span></button>
                        <button type="button" class="mlx-pbtn fwd" title="Forward (F)" @onclick="() => ForwardMessage(target)"><i data-lucide="forward"></i><span class="mlx-lb">Forward</span></button>
                        <span class="mlx-vsep"></span>
                    }
                    @if (DetailFolder == "trash")
                    {
                        <button type="button" class="mlx-qbtn" title="Restore to Inbox" aria-label="Restore to Inbox" @onclick="RestoreDetail"><i data-lucide="inbox"></i></button>
                        <button type="button" class="mlx-qbtn del" title="Delete forever (cannot be undone)" aria-label="Delete forever" @onclick="DeleteDetailForever"><i data-lucide="trash-2"></i></button>
                    }
                    else
                    {
                        @if (DetailFolder == "archive")
                        {
                            <button type="button" class="mlx-qbtn" title="Move to Inbox" aria-label="Move to Inbox" @onclick="() => MoveDetail(MailFolder.Inbox)"><i data-lucide="inbox"></i></button>
                        }
                        else
                        {
                            <button type="button" class="mlx-qbtn" title="Archive (E)" aria-label="Archive" @onclick="() => MoveDetail(MailFolder.Archive)"><i data-lucide="archive"></i></button>
                        }
                        <button type="button" class="mlx-qbtn del" title="Delete (Del)" aria-label="Delete" @onclick="() => MoveDetail(MailFolder.Trash)"><i data-lucide="trash-2"></i></button>
                    }
                    <button type="button" class="mlx-qbtn @(detail.IsStarred ? "star" : "")" title="@(detail.IsStarred ? "Unstar" : "Star")" aria-label="@(detail.IsStarred ? "Unstar" : "Star")" aria-pressed="@(detail.IsStarred ? "true" : "false")" @onclick="() => ToggleStar(detail.Id)"><i data-lucide="star"></i></button>
                    <span class="mlx-mwrap">
                        <button type="button" class="mlx-qbtn @(moreMenuOpen ? "on" : "")" title="More" aria-label="More" aria-haspopup="menu" aria-expanded="@(moreMenuOpen ? "true" : "false")" @onclick="ToggleMoreMenu"><i data-lucide="more-horizontal"></i></button>
                        @if (moreMenuOpen)
                        {
                            <div class="mlx-catch" @onclick="() => moreMenuOpen = false"></div>
                            <div class="mlx-pop mlx-menu" role="menu" @onclick:stopPropagation>
                                <a class="mlx-mi" role="menuitem" href="@MeetingFromMail(detail)" @onclick="() => moreMenuOpen = false"><i data-lucide="calendar-plus"></i><span>Schedule meeting</span></a>
                                <button type="button" class="mlx-mi" role="menuitem" @onclick="async () => { moreMenuOpen = false; await MarkUnread(detail.Id); }"><i data-lucide="mail"></i><span>Mark unread</span></button>
                                <button type="button" class="mlx-mi" role="menuitem" @onclick="() => { moreMenuOpen = false; labelMenuOpen = true; }"><i data-lucide="tag"></i><span>Label…</span><kbd>L</kbd></button>
                                <button type="button" class="mlx-mi" role="menuitem" @onclick="async () => { moreMenuOpen = false; await TogglePin(detail.Id); }"><i data-lucide="pin"></i><span>@(detail.IsPinned ? "Unpin" : "Pin to top")</span></button>
                                <button type="button" class="mlx-mi" role="menuitem" @onclick="async () => { moreMenuOpen = false; await ToggleMuteThread(detail.Id); }"><i data-lucide="@(detail.IsMuted ? "bell" : "bell-off")"></i><span>@(detail.IsMuted ? "Unmute thread" : "Mute thread")</span></button>
                                <div class="mlx-msep" role="separator"></div>
                                <button type="button" class="mlx-mi" role="menuitem" disabled="@printing" @onclick="async () => { moreMenuOpen = false; await PrintDirect(); }"><i data-lucide="printer"></i><span>Print</span></button>
                                <button type="button" class="mlx-mi" role="menuitem" @onclick="async () => { moreMenuOpen = false; await ExportPdf(); }"><i data-lucide="file-down"></i><span>Export PDF</span></button>
