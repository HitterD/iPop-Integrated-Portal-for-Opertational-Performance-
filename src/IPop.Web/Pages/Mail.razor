            {
                Toasts.Show($"Could not {(on ? "apply" : "remove")} the label \"{lbl.Name}\".", ToastKind.Error);
                return;
            }
            detail = detail with { LabelIds = on ? [.. detail.LabelIds, lbl.Id] : detail.LabelIds.Where(x => x != lbl.Id).ToList() };
