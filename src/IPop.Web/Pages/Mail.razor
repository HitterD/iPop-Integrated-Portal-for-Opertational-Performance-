    private async Task OpenDetail(Guid id)
    {
        selectedMail = id;
        moreMenuOpen = false; labelMenuOpen = false;
        if (selectedMail != id) { threadNewest = null; threadCountShown = 0; labelMenuOpen = false; scrollReaderTop = true; }
        detail = await MailSvc.GetAsync(id);
        if (id != selectedMail) return;
        _ = Notifs.MarkReadByTargetAsync("mail", id);

        if (activeFolder == MailFolder.Draft && detail is not null)
        {
            WithComposer(c => c.OpenDraft(detail));
            return;
        }

        if (detail?.Folder == "inbox" && !detail.IsRead)
        {
            await MailSvc.MarkReadAsync(id);
            var c = await MailSvc.GetCountsAsync();
            if (c is not null) counts = c;
            UpdateHeader();
            await LoadPage(page);
        }

        await LoadMeetingForDetail(id);
        if (_selfRef is not null && detail is not null)
            await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _selfRef, nameof(MobileBack));
        await JS.InvokeVoidAsync("ipop.icons");
        StateHasChanged();
    }

