    private record MuteResponseDto(bool Muted);

    private void ForwardMessage(MailDetail d)
    {
        var subj = d.Subject.StartsWith("Fwd:", StringComparison.OrdinalIgnoreCase) ? d.Subject : $"Fwd: {d.Subject}";
        var bodyQuote = $"<br/><br/>——— Forwarded from {d.SenderName} ———<br/>{d.Body}";
        OpenComposer(initialSubject: subj, initialBody: bodyQuote);
    }

    private async Task SendQuickReply()
    {
        if (detail is null || string.IsNullOrWhiteSpace(quickReplyText)) return;
        quickReplySending = true;
        try
        {
            var typed = System.Net.WebUtility.HtmlEncode(quickReplyText.Trim()).Replace("\n", "<br/>");
            var req = new MailSendRequest(
                Subject: detail.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase) ? detail.Subject : $"Re: {detail.Subject}",
                Body: $"<p>{typed}</p>{QuoteOf(detail)}",
                To: [detail.SenderNik],
                Cc: [],
                Bcc: [],
                InReplyToId: detail.Id,
                ThreadRootId: detail.ThreadRootId ?? detail.Id);

            var res = await MailSvc.SendAsync(req);
            if (res?.Success == true)
            {
                quickReplyText = "";
                Toasts.Show("Reply sent.");
                await ReloadDetail();
                await ReloadAll();
                if (threadStackRef is not null) await threadStackRef.ReloadAsync(expandLatest: true);
            }
        }
        finally
        {
            quickReplySending = false;
        }
    }

    private static string QuoteOf(MailDetail d)
    {
        var stamp = d.SentAt?.ToLocalTime().ToString("ddd, dd MMM yyyy 'at' HH:mm") ?? "earlier";
        return $"""
            <details class="mail-quote">
              <summary class="mail-quote-toggle" title="Show quoted message">⋯</summary>
              <div class="mail-quote-inner">
                <div class="mail-quote-attr">On {stamp}, {System.Net.WebUtility.HtmlEncode(d.SenderName)} wrote:</div>
                <blockquote>{d.Body}</blockquote>
              </div>
            </details>
            """;
    }

    private async Task OnComposerSent()
    {
        await ReloadAll();
        if (threadStackRef is not null) await threadStackRef.ReloadAsync(expandLatest: true);
    }

    private async Task<string> ResolveNameFromNikAsync(string nik)
    {
        try
        {
            var rows = await Auth.GetAsync<MemberSearchRow[]>($"/api/directory/member-search?q={Uri.EscapeDataString(nik)}");
            var hit = rows?.FirstOrDefault(r => string.Equals(r.Nik, nik, StringComparison.OrdinalIgnoreCase));
            if (hit is not null) return hit.Name;
        }
        catch { }
        return nik;
    }

    private Task RunAction(Func<Task> f)
    {
        try { return f(); }
        catch (Exception ex) { Toasts.Show(ex.Message); return Task.CompletedTask; }
    }

    private string FolderLabel(MailFolder f) => f switch
    {
        MailFolder.Inbox => "Inbox",
        MailFolder.Sent => "Sent",
        MailFolder.Draft => "Drafts",
        MailFolder.Scheduled => "Scheduled",
        MailFolder.Starred => "Starred",
        MailFolder.Archive => "Archive",
        MailFolder.Trash => "Trash",
        _ => "Inbox"
    };

    private string FolderIcon(MailFolder f) => f switch
    {
        MailFolder.Inbox => "inbox",
        MailFolder.Sent => "send",
        MailFolder.Draft => "file-text",
        MailFolder.Scheduled => "calendar-clock",
        MailFolder.Starred => "star",
        MailFolder.Archive => "archive",
        MailFolder.Trash => "trash-2",
        _ => "inbox"
    };

    private string FolderEmptyIcon(MailFolder f) => f switch
    {
        MailFolder.Draft => "file-pen-line",
        MailFolder.Scheduled => "calendar-clock",
        MailFolder.Trash => "trash",
        _ => "inbox"
    };

    private int FolderBadge(MailFolder f) => (counts, f) switch
    {
        (null, _) => 0,
        (_, MailFolder.Inbox) => counts.InboxUnread,
        (_, MailFolder.Draft) => counts.DraftTotal,
        (_, MailFolder.Scheduled) => counts.ScheduledTotal,
        (_, MailFolder.Starred) => counts.StarredTotal,
        _ => 0
    };

    private string RecipientsShort => detail is null ? "" : string.Join(", ", detail.Recipients.Where(r => r.RecipientType is "to" or "cc").Select(r => r.Name));
    private string? CcShort => detail is null ? null : string.Join(", ", detail.Recipients.Where(r => r.RecipientType == "cc").Select(r => r.Name));
    private static string Initials(string name)
        => string.Concat((name ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2)).ToUpperInvariant();

    private static string FormatTime(DateTime? t)
    {
        if (t is null) return "";
        var local = t.Value.ToLocalTime();
        if (local.Date == DateTime.Today) return local.ToString("HH:mm");
        if (local.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return local.ToString("dd MMM");
    }

    private static string FormatDetailDate(DateTime? t)
        => t is null ? "" : t.Value.ToLocalTime().ToString("ddd, dd MMM yyyy, HH:mm");

    private static string AvatarClass(string? nik)
    {
        if (string.IsNullOrEmpty(nik)) return "av-1";
        var idx = (Math.Abs(nik.GetHashCode()) % 8) + 1;
        return $"av-{idx}";
    }

    private string SenderPresence(string? nik)
    {
        if (string.IsNullOrEmpty(nik)) return "off";
        if (nik == Auth.Me?.Nik) return Auth.MyStatus;
        return "off";
    }

