    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = HandleDeeplinkIfAny();

    private async Task HandleDeeplinkIfAny()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query) || composerOpen || _lastHandledQuery == query) return;

        var parsed = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) parsed[Uri.UnescapeDataString(part)] = "";
            else parsed[Uri.UnescapeDataString(part[..eq])] = Uri.UnescapeDataString(part[(eq + 1)..]);
        }

        if (parsed.TryGetValue("settings", out var settingsVal) && settingsVal is "signature" or "ooo" or "rules" or "labels" or "templates")
        {
            _lastHandledQuery = query;
            settingsSection = settingsVal;
            StateHasChanged();
            return;
        }

        if (parsed.TryGetValue("mailId", out var mailIdStr) && Guid.TryParse(mailIdStr, out var mailId))
        {
            _lastHandledQuery = query;
            await OpenDetail(mailId);
            return;
        }

        var hasSubject = parsed.TryGetValue("shareSubject", out var s2);
        var hasBody = parsed.TryGetValue("shareBody", out var b2);
        if (hasSubject || hasBody)
        {
            _lastHandledQuery = query;
            OpenComposer(initialSubject: s2, initialBody: b2);
            return;
        }

        // mailto: links in chat/mail (links.js) → iPop's own composer. Recipients are iPop users
        // (NIK-based), so the address is looked up; an outside address can't be mailed from iPop.
        if (parsed.TryGetValue("toEmail", out var toEmail) && !string.IsNullOrWhiteSpace(toEmail))
        {
            _lastHandledQuery = query;
            toEmail = toEmail.Trim();
            var hit = await FindUserByEmailAsync(toEmail);
            if (hit is not null)
                OpenComposer(initialTo: [new MemberSearchRow(hit.Nik, hit.Name, null, null)]);
            else
            {
                OpenComposer();
                Toasts.Show($"{toEmail} isn't an iPop user — iPop Mail only reaches iPop accounts.", ToastKind.Warning);
            }
            return;
        }

        var hasCompose = parsed.TryGetValue("compose", out var composeVal);
        var hasTo = parsed.TryGetValue("to", out var toVal);

        if (hasCompose || hasTo)
        {
            _lastHandledQuery = query;
            var toList = new List<string>();

            if (hasTo && !string.IsNullOrWhiteSpace(toVal))
            {
                toList.AddRange(PLinks.Niks(toVal));
            }
            if (hasCompose && !string.IsNullOrWhiteSpace(composeVal) && composeVal != "1")
            {
                var composeNik = PLinks.Nik(composeVal)!;
                if (!toList.Contains(composeNik, StringComparer.OrdinalIgnoreCase))
                    toList.Add(composeNik);
            }

            if (toList.Count > 0)
            {
                var rows = new List<MemberSearchRow>();
                foreach (var nik in toList)
                {
                    var name = await ResolveNameFromNikAsync(nik);
                    rows.Add(new MemberSearchRow(nik, name, null, null));
                }
                OpenComposer(initialTo: rows);
            }
            else
            {
                OpenComposer();
            }
            return;
        }
    }

