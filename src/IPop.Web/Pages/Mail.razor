@code {
    private static readonly MailFolder[] Folders =
    [
        MailFolder.Inbox, MailFolder.Sent, MailFolder.Draft, MailFolder.Scheduled, MailFolder.Starred, MailFolder.Archive, MailFolder.Trash
    ];

    private MailFolder activeFolder = MailFolder.Inbox;
    private string tabFilter = "all"; // "all", "unread", "starred"
    private string? labelFilter;
    private List<MailSummary> Items = [];
    private MailDetail? detail;
    private MailCounts? counts;
    private List<MailLabel> serverLabels = [];
    private int page = 1, pageSize = 25, pageTotal;
    private bool loading;
    private bool loadingMore;
    private string search = "";
    private readonly HashSet<Guid> selected = [];
    private Guid? selectedMail;
    private CancellationTokenSource? cts;
    private string lastSyncedTime = DateTime.Now.ToString("HH:mm");

    private MailComposer? composerRef => ComposerHost.Instance;

    private static readonly (string[] Keys, string What)[] KbdShortcuts =
    [
        (["C"], "New message"),
        (["R"], "Reply (quick reply under the newest message)"),
        (["A"], "Reply all"),
        (["F"], "Forward"),
        (["E"], "Archive"),
        (["L"], "Label…"),
        (["Del"], "Move to Trash (in Trash: delete forever, asks first)"),
        (["J"], "Next message"),
        (["K"], "Previous message"),
        (["Ctrl", "Enter"], "Send (in composer)"),
        (["Ctrl", "K"], "Insert link (in composer)"),
        (["Esc"], "Close menu / minimise composer"),
        (["?"], "Show this list"),
    ];
    private MailThreadStack? threadStackRef;
    private bool composerOpen;
    private bool moreMenuOpen;
    private bool _navSubscribed;
    private string? _lastHandledQuery;

    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    // ── Outlook layout (mockup mail-layout-outlook.html v3) ──

    /// The newest message of the open conversation (top of the thread): what the toolbar and slim header act on.
    private MailDetail? threadNewest;
    private int threadCountShown;
    private MailDetail ActionTarget => threadNewest is { } n && detail is not null && SameThread(n, detail) ? n : detail!;
    private static bool SameThread(MailDetail a, MailDetail b) => (a.ThreadRootId ?? a.Id) == (b.ThreadRootId ?? b.Id);

    private Task OnThreadNewest(MailDetail n)
    {
        threadNewest = n;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string RailTitle(MailFolder f, int badge) => badge > 0 ? $"{FolderLabel(f)} · {badge}" : FolderLabel(f);

    private string SubjectText => string.IsNullOrWhiteSpace(detail?.Subject) ? "(no subject)" : detail!.Subject;
    private string ListTitle => labelFilter ?? FolderLabel(activeFolder);
    private int SelectedIndex => selectedMail is { } id ? Items.FindIndex(m => m.Id == id) : -1;

    /// Toolbar Reply / Reply all (and R / A): the quick reply under the newest message, in that mode.
    private async Task ToolbarReply(bool all)
    {
        if (detail is null) return;
        if (threadStackRef is not null) await threadStackRef.OpenQuickReplyAsync(null, all);
        else if (all) ReplyAllMessage(ActionTarget);
        else ReplyMessage(ActionTarget);
    }

    // List density: Compact (2 lines) by default, Comfortable (3 lines) — per user per device.
    private string density = MailListDensity.Compact;
    private bool scrollReaderTop;

    private async Task SetDensity(string d)
    {
        density = MailListDensity.Parse(d);
        await Auth.SetUserSettingAsync(MailListDensity.Key, density);
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private void OnCheckKey(KeyboardEventArgs e) { if (e.Key is " " or "Enter") ToggleSelectAll(); }

    /// Label colour by name: the user's own label colours, a stable fallback otherwise.
    private string LabelColor(string name)
        => serverLabels.FirstOrDefault(l => l.Name.Equals(name, StringComparison.OrdinalIgnoreCase))?.Color ?? LabelInk(name);

    /// The open mail's labels as chips (the EPop archive label is the icon, not a chip).
    private IReadOnlyList<MailLabel> DetailLabels => detail is null ? []
        : serverLabels.Where(l => detail.LabelIds.Contains(l.Id) && !MailEpop.IsImported([l.Name])).ToList();

    private string labelQuery = "";
    private IReadOnlyList<MailLabel> LabelChoices => serverLabels
        .Where(l => !MailEpop.IsImported([l.Name]))
        .Where(l => string.IsNullOrWhiteSpace(labelQuery) || l.Name.Contains(labelQuery.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();

    private void ToggleLabelPop()
    {
        labelMenuOpen = !labelMenuOpen;
        moreMenuOpen = false;
        labelQuery = "";
        if (labelMenuOpen) _ = JS.InvokeVoidAsync("ipop.focusById", "mlx-label-find").AsTask().ContinueWith(_ => { });
    }

    private void CloseLabelPop() { labelMenuOpen = false; labelQuery = ""; }
    private void OnLabelPopKey(KeyboardEventArgs e) { if (e.Key == "Escape") CloseLabelPop(); }

    private async Task OnLabelFindKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var exact = serverLabels.FirstOrDefault(l => l.Name.Equals(labelQuery.Trim(), StringComparison.OrdinalIgnoreCase));
        if (exact is not null) await ToggleDetailLabel(exact);
        else if (LabelChoices.Count == 1) await ToggleDetailLabel(LabelChoices[0]);
        else await CreateLabelFromPop();
    }

    private static readonly string[] NewLabelColors = ["#0a84ff", "#2e9e5b", "#ff9f0a", "#af52de", "#14a3a3", "#ff375f", "#8e8e93"];

    /// "+ Label" → "Create “X”": the label is created and applied to this mail. Empty search opens Manage labels.
    private async Task CreateLabelFromPop()
    {
        var name = labelQuery.Trim();
        if (name.Length == 0) { CloseLabelPop(); OpenSettings("labels"); return; }
        if (detail is null || labelBusy) return;
        labelBusy = true;
        try
        {
            var color = NewLabelColors[serverLabels.Count % NewLabelColors.Length];
            var created = await MailSvc.CreateLabelAsync(name, color);
            if (created is null) { Toasts.Show("Could not add the label. The name may already exist.", ToastKind.Error); return; }
            if (!await MailSvc.SetLabelAsync(detail.Id, created.Id, true)) { Toasts.Show($"Could not apply the label “{name}”.", ToastKind.Error); return; }
            detail = detail with { LabelIds = [.. detail.LabelIds, created.Id] };
            labelQuery = "";
            await AfterLabelsChanged();
        }
        finally { labelBusy = false; StateHasChanged(); }
    }

    /// Day groups in the list: Today · Yesterday · This week · Earlier.
    private static string DayGroup(DateTime? t)
    {
        if (t is null) return "Earlier";
        var d = t.Value.ToLocalTime().Date;
        if (d >= DateTime.Today) return "Today";
        if (d == DateTime.Today.AddDays(-1)) return "Yesterday";
        if (d > DateTime.Today.AddDays(-7)) return "This week";
        return "Earlier";
    }

    protected override async Task OnInitializedAsync()
    {
        composerOpen = composerRef?.IsOpen == true;
        ComposerHost.OpenChanged += OnHostComposerOpenChanged;
        ComposerHost.Sent += OnHostComposerSent;
        ComposerHost.Discarded += OnHostComposerDiscarded;
        ComposerHost.OpenTemplatesRequested += OnHostOpenTemplates;
        UpdateHeader();
        if (Auth.IsAuthenticated)
        {
            await ReloadAll();
            await LoadLabelsAsync();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        _mailSub = Auth.On(IPop.Application.Realtime.RealtimeEvents.MailChanged, OnMailChanged);
        // mailChanged pushes sent while the hub was down are lost: re-read once it's back.
        Auth.HubReconnected += OnMailChanged;
    }

    // ── Live refresh (mailChanged) ──
    // Another user/tab changed this mailbox. Re-fetch counts + the pages already loaded, in
    // place: no spinner, selection/open detail/composer untouched, list length kept so the
    // scroll position holds. Debounced so a burst (bulk move, send) triggers one reload.
    private IDisposable? _mailSub;
    private CancellationTokenSource? _liveCts;

    private void OnMailChanged()
    {
        _liveCts?.Cancel(); _liveCts?.Dispose();
        var t = new CancellationTokenSource(); _liveCts = t;
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(400, t.Token); } catch (OperationCanceledException) { return; }
            await LiveRefreshAsync();
        });
    }

    private async Task LiveRefreshAsync()
    {
        if (loading || loadingMore) return;
        try
        {
            var folderAtStart = activeFolder;
            var searchAtStart = search;
            var q = string.IsNullOrWhiteSpace(search) ? null : search;
            bool? unreadOnly = tabFilter == "unread" ? true : null;
            bool? starredOnly = tabFilter == "starred" ? true : null;

            var c = await MailSvc.GetCountsAsync();
            var fresh = new List<MailSummary>();
            var total = 0;
            var pages = Math.Max(1, page);
            for (var p = 1; p <= pages; p++)
            {
                var res = await MailSvc.GetFolderAsync(activeFolder, p, pageSize, q, starredOnly, unreadOnly, labelFilter, advDateFrom, advDateTo, advHasAttachment ? true : null);
                if (res is null) return;
                total = res.TotalCount;
                var seen = fresh.Select(x => x.Id).ToHashSet();
                fresh.AddRange((res.Items ?? []).Where(i => seen.Add(i.Id)));
                if (fresh.Count >= total) break;
            }
            // The user switched folder/search (or started a load) while we were fetching.
            if (folderAtStart != activeFolder || searchAtStart != search || loading || loadingMore) return;

            if (c is not null) counts = c;
            Items = fresh;
            pageTotal = total;
            selected.IntersectWith(Items.Select(i => i.Id));
            lastSyncedTime = DateTime.Now.ToString("HH:mm");
            UpdateHeader();
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { /* background refresh — the next event or a manual sync will catch up */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ipop.icons");
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ipop.mailBindShortcuts", _selfRef);
            try { await JS.InvokeAsync<bool>("ipopMailLayout.bind", ".mail-page"); } catch (JSException) { }
            density = MailListDensity.Parse(await Auth.GetUserSettingAsync(MailListDensity.Key));
            StateHasChanged();
            // Read receipts: the tracker watches [data-mail-seen] bodies in the reading pane (spec 2026-10-14 §3).
            _seenRef = DotNetObjectReference.Create(MailSeenReporter);
            try { await JS.InvokeAsync<bool>("ipopMailSeen.bind", ".mail-page", _seenRef); } catch (JSException) { }
            if (!_navSubscribed)
            {
                _navSubscribed = true;
                Nav.LocationChanged += OnLocationChanged;
                await HandleDeeplinkIfAny();
            }
        }
        await JS.InvokeVoidAsync("ipop.icons");
        if (!firstRender) { try { await JS.InvokeVoidAsync("ipopMailLayout.refresh"); } catch (JSException) { } }
        if (scrollReaderTop) { scrollReaderTop = false; try { await JS.InvokeVoidAsync("ipopMailLayout.scrollReaderTop"); } catch (JSException) { } }
        // Pasted images stored on the NAS need the token: swap them to blob: URLs once rendered.
        if (detail?.Body?.Contains("data-ipop-att", StringComparison.Ordinal) == true)
            await JS.InvokeVoidAsync("ipop.mailImages.hydrate", null, Http.BaseAddress?.ToString() ?? "", Auth.AccessToken);
    }

