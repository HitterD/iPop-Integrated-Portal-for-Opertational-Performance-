@code {
    private static readonly MailFolder[] Folders =
    [
        MailFolder.Inbox, MailFolder.Sent, MailFolder.Draft, MailFolder.Scheduled, MailFolder.Starred, MailFolder.Archive, MailFolder.Trash
    ];

    private MailFolder activeFolder = MailFolder.Inbox;
    private string tabFilter = "all"; // "all", "unread", "starred"
    private string? labelFilter;
    private List<MailSummary> Items = [];
    private MailDetail? detail;
    private MailCounts? counts;
    private List<MailLabel> serverLabels = [];
    private int page = 1, pageSize = 25, pageTotal;
    private bool loading;
    private bool loadingMore;
    private string search = "";
    private readonly HashSet<Guid> selected = [];
    private Guid? selectedMail;
    private CancellationTokenSource? cts;
    private string lastSyncedTime = DateTime.Now.ToString("HH:mm");

    private MailComposer? composerRef => ComposerHost.Instance;

    private static readonly (string[] Keys, string What)[] KbdShortcuts =
    [
        (["C"], "New message"),
        (["R"], "Quick reply"),
        (["A"], "Reply all"),
        (["F"], "Forward"),
        (["E"], "Archive"),
        (["Del"], "Move to Trash (in Trash: delete forever, asks first)"),
        (["J"], "Next message"),
        (["K"], "Previous message"),
        (["Ctrl", "Enter"], "Send (in composer)"),
        (["Ctrl", "K"], "Insert link (in composer)"),
        (["Esc"], "Close menu / minimise composer"),
        (["?"], "Show this list"),
    ];
    private MailThreadStack? threadStackRef;
    private bool composerOpen;
    private bool quickEmojiOpen;

    private async Task ToggleQuickEmoji()
    {
        await JS.InvokeVoidAsync("ipop.emojiSaveCaret", "mail-quick-reply-text");
        quickEmojiOpen = !quickEmojiOpen;
    }

    private async Task InsertQuickEmoji(string emoji)
    {
        quickReplyText = await JS.InvokeAsync<string>("ipop.emojiInsert", "mail-quick-reply-text", emoji);
        quickEmojiOpen = false;
    }

    private async Task CloseQuickEmoji()
    {
        quickEmojiOpen = false;
        await JS.InvokeVoidAsync("ipop.mailFocusReply");
    }

    private string quickReplyText = "";
    private bool quickReplySending;
    private bool replyOpen;
    private Guid? replyOpenFor;
    private bool moreMenuOpen;
    private bool _navSubscribed;
    private string? _lastHandledQuery;

    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        composerOpen = composerRef?.IsOpen == true;
        ComposerHost.OpenChanged += OnHostComposerOpenChanged;
        ComposerHost.Sent += OnHostComposerSent;
        ComposerHost.Discarded += OnHostComposerDiscarded;
        ComposerHost.OpenTemplatesRequested += OnHostOpenTemplates;
        UpdateHeader();
        if (Auth.IsAuthenticated)
        {
            await ReloadAll();
            await LoadLabelsAsync();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        _mailSub = Auth.On(IPop.Application.Realtime.RealtimeEvents.MailChanged, OnMailChanged);
        // mailChanged pushes sent while the hub was down are lost: re-read once it's back.
        Auth.HubReconnected += OnMailChanged;
    }

    // ── Live refresh (mailChanged) ──
    // Another user/tab changed this mailbox. Re-fetch counts + the pages already loaded, in
    // place: no spinner, selection/open detail/composer untouched, list length kept so the
    // scroll position holds. Debounced so a burst (bulk move, send) triggers one reload.
    private IDisposable? _mailSub;
    private CancellationTokenSource? _liveCts;

    private void OnMailChanged()
    {
        _liveCts?.Cancel(); _liveCts?.Dispose();
        var t = new CancellationTokenSource(); _liveCts = t;
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(400, t.Token); } catch (OperationCanceledException) { return; }
            await LiveRefreshAsync();
        });
    }

    private async Task LiveRefreshAsync()
    {
        if (loading || loadingMore) return;
        try
        {
            var folderAtStart = activeFolder;
            var searchAtStart = search;
            var q = string.IsNullOrWhiteSpace(search) ? null : search;
            bool? unreadOnly = tabFilter == "unread" ? true : null;
            bool? starredOnly = tabFilter == "starred" ? true : null;

            var c = await MailSvc.GetCountsAsync();
            var fresh = new List<MailSummary>();
            var total = 0;
            var pages = Math.Max(1, page);
            for (var p = 1; p <= pages; p++)
            {
                var res = await MailSvc.GetFolderAsync(activeFolder, p, pageSize, q, starredOnly, unreadOnly, labelFilter, advDateFrom, advDateTo, advHasAttachment ? true : null);
                if (res is null) return;
                total = res.TotalCount;
                var seen = fresh.Select(x => x.Id).ToHashSet();
                fresh.AddRange((res.Items ?? []).Where(i => seen.Add(i.Id)));
                if (fresh.Count >= total) break;
            }
            // The user switched folder/search (or started a load) while we were fetching.
            if (folderAtStart != activeFolder || searchAtStart != search || loading || loadingMore) return;

            if (c is not null) counts = c;
            Items = fresh;
            pageTotal = total;
            selected.IntersectWith(Items.Select(i => i.Id));
            lastSyncedTime = DateTime.Now.ToString("HH:mm");
            UpdateHeader();
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { /* background refresh — the next event or a manual sync will catch up */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ipop.icons");
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ipop.mailBindShortcuts", _selfRef);
            // Read receipts: the tracker watches [data-mail-seen] bodies in the reading pane (spec 2026-10-14 §3).
            _seenRef = DotNetObjectReference.Create(MailSeenReporter);
            try { await JS.InvokeAsync<bool>("ipopMailSeen.bind", ".mail-page", _seenRef); } catch (JSException) { }
            if (!_navSubscribed)
            {
                _navSubscribed = true;
                Nav.LocationChanged += OnLocationChanged;
                await HandleDeeplinkIfAny();
            }
        }
        await JS.InvokeVoidAsync("ipop.icons");
        // Pasted images stored on the NAS need the token: swap them to blob: URLs once rendered.
        if (detail?.Body?.Contains("data-ipop-att", StringComparison.Ordinal) == true)
            await JS.InvokeVoidAsync("ipop.mailImages.hydrate", null, Http.BaseAddress?.ToString() ?? "", Auth.AccessToken);
    }

