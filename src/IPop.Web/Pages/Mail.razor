    [JSInvokable]
    public Task OnShortcut(string key) => InvokeAsync(async () =>
    {
        switch (key)
        {
            case "Escape":
                if (quickEmojiOpen) await CloseQuickEmoji();
                else if (kbdSheetOpen) kbdSheetOpen = false;
                else if (rescheduleOpen) rescheduleOpen = false;
                else if (moreMenuOpen) moreMenuOpen = false;
                else if (labelMenuOpen) labelMenuOpen = false;
                else if (bulkLabelOpen) bulkLabelOpen = false;
                else if (settingsMenuOpen) settingsMenuOpen = false;
                else return;
                break;
            case "?": kbdSheetOpen = !kbdSheetOpen; break;
            case "c": OpenComposer(); break;
            case "r": if (detail is not null) await OpenQuickReply(); else return; break;
            case "a": if (detail is not null && detail.CanReplyAll) ReplyAllMessage(detail); else return; break;
            case "f": if (detail is not null) ForwardMessage(detail); else return; break;
            case "e": if (detail is not null) await MoveDetail(MailFolder.Archive); else return; break;
            case "Delete": if (detail is not null) await MoveDetail(MailFolder.Trash); else return; break;
            case "j": await StepDetail(1); break;
            case "k": await StepDetail(-1); break;
            default: return;
        }
        StateHasChanged();
    });

    private async Task StepDetail(int delta)
    {
        if (Items.Count == 0) return;
        var i = selectedMail is { } id ? Items.FindIndex(m => m.Id == id) : -1;
        var next = i < 0 ? 0 : Math.Clamp(i + delta, 0, Items.Count - 1);
        if (i == next) return;
        await OpenDetail(Items[next].Id);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.mailRevealSelected");
    }

