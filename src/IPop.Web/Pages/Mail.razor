                @if (string.IsNullOrWhiteSpace(detail.Body))
                {
                    <div class="mail-html-empty">
                        <i data-lucide="mail-open"></i>
                        <div class="t">This message has no content</div>
                        <div class="s">No content to preview.</div>
                    </div>
                }
                else
                {
                    <div class="mail-html-body">
                        @((MarkupString)(detail.IsHtml ? detail.Body : $"<pre style=\"white-space:pre-wrap;font-family:inherit\">{detail.Body}</pre>"))
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly MailFolder[] Folders =
    [
        MailFolder.Inbox, MailFolder.Sent, MailFolder.Draft, MailFolder.Scheduled, MailFolder.Starred, MailFolder.Archive, MailFolder.Trash
    ];

    private MailFolder activeFolder = MailFolder.Inbox;
    private string tabFilter = "all"; // "all", "unread", "starred"
    private string? labelFilter;
    private List<MailSummary> Items = [];
    private MailDetail? detail;
    private MailCounts? counts;
    private List<MailLabel> serverLabels = [];
    private int page = 1, pageSize = 25, pageTotal;
    private bool loading;
    private bool loadingMore;
    private string search = "";
    private readonly HashSet<Guid> selected = [];
    private Guid? selectedMail;
    private CancellationTokenSource? cts;
    private string lastSyncedTime = DateTime.Now.ToString("HH:mm");

    private MailComposer? composerRef;
    private MailThreadStack? threadStackRef;
    private bool composerOpen;
    private string quickReplyText = "";
    private bool quickReplySending;
    private bool moreMenuOpen;
    private bool _navSubscribed;
    private string? _lastHandledQuery;

    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        UpdateHeader();
        if (Auth.IsAuthenticated)
        {
            await ReloadAll();
            await LoadLabelsAsync();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("ipop.icons");
            if (!_navSubscribed)
            {
                _navSubscribed = true;
                Nav.LocationChanged += OnLocationChanged;
                await HandleDeeplinkIfAny();
            }
        }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public async Task ReloadAll()
    {
        counts = await MailSvc.GetCountsAsync();
        lastSyncedTime = DateTime.Now.ToString("HH:mm");
        UpdateHeader();
        await LoadPage(1);
        await LoadLabelsAsync();
    }

    private void UpdateHeader()
    {
        var title = FolderLabel(activeFolder);
        Layout.SetHeader(title);
        var unread = activeFolder == MailFolder.Inbox ? (counts?.InboxUnread ?? 0) : 0;
        var total = AllCount;
        var sub = $"{unread} unread · {total} {(total == 1 ? "message" : "messages")} · synced {lastSyncedTime}";
        Layout.SetSubtitle(sub);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = HandleDeeplinkIfAny();

    private async Task HandleDeeplinkIfAny()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        if (string.IsNullOrEmpty(query) || composerOpen || _lastHandledQuery == query) return;

        var parsed = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) parsed[Uri.UnescapeDataString(part)] = "";
            else parsed[Uri.UnescapeDataString(part[..eq])] = Uri.UnescapeDataString(part[(eq + 1)..]);
        }

        if (parsed.TryGetValue("mailId", out var mailIdStr) && Guid.TryParse(mailIdStr, out var mailId))
        {
            _lastHandledQuery = query;
            await OpenDetail(mailId);
            return;
        }

        var hasSubject = parsed.TryGetValue("shareSubject", out var s2);
        var hasBody = parsed.TryGetValue("shareBody", out var b2);
        if (hasSubject || hasBody)
        {
            _lastHandledQuery = query;
            OpenComposer(initialSubject: s2, initialBody: b2);
            return;
        }

        var hasCompose = parsed.TryGetValue("compose", out var composeVal);
        var hasTo = parsed.TryGetValue("to", out var toVal);

        if (hasCompose || hasTo)
        {
            _lastHandledQuery = query;
            var toList = new List<string>();

            if (hasTo && !string.IsNullOrWhiteSpace(toVal))
            {
                toList.AddRange(toVal.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
            }
            if (hasCompose && !string.IsNullOrWhiteSpace(composeVal) && composeVal != "1")
            {
                if (!toList.Contains(composeVal, StringComparer.OrdinalIgnoreCase))
                    toList.Add(composeVal.Trim());
            }

            if (toList.Count > 0)
            {
                var rows = new List<MemberSearchRow>();
                foreach (var nik in toList)
                {
                    var name = await ResolveNameFromNikAsync(nik);
                    rows.Add(new MemberSearchRow(nik, name, null, null));
                }
                OpenComposer(initialTo: rows);
            }
            else
            {
                OpenComposer();
            }
            return;
        }
    }

    private async Task SetTabFilter(string tab)
    {
        tabFilter = tab;
        await LoadPage(1);
    }

    // ── Counts Helpers ──
    private int AllCount => activeFolder switch
    {
        MailFolder.Inbox => counts?.InboxTotal ?? pageTotal,
        MailFolder.Sent => counts?.SentTotal ?? pageTotal,
        MailFolder.Draft => counts?.DraftTotal ?? pageTotal,
        MailFolder.Scheduled => counts?.ScheduledTotal ?? pageTotal,
        MailFolder.Starred => counts?.StarredTotal ?? pageTotal,
        MailFolder.Archive => counts?.ArchiveTotal ?? pageTotal,
        MailFolder.Trash => counts?.TrashTotal ?? pageTotal,
        _ => pageTotal
    };

    private int UnreadCount => activeFolder == MailFolder.Inbox
        ? (counts?.InboxUnread ?? 0)
        : Items.Count(i => !i.IsRead);

    private int StarredCount => counts?.StarredTotal ?? 0;

    private int NewCount => counts?.InboxUnread ?? 0;

    private bool HasMore => Items.Count < pageTotal;

    // ── Advanced Search ──
    private bool advSearchOpen;
    private string advFrom = "";
    private string advQuery = "";
    private DateTime? advDateFrom;
    private DateTime? advDateTo;
    private bool advHasAttachment;
    private string advLabel = "";

    private bool AdvancedActive =>
        !string.IsNullOrWhiteSpace(advFrom) || !string.IsNullOrWhiteSpace(advQuery) ||
        advDateFrom is not null || advDateTo is not null || advHasAttachment || !string.IsNullOrWhiteSpace(advLabel);

    private async Task ApplyAdvancedSearch()
    {
        search = string.Join(" ", new[] { advFrom, advQuery }.Where(s => !string.IsNullOrWhiteSpace(s)));
        labelFilter = string.IsNullOrWhiteSpace(advLabel) ? null : advLabel;
        await LoadPage(1);
    }

    private async Task ResetAdvancedSearch()
    {
        advFrom = ""; advQuery = ""; advDateFrom = null; advDateTo = null; advHasAttachment = false; advLabel = "";
        labelFilter = null; search = "";
        await LoadPage(1);
    }

    // Labels visible in current search results
    private List<string> AvailableLabels => Items
        .SelectMany(m => m.Labels ?? [])
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    // Labels for display in the Mailboxes card (server labels or fallback from items)
    private IReadOnlyList<MailLabel> DisplayLabels
    {
        get
        {
            if (serverLabels.Count > 0) return serverLabels;
            return AvailableLabels.Select(name => new MailLabel(Guid.Empty, name, LabelInk(name), 0)).ToList();
        }
    }

    private async Task LoadLabelsAsync()
    {
        try
        {
            serverLabels = await MailSvc.GetLabelsAsync() ?? [];
        }
        catch { serverLabels = []; }
    }

    private async Task ToggleLabelFilter(string name)
    {
        if (labelFilter == name)
        {
            labelFilter = null;
        }
        else
        {
            labelFilter = name;
        }
        await LoadPage(1);
    }

    private async Task LoadPage(int p, bool append = false)
    {
        if (!append) loading = true;
        StateHasChanged();
        try
        {
            var folderAtStart = activeFolder;
            var searchAtStart = search;
            var q = string.IsNullOrWhiteSpace(search) ? null : search;
            bool? unreadOnly = tabFilter == "unread" ? true : null;
            bool? starredOnly = tabFilter == "starred" ? true : null;

            var res = await MailSvc.GetFolderAsync(activeFolder, p, pageSize, q, starredOnly, unreadOnly, labelFilter, advDateFrom, advDateTo, advHasAttachment ? true : null);
            if (folderAtStart != activeFolder || searchAtStart != search) return;

            var fetched = res?.Items?.ToList() ?? [];
            pageTotal = res?.TotalCount ?? 0;
            page = p;

            if (append)
            {
                var existingIds = Items.Select(x => x.Id).ToHashSet();
                foreach (var item in fetched)
                {
                    if (existingIds.Add(item.Id))
                    {
                        Items.Add(item);
                    }
                }
            }
            else
            {
                Items = fetched;
            }

            lastSyncedTime = DateTime.Now.ToString("HH:mm");
            UpdateHeader();
        }
        catch (Exception ex) { Toasts.Show(ex.Message); }
        finally
        {
            loading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    private async Task LoadMore()
    {
        if (loadingMore || !HasMore) return;
        loadingMore = true;
        try
        {
            await LoadPage(page + 1, append: true);
        }
        finally
        {
            loadingMore = false;
        }
    }

    private async Task SelectFolder(MailFolder f)
    {
        if (activeFolder == f) { await LoadPage(1); return; }
        activeFolder = f;
        selected.Clear();
        selectedMail = null;
        detail = null;
        moreMenuOpen = false;
        UpdateHeader();
        await LoadPage(1);
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task OpenDetail(Guid id)
    {
        selectedMail = id;
        moreMenuOpen = false;
        detail = await MailSvc.GetAsync(id);
        if (id != selectedMail) return;

        if (activeFolder == MailFolder.Draft && detail is not null)
        {
            composerRef?.OpenDraft(detail);
            composerOpen = true;
            return;
        }

        if (detail?.Folder == "inbox" && !detail.IsRead)
        {
            await MailSvc.MarkReadAsync(id);
            var c = await MailSvc.GetCountsAsync();
            if (c is not null) counts = c;
            UpdateHeader();
            await LoadPage(page);
        }

        await LoadMeetingForDetail(id);
        await JS.InvokeVoidAsync("ipop.icons");
        StateHasChanged();
    }

    // ── Meeting RSVP in Reading Pane ──
    private MeetingDetailRow? meetingForDetail;

    private sealed record MeetingAttendeeRow(Guid UserId, string Name, string Nik, bool Required, string RsvpStatus, string? Note);
    private sealed record MeetingDetailRow(Guid Id, string Title, DateTime StartAt, DateTime EndAt, string? TimeZone, string? Location, string? Link,
        Guid OrganizerId, string OrganizerName, string Status, IReadOnlyList<MeetingAttendeeRow> Attendees,
        int AcceptCount, int MaybeCount, int DeclineCount, int PendingCount, string MyResponse, string? OrganizerNik = null);

    private async Task LoadMeetingForDetail(Guid mailId)
    {
        try
        {
            meetingForDetail = await Auth.GetAsync<MeetingDetailRow>($"/api/meetings/by-mail/{mailId}");
        }
        catch { meetingForDetail = null; }
    }

    private async Task OnRsvpRespond((string Response, string? Note) r)
    {
        if (meetingForDetail is null) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/meetings/{meetingForDetail.Id}/rsvp",
            new { response = r.Response, note = r.Note });
        if (res.IsSuccessStatusCode)
        {
            meetingForDetail = await res.Content.ReadFromJsonAsync<MeetingDetailRow>();
            Toasts.Show("Response saved.", ToastKind.Success);
        }
        else
        {
            Toasts.Show("Failed to save response.", ToastKind.Error);
        }
    }

    private bool hasConversation => detail is not null && (detail.ThreadCount > 0 || detail.ThreadRootId is not null || detail.InReplyToId is not null);

    private void BackToList() { selectedMail = null; detail = null; moreMenuOpen = false; }

    private async Task ReloadDetail()
    {
        if (detail is not null) detail = await MailSvc.GetAsync(detail.Id);
        StateHasChanged();
    }

    // ── Toolbar Actions (Row Under Topbar) ──
    private bool CanArchive => selected.Count > 0 || detail is not null;
    private bool CanDelete => selected.Count > 0 || detail is not null;
    private bool CanMarkRead => selected.Count > 0 || (activeFolder != MailFolder.Starred && (counts?.InboxUnread ?? 0) > 0);

    private async Task ToolbarArchive()
    {
        if (selected.Count > 0) await BulkMove(MailFolder.Archive);
        else if (detail is not null) await MoveDetail(MailFolder.Archive);
    }

    private async Task ToolbarDelete()
    {
        if (selected.Count > 0)
        {
            if (activeFolder == MailFolder.Trash) await BulkPermanent();
            else await BulkMove(MailFolder.Trash);
        }
        else if (detail is not null)
        {
            await MoveDetail(MailFolder.Trash);
        }
    }

    private async Task ToolbarMarkRead()
    {
        if (selected.Count > 0)
        {
            var list = selected.ToList();
            selected.Clear();
            foreach (var id in list)
            {
                await MailSvc.MarkReadAsync(id);
            }
            counts = await MailSvc.GetCountsAsync();
            UpdateHeader();
            await LoadPage(page);
            Toasts.Show("Marked as read.");
        }
        else
        {
            await MarkAllRead();
        }
    }

    private void ToggleMoreMenu() => moreMenuOpen = !moreMenuOpen;

    private async Task MoveToJunk()
    {
        // Backend lacks a dedicated Junk folder; routes to Trash per parity notes.
        await MoveDetail(MailFolder.Trash);
    }

    // ── Single Actions ──
    private Task TogglePin(Guid id) => RunAction(async () =>
    {
        await MailSvc.TogglePinAsync(id);
        await ReloadDetail();
        await LoadPage(page);
    });

    private Task ToggleStar(Guid id) => RunAction(async () =>
    {
        await MailSvc.ToggleStarAsync(id);
        await ReloadDetail();
        await LoadPage(page);
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
    });

    private Task MarkUnread(Guid id) => RunAction(async () =>
    {
        await MailSvc.MarkUnreadAsync(id);
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
        BackToList();
        await LoadPage(page);
    });

    private Task QuickToggleRead(MailSummary item) => RunAction(async () =>
    {
        if (item.IsRead) await MailSvc.MarkUnreadAsync(item.Id);
        else await MailSvc.MarkReadAsync(item.Id);
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
        await LoadPage(page);
    });

    private Task QuickDelete(Guid id) => RunAction(async () =>
    {
        await MailSvc.DeleteAsync(id);
        if (selectedMail == id) BackToList();
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
        await LoadPage(page);
    });

    // ── Recall ──
    private Guid? recallConfirmId;
    private void ConfirmRecall(Guid id) => recallConfirmId = id;

    private Task DoRecall() => RunAction(async () =>
    {
        if (recallConfirmId is null) return;
        var id = recallConfirmId.Value;
        recallConfirmId = null;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/mail/{id}/recall");
        if (res.IsSuccessStatusCode)
        {
            Toasts.Show("Message recalled.", ToastKind.Success);
            counts = await MailSvc.GetCountsAsync();
            UpdateHeader();
            await LoadPage(page);
        }
        else
        {
            Toasts.Show("Recall failed — the message may have already been read by the recipient.", ToastKind.Error);
        }
    });

    private Task MoveDetail(MailFolder f) => RunAction(async () =>
    {
        if (detail is null) return;
        await MailSvc.MoveAsync(detail.Id, f);
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
        BackToList();
        await LoadPage(page);
        Toasts.Show($"Moved to {FolderLabel(f)}");
    });

    private async Task ExportPdf()
    {
        if (detail is null) return;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/mail/{detail.Id}/export-pdf");
            if (res.IsSuccessStatusCode)
            {
                var bytes = await res.Content.ReadAsByteArrayAsync();
                var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
                await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"mail-{detail.Id.ToString("N")[..8]}-{stamp}.pdf");
                Toasts.ShowDetailed("Export Ready", "PDF file downloaded.", ToastKind.Success, "file-down");
            }
            else
            {
                Toasts.Show("Failed to export PDF.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export error: {ex.Message}", ToastKind.Error);
        }
    }

    // ── PDF & HTML Previews ──
    private bool pdfPreviewOpen;
    private bool pdfPreviewLoading;
    private string? pdfPreviewUrl;
    private byte[]? pdfPreviewBytes;
    private int pdfPage = 1;

    private bool htmlPreviewOpen;
    private void ToggleHtmlPreview() { if (detail is not null) htmlPreviewOpen = !htmlPreviewOpen; }
    private void CloseHtmlPreview() => htmlPreviewOpen = false;

    private async Task PreviewPdf()
    {
        if (detail is null || pdfPreviewLoading) return;
        pdfPreviewOpen = true;
        pdfPreviewLoading = true;
        pdfPreviewBytes = null;
        pdfPage = 1;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/mail/{detail.Id}/export-pdf?mode=preview");
            if (res.IsSuccessStatusCode)
            {
                pdfPreviewBytes = await res.Content.ReadAsByteArrayAsync();
                pdfPreviewUrl = await JS.InvokeAsync<string>("ipop.preview", Convert.ToBase64String(pdfPreviewBytes), "application/pdf", $"mail-{detail.Id.ToString("N")[..8]}.pdf");
            }
            else
            {
                Toasts.Show("PDF preview is not yet available on server.", ToastKind.Error);
                pdfPreviewOpen = false;
            }
        }
        finally { pdfPreviewLoading = false; }
    }

    private async Task DownloadPdfPreview()
    {
        if (pdfPreviewBytes is null || detail is null) return;
        await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(pdfPreviewBytes), $"mail-{detail.Id.ToString("N")[..8]}.pdf");
    }

    private async Task PrintPdfPreview()
    {
        if (pdfPreviewUrl is null) return;
        await JS.InvokeVoidAsync("ipop.printUrl", pdfPreviewUrl);
    }

    private void ClosePdfPreview()
    {
        pdfPreviewOpen = false;
        pdfPreviewUrl = null;
        pdfPreviewBytes = null;
    }

    private bool bulkExporting;

    private async Task BulkExportPdf()
    {
        if (selected.Count == 0 || bulkExporting) return;
        bulkExporting = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/mail/export-pdf", new { ids = selected.ToList() });
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show("Combined PDF export is not yet available on server.", ToastKind.Error);
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"mail-bundle-{stamp}.pdf");
            Toasts.Show($"{selected.Count} messages exported as a single PDF.", ToastKind.Success);
        }
        finally { bulkExporting = false; }
    }

    private bool printing;

    private async Task PrintDirect()
    {
        if (detail is null || printing) return;
        printing = true;
        try
        {
            if (pdfPreviewBytes is null)
            {
                var res = await Auth.SendAsync(HttpMethod.Get, $"/api/mail/{detail.Id}/export-pdf?mode=preview");
                if (!res.IsSuccessStatusCode)
                {
                    Toasts.Show("Printing is not yet available on server.", ToastKind.Error);
                    return;
                }
                pdfPreviewBytes = await res.Content.ReadAsByteArrayAsync();
            }
            var url = await JS.InvokeAsync<string>("ipop.preview", Convert.ToBase64String(pdfPreviewBytes), "application/pdf", "print.pdf");
            await JS.InvokeVoidAsync("ipop.printUrl", url);
        }
        finally { printing = false; }
    }

