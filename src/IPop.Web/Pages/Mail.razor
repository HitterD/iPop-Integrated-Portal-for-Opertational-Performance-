            initialSubject: MailAddressing.ReplySubject(d.Subject),
            initialBody: $"<p><br/></p>{QuoteOf(d)}",
            initialTo: plan.To, initialCc: plan.Cc);
        if (opened && plan.Notice is not null) Toasts.Show(plan.Notice, ToastKind.Warning);
    }

