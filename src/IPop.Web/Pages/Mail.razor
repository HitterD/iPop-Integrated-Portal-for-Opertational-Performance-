    private async Task OnComposerOpenChanged(bool open)
    {
        var was = composerOpen;
        composerOpen = open;
        if (was == open) return;
        try
        {
            await JS.InvokeVoidAsync("ipop.mobile.hideTabbar", open);
            // Open: push (or retarget) the Back entry. Closed over an open reader: keep/restore
            // the reader's entry. Closed with nothing under it: drop the entry.
            if ((open || detail is not null) && _selfRef is not null)
                await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _selfRef, nameof(MobileBack));
            else if (!open)
                await JS.InvokeVoidAsync("ipop.mobile.popDetail");
        }
        catch (JSException) { }
