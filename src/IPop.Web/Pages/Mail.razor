    /// The plain first page of a folder (no search or filters) is what a return visit shows
    /// while it refreshes. Memory only: summaries carry body snippets.
    private string? ListCacheKey(int p) =>
        p == 1 && string.IsNullOrWhiteSpace(search) && tabFilter is not ("unread" or "starred") && labelFilter is null
        && advDateFrom is null && advDateTo is null && !advHasAttachment ? $"mail.{activeFolder}" : null;

    private async Task LoadPage(int p, bool append = false)
    {
        if (!append) loading = true;
        if (!append && ListCacheKey(p) is { } ck && Cache.Peek<MailPaged<MailSummary>>(ck) is { } cached)
        {
            Items = cached.Items.ToList();
            pageTotal = cached.TotalCount;
        }
        StateHasChanged();
        try
        {
            var folderAtStart = activeFolder;
            var searchAtStart = search;
            var q = string.IsNullOrWhiteSpace(search) ? null : search;
            bool? unreadOnly = tabFilter == "unread" ? true : null;
            bool? starredOnly = tabFilter == "starred" ? true : null;

            var res = await MailSvc.GetFolderAsync(activeFolder, p, pageSize, q, starredOnly, unreadOnly, labelFilter, advDateFrom, advDateTo, advHasAttachment ? true : null);
            if (folderAtStart != activeFolder || searchAtStart != search) return;
            // Unreachable API: keep what is on screen (the shell shows the "couldn't load" bar).
            if (res is null) return;
            if (!append && ListCacheKey(p) is { } key) Cache.Put(key, res);

            var fetched = res.Items?.ToList() ?? [];
            pageTotal = res.TotalCount;
            page = p;

            if (append)
            {
                var existingIds = Items.Select(x => x.Id).ToHashSet();
                foreach (var item in fetched)
                {
                    if (existingIds.Add(item.Id))
                    {
                        Items.Add(item);
                    }
                }
            }
            else
            {
                Items = fetched;
            }

            lastSyncedTime = DateTime.Now.ToString("HH:mm");
            UpdateHeader();
        }
        catch (Exception ex) { Toasts.Show(ex.Message, ToastKind.Error); }
        finally
        {
            loading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    private async Task LoadMore()
    {
        if (loadingMore || !HasMore) return;
        loadingMore = true;
        try
        {
            await LoadPage(page + 1, append: true);
        }
        finally
        {
            loadingMore = false;
        }
    }

