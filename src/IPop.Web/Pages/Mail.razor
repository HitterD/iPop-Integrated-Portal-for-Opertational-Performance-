    /// Quick reply from the thread (under the newest message): the typed text to exactly the message it answers.
    private async Task<bool> SendQuickReply(MailReplyStart r)
    {
        var req = MailAddressing.QuickReply(r.Target, r.Text, Auth.Me?.Nik, r.All, r.Attachments.Select(a => a.Id).ToList());
        if (req.To.Count == 0)
        {
            Toasts.Show(MailAddressing.ForReply(r.Target, Auth.Me?.Nik, all: false).Notice
                ?? "There is no one to send this reply to.", ToastKind.Warning);
            return false;
        }
        try
        {
            var res = await MailSvc.SendAsync(req);
            if (res?.Success == true)
            {
                Toasts.Show("Reply sent.", ToastKind.Success);
                await ReloadDetail();
                await ReloadAll();
                if (threadStackRef is not null) await threadStackRef.ReloadAsync(expandLatest: true);
                return true;
            }
            // The typed text stays in the box so nothing is lost.
            Toasts.Show(res?.Error ?? "Couldn't send the reply. Try again.", ToastKind.Error);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Toasts.Show("Couldn't send the reply. Check your connection and try again.", ToastKind.Error);
        }
        return false;
    }

    /// "Open full editor": the composer opens as Reply / Reply all with what was typed above the quote.
    private void OpenFullReply(MailReplyStart r)
    {
        var plan = MailAddressing.ForReply(r.Target, Auth.Me?.Nik, r.All && r.Target.CanReplyAll);
        var typed = string.IsNullOrWhiteSpace(r.Text) ? "<p><br/></p>" : MailAddressing.TypedHtml(r.Text);
        var opened = WithComposer(c =>
        {
            c.OpenNew(r.Target.Id, r.Target.ThreadRootId ?? r.Target.Id, MailAddressing.ReplySubject(r.Target.Subject),
                $"{typed}{QuoteOf(r.Target)}", plan.To);
            if (plan.Cc.Count > 0) c.SetCcRows(plan.Cc);
            if (r.Attachments.Count > 0) c.AddAttachments(r.Attachments);
        });
        if (opened && plan.Notice is not null) Toasts.Show(plan.Notice, ToastKind.Warning);
    }

    private static string QuoteOf(MailDetail d) => MailAddressing.QuoteOf(d);

    private async Task OnComposerSent()
    {
        await ReloadAll();
        if (threadStackRef is not null) await threadStackRef.ReloadAsync(expandLatest: true);
    }

    private async Task<string> ResolveNameFromNikAsync(string nik)
    {
        try
        {
            var hit = await Auth.GetAsync<DirectoryEmployeeDto>($"/api/chat/users/{Uri.EscapeDataString(nik)}");
            if (hit is not null) return hit.Name;
        }
        catch { }
        return nik;
    }

    private Task RunAction(Func<Task> f)
    {
        try { return f(); }
        catch (Exception ex) { Toasts.Show(ex.Message, ToastKind.Error); return Task.CompletedTask; }
    }

    private string FolderLabel(MailFolder f) => f switch
    {
        MailFolder.Inbox => "Inbox",
        MailFolder.Sent => "Sent",
        MailFolder.Draft => "Drafts",
        MailFolder.Scheduled => "Scheduled",
        MailFolder.Starred => "Starred",
        MailFolder.Archive => "Archive",
        MailFolder.Trash => "Trash",
        _ => "Inbox"
    };

    private string FolderIcon(MailFolder f) => f switch
    {
        MailFolder.Inbox => "inbox",
        MailFolder.Sent => "send",
        MailFolder.Draft => "file-text",
        MailFolder.Scheduled => "calendar-clock",
        MailFolder.Starred => "star",
        MailFolder.Archive => "archive",
        MailFolder.Trash => "trash-2",
        _ => "inbox"
    };

    private string FolderEmptyIcon(MailFolder f) => f switch
    {
        MailFolder.Draft => "file-pen-line",
        MailFolder.Scheduled => "calendar-clock",
        MailFolder.Trash => "trash",
        _ => "inbox"
    };

    private int FolderBadge(MailFolder f) => (counts, f) switch
    {
        (null, _) => 0,
        (_, MailFolder.Inbox) => counts.InboxUnread,
        (_, MailFolder.Draft) => counts.DraftTotal,
        (_, MailFolder.Scheduled) => counts.ScheduledTotal,
        (_, MailFolder.Starred) => counts.StarredTotal,
        _ => 0
    };

    /// The opened mail came from the EPop archive import: it carries the importer's label.
    private bool DetailFromEpop => detail is not null && serverLabels.Any(l => l.Name.Equals(MailEpop.Label, StringComparison.OrdinalIgnoreCase) && detail.LabelIds.Contains(l.Id));

    private bool IsMyMail(MailDetail d) => string.Equals(d.SenderNik, Auth.Me?.Nik, StringComparison.OrdinalIgnoreCase);
    /// Hidden recipient list: everyone but the sender sees "undisclosed recipients".
    private bool IsUndisclosed => detail is { HideRecipients: true } d && !IsMyMail(d);

    private static string FormatTime(DateTime? t)
    {
        if (t is null) return "";
        var local = t.Value.ToLocalTime();
        if (local.Date == DateTime.Today) return local.ToString("HH:mm");
        if (local.Date == DateTime.Today.AddDays(-1)) return "Yesterday";
        return local.ToString("dd MMM");
    }

    private static string FormatDetailDate(DateTime? t)
        => t is null ? "" : t.Value.ToLocalTime().ToString("ddd, dd MMM yyyy, HH:mm");

    private string SenderPresence(string? nik)
    {
        if (string.IsNullOrEmpty(nik)) return "off";
        if (nik == Auth.Me?.Nik) return Auth.MyStatus;
        return "off";
    }

    // Deterministic palette for label colors
    private static readonly string[] LabelPalette = ["#2e7d5b", "#7d5ba6", "#8a6d3b", "#b3543f", "#4f6d8f", "#5b7d2e"];
    private static string LabelInk(string name) => LabelPalette[Math.Abs(name.GetHashCode()) % LabelPalette.Length];
    private static string HumanSize(long b) => b switch { < 1024 => $"{b} B", < 1024 * 1024 => $"{b / 1024.0:0.#} KB", _ => $"{b / 1024.0 / 1024.0:0.#} MB" };

    public void Dispose()
    {
        ComposerHost.OpenChanged -= OnHostComposerOpenChanged;
        ComposerHost.Sent -= OnHostComposerSent;
        ComposerHost.Discarded -= OnHostComposerDiscarded;
        ComposerHost.OpenTemplatesRequested -= OnHostOpenTemplates;
        cts?.Cancel();
        cts?.Dispose();
        _mailSub?.Dispose();
        Auth.HubReconnected -= OnMailChanged;
        _liveCts?.Cancel();
        _liveCts?.Dispose();
        if (_navSubscribed) Nav.LocationChanged -= OnLocationChanged;
        _ = ResetMobileAsync();
        _ = UnbindShortcutsAsync();
        _ = JS.InvokeVoidAsync("ipop.mailImages.release").AsTask().ContinueWith(_ => { });
        _ = UnbindSeenAsync();
        _ = JS.InvokeVoidAsync("ipopMailLayout.unbind").AsTask().ContinueWith(_ => { });
    }

    private async Task UnbindSeenAsync()
    {
        try { await JS.InvokeVoidAsync("ipopMailSeen.unbind"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        finally { _seenRef?.Dispose(); _seenRef = null; }
    }

    private async Task ResetMobileAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ipop.mobile.hideTabbar", false);
            await JS.InvokeVoidAsync("ipop.mobile.clearDetail");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task UnbindShortcutsAsync()
    {
        try { await JS.InvokeVoidAsync("ipop.mailUnbindShortcuts"); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        _selfRef?.Dispose();
    }
}

@code {
    /// Hover quick actions on a list row (Recall for Sent, Restore / Move for Trash / Archive, Delete, Pin, Star, Read).
    private RenderFragment RowActions(MailSummary item) => __builder =>
    {
        @if (activeFolder == MailFolder.Sent)
        {
            <button type="button" title="Recall message" aria-label="Recall message" @onclick="() => ConfirmRecall(item.Id)"><i data-lucide="undo-2"></i></button>
        }
        @if (activeFolder == MailFolder.Trash)
        {
            <button type="button" title="Restore to Inbox" aria-label="Restore to Inbox" @onclick="() => QuickRestore(item.Id)"><i data-lucide="inbox"></i></button>
        }
        else if (activeFolder == MailFolder.Archive)
        {
            <button type="button" title="Move to Inbox" aria-label="Move to Inbox" @onclick="() => QuickMove(item.Id, MailFolder.Inbox)"><i data-lucide="inbox"></i></button>
        }
        <button type="button" class="@(activeFolder == MailFolder.Trash ? "danger" : "")" title="@(activeFolder == MailFolder.Trash ? "Delete forever" : "Move to Trash")"
                aria-label="@(activeFolder == MailFolder.Trash ? "Delete forever" : "Move to Trash")" @onclick="() => QuickDelete(item.Id)"><i data-lucide="trash-2"></i></button>
        <button type="button" class="@(item.IsPinned ? "active" : "")" title="@(item.IsPinned ? "Unpin" : "Pin")" aria-label="@(item.IsPinned ? "Unpin" : "Pin")" @onclick="() => TogglePin(item.Id)"><i data-lucide="pin"></i></button>
        <button type="button" class="@(item.IsStarred ? "active" : "")" title="@(item.IsStarred ? "Unstar" : "Star")" aria-label="@(item.IsStarred ? "Unstar" : "Star")" @onclick="() => ToggleStar(item.Id)"><i data-lucide="star"></i></button>
        <button type="button" title="@(item.IsRead ? "Mark unread" : "Mark read")" aria-label="@(item.IsRead ? "Mark unread" : "Mark read")" @onclick="() => QuickToggleRead(item)"><i data-lucide="@(item.IsRead ? "mail-x" : "mail-check")"></i></button>
    };

    /// Mail settings popover (Mailboxes footer and the rail): list density, the settings pages, pane reset.
    private RenderFragment SettingsMenu => __builder =>
    {
        if (!settingsMenuOpen) return;
        <div class="mlx-catch" @onclick="() => settingsMenuOpen = false"></div>
        <div class="mlx-pop mlx-spop" role="menu" aria-label="Mail settings">
            <div class="mlx-mhd">List density</div>
            <div class="mlx-seg" role="radiogroup" aria-label="List density">
                <button type="button" role="radio" class="@(density == MailListDensity.Compact ? "on" : "")" aria-checked="@(density == MailListDensity.Compact ? "true" : "false")"
                        @onclick="() => SetDensity(MailListDensity.Compact)"><i data-lucide="rows-2"></i>Compact</button>
                <button type="button" role="radio" class="@(density == MailListDensity.Comfortable ? "on" : "")" aria-checked="@(density == MailListDensity.Comfortable ? "true" : "false")"
                        @onclick="() => SetDensity(MailListDensity.Comfortable)"><i data-lucide="rows-3"></i>Comfortable</button>
            </div>
            <div class="mlx-dprev">
                @if (density == MailListDensity.Compact) { <b>2 lines</b><text> · sender + date / subject — preview. More mail on screen.</text> }
                else { <b>3 lines</b><text> · sender + date / subject / preview. Easier to scan.</text> }
            </div>
            <div class="mlx-msep" role="separator"></div>
            <button type="button" class="mlx-mi" role="menuitem" @onclick='() => OpenSettings("signature")'><i data-lucide="pen-line"></i><span>Signature</span></button>
            <button type="button" class="mlx-mi" role="menuitem" @onclick='() => OpenSettings("ooo")'><i data-lucide="plane"></i><span>Out of office</span></button>
            <button type="button" class="mlx-mi" role="menuitem" @onclick='() => OpenSettings("rules")'><i data-lucide="list-filter"></i><span>Rules &amp; filters</span></button>
            <button type="button" class="mlx-mi" role="menuitem" @onclick='() => OpenSettings("labels")'><i data-lucide="tag"></i><span>Manage labels</span></button>
            <button type="button" class="mlx-mi" role="menuitem" @onclick='() => OpenSettings("templates")'><i data-lucide="layout-template"></i><span>Templates</span></button>
            <div class="mlx-msep" role="separator"></div>
            <button type="button" class="mlx-mi" role="menuitem" data-mlx-act="reset" @onclick="() => settingsMenuOpen = false"><i data-lucide="rotate-ccw"></i><span>Reset pane widths</span></button>
            <button type="button" class="mlx-mi danger" role="menuitem" @onclick="EmptyTrashFromMenu"><i data-lucide="trash-2"></i><span>Empty Trash</span></button>
        </div>
    };
}
