                                    <div class="resched-pop" role="dialog" aria-label="Reschedule delivery">
                                        <label class="resched-label" for="resched-at">Deliver on</label>
                                        <AppDateTimePicker Id="resched-at" @bind-Value="rescheduleAt" AriaLabel="Deliver on" />
                                        <div class="resched-quick">
                                            <button type="button" @onclick="() => rescheduleAt = DateTime.Today.AddDays(1).AddHours(8)">Tomorrow 08:00</button>
                                            <button type="button" @onclick="() => rescheduleAt = NextMonday().AddHours(8)">Monday 08:00</button>
                                        </div>
                                        @if (rescheduleAt <= DateTime.Now)
                                        {
                                            <div class="resched-err">Choose a time in the future.</div>
                                        }
                                        <div class="resched-actions">
                                            <button type="button" class="sched-btn" @onclick="() => rescheduleOpen = false">Cancel</button>
                                            <button type="button" class="sched-btn primary" disabled="@(rescheduleAt <= DateTime.Now)" @onclick="() => SaveReschedule(detail.Id)">Save</button>
                                        </div>
                                    </div>
                                }
                            </span>
                            <button type="button" class="sched-btn" @onclick="() => CancelScheduleAndEdit(detail)">Cancel &amp; Edit</button>
                            <button type="button" class="sched-btn" title="Move to Trash" @onclick="() => MoveDetail(MailFolder.Trash)">Delete</button>
                        </div>
                    </div>
                }

                @* Meeting RSVP Banner *@
                @if (meetingForDetail is not null)
                {
                    <MeetingRsvpPanel
                        Meeting="@(new MeetingRsvpPanel.MeetingModel(meetingForDetail.Id, meetingForDetail.Title, meetingForDetail.StartAt, meetingForDetail.EndAt, meetingForDetail.Location, meetingForDetail.Link))"
                        CurrentResponse="@meetingForDetail.MyResponse"
                        ShowSummary="@(meetingForDetail.OrganizerNik == Auth.Me?.Nik)"
                        Attendees="@(meetingForDetail.Attendees.Select(a => new MeetingRsvpPanel.AttendeeModel(a.Name, a.RsvpStatus)).ToList())"
                        OnRespond="OnRsvpRespond" />
                }

                @* Detail Scroll Area: Body + Attachments or Conversation Stack *@
                <div class="detail-scroll-area">
                    <MailMassPanel Detail="detail" IsSender="@IsMyMail(detail)" />
                    @* Linked Projects chip row if any *@
                    @if (detail.LinkedProjects.Count > 0)
                    {
                        <div class="linked-projects-row">
                            <span class="linked-title"><i data-lucide="kanban"></i> Projects:</span>
                            @foreach (var p in detail.LinkedProjects)
                            {
                                <span class="badge info" title="Progress: @p.Progress%">@p.Name</span>
                            }
                        </div>
                    }

                    @if (hasConversation)
                    {
                        <MailThreadStack @ref="threadStackRef"
                                         Detail="detail"
                                         MyNik="@Auth.Me?.Nik"
                                         FromEpop="@DetailFromEpop"
                                         OnQuickReply="OpenQuickReplyFor"
                                         OnReply="ReplyMessage"
                                         OnReplyAll="ReplyAllMessage"
                                         OnForward="ForwardMessage" />
                    }
                    else
                    {
                        <div class="mrd-host" data-mail-seen="@(MailSeen.Applies(detail, Auth.Me?.Nik) ? detail.Id.ToString() : null)">
                            <MailBody Mail="detail" FromEpop="@DetailFromEpop" />
                        </div>

                        <MailAttachmentCards Attachments="detail.Attachments" />

                        @if (detail.Folder is not ("draft" or "scheduled"))
                        {
                            <MailMessageActions Mail="detail" MyNik="@Auth.Me?.Nik"
                                                OnQuickReply="OpenQuickReplyFor" OnReply="ReplyMessage"
                                                OnReplyAll="ReplyAllMessage" OnForward="ForwardMessage" />
                        }
                    }
                </div>

            }
        </div>
    </div>
</div>

