                        <button type="button" class="m" @onclick="ToggleMoreMenu"><span class="ti"><i data-lucide="more-horizontal"></i></span>More</button>
                    </nav>
                }
            }
        </section>

        <div class="mlx-split" data-mlx-split="1" role="separator" aria-orientation="vertical" aria-label="Resize mailboxes" tabindex="0"><span class="mlx-grip"><i></i><i></i><i></i></span><span class="mlx-wbadge"></span></div>
        <div class="mlx-split" data-mlx-split="2" role="separator" aria-orientation="vertical" aria-label="Resize message list" tabindex="0"><span class="mlx-grip"><i></i><i></i><i></i></span><span class="mlx-wbadge"></span></div>
    </div>
</div>

