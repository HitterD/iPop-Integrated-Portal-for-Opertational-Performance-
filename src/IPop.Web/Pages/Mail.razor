@page "/mail"
@implements IDisposable
@inject IJSRuntime JS
@inject NotificationState Notifs
@inject AuthState Auth
@inject IPop.Web.Services.MailSeen MailSeenReporter
@using IPop.Web.Components
@using IPop.Web.Components.Mail
@using IPop.Web.Services

@inject NavigationManager Nav
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.ConfirmService Confirm
@inject HttpClient Http
@inject IPop.Web.Services.MailService MailSvc
@inject IPop.Web.Services.MailComposerHost ComposerHost
@inject IPop.Web.Services.PeopleLinks PLinks
@inject IPop.Web.Services.CalendarLinks CalLinks
@inject IPop.Web.Services.PageCache Cache

<PageTitle>Mail — IPop</PageTitle>


<div class="mail-page @(detail is not null ? "m-detail" : "") @(mFolderSheet ? "m-folders-open" : "")">
    @* ============ TOOLBAR (Segmented Filter + Ghost Actions) ============ *@
    <div class="toolbar">
        <div class="actions" style="margin-left:auto;display:flex;align-items:center;gap:8px">
            <div class="mail-search-wrap">
            <div class="v6-search" @onkeydown="OnSearchKey">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search mail or sender" aria-label="Search mail or sender" value="@search" @oninput="OnSearch" />
                <button type="button" class="v6-search-filter @(advSearchOpen || AdvancedActive ? "on" : "")" title="Advanced filter" aria-label="Advanced filter" aria-expanded="@(advSearchOpen ? "true" : "false")" @onclick="() => advSearchOpen = !advSearchOpen">
                    <i data-lucide="list-filter"></i>
                    @if (AdvancedCount > 0) { <span class="v6-search-filter-n">@AdvancedCount</span> }
                </button>
            </div>
            @if (advSearchOpen)
            {
                <div class="menu-backdrop" @onclick="() => advSearchOpen = false"></div>
                <div class="mail-filter-pop" role="dialog" aria-label="Filter mail" @onkeydown="OnFilterKey">
                    <div class="mfp-head">
                        <span>Filter</span>
                        <button type="button" class="mfp-x" aria-label="Close" @onclick="() => advSearchOpen = false"><i data-lucide="x"></i></button>
                    </div>
                    <label class="mfp-field">
                        <span>From</span>
                        <input type="text" placeholder="Name or employee ID" @bind="advFrom" @bind:event="oninput" />
                    </label>
                    <label class="mfp-field">
                        <span>Contains</span>
                        <input type="text" placeholder="Subject or words in the message" @bind="advQuery" @bind:event="oninput" />
                    </label>
                    <div class="mfp-field">
                        <span>Date</span>
                        <div class="mfp-chips">
                            <button type="button" class="mfp-chip @(DatePreset == "7" ? "on" : "")" @onclick='() => SetDatePreset("7")'>Last 7 days</button>
                            <button type="button" class="mfp-chip @(DatePreset == "30" ? "on" : "")" @onclick='() => SetDatePreset("30")'>Last 30 days</button>
                            <button type="button" class="mfp-chip @(DatePreset == "year" ? "on" : "")" @onclick='() => SetDatePreset("year")'>This year</button>
                        </div>
                        <div class="mfp-dates">
                            <AppDatePicker @bind-Value="advDateFrom" AllowClear="true" AriaLabel="From date" />
                            <span class="mfp-to">to</span>
                            <AppDatePicker @bind-Value="advDateTo" AllowClear="true" AriaLabel="To date" />
                        </div>
                    </div>
                    <div class="mfp-field">
                        <span>Show only</span>
                        <div class="mfp-chips">
                            <button type="button" class="mfp-chip @(advHasAttachment ? "on" : "")" aria-pressed="@(advHasAttachment ? "true" : "false")" @onclick="() => advHasAttachment = !advHasAttachment">
                                <i data-lucide="paperclip"></i> Has attachment
                            </button>
                        </div>
                    </div>
                    @if (DisplayLabels.Count > 0)
                    {
                        <div class="mfp-field">
                            <span>Label</span>
                            <div class="mfp-chips">
                                @foreach (var l in DisplayLabels)
                                {
                                    var name = l.Name;
                                    <button type="button" class="mfp-chip @(advLabel == name ? "on" : "")" aria-pressed="@(advLabel == name ? "true" : "false")" @onclick='() => advLabel = advLabel == name ? "" : name'>
                                        <span class="label-dot" style="background:@l.Color"></span>@name
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    <div class="mfp-foot">
                        <button type="button" class="mfp-link" disabled="@(!AdvancedActive && string.IsNullOrWhiteSpace(search))" @onclick="ClearFilters">Clear all</button>
                        <button type="button" class="mfp-apply" @onclick="ApplyFilters">Show results</button>
                    </div>
                </div>
            }
            </div>
            <button type="button" class="icon-btn" title="Sync mailbox" aria-label="Sync mailbox" @onclick="ReloadAll">
                <i data-lucide="refresh-cw"></i>
            </button>
            <button type="button" class="btn-dark" @onclick="() => OpenComposer()">
                <i data-lucide="square-pen"></i>
                <span>Compose</span>
            </button>
        </div>
    </div>

    @* ============ 3-PANE CARDS LAYOUT ============ *@
    <div class="mail-area @(selected.Count > 0 ? "has-selection" : "")">
        @if (mFolderSheet)
        {
            <div class="m-folder-backdrop" @onclick="() => mFolderSheet = false"></div>
        }
        @* ============ PANE 1: FOLDERS CARD ============ *@
        <div class="card mail-card mail-folders">
            <div class="card-head">
                <div>
                    <div class="card-title">Mailboxes</div>
                    <div class="card-meta">@(Auth.Me?.Email ?? $"{Folders.Length} folders")</div>
                </div>
            </div>

            <div class="tree">
                @foreach (var f in Folders)
                {
                    var folder = f;
                    var badge = FolderBadge(folder);
                    <button type="button"
                            class="tree-node @(activeFolder == folder ? "on" : "")"
                            aria-current="@(activeFolder == folder ? "page" : null)"
                            title="@FolderLabel(folder)"
                            aria-label="@FolderLabel(folder)"
                            @onclick="() => SelectFolder(folder)">
                        <i data-lucide="@(FolderIcon(folder))"></i>
                        <span class="lbl">@FolderLabel(folder)</span>
                        @if (badge > 0)
                        {
                            <span class="tree-n @(folder == MailFolder.Inbox ? "unread-accent" : "")">@badge</span>
                        }
                    </button>
                }

                <div class="tree-site" style="margin-top:10px">Labels</div>
                @if (DisplayLabels.Count == 0)
                {
                    <div class="empty-labels" style="padding:4px 10px;font-size:11.5px;color:var(--ink-4)">No labels</div>
                }
                else
                {
                    @foreach (var l in DisplayLabels)
                    {
                        var lbl = l;
                        var isLabelActive = labelFilter == lbl.Name;
                        <button type="button"
                                class="tree-node @(isLabelActive ? "on" : "")"
                                title="@lbl.Name"
                                aria-label="@lbl.Name"
                                @onclick="() => ToggleLabelFilter(lbl.Name)">
                            <span class="label-dot" style="background:@lbl.Color"></span>
                            <span class="lbl">@lbl.Name</span>
                            @if (lbl.Count > 0)
                            {
                                <span class="tree-n">@lbl.Count</span>
                            }
                        </button>
                    }
                }
            </div>

            <div class="folders-foot">
                @if (settingsMenuOpen)
                {
                    <div class="menu-backdrop" @onclick="() => settingsMenuOpen = false"></div>
                    <div class="mail-settings-menu" role="menu" aria-label="Mail settings">
                        <button type="button" class="more-item" role="menuitem" @onclick='() => OpenSettings("signature")'><i data-lucide="pen-line"></i><span>Signature</span></button>
                        <button type="button" class="more-item" role="menuitem" @onclick='() => OpenSettings("ooo")'><i data-lucide="plane"></i><span>Out of office</span></button>
                        <button type="button" class="more-item" role="menuitem" @onclick='() => OpenSettings("rules")'><i data-lucide="list-filter"></i><span>Rules &amp; filters</span></button>
                        <button type="button" class="more-item" role="menuitem" @onclick='() => OpenSettings("labels")'><i data-lucide="tag"></i><span>Labels</span></button>
                        <button type="button" class="more-item" role="menuitem" @onclick='() => OpenSettings("templates")'><i data-lucide="layout-template"></i><span>Templates</span></button>
                        <div class="msm-divider" role="separator"></div>
                        <button type="button" class="more-item danger" role="menuitem" @onclick="EmptyTrashFromMenu"><i data-lucide="trash-2"></i><span>Empty Trash</span></button>
                    </div>
                }
                <button type="button" class="ghost-btn mail-settings-btn @(settingsMenuOpen ? "on" : "")" aria-haspopup="menu" aria-expanded="@(settingsMenuOpen ? "true" : "false")" @onclick="() => settingsMenuOpen = !settingsMenuOpen">
                    <i data-lucide="settings"></i>
                    <span class="lbl">Mail settings</span>
                </button>
            </div>
        </div>

        @* ============ PANE 2: MESSAGES LIST CARD ============ *@
        <div class="card mail-card mail-list-card">
            <div class="card-head" style="justify-content:space-between">
                <div class="flex center gap-8">
                    <span class="cbx @(allSelected ? "on" : "")"
                          @onclick="ToggleSelectAll"
                          role="checkbox"
                          aria-checked="@(allSelected ? "true" : "false")"
                          tabindex="0"
                          title="Select all"
                          aria-label="Select all">
                        <i data-lucide="check"></i>
                    </span>
                    <span class="card-title">@FolderLabel(activeFolder)</span>
                    @* Phone only: the folder column is hidden, this opens it as a bottom sheet. *@
                    <button type="button" class="m-folder-btn" aria-haspopup="dialog" aria-expanded="@(mFolderSheet ? "true" : "false")" @onclick="() => mFolderSheet = true">
                        <i data-lucide="@(FolderIcon(activeFolder))"></i>
                        <span>@FolderLabel(activeFolder)</span>
                        @if (FolderBadge(activeFolder) > 0)
                        {
                            <span class="tree-n">@FolderBadge(activeFolder)</span>
                        }
                        <i data-lucide="chevron-down"></i>
                    </button>
                    @if (NewCount > 0)
                    {
                        <span class="v6-new-pill">@NewCount new</span>
                    }
                </div>
                <div class="flex center gap-6">
                    @if (activeFolder == MailFolder.Trash && Items.Count > 0)
                    {
                        <button type="button" class="btn btn-sm surface" style="color:var(--danger);font-size:11.5px;padding:3px 8px" @onclick="ConfirmEmptyTrash">
                            <i data-lucide="trash-2" style="width:12px;height:12px"></i> Empty Trash
                        </button>
                    }
                </div>
            </div>
            <div class="tabs mail-list-tabs" role="group" aria-label="Filter messages">
            <button type="button" class="tab @(tabFilter == "all" ? "active" : "")" @onclick='() => SetTabFilter("all")'>
                <i data-lucide="inbox"></i>
                <span>All</span>
                <span class="n">@AllCount</span>
            </button>
            <button type="button" class="tab @(tabFilter == "unread" ? "active" : "")" @onclick='() => SetTabFilter("unread")'>
                <i data-lucide="mail"></i>
                <span>Unread</span>
                <span class="n">@UnreadCount</span>
            </button>
            <button type="button" class="tab @(tabFilter == "starred" ? "active" : "")" @onclick='() => SetTabFilter("starred")'>
                <i data-lucide="star"></i>
                <span>Starred</span>
                <span class="n">@StarredCount</span>
            </button>
        </div>

            @if (activeFolder == MailFolder.Trash)
            {
                <div class="mail-trash-hint" role="note">
                    <i data-lucide="info"></i>
                    <span>Deleting a message from Trash removes it forever. Use Restore to move it back to Inbox.</span>
                </div>
            }

            @* Filter banner (Active query or label filter) *@
            @if (AdvancedActive || !string.IsNullOrWhiteSpace(search) || labelFilter is not null)
            {
                <div class="mail-search-banner">
                    <i data-lucide="search" style="width:13px;height:13px;color:var(--accent-ink)"></i>
                    <span>
                        Showing @Items.Count of @pageTotal @(pageTotal == 1 ? "result" : "results")
                        @if (!string.IsNullOrWhiteSpace(search)) { <text> for "@search"</text> }
                        @if (labelFilter is not null) { <span class="label-chip" style="margin-left:4px"><span class="label-dot" style="background:@LabelInk(labelFilter)"></span>@labelFilter</span> }
                    </span>
                    <button type="button" class="btn-sm surface" style="margin-left:auto;padding:2px 10px;font-size:11px" @onclick="ResetAdvancedSearch">
                        <i data-lucide="rotate-ccw" style="width:11px;height:11px"></i> Reset
                    </button>
                </div>
            }


            @* Bulk Selection Bar *@
            @if (Items.Count > 0 && selected.Count > 0)
            {
                <div class="bulk-bar" aria-label="Bulk actions">
                    <span class="bulk-count">@selected.Count selected</span>
                    <button type="button" class="comp-btn" title="Export selected as PDF" disabled="@bulkExporting" @onclick="BulkExportPdf"><i data-lucide="file-down"></i></button>
                    @if (activeFolder == MailFolder.Trash)
                    {
                        <button type="button" class="comp-btn" title="Restore to Inbox" @onclick="BulkRestore"><i data-lucide="inbox"></i> Restore</button>
                        <button type="button" class="comp-btn danger" title="Delete forever (cannot be undone)" @onclick="BulkPermanent"><i data-lucide="trash"></i> Delete forever</button>
                    }
                    else
                    {
                        @if (activeFolder == MailFolder.Archive)
                        {
                            <button type="button" class="comp-btn" title="Move to Inbox" @onclick="() => BulkMove(MailFolder.Inbox)"><i data-lucide="inbox"></i> Move to Inbox</button>
                        }
                        else
                        {
                            <button type="button" class="comp-btn" title="Archive" aria-label="Archive" @onclick="() => BulkMove(MailFolder.Archive)"><i data-lucide="archive"></i></button>
                        }
                        <button type="button" class="comp-btn" title="Move to Trash" aria-label="Move to Trash" @onclick="() => BulkMove(MailFolder.Trash)"><i data-lucide="trash-2"></i></button>
                        <button type="button" class="comp-btn" title="Star" aria-label="Star" @onclick="BulkStar" @onclick:stopPropagation><i data-lucide="star"></i></button>
                        <div class="more-menu-wrap mail-label-wrap">
                            <button type="button" class="comp-btn @(bulkLabelOpen ? "on" : "")" title="Label" aria-label="Label" aria-haspopup="menu"
                                    aria-expanded="@(bulkLabelOpen ? "true" : "false")" @onclick="() => { bulkLabelOpen = !bulkLabelOpen; labelMenuOpen = false; }">
                                <i data-lucide="tag"></i> Label
                            </button>
                            @if (bulkLabelOpen)
                            {
                                <div class="menu-backdrop" @onclick="() => bulkLabelOpen = false"></div>
                                <div class="more-dropdown mail-label-menu" role="menu" aria-label="Label selected messages" @onclick:stopPropagation>
                                    <div class="mail-label-menu-title">Label @selected.Count selected</div>
                                    @if (serverLabels.Count == 0)
                                    {
                                        <div class="mail-label-menu-empty">No labels yet.</div>
                                        <button type="button" class="more-item" role="menuitem" @onclick='() => { bulkLabelOpen = false; OpenSettings("labels"); }'>
                                            <i data-lucide="plus"></i><span>Create a label…</span>
                                        </button>
                                    }
                                    @foreach (var l in serverLabels)
                                    {
                                        var lbl = l;
                                        var state = BulkLabelState(lbl);
                                        <button type="button" class="more-item" role="menuitemcheckbox" aria-checked="@(state == true ? "true" : state is null ? "mixed" : "false")"
                                                disabled="@labelBusy" @onclick="() => BulkToggleLabel(lbl)">
                                            <i data-lucide="@(state == true ? "square-check" : state is null ? "square-minus" : "square")"></i>
                                            <span class="label-dot" style="background:@lbl.Color"></span>
                                            <span>@lbl.Name</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @* Messages List *@
            <div class="mail-rows" role="list" aria-label="Mail list">
                @if (loading && Items.Count == 0)
                {
                    <div class="list-skeleton"><span class="skeleton"></span><span class="skeleton"></span><span class="skeleton"></span></div>
                }
                else if (Items.Count == 0)
                {
                    <div class="empty-state" style="padding:40px 20px;text-align:center;color:var(--ink-3);">
                        <i data-lucide="@(FolderEmptyIcon(activeFolder))" style="width:36px;height:36px;margin-bottom:10px;opacity:0.5"></i>
                        <div class="title" style="font-weight:700;font-size:14px;color:var(--ink);">Nothing in @FolderLabel(activeFolder)</div>
                        <div class="sub" style="font-size:12px;margin-top:4px;">Messages land here. Press C to compose a new message.</div>
                    </div>
                }
                else
                {
                    @foreach (var it in Items)
                    {
                        var item = it;
                        var isSel = selected.Contains(item.Id);
                        <div @key="item.Id" class="mail-row @(item.IsRead ? "" : "unread") @(item.IsPinned ? "pinned" : "") @(selectedMail == item.Id ? "sel" : "") @(returningIds.Contains(item.Id) ? "mi-returning" : "")"
                             role="listitem" data-mail-row="@item.Id"
                             aria-selected="@(isSel ? "true" : "false")"
                             @onclick="() => OpenDetail(item.Id)">

                            @* Line 1: Checkbox, Importance, Pin, Sender, Time, Quick Actions *@
                            <div class="m-l1">
                                <span class="cbx @(isSel ? "on" : "")"
                                      @onclick="() => ToggleSelect(item.Id)"
                                      @onclick:stopPropagation
                                      role="checkbox"
                                      aria-checked="@(isSel ? "true" : "false")"
                                      tabindex="0"
                                      title="Select message"
                                      aria-label="Select message">
                                    <i data-lucide="check"></i>
                                </span>

                                @if (item.IsPinned)
                                {
                                    <span class="pin-badge" title="Pinned to top"><i data-lucide="pin"></i></span>
                                }
                                @if (item.IsMuted)
                                {
                                    <span class="mute-badge" title="Thread muted" style="color:var(--ink-3);margin-right:4px"><i data-lucide="bell-off" style="width:12px;height:12px"></i></span>
                                }

                                @if (item.Importance == "high")
                                {
                                    <span class="imp-tag high" title="High Importance"><i data-lucide="alert-circle"></i></span>
                                }
                                else if (item.Importance == "low")
                                {
                                    <span class="imp-tag low" title="Low Importance"><i data-lucide="arrow-down"></i></span>
                                }

                                <span class="m-from">@Hl(item.SenderName)</span>
                                <span class="m-time">
                                    @if (MailEpop.IsImported(item.Labels))
                                    {
                                        <span class="mrl-arc" title="Imported from EPop" aria-label="Imported from EPop"><i data-lucide="archive"></i></span>
                                    }
                                    @FormatTime(item.ReceivedAt)
                                </span>

                                @* Hover quick actions *@
                                <div class="mail-row-actions" @onclick:stopPropagation>
                                    @if (activeFolder == MailFolder.Sent)
                                    {
                                        <button type="button" title="Recall message" aria-label="Recall message" @onclick="() => ConfirmRecall(item.Id)">
                                            <i data-lucide="undo-2"></i>
                                        </button>
                                    }
                                    @if (activeFolder == MailFolder.Trash)
                                    {
                                        <button type="button" title="Restore to Inbox" aria-label="Restore to Inbox" @onclick="() => QuickRestore(item.Id)">
                                            <i data-lucide="inbox"></i>
                                        </button>
                                    }
                                    else if (activeFolder == MailFolder.Archive)
                                    {
                                        <button type="button" title="Move to Inbox" aria-label="Move to Inbox" @onclick="() => QuickMove(item.Id, MailFolder.Inbox)">
                                            <i data-lucide="inbox"></i>
                                        </button>
                                    }
                                    <button type="button" class="@(activeFolder == MailFolder.Trash ? "danger" : "")"
                                            title="@(activeFolder == MailFolder.Trash ? "Delete forever" : "Move to Trash")"
                                            aria-label="@(activeFolder == MailFolder.Trash ? "Delete forever" : "Move to Trash")" @onclick="() => QuickDelete(item.Id)">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                    <button type="button" class="@(item.IsPinned ? "active" : "")" title="@(item.IsPinned ? "Unpin" : "Pin")" aria-label="@(item.IsPinned ? "Unpin" : "Pin")" @onclick="() => TogglePin(item.Id)">
                                        <i data-lucide="pin"></i>
                                    </button>
                                    <button type="button" class="@(item.IsStarred ? "active" : "")" title="@(item.IsStarred ? "Unstar" : "Star")" aria-label="@(item.IsStarred ? "Unstar" : "Star")" @onclick="() => ToggleStar(item.Id)">
                                        <i data-lucide="star"></i>
                                    </button>
                                    <button type="button" title="@(item.IsRead ? "Mark unread" : "Mark read")" aria-label="@(item.IsRead ? "Mark unread" : "Mark read")" @onclick="() => QuickToggleRead(item)">
                                        <i data-lucide="@(item.IsRead ? "mail-x" : "mail-check")"></i>
                                    </button>
                                </div>
                            </div>

                            @* Line 2: Subject *@
                            <div class="m-l2">
                                <span class="m-subj">@Hl(item.Subject)</span>
                            </div>

                            @* Line 3: Snippet & Labels & Attachment clip *@
                            <div class="m-l3">
                                <span class="m-snip">@Hl(item.Snippet)</span>
                                @if (item.Labels is { Count: > 0 })
                                {
                                    @* The EPop archive label is the icon by the date, not a chip (spec 2026-10-14 §6). *@
                                    @foreach (var lbl in MailEpop.RowLabels(item.Labels).Take(3))
                                    {
                                        <span class="label-chip"><span class="label-dot" style="background:@LabelInk(lbl)"></span>@lbl</span>
                                    }
                                }
                                @if (item.HasAttachment)
                                {
                                    <span class="m-clip" title="Has attachment"><i data-lucide="paperclip"></i></span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* Pager replacement: Load more footer *@
            <div class="list-foot">
                <span class="foot-count">Showing @Items.Count of @pageTotal messages</span>
                @if (HasMore)
                {
                    <span class="foot-sep">·</span>
                    <button type="button" class="load-more-btn" @onclick="LoadMore" disabled="@loadingMore">
                        @(loadingMore ? "Loading…" : "Load more")
                    </button>
                }
            </div>
        </div>

        @* ============ PANE 3: READING CARD ============ *@
        <div class="card mail-card mail-detail-card">
            @if (detail is null)
            {
                <div class="empty-state">
                    <i data-lucide="mail-open"></i>
                    <div class="empty-title">Select a message</div>
                    <div class="empty-sub">Choose an email from the list to read it, reply, or forward.</div>
                </div>
            }
            else
            {
                @* Reading pane action bar *@
                <div class="m-reader-head">
                    <button type="button" class="m-back" aria-label="Back" @onclick="MobileBackClick"><i data-lucide="chevron-left"></i></button>
                    <span class="m-reader-folder">@FolderLabel(activeFolder)</span>
                </div>
                <div class="card-head detail-actions-bar">
                    <button type="button" class="icon-btn mobile-back-btn" title="Back to messages" aria-label="Back to messages" @onclick="BackToList">
                        <i data-lucide="arrow-left"></i>
                    </button>
                    <button type="button" class="btn-primary-reply" title="Quick reply (R)" aria-label="Quick reply" @onclick="() => OpenQuickReply()">
                        <i data-lucide="reply"></i>
                        <span>Quick Reply</span>
                    </button>
                    @* Calendar everywhere: a meeting with everyone on this mail, the subject as the title. *@
                    <a class="ghost-btn mail-schedule-btn" title="Schedule a meeting with everyone on this mail"
                       href="@MeetingFromMail(detail)">
                        <i data-lucide="calendar-plus"></i><span>Schedule meeting</span>
                    </a>
                    @if (DetailFolder == "trash")
                    {
                        <button type="button" class="ghost-btn" title="Restore to Inbox" @onclick="RestoreDetail">
                            <i data-lucide="inbox"></i>
                            <span>Restore</span>
                        </button>
                        <button type="button" class="ghost-btn danger" title="Delete forever (cannot be undone)" @onclick="DeleteDetailForever">
                            <i data-lucide="trash-2"></i>
                            <span>Delete forever</span>
                        </button>
                    }
                    else
                    {
                        @if (DetailFolder == "archive")
                        {
                            <button type="button" class="ghost-btn" title="Move to Inbox" @onclick="() => MoveDetail(MailFolder.Inbox)">
                                <i data-lucide="inbox"></i>
                                <span>Move to Inbox</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="icon-btn" title="Archive" aria-label="Archive" @onclick="() => MoveDetail(MailFolder.Archive)">
                                <i data-lucide="archive"></i>
                            </button>
                        }
                        <button type="button" class="icon-btn" title="Move to Trash" aria-label="Move to Trash" @onclick="() => MoveDetail(MailFolder.Trash)">
                            <i data-lucide="trash-2"></i>
                        </button>
                    }
                    <button type="button" class="icon-btn @(detail.IsStarred ? "star-active" : "")" title="@(detail.IsStarred ? "Starred" : "Star")" aria-label="@(detail.IsStarred ? "Starred" : "Star")" @onclick="() => ToggleStar(detail.Id)">
                        <i data-lucide="star"></i>
                    </button>
                    @* More options menu (Pin, Mark unread, Move to Junk, Previews) *@
                    <div class="more-menu-wrap" style="position:relative;margin-left:auto">
                        <button type="button" class="icon-btn @(moreMenuOpen ? "on" : "")" title="More options" aria-label="More options" @onclick="ToggleMoreMenu">
                            <i data-lucide="more-horizontal"></i>
                        </button>
                        @if (moreMenuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => moreMenuOpen = false"></div>
                            <div class="more-dropdown" role="menu" @onclick:stopPropagation>
                                <button type="button" class="more-item" role="menuitem" disabled="@(!detail.CanReplyAll)"
                                        title="@(detail.CanReplyAll ? null : "Reply all is turned off for mass mail")"
                                        @onclick="() => { moreMenuOpen = false; ReplyAllMessage(detail); }"><i data-lucide="reply-all"></i><span>Reply all</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="() => { moreMenuOpen = false; ForwardMessage(detail); }"><i data-lucide="forward"></i><span>Forward</span></button>
                                <div class="msm-divider" role="separator"></div>
                                <button type="button" class="more-item" role="menuitem" @onclick="() => { moreMenuOpen = false; labelMenuOpen = true; }"><i data-lucide="tag"></i><span>Label…</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="async () => { moreMenuOpen = false; await TogglePin(detail.Id); }"><i data-lucide="pin"></i><span>@(detail.IsPinned ? "Unpin" : "Pin")</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="async () => { moreMenuOpen = false; await ToggleMuteThread(detail.Id); }"><i data-lucide="@(detail.IsMuted ? "bell" : "bell-off")"></i><span>@(detail.IsMuted ? "Unmute thread" : "Mute thread")</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="async () => { moreMenuOpen = false; await MarkUnread(detail.Id); }"><i data-lucide="mail-x"></i><span>Mark as unread</span></button>
                                <div class="msm-divider" role="separator"></div>
                                <button type="button" class="more-item" role="menuitem" @onclick="async () => { moreMenuOpen = false; await ExportPdf(); }"><i data-lucide="file-down"></i><span>Export PDF</span></button>
                                <button type="button" class="more-item" role="menuitem" disabled="@printing" @onclick="async () => { moreMenuOpen = false; await PrintDirect(); }"><i data-lucide="printer"></i><span>Print</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="async () => { moreMenuOpen = false; await PreviewPdf(); }"><i data-lucide="file-search"></i><span>Preview PDF</span></button>
                                <button type="button" class="more-item" role="menuitem" @onclick="() => { moreMenuOpen = false; ToggleHtmlPreview(); }"><i data-lucide="eye"></i><span>Preview as recipient</span></button>
                            </div>
                        }
                        @if (labelMenuOpen)
                        {
                            <div class="menu-backdrop" @onclick="() => labelMenuOpen = false"></div>
