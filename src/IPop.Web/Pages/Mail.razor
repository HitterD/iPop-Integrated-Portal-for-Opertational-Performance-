    /// Which quick date chip the current range matches, so it shows as selected.
    private string DatePreset
    {
        get
        {
            if (advDateTo is not null || advDateFrom is null) return "";
            var f = advDateFrom.Value.Date;
            var today = DateTime.Today;
            if (f == today.AddDays(-7)) return "7";
            if (f == today.AddDays(-30)) return "30";
            if (f == new DateTime(today.Year, 1, 1)) return "year";
            return "";
        }
    }

    private void SetDatePreset(string key)
    {
        if (DatePreset == key) { advDateFrom = null; advDateTo = null; return; }
        var today = DateTime.Today;
        advDateFrom = key switch { "7" => today.AddDays(-7), "30" => today.AddDays(-30), _ => new DateTime(today.Year, 1, 1) };
        advDateTo = null;
    }

