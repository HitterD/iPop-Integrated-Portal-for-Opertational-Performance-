    private Task MoveDetail(MailFolder f) => RunAction(async () =>
    {
        if (detail is null) return;
        // Delete on a message that is already in Trash means "delete forever" — confirm first.
        if (f == MailFolder.Trash && DetailFolder == "trash") { await DeleteDetailForever(); return; }
        var id = detail.Id;
        var origin = Enum.TryParse<MailFolder>(DetailFolder, true, out var o) ? o : MailFolder.Inbox;
        var res = await MailSvc.MoveAsync(id, f);
        if (res?.Success != true) { Toasts.Show($"Could not move the message to {FolderLabel(f)}.", ToastKind.Error); return; }
        await LeaveRowsAsync([id]);
        counts = await MailSvc.GetCountsAsync();
        UpdateHeader();
        BackToList();
        await LoadPage(page);
        ShowMoveUndo(new[] { id }, origin, f);
    });

    /// One Undo toast for archive / delete, instead of a confirm dialog before every move.
    private void ShowMoveUndo(IReadOnlyList<Guid> ids, MailFolder origin, MailFolder target)
    {
        var text = ids.Count == 1 ? $"Moved to {FolderLabel(target)}" : $"Moved {ids.Count} items to {FolderLabel(target)}";
        Toasts.ShowUndo(text, async () =>
        {
            if (!await MailSvc.BulkMoveAsync(ids, origin)) { Toasts.Show("Could not undo.", ToastKind.Error); return; }
            counts = await MailSvc.GetCountsAsync();
            UpdateHeader();
            foreach (var rid in ids) returningIds.Add(rid);
            await LoadPage(page);
            await InvokeAsync(StateHasChanged);
            // #9: the restored rows slide back in (class only lives for the animation).
            await Task.Delay(450);
            foreach (var rid in ids) returningIds.Remove(rid);
            await InvokeAsync(StateHasChanged);
        }, "Undo", 8000);
    }

    // ── Micro-interactions (#9 row exit, #38 search highlight) ──
    private readonly HashSet<Guid> returningIds = [];

    /// #9: rows leaving the folder slide out first, then are dropped locally (and from the
    /// first-page cache) so the refresh that follows cannot flash them back in.
    /// Starred lists mail from every folder, so a move there does not remove the row.
    private async Task LeaveRowsAsync(IReadOnlyCollection<Guid> ids)
    {
        if (ids.Count == 0 || activeFolder == MailFolder.Starred) return;
        var gone = ids.ToHashSet();
        var shown = Items.Where(m => gone.Contains(m.Id)).Select(m => m.Id).Take(40).ToList();
        if (shown.Count > 0)
        {
            try
            {
                await Task.WhenAll(shown.Select(id =>
                    JS.InvokeVoidAsync("ipopMicro.leaveSelector", $"[data-mail-row=\"{id}\"]").AsTask()));
            }
            catch (JSException) { /* motion is decoration */ }
        }
        Items.RemoveAll(m => gone.Contains(m.Id));
        if (ListCacheKey(page) is { } key) Cache.Remove(key);
    }

    /// #38: the typed search lights up where it matches in sender, subject and snippet.
    private RenderFragment Hl(string? text) => builder =>
    {
        var t = text ?? "";
        var q = search?.Trim();
        var at = string.IsNullOrEmpty(q) || q.Length < 2 ? -1 : t.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (at < 0) { builder.AddContent(0, t); return; }
        builder.AddContent(1, t[..at]);
        builder.OpenElement(2, "mark");
        builder.AddAttribute(3, "class", "mail-hl");
        builder.AddContent(4, t.Substring(at, q!.Length));
        builder.CloseElement();
        builder.AddContent(5, t[(at + q.Length)..]);
    };

