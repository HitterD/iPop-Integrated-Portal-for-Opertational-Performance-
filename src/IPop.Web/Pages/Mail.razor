                                        <span class="label-dot" style="background:@lbl.Color"></span>
                                        <span>@lbl.Name</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Sender info block *@
                <div class="detail-sender-block">
                    <div class="sender-top">
                        <div class="av-wrap">
                            <PersonAvatar Nik="@detail.SenderNik" Name="@detail.SenderName" Size="44" Class="av" Viewable="true" />
                            <span class="presence @SenderPresence(detail.SenderNik)"></span>
                        </div>
                        <div class="sender-details">
                            <div class="sender-row">
                                <span class="sender-name">
                                    @detail.SenderName
                                </span>
                                <span class="sender-date">@FormatDetailDate(detail.SentAt ?? detail.ScheduledAt)</span>
                            </div>
                            @* To / Cc on one line each, +N opens the full list (spec 2026-10-14 §4). *@
                            <MailRecipientsHeader Detail="detail" MyNik="@Auth.Me?.Nik" />
                            @if (!hasConversation && detail.Folder is not ("draft" or "scheduled"))
                            {
                                @* Read receipts row (spec 2026-10-14 §1); a thread shows it on each open message instead. *@
                                <MailReceiptsRow MailId="detail.Id" />
