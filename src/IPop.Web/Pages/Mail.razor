                                {
                                    var lbl = l;
                                    var on = detail.LabelIds.Contains(lbl.Id);
                                    <button type="button" class="more-item" role="menuitemcheckbox" aria-checked="@(on ? "true" : "false")"
                                            disabled="@labelBusy" @onclick="() => ToggleDetailLabel(lbl)">
