                            var ccNames = detail.Recipients.Where(r => r.RecipientType == "cc").Select(r => r.Name).ToList();
                        }
                        @if (ccNames.Count > 0) { <span><strong>Cc:</strong> @string.Join(", ", ccNames)</span> }
