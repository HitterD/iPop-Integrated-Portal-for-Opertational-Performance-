    /// Like Outlook: a reply to my own sent message goes to its recipients; a sender without an
    /// active account can't be addressed (the composer opens without them and a toast says why).
    private void OpenReply(MailDetail d, bool all)
    {
        var plan = MailAddressing.ForReply(d, Auth.Me?.Nik, all);
        var opened = OpenComposer(inReplyTo: d.Id, threadRoot: d.ThreadRootId ?? d.Id,
            initialSubject: MailAddressing.ReplySubject(d.Subject),
            initialBody: $"<p><br/></p>{QuoteOf(d)}",
            initialTo: plan.To, initialCc: plan.Cc);
        if (opened && plan.Notice is not null) Toasts.Show(plan.Notice, ToastKind.Warning);
    }

