        if (activeFolder == MailFolder.Trash)
        {
            if (!await Confirm.AskAsync("Delete forever?", "This message will be permanently deleted from your mailbox. This cannot be undone.", "Delete forever", danger: true)) return;
            var res = await MailSvc.DeleteAsync(id);
            if (res?.Success != true) { Toasts.Show("Could not delete the message.", ToastKind.Error); return; }
        }
        else
        {
            // /move never hard-deletes, even for a trashed message listed under Starred.
            var res = await MailSvc.MoveAsync(id, MailFolder.Trash);
            if (res?.Success != true) { Toasts.Show("Could not move the message to Trash.", ToastKind.Error); return; }
            undoAfter = () => ShowMoveUndo(new[] { id }, activeFolder == MailFolder.Starred ? MailFolder.Inbox : activeFolder, MailFolder.Trash);
        }
        await LeaveRowsAsync([id]);
        if (selectedMail == id) BackToList();
