                                <i data-lucide="x" style="width:13px;height:13px"></i>
                            </button>
                        </div>
                        <textarea id="mail-quick-reply-text" rows="3" placeholder="Write a reply…" aria-label="Reply text" @bind="quickReplyText" @bind:event="oninput"></textarea>
                        <div class="ra">
                            <div style="position:relative">
                                <button type="button" class="icon-btn" title="Emoji" aria-label="Emoji" aria-expanded="@(quickEmojiOpen ? "true" : "false")"
