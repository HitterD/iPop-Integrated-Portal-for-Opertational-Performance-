@page "/profile"
@inject NavigationManager Nav

@* Old bookmark target. Profile editing is the account sheet (AccountSheet.razor) now, a popup
   from the sidebar account menu; this route just opens it over the dashboard. *@

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        Layout?.OpenAccount(AccountSheet.Pane.Profile);
        Nav.NavigateTo("/dashboard", replace: true);
    }
}
