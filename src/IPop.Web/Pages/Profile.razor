@page "/profile"
@implements IDisposable
@inject NavigationManager Nav
@inject PhoneState Phone

@if (Phone.IsPhone)
{
    <AccountSheet IsOpen="true" IsOpenChanged="_ => Nav.NavigateTo(previous)" />
}

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private string previous = "/dashboard";
    protected override void OnInitialized() { Phone.Changed += Changed; if (Phone.IsPhone) Layout?.SetHeader("Profile"); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!Phone.IsInitialized) await Phone.StartAsync();
        // Preserve the desktop bookmark behaviour only after browser detection answers.
        if (Phone.IsPhone) { Layout?.SetHeader("Profile"); return; }
        Layout?.OpenAccount(AccountSheet.Pane.Profile);
        Nav.NavigateTo("/dashboard", replace: true);
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Phone.Changed -= Changed;
}
