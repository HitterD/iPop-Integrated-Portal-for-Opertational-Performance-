        _ => "#3A3A3C"
    };

    private static string FormatTime(DateTime dt)
    {
        var now = DateTime.Now;
        var diff = now - dt;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m";
        if (diff.TotalHours < 24) return dt.ToString("HH:mm");
        if (diff.TotalDays < 7) return dt.ToString("ddd");
        return dt.ToString("dd MMM");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        Notifs.UnreadChanged -= OnLiveUnreadChanged;
        searchCts?.Cancel();
        searchCts?.Dispose();
    }

    private class NotificationItemDto
    {
        public Guid Id { get; set; }
        public string Type { get; set; }
        public string Title { get; set; }
        public string Body { get; set; }
        public string? Source { get; set; }
        public DateTime At { get; set; }
        public bool IsRead { get; set; }
        public string Priority { get; set; }
        public string? TargetUrl { get; set; }
        public DateTime? SnoozedUntil { get; set; }

        public NotificationItemDto(Guid id, string type, string title, string body, string? source, DateTime at, bool isRead, string priority, string? targetUrl, DateTime? snoozedUntil)
        {
            Id = id; Type = type; Title = title; Body = body; Source = source; At = at; IsRead = isRead; Priority = priority; TargetUrl = targetUrl; SnoozedUntil = snoozedUntil;
        }
    }

    private record InboxResultDto(List<InboxItemResultDto> Items, int TotalCount, int UnreadCount);
    private record InboxItemResultDto(Guid Id, string Type, string Title, string Body, string Source, DateTime At, bool IsRead, string Priority, string? TargetUrl, DateTime? SnoozedUntil = null);
    private record PrefResponseDto(bool QuietHoursEnabled, string? MutedTypes);
}
