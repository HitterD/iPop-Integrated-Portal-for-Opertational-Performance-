@page "/notifications"
@page "/notifications/inbox"
@inject NotificationSettingsState NotifSettings
@using System.Net.Http.Json
@using IPop.Web.Services
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthState Auth
@inject ToastService Toasts
@inject NotificationState Notifs
@inject PhoneState Phone
@using IPop.Web.Components.Phone.Notifications

<PageTitle>Notification Center — IPop</PageTitle>
<IPop.Web.Components.Phone.PullRefresh Prefix="/notifications" OnRefresh="ReloadAsync" />

<div class="notifs-v6 @((mDetail ? "m-detail" : "") + (Phone.IsPhone ? " m-nf-phone" : ""))">
    @if (Phone.IsPhone && !mDetail)
    {
        <NotificationsScreenPhone UnreadCount="unreadCount" Selecting="selecting" AllSelected="AllSelected" CanSelect="@(FilteredList.Count > 0)"
                                  Search="@searchQuery" SearchChanged="PhoneSearch"
                                  Rows="PhoneRows" Chips="PhoneChips" Filter="@categoryFilter" EmptyHint="@EmptyHint"
                                  SelectedIds="selectedIds"
                                  OnSelect="() => selecting = true" OnSelectAll="SelectAllToggle" OnDone="EndSelecting"
                                  OnMarkAllRead="MarkAllRead" OnPrefs="TogglePrefs" OnToggleSelect="ToggleItemSelection"
                                  OnBulkRead="BulkMarkRead" OnBulkDelete="BulkDelete"
                                  OnFilter="SetCategory" OnOpen="PhoneOpen" OnToggleRead="PhoneToggleRead"
                                  OnSnooze="PhoneSnoozeAsk" OnDelete="PhoneDelete" />
    }
    <div class="notifs-toolbar">
        <div class="v6-search notifs-search">
            <i data-lucide="search"></i>
            <input type="text" placeholder="Search notifications" aria-label="Search notifications" @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" />
        </div>
        <div class="notifs-toolbar-actions">
            <button type="button" class="nf-btn" disabled="@(unreadCount == 0)" @onclick="MarkAllRead">
                <i data-lucide="check-check"></i><span>Mark all read</span>
            </button>
            <button type="button" class="nf-btn @(showPrefs ? "on" : "")" aria-pressed="@(showPrefs ? "true" : "false")" @onclick="TogglePrefs">
                <i data-lucide="sliders-horizontal"></i><span>Preferences</span>
            </button>
        </div>
    </div>

    <div class="notifs-cols">
        @* Source list: flat on the page background, like the Mail sidebar. *@
        <nav class="notifs-side" aria-label="Notification categories">
            <div class="notifs-nav">
                @foreach (var c in CategoryList)
                {
                    var active = categoryFilter == c.Id;
                    var cCount = CountCategoryUnread(c.Id);
                    <button type="button" class="notifs-nav-item @(active ? "on" : "")" aria-current="@(active ? "true" : null)" @onclick="() => SetCategory(c.Id)">
                        <i data-lucide="@c.Icon" class="k-@c.Id"></i>
                        <span class="lbl">@c.Label</span>
                        @if (cCount > 0)
                        {
                            <span class="n">@cCount</span>
                        }
                    </button>
                }
            </div>

            <div class="notifs-dnd">
                <i data-lucide="moon"></i>
                <span class="notifs-dnd-txt">
                    <b>Do Not Disturb</b>
                    <small>@(quietHoursEnabled ? "On · 22:00 – 07:00" : "Off")</small>
                </span>
                <button type="button" class="apple-switch @(quietHoursEnabled ? "on" : "")" role="switch" aria-checked="@(quietHoursEnabled ? "true" : "false")" aria-label="Do Not Disturb" @onclick="ToggleDnd">
                    <span class="apple-switch-knob"></span>
                </button>
            </div>
        </nav>

        <div class="notifs-pane">
            <section class="notifs-list" aria-label="Notifications">
                <header class="notifs-list-head">
                    @if (selecting)
                    {
                        <button type="button" class="nf-link" @onclick="SelectAllToggle">@(AllSelected ? "Deselect all" : "Select all")</button>
                        <span class="notifs-list-title center">@(selectedIds.Count == 0 ? "Select items" : $"{selectedIds.Count} selected")</span>
                        <button type="button" class="nf-link strong" @onclick="EndSelecting">Done</button>
                    }
                    else
                    {
                        <span class="notifs-list-title">
                            <b>@CurrentCategoryTitle</b>
                            <small>@ListSummary</small>
                        </span>
                        <button type="button" class="nf-icon" title="Refresh" aria-label="Refresh" @onclick="ReloadAsync"><i data-lucide="rotate-cw"></i></button>
                        <button type="button" class="nf-link" disabled="@(FilteredList.Count == 0)" @onclick="() => selecting = true">Select</button>
                    }
                </header>

                <div class="notifs-scroll">
                    @if (isLoading && items.Count == 0)
                    {
                        <div class="notifs-skel"><div class="skel"></div><div class="skel"></div><div class="skel"></div></div>
                    }
                    else if (FilteredList.Count == 0)
                    {
                        <div class="notifs-empty">
                            <span class="notifs-empty-ico"><i data-lucide="@(string.IsNullOrWhiteSpace(searchQuery) ? "bell" : "search")"></i></span>
                            <b>@(string.IsNullOrWhiteSpace(searchQuery) ? "All caught up" : "No results")</b>
                            <span>@(string.IsNullOrWhiteSpace(searchQuery) ? EmptyHint : $"Nothing matches “{searchQuery.Trim()}”.")</span>
                        </div>
                    }
                    else
                    {
                        @foreach (var grp in GroupedNotifications)
                        {
                            <div class="notifs-day">@grp.Key</div>
                            @foreach (var n in grp)
                            {
                                var isSel = !selecting && selectedItem?.Id == n.Id;
                                var isChecked = selectedIds.Contains(n.Id);
                                var kind = Classify(n.Type);
                                <div class="notifs-row @(isSel ? "sel" : "") @(n.IsRead ? "" : "unread") @(isChecked ? "checked" : "")" @key="n.Id" data-nid="@n.Id"
                                     role="button" tabindex="0" aria-pressed="@(selecting ? (isChecked ? "true" : "false") : null)"
                                     @onclick="() => RowClick(n)" @onkeydown="e => SelectOnKey(e, n)">
                                    @if (selecting)
                                    {
                                        <span class="notifs-check" aria-hidden="true">@if (isChecked) { <i data-lucide="check"></i> }</span>
                                    }
                                    else
                                    {
                                        <span class="notifs-dot" title="@(n.IsRead ? null : "Unread")"></span>
                                    }
                                    <span class="nf-ico k-@kind"><i data-lucide="@GetIcon(n.Type)"></i></span>
                                    <span class="notifs-row-txt">
                                        <span class="notifs-row-top">
                                            <span class="notifs-row-title">@n.Title</span>
                                            <span class="notifs-row-time">@FormatTime(n.At)</span>
                                        </span>
                                        <span class="notifs-row-body">@n.Body</span>
                                        @if (IsSnoozed(n))
                                        {
                                            <span class="notifs-row-snz"><i data-lucide="alarm-clock"></i>Until @SnoozeLabel(n.SnoozedUntil!.Value)</span>
                                        }
                                    </span>
                                    @if (!selecting)
                                    {
                                        <span class="notifs-row-acts" @onclick:stopPropagation="true">
                                            <button type="button" class="nf-icon sm" title="@(n.IsRead ? "Mark as unread" : "Mark as read")" aria-label="@(n.IsRead ? "Mark as unread" : "Mark as read")" @onclick="() => ToggleReadStatus(n)"><i data-lucide="@(n.IsRead ? "mail" : "mail-open")"></i></button>
                                            <button type="button" class="nf-icon sm danger" title="Delete" aria-label="Delete" @onclick="() => DeleteItem(n)"><i data-lucide="trash-2"></i></button>
                                        </span>
                                    }
                                </div>
                            }
                        }
                    }
                </div>

                @if (selecting)
                {
                    <footer class="notifs-bulk">
                        <button type="button" class="nf-btn" disabled="@(selectedIds.Count == 0)" @onclick="BulkMarkRead"><i data-lucide="mail-open"></i><span>Mark as read</span></button>
                        <button type="button" class="nf-btn danger" disabled="@(selectedIds.Count == 0)" @onclick="BulkDelete"><i data-lucide="trash-2"></i><span>Delete</span></button>
                    </footer>
                }
            </section>

            <section class="notifs-detail" aria-label="@(showPrefs ? "Preferences" : "Notification")">
                @if (showPrefs)
                {
                    <header class="notifs-dt-bar">
                        @if (mDetail) { <button type="button" class="m-back nf-icon" aria-label="Back" @onclick="BackToList"><i data-lucide="chevron-left"></i></button> }
                        <span class="notifs-dt-bar-title">Preferences</span>
                        @if (!mDetail) { <button type="button" class="nf-icon" title="Close" aria-label="Close preferences" @onclick="TogglePrefs"><i data-lucide="x"></i></button> }
                    </header>
                    @if (Phone.IsPhone)
                    {
                        <NotificationPrefsPhone Dnd="quietHoursEnabled" Categories="PhoneCategories"
                                                OnDnd="ToggleDnd" OnCategory="ToggleMuteCategory" OnMore="NotifSettings.Open" />
                    }
                    else
                    {
                    <div class="notifs-dt-body">
                        <div class="nf-group">
                            <div class="nf-group-row">
                                <span class="nf-ico sm k-dnd"><i data-lucide="moon"></i></span>
                                <span class="nf-group-txt"><b>Do Not Disturb</b><small>Silence alerts from 22:00 to 07:00</small></span>
                                <button type="button" class="apple-switch @(quietHoursEnabled ? "on" : "")" role="switch" aria-checked="@(quietHoursEnabled ? "true" : "false")" aria-label="Do Not Disturb" @onclick="ToggleDnd"><span class="apple-switch-knob"></span></button>
                            </div>
                        </div>

                        <div class="nf-group-label">Allow notifications from</div>
                        <div class="nf-group">
                            @foreach (var c in CategoryList.Where(x => x.Id is not ("all" or "unread" or "snoozed")))
                            {
                                var allowed = !mutedCategories.Contains(c.Id);
                                <div class="nf-group-row">
                                    <span class="nf-ico sm k-@c.Id"><i data-lucide="@c.Icon"></i></span>
                                    <span class="nf-group-txt"><b>@c.Label</b></span>
                                    <button type="button" class="apple-switch @(allowed ? "on" : "")" role="switch" aria-checked="@(allowed ? "true" : "false")" aria-label="@c.Label" @onclick="() => ToggleMuteCategory(c.Id)"><span class="apple-switch-knob"></span></button>
                                </div>
                            }
                        </div>
                        <p class="nf-group-foot">Muted categories still collect here, but they don’t show banners or play sounds.</p>

                        <a class="nf-group nf-group-link" href="/notifications/settings" @onclick="NotifSettings.Open" @onclick:preventDefault>
                            <span class="nf-group-row">
                                <span class="nf-ico sm k-system"><i data-lucide="settings"></i></span>
                                <span class="nf-group-txt"><b>More settings</b><small>Channels, schedules and delivery history</small></span>
                                <i data-lucide="chevron-right" class="nf-chev"></i>
                            </span>
                        </a>
                    </div>
                    }
                }
                else if (selectedItem is not null)
                {
                    var kind = Classify(selectedItem.Type);
                    var snoozed = IsSnoozed(selectedItem);
                    var muted = mutedCategories.Contains(kind);
                    <header class="notifs-dt-bar">
                        @if (mDetail) { <button type="button" class="m-back nf-icon" aria-label="Back" @onclick="BackToList"><i data-lucide="chevron-left"></i></button> }
                        <span class="notifs-dt-bar-title"></span>
                        <button type="button" class="nf-icon" title="@(selectedItem.IsRead ? "Mark as unread" : "Mark as read")" aria-label="@(selectedItem.IsRead ? "Mark as unread" : "Mark as read")" @onclick="ToggleReadSelected"><i data-lucide="@(selectedItem.IsRead ? "mail" : "mail-open")"></i></button>
                        <button type="button" class="nf-icon wide @(snoozed ? "on" : "")" title="Snooze" aria-label="Snooze" aria-haspopup="menu" @onclick="OpenSnoozeMenu"><i data-lucide="alarm-clock"></i><i data-lucide="chevron-down" class="nf-caret"></i></button>
                        <button type="button" class="nf-icon @(muted ? "on" : "")" title="@(muted ? $"Unmute {GetCategoryName(selectedItem.Type)}" : $"Mute {GetCategoryName(selectedItem.Type)}")" aria-label="@(muted ? "Unmute this category" : "Mute this category")" aria-pressed="@(muted ? "true" : "false")" @onclick="() => MuteType(selectedItem.Type)"><i data-lucide="@(muted ? "bell-off" : "bell")"></i></button>
                        <span class="nf-sep"></span>
                        <button type="button" class="nf-icon danger" title="Delete" aria-label="Delete" @onclick="DeleteSelected"><i data-lucide="trash-2"></i></button>
                    </header>
                    <div class="notifs-dt-body">
                        <div class="notifs-dt-meta">
                            <span class="nf-ico lg k-@kind"><i data-lucide="@GetIcon(selectedItem.Type)"></i></span>
                            <span>
                                <b class="k-@kind">@GetCategoryName(selectedItem.Type)</b>
                                <small>@selectedItem.At.ToString("dddd, d MMMM yyyy 'at' HH:mm")</small>
                            </span>
                        </div>

                        <h2 class="notifs-dt-title">@selectedItem.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(selectedItem.Body))
                        {
                            <p class="notifs-dt-text">@selectedItem.Body</p>
                        }

                        @if (snoozed)
                        {
                            <div class="notifs-dt-snz">
                                <i data-lucide="alarm-clock"></i>
                                <span>Snoozed until @SnoozeLabel(selectedItem.SnoozedUntil!.Value)</span>
                                <button type="button" class="nf-link" @onclick="UnsnoozeSelected">Unsnooze</button>
                            </div>
                        }

                        @if (TargetOf(selectedItem) is not null)
                        {
                            <button type="button" class="notifs-target" @onclick="() => NavigateToTarget(selectedItem)">
                                <span>Open in @TargetName(selectedItem.Type)</span><i data-lucide="arrow-up-right"></i>
                            </button>
                        }

                        <dl class="notifs-dt-facts">
                            <div><dt>From</dt><dd>@SourceLabel(selectedItem.Source)</dd></div>
                            <div><dt>Priority</dt><dd class="@(IsHighPriority(selectedItem) ? "hi" : "")">@PriorityLabel(selectedItem.Priority)</dd></div>
                            <div><dt>Status</dt><dd>@(selectedItem.IsRead ? "Read" : "Unread")</dd></div>
                        </dl>
                    </div>
                }
                else
                {
                    <div class="notifs-empty">
                        <span class="notifs-empty-ico muted"><i data-lucide="bell"></i></span>
                        <b>No notification selected</b>
                        <span>Choose one from the list to read it here.</span>
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@if (snoozeMenuOpen && Phone.IsPhone)
{
    <SnoozeSheetPhone Options="@(SnoozeItems.Where(i => !i.IsHeader && !i.IsDivider).Select(i => new PhoneSnoozeOption(i.Label, i.Icon, i.OnClick)).ToList())"
                      OnClose="() => snoozeMenuOpen = false" />
}
else if (snoozeMenuOpen)
{
    <ContextMenu @ref="snoozeMenu" Items="SnoozeItems" OnClosed="() => snoozeMenuOpen = false" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    private List<NotificationItemDto> items = [];
    private HashSet<Guid> selectedIds = [];
    private bool isLoading = true;
    private int unreadCount = 0;
    private string categoryFilter = "all";
    private bool selecting;
    private bool snoozeMenuOpen;

    // ── Wave 2 phone list (NF1) / preferences (NF2): same data and actions as the desktop panes ──
    private static readonly string[] PhoneChipIds = ["all", "unread", "mention", "chat", "mail", "task", "meeting", "news", "system", "snoozed"];

    private IReadOnlyList<IPop.Web.Components.Phone.SegmentItem> PhoneChips => PhoneChipIds
        .Select(id => CategoryList.First(c => c.Id == id))
        .Select(c => new IPop.Web.Components.Phone.SegmentItem(c.Id, c.Id == "news" ? "News" : c.Label, c.Id == "unread" ? CountCategoryUnread("unread") : null))
        .ToList();

    private IReadOnlyList<PhoneNotifRow> PhoneRows => GroupedNotifications
        .SelectMany(g => g.Select(n => new PhoneNotifRow(n.Id, Classify(n.Type), GetIcon(n.Type), n.Title, n.Body, FormatTime(n.At),
            g.Key is "Today" ? "Today" : g.Key is "Yesterday" ? "Yesterday" : "Earlier", n.IsRead,
            IsSnoozed(n) ? $"Until {SnoozeLabel(n.SnoozedUntil!.Value)}" : null)))
        .ToList();

    private IReadOnlyList<PhoneNotifCategory> PhoneCategories => CategoryList
        .Where(x => x.Id is not ("all" or "unread" or "snoozed"))
        .Select(c => new PhoneNotifCategory(c.Id, c.Label, c.Icon, !mutedCategories.Contains(c.Id)))
        .ToList();

    private NotificationItemDto? Find(Guid id) => items.FirstOrDefault(x => x.Id == id);

    private Task PhoneSearch(string q) { searchQuery = q; return OnSearchChanged(); }

    private void PhoneOpen(Guid id) { if (Find(id) is { } n) SelectNotification(n); }

    private Task PhoneToggleRead(Guid id) => Find(id) is { } n ? ToggleReadStatus(n) : Task.CompletedTask;

    private Task PhoneDelete(Guid id) => Find(id) is { } n ? DeleteItem(n) : Task.CompletedTask;

    /// Swipe → Snooze: the same options as the detail bar's menu, as a bottom sheet.
    private void PhoneSnoozeAsk(Guid id)
    {
        if (Find(id) is not { } n) return;
        selectedItem = n;
        snoozeMenuOpen = true;
    }
    private (double X, double Y)? snoozeMenuAt;
    private ContextMenu? snoozeMenu;
    private string searchQuery = "";
    private bool showPrefs;
    private bool quietHoursEnabled;
    private HashSet<string> mutedCategories = [];
    private NotificationItemDto? selectedItem;
    private CancellationTokenSource? searchCts;

    private record CategoryDef(string Id, string Label, string Icon);
    private static readonly CategoryDef[] CategoryList =
    [
        new("all", "All", "inbox"),
        new("unread", "Unread", "circle-dot"),
        new("mention", "Mentions", "at-sign"),
        new("chat", "Chat", "message-circle"),
        new("mail", "Mail", "mail"),
        new("task", "Tasks", "kanban"),
        new("meeting", "Meetings", "calendar"),
        new("news", "Memos & News", "newspaper"),
        new("system", "System", "shield-check"),
        new("snoozed", "Snoozed", "alarm-clock"),
    ];

    private string CurrentCategoryTitle => CategoryList.FirstOrDefault(c => c.Id == categoryFilter)?.Label ?? "Notifications";

    private List<NotificationItemDto> FilteredList => items.Where(n =>
    {
        // Category filter
        if (categoryFilter == "unread" && n.IsRead) return false;
        if (categoryFilter == "snoozed" && (n.SnoozedUntil == null || n.SnoozedUntil <= DateTime.UtcNow)) return false;
        if (categoryFilter != "all" && categoryFilter != "unread" && categoryFilter != "snoozed")
        {
            var mod = Classify(n.Type);
            if (!mod.Equals(categoryFilter, StringComparison.OrdinalIgnoreCase)) return false;
        }

        // Search query
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            if (!n.Title.ToLowerInvariant().Contains(q) && !n.Body.ToLowerInvariant().Contains(q))
                return false;
        }

        return true;
    }).ToList();

    protected override async Task OnInitializedAsync()
    {
        Layout.SetHeader("Notifications", "Notification center");
        await LoadPreferences();
        await ReloadAsync();
        Notifs.UnreadChanged += OnLiveUnreadChanged;
    }

    private void OnLiveUnreadChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadPreferences()
    {
        try
        {
            var pref = await Auth.GetAsync<PrefResponseDto>("/api/notifications/v1/preferences");
            if (pref is not null)
            {
                quietHoursEnabled = pref.QuietHoursEnabled;
                mutedCategories = (pref.MutedTypes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
        }
        catch { }
    }

    private async Task ReloadAsync()
    {
        isLoading = true;
        try
        {
            var statusParam = categoryFilter == "snoozed" ? "snoozed" : null;
            var url = $"/api/notifications/v1/inbox?page=1&pageSize=100" + (statusParam != null ? $"&status={statusParam}" : "");
            var res = await Auth.GetAsync<InboxResultDto>(url);
            if (res is not null)
            {
                items = res.Items.Select(i => new NotificationItemDto(
                    i.Id, i.Type, i.Title, i.Body, i.Source,
                    i.At.Kind == DateTimeKind.Utc ? i.At.ToLocalTime() : i.At,
                    i.IsRead, i.Priority, i.TargetUrl, i.SnoozedUntil)).ToList();
                unreadCount = res.UnreadCount;
                Layout.SetSubtitle($"{unreadCount} unread · {items.Count} total");
                if (selectedItem is null && !showPrefs) selectedItem = items.FirstOrDefault();
                if (selectedItem != null)
                {
                    selectedItem = items.FirstOrDefault(x => x.Id == selectedItem.Id);
                }
            }
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private int CountCategoryUnread(string catId) => catId switch
    {
        "all" => items.Count(x => !x.IsRead && (x.SnoozedUntil == null || x.SnoozedUntil <= DateTime.UtcNow)),
        "unread" => items.Count(x => !x.IsRead && (x.SnoozedUntil == null || x.SnoozedUntil <= DateTime.UtcNow)),
        "snoozed" => items.Count(x => x.SnoozedUntil != null && x.SnoozedUntil > DateTime.UtcNow),
        _ => items.Count(x => !x.IsRead && Classify(x.Type) == catId && (x.SnoozedUntil == null || x.SnoozedUntil <= DateTime.UtcNow))
    };

    // Snoozed items only come back from the server when asked for, so entering or leaving
    // the Snoozed view reloads; every other category filters what is already loaded.
    private async Task SetCategory(string cat)
    {
        var reload = (cat == "snoozed") != (categoryFilter == "snoozed");
        categoryFilter = cat;
        selectedItem = null;
        EndSelecting();
        if (reload) await ReloadAsync();
    }

    private string ListSummary
    {
        get
        {
            var list = FilteredList;
            var unread = list.Count(x => !x.IsRead);
            var total = list.Count == 1 ? "1 notification" : $"{list.Count} notifications";
            return unread > 0 && categoryFilter != "unread" ? $"{total}, {unread} unread" : total;
        }
    }

    private string EmptyHint => categoryFilter switch
    {
        "unread" => "You’ve read everything.",
        "snoozed" => "Snoozed notifications wait here until their time comes.",
        "all" => "New notifications will show up here.",
        _ => $"Nothing from {CurrentCategoryTitle} right now."
    };

    // ---- Select mode (Mail-style "Select" → tap rows → act on the footer) ----
    private bool AllSelected => FilteredList.Count > 0 && FilteredList.All(x => selectedIds.Contains(x.Id));

    private void SelectAllToggle()
    {
        if (AllSelected) selectedIds.Clear();
        else selectedIds = FilteredList.Select(x => x.Id).ToHashSet();
    }

    private void EndSelecting()
    {
        selecting = false;
        selectedIds.Clear();
    }

    private void RowClick(NotificationItemDto n)
    {
        if (selecting) ToggleItemSelection(n.Id);
        else SelectNotification(n);
    }

    // ---- Snooze menu ----
    private void OpenSnoozeMenu(MouseEventArgs e)
    {
        snoozeMenuOpen = true;
        snoozeMenuAt = (e.ClientX - 150, e.ClientY + 14);
    }

    private IReadOnlyList<ContextMenu.Item> SnoozeItems
    {
        get
        {
            var list = new List<ContextMenu.Item>
            {
                ContextMenu.Item.Header("Snooze until"),
                new("In 1 hour", "clock", () => Snooze(1)),
                new($"This evening ({EveningTarget:HH:mm}{(EveningTarget.Date == DateTime.Today ? "" : ", tomorrow")})", "sunset", SnoozeTonight),
                new($"Tomorrow morning ({DateTime.Today.AddDays(1).AddHours(8):ddd} 08:00)", "sunrise", SnoozeTomorrow),
                new($"Next week ({NextMonday:ddd d MMM}, 08:00)", "calendar", SnoozeNextWeek),
            };
            if (selectedItem is not null && IsSnoozed(selectedItem))
            {
                list.Add(ContextMenu.Item.Divider());
                list.Add(new("Unsnooze", "alarm-clock-off", UnsnoozeSelected));
            }
            return list;
        }
    }

    private static DateTime EveningTarget
    {
        get
        {
            var t = DateTime.Today.AddHours(20);
            return t <= DateTime.Now ? t.AddDays(1) : t;
        }
    }

    private static DateTime NextMonday
    {
        get
        {
            var days = ((int)DayOfWeek.Monday - (int)DateTime.Today.DayOfWeek + 7) % 7;
            return DateTime.Today.AddDays(days == 0 ? 7 : days).AddHours(8);
        }
    }

    private static bool IsSnoozed(NotificationItemDto n) => n.SnoozedUntil is { } s && s > DateTime.UtcNow;

    private static string SnoozeLabel(DateTime utc)
    {
        var local = utc.Kind == DateTimeKind.Local ? utc : DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();
        if (local.Date == DateTime.Today) return $"today {local:HH:mm}";
        if (local.Date == DateTime.Today.AddDays(1)) return $"tomorrow {local:HH:mm}";
        return local.ToString("ddd d MMM, HH:mm");
    }

    // ---- Detail labels ----
    private static string SourceLabel(string? source) => string.IsNullOrWhiteSpace(source) || source.Equals("system", StringComparison.OrdinalIgnoreCase)
        ? "IPop"
        : char.ToUpperInvariant(source[0]) + source[1..].Replace('_', ' ').Replace('-', ' ');

    private static bool IsHighPriority(NotificationItemDto n) => n.Priority?.ToLowerInvariant() is "high" or "urgent" or "critical";

    private static string PriorityLabel(string? p) => p?.ToLowerInvariant() switch
    {
        "high" => "High",
        "urgent" or "critical" => "Urgent",
        "low" => "Low",
        _ => "Normal"
    };

    private static string? TargetOf(NotificationItemDto item) => !string.IsNullOrEmpty(item.TargetUrl) ? item.TargetUrl : Classify(item.Type) switch
    {
        "mention" or "chat" => "/chat",
        "mail" => "/mail",
        "task" => "/projects",
        "meeting" => "/calls?tab=scheduled",
        "news" => "/news",
        _ => null
    };

    private static string TargetName(string type) => Classify(type) switch
    {
        "mention" or "chat" => "Chat",
        "mail" => "Mail",
        "task" => "Projects",
        "meeting" => "Calls & Meetings",
        "news" => "News",
        _ => "IPop"
    };

    private async Task TogglePrefs()
    {
        showPrefs = !showPrefs;
        if (showPrefs) await OpenMobileDetail();
        else if (mDetail) await BackToList();
    }

    // ---- Phone list/detail (see .scratch/backup-mobile/CONTRACT.md) ----
    private bool mDetail;
    private DotNetObjectReference<Notifications>? mRef;

    private async Task OpenMobileDetail()
    {
        if (mDetail) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("ipop.mobile.isMobile")) return;
            mRef ??= DotNetObjectReference.Create(this);
            mDetail = true;
            await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", mRef, nameof(CloseMobileDetail));
        }
        catch { }
    }

    private async Task BackToList()
    {
        if (!mDetail) return;
        mDetail = false;
        if (showPrefs) showPrefs = false;
        try { await JS.InvokeVoidAsync("ipop.mobile.popDetail"); } catch { }
    }

    /// Phone/browser Back popped our history entry.
    [JSInvokable]
    public Task CloseMobileDetail()
    {
        mDetail = false; showPrefs = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ToggleDnd()
    {
        quietHoursEnabled = !quietHoursEnabled;
        try
        {
            await Auth.SendAsync(HttpMethod.Put, "/api/notifications/v1/preferences", new
            {
                quietHoursEnabled,
                quietStart = "22:00",
                quietEnd = "07:00",
                mutedTypes = string.Join(',', mutedCategories)
            });
            Toasts.ShowDetailed("DND Updated", quietHoursEnabled ? "Do Not Disturb enabled (22:00–07:00)" : "Do Not Disturb disabled", ToastKind.Success, "moon");
        }
        catch { }
    }

    private async Task ToggleMuteCategory(string type)
    {
        var next = !mutedCategories.Contains(type);
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/preferences/mute-type", new { type, muted = next });
            if (res.IsSuccessStatusCode)
            {
                if (next) mutedCategories.Add(type);
                else mutedCategories.Remove(type);
                Toasts.ShowDetailed("Category Updated", next ? $"{type} notifications muted" : $"{type} notifications unmuted", ToastKind.Success, "bell-off");
            }
        }
        catch { }
    }

    private async Task OnSearchChanged()
    {
        searchCts?.Cancel();
        searchCts?.Dispose();
        var t = new CancellationTokenSource();
        searchCts = t;
        try { await Task.Delay(200, t.Token); }
        catch (OperationCanceledException) { return; }
        StateHasChanged();
    }

    private void SelectOnKey(KeyboardEventArgs e, NotificationItemDto item)
    {
        if (e.Key is "Enter" or " ") SelectNotification(item);
    }

    private void SelectNotification(NotificationItemDto item)
    {
        selectedItem = item;
        showPrefs = false;
        _ = InvokeAsync(async () => { await OpenMobileDetail(); StateHasChanged(); });
        if (!item.IsRead)
        {
            _ = MarkReadAsync(item.Id);
        }
    }

    private async Task MarkReadAsync(Guid id)
    {
        var item = items.FirstOrDefault(x => x.Id == id);
        if (item is not null && !item.IsRead)
        {
            item.IsRead = true;
            unreadCount = Math.Max(0, unreadCount - 1);
            await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{id}/read", new { });
            Notifs.SetUnread(unreadCount);
        }
    }

    private async Task Snooze(double hours)
    {
        if (selectedItem is null) return;
        var until = DateTime.UtcNow.AddHours(hours);
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{selectedItem.Id}/snooze", new { until });
        if (res.IsSuccessStatusCode)
        {
            selectedItem.SnoozedUntil = until;
            Toasts.ShowDetailed("Snoozed", hours == 1 ? "It’ll come back in an hour" : $"It’ll come back in {hours} hours", ToastKind.Success, "alarm-clock");
            await ReloadAsync();
        }
    }

    private async Task SnoozeTonight()
    {
        var now = DateTime.UtcNow;
        var target = DateTime.Today.AddHours(20);
        if (target <= DateTime.Now) target = target.AddDays(1);
        await SnoozeUntilTime(target.ToUniversalTime(), target.Date == DateTime.Today ? "this evening at 20:00" : "tomorrow at 20:00");
    }

    private async Task SnoozeTomorrow()
    {
        var target = DateTime.Today.AddDays(1).AddHours(8);
        await SnoozeUntilTime(target.ToUniversalTime(), "tomorrow at 08:00");
    }

    private async Task SnoozeNextWeek()
    {
        var days = ((int)DayOfWeek.Monday - (int)DateTime.Today.DayOfWeek + 7) % 7;
        if (days == 0) days = 7;
        var target = DateTime.Today.AddDays(days).AddHours(8);
        await SnoozeUntilTime(target.ToUniversalTime(), "next Monday at 08:00");
    }

    private async Task SnoozeUntilTime(DateTime utc, string label)
    {
        if (selectedItem is null) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{selectedItem.Id}/snooze", new { until = utc });
        if (res.IsSuccessStatusCode)
        {
            selectedItem.SnoozedUntil = utc;
            Toasts.ShowDetailed("Snoozed", $"It’ll come back {label}", ToastKind.Success, "alarm-clock");
            await ReloadAsync();
        }
    }

    private async Task UnsnoozeSelected()
    {
        if (selectedItem is null) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{selectedItem.Id}/unsnooze", new { });
        if (res.IsSuccessStatusCode)
        {
            selectedItem.SnoozedUntil = null;
            Toasts.ShowDetailed("Unsnoozed", "Moved back to your notifications", ToastKind.Success, "check");
            await ReloadAsync();
        }
    }

    private void ToggleItemSelection(Guid id)
    {
        if (!selectedIds.Add(id)) selectedIds.Remove(id);
    }

    private async Task DeleteItem(NotificationItemDto n)
    {
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/notifications/v1/notifications/{n.Id}", null);
        if (res.IsSuccessStatusCode)
        {
            await LeaveRowsAsync([n.Id]);
            items.RemoveAll(x => x.Id == n.Id);
            selectedIds.Remove(n.Id);
            if (selectedItem?.Id == n.Id) selectedItem = null;
            Toasts.Show("Notification deleted.", ToastKind.Success);
            await ReloadAsync();
        }
        else
        {
            Toasts.Show("Could not delete notification.", ToastKind.Error);
        }
    }

    private async Task DeleteSelected()
    {
        if (selectedItem is null) return;
        await DeleteItem(selectedItem);
        await BackToList();
    }

    private async Task BulkDelete()
    {
        if (selectedIds.Count == 0) return;
        var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/notifications/bulk-delete", new { requestIds = selectedIds.ToList() });
        if (res.IsSuccessStatusCode)
        {
            await LeaveRowsAsync(selectedIds.ToList());
            items.RemoveAll(x => selectedIds.Contains(x.Id));
            if (selectedItem is not null && selectedIds.Contains(selectedItem.Id)) selectedItem = null;
            EndSelecting();
            Toasts.Show("Notifications deleted.", ToastKind.Success);
            await ReloadAsync();
        }
    }

    private async Task BulkMarkRead()
    {
        if (selectedIds.Count == 0) return;
        var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/notifications/bulk-read", new { requestIds = selectedIds.ToList() });
        if (res.IsSuccessStatusCode)
        {
            // In the Unread view, read rows leave the list: slide them out first.
            if (categoryFilter == "unread") await LeaveRowsAsync(selectedIds.ToList());
            foreach (var item in items.Where(x => selectedIds.Contains(x.Id))) item.IsRead = true;
            EndSelecting();
            Toasts.Show("Notifications marked as read.", ToastKind.Success);
            await ReloadAsync();
        }
    }

    private IEnumerable<IGrouping<string, NotificationItemDto>> GroupedNotifications =>
        FilteredList.GroupBy(n =>
        {
            var local = n.At.ToLocalTime().Date;
            var today = DateTime.Today;
            if (local == today) return "Today";
            if (local == today.AddDays(-1)) return "Yesterday";
            if (local >= today.AddDays(-7)) return "Earlier this week";
            return "Older";
        });

    private async Task ToggleReadStatus(NotificationItemDto n)
    {
        if (n.IsRead)
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{n.Id}/unread", new { });
            if (res.IsSuccessStatusCode)
            {
                n.IsRead = false;
                unreadCount++;
            }
        }
        else
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{n.Id}/read", new { });
            if (res.IsSuccessStatusCode)
            {
                if (categoryFilter == "unread") await LeaveRowsAsync([n.Id]);
                n.IsRead = true;
                if (unreadCount > 0) unreadCount--;
            }
        }
        Notifs.SetUnread(unreadCount);
        StateHasChanged();
    }

    private async Task ToggleReadSelected()
    {
        if (selectedItem is null) return;
        await ToggleReadStatus(selectedItem);
    }

    private async Task MuteType(string type)
    {
        var cat = Classify(type);
        var muted = !mutedCategories.Contains(cat);
        var res = await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/preferences/mute-type", new { type = cat, muted });
        if (res.IsSuccessStatusCode)
        {
            if (muted) mutedCategories.Add(cat);
            else mutedCategories.Remove(cat);
            Toasts.ShowDetailed(muted ? "Category Muted" : "Category Unmuted", $"{GetCategoryName(type)} notifications {(muted ? "muted" : "unmuted")}", ToastKind.Success, muted ? "bell-off" : "bell");
            StateHasChanged();
        }
    }

    /// Micro #9: rows about to disappear slide out (300ms) before the list drops them.
    private async Task LeaveRowsAsync(IReadOnlyCollection<Guid> ids)
    {
        if (ids.Count == 0 || ids.Count > 30) return; // a mass removal just closes the gap
        try { await Task.WhenAll(ids.Select(id => JS.InvokeVoidAsync("ipopMicro.leaveSelector", $".notifs-row[data-nid=\"{id}\"]").AsTask())); }
        catch { /* motion is optional */ }
    }

    private async Task MarkAllRead()
    {
        await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/inbox/read-all", new { });
        if (categoryFilter == "unread") await LeaveRowsAsync(items.Where(i => !i.IsRead).Select(i => i.Id).ToList());
        foreach (var i in items) i.IsRead = true;
        unreadCount = 0;
        Notifs.SetUnread(0);
        Toasts.ShowDetailed("All Read", "All notifications marked as read", ToastKind.Success, "check-check");
    }

    private void NavigateToTarget(NotificationItemDto item)
    {
        if (TargetOf(item) is { } target) Nav.NavigateTo(target);
    }

    private static string Classify(string type)
    {
        var e = type.ToLowerInvariant();
        if (e.Contains("mention")) return "mention";
        if (e.StartsWith("chat.") || e == "chat") return "chat";
        if (e.StartsWith("mail.") || e == "mail") return "mail";
        if (e.StartsWith("meeting.") || e.StartsWith("call.") || e == "meeting") return "meeting";
        if (e.StartsWith("news.") || e.StartsWith("memo.") || e == "news") return "news";
        if (e.StartsWith("project.") || e.StartsWith("task.") || e == "project" || e == "task") return "task";
        return "system";
    }

