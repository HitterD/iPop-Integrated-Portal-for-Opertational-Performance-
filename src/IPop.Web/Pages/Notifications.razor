    private static string GetIconColor(string type) => Classify(type) switch
    {
        "mention" => "#0288D1",
        "chat" => "#1C7A44",
        "mail" => "#0A63D1",
        "task" => "#7657C4",
        "meeting" => "#5E35B1",
