@page "/mail/new"
@using IPop.Web.Components.Mail
@using IPop.Web.Services
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>New Mail — IPop</PageTitle>

<div class="new-mail-page">
    @* Header *@
    <div class="new-mail-header">
        <button type="button" class="back-btn" @onclick="GoBack" title="Back to Mail">
            <i data-lucide="arrow-left"></i>
        </button>
        <h1 class="page-title">New Message</h1>
        <div class="header-actions">
            <button type="button" class="action-btn" title="Save draft" @onclick="SaveDraft">
                <i data-lucide="save"></i>
            </button>
            <button type="button" class="action-btn" title="Discard" @onclick="Discard">
                <i data-lucide="trash-2"></i>
            </button>
        </div>
    </div>

    <div class="new-mail-body">
        @* Recipients *@
        <div class="form-section">
            <div class="recipient-row">
                <span class="recipient-label">To</span>
                <div class="recipient-input-wrap">
                    <input type="text"
                           class="recipient-input"
                           placeholder="Add recipients…"
                           @bind="toInput"
                           @bind:event="oninput"
                           @onkeydown="OnToKeyDown" />
                    <div class="chips">
                        @foreach (var r in toRecipients)
                        {
                            <span class="chip">
                                @r
                                <button type="button" class="chip-x" @onclick="() => toRecipients.Remove(r)">
                                    <i data-lucide="x"></i>
                                </button>
                            </span>
                        }
                    </div>
                </div>
                <div class="cc-bcc-toggles">
                    @if (!showCc) { <button type="button" @onclick="() => showCc = true">Cc</button> }
                    @if (!showBcc) { <button type="button" @onclick="() => showBcc = true">Bcc</button> }
                </div>
            </div>

            @if (showCc)
            {
                <div class="recipient-row">
                    <span class="recipient-label">Cc</span>
                    <div class="recipient-input-wrap">
                        <input type="text" class="recipient-input" placeholder="Add Cc recipients…" @bind="ccInput" @bind:event="oninput" />
                        <div class="chips">
                            @foreach (var r in ccRecipients)
                            {
                                <span class="chip">
                                    @r
                                    <button type="button" class="chip-x" @onclick="() => ccRecipients.Remove(r)">
                                        <i data-lucide="x"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (showBcc)
            {
                <div class="recipient-row">
                    <span class="recipient-label">Bcc</span>
                    <div class="recipient-input-wrap">
                        <input type="text" class="recipient-input" placeholder="Add Bcc recipients…" @bind="bccInput" @bind:event="oninput" />
                        <div class="chips">
                            @foreach (var r in bccRecipients)
                            {
                                <span class="chip">
                                    @r
                                    <button type="button" class="chip-x" @onclick="() => bccRecipients.Remove(r)">
                                        <i data-lucide="x"></i>
                                    </button>
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Subject *@
        <div class="form-section">
            <input type="text"
                   class="subject-input"
                   placeholder="Add a subject"
                   @bind="subject"
                   @bind:event="oninput" />
        </div>

        @* Attachments Area with Drag & Drop *@
        <div class="form-section">
            <div class="attachments-area @(isDragging ? "drag-over" : "")" @ref="dropZoneRef">

                @if (attachments.Count == 0)
                {
                    <div class="drop-zone">
                        <i data-lucide="paperclip"></i>
                        <span class="drop-text">Drag & drop files here, or</span>
                        <button type="button" class="browse-btn" @onclick="TriggerFileInput">browse</button>
                        <span class="drop-hint">Supports images, documents, and archives (max 25MB each)</span>
                    </div>
                }
                else
                {
                    <div class="attachments-grid">
                        @foreach (var att in attachments)
                        {
                            var item = att;
                            <div class="attachment-card @(item.IsImage ? "is-image" : "")" @key="item.Id">
                                @if (item.IsImage && !string.IsNullOrEmpty(item.PreviewUrl))
                                {
                                    <div class="attachment-preview">
                                        <img src="@item.PreviewUrl" alt="@item.FileName" />
                                        <div class="attachment-overlay">
                                            <button type="button" class="overlay-btn" title="Remove" @onclick="() => RemoveAttachment(item)">
                                                <i data-lucide="x"></i>
                                            </button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="attachment-icon" style="--accent:@GetFileColor(item.FileName)">
                                        <i data-lucide="@GetFileIcon(item.FileName)"></i>
                                    </div>
                                }
                                <div class="attachment-info">
                                    <span class="attachment-name" title="@item.FileName">@item.FileName</span>
                                    <span class="attachment-size">@FormatFileSize(item.FileSize)</span>
                                </div>
                                @if (!item.IsImage)
                                {
                                    <button type="button" class="remove-btn" title="Remove" @onclick="() => RemoveAttachment(item)">
                                        <i data-lucide="x"></i>
                                    </button>
                                }
                            </div>
                        }

                        @* Add more button *@
                        <button type="button" class="add-more-card" @onclick="TriggerFileInput">
                            <i data-lucide="plus"></i>
                            <span>Add more</span>
                        </button>
                    </div>
                }
            </div>
            <InputFile @ref="fileInput" OnChange="OnFilesSelected" class="hidden-input" multiple />
        </div>

        @* Rich Text Editor Area *@
        <div class="form-section editor-section">
            <div class="editor-toolbar">
                <button type="button" class="tool-btn" title="Bold" @onclick='() => InsertFormat("b")'>
                    <i data-lucide="bold"></i>
                </button>
                <button type="button" class="tool-btn" title="Italic" @onclick='() => InsertFormat("i")'>
                    <i data-lucide="italic"></i>
                </button>
                <button type="button" class="tool-btn" title="Underline" @onclick='() => InsertFormat("u")'>
                    <i data-lucide="underline"></i>
                </button>
                <span class="tool-sep"></span>
                <button type="button" class="tool-btn" title="Insert link" @onclick="InsertLink">
                    <i data-lucide="link"></i>
                </button>
                <button type="button" class="tool-btn" title="Insert image" @onclick="TriggerImageInput">
                    <i data-lucide="image"></i>
                </button>
                <span class="tool-sep"></span>
                <button type="button" class="tool-btn" title="Bullet list" @onclick='() => InsertList("ul")'>
                    <i data-lucide="list"></i>
                </button>
                <button type="button" class="tool-btn" title="Numbered list" @onclick='() => InsertList("ol")'>
                    <i data-lucide="list-ordered"></i>
                </button>
            </div>
            <div class="editor-content"
                 contenteditable="true"
                 @ref="editorRef"
                 @oninput="OnEditorInput"
                 placeholder="Type your message here…">
            </div>
            <div class="editor-hint">
                <i data-lucide="info"></i>
                <span>Tip: Press Ctrl+V to paste text or images directly from clipboard</span>
            </div>
        </div>

        @* Footer Actions *@
        <div class="new-mail-footer">
            <div class="footer-left">
                <select class="priority-select" @bind="priority">
                    <option value="normal">Normal Priority</option>
                    <option value="high">❗ High Importance</option>
                    <option value="low">↓ Low Importance</option>
                </select>

                <button type="button" class="schedule-btn" @onclick="() => showSchedule = !showSchedule">
                    <i data-lucide="clock"></i>
                    Schedule send
                </button>

                @if (showSchedule)
                {
                    <div class="schedule-dropdown">
                        <button type="button" @onclick='() => ScheduleSend("1h")'>In 1 hour</button>
                        <button type="button" @onclick='() => ScheduleSend("3h")'>In 3 hours</button>
                        <button type="button" @onclick='() => ScheduleSend("tomorrow")'>Tomorrow morning</button>
                        <button type="button" @onclick='() => ScheduleSend("custom")'>Pick date & time…</button>
                    </div>
                }
            </div>

            <div class="footer-right">
                <button type="button" class="btn-secondary" @onclick="() => showPreview = true">
                    <i data-lucide="eye"></i>
                    Preview
                </button>
                <button type="button" class="btn-secondary" @onclick="SaveDraft">
                    Save draft
                </button>
                <button type="button" class="btn-primary" @onclick="SendMail" disabled="@(toRecipients.Count == 0 || sending)">
                    <i data-lucide="send"></i>
                    @(sending ? "Sending…" : "Send")
                </button>
            </div>
        </div>
    </div>

    @* Preview Panel *@
    <MailPreviewPanel IsOpen="@showPreview"
                      Mode="@previewMode"
                      Subject="@subject"
                      Body="@editorBody"
                      SenderName="Current User"
                      SenderEmail="user@company.com"
                      ToRecipients="@toRecipients"
                      CcRecipients="@ccRecipients"
                      Attachments="@previewAttachments"
                      OnClose="() => showPreview = false"
                      OnExportPdf="ExportPdf"
                      OnPrint="Print"
                      OnSend="SendMail" />
</div>

<style>
    .new-mail-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--bg);
    }

    .new-mail-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
    }

    .back-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--ink-2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .back-btn:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .page-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--ink);
        margin: 0;
        flex: 1;
    }

    .header-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--surface);
        color: var(--ink-2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .action-btn:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .new-mail-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        max-width: 900px;
        margin: 0 auto;
        width: 100%;
    }

    .form-section {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
    }

    .recipient-row {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px solid var(--line-soft);
    }

    .recipient-row:last-child {
        border-bottom: none;
    }

    .recipient-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--ink-2);
        min-width: 40px;
        padding-top: 8px;
    }

    .recipient-input-wrap {
        flex: 1;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .recipient-input {
        flex: 1;
        min-width: 150px;
        border: none;
        background: transparent;
        font-size: 14px;
        color: var(--ink);
        padding: 6px 0;
    }

    .recipient-input:focus {
        outline: none;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        background: var(--accent-soft);
        color: var(--accent-ink);
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
    }

    .chip-x {
        width: 16px;
        height: 16px;
        border: none;
        background: transparent;
        color: var(--accent-ink);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        opacity: 0.7;
    }

    .chip-x:hover {
        opacity: 1;
        background: rgba(0,0,0,0.1);
    }

    .cc-bcc-toggles {
        display: flex;
        gap: 8px;
    }

    .cc-bcc-toggles button {
        border: none;
        background: transparent;
        color: var(--ink-3);
        font-size: 12px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
    }

    .cc-bcc-toggles button:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .subject-input {
        width: 100%;
        border: none;
        background: transparent;
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
        padding: 8px 0;
    }

    .subject-input:focus {
        outline: none;
    }

    .subject-input::placeholder {
        color: var(--ink-3);
        font-weight: 400;
    }

    /* Attachments Area */
    .attachments-area {
        min-height: 120px;
        border: 2px dashed var(--line);
        border-radius: 12px;
        transition: all 0.2s ease;
    }

    .attachments-area.drag-over {
        border-color: var(--accent);
        background: var(--accent-soft);
    }

    .drop-zone {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        text-align: center;
        color: var(--ink-3);
    }

    .drop-zone .lucide {
        width: 40px;
        height: 40px;
        margin-bottom: 12px;
        opacity: 0.5;
    }

    .drop-text {
        font-size: 14px;
        margin-bottom: 4px;
    }

    .browse-btn {
        border: none;
        background: transparent;
        color: var(--accent);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
    }

    .drop-hint {
        font-size: 12px;
        color: var(--ink-3);
        margin-top: 8px;
    }

    .attachments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
        padding: 12px;
    }

    .attachment-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.15s ease;
    }

    .attachment-card:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow-sm);
    }

    .attachment-card.is-image {
        aspect-ratio: 1;
    }

    .attachment-preview {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .attachment-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .attachment-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .attachment-card:hover .attachment-overlay {
        opacity: 1;
    }

    .overlay-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: var(--danger);
        color: white;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .attachment-icon {
        width: 100%;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--tray);
        color: var(--accent, var(--accent-ink));
    }

    .attachment-icon .lucide {
        width: 32px;
        height: 32px;
    }

    .attachment-info {
        padding: 10px;
    }

    .attachment-name {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: var(--ink);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .attachment-size {
        font-size: 11px;
        color: var(--ink-3);
    }

    .remove-btn {
        position: absolute;
        top: 6px;
        right: 6px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: none;
        background: var(--surface);
        color: var(--ink-2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-sm);
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .attachment-card:hover .remove-btn {
        opacity: 1;
    }

    .remove-btn:hover {
        background: var(--danger);
        color: white;
    }

    .add-more-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 20px;
        background: var(--tray);
        border: 2px dashed var(--line);
        border-radius: 10px;
        color: var(--ink-3);
        cursor: pointer;
        transition: all 0.15s ease;
        min-height: 120px;
    }

    .add-more-card:hover {
        border-color: var(--accent);
        color: var(--accent-ink);
        background: var(--accent-soft);
    }

    .hidden-input {
        display: none;
    }

    /* Editor */
    .editor-section {
        min-height: 300px;
        display: flex;
        flex-direction: column;
    }

    .editor-toolbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 8px;
        border-bottom: 1px solid var(--line-soft);
        margin-bottom: 12px;
    }

    .tool-btn {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        border: none;
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s ease;
    }

    .tool-btn:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .tool-sep {
        width: 1px;
        height: 20px;
        background: var(--line);
        margin: 0 6px;
    }

    .editor-content {
        flex: 1;
        min-height: 200px;
        padding: 8px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--ink);
        outline: none;
    }

    .editor-content:empty::before {
        content: attr(placeholder);
        color: var(--ink-3);
    }

    .editor-content img {
        max-width: 100%;
        border-radius: 8px;
        margin: 8px 0;
    }

    /* Freeform image layer */
    .editor-content .freeform-image {
        position: relative;
        display: inline-block;
        margin: 8px 0;
        cursor: move;
        user-select: none;
    }

    .editor-content .freeform-image img {
        display: block;
        max-width: 100%;
        border-radius: 8px;
        pointer-events: none;
    }

    .editor-content .freeform-image .resize-handle {
        position: absolute;
        width: 12px;
        height: 12px;
        background: var(--accent);
        border: 2px solid white;
        border-radius: 50%;
        cursor: nwse-resize;
        opacity: 0;
        transition: opacity 0.15s ease;
    }

    .editor-content .freeform-image:hover .resize-handle {
        opacity: 1;
    }

    .editor-content .freeform-image .resize-handle.br {
        bottom: -6px;
        right: -6px;
    }

    .editor-content .freeform-image .image-toolbar {
        position: absolute;
        top: -32px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 4px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 2px;
        opacity: 0;
        transition: opacity 0.15s ease;
        box-shadow: var(--shadow-sm);
    }

    .editor-content .freeform-image:hover .image-toolbar {
        opacity: 1;
    }

    .editor-content .freeform-image .image-toolbar button {
        width: 24px;
        height: 24px;
        border: none;
        background: transparent;
        color: var(--ink-2);
        cursor: pointer;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .editor-content .freeform-image .image-toolbar button:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .editor-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px;
        margin-top: 8px;
        font-size: 12px;
        color: var(--ink-3);
        background: var(--tray);
        border-radius: 6px;
    }

    .editor-hint .lucide {
        width: 14px;
        height: 14px;
    }

    /* Footer */
    .new-mail-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        background: var(--surface);
        border-top: 1px solid var(--line);
        position: sticky;
        bottom: 0;
    }

    .footer-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .priority-select {
        padding: 8px 12px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        color: var(--ink);
        font-size: 13px;
        cursor: pointer;
    }

    .schedule-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        color: var(--ink-2);
        font-size: 13px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .schedule-btn:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .schedule-dropdown {
        position: absolute;
        bottom: 100%;
        left: 0;
        margin-bottom: 8px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
        min-width: 180px;
    }

    .schedule-dropdown button {
        display: block;
        width: 100%;
        padding: 10px 16px;
        border: none;
        background: transparent;
        color: var(--ink);
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .schedule-dropdown button:hover {
        background: var(--tray);
    }

    .footer-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-secondary {
        padding: 10px 20px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface);
        color: var(--ink-2);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-secondary:hover {
        background: var(--tray);
        color: var(--ink);
    }

    .btn-primary {
        display: flex;
        align-items: center;
