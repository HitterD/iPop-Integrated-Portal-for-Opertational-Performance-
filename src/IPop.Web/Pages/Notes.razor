@page "/notes"
@page "/notes/{Id:guid}"
@implements IAsyncDisposable
@using IPop.Application.Notes
@inject AuthState Auth
@inject NotificationState Notifs
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject TutorialState Tutorials
@inject IPop.Web.Services.PageCache Cache

<PageTitle>@(note is null ? "Notes" : $"{DisplayTitle(note.Title)} - Notes") - IPop</PageTitle>

<div class="notes-page @(sideOpen ? "side-open" : "")">
    @* ── Sidebar ──────────────────────────────────────────────────────────── *@
    <aside class="nt-side" aria-label="Notes" @ref="sideRef">
        <div class="nt-side-head">
            <h1>Notes</h1>
            <button type="button" class="nt-icon-btn nt-mobile-only" title="Close" @onclick="() => sideOpen = false"><i data-lucide="x"></i></button>
        </div>
        <label class="nt-search">
            <i data-lucide="search" class="sm"></i>
            <input @ref="searchRef" placeholder="Search notes" value="@searchQ" @oninput="OnSearchInput" @onkeydown="OnSearchKey" aria-label="Search notes" />
            @if (!string.IsNullOrEmpty(searchQ)) { <button type="button" class="nt-icon-btn" style="width:20px;height:20px" title="Clear" @onclick="ClearSearch"><i data-lucide="x" class="sm"></i></button> }
        </label>
        <div class="nt-new">
            <button type="button" class="nt-new-main" title="New page (Alt N)" disabled="@creating" @onclick="() => CreateBlank(null)"><i data-lucide="plus" class="sm"></i>New page</button>
            <button type="button" class="nt-new-more" title="New from a template" aria-haspopup="menu" @onclick="OpenNewMenu"><i data-lucide="chevron-down" class="sm"></i></button>
        </div>

        <div class="nt-side-scroll">
            @if (!string.IsNullOrWhiteSpace(searchQ))
            {
                <div class="nt-sect">Search results</div>
                <div class="nt-hits">
                    @if (hits is null) { <div class="nt-side-empty">Searching…</div> }
                    else if (hits.Count == 0) { <div class="nt-side-empty">Nothing matches “@searchQ”.</div> }
                    else
                    {
                        @foreach (var h in hits)
                        {
                            <button type="button" class="nt-hit" @onclick="() => Open(h.Id)">
                                <div class="ht"><span>@(h.Emoji ?? "📄")</span><span>@DisplayTitle(h.Title)</span></div>
                                @if (!string.IsNullOrEmpty(h.Snippet)) { <div class="hs">@h.Snippet</div> }
                            </button>
                        }
                    }
                </div>
            }
            else if (sidebar is null)
            {
                <div class="nt-side-empty" style="padding-top:12px">Loading…</div>
            }
            else
            {
                var guide = sidebar.Pages.FirstOrDefault(p => p.IsGuide && p.IsMine);
                if (guide is not null && (!GuideHidden(guide) || IsActive(guide.Id)))
                {
                    <div class="nt-row guide @(IsActive(guide.Id) ? "active" : "")" role="button" tabindex="0" data-id="@guide.Id"
                         @onclick="() => Open(guide.Id)" @onkeydown="e => OnRowKey(e, guide)">
                        <span class="emo">@(guide.Emoji ?? "👋")</span>
                        <span class="t">Start here</span>
                        <span class="pill @(guide.TodoTotal > 0 && guide.TodoDone == guide.TodoTotal ? "done" : "")">@guide.TodoDone/@guide.TodoTotal</span>
                        <span class="actions">
                            <span title="More" @onclick="e => OpenRowMenu(guide, e)" @onclick:stopPropagation><i data-lucide="ellipsis"></i></span>
                        </span>
                    </div>
                }

                var recent = sidebar.Recent.Select(id => sidebar.Pages.FirstOrDefault(p => p.Id == id)).Where(p => p is not null && !p.IsGuide).Take(4).ToList();
                if (recent.Count > 0)
                {
                    @Section("recent", "Recently opened", null)
                    @if (!collapsed.Contains("recent"))
                    {
                        @foreach (var p in recent)
                        {
                            <div class="nt-row @(IsActive(p!.Id) ? "active" : "") @(menuFor?.Id == p.Id ? "menu-on" : "")" role="button" tabindex="0" data-id="@p.Id"
                                 @onclick="() => Open(p.Id)" @onkeydown="e => OnRowKey(e, p)">
                                <span class="emo">@(p.Emoji ?? "📄")</span><span class="t">@DisplayTitle(p.Title)</span>
                                <span class="meta">@Ago(p.UpdatedAt)</span>
                                <span class="actions">
                                    <span title="More" @onclick="e => OpenRowMenu(p, e)" @onclick:stopPropagation><i data-lucide="ellipsis"></i></span>
                                </span>
                            </div>
                        }
                    }
                }

                var favs = sidebar.Pages.Where(p => p.IsFavorite).ToList();
                if (favs.Count > 0)
                {
                    @Section("favorites", "Favorites", null)
                    @if (!collapsed.Contains("favorites")) { @foreach (var p in favs) { @Row(p, false, false) } }
                }

                var shared = Roots(false);
                @Section("shared", "Shared with me", null)
                @if (!collapsed.Contains("shared"))
                {
                    @if (shared.Count == 0) { <div class="nt-side-empty">Nothing yet. Notes sent to your chats show up here.</div> }
                    @foreach (var p in shared) { @Row(p, true, false) }
                }

                var mine = Roots(true).Where(p => !p.IsGuide).ToList();
                @Section("mine", "My pages", () => CreateBlank(null))
                @if (!collapsed.Contains("mine"))
                {
                    @foreach (var p in mine) { @Row(p, true, true) }
                    @if (mine.Count == 0) { <div class="nt-side-empty">Click “New page” to create your first page.</div> }
                }
            }
        </div>
        <div class="nt-side-foot">
            <button type="button" class="nt-row @(view == View.Trash ? "active" : "")" data-drop="trash" title="Trash — drop a page here to delete it" @onclick="OpenTrash">
                <span class="sico"><i data-lucide="trash-2" class="sm"></i></span><span class="t">Trash</span>
                @if (sidebar?.TrashCount > 0) { <span class="nt-count">@sidebar.TrashCount</span> }
            </button>
        </div>
    </aside>

    @* ── Document ─────────────────────────────────────────────────────────── *@
    <main class="nt-doc">
        <div class="nt-doc-top">
            <button type="button" class="nt-icon-btn nt-mobile-only" title="Notes list" @onclick="() => sideOpen = true"><i data-lucide="panel-left"></i></button>
            @if (view == View.Page && note is not null)
            {
                <nav class="nt-crumbs" aria-label="Breadcrumb">
                    @foreach (var c in note.Breadcrumb)
                    {
                        <a @onclick="() => Open(c.Id)">@(c.Emoji ?? "📄") @DisplayTitle(c.Title)</a><i data-lucide="chevron-right"></i>
                    }
                    <a class="cur">@(note.Emoji ?? "📄") @DisplayTitle(note.Title)</a>
                </nav>
                <span class="nt-saved hide-sm @(saveState == "offline" ? "offline" : "")">
                    @if (saveState == "saving") { <i data-lucide="loader"></i><span>Saving…</span> }
                    else if (saveState == "offline") { <i data-lucide="wifi-off"></i><span>Offline — changes will save when you reconnect</span> }
                    else if (!CanEdit) { <i data-lucide="eye"></i><span>@(note.Access == "comment" ? "Can comment" : "View only")</span> }
                    else { <i data-lucide="check"></i><span>Saved</span> }
                </span>
                @if (presence.Count > 0)
                {
                    <div class="nt-avatars hide-sm" title="@string.Join(", ", presence.Select(u => u.Name)) viewing now">
                        @foreach (var u in presence.Take(4))
                        {
                            <PersonAvatar Nik="@u.Nik" Name="@u.Name" Size="24" Color="@u.Color" Class="nt-av s24 live" Decorative="true" />
                        }
                        @if (presence.Count > 4) { <span class="nt-av s24 more">+@(presence.Count - 4)</span> }
                    </div>
                    <span class="nt-top-sep hide-sm"></span>
                }
                @if (CanEdit)
                {
                    <button type="button" class="nt-btn ghost hide-sm" @onclick="() => pop = Pop.Style"><i data-lucide="palette" class="sm"></i>Style</button>
                }
                <button type="button" class="nt-icon-btn @(commentsOpen ? "on" : "")" title="Comments" @onclick="ToggleComments"><i data-lucide="message-square"></i></button>
                <button type="button" class="nt-icon-btn fav @(note.IsFavorite ? "on" : "")" title="@(note.IsFavorite ? "Remove from favorites" : "Add to favorites")" @onclick="ToggleFavorite"><i data-lucide="star"></i></button>
                @if (IsOwner)
                {
                    <button type="button" class="nt-btn primary" @onclick="OpenShare"><i data-lucide="share" class="sm"></i>Share</button>
                }
                <button type="button" class="nt-icon-btn" title="More" @onclick="() => pop = Pop.More"><i data-lucide="ellipsis"></i></button>
            }
            else
            {
                <nav class="nt-crumbs"><a class="cur">@(view == View.Trash ? "🗑 Trash" : view == View.New ? "New page" : "Notes")</a></nav>
            }
        </div>

        <div class="nt-doc-scroll" @ref="scrollRef">
            @if (view == View.Trash)
            {
                <div class="nt-trash">
                    <h2>Trash</h2>
                    <div class="sub">Deleted pages can be restored. Their sub-pages come back too.</div>
                    @if (trash is null) { <div class="nt-loading">Loading…</div> }
                    else if (trash.Count == 0) { <div class="nt-side-empty">Trash is empty.</div> }
                    else
                    {
                        @foreach (var t in trash)
                        {
                            <div class="it">
                                <span>@(t.Emoji ?? "📄")</span>
                                <span class="t">@DisplayTitle(t.Title)</span>
                                <span class="m">@Ago(t.UpdatedAt)</span>
                                <button type="button" class="nt-btn ghost" @onclick="() => RestorePage(t.Id)"><i data-lucide="rotate-ccw" class="sm"></i>Restore</button>
                                @if (t.IsMine) { <button type="button" class="nt-btn ghost danger" @onclick="() => PurgePage(t)"><i data-lucide="trash-2" class="sm"></i>Delete forever</button> }
                            </div>
                        }
                    }
                </div>
            }
            else if (view == View.New)
            {
                <section class="nt-pageview" style="--pc:@AccentHex(newAccent)">
                    <div class="nt-page no-cover">
                        <div class="nt-page-icon" style="cursor:default">📄</div>
                        <input class="nt-page-title" placeholder="Untitled" @bind="newTitle" @bind:event="oninput" @onkeydown="OnNewTitleKey" @ref="newTitleRef" />
                        <div class="nt-page-props">
                            <span class="nt-prop"><i data-lucide="lock"></i>@(newParent is null ? "Private — only you" : "Sub-page")</span>
                        </div>
                        <div class="nt-tpl-hint">START FROM A TEMPLATE — OR PRESS ENTER FOR A BLANK PAGE</div>
                        <div class="nt-tpl-grid">
                            @foreach (var t in Templates)
                            {
                                <button type="button" class="nt-tpl c-@t.Color" disabled="@creating" @onclick="() => CreatePage(t.Key)">
                                    <span class="ti">@t.Emoji</span>
                                    <span><span class="tn">@t.Name</span><br /><span class="td">@t.Desc</span></span>
                                </button>
                            }
                            <button type="button" class="nt-tpl c-gray" disabled="@creating" @onclick="() => CreatePage(null)">
                                <span class="ti">📄</span>
                                <span><span class="tn">Blank page</span><br /><span class="td">Start from scratch</span></span>
                            </button>
                        </div>
                        @if (GuideId is { } gid)
                        {
                            <button type="button" class="nt-new-guide" @onclick="() => Open(gid)">
                                <span class="emo">👋</span>
                                <span><b>New here?</b><br /><span class="muted">Open the quick guide — 13 hands-on steps.</span></span>
                            </button>
                        }
                        @* The guide page teaches the blocks; the tour shows where things are on screen. *@
                        <button type="button" class="nt-new-guide" @onclick='() => Tutorials.StartTourAsync(TutorialRegistry.Get("notes")!)'>
                            <span class="emo">🧭</span>
                            <span><b>1-minute tour</b><br /><span class="muted">See where pages, sharing and search live. Reopen it anytime from the ? button at the top.</span></span>
                        </button>
                    </div>
                </section>
            }
            else if (view == View.Page)
            {
                @if (pageError is not null)
                {
                    <div class="nt-error">
                        <div class="emo">@(pageError == "not_found" ? "🔍" : "🔒")</div>
                        <b>@(pageError == "not_found" ? "Page not found" : "You don't have access to this page")</b>
                        <span>@(pageError == "not_found" ? "It may have been deleted or moved to Trash." : "Ask the owner to share this note with you or one of your group chats.")</span>
                        <button type="button" class="nt-btn" @onclick="GoHome">Back to Notes</button>
                    </div>
                }
                else if (note is null)
                {
                    <div class="nt-loading">Loading page…</div>
                }
                else
                {
                    <section class="nt-pageview @FontClass @(note.SmallText ? "small" : "")" style="--pc:@AccentHex(note.Accent)">
                        @if (note.Cover is not null)
                        {
                            <div class="nt-cover" style="--cover:@CoverCss(note.Cover)">
                                @if (CanEdit)
                                {
                                    <div class="nt-cover-actions">
                                        <button type="button" @onclick="() => pop = Pop.Style"><i data-lucide="image" class="sm"></i>Change cover</button>
                                        <button type="button" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, "", null, null, null, null))'>Remove</button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="nt-page @(note.FullWidth ? "wide" : "") @(note.Cover is null ? "no-cover" : "")">
                            <div class="nt-page-icon" title="@(CanEdit ? "Change icon" : "")" style="@(CanEdit ? "" : "cursor:default")" @onclick="() => { if (CanEdit) pop = Pop.Emoji; }">@(note.Emoji ?? "📄")</div>
                            @if (CanEdit && note.Cover is null)
                            {
                                <div class="nt-add-row">
                                    <button type="button" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, "ocean", null, null, null, null))'><i data-lucide="image" class="sm"></i>Add cover</button>
                                    <button type="button" @onclick="ToggleComments"><i data-lucide="message-square" class="sm"></i>Comment</button>
                                </div>
                            }
                            <input class="nt-page-title" placeholder="Untitled" value="@titleDraft" readonly="@(!CanEdit)" @ref="titleRef"
                                   @oninput="OnTitleInput" @onkeydown="OnTitleKey" @onblur="FlushTitle" aria-label="Title" />
                            <div class="nt-page-props">
                                @if (!note.OwnerNik.Equals(Auth.Me?.Nik, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="nt-prop"><i data-lucide="user"></i>@note.OwnerName</span>
                                }
                                <span class="nt-prop"><i data-lucide="clock"></i>Edited @Ago(note.UpdatedAt)@(note.UpdatedByName is { } ub ? $" by {FirstName(ub)}" : "")</span>
                                @if (note.Rooms.Count > 0)
                                {
                                    <span class="nt-prop acc" title="@string.Join(", ", note.Rooms.Select(r => r.Name))"><i data-lucide="users"></i>@(note.Rooms.Count == 1 ? note.Rooms[0].Name : $"{note.Rooms.Count} chats")</span>
                                }
                                else if (note.IsShared)
                                {
                                    <span class="nt-prop acc"><i data-lucide="users"></i>Shared</span>
                                }
                                else
                                {
                                    <span class="nt-prop"><i data-lucide="lock"></i>Private</span>
                                }
                                @if (note.TodoTotal > 0)
                                {
                                    <span class="nt-prop"><i data-lucide="square-check"></i>@note.TodoDone/@note.TodoTotal</span>
                                }
                            </div>
                            <div @ref="editorRef" @key="note.Id"></div>
                            @if (showTemplates)
                            {
                                <div class="nt-tpl-hint">OR START FROM A TEMPLATE</div>
                                <div class="nt-tpl-grid">
                                    @foreach (var t in Templates)
                                    {
                                        <button type="button" class="nt-tpl c-@t.Color" @onclick="() => ApplyTemplate(t.Key)">
                                            <span class="ti">@t.Emoji</span>
                                            <span><span class="tn">@t.Name</span><br /><span class="td">@t.Desc</span></span>
                                        </button>
                                    }
                                </div>
                            }
                            @if (note.Children.Count > 0)
                            {
                                <div class="nt-tpl-hint">SUB-PAGES</div>
                                @foreach (var c in note.Children)
                                {
                                    <button type="button" class="nt-row" @onclick="() => Open(c.Id)"><span class="emo">@(c.Emoji ?? "📄")</span><span class="t">@DisplayTitle(c.Title)</span></button>
                                }
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="nt-home">
                    <h2>Notes</h2>
                    <div class="sub">Notes, SOPs and meeting minutes — share them to chat and edit together.</div>
                    <div class="nt-cards">
                        <button type="button" class="nt-card" @onclick="() => CreateBlank(null)"><span class="emo">➕</span><span class="t">New page</span><span class="m">Alt N</span></button>
                        @if (sidebar is not null)
                        {
                            @foreach (var p in sidebar.Pages.OrderByDescending(p => p.IsGuide).ThenByDescending(p => p.UpdatedAt).Take(11))
                            {
                                <button type="button" class="nt-card" @onclick="() => Open(p.Id)">
                                    <span class="emo">@(p.Emoji ?? "📄")</span><span class="t">@DisplayTitle(p.Title)</span>
                                    <span class="m">@(p.IsMine ? "" : p.OwnerName + " · ")@Ago(p.UpdatedAt)</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </main>

    @* ── Comments ─────────────────────────────────────────────────────────── *@
    <aside class="nt-comments @(commentsOpen && view == View.Page ? "open" : "")" aria-label="Comments">
        <div class="nt-cp-head">
            <h2>Comments</h2>
            <div class="nt-seg">
                <button type="button" class="@(showResolved ? "" : "on")" @onclick="() => showResolved = false">Open</button>
                <button type="button" class="@(showResolved ? "on" : "")" @onclick="() => showResolved = true">All</button>
            </div>
            <button type="button" class="nt-icon-btn" title="Close" @onclick="() => commentsOpen = false"><i data-lucide="x"></i></button>
        </div>
        <div class="nt-cp-body">
            @if (draft is not null)
            {
                <div class="nt-thread draft">
                    <div class="quoteline"><span>@draft.Quote</span></div>
                    <textarea @ref="draftRef" placeholder="Write a comment… (@@ to mention)" @bind="draft.Body" @bind:event="oninput" @onkeydown="OnDraftKey"></textarea>
                    <div class="acts">
                        <button type="button" class="nt-btn ghost" @onclick="() => draft = null">Cancel</button>
                        <button type="button" class="nt-btn primary" disabled="@(string.IsNullOrWhiteSpace(draft.Body) || busy)" @onclick="PostDraft">Send</button>
                    </div>
                </div>
            }
            @{ var shown = threads.Where(t => showResolved || t.ResolvedAt is null).ToList(); }
            @if (shown.Count == 0 && draft is null)
            {
                <div class="nt-cp-empty">
                    @(threads.Count == 0 ? "No comments yet." : "All comments are resolved.")<br />
                    @if (CanComment) { <span>Select text, then click <b>💬 Comment</b> or press <kbd>Ctrl Shift M</kbd>.</span> }
                </div>
            }
            @foreach (var t in shown)
            {
                <div class="nt-thread @(t.Id == focusThread ? "focus" : "") @(t.ResolvedAt is null ? "" : "resolved")" @onclick="() => FocusThread(t.Id)">
                    @if (!string.IsNullOrEmpty(t.Quote))
                    {
                        <div class="quoteline">
                            <span>@t.Quote</span>
                            @if (CanComment)
                            {
                                <button type="button" title="@(t.ResolvedAt is null ? "Resolve" : "Reopen")" @onclick="() => Resolve(t)" @onclick:stopPropagation>
                                    <i data-lucide="@(t.ResolvedAt is null ? "circle-check" : "rotate-ccw")" class="sm"></i>
                                </button>
                            }
                        </div>
                    }
                    @foreach (var c in t.Comments)
                    {
                        <div class="nt-c-msg">
                            @if (c.AuthorNik is null) { <span class="nt-av s24 bot">iP</span> }
                            else { <PersonAvatar Nik="@c.AuthorNik" Name="@c.AuthorName" Size="24" Class="nt-av s24" Decorative="true" /> }
                            <div style="min-width:0">
                                <div class="who">@c.AuthorName<span class="when">@Ago(c.CreatedAt)</span></div>
                                <div class="txt">@c.Body</div>
                            </div>
                        </div>
                    }
                    @if (CanComment && t.ResolvedAt is null)
                    {
                        <div class="nt-c-reply" @onclick:stopPropagation>
                            <input placeholder="Reply…" value="@(replies.GetValueOrDefault(t.Id) ?? "")" @oninput="e => replies[t.Id] = e.Value?.ToString()" @onkeydown="e => OnReplyKey(e, t)" />
                            <button type="button" class="nt-icon-btn" title="Send" @onclick="() => Reply(t)"><i data-lucide="arrow-up"></i></button>
                        </div>
                    }
                </div>
            }
        </div>
    </aside>
</div>

@* ── Popovers ─────────────────────────────────────────────────────────────── *@
@if (pop != Pop.None && note is not null)
{
    <div class="nt-scrim @(pop is Pop.Share or Pop.History ? "dim" : "")" @onclick="ClosePop"></div>
    @switch (pop)
    {
        case Pop.More:
            <div class="nt-layer nt-menu-l" style="top:52px;right:14px">
                @if (CanEdit)
                {
                    <button type="button" class="mi" @onclick="() => pop = Pop.Style"><i data-lucide="palette" class="sm"></i>Style</button>
                    <button type="button" class="mi" @onclick="() => CreateBlank(note.Id)"><i data-lucide="file-plus" class="sm"></i>Add sub-page</button>
                }
                <button type="button" class="mi" @onclick="OpenHistory"><i data-lucide="history" class="sm"></i>Version history</button>
                <button type="button" class="mi" @onclick="CopyLink"><i data-lucide="link" class="sm"></i>Copy link</button>
                @if (CanEdit)
                {
                    <hr />
                    <button type="button" class="mi danger" @onclick="TrashPage"><i data-lucide="trash-2" class="sm"></i>Move to Trash</button>
                }
                <hr />
                <div class="mh" style="font-weight:400">Created @ShortDate(note.CreatedAt) · @note.OwnerName</div>
            </div>
            break;

        case Pop.Style:
            <div class="nt-layer nt-style" style="top:52px;right:14px">
                <section>
                    <h4>COVER</h4>
                    <div class="nt-covers">
                        <button type="button" class="none @(note.Cover is null ? "on" : "")" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, "", null, null, null, null))'>None</button>
                        @foreach (var c in Covers)
                        {
                            <button type="button" class="@(note.Cover == c ? "on" : "")" style="--cv:var(--cv-@c)" title="@c" @onclick="() => PatchAsync(new UpdateNoteMetaRequest(null, null, c, null, null, null, null))"></button>
                        }
                    </div>
                </section>
                <section>
                    <h4>ACCENT COLOR</h4>
                    <div class="nt-accents">
                        @foreach (var a in Accents)
                        {
                            <button type="button" class="nt-dot @(note.Accent == a.Key ? "on" : "")" style="--k:@a.Value" title="@a.Key" @onclick="() => SetAccentAsync(a.Key)"></button>
                        }
                    </div>
                </section>
                <section>
                    <h4>FONT</h4>
                    <div class="nt-fonts">
                        <button type="button" class="@(note.Font == "default" ? "on" : "")" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, null, null, "default", null, null))'><b style="font-family:var(--display)">Ag</b>Default</button>
                        <button type="button" class="@(note.Font == "serif" ? "on" : "")" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, null, null, "serif", null, null))'><b style="font-family:var(--serif)">Ag</b>Serif</button>
                        <button type="button" class="@(note.Font == "mono" ? "on" : "")" @onclick='() => PatchAsync(new UpdateNoteMetaRequest(null, null, null, null, "mono", null, null))'><b style="font-family:var(--mono)">Ag</b>Mono</button>
                    </div>
                </section>
                <section>
                    <div class="nt-switch-row"><span>Full width</span><button type="button" class="nt-switch @(note.FullWidth ? "on" : "")" aria-label="Full width" @onclick="() => PatchAsync(new UpdateNoteMetaRequest(null, null, null, null, null, !note.FullWidth, null))"></button></div>
                    <div class="nt-switch-row"><span>Small text</span><button type="button" class="nt-switch @(note.SmallText ? "on" : "")" aria-label="Small text" @onclick="() => PatchAsync(new UpdateNoteMetaRequest(null, null, null, null, null, null, !note.SmallText))"></button></div>
                </section>
            </div>
            break;

        case Pop.Emoji:
            <div class="nt-layer nt-emoji" style="top:@(note.Cover is null ? 170 : 290)px;left:50%;transform:translateX(-50%)">
                <div class="nt-emoji-grid">
                    @foreach (var e in Emojis)
                    {
                        <button type="button" @onclick="() => SetEmoji(e)">@e</button>
                    }
                </div>
                <div class="foot">
                    <button type="button" class="nt-btn ghost" @onclick="() => SetEmoji(Emojis[Random.Shared.Next(Emojis.Length)])"><i data-lucide="shuffle" class="sm"></i>Random</button>
                    <button type="button" class="nt-btn ghost" @onclick='() => SetEmoji("")'>Remove icon</button>
                </div>
            </div>
            break;

        case Pop.Share:
            <div class="nt-layer nt-share" role="dialog" aria-label="Share">
                <div class="nt-share-tabs">
                    <button type="button" class="@(shareTab == 0 ? "on" : "")" @onclick="() => shareTab = 0">Share</button>
                    <button type="button" class="@(shareTab == 1 ? "on" : "")" @onclick="OpenSendTab">Send to chat</button>
                </div>
                @if (shareTab == 0)
                {
                    <div class="nt-share-pane">
                        <div class="nt-inv">
                            <label class="nt-field"><i data-lucide="user-plus" class="sm"></i><input placeholder="Search name or email" value="@inviteQ" @oninput="OnInviteInput" /></label>
                            <select class="nt-role" style="border:1px solid var(--line);height:34px" @bind="inviteLevel">
                                <option value="edit">Can edit</option><option value="comment">Can comment</option><option value="view">Can view</option>
                            </select>
                            @if (inviteHits.Count > 0)
                            {
                                <div class="nt-sugg">
                                    @foreach (var p in inviteHits)
                                    {
                                        <button type="button" @onclick="() => Invite(p)">
                                            <PersonAvatar Nik="@p.Nik" Name="@p.Name" Size="30" Class="nt-av s30" Decorative="true" />
                                            <span><span class="nm">@p.Name</span></span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (shares is null) { <div class="nt-loading">Loading…</div> }
                        else
                        {
                            <div class="nt-plist">
                                <div class="lbl">PEOPLE</div>
                                <div class="nt-pr">
                                    <PersonAvatar Nik="@shares.OwnerNik" Name="@shares.OwnerName" Size="30" Class="nt-av s30" Decorative="true" />
                                    <div class="grow"><div class="nm">@shares.OwnerName @(shares.OwnerNik.Equals(Auth.Me?.Nik, StringComparison.OrdinalIgnoreCase) ? "(you)" : "")</div><div class="sub">Owner</div></div>
                                    <span class="nt-role static">Owner</span>
                                </div>
                                @foreach (var s in shares.Shares.Where(s => s.UserId is not null))
                                {
                                    <div class="nt-pr">
                                        <PersonAvatar Nik="@s.UserNik" Name="@s.UserName" Size="30" Class="nt-av s30" Decorative="true" />
                                        <div class="grow"><div class="nm">@s.UserName</div><div class="sub">@(s.InheritedFromTitle is { } it ? $"From “{DisplayTitle(it)}”" : "")</div></div>
                                        @ShareRole(s)
                                    </div>
                                }
                                @if (shares.Shares.Any(s => s.RoomId is not null))
                                {
                                    <div class="lbl">CHAT</div>
                                    @foreach (var s in shares.Shares.Where(s => s.RoomId is not null))
                                    {
                                        <div class="nt-pr">
                                            <span class="nt-room-av" style="background:@AvatarPalette.For(s.RoomName)"><i data-lucide="@(IsDirect(s.RoomType) ? "user" : "users")" class="sm"></i></span>
                                            <div class="grow"><div class="nm">@s.RoomName</div><div class="sub">@(s.InheritedFromTitle is { } it ? $"From “{DisplayTitle(it)}”" : IsDirect(s.RoomType) ? "Direct message" : $"{s.RoomMembers} members · follows group membership")</div></div>
                                            @ShareRole(s)
                                        </div>
                                    }
                                }
                            </div>
                            <div class="nt-general">
                                <span class="gi"><i data-lucide="@(shares.Shares.Count == 0 ? "lock" : "users")" class="sm"></i></span>
                                <div><div style="font-weight:500">@(shares.Shares.Count == 0 ? "Only you" : "Restricted")</div><div class="sub">Only the people and chat members above can open it.</div></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="nt-share-pane">
                        <label class="nt-field"><i data-lucide="search" class="sm"></i><input placeholder="Search chats or groups" @bind="roomQ" @bind:event="oninput" /></label>
                        <div class="nt-rooms">
                            @if (rooms is null) { <div class="nt-loading">Loading chats…</div> }
                            else
                            {
                                var list = rooms.Where(r => string.IsNullOrWhiteSpace(roomQ) || RoomName(r).Contains(roomQ, StringComparison.OrdinalIgnoreCase)).Take(60).ToList();
                                if (list.Count == 0) { <div class="nt-side-empty">No matching chats.</div> }
                                @foreach (var r in list)
                                {
                                    <button type="button" class="nt-rm @(sendRoom == r.Id ? "on" : "")" @onclick="() => sendRoom = r.Id">
                                        @if (IsDirect(r.Type)) { <PersonAvatar Nik="@r.RecipientNik" Name="@RoomName(r)" Size="30" Class="nt-room-av" Decorative="true" /> }
                                        else { <span class="nt-room-av" style="background:@(r.AvatarColor ?? AvatarPalette.For(r.RecipientNik ?? RoomName(r)))"><i data-lucide="users" class="sm"></i></span> }
                                        <span class="grow"><span class="nm" style="display:block">@RoomName(r)</span><span class="sub">@(IsDirect(r.Type) ? "Direct message" : "Group")</span></span>
                                        <span class="nt-radio"></span>
                                    </button>
                                }
                            }
                        </div>
                        <div class="nt-send-opts">
                            <span style="color:var(--ink-3);font-size:12.5px">Members can</span>
                            <div class="nt-seg">
                                <button type="button" class="@(sendLevel == "view" ? "on" : "")" @onclick='() => sendLevel = "view"'>View</button>
                                <button type="button" class="@(sendLevel == "comment" ? "on" : "")" @onclick='() => sendLevel = "comment"'>Comment</button>
                                <button type="button" class="@(sendLevel == "edit" ? "on" : "")" @onclick='() => sendLevel = "edit"'>Edit</button>
                            </div>
                        </div>
                        <textarea class="nt-msg-field" placeholder="Add a message (optional)" @bind="sendMsg" @bind:event="oninput"></textarea>
                        <div class="nt-note-hint"><i data-lucide="info" class="sm"></i><span>Access follows chat membership: new members can open it automatically, and anyone who leaves loses access. Sub-pages are shared too.</span></div>
                    </div>
                }
                <div class="nt-share-foot">
                    <button type="button" class="nt-link" @onclick="CopyLink"><i data-lucide="link" class="sm"></i>Copy link</button>
                    @if (shareTab == 1)
                    {
                        <button type="button" class="nt-btn primary" disabled="@(sendRoom is null || busy)" @onclick="SendToChat"><i data-lucide="send" class="sm"></i>Send</button>
                    }
                    else
                    {
                        <button type="button" class="nt-btn" @onclick="ClosePop">Done</button>
                    }
                </div>
            </div>
            break;

        case Pop.History:
            <div class="nt-layer nt-history" role="dialog" aria-label="Version history">
                <div class="nt-h-prev">
                    @if (versions is { Count: > 0 } && selVersion is not null)
                    {
                        var v = versions.First(x => x.Id == selVersion);
                        <div class="nt-page-title" style="margin-top:0">@DisplayTitle(v.Title)</div>
                    }
                    <div class="nt-pageview" style="--pc:@AccentHex(note.Accent)"><div @ref="previewRef"></div></div>
                    @if (versions is { Count: 0 }) { <div class="nt-cp-empty">No saved versions yet. Versions are created automatically as the page is edited.</div> }
                </div>
                <div class="nt-h-list">
                    <div class="hd"><h3>Version history</h3><button type="button" class="nt-icon-btn" title="Close" @onclick="ClosePop"><i data-lucide="x"></i></button></div>
                    <div class="items">
                        @if (versions is null) { <div class="nt-loading">Loading…</div> }
                        else
                        {
                            @foreach (var v in versions)
                            {
                                <button type="button" class="hi @(selVersion == v.Id ? "on" : "")" @onclick="() => SelectVersion(v.Id)">
                                    <div class="d">@StampDate(v.CreatedAt)</div>
                                    <div class="w">
                                        @foreach (var n in v.Contributors.Take(3)) { <PersonAvatar Nik="@ContributorNik(n)" Name="@n" Size="20" Class="nt-av s20" Decorative="true" /> }
                                        <span>@string.Join(", ", v.Contributors.Select(FirstName))</span>
                                    </div>
                                </button>
                            }
                        }
                    </div>
                    @if (CanEdit)
                    {
                        <div class="ft"><button type="button" class="nt-btn primary" disabled="@(selVersion is null || busy)" @onclick="RestoreVersion"><i data-lucide="rotate-ccw" class="sm"></i>Restore this version</button></div>
                    }
                </div>
            </div>
            break;
    }
}

@* ── Sidebar menus ────────────────────────────────────────────────────────── *@
@if (menuFor is { } m)
{
    var edit = m.Access is "owner" or "edit";
    <div class="nt-scrim" @onclick="CloseRowMenu" @oncontextmenu="CloseRowMenu" @oncontextmenu:preventDefault></div>
    <div class="nt-layer nt-menu-l" role="menu" style="top:@(menuY)px;left:@(menuX)px" @ref="menuRef">
        @if (m.IsGuide)
        {
            <button type="button" class="mi" @onclick="() => HideGuide(true)"><i data-lucide="eye-off" class="sm"></i>Hide from sidebar</button>
            <div class="mh" style="font-weight:400">You can still open it from the Notes home.</div>
        }
        else
        {
            @if (edit)
            {
                <button type="button" class="mi" @onclick="() => StartRename(m)"><i data-lucide="pencil" class="sm"></i>Rename<span class="ds">F2</span></button>
                <button type="button" class="mi" @onclick="() => CreateBlank(m.Id)"><i data-lucide="file-plus" class="sm"></i>Add sub-page</button>
            }
            <button type="button" class="mi" @onclick="() => SetFavorite(m, !m.IsFavorite)"><i data-lucide="star" class="sm"></i>@(m.IsFavorite ? "Remove from Favorites" : "Add to Favorites")</button>
            @if (edit)
            {
                <button type="button" class="mi" @onclick="() => Duplicate(m)"><i data-lucide="copy" class="sm"></i>Duplicate</button>
            }
            <button type="button" class="mi" @onclick="() => CopyLinkOf(m.Id)"><i data-lucide="link" class="sm"></i>Copy link</button>
            <button type="button" class="mi" @onclick="() => OpenInNewTab(m.Id)"><i data-lucide="external-link" class="sm"></i>Open in new tab</button>
            @if (m.Access == "owner")
            {
                <button type="button" class="mi" @onclick="() => OpenMoveDialog(m)"><i data-lucide="folder-input" class="sm"></i>Move to…</button>
            }
            @if (edit)
            {
                <hr />
                <button type="button" class="mi danger" @onclick="() => TrashById(m.Id)"><i data-lucide="trash-2" class="sm"></i>Move to Trash</button>
            }
        }
    </div>
}
@if (newMenuOpen)
{
    <div class="nt-scrim" @onclick="() => newMenuOpen = false"></div>
    <div class="nt-layer nt-menu-l" role="menu" style="top:@(menuY)px;left:@(menuX)px" @ref="menuRef">
        <div class="mh">New page from a template</div>
        @foreach (var t in Templates)
        {
            <button type="button" class="mi" @onclick="() => CreateFromTemplate(t.Key)"><span class="nt-mi-emo">@t.Emoji</span>@t.Name</button>
        }
        <hr />
        <button type="button" class="mi" @onclick="() => CreateBlank(null)"><span class="nt-mi-emo">📄</span>Blank page</button>
    </div>
}
@if (moveFor is { } mv)
{
    var targets = MoveTargets(mv);
    <div class="nt-scrim dim" @onclick="() => moveFor = null"></div>
    <div class="nt-layer nt-move" role="dialog" aria-label="Move page">
        <div class="hd">Move “@DisplayTitle(mv.Title)” to…</div>
        <label class="nt-search">
            <i data-lucide="search" class="sm"></i>
            <input @ref="moveRef" placeholder="Search pages" value="@moveQ" @oninput="e => moveQ = e.Value?.ToString() ?? string.Empty" @onkeydown="OnMoveKey" aria-label="Search pages" />
        </label>
        <div class="ls">
            @if (string.IsNullOrWhiteSpace(moveQ) && mv.ParentId is not null && mv.IsMine)
            {
                <button type="button" class="nt-row" @onclick="() => MoveTo(mv, null, null)"><span class="sico"><i data-lucide="file-stack" class="sm"></i></span><span class="t">My pages (top level)</span></button>
            }
            @foreach (var t in targets)
            {
                <button type="button" class="nt-row" @onclick="() => MoveTo(mv, t.Id, null)">
                    <span class="emo">@(t.Emoji ?? "📄")</span><span class="t">@DisplayTitle(t.Title)</span>
                    @if (!t.IsMine) { <span class="meta">@t.OwnerName</span> }
                </button>
            }
            @if (targets.Count == 0) { <div class="nt-side-empty" style="padding:10px">No pages you can move it into.</div> }
        </div>
    </div>
}

@code {
    /// One page in the sidebar tree. <paramref name="sortable"/> rows accept drops before/after them
    /// (manual order); "Shared with me" roots stay alphabetical, so they only accept drops onto them.
    private RenderFragment Row(NoteListItemDto p, bool tree, bool sortable) => __builder =>
    {
        var kids = tree ? Children(p.Id) : [];
        var open = expanded.Contains(p.Id);
        var edit = p.Access is "owner" or "edit";
        var renaming = renamingId == p.Id;
        <div>
            <div class="nt-row @(IsActive(p.Id) ? "active" : "") @(menuFor?.Id == p.Id ? "menu-on" : "")" role="button" tabindex="0"
                 data-id="@p.Id" data-drag="@(edit && tree && !renaming ? "1" : null)" data-sort="@(sortable && tree ? "1" : null)" data-nest="@(edit && tree ? "1" : null)"
                 @onclick="() => Open(p.Id)" @ondblclick="() => StartRename(p)" @onkeydown="e => OnRowKey(e, p)">
                <span class="chev @(kids.Count == 0 ? "none" : "") @(open ? "open" : "")" @onclick="() => ToggleExpand(p.Id)" @onclick:stopPropagation><i data-lucide="chevron-right"></i></span>
                <span class="emo">@(p.Emoji ?? "📄")</span>
                @if (renaming)
                {
                    <input class="nt-rename" @ref="renameRef" value="@renameDraft" aria-label="Page name" placeholder="Untitled"
                           @oninput="e => renameDraft = e.Value?.ToString() ?? string.Empty" @onkeydown="OnRenameKey" @onkeydown:stopPropagation
                           @onblur="CommitRename" @onclick:stopPropagation @ondblclick:stopPropagation />
                }
                else
                {
                    <span class="t">@DisplayTitle(p.Title)</span>
                    @if (p.IsShared) { <span class="meta"><i data-lucide="users" class="sm"></i></span> }
                    <span class="actions">
                        <span title="More" @onclick="e => OpenRowMenu(p, e)" @onclick:stopPropagation><i data-lucide="ellipsis"></i></span>
                        @if (edit)
                        {
                            <span title="Add sub-page" @onclick="() => CreateBlank(p.Id)" @onclick:stopPropagation><i data-lucide="plus"></i></span>
                        }
                    </span>
                }
            </div>
            @if (open && kids.Count > 0)
            {
                <div class="nt-children">
                    @foreach (var k in kids) { @Row(k, true, true) }
                </div>
            }
        </div>
    };

    /// Collapsible sidebar heading; <paramref name="add"/> shows a small + on hover.
    private RenderFragment Section(string key, string label, Func<Task>? add) => __builder =>
    {
        var shut = collapsed.Contains(key);
        <div class="nt-sect">
            <button type="button" class="nt-sect-t" aria-expanded="@(shut ? "false" : "true")" @onclick="() => ToggleSection(key)">
                @label<i data-lucide="chevron-down" class="sm @(shut ? "shut" : "")"></i>
            </button>
            @if (add is not null) { <button type="button" title="New page" @onclick="add"><i data-lucide="plus" class="sm"></i></button> }
        </div>
    };

    private RenderFragment ShareRole(NoteShareDto s) => __builder =>
    {
        if (s.InheritedFromId is not null)
        {
            <span class="nt-role static">@LevelLabel(s.Level)</span>
        }
        else
        {
            <select class="nt-role" value="@s.Level" @onchange="e => ChangeShare(s, e.Value?.ToString())">
                <option value="edit">Can edit</option>
                <option value="comment">Can comment</option>
                <option value="view">Can view</option>
                <option value="remove">Remove access</option>
            </select>
        }
    };
}
