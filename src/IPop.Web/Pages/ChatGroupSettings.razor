@page "/chat/group/{RoomId:guid}/settings"
@inject IJSRuntime JS
@inject AuthState Auth
@inject ChatState ChatSvc
@inject NavigationManager Nav
@inject IPop.Web.Services.ToastService Toasts
@using IPop.Application.Chat
@using IPop.Web.Components.Chat

<PageTitle>Group settings — IPop</PageTitle>

<div class="content" style="grid-template-columns:1fr">

    @if (loading)
    {
        <div class="tray rise rise-1">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="tree-empty" style="padding:34px">
                    <i data-lucide="loader-circle" style="width:20px;height:20px;margin-bottom:6px"></i>
                    <div>Loading group settings…</div>
                </div>
            </div>
        </div>
    }
    else if (room is null)
    {
        <div class="tray rise rise-1">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="tree-empty" style="padding:34px">
                    <i data-lucide="users" style="width:20px;height:20px;margin-bottom:6px"></i>
                    <div>Group not found.</div>
                    <div class="meta" style="font-size:11.5px;color:var(--ink-3)">This group does not exist, is not a group, or you are not a member.</div>
                    <div style="margin-top:12px"><button class="btn-sm surface" @onclick='() => Nav.NavigateTo("/chat")'><i data-lucide="arrow-left" style="width:13px;height:13px"></i> Back to Messages</button></div>
                </div>
            </div>
        </div>
    }
    else
    {
        @* ---- Group identity ---- *@
        <div class="tray rise rise-1">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="users"></i> <span>Group Identity</span>
                    <span class="meta">@room.MemberCount members</span>
                    <span style="margin-left:auto;display:flex;gap:6px">
                        <button class="btn-sm surface" @onclick='() => Nav.NavigateTo($"/chat/{room.Id}")' title="Open chat"><i data-lucide="message-circle" style="width:13px;height:13px"></i> Open chat</button>
                    </span>
                </div>
                <div style="display:flex;align-items:flex-start;gap:16px;padding:16px">
                    <div class="grp-avatar-wrap">
                        @if (avatarPreviewUrl is not null)
                        {
                            <img src="@avatarPreviewUrl" alt="Group photo preview" style="width:72px;height:72px;border-radius:20px;object-fit:cover" />
                        }
                        else
                        {
                            <div class="av-big avatar" style="background:@(avatarColor ?? IPop.Web.Models.AvatarPalette.For(room.Name ?? "G"));width:72px;height:72px;font-size:24px;border-radius:20px">@Initials(room.Name ?? "G")</div>
                        }
                        @if (canEdit)
                        {
                            <InputFile OnChange="OnAvatarSelected" accept="image/*" style="display:none" id="grp-avatar-input" />
                            <label for="grp-avatar-input" class="btn-sm surface" style="cursor:pointer;font-size:11px">
                                <i data-lucide="image-plus" style="width:12px;height:12px"></i> Change photo
                            </label>
                            <div class="grp-avatar-colors">
                                @foreach (var c in AvatarChoices)
                                {
                                    var color = c;
                                    <button type="button" class="grp-color-dot @(avatarColor == color ? "on" : "")" style="background:@color"
                                            title="Use this color" @onclick="() => PickColor(color)"></button>
                                }
                            </div>
                            @if (avatarColor != room.AvatarColor)
                            {
                                <button class="btn-sm accent" style="font-size:11px" @onclick="SaveColorAsync"><i data-lucide="check" style="width:12px;height:12px"></i> Save color</button>
                            }
                            <div class="grp-avatar-hint">Photo uploaded once avatar endpoint is available; color is saved to server</div>
                        }
                    </div>
                    <div style="flex:1;min-width:0">
                        <GroupIdentityEditor RoomId="room.Id" Name="@room.Name" Description="@room.Description" CanEdit="canEdit" OnSaved="ReloadAsync" />
                    </div>
                </div>
            </div>
        </div>

        @* ---- Notifications ---- *@
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="bell"></i> <span>Notifications</span>
                    <span class="meta">@MuteSummary</span>
                </div>
                <div style="padding:10px 14px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                    @if (isMuted)
                    {
                        <button class="btn-sm accent" disabled="@muteBusy" @onclick="UnmuteAsync"><i data-lucide="bell-ring" style="width:13px;height:13px"></i> Unmute</button>
                    }
                    else
                    {
                        @foreach (var d in new[] { ("1h", "1 hour"), ("8h", "8 hours"), ("1w", "1 week"), ("forever", "Forever") })
                        {
                            var dur = d;
                            <button class="btn-sm surface" disabled="@muteBusy" @onclick="() => MuteAsync(dur.Item1)"><i data-lucide="bell-off" style="width:13px;height:13px"></i> Mute for @dur.Item2</button>
                        }
                    }
                </div>
            </div>
        </div>

        @* ---- Danger zone ---- *@
        <div class="tray rise rise-3">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="shield-alert"></i> <span>More</span>
                </div>
                <div style="padding:12px 14px;display:grid;gap:8px;max-width:520px">
                    <button class="btn-sm surface" style="justify-content:flex-start" @onclick="ArchiveAsync">
                        <i data-lucide="archive" style="width:13px;height:13px"></i> Archive group — history remains accessible in Archived
                    </button>
                    <button class="btn-sm surface" style="justify-content:flex-start;color:var(--danger);border-color:var(--danger-soft)" @onclick="ConfirmLeave">
                        <i data-lucide="log-out" style="width:13px;height:13px"></i> Leave group — conversation will be removed from your list
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@if (showLeaveConfirm)
{
    <ConfirmDialog Title="Leave group" Message="@leaveMessage" ConfirmText="Leave" CancelText="Cancel" OnConfirm="DoLeaveAsync" OnCancel="() => showLeaveConfirm = false" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    [Parameter] public Guid RoomId { get; set; }

    private ChatRoomDto? room;
    private bool loading = true;
    private bool muteBusy;
    private bool showLeaveConfirm;
    private string leaveMessage = "";
    private string? avatarColor;
    private string? avatarPreviewUrl;

    private static readonly string[] AvatarChoices = ["#2e7d5b", "#7d5ba6", "#8a6d3b", "#b3543f", "#4f6d8f", "#5b7d2e"];

    private bool canEdit => room?.CurrentUserRole is "owner" or "admin";

    private RoomListDto? RoomListEntry =>
        ChatSvc.GroupRooms.Concat(ChatSvc.DirectRooms).FirstOrDefault(r => r.Id == RoomId);

    private bool isMuted => RoomListEntry?.IsMuted == true;

    private string MuteSummary => RoomListEntry is not { IsMuted: true } dto
        ? "active"
        : dto.MuteExpiresAt is null ? "muted forever" : $"muted until {dto.MuteExpiresAt.Value.ToLocalTime():g}";

    protected override void OnInitialized()
    {
        Layout.SetHeader("Messages");
        Layout.SetSubtitle("Group settings");
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            await ChatSvc.ConnectAsync();
            await ChatSvc.LoadRoomsAsync();
            var r = await Auth.GetAsync<ChatRoomDto>($"/api/chat/rooms/{RoomId}");
            room = r is not null && r.Type == "group" ? r : null;
            avatarColor = room?.AvatarColor ?? IPop.Web.Models.AvatarPalette.For(room?.Name ?? "G");
        }
        catch { room = null; }
        finally { loading = false; }
    }

    private async Task ReloadAsync()
    {
        room = await Auth.GetAsync<ChatRoomDto>($"/api/chat/rooms/{RoomId}");
        await ChatSvc.LoadRoomsAsync();
        StateHasChanged();
    }

    private void PickColor(string color)
    {
        avatarColor = color;
        avatarPreviewUrl = null;
    }

    private async Task SaveColorAsync()
    {
        if (room is null || avatarColor is null) return;
        await Auth.SendAsync(HttpMethod.Put, $"/api/chat/rooms/{room.Id}", new { name = room.Name, description = room.Description, avatarColor });
        await ReloadAsync();
        Toasts.Show("Group avatar color saved.", ToastKind.Success);
    }

    private async Task OnAvatarSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            Toasts.Show("File must be an image.", ToastKind.Error);
            return;
        }
        if (file.Size > 2 * 1024 * 1024)
        {
            Toasts.Show("Photo must be 2 MB or less.", ToastKind.Error);
            return;
        }
        try
        {
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            avatarPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            Toasts.Show("Photo selected — avatar upload is not yet available on the server.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show("Failed to read photo: " + ex.Message, ToastKind.Error);
        }
    }

    private async Task MuteAsync(string duration)
    {
        muteBusy = true;
        try
        {
            await Auth.SendAsync(HttpMethod.Post, $"/api/chat/rooms/{RoomId}/mute", new { duration });
            await ChatSvc.LoadRoomsAsync();
        }
        finally { muteBusy = false; }
    }

    private async Task UnmuteAsync()
    {
        muteBusy = true;
        try
        {
            await Auth.SendAsync(HttpMethod.Delete, $"/api/chat/rooms/{RoomId}/mute");
            await ChatSvc.LoadRoomsAsync();
        }
        finally { muteBusy = false; }
    }

    private async Task ArchiveAsync()
    {
        await Auth.SendAsync(HttpMethod.Post, $"/api/chat/rooms/{RoomId}/archive");
        await ChatSvc.LoadRoomsAsync();
        await ChatSvc.LoadArchivedRoomsAsync();
        Toasts.Show("Group archived. Reopen from the Archived list.", ToastKind.Success);
        Nav.NavigateTo("/chat");
    }

    private void ConfirmLeave()
    {
        var role = room?.CurrentUserRole;
        var others = room?.Members.Where(m => m.Nik != Auth.Me?.Nik).ToList() ?? [];
        if (role == "owner" && others.Count > 0)
        {
            var sorted = others.OrderBy(m => m.Role == "admin" ? 0 : 1).ToList();
            leaveMessage = $"You are the group owner. Ownership will transfer to {sorted[0].Name}. Leave {room?.Name}?";
        }
        else if (role == "owner" && others.Count == 0)
            leaveMessage = $"You are the last member. The group will be archived. Leave {room?.Name}?";
        else
            leaveMessage = $"Leave {room?.Name}?";
        showLeaveConfirm = true;
    }

    private async Task DoLeaveAsync()
    {
        showLeaveConfirm = false;
        await Auth.SendAsync(HttpMethod.Delete, $"/api/chat/rooms/{RoomId}/leave");
        await ChatSvc.LoadRoomsAsync();
        Nav.NavigateTo("/chat");
    }

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
        => await JS.InvokeVoidAsync("ipop.icons");
}
