@page "/chat/group/{RoomId:guid}/settings"
@inject NavigationManager Nav

@* Group settings now live inside the chat room drawer (Components/Chat/GroupSettingsPanel).
   This route stays for old links/bookmarks: open the room with the settings view. *@

@code {
    [Parameter] public Guid RoomId { get; set; }

    protected override void OnInitialized()
        => Nav.NavigateTo($"/chat/{RoomId}?panel=settings", replace: true);
}
