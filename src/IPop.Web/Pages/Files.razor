@page "/files"
@implements IDisposable
@using IPop.Web.Services
@using IPop.Web.Components.Files
@using IPop.Application.Files
@using System.Net.Http.Json
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject FileState FileStateService
@inject HttpClient Http
@inject PhoneState Phone
@using IPop.Web.Components.Phone.Files

<PageTitle>Files - IPop</PageTitle>

@{
    var rows = DisplayRows();
    var crumbs = GetBreadcrumbs();
    var inFolder = !IsRoot && !isRecycleBin && !isStarredView && !isRecentView && !needsCredential;
    var title = isStarredView ? "Starred" : isRecentView ? "Recent" : isRecycleBin ? "Recycle Bin" : IsRoot ? serverLabel : crumbs.LastOrDefault()?.Name ?? serverLabel;
}

@if (Phone.IsPhone)
{
    <div class="m-files-page" @ref="rootRef">
        @if (phoneLocations)
        {
            <LocationsPhone States="@(Servers.ToDictionary(s => s.Id, s => SiteStatus(s.Id).Css))" StarCount="stars.Count" OnSite="PhoneSite" OnFavorite="PhoneFavorite" OnSignIn="() => { credAllSites = true; showCred = true; }">
                <Search><button type="button" class="m-files-search" @onclick='async () => { await PushPhoneFolder(); await GoTo(server, "/"); SetSearchScope("all"); }'><i data-lucide="search"></i>Search files</button></Search>
            </LocationsPhone>
        }
        else
        {
            <BrowsePhone Title="@title" BackLabel="Files" OnBack="PhoneBack" Grid="gridView" SortKey="@sortBy" OnSort="PhoneSort" OnGrid="SetGridView" Selecting="phoneSelecting" OnSelect="PhoneSelect">
                <BreadcrumbContent>
                    <button type="button" @onclick='() => PhoneCrumb("/")'>@serverLabel</button>
                    @foreach (var crumb in crumbs) { <i data-lucide="chevron-right"></i><button type="button" @onclick="() => PhoneCrumb(crumb.Path)">@crumb.Name</button> }
                </BreadcrumbContent>
                <Search><input class="m-files-search" type="search" aria-label="Search files" placeholder="Search files" value="@search" @oninput="OnSearchInput" data-fx-search /></Search>
                <ChildContent>
                    @if (selectedPaths.Count > 0)
                    {
                        <div class="m-files-selection"><span>@selectedPaths.Count selected</span>
                            @if (isRecycleBin) { <button type="button" @onclick="RestoreSelected">Put back</button><button type="button" @onclick="DeleteSelectedPermanently">Delete permanently</button> }
                            else { <button type="button" @onclick="DownloadSelectedZip">Download zip</button><button type="button" @onclick="OpenMoveCopySelected">Move or copy</button><button type="button" @onclick="DeleteSelected">Delete</button> }
                        </div>
                    }
                    @if (needsCredential && !isStarredView && !isRecentView)
                    { <div class="m-files-empty"><h2>Connect to @serverLabel</h2><p>Sign in with your Synology account. Your existing permissions apply.</p><button type="button" @onclick="() => { credServer = server; showCred = true; }">Connect</button></div> }
                    else if (loadError is not null)
                    { <div class="m-files-empty" role="alert"><p>@loadError</p><button type="button" @onclick="ForceRefresh">Try again</button></div> }
                    else if (loading && rows.Count == 0) { <p class="m-files-empty" role="status">Loading…</p> }
                    else if (rows.Count == 0) { <p class="m-files-empty">@(searchRunning ? "Searching…" : SearchMode ? "No matches" : isRecentView ? "Nothing opened yet" : isStarredView ? "No starred items yet" : isRecycleBin ? "Recycle Bin is empty" : "This folder is empty")</p> }
                    <div class="m-files-list @(gridView ? "m-files-grid" : "")">
                        @foreach (var row in rows)
                        {
                            var item = row.Item;
                            <div class="m-files-row" @key="row.Key">
                                <button type="button" class="m-files-open" @onclick="() => PhoneOpen(row)" aria-label="@(phoneSelecting ? $"Select {item.Name}" : item.Name)">
                                    @if (phoneSelecting && CanAct(row)) { <span role="checkbox" aria-checked="@(IsSelected(row) ? "true" : "false")"><i data-lucide="@(IsSelected(row) ? "square-check" : "square")"></i></span> }
                                    <span class="m-files-icon m-files-kind-@FileKinds.Kind(item.Name, item.IsDir)"><i data-lucide="@FileKinds.Icon(item.Name, item.IsDir)"></i>@if (!item.IsDir) { <small>@FileKinds.Label(item.Name)</small> }</span>
                                    <span class="m-files-name"><strong>@item.Name</strong><small>@(item.IsDir ? "Folder" : FileKinds.Size(item.Size))@(item.Mtime > 0 ? " · " + FileKinds.When(item.Mtime) : "")@(ShowLocation ? " · " + Where(row) : "")</small></span>
                                </button>
                                <button type="button" class="m-files-more" aria-label="@($"Actions for {item.Name}")" @onclick="() => phoneAction = row"><i data-lucide="ellipsis"></i></button>
                            </div>
                        }
                    </div>
                    @if (searchRunning) { <button type="button" class="m-files-button" @onclick="() => { searchCts?.Cancel(); searchRunning = false; }">Stop search</button> }
                    @if (activeTransfers.Count > 0) { @foreach (var transfer in activeTransfers.Values) { <p role="status">@(transfer.Kind == "move" ? "Moving" : "Copying") · @transfer.Completed / @transfer.Total</p> } }
                </ChildContent>
            </BrowsePhone>
            @if (inFolder) { <Fab Icon="upload" Label="Upload" OnClick="() => phoneUpload = true" /> }
            @if (uploads.Count > 0 && !phoneUpload) { <button type="button" class="m-files-upload-status" @onclick="() => phoneUpload = true">Uploads · @UploadPercent%</button> }
        }
        <UploadSheet Open="phoneUpload" OpenChanged="v => phoneUpload = v" Folder="@(crumbs.LastOrDefault()?.Name ?? serverLabel)" Uploading="@(uploads.Any(u => u.Ok is null) && !uploadCancelled)" OnPick="PhonePick" OnFolder="() => { phoneUpload = false; OpenNewFolderModal(); }" OnCancel="CancelUpload">
            <Progress>@foreach (var upload in uploads) { <div class="m-files-progress"><strong>@upload.Name</strong><progress max="@Math.Max(1, upload.Size)" value="@(upload.Ok == true ? upload.Size : upload.Sent)"></progress><small>@(upload.Ok == true ? "Done" : upload.Ok == false ? upload.Error : uploadCancelled ? "Cancelled" : $"{FileKinds.Size(upload.Sent)} of {FileKinds.Size(upload.Size)}")</small></div> }@if (uploads.Count > 0 && (uploadCancelled || uploads.All(u => u.Ok is not null))) { <button type="button" class="m-files-button" @onclick="DismissUploads">Dismiss uploads</button> }</Progress>
        </UploadSheet>
    </div>
}
else
{
<div class="files-page fx @(sideOpen ? "side-open" : "")" @ref="rootRef">
    <div class="fx-window">
        @* ── Sidebar ─────────────────────────────────────────────────────── *@
        <aside class="fx-side" aria-label="Places">
            <div class="fx-side-group">
                <div class="fx-side-label">Favorites</div>
                <button type="button" class="fx-place @(isStarredView ? "on" : "")" @onclick="() => { isStarredView = true; isRecentView = false; isRecycleBin = false; CancelSearch(true); selectedPaths.Clear(); focusKey = null; sideOpen = false; }">
                    <i data-lucide="star" class="fx-ic-star"></i><span>Starred</span>@if (stars.Count > 0) { <em>@stars.Count</em> }
                </button>
                <button type="button" class="fx-place @(isRecentView ? "on" : "")" @onclick="EnterRecentView">
                    <i data-lucide="clock" class="fx-ic-recent"></i><span>Recent</span>
                </button>
            </div>

            <div class="fx-side-group">
                <div class="fx-side-label">Locations</div>
                @foreach (var s in Servers)
                {
                    var st = SiteStatus(s.Id);
                    var open = expandedSites.Contains(s.Id);
                    var here = s.Id == server && !isStarredView && !isRecentView && !isRecycleBin;
                    <div class="fx-site @(open ? "open" : "")">
                        <div class="fx-place fx-site-row @(here && IsRoot ? "on" : "")" data-drop-server="@s.Id" data-drop-path="">
                            <button type="button" class="fx-disclose" aria-label="@(open ? "Collapse" : "Expand") @s.Label" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleSite(s.Id)"><i data-lucide="chevron-right"></i></button>
                            <button type="button" class="fx-site-main" title="@s.Host · @st.Text" @onclick='() => GoTo(s.Id, "/")'>
                                <i data-lucide="server"></i><span>@s.Label</span><span class="fx-dot @st.Css" aria-label="@st.Text"></span>
                            </button>
                        </div>
                        @if (open)
                        {
                            var list = SharesFor(s.Id);
                            <div class="fx-shares">
                                @if (list is null)
                                {
                                    <span class="fx-side-hint">@(st.Css == "on" ? "Loading…" : "Not connected")</span>
                                }
                                else
                                {
                                    @foreach (var sh in list)
                                    {
                                        var active = here && (currentPath == sh || currentPath.StartsWith(sh + "/"));
                                        <button type="button" class="fx-place fx-share @(active ? "on" : "")" data-drop-server="@s.Id" data-drop-path="@sh" @onclick="() => GoTo(s.Id, sh)">
                                            <i data-lucide="folder"></i><span>@ShareName(sh)</span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                <button type="button" class="fx-place fx-bin @(isRecycleBin ? "on" : "")" @onclick="() => { isStarredView = false; isRecentView = false; CancelSearch(true); sideOpen = false; EnterRecycleBin(); }">
                    <i data-lucide="trash-2"></i><span>Recycle Bin</span><small>@serverLabel</small>
                </button>
            </div>

            <div class="fx-side-foot">
                @if (storageInfo is { TotalBytes: > 0 } && storageInfo.Server == server)
                {
                    var pct = (int)(storageInfo.UsedBytes * 100 / storageInfo.TotalBytes);
                    <div class="fx-storage" title="@FileKinds.Size(storageInfo.FreeBytes) free">
                        <div class="fx-storage-top"><span>@serverLabel storage</span><span>@pct%</span></div>
                        <div class="fx-meter"><span class="@(pct >= 90 ? "hot" : "")" style="width:@(pct)%"></span></div>
                        <div class="fx-storage-sub">@FileKinds.Size(storageInfo.UsedBytes) of @FileKinds.Size(storageInfo.TotalBytes)</div>
                    </div>
                }
                <button type="button" class="fx-connect" @onclick="() => { credAllSites = true; showCred = true; }">
                    <i data-lucide="key-round"></i><span>@(siteCreds.Count == 0 ? "Connect sites" : "Manage sign-in")</span>
                </button>
            </div>
        </aside>
        <div class="fx-scrim" @onclick="() => sideOpen = false"></div>

        @* ── Main ────────────────────────────────────────────────────────── *@
        <section class="fx-main" data-fx-dropzone data-drop-server="@server" data-drop-path="@(inFolder ? currentPath : "")">
            <header class="fx-toolbar">
                <button type="button" class="fx-tb fx-side-toggle" aria-label="Show places" @onclick="() => sideOpen = !sideOpen"><i data-lucide="panel-left"></i></button>
                <div class="fx-nav" role="group" aria-label="History">
                    <button type="button" class="fx-tb" title="Back (Alt+←)" disabled="@(backStack.Count == 0)" @onclick="GoBack"><i data-lucide="chevron-left"></i></button>
                    <button type="button" class="fx-tb" title="Forward (Alt+→)" disabled="@(forwardStack.Count == 0)" @onclick="GoForward"><i data-lucide="chevron-right"></i></button>
                </div>
                <div class="fx-title">
                    <h1>@title</h1>
                    @if (isRevalidating || loading) { <i data-lucide="loader-circle" class="spin fx-busy"></i> }
                </div>
                <div class="fx-tools">
                    <div class="fx-seg" role="group" aria-label="View">
                        <button type="button" class="@(!gridView ? "on" : "")" title="as List" aria-pressed="@(!gridView ? "true" : "false")" @onclick="() => SetGridView(false)"><i data-lucide="list"></i></button>
                        <button type="button" class="@(gridView ? "on" : "")" title="as Icons" aria-pressed="@(gridView ? "true" : "false")" @onclick="() => SetGridView(true)"><i data-lucide="layout-grid"></i></button>
                    </div>
                    @if (selectedPaths.Count > 0)
                    {
                        <span class="fx-selacts" role="group" aria-label="Selection">
                            @if (isRecycleBin)
                            {
                                <button type="button" class="fx-tb" title="Put back" @onclick="RestoreSelected"><i data-lucide="undo-2"></i></button>
                                <button type="button" class="fx-tb fx-danger-txt" title="Delete permanently" @onclick="DeleteSelectedPermanently"><i data-lucide="trash-2"></i></button>
                            }
                            else
                            {
                                <button type="button" class="fx-tb" title="Download" @onclick="DownloadSelectedZip"><i data-lucide="download"></i></button>
                                <button type="button" class="fx-tb" title="Move / Copy" @onclick="OpenMoveCopySelected"><i data-lucide="folder-input"></i></button>
                                <button type="button" class="fx-tb" title="Move to Recycle Bin (Del)" @onclick="DeleteSelected"><i data-lucide="trash-2"></i></button>
                            }
                        </span>
                        <span class="fx-tb-sep"></span>
                    }
                    <button type="button" class="fx-tb" title="Sort" @onclick="OpenSortMenu"><i data-lucide="arrow-up-down"></i></button>
                    <button type="button" class="fx-tb @(showInfoPane ? "on" : "")" title="Get Info (Ctrl+I)" @onclick="ToggleInfoPane"><i data-lucide="info"></i></button>
                    @if (inFolder)
                    {
                        <button type="button" class="fx-tb" title="New folder" @onclick="OpenNewFolderModal"><i data-lucide="folder-plus"></i></button>
                        <button type="button" class="fx-upload-btn" @onclick="PickFiles" disabled="@uploading"><i data-lucide="upload"></i><span>Upload</span></button>
                    }
                    @if (isRecycleBin && items.Count > 0)
                    {
                        <button type="button" class="fx-tb fx-danger-txt" title="Empty Recycle Bin" @onclick="EmptyRecycleBin"><i data-lucide="trash-2"></i><span>Empty</span></button>
                    }
                    <div class="fx-search">
                        <i data-lucide="search"></i>
                        <input type="search" data-fx-search aria-label="Search files" placeholder="Search" value="@search" @oninput="OnSearchInput" />
                        @if (searchRunning) { <i data-lucide="loader-circle" class="spin fx-search-busy"></i> }
                        else if (search.Length > 0) { <button type="button" class="fx-search-x" aria-label="Clear search" @onclick="() => CancelSearch(true)"><i data-lucide="x"></i></button> }
                    </div>
                </div>
                <input type="file" data-fx-upload multiple hidden />
            </header>

            @if (SearchMode)
            {
                <div class="fx-scope" role="group" aria-label="Search in">
                    <span>Search:</span>
                    @if (!IsRoot) { <button type="button" class="@(searchScope == "folder" ? "on" : "")" @onclick='() => SetSearchScope("folder")'>“@(crumbs.LastOrDefault()?.Name ?? serverLabel)”</button> }
                    <button type="button" class="@(searchScope == "site" || (IsRoot && searchScope == "folder") ? "on" : "")" @onclick='() => SetSearchScope("site")'>@serverLabel</button>
                    <button type="button" class="@(searchScope == "all" ? "on" : "")" @onclick='() => SetSearchScope("all")'>All sites</button>
                    <span class="fx-scope-status">
                        @if (searchRunning) { <text>Searching the NAS… @searchHits.Count found</text> }
                        else { <text>@rows.Count result@(rows.Count == 1 ? "" : "s")</text> }
                    </span>
                    @if (searchRunning) { <button type="button" class="fx-scope-stop" @onclick="() => { searchCts?.Cancel(); searchRunning = false; }">Stop</button> }
                </div>
            }

            <div class="fx-body">
                <div class="fx-content" @oncontextmenu="OpenBlankMenu" @oncontextmenu:preventDefault @onclick="ClearSelection">
                    @if (needsCredential && !isStarredView && !isRecentView)
                    {
                        <div class="fx-empty fx-connect-hero">
                            <div class="fx-empty-art"><i data-lucide="key-round"></i></div>
                            <h2>Connect to @serverLabel</h2>
                            <p>Sign in once with your Synology account, iPop tries it on all four sites. Same permissions as File Explorer.</p>
                            <button type="button" class="fx-primary" @onclick="() => { credAllSites = siteCreds.Count == 0; credServer = server; showCred = true; }" @onclick:stopPropagation>
                                <i data-lucide="key-round"></i>@(siteCreds.Count == 0 ? "Sign in to all sites" : $"Sign in to {serverLabel}")
                            </button>
                        </div>
                    }
                    else if (loadError is not null && rows.Count == 0)
                    {
                        <div class="fx-empty">
                            <div class="fx-empty-art warn"><i data-lucide="circle-alert"></i></div>
                            <h2>@loadError</h2>
                            <p>The NAS didn't answer. It may be busy or offline.</p>
                            <button type="button" class="fx-secondary" @onclick="ForceRefresh" @onclick:stopPropagation><i data-lucide="refresh-cw"></i>Try again</button>
                        </div>
                    }
                    else if (loading && rows.Count == 0)
                    {
                        <div class="fx-skel @(gridView ? "grid" : "")" aria-busy="true" aria-label="Loading">
                            @for (var i = 0; i < 10; i++) { <div class="fx-skel-row" style="--d:@(i * 60)ms"><span></span><span></span></div> }
                        </div>
                    }
                    else if (rows.Count == 0)
                    {
                        <div class="fx-empty">
                            @if (SearchMode)
                            {
                                <div class="fx-empty-art"><i data-lucide="search-x"></i></div>
                                <h2>@(searchRunning ? "Searching…" : "No matches")</h2>
                                <p>@(searchRunning ? "Results appear as the NAS finds them." : searchScope == "all" ? "Nothing on any connected site matches that name." : "Try searching all sites.")</p>
                                @if (!searchRunning && searchScope != "all") { <button type="button" class="fx-secondary" @onclick='() => SetSearchScope("all")' @onclick:stopPropagation>Search all sites</button> }
                            }
                            else if (isStarredView)
                            {
                                <div class="fx-empty-art star"><i data-lucide="star"></i></div>
                                <h2>No starred items yet</h2>
                                <p>Right-click a file or folder and choose Add to Starred. Stars follow you to any computer.</p>
                            }
                            else if (isRecentView)
                            {
                                <div class="fx-empty-art"><i data-lucide="clock"></i></div>
                                <h2>Nothing opened yet</h2>
                                <p>Files you open show up here, from every site.</p>
                            }
                            else if (isRecycleBin)
                            {
                                <div class="fx-empty-art"><i data-lucide="trash-2"></i></div>
                                <h2>Recycle Bin is empty</h2>
                                <p>Deleted items from @serverLabel land here first.</p>
                            }
                            else
                            {
                                <div class="fx-empty-art"><i data-lucide="folder-open"></i></div>
                                <h2>This folder is empty</h2>
                                <p>Drop files here to upload, or create a folder.</p>
                                @if (inFolder)
                                {
                                    <span class="fx-empty-acts">
                                        <button type="button" class="fx-primary" @onclick="PickFiles" @onclick:stopPropagation><i data-lucide="upload"></i>Upload</button>
                                        <button type="button" class="fx-secondary" @onclick="OpenNewFolderModal" @onclick:stopPropagation><i data-lucide="folder-plus"></i>New folder</button>
                                    </span>
                                }
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@(gridView ? "fx-grid" : "fx-list") @(ShowLocation ? "with-where" : "")" role="listbox" aria-multiselectable="true" aria-label="@title">
                            @if (!gridView)
                            {
                                <div class="fx-head" role="presentation" @onclick:stopPropagation>
                                    <button type="button" class="c-name" @onclick='() => SortBy("name")'>Name<i data-lucide="@SortIcon("name")"></i></button>
                                    @if (ShowLocation) { <span class="c-where">Where</span> }
                                    <button type="button" class="c-date" @onclick='() => SortBy("modified")'>@(isRecentView ? "Opened" : "Date Modified")<i data-lucide="@SortIcon("modified")"></i></button>
                                    <button type="button" class="c-size" @onclick='() => SortBy("size")'>Size<i data-lucide="@SortIcon("size")"></i></button>
                                    <button type="button" class="c-kind" @onclick='() => SortBy("kind")'>Kind<i data-lucide="@SortIcon("kind")"></i></button>
                                    <span class="c-more"></span>
                                </div>
                            }
                            @foreach (var r in rows)
                            {
                                var it = r.Item;
                                var kind = FileKinds.Kind(it.Name, it.IsDir);
                                var sel = IsSelected(r);
                                var act = CanAct(r);
                                var dropHere = it.IsDir && !isRecycleBin && r.Server == server && !ShowLocation;
                                <div @key="r.Key" class="fx-item fk-@kind @(sel ? "is-selected" : "") @(focusKey == r.Key ? "is-focus" : "") @(!it.IsDir && !isRecycleBin && !IsRoot ? "" : "")"
                                     role="option" aria-selected="@(sel ? "true" : "false")" title="@it.Name"
                                     data-fx-item="@r.Key" draggable="@(act && !isRecycleBin ? "true" : "false")"
                                     data-drop-server="@(dropHere ? r.Server : null)" data-drop-path="@(dropHere ? it.Path : null)"
                                     @onclick="e => OnRowClick(r, e)" @onclick:stopPropagation
                                     @ondblclick="() => OpenRow(r)"
                                     @oncontextmenu="e => OpenItemMenu(r, e)" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
                                    <span class="c-name">
                                        <span class="fx-icon"><i data-lucide="@(IsRoot && it.IsDir ? "folder-closed" : FileKinds.Icon(it.Name, it.IsDir))"></i></span>
                                        <span class="fx-name">@it.Name</span>
                                        @if (IsStarred(r)) { <i data-lucide="star" class="fx-star" aria-label="Starred"></i> }
                                    </span>
                                    @if (gridView)
                                    {
                                        <span class="fx-sub">@(ShowLocation ? SiteLabel(r.Server) : it.IsDir ? "" : FileKinds.Size(it.Size))</span>
                                    }
                                    else
                                    {
                                        @if (ShowLocation) { <span class="c-where" title="@Where(r)">@Where(r)</span> }
                                        <span class="c-date">@(it.Mtime > 0 ? FileKinds.When(it.Mtime) : "—")</span>
                                        <span class="c-size">@(it.IsDir || it.Size == 0 && ShowLocation ? "—" : FileKinds.Size(it.Size))</span>
                                        <span class="c-kind">@FileKinds.Label(it.Name, it.IsDir)</span>
                                    }
                                    <button type="button" class="fx-more" aria-label="Actions for @it.Name" @onclick="e => OpenItemMenu(r, e)" @onclick:stopPropagation><i data-lucide="ellipsis"></i></button>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (showInfoPane)
                {
                    <aside class="fx-info" aria-label="Info">
                        <button type="button" class="fx-info-x" aria-label="Close info" @onclick="ToggleInfoPane"><i data-lucide="x"></i></button>
                        @if (infoItem is null)
                        {
                            <div class="fx-info-empty">
                                <i data-lucide="info"></i>
                                <p>Select an item to see its details.</p>
                            </div>
                        }
                        else
                        {
                            var ik = FileKinds.Kind(infoItem.Name, infoItem.IsDir);
                            var infoRow = new Row(infoSite ?? server, infoItem);
                            <div class="fx-info-hero fk-@ik"><span class="fx-icon big"><i data-lucide="@FileKinds.Icon(infoItem.Name, infoItem.IsDir)"></i></span></div>
                            <h3>@infoItem.Name</h3>
                            <p class="fx-info-kind">@FileKinds.Label(infoItem.Name, infoItem.IsDir)@(infoItem.IsDir ? "" : " · " + FileKinds.Size(infoItem.Size))</p>
                            <dl>
                                <dt>Site</dt><dd>@SiteLabel(infoRow.Server)</dd>
                                <dt>Where</dt><dd class="mono">@ParentOf(infoItem.Path)</dd>
                                @if (infoItem.Mtime > 0) { <dt>@(isRecentView ? "Opened" : "Modified")</dt><dd>@FileKinds.When(infoItem.Mtime)</dd> }
                            </dl>
                            <div class="fx-info-acts">
                                @if (!infoItem.IsDir && IsPreviewable(infoItem.Name)) { <button type="button" @onclick="() => QuickLook(infoRow)"><i data-lucide="eye"></i>Quick Look</button> }
                                else { <button type="button" @onclick="() => OpenRow(infoRow)"><i data-lucide="folder-open"></i>Open</button> }
                                <button type="button" @onclick="() => ToggleStar(infoRow)"><i data-lucide="star"></i>@(IsStarred(infoRow) ? "Unstar" : "Star")</button>
                                <button type="button" @onclick='() => CopyText(infoItem.Path, "Path copied")'><i data-lucide="copy"></i>Copy path</button>
                            </div>
                        }
                    </aside>
                }
            </div>

            @if (!isStarredView && !isRecentView && !IsRoot && crumbs.Count > 0)
            {
                <nav class="fx-path" aria-label="Path">
                    <button type="button" class="fx-crumb" data-drop-server="@server" data-drop-path="" @onclick='() => GoTo(server, "/")'><i data-lucide="server"></i>@serverLabel</button>
                    @foreach (var c in crumbs)
                    {
                        <i data-lucide="chevron-right" class="fx-crumb-sep"></i>
                        <button type="button" class="fx-crumb @(c.IsLast ? "last" : "")" data-drop-server="@(isRecycleBin ? "" : server)" data-drop-path="@(isRecycleBin || c.IsLast ? "" : c.Path)" @onclick="() => Navigate(c.Path)">@c.Name</button>
                    }
                </nav>
            }
            <footer class="fx-status">
                @if (needsCredential && !isStarredView && !isRecentView) { <span>Not connected</span> }
                else
                {
                    <span>@rows.Count item@(rows.Count == 1 ? "" : "s")@(selectedPaths.Count > 0 ? $", {selectedPaths.Count} selected" : "")</span>
                    @if (credential?.Username is not null && !isStarredView && !isRecentView) { <span class="fx-status-who"><i data-lucide="user-round"></i>@credential.Username on @serverLabel</span> }
                }
            </footer>
        </section>
    </div>

    @if (ctxOpen)
    {
        <ContextMenu @ref="ctxMenu" Items="ctxItems" OnClosed="() => ctxOpen = false" />
    }

    @if (uploading || activeTransfers.Count > 0)
    {
        <div class="fx-tasks" role="status" aria-live="polite">
            @if (uploading)
            {
                var done = uploads.Count(u => u.Ok is not null);
                var failed = uploads.Count(u => u.Ok == false);
                var running = uploads.Any(u => u.Ok is null) && !uploadCancelled;
                <div class="fx-task @(running ? "is-running" : failed == 0 && !uploadCancelled ? "is-done" : "")">
                    <div class="fx-task-head">
                        @* @key swaps the icon element when the state changes, so the finished tick pops in fresh (#13). *@
                        <i @key="@(running ? "up" : failed > 0 ? "err" : "ok")" data-lucide="@(running ? "cloud-upload" : failed > 0 ? "circle-alert" : "check")" class="@(failed > 0 && !running ? "err" : "")"></i>
                        <strong>@(running ? $"Uploading {Math.Min(done + 1, uploads.Count)} of {uploads.Count}" : failed > 0 ? $"{failed} upload{(failed == 1 ? "" : "s")} failed" : uploadCancelled ? "Upload stopped" : "Uploaded")</strong>
                        <span>@FileKinds.Size(UploadSent) / @FileKinds.Size(UploadTotal)</span>
                        @if (running) { <button type="button" class="fx-task-x" title="Cancel" @onclick="CancelUpload"><i data-lucide="x"></i></button> }
                        else { <button type="button" class="fx-task-x" title="Dismiss" @onclick="DismissUploads"><i data-lucide="x"></i></button> }
                    </div>
                    <div class="fx-meter"><span style="width:@(UploadPercent)%"></span></div>
                    @if (!running && failed > 0)
                    {
                        <ul class="fx-task-errs">
                            @foreach (var u in uploads.Where(u => u.Ok == false)) { <li><span>@u.Name</span><em>@u.Error</em></li> }
                        </ul>
                    }
                </div>
            }
            @foreach (var t in activeTransfers.Values)
            {
                <div class="fx-task">
                    <div class="fx-task-head">
                        <i data-lucide="arrow-right-left"></i>
                        <strong>@(t.Kind == "move" ? "Moving" : "Copying") to @SiteLabel(t.DestServer)</strong>
                        <span>@t.Completed / @t.Total</span>
                    </div>
                    <div class="fx-meter"><span style="width:@(t.Total > 0 ? t.Completed * 100 / t.Total : 0)%"></span></div>
                </div>
            }
        </div>
    }
</div>

}

@if (Phone.IsPhone)
{
    <BottomSheet Open="@(phoneAction is not null)" OpenChanged="v => { if (!v) phoneAction = null; }" Title="@phoneAction?.Item.Name" Class="m-files-sheet">
        @if (phoneAction is not null)
        {
            @if (!isRecycleBin)
            {
                <div class="m-files-quick-actions">
                    @if (!phoneAction.Item.IsDir && phoneAction.Server == server) { <button type="button" @onclick='() => PhoneAction("download")'><i data-lucide="download"></i>Download</button> }
                    @if (CanAct(phoneAction)) { <button type="button" @onclick='() => PhoneAction("share")'><i data-lucide="link"></i>Share link</button> }
                    <button type="button" @onclick='() => PhoneAction("star")'><i data-lucide="star"></i>@(IsStarred(phoneAction) ? "Starred" : "Star")</button>
                </div>
                @if (CanAct(phoneAction))
                {
                    <button type="button" class="m-files-place" @onclick='() => PhoneAction("move")'><i data-lucide="folder-input"></i><span>Move or copy</span></button>
                    <button type="button" class="m-files-place" @onclick='() => PhoneAction("rename")'><i data-lucide="pencil"></i><span>Rename</span></button>
                }
            }
            <button type="button" class="m-files-place" @onclick='() => PhoneAction("info")'><i data-lucide="info"></i><span>Info</span></button>
            @if (isRecycleBin && CanAct(phoneAction))
            {
                <button type="button" class="m-files-place" @onclick='() => PhoneAction("restore")'><i data-lucide="undo-2"></i><span>Put back</span></button>
                <button type="button" class="m-files-place m-files-danger" @onclick='() => PhoneAction("permanent")'><i data-lucide="trash-2"></i><span>Delete permanently</span></button>
            }
            else if (!isRecycleBin && CanAct(phoneAction)) { <button type="button" class="m-files-place m-files-danger" @onclick='() => PhoneAction("delete")'><i data-lucide="trash-2"></i><span>Move to Recycle Bin</span></button> }
        }
    </BottomSheet>
    <BottomSheet Open="phoneInfo" OpenChanged="v => phoneInfo = v" Title="Info" Class="m-files-sheet">
        @if (infoItem is not null) { <dl class="m-files-info"><dt>Name</dt><dd>@infoItem.Name</dd><dt>Kind</dt><dd>@FileKinds.Label(infoItem.Name, infoItem.IsDir)</dd><dt>Size</dt><dd>@FileKinds.Size(infoItem.Size)</dd><dt>Site</dt><dd>@SiteLabel(infoSite ?? server)</dd><dt>Where</dt><dd>@infoItem.Path</dd>@if (infoItem.Mtime > 0) { <dt>Modified</dt><dd>@FileKinds.When(infoItem.Mtime)</dd> }</dl> }
    </BottomSheet>
}

@if (showCred && Phone.IsPhone)
{
    <BottomSheet Open="showCred" OpenChanged="v => showCred = v" Title="Manage sign-in" Class="m-files-sheet">
        <div class="m-files-dialog">
            <p class="m-files-note">One account, tried on every site. Your Synology permissions apply.</p>
            <label>Sites<select @bind="credAllSites"><option value="true">All sites</option><option value="false">@credServer.ToUpperInvariant()</option></select></label>
            <label>Synology username<input autocomplete="username" @bind="credUser" /></label>
            <label>Password<input type="password" autocomplete="current-password" @bind="credPass" /></label>
            @foreach (var site in Servers) { <p>@SiteLabel(site.Id) · @(SiteStatus(site.Id).Css switch { "on" => "Connected", "warn" => "Sign in again", "err" => "Unreachable", _ => "Not connected" })</p> }
            @if (credError is not null) { <p role="alert">@credError</p> }
            <button type="button" class="m-files-button" disabled="credBusy" @onclick="SaveCredential">@(credBusy ? "Connecting…" : credAllSites ? "Connect all sites" : "Save & connect")</button>
            @if (!credAllSites) { <button type="button" class="m-files-button" disabled="credBusy" @onclick="ClearCredential">Disconnect</button> }
        </div>
    </BottomSheet>
}
else if (showCred)
{
    <OverlayHook OnClose="() => showCred = false" />
    <div class="backdrop on" @onclick="() => showCred = false"></div>
    <div class="drawer on" role="dialog" aria-label="Connect Synology">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">@(credAllSites ? "Connect to all sites" : $"Connect {Servers.First(x => x.Id == credServer).Label}") <button class="drawer-close" @onclick="() => showCred = false"><i data-lucide="x"></i></button></div>
            <div class="drawer-body" style="flex:1; overflow:auto">
                @if (credential?.IsInvalid == true)
                { <div class="note err"><i data-lucide="alert-triangle"></i><span>Stored credential was rejected - please re-enter it.</span></div> }
                <div class="field" style="margin-top:12px"><label>Sign in to</label><div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px">
                    <button class="admin-tab @(credAllSites ? "active" : "")" @onclick="() => credAllSites = true" style="padding:6px 12px; font-size:12px">All sites</button>
                    @foreach (var s in Servers)
                    { <button class="admin-tab @(!credAllSites && credServer == s.Id ? "active" : "")" @onclick="() => { credAllSites = false; credServer = s.Id; }" style="padding:6px 12px; font-size:12px">@s.Label</button> }
                </div></div>
                @if (credAllSites)
                {
                    <div class="files-site-status">
                        @foreach (var s in Servers)
                        {
                            var st = SiteStatus(s.Id);
                            <div class="files-site-row"><span class="files-site-dot @st.Css"></span><strong>@s.Label</strong><span class="files-site-text">@st.Text</span></div>
                        }
                    </div>
                }
                <div class="field"><label>Synology username</label><input placeholder="alice" @bind="credUser" /></div>
                <div class="field"><label>Password</label><input type="password" placeholder="••••••••" @bind="credPass" /></div>
                <div class="note"><i data-lucide="shield"></i><span>@(credAllSites ? "One account, tried on every site at once. Sites that reject it keep their own sign-in." : "Checked with the NAS before saving.") Stays signed in until you disconnect.</span></div>
                @if (credError is not null) { <div class="note err"><i data-lucide="alert-circle"></i><span>@credError</span></div> }
            </div>
            <div style="padding:14px 18px; border-top:1px solid var(--line-soft); display:flex; gap:8px; background:var(--bg)">
                <button class="btn" style="flex:1; margin:0" disabled="@credBusy" @onclick="SaveCredential">@(credBusy ? "Connecting…" : credAllSites ? "Connect all sites" : "Save & connect") <span class="orb"><i data-lucide="arrow-right"></i></span></button>
                @if (!credAllSites)
                { <button class="btn" style="width:auto; margin:0; background:var(--surface); color:var(--ink); border:1px solid var(--line)" @onclick="ClearCredential">Disconnect</button> }
            </div>
        </div></div>
    </div>
}

@if (Phone.IsPhone && showPreview && previewItem is not null)
{
    <PreviewPhone Name="@previewItem.Name" Url="@previewUrl" Mime="@previewMime" Loading="previewLoading" Error="@previewError" OfficeUrl="@(IsCoAuthorable(previewItem.Name) ? GetEditorUrl(previewItem) + "&embedded=1" : null)" OnClose="ClosePreview" OnDownload="() => Download(previewItem)" OnShare="() => phoneAction = new Row(server, previewItem)">
    </PreviewPhone>
}
else if (showPreview)
{
    @* Quick Look: one quiet header (icon, name, kind · size, icon actions), the document fills the rest. *@
    <div class="fx-ql-scrim" @onclick="ClosePreview"></div>
    <div class="fx-ql" role="dialog" aria-modal="true" aria-label="@($"Quick Look: {previewItem?.Name}")">
        <header class="fx-ql-head">
            @if (previewItem is not null)
            {
                var qk = FileKinds.Kind(previewItem.Name);
                <span class="fx-icon fk-@qk"><i data-lucide="@FileKinds.Icon(previewItem.Name)"></i></span>
                <div class="fx-ql-title">
                    <strong title="@previewItem.Name">@previewItem.Name</strong>
                    <small>@FileKinds.Label(previewItem.Name)@(previewItem.Size > 0 ? " · " + FileKinds.Size(previewItem.Size) : "")@(previewItem.Mtime > 0 ? " · " + FileKinds.When(previewItem.Mtime) : "")</small>
                </div>
            }
            <div class="fx-ql-acts">
                @if (previewItem is not null && IsCoAuthorable(previewItem.Name))
                { <a href="@GetEditorUrl(previewItem)" target="_blank" class="fx-ql-open" title="Edit together in ONLYOFFICE (new tab)"><i data-lucide="users"></i><span>Open to edit</span></a> }
                <button type="button" class="fx-tb" title="Show in File Explorer" @onclick="OpenInExplorer"><i data-lucide="folder-open"></i></button>
                <button type="button" class="fx-tb" title="Print" @onclick="PrintPreview"><i data-lucide="printer"></i></button>
                <button type="button" class="fx-tb" title="Download" @onclick="() => Download(previewItem!)"><i data-lucide="download"></i></button>
                <span class="fx-tb-sep"></span>
                <button type="button" class="fx-tb" title="Close (Esc)" aria-label="Close" @onclick="ClosePreview"><i data-lucide="x"></i></button>
            </div>
        </header>
        <div class="fx-ql-body @(isSheetPreview && previewError is null ? "is-sheet" : "")">
            @if (previewLoading)
            { <div class="fx-ql-msg"><i data-lucide="loader-circle" class="spin"></i><span>Loading preview…</span></div> }
            else if (previewError is not null)
            {
                <div class="fx-empty">
                    <div class="fx-empty-art warn"><i data-lucide="circle-alert"></i></div>
                    <h2>Can't preview this file</h2>
                    <p>@previewError</p>
                    @if (previewItem is not null) { <button type="button" class="fx-secondary" @onclick="() => Download(previewItem)"><i data-lucide="download"></i>Download</button> }
                </div>
            }
            else if (isSheetPreview && previewSheetBytes is not null)
            {
                <ExcelViewer FileName="@previewItem?.Name" Bytes="@previewSheetBytes" Compact="true" Height="100%" />
            }
            else if (previewItem is not null && GetFileExt(previewItem.Name) == ".xls")
            {
                <div id="office-preview" style="width:100%"></div>
            }
            else if (previewUrl is not null && previewMime is not null)
            {
                @if (previewMime.StartsWith("image/"))
                { <img class="fx-ql-img" src="@previewUrl" alt="@previewItem?.Name" /> }
                else if (previewMime == "application/pdf")
                { <iframe id="preview-frame" class="fx-ql-frame" src="@previewUrl" title="@previewItem?.Name"></iframe> }
                else
                {
                    <div class="fx-empty">
                        <div class="fx-empty-art"><i data-lucide="file"></i></div>
                        <h2>No preview for this kind of file</h2>
                        <p>Download it to open on your computer.</p>
                    </div>
                }
            }
        </div>
    </div>
}

<FilesDialog Phone="Phone.IsPhone" IsOpen="showNewFolderModal" IsOpenChanged="v => showNewFolderModal = v" Title="New folder" Subtitle="@($"In {ShareName(currentPath)}")">
    <ChildContent>
        <form class="fx-form" @onsubmit="CreateFolder" @onsubmit:preventDefault>
            <input class="fx-input" aria-label="Folder name" placeholder="untitled folder" @bind="newFolderName" @bind:event="oninput" autofocus />
        </form>
    </ChildContent>
    <Footer>
        <button type="button" class="fx-secondary" @onclick="() => showNewFolderModal = false">Cancel</button>
        <button type="button" class="fx-primary" disabled="@string.IsNullOrWhiteSpace(newFolderName)" @onclick="CreateFolder">Create</button>
    </Footer>
</FilesDialog>

<FilesDialog Phone="Phone.IsPhone" IsOpen="showRenameModal" IsOpenChanged="v => showRenameModal = v" Title="Rename" Subtitle="@renameTargetItem?.Name">
    <ChildContent>
        <form class="fx-form" @onsubmit="SaveRename" @onsubmit:preventDefault>
            <input class="fx-input" aria-label="New name" @bind="renameTargetName" @bind:event="oninput" autofocus />
        </form>
    </ChildContent>
    <Footer>
        <button type="button" class="fx-secondary" @onclick="() => showRenameModal = false">Cancel</button>
        <button type="button" class="fx-primary" disabled="@(string.IsNullOrWhiteSpace(renameTargetName) || renameTargetName == renameTargetItem?.Name)" @onclick="SaveRename">Rename</button>
    </Footer>
</FilesDialog>

<FilesDialog Phone="Phone.IsPhone" IsOpen="showMoveCopyModal" IsOpenChanged="v => showMoveCopyModal = v" Title="Move or copy" Subtitle="@(moveCopyPaths.Count == 1 ? moveCopyPaths[0] : $"{moveCopyPaths.Count} items")">
    <ChildContent>
        <div class="fx-form">
            <div class="fx-seg wide" role="group" aria-label="Action">
                <button type="button" class="@(moveCopyMode == "copy" ? "on" : "")" @onclick='() => moveCopyMode = "copy"'><i data-lucide="copy"></i>Copy</button>
                <button type="button" class="@(moveCopyMode == "move" ? "on" : "")" @onclick='() => moveCopyMode = "move"'><i data-lucide="folder-input"></i>Move</button>
            </div>
            <label class="fx-field"><span>Site</span>
                <div class="fx-seg wide" role="group" aria-label="Destination site">
                    @foreach (var s in Servers)
                    {
                        <button type="button" class="@(targetServer == s.Id ? "on" : "")" disabled="@(SiteStatus(s.Id).Css != "on" && s.Id != server)" @onclick="() => targetServer = s.Id">@s.Label</button>
                    }
                </div>
            </label>
            <label class="fx-field"><span>Folder</span>
                <input class="fx-input mono" placeholder="/share/folder" @bind="targetDestDir" @bind:event="oninput" />
            </label>
            @if (targetServer != server)
            {
                <p class="fx-hint"><i data-lucide="info"></i>Copying between sites runs in the background, progress shows bottom-right.</p>
            }
            <p class="fx-hint"><i data-lucide="mouse-pointer-2"></i>Tip: drag items onto a folder or a share in the sidebar. Hold Ctrl to copy.</p>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="fx-secondary" @onclick="() => showMoveCopyModal = false">Cancel</button>
        <button type="button" class="fx-primary" disabled="@string.IsNullOrWhiteSpace(targetDestDir)" @onclick="ExecuteMoveCopy">@(moveCopyMode == "move" ? "Move" : "Copy")</button>
    </Footer>
</FilesDialog>

<FilesDialog Phone="Phone.IsPhone" IsOpen="showShareModal" IsOpenChanged="v => showShareModal = v" Title="Share link" Subtitle="@shareTargetItem?.Name">
    <ChildContent>
        <div class="fx-form">
            @if (existingShareLinks.Count > 0)
            {
                @foreach (var l in existingShareLinks)
                {
                    <div class="fx-link">
                        <i data-lucide="link"></i>
                        <span class="mono">@l.Url</span>
                        <button type="button" class="fx-tb" title="Copy link" @onclick="() => CopyShareUrl(l.Url)"><i data-lucide="copy"></i></button>
                        <button type="button" class="fx-tb fx-danger-txt" title="Remove link" @onclick="() => DeleteShareLink(l.Id)"><i data-lucide="trash-2"></i></button>
                    </div>
                }
            }
            else
            {
                <p class="fx-hint">Anyone with the link can download this item for 14 days.</p>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="fx-secondary" @onclick="() => showShareModal = false">Done</button>
        @if (existingShareLinks.Count == 0) { <button type="button" class="fx-primary" @onclick="CreateShareLink"><i data-lucide="link"></i>Create link</button> }
    </Footer>
</FilesDialog>
