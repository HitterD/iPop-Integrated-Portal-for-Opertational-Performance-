@page "/files"
@implements IDisposable
@inject AuthState Auth
@inject IJSRuntime JS

<PageTitle>Files - IPop</PageTitle>

<div class="content files-page">
    <div class="admin-tabs files-servers">
        @foreach (var s in Servers)
        {
            <button class="admin-tab @(server == s.Id ? "active" : "")" @onclick="() => SwitchServer(s.Id)">
                <i data-lucide="hard-drive"></i> @s.Label <span class="mono" style="font-size:10px; opacity:0.6; margin-left:4px">@s.Host</span>
            </button>
        }
    </div>
    <div class="tray rise rise-1"><div class="core" style="padding:0; overflow:hidden">
        <div class="panel-head files-panel-head">
            <i data-lucide="folder"></i> <span>Files</span>
            <span class="meta">@serverLabel · @(shares?.Count ?? 0) shares</span>
            <span class="meta"><span class="live-dot"></span> Live</span>
            @if (!needsCredential && credential?.Username is not null)
            {
                <span class="files-account" title="Synology account for @serverLabel - same permissions as File Explorer">
                    <i data-lucide="user-round" style="width:13px;height:13px"></i> as <strong>@credential.Username</strong>
                </span>
            }
            <button class="btn btn-sm surface" style="margin-left:auto" @onclick="() => showCred = true">
                <i data-lucide="plug-zap" style="width:14px;height:14px"></i> @(needsCredential ? "Connect" : "Manage")
            </button>
        </div>
        @if (!needsCredential && credential?.Username is not null)
        {
            <div class="files-identity" role="status">
                <span class="files-identity-dot"></span>
                <span>Browsing <strong>@serverLabel</strong> as <strong>@credential.Username</strong> - same ACLs as File Explorer for that account.</span>
                <button class="files-identity-action" @onclick="() => showCred = true">Switch account</button>
            </div>
        }

        <div class="filter-bar">
            <div class="search"><i data-lucide="search"></i><input placeholder="Search name…" @bind="search" @bind:event="oninput" /></div>
            <AppSelect Label="Type filter" Value="@typeFilter" ValueChanged="v => { typeFilter = v; StateHasChanged(); }"
                       Options="@TypeOptions" />
            <AppSelect Label="Sort" Value="@sortBy" ValueChanged="v => { sortBy = v; StateHasChanged(); }"
                       Options="@SortOptions" />
            @if (!string.IsNullOrEmpty(typeFilter) || !string.IsNullOrWhiteSpace(search))
            {
                <button class="btn btn-sm surface" @onclick="ClearFilters"><i data-lucide="x" style="width:12px;height:12px"></i> Clear</button>
            }
            <label class="btn btn-sm accent">
                <i data-lucide="upload" style="width:14px;height:14px"></i> Upload
                <InputFile OnChange="OnUpload" style="display:none" />
            </label>
        </div>

        @if (needsCredential)
        {
            <div class="tree-empty" style="padding:28px">Connect your Synology account for @serverLabel to browse. <button class="btn btn-sm" style="display:inline-flex; margin-left:8px" @onclick="() => showCred = true">Connect</button></div>
        }
        else if (loadError is not null)
        {
            <div class="tree-empty" style="padding:28px"><p>@loadError</p><button class="btn btn-sm" style="margin:12px auto 0" @onclick="Reload">Retry</button></div>
        }
        else
        {
            <div class="files-shell">
                <aside class="files-shares">
                    <div class="files-shares-title">Shares · @serverLabel</div>
                    @if (loading && shares is null)
                    {
                        <div class="tree-empty">Loading…</div>
                    }
                    else if (shares is not null)
                    {
                        @foreach (var sh in shares)
                        {
                            var active = currentPath.StartsWith(sh);
                            <button class="share-btn @(active ? "active" : "")" @onclick="() => Enter(sh)">
                                <i data-lucide="@(sh.Contains("homes") ? "home" : sh.Contains("team") ? "users" : "building-2")"></i>
                                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@sh</span>
                                <i data-lucide="chevron-right" class="chev"></i>
                            </button>
                        }
                    }
                    <div class="note"><i data-lucide="shield-check"></i><span>Same ACLs as File Explorer.</span></div>
                </aside>

                <div class="files-browser">
                    <div class="files-crumb-bar">
                        <div class="files-nav">
                            <button class="files-nav-btn @(backStack.Count == 0 ? "dis" : "")" title="Back" @onclick="GoBack" disabled="@(backStack.Count == 0)">
                                <i data-lucide="arrow-left"></i>
                            </button>
                            <button class="files-nav-btn @(forwardStack.Count == 0 ? "dis" : "")" title="Forward" @onclick="GoForward" disabled="@(forwardStack.Count == 0)">
                                <i data-lucide="arrow-right"></i>
                            </button>
                            <button class="files-nav-btn @(currentPath == "/" ? "dis" : "")" title="Up" @onclick="GoUp" disabled="@(currentPath == "/")">
                                <i data-lucide="arrow-up"></i>
                            </button>
                        </div>
                        <button class="files-crumb-pill home" @onclick='() => Navigate("/")'>/</button>
                        @if (currentPath != "/")
                        {
                            <i data-lucide="chevron-right" style="width:14px;height:14px;color:var(--ink-3); flex-shrink:0"></i>
                            <span class="files-crumb-pill current" title="@currentPath">@currentPath</span>
                        }
                        <span class="meta" style="margin-left:6px; font-size:11px; color:var(--ink-3)">@filteredItems.Count items</span>
                    </div>

                    <div class="files-head">
                        <button @onclick='() => ToggleSort("name")'>Name <i data-lucide="@(sortBy.StartsWith("name") ? (sortBy == "name" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <button @onclick='() => ToggleSort("size")'>Size <i data-lucide="@(sortBy.StartsWith("size") ? (sortBy == "size" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <button @onclick='() => ToggleSort("modified")'>Modified <i data-lucide="@(sortBy.StartsWith("modified") ? (sortBy == "modified" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <span style="text-align:right">Action</span>
                    </div>

                    <div class="files-list">
                        @if (loading)
                        {
                            <div class="tree-empty" style="padding:24px">Loading…</div>
                        }
                        else if (filteredItems.Count == 0)
                        {
                            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter))
                            {
                                <div class="tree-empty" style="padding:28px">No matching files. <button class="btn btn-sm surface" style="display:inline-flex; margin-left:8px" @onclick="ClearFilters">Clear filters</button></div>
                            }
                            else
                            {
                                <div class="tree-empty" style="padding:28px">Empty folder.</div>
                            }
                        }
                        else
                        {
                            @foreach (var it in filteredItems)
                            {
                                <div class="file-row">
                                    <span class="fname" @onclick="() => OnItemClick(it)" title="@(it.IsDir ? "Open folder" : IsPreviewable(it.Name) ? "Click to preview" : "Download")">
                                        @if (it.IsDir)
                                        {
                                            <span class="fi" style="background:var(--accent-soft); color:var(--accent-ink)"><i data-lucide="folder"></i></span>
                                            <span class="n">@it.Name</span> <span class="tag">dir</span>
                                        }
                                        else
                                        {
                                            <span class="fi" style="background:@GetFileIconBg(it.Name); color:@GetFileIconColor(it.Name)"><i data-lucide="@GetFileIcon(it.Name)"></i></span>
                                            <span class="n">@it.Name</span> <span class="tag" style="background:@GetFileTagBg(it.Name); color:@GetFileTagColor(it.Name)">@GetFileExtLabel(it.Name)</span>
                                            @if (IsPreviewable(it.Name)) { <span class="tag" style="background:var(--accent-soft); color:var(--accent-ink); border:1px solid rgba(46,125,91,0.12)"><i data-lucide="eye" style="width:10px;height:10px; display:inline; vertical-align:middle; margin-right:3px"></i>Preview</span> }
                                        }
                                    </span>
                                    <span class="fmeta mono">@(it.IsDir ? "—" : FormatSize(it.Size))</span>
                                    <span class="fmeta">@FormatMtime(it.Mtime)</span>
                                    <span class="factions">
                                        @if (it.IsDir)
                                        {
                                            <i data-lucide="chevron-right" style="width:14px;height:14px;color:var(--ink-3)"></i>
                                        }
                                        else
                                        {
                                            <button class="org-act" title="Open in Explorer" @onclick="() => OpenInExplorerFor(it)"><i data-lucide="folder-open"></i></button>
                                            @if (IsPreviewable(it.Name))
                                            { <button class="org-act" title="Preview" @onclick="() => Preview(it)"><i data-lucide="eye"></i></button> }
                                            <button class="org-act" title="Download" @onclick="() => Download(it)"><i data-lucide="download"></i></button>
                                        }
                                    </span>
                                </div>
                            }
                        }
                    </div>

                    <div class="files-foot">
                        <span class="dot"></span> Live pass-through - no index
                        <span style="margin-left:auto; display:flex; gap:6px; align-items:center"><i data-lucide="eye" style="width:12px;height:12px"></i> Click eye to preview PDF / image, then Print</span>
                    </div>
                </div>
            </div>
        }
    </div></div>
</div>

@if (showCred)
{
    <div class="backdrop on" @onclick="() => showCred = false"></div>
    <div class="drawer on" role="dialog" aria-label="Connect Synology">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">Connect @serverLabel <button class="drawer-close" @onclick="() => showCred = false"><i data-lucide="x"></i></button></div>
            <div class="drawer-body" style="flex:1; overflow:auto">
                @if (credential?.IsInvalid == true)
                { <div class="note err"><i data-lucide="alert-triangle"></i><span>Stored credential was rejected - please re-enter it.</span></div> }
                <div class="field" style="margin-top:12px"><label>Server</label><div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px">
                    @foreach (var s in Servers)
                    { <button class="admin-tab @(credServer == s.Id ? "active" : "")" @onclick="() => credServer = s.Id" style="padding:6px 12px; font-size:12px">@s.Label</button> }
                </div></div>
                <div class="field"><label>Synology username</label><input placeholder="alice" @bind="credUser" /></div>
                <div class="field"><label>Password</label><input type="password" placeholder="••••••••" @bind="credPass" /></div>
                <div class="note"><i data-lucide="shield"></i><span>Validated live before storage. Wrong credentials never get saved. Sealed with Data Protection, key in Postgres.</span></div>
                @if (credError is not null) { <div class="note err"><i data-lucide="alert-circle"></i><span>@credError</span></div> }
            </div>
            <div style="padding:14px 18px; border-top:1px solid var(--line-soft); display:flex; gap:8px; background:var(--bg)">
                <button class="btn" style="flex:1; margin:0" @onclick="SaveCredential">Save &amp; connect <span class="orb"><i data-lucide="arrow-right"></i></span></button>
                <button class="btn" style="width:auto; margin:0; background:var(--surface); color:var(--ink); border:1px solid var(--line)" @onclick="ClearCredential">Clear</button>
            </div>
        </div></div>
    </div>
}

@if (showPreview)
{
    <div class="backdrop on" @onclick="ClosePreview"></div>
    <div class="drawer on" role="dialog" aria-label="Preview" style="width:min(1200px, 92vw)">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                <span style="display:flex; gap:8px; align-items:center; min-width:0"><i data-lucide="eye"></i> <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@previewItem?.Name</span> @if (previewMime is not null) { <span class="tag">@previewMime</span> }</span>
                <span style="display:flex; gap:6px; align-items:center">
                    <button class="org-act" title="Open in File Explorer" @onclick="OpenInExplorer"><i data-lucide="folder-open"></i></button>
                    <button class="org-act" title="Print" @onclick="PrintPreview"><i data-lucide="printer"></i></button>
                    <button class="org-act" title="Download" @onclick="() => Download(previewItem!)"><i data-lucide="download"></i></button>
                    <button class="drawer-close" @onclick="ClosePreview"><i data-lucide="x"></i></button>
                </span>
            </div>
            <div style="flex:1; overflow:auto; padding:14px; background:var(--bg); display:grid; place-items:center">
                @if (previewLoading)
                { <div class="tree-empty">Loading preview…</div> }
                else if (previewError is not null)
                { <div class="note err"><i data-lucide="alert-circle"></i><span>@previewError</span></div> }
                else if (isSheetPreview && previewSheetBytes is not null)
                {
                    <ExcelViewer FileName="@previewItem?.Name" Bytes="@previewSheetBytes" />
                }
                else if (previewItem is not null && GetFileExt(previewItem.Name) == ".xls")
                {
                    <div id="office-preview" style="width:100%"></div>
                }
                else if (previewUrl is not null && previewMime is not null)
                {
                    @if (previewMime.StartsWith("image/"))
                    { <img src="@previewUrl" alt="@previewItem?.Name" style="max-width:100%; max-height:calc(100dvh - 180px); object-fit:contain; border-radius:12px; border:1px solid var(--line-soft); background:var(--surface)" /> }
                    else if (previewMime == "application/pdf")
                    { <iframe id="preview-frame" src="@previewUrl" style="width:100%; height:calc(100dvh - 180px); border:1px solid var(--line-soft); border-radius:12px; background:var(--surface)"></iframe> }
                    else
                    { <div class="note"><i data-lucide="file-text"></i><span>Preview not available - use Download.</span></div> }
                }
            </div>
            <div style="padding:12px 14px; border-top:1px solid var(--line-soft); display:flex; gap:8px; background:var(--surface)">
                <button class="btn" style="flex:1; margin:0; background:var(--surface); color:var(--ink); border:1px solid var(--line)" @onclick="OpenInExplorer"><i data-lucide="folder-open" style="margin-right:6px"></i> Open in Explorer</button>
                <button class="btn" style="flex:1; margin:0" @onclick="PrintPreview"><i data-lucide="printer" style="margin-right:6px"></i> Print</button>
                <button class="btn" style="width:auto; margin:0; background:var(--surface); color:var(--ink); border:1px solid var(--line)" @onclick="() => Download(previewItem!)">Download</button>
            </div>
        </div></div>
    </div>
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    private string server = "spj";
    private string credServer = "spj";
    private string currentPath = "/";
    private readonly List<string> backStack = [];
    private readonly List<string> forwardStack = [];
    private string search = "";
    private string typeFilter = "";
    private string sortBy = "name";
    private bool loading, needsCredential, showCred;
    private string? loadError, credError;
    private string credUser = "", credPass = "";
    private List<SynoItemDto> items = [];
    private List<string>? shares;
    private CredentialStatusDto? credential;

    private bool showPreview;
    private SynoItemDto? previewItem;
    private string? previewUrl;
    private string? previewMime;
    private bool previewLoading;
    private string? previewError;
    private byte[]? previewSheetBytes;

    private static readonly List<AppOption> TypeOptions =
        [new("", "All types"), new("pdf", "PDF"), new("image", "Images"), new("sheet", "Excel"),
         new("word", "Word"), new("slide", "Slides"), new("archive", "Archives"), new("other", "Other")];
    private static readonly List<AppOption> SortOptions =
        [new("name", "Name A-Z"), new("name-desc", "Name Z-A"), new("modified-desc", "Newest"),
         new("modified", "Oldest"), new("size-desc", "Largest"), new("size", "Smallest")];

    private record ServerInfo(string Id, string Label, string Host);
    private static readonly ServerInfo[] Servers = [
        new("spj", "SPJ", "192.168.2.16"),
        new("krw", "KRW", "10.12.2.6"),
        new("jtb", "JTB", "10.11.2.6"),
        new("smg", "SMG", "10.14.2.16"),
    ];
    private string serverLabel => Servers.FirstOrDefault(s => s.Id == server)?.Label ?? server.ToUpperInvariant();
    private List<SynoItemDto> filteredItems
    {
        get
        {
            IEnumerable<SynoItemDto> q = items;
            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(i => i.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(typeFilter))
                q = q.Where(i => MatchesType(i.Name, typeFilter));
            q = sortBy switch
            {
                "name" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase),
                "name-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Name, StringComparer.OrdinalIgnoreCase),
                "modified" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Mtime),
                "modified-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Mtime),
                "size" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Size),
                "size-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Size),
                _ => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase),
            };
            return q.ToList();
        }
    }
    private static bool MatchesType(string name, string filter)
    {
        var ext = GetFileExt(name);
        return filter switch
        {
            "pdf" => ext == ".pdf",
            "image" => ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg",
            "sheet" => ext is ".xls" or ".xlsx" or ".csv",
            "word" => ext is ".doc" or ".docx",
            "slide" => ext is ".ppt" or ".pptx",
            "archive" => ext is ".zip" or ".rar" or ".7z" or ".tar" or ".gz",
            "other" => ext == "" || ext == ".txt" || ext == ".log" || ext == ".json",
            _ => true
        };
    }
    private void ToggleSort(string key)
    {
        if (sortBy == key) sortBy = key + "-desc";
        else if (sortBy == key + "-desc") sortBy = key;
        else sortBy = key;
        StateHasChanged();
    }
    private void ClearFilters()
    {
        search = ""; typeFilter = ""; sortBy = "name";
        StateHasChanged();
    }

    protected override void OnInitialized() => Layout.SetHeader("Files", "Files");
    protected override async Task OnInitializedAsync() => await Reload();

    private async Task SwitchServer(string id)
    {
        server = id; credServer = id; currentPath = "/"; search = "";
        await Reload();
    }

    private async Task Reload()
    {
        loading = true; loadError = null;
        shares = null; items = [];
        var cred = await Auth.GetAsync<CredentialStatusDto>($"/api/files/credential?server={server}");
        credential = cred;
        if (cred is null || !cred.HasCredential) { needsCredential = true; loading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); return; }
        if (cred.IsInvalid) { needsCredential = true; showCred = true; loading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); return; }
        needsCredential = false;
        if (currentPath == "/")
        {
            var s = await Auth.GetAsync<List<string>>($"/api/files/shares?server={server}");
            if (s is null) loadError = "Could not reach the NAS.";
            else shares = s;
        }
        else
        {
            var list = await Auth.GetAsync<List<SynoItemDto>>($"/api/files?server={server}&path={Uri.EscapeDataString(currentPath)}");
            if (list is null) loadError = "Could not load folder.";
            else items = list;
        }
        loading = false;
        StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons");
    }

    // Push the current path onto the back stack before navigating somewhere
    // new; forward gets cleared (a new branch invalidates the forward history).
    private void PushHistory()
    {
        if (backStack.Count == 0 || backStack[^1] != currentPath) backStack.Add(currentPath);
        forwardStack.Clear();
    }

    private void Enter(string share) { PushHistory(); currentPath = share; _ = Reload(); }
    private Task OnItemClick(SynoItemDto it)
    {
        if (it.IsDir) { PushHistory(); currentPath = it.Path; return Reload(); }
        if (IsPreviewable(it.Name)) return Preview(it);
        return Download(it);
    }
    private void GoUp() { PushHistory(); var p = currentPath.TrimEnd('/'); var idx = p.LastIndexOf('/'); currentPath = idx <= 0 ? "/" : p[..idx]; _ = Reload(); }
    private async Task Navigate(string path)
    {
        if (path == currentPath) return; // clicking the current crumb is a no-op
        PushHistory(); currentPath = path; await Reload();
    }
    private void GoBack()
    {
        if (backStack.Count == 0) return;
        forwardStack.Add(currentPath);
        currentPath = backStack[^1];
        backStack.RemoveAt(backStack.Count - 1);
        _ = Reload();
    }
    private void GoForward()
    {
        if (forwardStack.Count == 0) return;
        backStack.Add(currentPath);
        currentPath = forwardStack[^1];
        forwardStack.RemoveAt(forwardStack.Count - 1);
        _ = Reload();
    }

    private bool isSheetPreview => previewItem is not null && IsSheetPreviewable(previewItem.Name);

    private async Task Preview(SynoItemDto it)
    {
        previewItem = it;
        previewError = null;
        previewUrl = null;
        previewMime = GetMimeType(it.Name);
        previewLoading = true;
        previewSheetBytes = null;
        showPreview = true;
        StateHasChanged();
        if (IsSheetPreviewable(it.Name))
        {
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
                previewSheetBytes = await res2.Content.ReadAsByteArrayAsync();
                previewLoading = false;
                StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons");
                return;
            }
            catch { previewError = "Preview failed."; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        if (GetFileExt(it.Name) == ".xls")
        {
            // Legacy binary Excel - rendered client-side by SheetJS (ipop.renderOffice).
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
                var bytes2 = await res2.Content.ReadAsByteArrayAsync();
                var b642 = Convert.ToBase64String(bytes2);
                previewLoading = false;
                StateHasChanged();
                await Task.Delay(50);
                var ok = await JS.InvokeAsync<bool>("ipop.renderOffice", b642, "xls");
                if (!ok) previewError = "Preview not available - use Download.";
                await JS.InvokeVoidAsync("ipop.icons");
                return;
            }
            catch { previewError = "Preview failed."; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        if (IsOfficePreviewable(it.Name))
        {
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/preview?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode) { previewError = "Preview not available - use Download."; return; }
                var bytes2 = await res2.Content.ReadAsByteArrayAsync();
                previewUrl = await JS.InvokeAsync<string>("ipop.preview", Convert.ToBase64String(bytes2), "application/pdf", it.Name);
                previewMime = "application/pdf";
            }
            catch { previewError = "Preview failed."; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
            if (!res.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var b64 = Convert.ToBase64String(bytes);
            previewUrl = await JS.InvokeAsync<string>("ipop.preview", b64, previewMime, it.Name);
        }
        catch { previewError = "Preview failed."; }
        finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
    }
    private string BuildExplorerUrl(SynoItemDto it) => $"ipop://open?server={Uri.EscapeDataString(server)}&path={Uri.EscapeDataString(it.Path)}";
    private async Task OpenInExplorer()
    {
        if (previewItem is null) return;
        var url = BuildExplorerUrl(previewItem);
        await JS.InvokeVoidAsync("ipop.openExplorer", url);
        await JS.InvokeVoidAsync("ipop.icons");
    }
    private async Task OpenInExplorerFor(SynoItemDto it)
    {
        previewItem = it;
        await OpenInExplorer();
    }

    private async Task ClosePreview()
    {
        showPreview = false;
        previewItem = null;
        var url = previewUrl;
        previewUrl = null;
        previewMime = null;
        previewError = null;
        previewSheetBytes = null;
        StateHasChanged();
        if (url is not null) await JS.InvokeVoidAsync("ipop.revokePreview");
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task PrintPreview()
    {
        if (previewUrl is null) return;
        await JS.InvokeVoidAsync("ipop.printUrl", previewUrl);
    }

    private async Task Download(SynoItemDto it)
    {
        var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
        if (!res.IsSuccessStatusCode) { loadError = "Download failed."; return; }
        var bytes = await res.Content.ReadAsByteArrayAsync();
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("ipop.download", b64, it.Name);
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        loadError = null;
        using var form = new MultipartFormDataContent();
        form.Add(new StringContent(server), "server");
        form.Add(new StringContent(currentPath), "path");
        await using var s = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
        form.Add(new StreamContent(s), "file", file.Name);
        var res = await Auth.SendMultipartAsync("/api/files/upload", form);
        if (!res.IsSuccessStatusCode)
            loadError = res.StatusCode == System.Net.HttpStatusCode.Unauthorized ? "Sign in again." : "Upload failed.";
        await Reload();
    }

    private async Task SaveCredential()
    {
        credError = null;
        var res = await Auth.SendAsync(HttpMethod.Put, "/api/files/credential", new { server = credServer, username = credUser, password = credPass });
        if (!res.IsSuccessStatusCode) { credError = "Synology rejected the credentials."; StateHasChanged(); return; }
        showCred = false; credUser = ""; credPass = "";
        server = credServer;
        await Reload();
    }

    private async Task ClearCredential()
    {
        await Auth.SendAsync(HttpMethod.Delete, $"/api/files/credential?server={credServer}", null);
        showCred = false; await Reload();
    }

    private static string FormatSize(long b) => b < 1024 ? $"{b} B" : b < 1024 * 1024 ? $"{b / 1024:N0} KB" : $"{b / 1024 / 1024:N0} MB";
    private static string FormatMtime(long mtime) => mtime == 0 ? "—" : DateTimeOffset.FromUnixTimeSeconds(mtime).ToLocalTime().ToString("MMM dd");
    private static string GetFileExt(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant();
    private static bool IsPreviewable(string name) => GetFileExt(name) is ".pdf" or ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" or ".xlsx" or ".xls" or ".csv" or ".docx" or ".doc" or ".pptx" or ".ppt";
    private static bool IsOfficePreviewable(string name) => GetFileExt(name) is ".xlsx" or ".xls" or ".csv" or ".docx" or ".doc" or ".pptx" or ".ppt";
    // Sheets renderable by RadzenSpreadsheet (XLSX/CSV). Legacy .xls stays on the SheetJS path.
    private static bool IsSheetPreviewable(string name) => GetFileExt(name) is ".xlsx" or ".csv";
    private static string GetFileIcon(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "table",
        ".doc" or ".docx" => "file-text",
        ".ppt" or ".pptx" => "presentation",
        ".pdf" => "file-text",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "image",
        ".zip" or ".rar" or ".7z" or ".tar" or ".gz" => "archive",
        ".mp4" or ".mov" or ".avi" or ".mkv" => "video",
        ".mp3" or ".wav" or ".ogg" => "music",
        _ => "file"
    };
    private static string GetFileIconBg(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "#e8f5e9",
        ".doc" or ".docx" => "#e3f2fd",
        ".ppt" or ".pptx" => "#fff3e0",
        ".pdf" => "#f9ece7",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#f3e8ff",
        ".zip" or ".rar" or ".7z" => "#eceff1",
        _ => "var(--surface)"
    };
    private static string GetFileIconColor(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "#1b7a3d",
        ".doc" or ".docx" => "#1a56c4",
        ".ppt" or ".pptx" => "#c2410c",
        ".pdf" => "#b3462f",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#7c3aed",
        ".zip" or ".rar" or ".7z" => "#546e7a",
        _ => "var(--ink-3)"
    };
    private static string GetFileTagBg(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "#e8f5e9",
        ".doc" or ".docx" => "#e3f2fd",
        ".ppt" or ".pptx" => "#fff3e0",
        ".pdf" => "var(--danger-soft)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#f3e8ff",
        _ => "var(--tray)"
    };
    private static string GetFileTagColor(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "#1b7a3d",
        ".doc" or ".docx" => "#1a56c4",
        ".ppt" or ".pptx" => "#c2410c",
        ".pdf" => "var(--danger)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#7c3aed",
        _ => "var(--ink-2)"
    };
    private static string GetFileExtLabel(string name)
    {
        var ext = GetFileExt(name);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant();
    }
    private static string GetMimeType(string name) => GetFileExt(name) switch
    {
        ".pdf" => "application/pdf",
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".bmp" => "image/bmp",
        ".svg" => "image/svg+xml",
        _ => "application/octet-stream"
    };
    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("ipop.revokePreview");
    }
    private record CredentialStatusDto(bool HasCredential, bool IsInvalid, string? Username, string? Server);
    private record SynoItemDto(string Name, string Path, bool IsDir, long Size, long Mtime);
}
