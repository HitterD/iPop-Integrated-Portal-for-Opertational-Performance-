@page "/files"
@implements IDisposable
@using IPop.Web.Services
@using IPop.Application.Files
@using System.Net.Http.Json
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject FileState FileStateService

<PageTitle>Files - IPop</PageTitle>

<div class="content files-page">
    <div class="admin-tabs files-servers">
        @foreach (var s in Servers)
        {
            <button class="admin-tab @(server == s.Id ? "active" : "")" @onclick="() => SwitchServer(s.Id)">
                <i data-lucide="hard-drive"></i> @s.Label <span class="mono" style="font-size:10px; opacity:0.6; margin-left:4px">@s.Host</span>
            </button>
        }
    </div>
    <div class="tray rise rise-1"><div class="core" style="padding:0; overflow:hidden">
        <div class="panel-head files-panel-head">
            <i data-lucide="folder"></i> <span>Files</span>
            <span class="meta">@serverLabel · @(shares?.Count ?? 0) shares</span>
            <span class="meta"><span class="live-dot"></span> Live</span>
            @if (!needsCredential && credential?.Username is not null)
            {
                <span class="files-account" title="Synology account for @serverLabel - same permissions as File Explorer">
                    <i data-lucide="user-round" style="width:13px;height:13px"></i> as <strong>@credential.Username</strong>
                </span>
            }
            <button class="btn btn-sm surface" style="margin-left:auto" @onclick="() => showCred = true">
                <i data-lucide="plug-zap" style="width:14px;height:14px"></i> @(needsCredential ? "Connect" : "Manage")
            </button>
        </div>
        @if (!needsCredential && credential?.Username is not null)
        {
            <div class="files-identity" role="status">
                <span class="files-identity-dot"></span>
                <span>Browsing <strong>@serverLabel</strong> as <strong>@credential.Username</strong> - same ACLs as File Explorer for that account.</span>
                <button class="files-identity-action" @onclick="() => showCred = true">Switch account</button>
            </div>
        }

        <div class="filter-bar">
            <div class="search"><i data-lucide="search"></i><input placeholder="Search name…" @bind="search" @bind:event="oninput" /></div>
            <AppSelect Label="Type filter" Value="@typeFilter" ValueChanged="v => { typeFilter = v; StateHasChanged(); }"
                       Options="@TypeOptions" />
            <AppSelect Label="Sort" Value="@sortBy" ValueChanged="v => { sortBy = v; StateHasChanged(); }"
                       Options="@SortOptions" />
            @if (!string.IsNullOrEmpty(typeFilter) || !string.IsNullOrWhiteSpace(search))
            {
                <button class="btn btn-sm surface" @onclick="ClearFilters"><i data-lucide="x" style="width:12px;height:12px"></i> Clear</button>
            }
            <button type="button" class="btn btn-sm surface" @onclick="OpenNewFolderModal">
                <i data-lucide="folder-plus" style="width:14px;height:14px"></i> New folder
            </button>
            <label class="btn btn-sm accent">
                <i data-lucide="upload" style="width:14px;height:14px"></i> Upload
                <InputFile OnChange="OnUpload" multiple style="display:none" />
            </label>
        </div>

        @if (selectedPaths.Count > 0)
        {
            <div style="display:flex; align-items:center; gap:8px; padding:8px 16px; background:var(--accent-soft); border-bottom:1px solid var(--line-soft)">
                <span style="font-weight:600; font-size:12.5px; color:var(--accent-ink)">@selectedPaths.Count selected</span>
                <div style="flex:1"></div>
                @if (isRecycleBin)
                {
                    <button type="button" class="btn btn-sm surface" @onclick="RestoreSelected"><i data-lucide="undo-2" style="width:13px;height:13px"></i> Restore</button>
                    <button type="button" class="btn btn-sm surface" style="color:var(--danger)" @onclick="DeleteSelectedPermanently"><i data-lucide="trash-2" style="width:13px;height:13px"></i> Delete forever</button>
                }
                else
                {
                    <button type="button" class="btn btn-sm surface" @onclick="DownloadSelectedZip"><i data-lucide="download" style="width:13px;height:13px"></i> Download ZIP</button>
                    <button type="button" class="btn btn-sm surface" @onclick="OpenMoveCopySelected"><i data-lucide="folder-input" style="width:13px;height:13px"></i> Move / Copy</button>
                    <button type="button" class="btn btn-sm surface" style="color:var(--danger)" @onclick="DeleteSelected"><i data-lucide="trash-2" style="width:13px;height:13px"></i> Move to Bin</button>
                }
                <button type="button" class="btn btn-sm surface" @onclick="() => selectedPaths.Clear()"><i data-lucide="x" style="width:13px;height:13px"></i> Clear</button>
            </div>
        }

        @if (needsCredential)
        {
            <div class="files-connect-hero"><i data-lucide="hard-drive"></i><h2>Connect to @serverLabel</h2><p>Browse your shares, preview documents and manage files using your Synology permissions.</p><button class="btn btn-sm" @onclick="() => showCred = true">Connect account</button></div>
        }
        else if (loadError is not null)
        {
            <div class="tree-empty" style="padding:28px"><p>@loadError</p><button class="btn btn-sm" style="margin:12px auto 0" @onclick="() => Reload()">Retry</button></div>
        }
        else
        {
            <div class="files-shell">
                <aside class="files-shares">
                    <div class="files-shares-title">Shares · @serverLabel</div>
                    @if (loading && shares is null)
                    {
                        <div class="tree-empty">Loading…</div>
                    }
                    else if (shares is not null)
                    {
                        @foreach (var sh in shares)
                        {
                            var active = currentPath.StartsWith(sh);
                            <button class="share-btn @(active ? "active" : "")" @onclick="() => Enter(sh)">
                                <i data-lucide="@(sh.Contains("homes") ? "home" : sh.Contains("team") ? "users" : "building-2")"></i>
                                <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@sh</span>
                                <i data-lucide="chevron-right" class="chev"></i>
                            </button>
                        }
                    }
                    <div style="border-top:1px solid var(--line-soft); margin:8px 0; padding-top:8px">
                        <button class="share-btn @(isRecycleBin ? "active" : "")" @onclick="EnterRecycleBin">
                            <i data-lucide="trash-2"></i>
                            <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap">Recycle Bin</span>
                            <i data-lucide="chevron-right" class="chev"></i>
                        </button>
                    </div>
                    <div class="note"><i data-lucide="shield-check"></i><span>Same ACLs as File Explorer.</span></div>
                    @if (storageInfo is not null)
                    {
                        <div style="margin-top:auto; padding:12px; background:var(--tray); border-radius:12px; font-size:12px">
                            <div style="display:flex; justify-content:space-between; margin-bottom:4px; font-weight:600">
                                <span>@serverLabel Storage</span>
                                <span style="color:var(--ink-3)">@(storageInfo.TotalBytes > 0 ? (storageInfo.UsedBytes * 100 / storageInfo.TotalBytes) : 0)%</span>
                            </div>
                            <div style="height:6px; background:var(--line); border-radius:3px; overflow:hidden; margin-bottom:6px">
                                <div style="height:100%; width:@(storageInfo.TotalBytes > 0 ? (storageInfo.UsedBytes * 100 / storageInfo.TotalBytes) : 0)%; background:var(--accent); border-radius:3px"></div>
                            </div>
                            <div style="color:var(--ink-3); font-size:11px">
                                @FormatSize(storageInfo.UsedBytes) of @FormatSize(storageInfo.TotalBytes) used
                            </div>
                        </div>
                    }
                </aside>

                <div class="files-browser">
                    <div class="files-crumb-bar">
                        <div class="files-nav">
                            <button class="files-nav-btn @(backStack.Count == 0 ? "dis" : "")" title="Back" @onclick="GoBack" disabled="@(backStack.Count == 0)">
                                <i data-lucide="arrow-left"></i>
                            </button>
                            <button class="files-nav-btn @(forwardStack.Count == 0 ? "dis" : "")" title="Forward" @onclick="GoForward" disabled="@(forwardStack.Count == 0)">
                                <i data-lucide="arrow-right"></i>
                            </button>
                            <button class="files-nav-btn @(currentPath == "/" ? "dis" : "")" title="Up" @onclick="GoUp" disabled="@(currentPath == "/")">
                                <i data-lucide="arrow-up"></i>
                            </button>
                        </div>
                        <div class="files-crumb-trail">
                            <button class="files-crumb-seg @(currentPath == "/" ? "active" : "")" @onclick='() => Navigate("/")' title="Root">
                                <i data-lucide="hard-drive" style="width:12px;height:12px"></i> @serverLabel
                            </button>
                            @foreach (var seg in GetBreadcrumbs())
                            {
                                <i data-lucide="chevron-right" class="files-crumb-sep"></i>
                                @if (seg.IsLast)
                                {
                                    <span class="files-crumb-seg active" title="@seg.Path">@seg.Name</span>
                                }
                                else
                                {
                                    <button class="files-crumb-seg" title="@seg.Path" @onclick="() => Navigate(seg.Path)">@seg.Name</button>
                                }
                            }
                        </div>
                        <div class="files-crumb-actions">
                            @if (isRevalidating)
                            {
                                <span class="files-revalidating"><span class="spinner"></span> Syncing…</span>
                            }
                            @if (isRecycleBin)
                            {
                                <button class="files-tool-btn" style="color:var(--danger)" title="Empty Recycle Bin" @onclick="EmptyRecycleBin">
                                    <i data-lucide="trash-2"></i> <span>Empty Bin</span>
                                </button>
                            }
                            <button class="files-tool-btn @(copiedPath ? "copied" : "")" title="Copy current path to clipboard" @onclick="CopyCurrentPath">
                                <i data-lucide="@(copiedPath ? "check" : "copy")"></i> <span>@(copiedPath ? "Copied" : "Copy path")</span>
                            </button>
                            <button class="files-tool-btn" title="@(gridView ? "List view" : "Grid view")" aria-label="@(gridView ? "List view" : "Grid view")" @onclick="() => gridView = !gridView"><i data-lucide="@(gridView ? "list" : "layout-grid")"></i></button>
                            <button class="files-tool-btn" title="Force refresh from Synology NAS" @onclick="ForceRefresh">
                                <i data-lucide="refresh-cw"></i> <span>Refresh</span>
                            </button>
                            <span class="meta" style="font-size:11px; color:var(--ink-3); margin-left:4px">@filteredItems.Count items</span>
                        </div>
                    </div>

                    @if (!gridView)
                    {
                    <div class="files-head" style="grid-template-columns: 32px 1fr 100px 130px 140px">
                        <input type="checkbox" checked="@(filteredItems.Count > 0 && selectedPaths.Count == filteredItems.Count)" @onchange="ToggleSelectAll" />
                        <button @onclick='() => ToggleSort("name")'>Name <i data-lucide="@(sortBy.StartsWith("name") ? (sortBy == "name" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <button @onclick='() => ToggleSort("size")'>Size <i data-lucide="@(sortBy.StartsWith("size") ? (sortBy == "size" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <button @onclick='() => ToggleSort("modified")'>Modified <i data-lucide="@(sortBy.StartsWith("modified") ? (sortBy == "modified" ? "arrow-up" : "arrow-down") : "arrow-up-down")"></i></button>
                        <span style="text-align:right">Action</span>
                    </div>
                    }

                    <div class="files-list @(gridView ? "files-grid" : "")">
                        @if (loading)
                        {
                            <div class="tree-empty" style="padding:24px">Loading…</div>
                        }
                        else if (filteredItems.Count == 0)
                        {
                            @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrEmpty(typeFilter))
                            {
                                <div class="files-empty-box">
                                    <div class="empty-icon"><i data-lucide="search-x"></i></div>
                                    <div class="empty-title">No matching files</div>
                                    <div class="empty-desc">No items match the current filter or search query.</div>
                                    <button class="btn btn-sm surface" style="margin-top:6px" @onclick="ClearFilters">Clear filters</button>
                                </div>
                            }
                            else
                            {
                                <div class="files-empty-box">
                                    <div class="empty-icon"><i data-lucide="folder-open"></i></div>
                                    <div class="empty-title">This folder is empty</div>
                                    <div class="empty-desc">No files or subfolders in this directory.</div>
                                </div>
                            }
                        }
                        else
                        {
                            @foreach (var it in filteredItems)
                            {
                                <div class="file-row @(infoItem?.Path == it.Path ? "is-active" : "")" style="@(gridView ? "" : "grid-template-columns: 32px 1fr 100px 130px 140px")">
                                    <input type="checkbox" checked="@selectedPaths.Contains(it.Path)" @onchange="() => ToggleSelect(it.Path)" @onclick:stopPropagation />
                                    <span class="fname" @onclick="() => OnItemClick(it)" title="@(it.IsDir ? "Open folder" : IsPreviewable(it.Name) ? "Click to preview" : "Download")">
                                        @if (it.IsDir)
                                        {
                                            <span class="fi" style="background:var(--accent-soft); color:var(--accent-ink)"><i data-lucide="folder"></i></span>
                                            <span class="n">@it.Name</span> <span class="tag">dir</span>
                                        }
                                        else
                                        {
                                            <span class="fi" style="background:@GetFileIconBg(it.Name); color:@GetFileIconColor(it.Name)"><i data-lucide="@GetFileIcon(it.Name)"></i></span>
                                            <span class="n">@it.Name</span> <span class="tag" style="background:@GetFileTagBg(it.Name); color:@GetFileTagColor(it.Name)">@GetFileExtLabel(it.Name)</span>
                                            @if (IsCoAuthorable(it.Name)) { <span class="tag" style="background:#e8f5e9; color:#1b7a3d; border:1px solid rgba(27,122,61,0.2)"><i data-lucide="users" style="width:10px;height:10px; display:inline; vertical-align:middle; margin-right:3px"></i>Co-author</span> }
                                        }
                                    </span>
                                    <span class="fmeta mono">@(it.IsDir ? "—" : FormatSize(it.Size))</span>
                                    <span class="fmeta">@FormatMtime(it.Mtime)</span>
                                    <span class="factions">
                                        <button class="org-act" title="File info" aria-label="File info" @onclick="() => ShowInfo(it)" @onclick:stopPropagation><i data-lucide="info"></i></button>
                                        @if (it.IsDir)
                                        {
                                            <button class="org-act" title="Rename" @onclick="() => OpenRenameModal(it)" @onclick:stopPropagation><i data-lucide="edit-3"></i></button>
                                            <button class="org-act" title="Move / Copy" @onclick="() => OpenMoveCopyModal(it)" @onclick:stopPropagation><i data-lucide="folder-input"></i></button>
                                            <button class="org-act" title="Delete" style="color:var(--danger)" @onclick="() => DeleteSingle(it)" @onclick:stopPropagation><i data-lucide="trash-2"></i></button>
                                            <i data-lucide="chevron-right" style="width:14px;height:14px;color:var(--ink-3)"></i>
                                        }
                                        else
                                        {
                                            @if (IsCoAuthorable(it.Name))
                                            {
                                                <a href="@GetEditorUrl(it)" target="_blank" class="file-action-btn edit-collab" title="Co-author real-time in new tab (ONLYOFFICE)" @onclick:stopPropagation="true">
                                                    <i data-lucide="users"></i>
                                                    <span>Co-author</span>
                                                </a>
                                            }
                                            @if (IsPreviewable(it.Name))
                                            {
                                                <button class="file-action-btn preview-btn" title="Quick document preview" @onclick="() => Preview(it)">
                                                    <i data-lucide="eye"></i>
                                                    <span>Preview</span>
                                                </button>
                                            }
                                            <button class="org-act" title="Open in Explorer" @onclick="() => OpenInExplorerFor(it)"><i data-lucide="folder-open"></i></button>
                                            <button class="org-act" title="Download" @onclick="() => Download(it)"><i data-lucide="download"></i></button>
                                            @if (!isRecycleBin)
                                            {
                                                <button class="org-act" title="Rename" @onclick="() => OpenRenameModal(it)" @onclick:stopPropagation><i data-lucide="edit-3"></i></button>
                                                <button class="org-act" title="Move / Copy" @onclick="() => OpenMoveCopyModal(it)" @onclick:stopPropagation><i data-lucide="folder-input"></i></button>
                                                <button class="org-act" title="Share link" @onclick="() => OpenShareModal(it)" @onclick:stopPropagation><i data-lucide="link"></i></button>
                                                <button class="org-act" title="Move to Bin" style="color:var(--danger)" @onclick="() => DeleteSingle(it)" @onclick:stopPropagation><i data-lucide="trash-2"></i></button>
                                            }
                                            else
                                            {
                                                <button class="org-act" title="Restore" @onclick="() => RestoreSingle(it)" @onclick:stopPropagation><i data-lucide="undo-2"></i></button>
                                                <button class="org-act" title="Delete permanently" style="color:var(--danger)" @onclick="() => DeleteSinglePermanently(it)" @onclick:stopPropagation><i data-lucide="trash-2"></i></button>
                                            }
                                        }
                                    </span>
                                </div>
                            }
                        }
                    </div>

                    <div class="files-foot">
                        <span class="dot"></span> Live pass-through - no index
                        <span style="margin-left:auto; display:flex; gap:6px; align-items:center"><i data-lucide="eye" style="width:12px;height:12px"></i> Click eye to preview PDF / image, then Print</span>
                    </div>
                </div>
                @if (infoItem is { } info)
                {
                    <aside class="files-info-pane">
                        <div class="files-info-head"><strong>File info</strong><button class="org-act" title="Close info" @onclick="() => infoItem = null"><i data-lucide="x"></i></button></div>
                        <div class="files-info-icon"><i data-lucide="@(info.IsDir ? "folder" : GetFileIcon(info.Name))"></i></div>
                        <h3>@info.Name</h3>
                        <dl><dt>Type</dt><dd>@(info.IsDir ? "Folder" : GetFileExtLabel(info.Name))</dd><dt>Size</dt><dd>@(info.IsDir ? "—" : FormatSize(info.Size))</dd><dt>Modified</dt><dd>@FormatMtime(info.Mtime)</dd><dt>Path</dt><dd class="files-info-path">@info.Path</dd></dl>
                        <div class="files-info-actions">
                            @if (!info.IsDir) { <button class="btn btn-sm surface" @onclick="() => Download(info)">Download</button> }
                            @if (!isRecycleBin) { <button class="btn btn-sm surface" @onclick="() => OpenShareModal(info)">Share link</button> }
                        </div>
                    </aside>
                }
            </div>
        }
    </div></div>
</div>

@if (showCred)
{
    <div class="backdrop on" @onclick="() => showCred = false"></div>
    <div class="drawer on" role="dialog" aria-label="Connect Synology">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">Connect @serverLabel <button class="drawer-close" @onclick="() => showCred = false"><i data-lucide="x"></i></button></div>
            <div class="drawer-body" style="flex:1; overflow:auto">
                @if (credential?.IsInvalid == true)
                { <div class="note err"><i data-lucide="alert-triangle"></i><span>Stored credential was rejected - please re-enter it.</span></div> }
                <div class="field" style="margin-top:12px"><label>Server</label><div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:6px">
                    @foreach (var s in Servers)
                    { <button class="admin-tab @(credServer == s.Id ? "active" : "")" @onclick="() => credServer = s.Id" style="padding:6px 12px; font-size:12px">@s.Label</button> }
                </div></div>
                <div class="field"><label>Synology username</label><input placeholder="alice" @bind="credUser" /></div>
                <div class="field"><label>Password</label><input type="password" placeholder="••••••••" @bind="credPass" /></div>
                <div class="note"><i data-lucide="shield"></i><span>Validated live before storage. Wrong credentials never get saved. Sealed with Data Protection, key in Postgres.</span></div>
                @if (credError is not null) { <div class="note err"><i data-lucide="alert-circle"></i><span>@credError</span></div> }
            </div>
            <div style="padding:14px 18px; border-top:1px solid var(--line-soft); display:flex; gap:8px; background:var(--bg)">
                <button class="btn" style="flex:1; margin:0" @onclick="SaveCredential">Save &amp; connect <span class="orb"><i data-lucide="arrow-right"></i></span></button>
                <button class="btn" style="width:auto; margin:0; background:var(--surface); color:var(--ink); border:1px solid var(--line)" @onclick="ClearCredential">Clear</button>
            </div>
        </div></div>
    </div>
}

@if (showPreview)
{
    <div class="backdrop on" @onclick="ClosePreview"></div>
    <div class="drawer on" role="dialog" aria-label="Preview" style="width:min(1200px, 92vw)">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                <span style="display:flex; gap:8px; align-items:center; min-width:0"><i data-lucide="eye"></i> <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@previewItem?.Name</span> @if (previewMime is not null) { <span class="tag">@previewMime</span> }</span>
                <span style="display:flex; gap:6px; align-items:center">
                    @if (previewItem is not null && IsCoAuthorable(previewItem.Name))
                    { <a href="@GetEditorUrl(previewItem)" target="_blank" class="file-action-btn edit-collab" style="padding:4px 12px; font-size:12px; box-shadow:0 1px 2px rgba(27,122,61,0.12)" title="Co-author real-time in new tab"><i data-lucide="users" style="width:13px;height:13px;margin-right:5px"></i> Co-author</a> }
                    <button class="org-act" title="Open in File Explorer" @onclick="OpenInExplorer"><i data-lucide="folder-open"></i></button>
                    <button class="org-act" title="Print" @onclick="PrintPreview"><i data-lucide="printer"></i></button>
                    <button class="org-act" title="Download" @onclick="() => Download(previewItem!)"><i data-lucide="download"></i></button>
                    <button class="drawer-close" @onclick="ClosePreview"><i data-lucide="x"></i></button>
                </span>
            </div>
            <div style="flex:1; overflow:auto; padding:14px; background:var(--bg); display:grid; place-items:center">
                @if (previewLoading)
                { <div class="tree-empty">Loading preview…</div> }
                else if (previewError is not null)
                {
                    <div style="display:flex; flex-direction:column; align-items:center; gap:12px; max-width:440px; text-align:center">
                        <div class="note err"><i data-lucide="alert-circle"></i><span>@previewError</span></div>
                        @if (previewItem is not null)
                        {
                            <button class="btn" style="width:auto; margin:0; font-size:13px" @onclick="() => Download(previewItem)"><i data-lucide="download" style="margin-right:6px"></i> Download @previewItem.Name</button>
                        }
                    </div>
                }
                else if (isSheetPreview && previewSheetBytes is not null)
                {
                    <ExcelViewer FileName="@previewItem?.Name" Bytes="@previewSheetBytes" />
                }
                else if (previewItem is not null && GetFileExt(previewItem.Name) == ".xls")
                {
                    <div id="office-preview" style="width:100%"></div>
                }
                else if (previewUrl is not null && previewMime is not null)
                {
                    @if (previewMime.StartsWith("image/"))
                    { <img src="@previewUrl" alt="@previewItem?.Name" style="max-width:100%; max-height:calc(100dvh - 180px); object-fit:contain; border-radius:12px; border:1px solid var(--line-soft); background:var(--surface)" /> }
                    else if (previewMime == "application/pdf")
                    { <iframe id="preview-frame" src="@previewUrl" style="width:100%; height:calc(100dvh - 180px); border:1px solid var(--line-soft); border-radius:12px; background:var(--surface)"></iframe> }
                    else
                    { <div class="note"><i data-lucide="file-text"></i><span>Preview not available - use Download.</span></div> }
                }
            </div>
            <div style="padding:12px 14px; border-top:1px solid var(--line-soft); display:flex; gap:8px; background:var(--surface)">
