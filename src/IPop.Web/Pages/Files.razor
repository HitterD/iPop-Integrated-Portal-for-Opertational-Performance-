        if (!ok) return;

        var res = await Auth.SendAsync(HttpMethod.Post, "/api/files/recycle/empty", new { server });
        if (res.IsSuccessStatusCode)
        {
            Toasts.ShowDetailed("Emptied", "Recycle Bin emptied successfully.", ToastKind.Success, "trash-2");
            await Reload();
        }
