    private async Task DownloadSelectedZip()
    {
        if (selectedPaths.Count == 0) return;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/files/bulk-download", new { server, paths = selectedPaths.ToArray() });
            if (res.IsSuccessStatusCode)
            {
                var bytes = await res.Content.ReadAsByteArrayAsync();
                var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
                await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"files_{server}_{stamp}.zip");
                Toasts.ShowDetailed("Download Ready", "ZIP archive downloaded.", ToastKind.Success, "download");
            }
        }
        catch { }
    }

    private record ServerInfo(string Id, string Label, string Host);
    private static readonly ServerInfo[] Servers = [
        new("spj", "SPJ", "192.168.2.16"),
        new("krw", "KRW", "10.12.2.6"),
        new("jtb", "JTB", "10.11.2.6"),
        new("smg", "SMG", "10.14.2.16"),
    ];
    private string serverLabel => Servers.FirstOrDefault(s => s.Id == server)?.Label ?? server.ToUpperInvariant();
    private List<SynoItemDto> filteredItems
    {
        get
        {
            IEnumerable<SynoItemDto> q = items;
            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(i => i.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrEmpty(typeFilter))
                q = q.Where(i => MatchesType(i.Name, typeFilter));
            q = sortBy switch
            {
                "name" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase),
                "name-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Name, StringComparer.OrdinalIgnoreCase),
                "modified" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Mtime),
                "modified-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Mtime),
                "size" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Size),
                "size-desc" => q.OrderBy(i => i.IsDir ? 0 : 1).ThenByDescending(i => i.Size),
                _ => q.OrderBy(i => i.IsDir ? 0 : 1).ThenBy(i => i.Name, StringComparer.OrdinalIgnoreCase),
            };
            return q.ToList();
        }
    }
    private static bool MatchesType(string name, string filter)
    {
        var ext = GetFileExt(name);
        return filter switch
        {
            "pdf" => ext == ".pdf",
            "image" => ext is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg",
            "sheet" => ext is ".xls" or ".xlsx" or ".csv",
            "word" => ext is ".doc" or ".docx",
            "slide" => ext is ".ppt" or ".pptx",
            "archive" => ext is ".zip" or ".rar" or ".7z" or ".tar" or ".gz",
            "other" => ext == "" || ext == ".txt" || ext == ".log" || ext == ".json",
            _ => true
        };
    }
    private void ToggleSort(string key)
    {
        if (sortBy == key) sortBy = key + "-desc";
        else if (sortBy == key + "-desc") sortBy = key;
        else sortBy = key;
        StateHasChanged();
    }
    private void ClearFilters()
    {
        search = ""; typeFilter = ""; sortBy = "name";
        StateHasChanged();
    }

    private bool isRevalidating;
    private bool copiedPath;

    private record BreadcrumbSegment(string Name, string Path, bool IsLast);

    private List<BreadcrumbSegment> GetBreadcrumbs()
    {
        var list = new List<BreadcrumbSegment>();
        if (string.IsNullOrEmpty(currentPath) || currentPath == "/") return list;

        var parts = currentPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var acc = "";
        for (int i = 0; i < parts.Length; i++)
        {
            acc += "/" + parts[i];
            list.Add(new BreadcrumbSegment(parts[i], acc, i == parts.Length - 1));
        }
        return list;
    }

    private async Task CopyCurrentPath()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", currentPath);
            copiedPath = true;
            StateHasChanged();
            await Task.Delay(1800);
            copiedPath = false;
            StateHasChanged();
        }
        catch
        {
            // fallback: no clipboard permission
        }
    }

    private async Task ForceRefresh()
    {
        FileStateService.Invalidate(server, currentPath);
        await Reload(bypassCache: true);
    }

    protected override void OnInitialized()
    {
        Layout.SetHeader("Files", "Files");
        // Pulihkan state server dan path dari in-memory state seketika (0ms)
        server = FileStateService.CurrentServer;
        credServer = server;
        currentPath = FileStateService.CurrentPath;

        backStack.Clear();
        backStack.AddRange(FileStateService.BackStack);
        forwardStack.Clear();
        forwardStack.AddRange(FileStateService.ForwardStack);

        // Pulihkan shares dari cache jika tersedia
        if (FileStateService.TryGetCachedShares(server, out var sCached))
        {
            shares = sCached;
        }

        if (currentPath == "/")
        {
            if (shares is not null) loading = false;
        }
        else
        {
            if (FileStateService.TryGetCachedItems(server, currentPath, out var iCached))
            {
                items = iCached;
                loading = false;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Pulihkan persistent last-seen dari localStorage (jika browser di-refresh / tab baru)
        var restored = await FileStateService.LoadLastSeenAsync(JS);
        if (restored.HasValue)
        {
            server = FileStateService.CurrentServer;
            credServer = server;
            currentPath = FileStateService.CurrentPath;
            if (FileStateService.TryGetCachedShares(server, out var sCached2))
            {
                shares = sCached2;
            }
            if (currentPath != "/" && FileStateService.TryGetCachedItems(server, currentPath, out var iCached))
            {
                items = iCached;
                loading = false;
                StateHasChanged();
            }
        }

        await Reload();
    }

    private async Task SwitchServer(string id)
    {
        server = id; credServer = id; currentPath = "/"; search = "";
        FileStateService.CurrentServer = id;
        FileStateService.CurrentPath = "/";
        backStack.Clear(); forwardStack.Clear();
        FileStateService.BackStack.Clear(); FileStateService.ForwardStack.Clear();
        _ = FileStateService.SaveLastSeenAsync(JS);
        await Reload();
    }

    private async Task Reload(bool bypassCache = false)
    {
        // ipop-42: navigation paths fire-and-forget Reload after mutating currentPath.
        // Capture at start and compare after EVERY await — a superseded continuation
        // must write nothing, or the listing can show folder A while currentPath is B
        // (and OnUpload then posts files into B while the user is looking at A).
        var pathAtStart = currentPath;
        var serverAtStart = server;
        loadError = null;

        bool hasCachedData = false;
        // Selalu pastikan shares di-resolve dari cache terlebih dahulu
        if (shares is null && FileStateService.TryGetCachedShares(server, out var shCache))
        {
            shares = shCache;
        }

        if (!bypassCache)
        {
            if (currentPath == "/")
            {
                if (shares is not null)
                {
                    hasCachedData = true;
                }
            }
            else
            {
                if (FileStateService.TryGetCachedItems(server, currentPath, out var iCached))
                {
                    items = iCached;
                    hasCachedData = true;
                }
            }
        }

        if (hasCachedData)
        {
            loading = false;
            isRevalidating = true;
            StateHasChanged();
        }
        else
        {
            loading = true;
            if (currentPath != "/") items = [];
        }

        try
        {
            var cred = await Auth.GetAsync<CredentialStatusDto>($"/api/files/credential?server={server}");
            if (pathAtStart != currentPath || serverAtStart != server) return; // superseded by navigation
            credential = cred;
            if (cred is null || !cred.HasCredential) { needsCredential = true; return; }
            if (cred.IsInvalid) { needsCredential = true; showCred = true; return; }
            needsCredential = false;

            Task<List<string>?>? sharesTask = null;
            if (shares is null)
            {
                sharesTask = Auth.GetAsync<List<string>>($"/api/files/shares?server={server}");
            }

            Task<List<SynoItemDto>?>? itemsTask = null;
            if (isRecycleBin)
            {
                itemsTask = Auth.GetAsync<List<SynoItemDto>>($"/api/files/recycle?server={server}&path={Uri.EscapeDataString(currentPath)}");
            }
            else if (currentPath != "/")
            {
                itemsTask = Auth.GetAsync<List<SynoItemDto>>($"/api/files?server={server}&path={Uri.EscapeDataString(currentPath)}");
            }

            _ = Auth.GetAsync<SynoStorageInfo>($"/api/files/storage?server={server}").ContinueWith(t => {
                if (t.IsCompletedSuccessfully && t.Result is not null) { storageInfo = t.Result; _ = InvokeAsync(StateHasChanged); }
            });

            if (sharesTask is not null)
            {
                var s = await sharesTask;
                if (pathAtStart != currentPath || serverAtStart != server) return;
                if (s is not null)
                {
                    shares = s;
                    FileStateService.SetCachedShares(server, s);
                }
            }

            if (currentPath == "/")
            {
                if (shares is null)
                {
                    if (!hasCachedData) loadError = "Could not reach the NAS.";
                }
                else if (shares.Count > 0)
                {
                    // Auto-open share pertama jika di root "/" agar panel kanan tidak kosong
                    var targetShare = shares.FirstOrDefault(sh => !sh.Contains("backup") && !sh.Contains("git")) ?? shares[0];
                    currentPath = targetShare;
                    FileStateService.CurrentPath = targetShare;
                    _ = FileStateService.SaveLastSeenAsync(JS);
                    _ = Reload();
                    return;
                }
            }
            else if (itemsTask is not null)
            {
                var list = await itemsTask;
                if (pathAtStart != currentPath || serverAtStart != server) return; // superseded
                if (list is null)
                {
                    if (!hasCachedData) loadError = "Could not load folder.";
                }
                else
                {
                    items = list;
                    FileStateService.SetCachedItems(server, currentPath, list);
                }
            }

            FileStateService.CurrentServer = server;
            FileStateService.CurrentPath = currentPath;
            FileStateService.BackStack = backStack.ToList();
            FileStateService.ForwardStack = forwardStack.ToList();
            _ = FileStateService.SaveLastSeenAsync(JS);
        }
        finally
        {
            // ipop-46 + ipop-42: guarantee the spinner clears on a throw, but a SUPERSEDED
            // continuation still writes nothing — the newer Reload owns `loading` now.
            if (pathAtStart == currentPath && serverAtStart == server)
            {
                loading = false;
                isRevalidating = false;
                StateHasChanged();
                await JS.InvokeVoidAsync("ipop.icons");
            }
        }
    }

    // Push the current path onto the back stack before navigating somewhere
    // new; forward gets cleared (a new branch invalidates the forward history).
    private void PushHistory()
    {
        if (backStack.Count == 0 || backStack[^1] != currentPath) backStack.Add(currentPath);
        forwardStack.Clear();
        FileStateService.BackStack = backStack.ToList();
        FileStateService.ForwardStack = forwardStack.ToList();
    }

    private void Enter(string share) { isRecycleBin = false; PushHistory(); currentPath = share; _ = Reload(); }
    private Task OnItemClick(SynoItemDto it)
    {
        if (it.IsDir) { PushHistory(); currentPath = it.Path; return Reload(); }
        if (IsPreviewable(it.Name)) return Preview(it);
        return Download(it);
    }
    private void GoUp() { PushHistory(); var p = currentPath.TrimEnd('/'); var idx = p.LastIndexOf('/'); currentPath = idx <= 0 ? "/" : p[..idx]; _ = Reload(); }
    private async Task Navigate(string path)
    {
        if (path == currentPath) return; // clicking the current crumb is a no-op
        PushHistory(); currentPath = path; await Reload();
    }
    private void GoBack()
    {
        if (backStack.Count == 0) return;
        forwardStack.Add(currentPath);
        currentPath = backStack[^1];
        backStack.RemoveAt(backStack.Count - 1);
        FileStateService.BackStack = backStack.ToList();
        FileStateService.ForwardStack = forwardStack.ToList();
        FileStateService.CurrentPath = currentPath;
        _ = FileStateService.SaveLastSeenAsync(JS);
        _ = Reload();
    }
    private void GoForward()
    {
        if (forwardStack.Count == 0) return;
        backStack.Add(currentPath);
        currentPath = forwardStack[^1];
        forwardStack.RemoveAt(forwardStack.Count - 1);
        FileStateService.BackStack = backStack.ToList();
        FileStateService.ForwardStack = forwardStack.ToList();
        FileStateService.CurrentPath = currentPath;
        _ = FileStateService.SaveLastSeenAsync(JS);
        _ = Reload();
    }

    private bool isSheetPreview => previewItem is not null && IsSheetPreviewable(previewItem.Name);

    private async Task Preview(SynoItemDto it)
    {
        previewItem = it;
        previewError = null;
        previewUrl = null;
        previewMime = GetMimeType(it.Name);
        previewLoading = true;
        previewSheetBytes = null;
        showPreview = true;
        StateHasChanged();
        if (IsSheetPreviewable(it.Name))
        {
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
                previewSheetBytes = await res2.Content.ReadAsByteArrayAsync();
                previewLoading = false;
                StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons");
                return;
            }
            catch { previewError = "Preview failed."; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        if (GetFileExt(it.Name) == ".xls")
        {
            // Legacy binary Excel - rendered client-side by SheetJS (ipop.renderOffice).
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
                var bytes2 = await res2.Content.ReadAsByteArrayAsync();
                var b642 = Convert.ToBase64String(bytes2);
                previewLoading = false;
                StateHasChanged();
                await Task.Delay(50);
                var ok = await JS.InvokeAsync<bool>("ipop.renderOffice", b642, "xls");
                if (!ok) previewError = "Preview not available - use Download.";
                await JS.InvokeVoidAsync("ipop.icons");
                return;
            }
            catch { previewError = "Preview failed."; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        if (IsOfficePreviewable(it.Name))
        {
            try
            {
                var res2 = await Auth.SendAsync(HttpMethod.Get, $"/api/files/preview?server={server}&path={Uri.EscapeDataString(it.Path)}");
                if (!res2.IsSuccessStatusCode)
                {
                    var errText = "Document preview is unavailable.";
                    try
                    {
                        var errJson = await res2.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                        if (errJson.TryGetProperty("message", out var m) && !string.IsNullOrWhiteSpace(m.GetString()))
                            errText = m.GetString()!;
                    }
                    catch { }
                    previewError = errText;
                    return;
                }
                var bytes2 = await res2.Content.ReadAsByteArrayAsync();
                previewUrl = await JS.InvokeAsync<string>("ipop.preview", Convert.ToBase64String(bytes2), "application/pdf", it.Name);
                previewMime = "application/pdf";
            }
            catch (Exception ex) { previewError = $"Failed to load preview: {ex.Message}"; }
            finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
            return;
        }
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
            if (!res.IsSuccessStatusCode) { previewError = "Could not load preview."; return; }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var b64 = Convert.ToBase64String(bytes);
            previewUrl = await JS.InvokeAsync<string>("ipop.preview", b64, previewMime, it.Name);
        }
        catch { previewError = "Preview failed."; }
        finally { previewLoading = false; StateHasChanged(); await JS.InvokeVoidAsync("ipop.icons"); }
    }
    private string BuildExplorerUrl(SynoItemDto it) => $"ipop://open?server={Uri.EscapeDataString(server)}&path={Uri.EscapeDataString(it.Path)}";
    private async Task OpenInExplorer()
    {
        if (previewItem is null) return;
        var url = BuildExplorerUrl(previewItem);
        await JS.InvokeVoidAsync("ipop.openExplorer", url);
        await JS.InvokeVoidAsync("ipop.icons");
    }
    private async Task OpenInExplorerFor(SynoItemDto it)
    {
        previewItem = it;
        await OpenInExplorer();
    }

    private async Task ClosePreview()
    {
        showPreview = false;
        previewItem = null;
        var url = previewUrl;
        previewUrl = null;
        previewMime = null;
        previewError = null;
        previewSheetBytes = null;
        StateHasChanged();
        if (url is not null) await JS.InvokeVoidAsync("ipop.revokePreview");
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private static bool IsCoAuthorable(string name) => GetFileExt(name) is ".docx" or ".doc" or ".xlsx" or ".xls" or ".pptx" or ".ppt" or ".rtf";
    private string GetEditorUrl(SynoItemDto it) => $"/files/editor?server={server}&path={Uri.EscapeDataString(it.Path)}";

    private async Task PrintPreview()
    {
        if (previewUrl is null) return;
        await JS.InvokeVoidAsync("ipop.printUrl", previewUrl);
    }

    private async Task Download(SynoItemDto it)
    {
        var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={server}&path={Uri.EscapeDataString(it.Path)}");
        if (!res.IsSuccessStatusCode) { loadError = "Download failed."; return; }
        var bytes = await res.Content.ReadAsByteArrayAsync();
        var b64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("ipop.download", b64, it.Name);
    }

    private async Task OnUpload(InputFileChangeEventArgs e)
    {
        loadError = null;
        foreach (var file in e.GetMultipleFiles(20))
        {
            using var form = new MultipartFormDataContent();
            form.Add(new StringContent(server), "server");
            form.Add(new StringContent(currentPath), "path");
            await using var s = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            form.Add(new StreamContent(s), "file", file.Name);
            var res = await Auth.SendMultipartAsync("/api/files/upload", form);
            if (!res.IsSuccessStatusCode)
                loadError = res.StatusCode == System.Net.HttpStatusCode.Unauthorized ? "Sign in again." : $"Upload failed: {file.Name}";
        }
        await Reload();
    }

    private async Task SaveCredential()
    {
        credError = null;
        var res = await Auth.SendAsync(HttpMethod.Put, "/api/files/credential", new { server = credServer, username = credUser, password = credPass });
        if (!res.IsSuccessStatusCode) { credError = "Synology rejected the credentials."; StateHasChanged(); return; }
        showCred = false; credUser = ""; credPass = "";
        server = credServer;
        await Reload();
    }

    private async Task ClearCredential()
    {
        await Auth.SendAsync(HttpMethod.Delete, $"/api/files/credential?server={credServer}", null);
        showCred = false; await Reload();
    }

    private static string FormatSize(long b) => b < 1024 ? $"{b} B" : b < 1024 * 1024 ? $"{b / 1024:N0} KB" : $"{b / 1024 / 1024:N0} MB";
    private static string FormatMtime(long mtime) => mtime == 0 ? "—" : DateTimeOffset.FromUnixTimeSeconds(mtime).ToLocalTime().ToString("MMM dd");
    private static string GetFileExt(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant();
    private static bool IsPreviewable(string name) => GetFileExt(name) is ".pdf" or ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" or ".xlsx" or ".xls" or ".csv" or ".docx" or ".doc" or ".pptx" or ".ppt" or ".rtf";
    private static bool IsOfficePreviewable(string name) => GetFileExt(name) is ".docx" or ".doc" or ".pptx" or ".ppt" or ".rtf";
    // Sheets renderable by RadzenSpreadsheet (XLSX/CSV). Legacy .xls stays on the SheetJS path.
    private static bool IsSheetPreviewable(string name) => GetFileExt(name) is ".xlsx" or ".csv";
    private static string GetFileIcon(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "table",
        ".doc" or ".docx" or ".rtf" => "file-text",
        ".ppt" or ".pptx" => "presentation",
        ".pdf" => "file-text",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "image",
        ".zip" or ".rar" or ".7z" or ".tar" or ".gz" => "archive",
        ".mp4" or ".mov" or ".avi" or ".mkv" => "video",
        ".mp3" or ".wav" or ".ogg" => "music",
        _ => "file"
    };
    private static string GetFileIconBg(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "var(--accent-soft)",
        ".doc" or ".docx" or ".rtf" => "var(--info-soft)",
        ".ppt" or ".pptx" => "var(--warn-soft)",
        ".pdf" => "var(--danger-soft)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "rgba(124, 58, 237, 0.12)",
        ".zip" or ".rar" or ".7z" => "var(--surface-3)",
        _ => "var(--surface-2)"
    };
    private static string GetFileIconColor(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "var(--accent-ink)",
        ".doc" or ".docx" or ".rtf" => "var(--info)",
        ".ppt" or ".pptx" => "var(--warn)",
        ".pdf" => "var(--danger)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#8b5cf6",
        ".zip" or ".rar" or ".7z" => "var(--ink-3)",
        _ => "var(--ink-3)"
    };
    private static string GetFileTagBg(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "var(--accent-soft)",
        ".doc" or ".docx" or ".rtf" => "var(--info-soft)",
        ".ppt" or ".pptx" => "var(--warn-soft)",
        ".pdf" => "var(--danger-soft)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "rgba(124, 58, 237, 0.12)",
        _ => "var(--surface-2)"
    };
    private static string GetFileTagColor(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "var(--accent-ink)",
        ".doc" or ".docx" or ".rtf" => "var(--info)",
        ".ppt" or ".pptx" => "var(--warn)",
        ".pdf" => "var(--danger)",
        ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" or ".svg" => "#8b5cf6",
        _ => "var(--ink-2)"
    };
    private static string GetFileExtLabel(string name)
    {
        var ext = GetFileExt(name);
        return string.IsNullOrEmpty(ext) ? "FILE" : ext.TrimStart('.').ToUpperInvariant();
    }
    private static string GetMimeType(string name) => GetFileExt(name) switch
    {
        ".pdf" => "application/pdf",
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        ".gif" => "image/gif",
        ".webp" => "image/webp",
        ".bmp" => "image/bmp",
        ".svg" => "image/svg+xml",
        ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        ".doc" => "application/msword",
        ".rtf" => "application/rtf",
        ".pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        ".ppt" => "application/vnd.ms-powerpoint",
        ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        ".xls" => "application/vnd.ms-excel",
        ".csv" => "text/csv",
        _ => "application/octet-stream"
    };
    private void ShareViaMail(SynoItemDto it)
    {
        var subject = it.Name;
        var body = $"File: {it.Name}\nLocation: {server}:{it.Path}";
        Nav.NavigateTo($"/mail?shareSubject={Uri.EscapeDataString(subject)}&shareBody={Uri.EscapeDataString(body)}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("ipop.revokePreview");
    }
