@page "/news"
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>News & Memos — IPop</PageTitle>

<div class="news-v6x">
    <div class="toolbar">
        <div class="v6-search news-search">
            <i data-lucide="search"></i>
            <input type="search" placeholder="Search news, memos or authors" aria-label="Search news" value="@q" @oninput="e => OnSearchInput(e.Value?.ToString() ?? string.Empty)" />
        </div>
        <div class="push flex center gap-8">
            @if (isApprover)
            {
                <label class="v6-select" title="Filter by workflow status">
                    <i data-lucide="filter"></i>
                    <select aria-label="Status" @bind="statusFilter" @bind:after="() => Reload(1, true)">
                        @foreach (var o in NewsUiHelper.StatusOptions) { <option value="@o.Value">@o.Label</option> }
                    </select>
                    <i data-lucide="chevron-down" class="chev"></i>
                </label>
            }
            <label class="v6-select">
                <i data-lucide="arrow-up-down"></i>
                <select aria-label="Sort" @bind="sortOrder" @bind:after="OnSortChanged">
                    <option value="newest">Newest</option>
                    <option value="oldest">Oldest</option>
                </select>
                <i data-lucide="chevron-down" class="chev"></i>
            </label>
            <button type="button" class="btn-primary" @onclick="OpenCreate"><i data-lucide="square-pen"></i>New post</button>
        </div>
    </div>

    <div class="news-cols">
        <div class="news-side">
            <nav class="card news-nav" aria-label="News filters">
                <button type="button" class="nn @(!requiresAckOnly && !pinnedOnly && !includeScheduled && typeFilter == "" ? "on" : "")" @onclick="ShowAll"><i data-lucide="newspaper"></i><span class="lbl">All posts</span><span class="n">@total</span></button>
                <button type="button" class="nn @(requiresAckOnly ? "on" : "")" @onclick="ToggleAckFilter"><i data-lucide="clipboard-check"></i><span class="lbl">Needs acknowledgement</span>@if (PendingAck > 0) { <span class="dot"></span> }<span class="n">@PendingAck</span></button>
                <button type="button" class="nn @(pinnedOnly ? "on" : "")" @onclick="TogglePinnedFilter"><i data-lucide="pin"></i><span class="lbl">Pinned</span><span class="n">@pinnedItems.Count</span></button>
                @if (isApprover)
                {
                    <button type="button" class="nn @(includeScheduled ? "on" : "")" @onclick="ToggleScheduledFilter"><i data-lucide="clock-3"></i><span class="lbl">Scheduled</span><span class="n">@scheduledItems.Count</span></button>
                }
                <div class="nn-label">Categories</div>
                @foreach (var cat in Categories)
                {
                    var c = cat;
                    <button type="button" class="nn @(typeFilter == c.Key ? "on" : "")" @onclick="() => SetCategoryTab(typeFilter == c.Key ? string.Empty : c.Key)"><i data-lucide="@c.Icon"></i><span class="lbl">@c.Label</span></button>
                }
            </nav>
            @if (PendingAck > 0)
            {
                <div class="news-review">
                    <div class="t"><i data-lucide="clipboard-check"></i><span>@PendingAck @(PendingAck == 1 ? "memo needs" : "memos need") your acknowledgement</span></div>
                    <button type="button" @onclick="ReviewNow">Review now</button>
                </div>
            }
        </div>

        <div class="card news-list">
            <div class="card-head">
                <span class="card-title">@ListTitle</span>
                <span class="card-meta">@total @(total == 1 ? "post" : "posts")</span>
                @if (HasActiveFilters)
                {
                    <button type="button" class="link-btn" style="margin-left:auto" @onclick="ClearFilters">Clear filters</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(listError))
            {
                <div style="padding:12px 16px"><div class="note err"><i data-lucide="alert-circle"></i><span>@listError</span></div></div>
            }
            <div class="news-rows">
                @if (loading && items is null)
                {
                    @for (var i = 0; i < 5; i++) { <div class="skel" style="height:96px;margin:12px 16px;border-radius:10px"></div> }
                }
                else if (items is not null && items.Count == 0)
                {
                    <div class="news-empty">
                        <i data-lucide="@NewsUiHelper.GetCategoryIcon(typeFilter)"></i>
                        <div class="t">No posts here yet</div>
                        <div class="s">@(HasActiveFilters ? "Try clearing the filters." : "Publish the first announcement for your team.")</div>
                        <button type="button" class="btn-primary" @onclick="OpenCreate"><i data-lucide="square-pen"></i>New post</button>
                    </div>
                }
                else if (items is not null)
                {
                    @foreach (var p in OrderedItems)
                    {
                        var post = p;
                        var needsAck = post.RequiresAcknowledgement && !post.IsAcknowledged;
                        <button type="button" class="news-row @(openDetailId == post.Id ? "sel" : "")" @onclick="() => OpenDetail(post.Id)">
                            <div class="r1">
                                <span class="cat-chip @post.Type">@NewsUiHelper.GetCategoryLabel(post.Type)</span>
                                @if (post.IsPinned) { <span class="pin"><i data-lucide="pin"></i>Pinned</span> }
                                @if (post.Status != "published") { <span class="status-pill @post.Status">@NewsUiHelper.StatusLabel(post.Status)</span> }
                                <span class="date">@((post.PublishedAt ?? post.CreatedAt).ToLocalTime().ToString("MMM d, yyyy"))</span>
                            </div>
                            <div class="ttl">@if (needsAck) { <span class="udot"></span> }@post.Title</div>
                            <div class="r3">
                                <span class="by">@post.AuthorName · @NewsUiHelper.ReadTime(post.Title) min read</span>
                                @if (needsAck) { <span class="ack req">Action required</span> }
                                else if (post.RequiresAcknowledgement) { <span class="ack ok"><i data-lucide="check"></i>Acknowledged</span> }
                            </div>
                        </button>
                    }
                    @if (page < totalPages)
                    {
                        <div style="padding:14px;text-align:center">
                            <button type="button" class="ghost-btn" style="margin:0 auto" @onclick="LoadMore">Load more (@(total - items.Count) remaining)</button>
                        </div>
                    }
                }
            </div>
        </div>

        <aside class="card news-v6-reader">
            @if (showDetail && detail is not null)
            {
                <NewsDetailDrawer Inline="true" Detail="@detail" Audits="@audits" IsApprover="@isApprover"
                                  CanEdit="@canEdit" AckBusy="@ackBusy" DetailError="@detailError"
                                  OnClose="CloseDetail" OnCopyLink="CopyLink" OnEdit="OpenEdit"
                                  OnSubmit="Submit" OnApprove="Approve" OnOpenReject="() => showReject = true"
                                  OnUnpublish="Unpublish" OnTogglePin="TogglePin"
                                  OnAcknowledge="Acknowledge" OnRemindAck="RemindAck"
                                  OnDelete="DeleteCurrentPost"
                                  Discussion="@discussion" CommentText="@commentText"
                                  OnCommentTextChanged="v => commentText = v"
                                  OnToggleLike="ToggleLike" OnComment="AddComment" />
            }
            else if (showDetail && detailError is not null)
            {
                <div class="news-v6-empty"><i data-lucide="alert-circle"></i>@detailError</div>
            }
            else if (showDetail)
            {
                <div style="padding:24px"><div class="skel" style="height:28px;width:60%;border-radius:8px"></div><div class="skel" style="height:160px;margin-top:16px;border-radius:12px"></div></div>
            }
            else { <div class="news-v6-empty"><i data-lucide="newspaper"></i>Select a post to read</div> }
        </aside>
    </div>
</div>

<!-- Reject Modal -->
@if (showReject)
{
    <NewsRejectModal OnClose="() => showReject = false"
                     OnConfirmReject="RejectWithReason" />
}

<!-- Create / Edit Drawer Form -->
@if (showCreate || showEdit)
{
    <NewsEditorDrawer IsEdit="@showEdit"
                      Detail="@detail"
                      DefaultCategory="@(string.IsNullOrEmpty(typeFilter) ? "news" : typeFilter)"
                      FormBusy="@formBusy"
                      FormError="@formError"
                      OnClose="CloseForm"
                      OnSave="SaveForm" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    private bool loading = true;
    private string? listError;
    private string q = "";
    private string typeFilter = "";
    private string statusFilter = "";
    private bool pinnedOnly;
    private bool requiresAckOnly;
    private bool includeScheduled;
    private int page = 1;
    private int total;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(total / 20.0));
    private List<NewsSummaryDto>? items;
    private List<NewsSummaryDto> pinnedItems => items?.Where(x => x.IsPinned).ToList() ?? [];
    private List<NewsSummaryDto> feedItems =>
        sortOrder == "oldest"
            ? (items?.Where(x => !x.IsPinned).OrderBy(x => x.PublishedAt ?? x.CreatedAt).ToList() ?? [])
            : (items?.Where(x => !x.IsPinned).OrderByDescending(x => x.PublishedAt ?? x.CreatedAt).ToList() ?? []);
    private List<NewsSummaryDto> scheduledItems => items?.Where(x => x.PublishAt != null && x.PublishAt > DateTime.UtcNow).ToList() ?? [];

    private bool showDetail;
    private NewsDetailDto? detail;
    private List<NewsAuditDto>? audits;
    private string? detailError;
    private bool ackBusy;
    private bool showReject;
    private bool showCreate;
    private bool showEdit;
    private bool formBusy;
    private string? formError;
    private Guid? openDetailId;
    private NewsDiscussionDto? discussion;
    private string commentText = "";
    private string sortOrder = "newest";

    private async Task OnSortChanged()
    {
        await Reload(1, true);
    }

    private bool isApprover => Auth.Me?.Roles.Contains("Admin") == true;
    private bool canEdit => detail is not null && (detail.Status == "draft" || detail.Status == "rejected");
    private bool HasActiveFilters => !string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(statusFilter) || pinnedOnly || requiresAckOnly || includeScheduled;

    protected override void OnInitialized()
    {
        Layout.SetHeader("News & Memos", "Corporate announcements & internal news");
        Layout.SearchChanged += OnLayoutSearch;
    }

    protected override async Task OnInitializedAsync()
    {
        await Reload(1, true);
        // Dashboard deep links: ?post={id} opens the reader, ?new=1 opens the editor.
        var query = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (Guid.TryParse(query["post"], out var postId)) await OpenDetail(postId);
        else if (query["new"] == "1") OpenCreate();
    }

    private void OnLayoutSearch() => _ = InvokeAsync(async () =>
    {
        try
        {
            q = Layout.SearchQuery ?? "";
            await Reload(1, true);
        }
        catch (Exception ex)
        {
            listError = $"Search failed: {ex.Message}";
            loading = false;
            StateHasChanged();
        }
    });

    private async Task OnSearchInput(string val)
    {
        q = val;
        await Reload(1, true);
    }

    private async Task OnStatusFilterChanged(string val)
    {
        statusFilter = val;
        await Reload(1, true);
    }

    private async Task SetCategoryTab(string cat)
    {
        typeFilter = cat;
        await Reload(1, true);
    }

    private static readonly (string Key, string Label, string Icon)[] Categories =
    [
        ("news", "Company news", "building-2"),
        ("memo", "Internal memos", "file-text"),
        ("announcement", "Announcements", "megaphone"),
        ("condolence", "Condolences", "heart"),
    ];
    private int PendingAck => items?.Count(x => x.RequiresAcknowledgement && !x.IsAcknowledged && x.Status == "published") ?? 0;
    private IEnumerable<NewsSummaryDto> OrderedItems => pinnedItems.Concat(feedItems);
    private string ListTitle =>
        requiresAckOnly ? "Needs acknowledgement"
        : pinnedOnly ? "Pinned"
        : includeScheduled ? "Scheduled"
        : string.IsNullOrEmpty(typeFilter) ? "All posts"
        : Categories.FirstOrDefault(c => c.Key == typeFilter).Label ?? NewsUiHelper.GetCategoryLabel(typeFilter);
    private async Task ShowAll()
    {
        typeFilter = "";
        requiresAckOnly = pinnedOnly = includeScheduled = false;
        await Reload(1, true);
    }
    private async Task TogglePinnedFilter()
    {
        pinnedOnly = !pinnedOnly;
        await Reload(1, true);
    }
    private async Task ToggleScheduledFilter()
    {
        includeScheduled = !includeScheduled;
        await Reload(1, true);
    }
    private async Task ReviewNow()
    {
        var first = items?.FirstOrDefault(x => x.RequiresAcknowledgement && !x.IsAcknowledged && x.Status == "published");
        if (!requiresAckOnly) { requiresAckOnly = true; await Reload(1, true); }
        if (first is not null) await OpenDetail(first.Id);
    }
    private async Task ToggleAckFilter()
    {
        requiresAckOnly = !requiresAckOnly;
        await Reload(1, true);
    }

    private async Task Reload(int p, bool replace)
    {
        loading = items is null;
        page = p;
        listError = null;
        var qs = BuildQuery(p);
        var res = await Auth.GetAsync<PagedNewsResult<NewsSummaryDto>>($"/api/news{qs}");
        if (qs != BuildQuery(p)) return;
        if (res is null)
        {
            listError = "Failed to load news list.";
            loading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
        }
        total = res.TotalCount;
        page = res.Page;
        if (replace || items is null) items = res.Items.ToList();
        else items.AddRange(res.Items);
        if (!HasActiveFilters) Layout.SetSubtitle($"{total} {(total == 1 ? "post" : "posts")}{(PendingAck > 0 ? $" · {PendingAck} need acknowledgement" : "")}");
        loading = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private string BuildQuery(int p)
    {
        var parts = new List<string> { $"page={p}", "pageSize=20" };
        if (!string.IsNullOrWhiteSpace(typeFilter)) parts.Add($"type={Uri.EscapeDataString(typeFilter)}");
        if (!string.IsNullOrWhiteSpace(statusFilter)) parts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        if (!string.IsNullOrWhiteSpace(q)) parts.Add($"q={Uri.EscapeDataString(q.Trim())}");
        if (pinnedOnly) parts.Add("pinned=true");
        if (requiresAckOnly) parts.Add("requiresAck=true");
        if (includeScheduled) parts.Add("includeScheduled=true");
        return "?" + string.Join("&", parts);
    }

    private void ClearFilters()
    {
        q = "";
        statusFilter = "";
        pinnedOnly = false;
        requiresAckOnly = false;
        includeScheduled = false;
        _ = Reload(1, true);
    }

    private Task LoadMore() => Reload(page + 1, false);

    private async Task OpenDetail(Guid id)
    {
        openDetailId = id;
        detailError = null;
        audits = null;
        discussion = null;
        commentText = "";
        showDetail = true;
        detail = null;
        StateHasChanged();

        var d = await Auth.GetAsync<NewsDetailDto>($"/api/news/{id}");
        if (d is null)
        {
            if (openDetailId != id) return;
            detailError = "Unable to load post details.";
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
        }
        if (openDetailId != id) return;
        detail = d;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");

        var a = await Auth.GetAsync<NewsAuditDto[]>($"/api/news/{id}/audits");
        if (openDetailId != id) return;
        audits = a?.ToList() ?? [];
        discussion = await Auth.GetAsync<NewsDiscussionDto>($"/api/news/{id}/discussion");
        if (openDetailId != id) return;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private void CloseDetail()
    {
        showDetail = false;
        detail = null;
        audits = null;
        discussion = null;
        detailError = null;
        showReject = false;
        openDetailId = null;
        StateHasChanged();
    }

    private async Task ToggleLike()
    {
        if (detail is not { Status: "published" }) return;
        var method = discussion?.IsLiked == true ? HttpMethod.Delete : HttpMethod.Post;
        var res = await Auth.SendAsync(method, $"/api/news/{detail.Id}/like", null);
        if (res.IsSuccessStatusCode) discussion = await res.Content.ReadFromJsonAsync<NewsDiscussionDto>();
        else Toasts.Show("Could not update your reaction.");
    }

    private async Task AddComment()
    {
        if (detail is not { Status: "published" } || string.IsNullOrWhiteSpace(commentText)) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/comments", new { body = commentText.Trim() });
        if (res.IsSuccessStatusCode)
        {
            discussion = await res.Content.ReadFromJsonAsync<NewsDiscussionDto>();
            commentText = "";
        }
        else Toasts.Show("Could not post your comment.");
    }

    private async Task Acknowledge()
    {
        if (detail is null) return;
        ackBusy = true;
        detailError = null;
        StateHasChanged();
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/acknowledge", null);
            if (!res.IsSuccessStatusCode)
            {
                detailError = "Unable to record acknowledgement.";
                StateHasChanged();
                return;
            }
            var updated = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
            if (updated is not null) detail = updated;
            await Reload(1, true);
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            Toasts.Show("Read confirmation recorded successfully.", ToastKind.Success);
        }
        finally
        {
            ackBusy = false;
        }
    }

    private async Task RemindAck()
    {
        if (detail is null) return;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/remind-ack", null);
            if (res.IsSuccessStatusCode)
            {
                Toasts.Show("Reminder sent to targeted employees.", ToastKind.Success);
            }
            else
            {
                Toasts.Show("Unable to send acknowledgement reminder.", ToastKind.Error);
            }
        }
        catch (Exception ex)
        {
            Toasts.Show($"Reminder failed: {ex.Message}", ToastKind.Error);
        }
    }

    private async Task CopyLink()
    {
        if (detail is null) return;
        var url = Nav.Uri.Split('?')[0] + $"?post={detail.Id}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Toasts.Show("Post link copied to clipboard.", ToastKind.Success);
        }
        catch
        {
            Toasts.Show(url, ToastKind.Info);
        }
    }

    private async Task Submit() => await Workflow("submit");
    private async Task Approve() => await Workflow("approve");

    private async Task RejectWithReason(string reason)
    {
        if (string.IsNullOrWhiteSpace(reason))
        {
            detailError = "Rejection reason is required.";
            StateHasChanged();
            return;
        }
        showReject = false;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail!.Id}/reject", new { reason });
        if (!res.IsSuccessStatusCode)
        {
            detailError = await ReadErr(res);
            StateHasChanged();
            return;
        }
        detail = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        await Reload(1, true);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
        Toasts.Show("Post has been rejected.", ToastKind.Info);
    }

    private async Task Publish() => await Workflow("publish");
    private async Task Unpublish() => await Workflow("unpublish");

    private async Task TogglePin()
    {
        if (detail is null) return;
        var method = detail.IsPinned ? HttpMethod.Delete : HttpMethod.Post;
        var res = await Auth.SendAsync(method, $"/api/news/{detail.Id}/pin", null);
        if (!res.IsSuccessStatusCode)
        {
            detailError = await ReadErr(res);
            StateHasChanged();
            return;
        }
        detail = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        await Reload(1, true);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
        Toasts.Show(detail.IsPinned ? "Post pinned successfully." : "Post unpinned.", ToastKind.Success);
    }

    private async Task Workflow(string action)
    {
        if (detail is null) return;
        detailError = null;
        StateHasChanged();
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/{action}", null);
        if (!res.IsSuccessStatusCode)
        {
            detailError = await ReadErr(res);
            StateHasChanged();
            return;
        }
        detail = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        audits = await Auth.GetAsync<NewsAuditDto[]>($"/api/news/{detail!.Id}/audits") is { } a ? a.ToList() : audits;
        await Reload(1, true);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
        Toasts.Show("Action " + action + " completed successfully.", ToastKind.Success);
    }

    private async Task DeleteCurrentPost()
    {
        if (detail is null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{detail.Title}\"?");
        if (!confirmed) return;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/news/{detail.Id}");
        if (res.IsSuccessStatusCode)
        {
            CloseDetail();
            await Reload(1, true);
            Toasts.Show("Post deleted.", ToastKind.Success);
        }
        else
        {
            Toasts.Show("Could not delete post.", ToastKind.Error);
        }
    }

    private void OpenCreate()
    {
        formError = null;
        showCreate = true;
        showEdit = false;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    private void OpenEdit()
    {
        if (detail is null) return;
        formError = null;
        showEdit = true;
        showCreate = false;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    private void CloseForm()
    {
        showCreate = false;
        showEdit = false;
        formError = null;
        formBusy = false;
        StateHasChanged();
    }

    private async Task SaveForm(NewsSaveRequest req)
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(req.Title))
        {
            formError = "Post title is required.";
            StateHasChanged();
            return;
        }
        if (string.IsNullOrWhiteSpace(req.Body))
        {
            formError = "Content is required.";
            StateHasChanged();
            return;
        }
        formBusy = true;
        StateHasChanged();

        HttpResponseMessage res;
        if (showEdit && detail is not null)
        {
            res = await Auth.SendAsync(new HttpMethod("PATCH"), $"/api/news/{detail.Id}", new
            {
                title = req.Title,
                body = req.Body,
                type = req.Type,
                publishAt = req.PublishAt,
                requiresAcknowledgement = req.RequiresAcknowledgement,
                isPinned = req.IsPinned,
                targets = req.Targets
            });
        }
        else
        {
            res = await Auth.SendAsync(HttpMethod.Post, "/api/news", new
            {
                type = req.Type,
                title = req.Title,
                body = req.Body,
                publishAt = req.PublishAt,
                requiresAcknowledgement = req.RequiresAcknowledgement,
                isPinned = req.IsPinned,
                targets = req.Targets.Count == 0 ? null : req.Targets
            });
        }

        if (!res.IsSuccessStatusCode)
        {
            formError = await ReadErr(res);
            formBusy = false;
            StateHasChanged();
            return;
        }

        var created = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        formBusy = false;
        showCreate = false;
        showEdit = false;
        if (created is not null)
        {
            detail = created;
            showDetail = true;
            audits = await Auth.GetAsync<NewsAuditDto[]>($"/api/news/{created.Id}/audits") is { } a ? a.ToList() : audits;
        }
        await Reload(1, true);
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
        Toasts.Show(showEdit ? "Post updated successfully." : "Draft post created successfully.", ToastKind.Success);
    }

    private static async Task<string> ReadErr(HttpResponseMessage r)
    {
        try
        {
            var j = await r.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (j is not null && j.TryGetValue("message", out var m)) return m;
            if (j is not null && j.TryGetValue("code", out var c)) return c;
        }
        catch { }
        return r.StatusCode.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) => await JS.InvokeVoidAsync("ipop.icons");
    public void Dispose() { Layout.SearchChanged -= OnLayoutSearch; }
}
