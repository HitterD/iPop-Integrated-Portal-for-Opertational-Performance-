@page "/news"
@page "/news/{Id:guid}"
@implements IDisposable
@inject AuthState Auth
@inject NotificationState Notifs
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject BadgeState Badges
@inject IPop.Web.Services.PageCache Cache

<PageTitle>News & Memos — IPop</PageTitle>

<div class="news-v6x nm @(showDetail ? "m-detail" : "") @(IsHome ? "nm-home" : "nm-read")">
    <div class="nm-top">
        <div class="nm-tabs" role="tablist" aria-label="News filters">
            @if (!IsHome)
            {
                <button type="button" class="nm-back" @onclick="GoHome"><i data-lucide="chevron-left"></i>All news</button>
                <span class="nm-sep"></span>
            }
            @foreach (var v in Views)
            {
                var view = v;
                if (view.ManagerOnly && !canManage) continue;
                var n = CountFor(view.Key);
                if (view.Key is "pinned" or "scheduled" && n == 0 && activeView != view.Key) continue;
                var on = activeView == view.Key && typeFilter == "";
                <button type="button" role="tab" aria-selected="@(on ? "true" : "false")" class="nm-tab @(on ? "on" : "")" @onclick="() => SetView(view.Key)">
                    @view.Label
                    @if (view.Key == "ack" && n > 0) { <span class="nm-badge">@n</span> }
                    else if (view.Key is "unread" or "drafts" or "scheduled" && n > 0) { <span class="nm-count">@n</span> }
                </button>
            }
            <span class="nm-sep"></span>
            @foreach (var cat in Categories)
            {
                var c = cat;
                <button type="button" class="nm-tab cat @NewsHome.Kind(c.Key) @(typeFilter == c.Key ? "on" : "")" aria-pressed="@(typeFilter == c.Key ? "true" : "false")"
                        @onclick="() => SetCategory(typeFilter == c.Key ? string.Empty : c.Key)"><i data-lucide="@NewsHome.Icon(c.Key)"></i>@c.Label</button>
            }
        </div>
        <div class="nm-actions">
            <div class="v6-search news-search">
                <i data-lucide="search"></i>
                <input type="search" placeholder="Search news, memos or authors" aria-label="Search news" value="@q" @oninput="e => OnSearchInput(e.Value?.ToString() ?? string.Empty)" />
            </div>
            @if (!IsHome)
            {
                <AppSelect Label="Sort" CssClass="news-sort" Value="@sortOrder" Options="@SortOptions"
                           ValueChanged="async v => { sortOrder = v ?? sortOrder; await Reload(1, true); }" />
            }
            @if (canManage)
            {
                <button type="button" class="btn-primary" @onclick="OpenCreate"><i data-lucide="square-pen"></i>New post</button>
            }
        </div>
    </div>

    @if (IsHome)
    {
        <div class="nm-body">
            @if ((counts?.NeedsAck ?? 0) > 0)
            {
                <div class="nm-ack-strip" role="status">
                    <span class="ic"><i data-lucide="clipboard-check"></i></span>
                    <span class="tx"><b>@counts!.NeedsAck @(counts.NeedsAck == 1 ? "memo needs" : "memos need") your acknowledgement</b>
                        @if (NextAck is { } na) { <small>@na.Title@(na.AckDueAt is { } due ? $" is due {due.ToLocalTime():ddd d MMM}" : "")</small> }</span>
                    <button type="button" class="nm-btn" @onclick="ReviewNow">Review now</button>
                </div>
            }
            @if (!string.IsNullOrEmpty(listError))
            {
                <div class="note err"><i data-lucide="alert-circle"></i><span>@listError</span></div>
            }
            @if (loading && items is null)
            {
                <div class="nh-hero"><div class="skel" style="height:330px;border-radius:18px"></div><div class="skel" style="height:330px;border-radius:18px"></div></div>
            }
            else if (items is { Count: 0 })
            {
                <div class="news-empty">
                    <i data-lucide="newspaper"></i>
                    <div class="t">No posts yet</div>
                    <div class="s">@(canManage ? "Publish the first announcement for your team." : "New announcements will show up here.")</div>
                    @if (canManage) { <button type="button" class="btn-primary" @onclick="OpenCreate"><i data-lucide="square-pen"></i>New post</button> }
                </div>
            }
            else if (items is not null)
            {
                <NewsHome Items="items" OnOpen="OpenDetail" />
                @if (page < totalPages)
                {
                    <div class="nm-more"><button type="button" class="ghost-btn" @onclick="LoadMore">Show more (@(total - items.Count) remaining)</button></div>
                }
            }
        </div>
    }
    else
    {
    <div class="news-cols">
        <div class="card news-list">
            <div class="card-head">
                <span class="card-title">@ListTitle</span>
                <span class="card-meta">@total @(total == 1 ? "post" : "posts")</span>
                @if (activeView == "drafts")
                {
                    <a class="link-btn" style="margin-left:auto" href="/news/drafts">Private autosaves</a>
                }
                else if (HasActiveFilters)
                {
                    <button type="button" class="link-btn" style="margin-left:auto" @onclick="ClearFilters">Clear filters</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(listError))
            {
                <div style="padding:12px 16px"><div class="note err"><i data-lucide="alert-circle"></i><span>@listError</span></div></div>
            }
            <div class="news-rows">
                @if (loading && items is null)
                {
                    @for (var i = 0; i < 5; i++) { <div class="skel" style="height:72px;margin:12px 16px;border-radius:10px"></div> }
                }
                else if (items is not null && items.Count == 0)
                {
                    <div class="news-empty">
                        <i data-lucide="@EmptyIcon"></i>
                        <div class="t">@EmptyTitle</div>
                        <div class="s">@(HasActiveFilters ? "Try another filter." : canManage ? "Publish the first announcement for your team." : "New announcements will show up here.")</div>
                    </div>
                }
                else if (items is not null)
                {
                    @foreach (var p in items)
                    {
                        var post = p;
                        var unread = post.Status == "published" && !post.IsRead;
                        <button type="button" class="nm-row @NewsHome.Kind(post.Type) @(openDetailId == post.Id ? "sel" : "") @(unread ? "unread" : "")" @onclick="() => OpenDetail(post.Id)">
                            <span class="nh-th">
                                @if (post.Video is { } video) { <NewsVideoThumb Video="@video" CssClass="nh-media sm" /> }
                                else if (post.CoverMediaId is { } cover && post.CoverMode != "none") { <NewsCoverThumb PostId="@post.Id" MediaId="@cover" /> }
                                else { <span class="nh-ill"><i data-lucide="@NewsHome.Icon(post.Type)"></i></span> }
                            </span>
                            <span class="nm-rtxt">
                                <span class="nh-r1"><span class="nh-chip"><i data-lucide="@NewsHome.Icon(post.Type)"></i>@NewsUiHelper.GetCategoryLabel(post.Type)</span>
                                    @if (post.IsPinned) { <i data-lucide="pin" class="nm-pin" aria-label="Pinned"></i> }
                                    <span class="nh-when">@NewsHome.When(post)</span></span>
                                <span class="nm-rtitle">@if (unread) { <span class="nh-udot" title="Unread"></span> }@post.Title</span>
                                <Meta Post="post" />
                            </span>
                        </button>
                    }
                    @if (page < totalPages)
                    {
                        <div style="padding:14px;text-align:center">
                            <button type="button" class="ghost-btn" style="margin:0 auto" @onclick="LoadMore">Load more (@(total - items.Count) remaining)</button>
                        </div>
                    }
                }
            </div>
        </div>

        <aside class="card news-v6-reader">
            @if (showDetail)
            {
                <div class="m-detail-bar news-m-bar">
                    <button type="button" class="m-back" aria-label="Back" @onclick="CloseDetail"><i data-lucide="chevron-left"></i></button>
                    <span class="m-detail-title">@ListTitle</span>
                </div>
            }
            @if (showDetail && detail is not null)
            {
                <NewsDetailDrawer Inline="true" Detail="@detail" Audits="@audits"
                                  AckBusy="@ackBusy" DetailError="@detailError"
                                  OnClose="CloseDetail" OnCopyLink="CopyLink" OnEdit="OpenEdit"
                                  OnPublish="Publish" OnUnpublish="Unpublish" OnTogglePin="TogglePin"
                                  OnToggleSave="ToggleSave" OnMarkUnread="MarkUnread"
                                  OnAcknowledge="Acknowledge" OnRemindAck="RemindAck"
                                  OnDelete="DeleteCurrentPost"
                                  Discussion="@discussion" CommentText="@commentText"
                                  OnCommentTextChanged="v => commentText = v"
                                  OnToggleLike="ToggleLike" OnComment="AddComment"
                                  OnPrev="@(PrevId is null ? null : () => OpenDetail(PrevId.Value))"
                                  OnNext="@(NextId is null ? null : () => OpenDetail(NextId.Value))" />
            }
            else if (showDetail && detailError is not null)
            {
                <div class="news-v6-empty"><i data-lucide="alert-circle"></i>@detailError</div>
            }
            else if (showDetail)
            {
                <div style="padding:24px"><div class="skel" style="height:28px;width:60%;border-radius:8px"></div><div class="skel" style="height:160px;margin-top:16px;border-radius:12px"></div></div>
            }
            else { <div class="news-v6-empty"><i data-lucide="newspaper"></i>Pick a post on the left to read it</div> }
        </aside>
    </div>
    }
</div>

@if (showCreate || showEdit)
{
    <NewsEditorDrawer IsEdit="@showEdit"
                      Detail="@detail"
                      DefaultCategory="@(string.IsNullOrEmpty(typeFilter) ? "news" : typeFilter)"
                      FormBusy="@formBusy"
                      FormError="@formError"
                      OnClose="CloseForm"
                      OnSave="SaveForm" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    [Parameter] public Guid? Id { get; set; }

    private bool loading = true;
    private string? listError;
    private string q = "";
    private string typeFilter = "";
    private string activeView = "all";
    private string sortOrder = "newest";
    private static List<AppOption> SortOptions =>
    [
        new("newest", "Newest", Icon: "arrow-down-wide-narrow"),
        new("oldest", "Oldest", Icon: "arrow-up-narrow-wide"),
        new("mostRead", "Most read", Icon: "eye"),
    ];
    private int page = 1;
    private int total;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(total / 20.0));
    private List<NewsSummaryDto>? items;
    private NewsCountsDto? counts;

    private bool showDetail;
    private NewsDetailDto? detail;
    private List<NewsAuditDto>? audits;
    private string? detailError;
    private bool ackBusy;
    private bool showCreate;
    private bool showEdit;
    private bool formBusy;
    private string? formError;
    private Guid? openDetailId;
    private NewsDiscussionDto? discussion;
    private string commentText = "";

    // The server decides who manages news (Admin or HR); the role list is only a first-paint hint.
    private bool canManage => counts?.CanManage ?? (Auth.Me?.Roles.Any(r => r is "Admin" or "HR") == true);
    private bool HasActiveFilters => !string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(typeFilter) || activeView != "all";

    /// Front page: "For you" with no category or search and no post open. Anything else reads in two columns.
    private bool IsHome => !HasActiveFilters && !showDetail && !readMode;
    /// Set by "Latest"/list navigation so closing a post keeps the two-column list.
    private bool readMode;

    private NewsSummaryDto? NextAck => items?.FirstOrDefault(p => p.Status == "published" && p.RequiresAcknowledgement && !p.IsAcknowledged);

    private int OpenIndex => items is null || openDetailId is null ? -1 : items.FindIndex(p => p.Id == openDetailId);
    private Guid? PrevId => OpenIndex > 0 ? items![OpenIndex - 1].Id : null;
    private Guid? NextId => OpenIndex >= 0 && OpenIndex < items!.Count - 1 ? items[OpenIndex + 1].Id : null;

    [JSInvokable]
    public Task NewsStep(int dir) => InvokeAsync(async () =>
    {
        if (!showDetail || showCreate || showEdit) return;
        if ((dir > 0 ? NextId : PrevId) is { } id) await OpenDetail(id);
    });

    private async Task GoHome()
    {
        readMode = false;
        if (showDetail) CloseDetail();
        if (HasActiveFilters) await ClearFilters();
    }

    private static readonly (string Key, string Label, string Icon, bool ManagerOnly)[] Views =
    [
        ("all", "For you", "newspaper", false),
        ("unread", "Unread", "mail", false),
        ("ack", "To acknowledge", "clipboard-check", false),
        ("saved", "Saved", "bookmark", false),
        ("pinned", "Pinned", "pin", false),
        ("scheduled", "Scheduled", "clock-3", true),
        ("drafts", "Drafts", "file-pen-line", true),
    ];

    private static readonly (string Key, string Label, string Icon)[] Categories =
    [
        ("news", "Company news", "building-2"),
        ("memo", "Memos", "file-text"),
        ("announcement", "Announcements", "megaphone"),
        ("condolence", "Condolences", "heart"),
    ];

    private int CountFor(string view) => counts is null ? 0 : view switch
    {
        "unread" => counts.Unread,
        "ack" => counts.NeedsAck,
        "saved" => counts.Saved,
        "pinned" => counts.Pinned,
        "scheduled" => counts.Scheduled,
        "drafts" => counts.Drafts,
        _ => counts.All,
    };

    private string ListTitle =>
        !string.IsNullOrEmpty(typeFilter) ? Categories.FirstOrDefault(c => c.Key == typeFilter).Label ?? NewsUiHelper.GetCategoryLabel(typeFilter)
        : activeView == "all" ? (string.IsNullOrWhiteSpace(q) ? "All posts" : $"Results for “{q.Trim()}”")
        : Views.FirstOrDefault(v => v.Key == activeView).Label ?? "All posts";

    private string EmptyIcon => activeView switch
    {
        "unread" => "mail-check",
        "ack" => "clipboard-check",
        "saved" => "bookmark",
        "pinned" => "pin",
        "scheduled" => "clock-3",
        "drafts" => "file-pen-line",
        _ => NewsUiHelper.GetCategoryIcon(typeFilter)
    };

    private string EmptyTitle => activeView switch
    {
        "unread" => "You're all caught up",
        "ack" => "Nothing waiting for your acknowledgement",
        "saved" => "No saved posts yet",
        "drafts" => "No drafts",
        "scheduled" => "Nothing scheduled",
        _ => "No posts here yet"
    };

    protected override void OnInitialized()
    {
        Layout.SetHeader("News & Memos", "Corporate announcements & internal news");
        Layout.SearchChanged += OnLayoutSearch;
        _newsSub = Auth.On(IPop.Application.Realtime.RealtimeEvents.NewsChanged, OnNewsChanged);
    }

    // ── Live refresh (newsChanged) ──
    // A post was created/edited/published/pinned/deleted elsewhere. Re-fetch counts and the
    // pages already loaded in place (no spinner, same length so scroll holds); the open reader
    // and any create/edit form are left alone. Debounced so a burst triggers one reload.
    private IDisposable? _newsSub;
    private CancellationTokenSource? _liveCts;

    private void OnNewsChanged()
    {
        _liveCts?.Cancel(); _liveCts?.Dispose();
        var t = new CancellationTokenSource(); _liveCts = t;
        _ = InvokeAsync(async () =>
        {
            try { await Task.Delay(400, t.Token); } catch (OperationCanceledException) { return; }
            await LiveRefreshAsync();
        });
    }

    private async Task LiveRefreshAsync()
    {
        try
        {
            // The "news" badge (unacknowledged memos) is per user, so re-seed it over REST.
            _ = Badges.RefreshAsync();
            await LoadCounts();
            if (items is null || loading) return;

            var pages = Math.Max(1, page);
            var fresh = new List<NewsSummaryDto>();
            var seen = new HashSet<Guid>();
            var newTotal = total;
            var startQuery = BuildQuery(pages);
            for (var p = 1; p <= pages; p++)
            {
                var res = await Auth.GetAsync<PagedNewsResult<NewsSummaryDto>>($"/api/news{BuildQuery(p)}");
                if (res is null) return;
                newTotal = res.TotalCount;
                fresh.AddRange(res.Items.Where(i => seen.Add(i.Id)));
                if (fresh.Count >= newTotal) break;
            }
            // Filters/search changed while we were fetching: that load wins.
            if (startQuery != BuildQuery(pages) || loading) return;
            items = fresh;
            total = newTotal;

            // Refresh the open reader in place unless the editor is up (keep the form untouched).
            if (openDetailId is { } id && showDetail && !showEdit && detail is not null)
            {
                var d = await Auth.GetAsync<NewsDetailDto>($"/api/news/{id}");
                if (d is not null && openDetailId == id && !showEdit) detail = d;
            }
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { /* background refresh — the next event or a manual refresh will catch up */ }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadCounts(), Reload(1, true));
        // Deep links: /news/{id} or legacy ?post={id} open the reader; ?new=1 opens the editor.
        var query = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (Id is { } routeId) await OpenDetail(routeId);
        else if (Guid.TryParse(query["post"], out var postId)) await OpenDetail(postId);
        else if (query["new"] == "1" && canManage) OpenCreate();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Navigating between /news/{id} links while the page is mounted.
        if (Id is { } id && id != openDetailId && items is not null) await OpenDetail(id);
    }

    private void OnLayoutSearch() => _ = InvokeAsync(async () =>
    {
        try
        {
            q = Layout.SearchQuery ?? "";
            await Reload(1, true);
        }
        catch (Exception ex)
        {
            listError = $"Search failed: {ex.Message}";
            loading = false;
            StateHasChanged();
        }
    });

    private async Task OnSearchInput(string val)
    {
        q = val;
        await Reload(1, true);
    }

    private async Task SetView(string view)
    {
        // "For you" is the front page: leave the reader and go back to the magazine.
        if (view == "all" && string.IsNullOrWhiteSpace(q)) { await GoHome(); return; }
        activeView = view;
        typeFilter = "";
        await Reload(1, true);
    }

    private async Task SetCategory(string cat)
    {
        typeFilter = cat;
        activeView = "all";
        await Reload(1, true);
    }

    private async Task ReviewNow()
    {
        await SetView("ack");
        if (items?.FirstOrDefault() is { } first) await OpenDetail(first.Id);
    }

    private async Task LoadCounts()
    {
        counts = await Auth.GetAsync<NewsCountsDto>("/api/news/counts") ?? counts;
        if (counts is not null)
            Layout.SetSubtitle($"{counts.All} {(counts.All == 1 ? "post" : "posts")}{(counts.Unread > 0 ? $" · {counts.Unread} unread" : "")}{(counts.NeedsAck > 0 ? $" · {counts.NeedsAck} need acknowledgement" : "")}");
        StateHasChanged();
    }

    private async Task Reload(int p, bool replace)
    {
        page = p;
        listError = null;
        var qs = BuildQuery(p);
        // Same filters as last visit: show that first page while this one loads (memory only).
        var cacheKey = p == 1 ? $"news{qs}" : null;
        if (cacheKey is not null && (replace || items is null) && Cache.Peek<PagedNewsResult<NewsSummaryDto>>(cacheKey) is { } cached)
        {
            items = cached.Items.ToList();
            total = cached.TotalCount;
        }
        loading = items is null;
        var res = await Auth.GetAsync<PagedNewsResult<NewsSummaryDto>>($"/api/news{qs}");
        if (qs != BuildQuery(p)) return;
        if (res is not null && cacheKey is not null) Cache.Put(cacheKey, res);
        if (res is null)
        {
            listError = "Failed to load news list.";
            loading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
        }
        total = res.TotalCount;
        page = res.Page;
        if (replace || items is null) items = res.Items.ToList();
        else items.AddRange(res.Items);
        loading = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private string BuildQuery(int p)
    {
        var parts = new List<string> { $"page={p}", "pageSize=20", $"sort={sortOrder}" };
        if (!string.IsNullOrWhiteSpace(typeFilter)) parts.Add($"type={Uri.EscapeDataString(typeFilter)}");
        if (!string.IsNullOrWhiteSpace(q)) parts.Add($"q={Uri.EscapeDataString(q.Trim())}");
        switch (activeView)
        {
            case "unread": parts.Add("view=unread"); break;
            case "saved": parts.Add("view=saved"); break;
            case "drafts": parts.Add("view=drafts"); break;
            case "scheduled": parts.Add("view=scheduled"); break;
            case "pinned": parts.Add("pinned=true"); break;
            case "ack": parts.Add("requiresAck=true"); break;
        }
        return "?" + string.Join("&", parts);
    }

    private async Task ClearFilters()
    {
        q = "";
        typeFilter = "";
        activeView = "all";
        await Reload(1, true);
    }

    private Task LoadMore() => Reload(page + 1, false);

    private async Task Refresh()
    {
        await Task.WhenAll(LoadCounts(), Reload(1, true));
    }

    private void PatchRow(Guid id, Func<NewsSummaryDto, NewsSummaryDto> change)
    {
        if (items is null) return;
        var i = items.FindIndex(x => x.Id == id);
        if (i >= 0) items[i] = change(items[i]);
    }

    private async Task OpenDetail(Guid id)
    {
        openDetailId = id;
        detailError = null;
        audits = null;
        discussion = null;
        commentText = "";
        showDetail = true;
        detail = null;
        StateHasChanged();
        _selfRef ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _selfRef, nameof(MobileBack)); } catch (JSException) { }

        var d = await Auth.GetAsync<NewsDetailDto>($"/api/news/{id}");
        if (openDetailId != id) return;
        if (d is null)
        {
            detailError = "This post is unavailable or you don't have access to it.";
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
        }
        detail = d;
        _ = Notifs.MarkReadByTargetAsync("news", id);
        // Opening a published post marks it read on the server; mirror that in the list.
        if (d.Status == "published")
        {
            var wasUnread = items?.FirstOrDefault(x => x.Id == id) is { IsRead: false };
            PatchRow(id, x => x with { IsRead = true });
            if (wasUnread) _ = LoadCounts();
        }
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");

        if (d.CanManage)
        {
            var a = await Auth.GetAsync<NewsAuditDto[]>($"/api/news/{id}/audits");
            if (openDetailId != id) return;
            audits = a?.ToList() ?? [];
        }
        if (d.Status == "published")
            discussion = await Auth.GetAsync<NewsDiscussionDto>($"/api/news/{id}/discussion");
        if (openDetailId != id) return;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    // ── Phone layout (<= 767px): the reader is a full-screen detail; phone Back closes it. ──
    private DotNetObjectReference<News>? _selfRef;

    [JSInvokable]
    public Task MobileBack() => InvokeAsync(CloseDetail);

    private void CloseDetail()
    {
        // Drop the reader's history entry (no-op on desktop or when Back already popped it).
        if (showDetail) _ = JS.InvokeVoidAsync("ipop.mobile.popDetail").AsTask().ContinueWith(_ => { });
        showDetail = false;
        detail = null;
        audits = null;
        discussion = null;
        detailError = null;
        openDetailId = null;
        StateHasChanged();
    }

    private async Task ToggleLike()
    {
        if (detail is not { Status: "published" }) return;
        var method = discussion?.IsLiked == true ? HttpMethod.Delete : HttpMethod.Post;
        var res = await Auth.SendAsync(method, $"/api/news/{detail.Id}/like", null);
        if (res.IsSuccessStatusCode) discussion = await res.Content.ReadFromJsonAsync<NewsDiscussionDto>();
        else Toasts.Show("Could not update your reaction.", ToastKind.Error);
    }

    private async Task AddComment()
    {
        if (detail is not { Status: "published" } || string.IsNullOrWhiteSpace(commentText)) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/comments", new { body = commentText.Trim() });
        if (res.IsSuccessStatusCode)
        {
            discussion = await res.Content.ReadFromJsonAsync<NewsDiscussionDto>();
            commentText = "";
        }
        else Toasts.Show("Could not post your comment.", ToastKind.Error);
    }

    private async Task ToggleSave()
    {
        if (detail is null) return;
        var save = !detail.IsSaved;
        var res = await Auth.SendAsync(save ? HttpMethod.Post : HttpMethod.Delete, $"/api/news/{detail.Id}/bookmark", null);
        if (!res.IsSuccessStatusCode) { Toasts.Show("Could not update saved posts.", ToastKind.Error); return; }
        detail = detail with { IsSaved = save };
        PatchRow(detail.Id, x => x with { IsSaved = save });
        Toasts.Show(save ? "Saved for later." : "Removed from saved.", ToastKind.Success);
        if (activeView == "saved") await Reload(1, true);
        await LoadCounts();
    }

    private async Task MarkUnread()
    {
        if (detail is null) return;
        var id = detail.Id;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/news/{id}/read", null);
        if (!res.IsSuccessStatusCode) { Toasts.Show("Could not mark as unread.", ToastKind.Error); return; }
        PatchRow(id, x => x with { IsRead = false });
        CloseDetail();
        await LoadCounts();
        Toasts.Show("Marked as unread.", ToastKind.Success);
    }

    private async Task Acknowledge()
    {
        if (detail is null) return;
        ackBusy = true;
        detailError = null;
        StateHasChanged();
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/acknowledge?contentVersion={detail.ContentVersion}", null);
            if (!res.IsSuccessStatusCode)
            {
                detailError = res.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "This post has changed. Reopen it and read the latest version before acknowledging."
                    : "Unable to record acknowledgement.";
                StateHasChanged();
                return;
            }
            var updated = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
            if (updated is not null) detail = updated;
            PatchRow(detail.Id, x => x with { IsAcknowledged = true });
            await LoadCounts();
            if (activeView == "ack") await Reload(1, true);
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            Toasts.Show("Acknowledgement recorded.", ToastKind.Success);
        }
        finally
        {
            ackBusy = false;
        }
    }

    private async Task RemindAck()
    {
        if (detail is null) return;
        var pending = detail.AckTotal - detail.AckCount;
        if (!await Confirm.AskAsync("Send reminder?", $"{pending} {(pending == 1 ? "employee has" : "employees have")} not acknowledged \"{detail.Title}\" yet. They will get a high-priority notification.", "Send reminder", danger: false))
            return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/remind-ack", null);
        if (res.IsSuccessStatusCode)
        {
            await ReloadAudits();
            Toasts.Show($"Reminder sent to {pending} {(pending == 1 ? "employee" : "employees")}.", ToastKind.Success);
        }
        else Toasts.Show("Unable to send the reminder.", ToastKind.Error);
    }

    private async Task CopyLink()
    {
        if (detail is null) return;
        var url = Nav.ToAbsoluteUri($"news/{detail.Id}").ToString();
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
            Toasts.Show("Link copied to clipboard.", ToastKind.Success);
        }
        catch
        {
            Toasts.Show(url, ToastKind.Info);
        }
    }

    private Task Publish() => Workflow("publish", "Post published.");
    private async Task Unpublish()
    {
        if (detail is null) return;
        if (!await Confirm.AskAsync("Unpublish post?", $"\"{detail.Title}\" will be hidden from readers and moved back to drafts.", "Unpublish", danger: false)) return;
        await Workflow("unpublish", "Post moved back to drafts.");
    }

    private async Task TogglePin()
    {
        if (detail is null) return;
        var method = detail.IsPinned ? HttpMethod.Delete : HttpMethod.Post;
        var res = await Auth.SendAsync(method, $"/api/news/{detail.Id}/pin", null);
        if (!res.IsSuccessStatusCode)
        {
            detailError = await ReadErr(res);
            StateHasChanged();
            return;
        }
        detail = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        await ReloadAudits();
        await Refresh();
        Toasts.Show(detail!.IsPinned ? "Post pinned to the top." : "Post unpinned.", ToastKind.Success);
    }

    private async Task Workflow(string action, string done)
    {
        if (detail is null) return;
        detailError = null;
        StateHasChanged();
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/{detail.Id}/{action}", null);
        if (!res.IsSuccessStatusCode)
        {
            detailError = await ReadErr(res);
            StateHasChanged();
            return;
        }
        detail = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        await ReloadAudits();
        await Refresh();
        Toasts.Show(done, ToastKind.Success);
    }

    private async Task ReloadAudits()
    {
        if (detail is { CanManage: true })
            audits = await Auth.GetAsync<NewsAuditDto[]>($"/api/news/{detail.Id}/audits") is { } a ? a.ToList() : audits;
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task DeleteCurrentPost()
    {
        if (detail is null) return;
        if (!await Confirm.AskAsync("Delete post?", $"\"{detail.Title}\" and its comments, acknowledgements and attachments will be permanently removed. This is recorded in the audit trail.", "Delete", danger: true))
            return;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/news/{detail.Id}");
        if (res.IsSuccessStatusCode)
        {
            CloseDetail();
            await Refresh();
            Toasts.Show("Post deleted.", ToastKind.Success);
        }
        else
        {
            Toasts.Show("Could not delete post.", ToastKind.Error);
        }
    }

    private void OpenCreate()
    {
        if (!canManage) return;
        Nav.NavigateTo($"/news/new?category={Uri.EscapeDataString(string.IsNullOrEmpty(typeFilter) ? "news" : typeFilter)}");
    }

    private void OpenEdit()
    {
        if (detail is null) return;
        if (!detail.CanEdit) return;
        Nav.NavigateTo($"/news/{detail.Id}/edit");
    }

    private void CloseForm()
    {
        showCreate = false;
        showEdit = false;
        formError = null;
        formBusy = false;
        StateHasChanged();
    }

    private async Task SaveForm(NewsSaveRequest req)
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(req.Title)) { formError = "Post title is required."; StateHasChanged(); return; }
        if (string.IsNullOrWhiteSpace(req.Body)) { formError = "Content is required."; StateHasChanged(); return; }
        if (req.Mode == "schedule" && (req.PublishAt is null || req.PublishAt <= DateTime.UtcNow))
        {
            formError = "Pick a future date and time to schedule this post.";
            StateHasChanged();
            return;
        }
        formBusy = true;
        StateHasChanged();

        var editing = showEdit && detail is not null;
        HttpResponseMessage res;
        if (editing)
        {
            res = await Auth.SendAsync(new HttpMethod("PATCH"), $"/api/news/{detail!.Id}", new
            {
                title = req.Title,
                body = req.Body,
                type = req.Type,
                publishAt = req.PublishAt,
                clearPublishAt = req.PublishAt is null,
                requiresAcknowledgement = req.RequiresAcknowledgement,
                ackDueAt = req.AckDueAt,
                clearAckDueAt = req.AckDueAt is null,
                isPinned = req.IsPinned,
                targets = req.Targets,
                attachmentIds = req.AttachmentIds ?? []
            });
        }
        else
        {
            res = await Auth.SendAsync(HttpMethod.Post, "/api/news", new
            {
                type = req.Type,
                title = req.Title,
                body = req.Body,
                publishAt = req.Mode == "schedule" ? req.PublishAt : null,
                requiresAcknowledgement = req.RequiresAcknowledgement,
                ackDueAt = req.AckDueAt,
                isPinned = req.IsPinned,
                targets = req.Targets.Count == 0 ? null : req.Targets,
                mode = req.Mode,
                attachmentIds = req.AttachmentIds
            });
        }

        if (!res.IsSuccessStatusCode)
        {
            formError = FriendlyError(await ReadErr(res));
            formBusy = false;
            StateHasChanged();
            return;
        }

        var saved = await res.Content.ReadFromJsonAsync<NewsDetailDto>();
        formBusy = false;
        showCreate = false;
        showEdit = false;
        if (saved is not null)
        {
            detail = saved;
            openDetailId = saved.Id;
            showDetail = true;
            await ReloadAudits();
        }
        await Refresh();
        Toasts.Show(editing ? "Post updated."
            : req.Mode == "publish" ? "Post published."
            : req.Mode == "schedule" ? $"Post scheduled for {req.PublishAt!.Value.ToLocalTime():dd MMM, HH:mm}."
            : "Draft saved.", ToastKind.Success);
    }

    private static string FriendlyError(string code) => code switch
    {
        "forbidden" => "Only the post's author, HR or Admin can edit this post.",
        "schedule_requires_future_time" => "Pick a future date and time to schedule this post.",
        "title_required" => "Post title is required.",
        "body_required" => "Content is required.",
        "title_too_long" => "Title must be 300 characters or fewer.",
        _ => code
    };

    private static async Task<string> ReadErr(HttpResponseMessage r)
    {
        try
        {
            var j = await r.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (j is not null && j.TryGetValue("message", out var m)) return m;
            if (j is not null && j.TryGetValue("code", out var c)) return c;
        }
        catch { }
        return r.StatusCode.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("ipop.newsKeys", _selfRef); } catch (JSException) { }
        }
        await JS.InvokeVoidAsync("ipop.icons");
    }
    public void Dispose()
    {
        Layout.SearchChanged -= OnLayoutSearch;
        _newsSub?.Dispose();
        _liveCts?.Cancel();
        _liveCts?.Dispose();
        _ = JS.InvokeVoidAsync("ipop.mobile.clearDetail").AsTask().ContinueWith(_ => { });
        _ = JS.InvokeVoidAsync("ipop.newsKeysOff").AsTask().ContinueWith(_ => { });
        _selfRef?.Dispose();
    }
}
