@page "/news/new"
@page "/news/{Id:guid}/edit"
@implements IDisposable
@using AppDtos = IPop.Application.News
@using WebDtos = IPop.Web.Models
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject IPop.Web.Services.PeopleLinks PLinks

<PageTitle>@(IsRevision ? "Edit post" : "New post") — News &amp; Memos — IPop</PageTitle>

@* A few composer-page classes the shared news-compose.css does not define (the banner, the live
   strip). Kept local so the stylesheet stays owned by the CSS module. *@
<style>
    .nc-live-strip {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        background: var(--accent-soft); border: 1px solid var(--line-2); color: var(--accent-ink);
        padding: 10px 14px; border-radius: 14px; margin-bottom: 16px; font-size: 12.5px;
    }
    .nc-live-strip.warn { background: var(--warn-soft); color: var(--warn); }
    .nc-live-strip .lucide { width: 15px; height: 15px; }
    .nc-conflict {
        display: flex; align-items: center; gap: 12px; flex-wrap: wrap; flex: none;
        background: var(--danger-soft); color: var(--danger); border-bottom: 1px solid var(--line-2);
        padding: 12px 22px; font-size: 12.5px;
    }
    .nc-conflict .lucide { width: 18px; height: 18px; flex: none; }
    .nc-conflict b { display: block; font-weight: 620; }
    .nc-conflict span { color: var(--danger); opacity: .85; }
    .nc-conflict-actions { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }
</style>

<div class="nc-shell">
    <NavigationLock ConfirmExternalNavigation="@(dirty && !conflict)" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

    <header class="nc-topbar">
        <button type="button" class="nc-back" aria-label="Back to News and Memo" @onclick="BackAsync"><i data-lucide="arrow-left"></i></button>
        <div class="nc-tt">
            <div class="k">News &amp; Memo</div>
            <h1>@(IsRevision ? "Edit post" : "New post")</h1>
        </div>
        <div class="nc-status @StatusClass" role="status" aria-live="polite">
            <i data-lucide="@StatusIcon" class="@(saveState == NewsSaveState.Saving ? "nc-spin" : "")"></i>
            <span>@StatusText</span>
        </div>
        <div class="nc-top-actions">
            <button type="button" class="nc-btn2" aria-pressed="@(previewOpen ? "true" : "false")" @onclick="TogglePreview">
                <i data-lucide="@(previewOpen ? "pencil" : "eye")"></i><span class="nc-lbl-sm">@(previewOpen ? "Editing" : "Preview")</span>
            </button>
            <button type="button" class="nc-btn2 primary" disabled="@(PublishBusy || conflict || loading)" @onclick="PublishAsync">
                <i data-lucide="@(PublishBusy ? "loader-circle" : scheduleOn ? "calendar-clock" : "send")" class="@(PublishBusy ? "nc-spin" : "")"></i>
                <span class="nc-lbl-sm">@PublishLabel</span>
            </button>
        </div>
    </header>

    @if (loadError is not null)
    {
        <div class="nc-conflict" role="alert">
            <i data-lucide="alert-circle"></i>
            <div><b>Could not open the composer</b><span>@loadError</span></div>
            <div class="nc-conflict-actions"><button type="button" class="nc-btn2" @onclick="BackAsync"><i data-lucide="arrow-left"></i>Back to News</button></div>
        </div>
    }
    else if (conflict)
    {
        <div class="nc-conflict" role="alert">
            <i data-lucide="triangle-alert"></i>
            <div>
                <b>@(conflictCopy ? "This draft changed in another tab" : "This post changed since you opened it")</b>
                <span>Your latest edits are not saved. Reload to continue from the newer version, or copy your text out first — nothing was overwritten.</span>
            </div>
            <div class="nc-conflict-actions">
                <button type="button" class="nc-btn2" @onclick="CopyConflictAsync"><i data-lucide="clipboard-copy"></i>Copy my text</button>
                <button type="button" class="nc-btn2 primary" @onclick="ReloadAfterConflictAsync"><i data-lucide="refresh-cw"></i>Reload</button>
            </div>
        </div>
    }

    <main class="nc-main" data-view="@(previewOpen ? "preview" : "edit")">
        <div class="nc-editor-col">
            <div class="nc-editor-inner">
                @if (IsRevision && postStatus == "published")
                {
                    <div class="nc-live-strip">
                        <i data-lucide="circle-check"></i>
                        <span><b>Published</b> — edits save straight to the live post when you press Update.</span>
                    </div>
                }

                <label class="sr" for="nc-title">Post title</label>
                <textarea id="nc-title" class="nc-title" rows="1" maxlength="300" placeholder="Post title"
                          @bind="title" @bind:event="oninput" @bind:after="AfterTitle"
                          @ref="titleRef" disabled="@Locked"></textarea>

                <div class="nc-author-row">
                    <span class="nc-av">@Initials</span>
                    <span>@AuthorName · @(IsRevision ? "editing live post" : "draft")</span>
                </div>

                <div class="nc-cover">
                    <div class="nc-cover-frame" id="nc-cover-drop">
                        @if (CoverUrl is not null)
                        {
                            <img src="@CoverUrl" alt="Post cover" />
                        }
                        else
                        {
                            <div class="nc-cover-empty">
                                <i data-lucide="image"></i>
                                <b>No cover yet</b>
                                <span>Drop an image here, or the first image in the body is used automatically.</span>
                            </div>
                        }
                        @if (CoverUrl is not null || coverMode == "auto")
                        {
                            <span class="nc-cover-chip">
                                <i data-lucide="@(coverMode == "manual" ? "image" : "sparkles")"></i>
                                @(coverMode == "manual" ? "Cover · custom" : "Cover · auto from first image")
                            </span>
                        }
                        <div class="nc-cover-actions">
                            <label class="nc-cover-btn @(coverUploading || conflict ? "is-busy" : "")">
                                <i data-lucide="@(coverUploading ? "loader-circle" : "upload")" class="@(coverUploading ? "nc-spin" : "")"></i>Replace
                                <InputFile OnChange="OnCoverPick" accept="image/png,image/jpeg,image/gif,image/webp" class="sr" disabled="@(coverUploading || Locked)" />
                            </label>
                            <button type="button" class="nc-cover-btn" @onclick="RemoveCover" disabled="@Locked"><i data-lucide="x"></i>Remove</button>
                        </div>
                    </div>
                    <div class="nc-cover-note">
                        <i data-lucide="info"></i>
                        <span>@CoverNoteText</span>
                        @if (coverMode != "auto")
                        {
                            <button type="button" class="nc-linkish" @onclick="UseAutoCover">Use first image again</button>
                        }
                    </div>
                </div>

                @if (!canManage && !IsRevision)
                {
                    <div class="nc-live-strip warn"><i data-lucide="lock"></i><span>Only HR and Admin can publish news and memos.</span></div>
                }

                @* The editor uploads with its own XHR (real progress, streamed — no 100 MB byte[] in wasm).
                   The composer media endpoint takes its kind from the query string, so image and
                   video get separate URLs. No token is passed: the editor fetches a live bearer
                   per upload (and refreshes on 401), so a long session cannot outlive it. *@
                <NewsRichEditor @ref="rte"
                                Value="@body"
                                ValueChanged="OnBodyChanged"
                                UploadUrl="@MediaUploadUrl("image")"
                                VideoUploadUrl="@MediaUploadUrl("video")"
                                MediaUrls="@mediaUrls"
                                Disabled="@Locked"
                                OnMediaUploaded="OnMediaUploaded"
                                UploadProgress="OnRteUploadProgress"
                                OnNotice="OnRteNotice" />

                @if (attachments.Count > 0)
                {
                    <div class="nc-att-list">
                        @foreach (var att in attachments.ToList())
                        {
                            var a = att;
                            <div class="nc-att @(a.Error is not null ? "err" : "")">
                                <span class="nc-att-ic"><i data-lucide="@AttIcon(a.FileName)"></i></span>
                                <div class="nc-att-n">
                                    <b title="@a.FileName">@a.FileName</b>
                                    <span>
                                        @if (a.Error is not null)
                                        {
                                            @a.Error
                                        }
                                        else if (a.IsReady)
                                        {
                                            @(NewsUiHelper.FileSize(a.Size))
                                        }
                                        else
                                        {
                                            @($"uploading {a.Progress}%")
                                        }
                                    </span>
                                    @if (a.Error is null && !a.IsReady)
                                    {
                                        <div class="nc-att-bar"><i style="width:@(a.Progress)%"></i></div>
                                    }
                                </div>
                                <button type="button" class="nc-att-x" aria-label="Remove @a.FileName" @onclick="() => attachments.Remove(a)"><i data-lucide="x"></i></button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <aside class="nc-settings-col" aria-label="Post settings">
            <div class="nc-set">
                <div class="nc-set-head"><i data-lucide="tag"></i>Basics</div>
                <div class="nc-set-body">
                    <div class="nc-frow">
                        <div class="nc-flabel"><i data-lucide="folder-tree"></i>Category <span class="rq">*</span></div>
                        <select class="nc-field" aria-label="Category" @bind="formType" @bind:after="AfterCategory" disabled="@Locked">
                            @foreach (var o in NewsUiHelper.FormTypeOptions)
                            {
                                <option value="@o.Value">@o.Label</option>
                            }
                        </select>
                        <div class="nc-fhint">Shown as the badge on the post card and in the reader.</div>
                    </div>
                    <div class="nc-frow">
                        <div class="nc-flabel"><i data-lucide="users"></i>Audience <span class="rq">*</span></div>
                        @if (formTargets.Count > 0)
                        {
                            <div class="nc-chips" style="margin-bottom:8px">
                                @foreach (var t in formTargets.ToList())
                                {
                                    var target = t;
                                    <button type="button" class="nc-chip" aria-pressed="true" @onclick="() => RemoveTarget(target)" disabled="@Locked">
                                        @TargetLabel(target)<i data-lucide="x"></i>
                                    </button>
                                }
                            </div>
                        }
                        <select class="nc-field" aria-label="Add audience" value="" @onchange="OnAddTargetKind" disabled="@Locked">
                            <option value="">Add audience…</option>
                            @foreach (var o in NewsUiHelper.TargetKindOptions)
                            {
                                <option value="@o.Value">@o.Label</option>
                            }
                        </select>
                        @if (targetKind is "department" or "role")
                        {
                            <div style="display:flex;gap:6px;margin-top:8px">
                                <input class="nc-field" placeholder="@(targetKind == "department" ? "Dept code (e.g. ENG, HRD)" : "Role (e.g. Manager)")"
                                       @bind="targetValue" @bind:event="oninput" disabled="@Locked" />
                                <button type="button" class="nc-btn2" @onclick="AddTypedTarget" disabled="@Locked"><i data-lucide="plus"></i>Add</button>
                            </div>
                        }
                        @if (targetKind == "user")
                        {
                            <div style="margin-top:8px"><AppMemberPicker Placeholder="Select employee…" ValueChanged="OnPickMember" /></div>
                        }
                        <div class="nc-fhint @(formTargets.Count == 0 ? "warn" : "")">@AudienceHint</div>
                    </div>
                </div>
            </div>

            <div class="nc-set">
                <div class="nc-set-head"><i data-lucide="circle-check"></i>Acknowledgement</div>
                <div class="nc-set-body">
                    <div class="nc-frow">
                        <label class="nc-sw">
                            <input type="checkbox" @bind="formRequiresAck" @bind:after="MarkDirty" disabled="@Locked" />
                            <span class="nc-sw-track" aria-hidden="true"></span>
                            <span class="nc-sw-tx"><b>Request acknowledgement</b><span>Readers confirm they have read this post.</span></span>
                        </label>
                    </div>
                    <div class="nc-frow">
                        <div class="nc-flabel"><i data-lucide="calendar-clock"></i>Acknowledge by</div>
                        <AppDateTimePicker @bind-Value="formAckDueAt" @bind-Value:after="MarkDirty" AllowClear="true" Class="nc-field" AriaLabel="Acknowledge by" Disabled="@(!formRequiresAck || conflict)" />
                        <div class="nc-fhint">@(formRequiresAck ? "Shown to readers until the deadline." : "Readers will not be asked to confirm this post.")</div>
                    </div>
                    @if (IsRevision && postStatus == "published")
                    {
                        <div class="nc-frow">
                            <label class="nc-sw">
                                <input type="checkbox" @bind="ackAgain" @bind:after="OnAckAgainChanged" disabled="@Locked" />
                                <span class="nc-sw-track" aria-hidden="true"></span>
                                <span class="nc-sw-tx"><b>Request acknowledgement again</b><span>@(ackAgainHint ?? "Clears the existing acknowledgements and asks everyone to confirm the updated post.")</span></span>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="nc-set">
                <div class="nc-set-head"><i data-lucide="send"></i>Publishing</div>
                <div class="nc-set-body">
                    <div class="nc-frow">
                        <label class="nc-sw">
                            <input type="checkbox" @bind="pinOn" @bind:after="MarkDirty" disabled="@Locked" />
                            <span class="nc-sw-track" aria-hidden="true"></span>
                            <span class="nc-sw-tx"><b>Pin to top</b><span>Stays above newer posts until it is unpinned.</span></span>
                        </label>
                    </div>
                    <div class="nc-frow">
                        <label class="nc-sw">
                            <input type="checkbox" @bind="scheduleOn" @bind:after="AfterSchedule" disabled="@Locked" />
                            <span class="nc-sw-track" aria-hidden="true"></span>
                            <span class="nc-sw-tx"><b>Schedule</b><span>Publish automatically at a set time.</span></span>
                        </label>
                        @if (scheduleOn)
                        {
                            <div style="margin-top:8px">
                                <AppDateTimePicker @bind-Value="publishAt" @bind-Value:after="MarkDirty" AllowClear="false" Class="nc-field" AriaLabel="Publish at" Disabled="@(conflict)" />
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="nc-set">
                <div class="nc-set-head"><i data-lucide="paperclip"></i>Attachments</div>
                <div class="nc-set-body">
                    <div class="nc-frow">
                        <div class="nc-drop" id="nc-file-drop" tabindex="0" role="button" aria-label="Add attachments">
                            <i data-lucide="upload-cloud"></i>
                            <b>Drop files here</b>
                            <label class="pick-box">or <span class="pick">choose files</span>
                                <InputFile OnChange="OnFilesPicked" multiple class="sr"
                                           accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt,.png,.jpg,.jpeg" />
                            </label>
                        </div>
                        <div class="nc-att-foot"><span>@AttachmentFoot</span></div>
                        <div class="nc-fhint">Up to 10 files, 25 MB each. Inline images max 5 MB · one inline video, max 100 MB.</div>
                    </div>
                </div>
            </div>

            <div class="nc-side-actions">
                <button type="button" class="nc-btn2 primary" disabled="@(PublishBusy || conflict || loading)" @onclick="PublishAsync">
                    <i data-lucide="@(PublishBusy ? "loader-circle" : scheduleOn ? "calendar-clock" : "send")" class="@(PublishBusy ? "nc-spin" : "")"></i>
                    <span>@PublishLabel</span>
                </button>
                <button type="button" class="nc-btn2" aria-pressed="@(previewOpen ? "true" : "false")" @onclick="TogglePreview"><i data-lucide="eye"></i>Preview as reader</button>
            </div>
        </aside>

        <section class="nc-preview" aria-label="Reader preview">
            <div class="nc-pv-bar">
                <div class="t"><i data-lucide="eye"></i>Preview <span class="hint">@(device == NewsPreviewDevice.Mobile ? "Mobile · 390 px" : "Desktop · 980 px")</span></div>
                <div class="right">
                    <div class="nc-seg" role="group" aria-label="Preview width">
                        <button type="button" aria-pressed="@(device == NewsPreviewDevice.Desktop ? "true" : "false")" @onclick="() => device = NewsPreviewDevice.Desktop"><i data-lucide="monitor"></i>Desktop</button>
                        <button type="button" aria-pressed="@(device == NewsPreviewDevice.Mobile ? "true" : "false")" @onclick="() => device = NewsPreviewDevice.Mobile"><i data-lucide="smartphone"></i>Mobile</button>
                    </div>
                    <button type="button" class="nc-btn2" disabled="@PublishBusy" @onclick="TogglePreview"><i data-lucide="pencil"></i>Back to editing</button>
                </div>
            </div>
            <div class="nc-pv-stage">
                <article class="nc-pv-frame @(device == NewsPreviewDevice.Mobile ? "mobile" : "")">
                    <div class="nc-pv-screen">
                        @if (CoverUrl is not null)
                        {
                            <img class="nc-pv-hero" src="@CoverUrl" alt="Post cover" />
                        }
                        else
                        {
                            <div class="nc-pv-hero empty">No cover image</div>
                        }
                        <div class="nc-pv-inner">
                            <span class="nc-pv-cat"><i data-lucide="@NewsUiHelper.GetCategoryIcon(formType)"></i>@NewsUiHelper.GetCategoryLabel(formType)</span>
                            <h1 class="nc-pv-title">@(string.IsNullOrWhiteSpace(title) ? "Untitled post" : title)</h1>
                            <div class="nc-pv-by">
                                <span class="nc-av">@Initials</span>
                                <span>@AuthorName</span>
                                @if (pinOn) { <span class="pill">Pinned</span> }
                            </div>
                            @if (previewError is not null)
                            {
                                <div class="nc-pv-empty" role="alert"><i data-lucide="alert-circle"></i> @previewError</div>
                            }
                            else if (previewHtml is not null)
                            {
                                <NewsBody Html="@previewHtml" BodyFormat="html" DraftId="@draftId" MediaUrls="@mediaUrls" />
                            }
                            else
                            {
                                <div class="nc-pv-empty">Loading the sanitized preview…</div>
                            }
                            <div class="nc-pv-meta">
                                <div class="r">
                                    <i data-lucide="users"></i><b>Audience</b>
                                    @if (formTargets.Count == 0)
                                    {
                                        <span class="pill">All employees</span>
                                    }
                                    else
                                    {
                                        @foreach (var t in formTargets) { <span class="pill">@TargetLabel(t)</span> }
                                    }
                                </div>
                                <div class="r"><i data-lucide="tag"></i><b>Category</b><span class="pill">@NewsUiHelper.GetCategoryLabel(formType)</span></div>
                                @if (formRequiresAck)
                                {
                                    <div class="r"><i data-lucide="calendar-clock"></i><b>Acknowledge by</b><span class="pill">@(formAckDueAt is { } due ? due.ToString("dd MMM yyyy HH:mm") : "not set")</span></div>
                                }
                            </div>
                            @if (formRequiresAck)
                            {
                                <div class="nc-pv-ack">
                                    <i data-lucide="shield-check"></i>
                                    <div><b>Acknowledgement requested</b><br /><span>@(formAckDueAt is { } d2 ? $"Acknowledge by {d2:dd MMM yyyy HH:mm}" : "No deadline set")</span></div>
                                </div>
                            }
                        </div>
                    </div>
                </article>
            </div>
        </section>
    </main>
</div>

@code {
    /// Set on /news/{Id:guid}/edit: the live post this composer revises.
    [Parameter] public Guid? Id { get; set; }

    private const int MaxFiles = 10;
    private const long MaxFileBytes = 25L * 1024 * 1024;
    private const long MaxInlineImageBytes = 5L * 1024 * 1024;
    private const long MaxInlineVideoBytes = 100L * 1024 * 1024;
    private static readonly HashSet<string> ImageExts = [".png", ".jpg", ".jpeg", ".gif", ".webp"];

    // ── Draft identity + form ────────────────────────────────────────────────────
    private Guid? draftId;
    private int baseVersion;
    private int? baseContentVersion;
    private bool IsRevision => Id is not null;
    private bool loading = true;
    private string? loadError;

    private string title = "";
    private string body = "";
    private string formType = "news";
    private bool formRequiresAck;
    private DateTime? formAckDueAt;
    private bool pinOn;
    private bool scheduleOn;
    private DateTime? publishAt;
    private string coverMode = "auto";
    private Guid? coverMediaId;
    private readonly List<NewsComposerAttachment> attachments = [];
    private readonly List<AppDtos.NewsTargetInput> formTargets = [];
    private string targetKind = "";
    private string targetValue = "";
    private readonly Dictionary<string, string> userNames = new(StringComparer.OrdinalIgnoreCase);
    private bool ackAgain;
    private string? ackAgainHint;
    private string? postStatus;

    // ── Autosave ─────────────────────────────────────────────────────────────────
    private NewsSaveState saveState = NewsSaveState.Idle;
    private DateTime? lastSavedAt;
    private bool conflict;
    private bool conflictCopy;
    private bool dirty;
    private bool inflight;
    private bool disposed;
    private string? saveError;
    private int generation;
    /// One-shot: the author already approved leaving (Back, or the nav prompt), so the next
    /// LocationChanging must pass without asking a second time.
    private bool navigationApproved;
    /// Bumped on every user edit (and on a conflict reload). A save only clears `dirty` when this is
    /// unchanged from what it captured — so an edit made mid-save is never marked saved by the older response.
    private int editSeq;
    private readonly SemaphoreSlim saveGate = new(1, 1);
    private System.Threading.Timer? debounce;

    // ── Capability + UI ──────────────────────────────────────────────────────────
    private bool canManage;
    private bool previewOpen;
    private NewsPreviewDevice device = NewsPreviewDevice.Desktop;
    private bool PublishBusy;
    private bool coverUploading;
    private string? previewHtml;
    private string? previewError;

    /// All form editing is frozen while a conflict is unresolved or a publish is in flight.
    private bool Locked => conflict || PublishBusy;

    // ── Media ────────────────────────────────────────────────────────────────────
    private readonly Dictionary<Guid, string> mediaUrls = [];
    private readonly Dictionary<Guid, NewsComposerMediaRef> mediaRefs = [];

    private ElementReference titleRef;
    private NewsRichEditor? rte;
    private int uploadsInFlight;
    private DotNetObjectReference<NewsCompose>? selfRef;
    private IJSObjectReference? guardModule;
    private bool dropsInstalled;
    private CancellationTokenSource? lifetimeCts;

    private const string AttachAccept = ".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.csv,.txt,.png,.jpg,.jpeg";

    /// A file handed over by the JS drop/pick bridge (Blazor's DragEventArgs carries names only).
    public sealed record DroppedFile(string Name, string ContentType, byte[] Data);

    private string AuthorName => Auth.Me?.Name ?? "You";
    private string Initials => string.Concat(AuthorName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0]).Take(2)).ToUpperInvariant();

    // ─────────────────────────────────────────────────────────────────────────────
    // Lifecycle
    // ─────────────────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        lifetimeCts = new CancellationTokenSource();
        try { await JS.InvokeVoidAsync("ipop.newsEditor.ensureStyle"); } catch { }
        await LoadAsync();
    }

    /// NavigationLock handles in-app navigation; the module below covers closing/reloading the tab
    /// and the drag-and-drop / keyboard file pickers (Blazor's DragEventArgs carries file names only).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            guardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/news-compose.js?v=20261002-compose");
            if (firstRender) await guardModule.InvokeVoidAsync("install");
            await guardModule.InvokeVoidAsync("setDirty", HasUnsavedChanges());
            if (!dropsInstalled && !loading)
            {
                dropsInstalled = true;
                selfRef ??= DotNetObjectReference.Create(this);
                await guardModule.InvokeVoidAsync("installDrop", selfRef, "nc-cover-drop", false, "image/png,image/jpeg,image/gif,image/webp");
                await guardModule.InvokeVoidAsync("installDrop", selfRef, "nc-file-drop", true, AttachAccept);
            }
        }
        catch { /* bfcache / disposed runtime — the guard is best-effort */ }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    // ── Files handed over by JS (drag/drop and the keyboard picker) ──────────────

    [JSInvokable]
    public async Task OnDroppedCover(List<DroppedFile> files)
    {
        if (files is not { Count: > 0 } || draftId is not { } id) return;
        var f = files[0];
        if (f?.Data is null) return;
        await UploadCoverBytesAsync(id, f.Name, f.ContentType, f.Data);
    }

    [JSInvokable]
    public async Task OnDroppedFile(List<DroppedFile> files)
    {
        if (files is null || files.Count == 0 || draftId is not { } id) return;
        await AddFileBytesAsync(id, files);
    }

    /// The keyboard path on the drop zone: "choose files" without an InputFile ref.
    [JSInvokable]
    public async Task OnPickFiles()
    {
        if (guardModule is not null) await guardModule.InvokeVoidAsync("pickFiles", selfRef, AttachAccept);
