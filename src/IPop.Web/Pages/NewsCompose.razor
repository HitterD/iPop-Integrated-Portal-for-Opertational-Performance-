    private async Task LoadAsync()
    {
        loading = true;
        loadError = null;
        try
        {
            canManage = (await Auth.GetAsync<NewsCountsDto>("/api/news/counts"))?.CanManage ?? false;

            var query = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
            var cat = query["category"];
            if (!string.IsNullOrEmpty(cat)) formType = cat!;

            if (Guid.TryParse(query["draft"], out var resumeId))
            {
                await ResumeDraftAsync(resumeId);
            }
            else if (Id is { } postId)
            {
                var list = await Auth.GetAsync<AppDtos.NewsDraftListDto>("/api/news/composer/drafts");
                var existing = list?.Items.FirstOrDefault(i => i.PostId == postId);
                if (existing is not null) await ResumeDraftAsync(existing.Id);
                else await CreateDraftAsync(postId);
            }
            else
            {
                await CreateDraftAsync(null);
            }
            if (loadError is null)
            {
                SetClean();
                // Resolve display URLs for media the body already references (a resumed draft or a
                // revision seeded from the live post): the body stores ids, never URLs.
                _ = ResolveMissingAsync(BodyMediaIds().ToList());
        _ = ResolveMissingAsync(mediaRefs.Keys.ToList());
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CreateDraftAsync(Guid? postId)
    {
        var res = await Auth.SendAsync(HttpMethod.Post, "/api/news/composer/drafts", new AppDtos.CreateNewsDraftRequest(postId));
        var result = await SafeReadAsync<AppDtos.NewsDraftResultDto>(res);
        if (result is not { Success: true, Draft: not null }) { loadError = DraftError(result?.Error); return; }
        ApplyDraft(result.Draft);
        if (result.Draft.PostId is { } pid) await LoadPostContextAsync(pid);
    }

    private async Task ResumeDraftAsync(Guid resumeId)
    {
        var res = await Auth.SendAsync(HttpMethod.Get, $"/api/news/composer/drafts/{resumeId}");
        var result = await SafeReadAsync<AppDtos.NewsDraftResultDto>(res);
        if (result is not { Success: true, Draft: not null }) { loadError = DraftError(result?.Error); return; }
        if (Id is { } postId && result.Draft.PostId != postId) { loadError = "That draft belongs to a different post."; return; }
        ApplyDraft(result.Draft);
        if (result.Draft.PostId is { } pid) await LoadPostContextAsync(pid);
    }

    private async Task LoadPostContextAsync(Guid postId)
    {
        var d = await Auth.GetAsync<NewsDetailDto>($"/api/news/{postId}");
        postStatus = d?.Status;
        if (d?.AckCount is > 0)
            ackAgainHint = $"Clears the {(d.AckCount == 1 ? "existing acknowledgement" : $"{d.AckCount} existing acknowledgements")} and asks everyone to confirm the updated post.";
    }

    private void ApplyDraft(AppDtos.NewsDraftDto d)
    {
        draftId = d.Id;
        baseVersion = d.Version;
        baseContentVersion = d.BaseContentVersion;

        var s = d.Snapshot;
        title = s.Title ?? "";
        body = s.Body ?? "";
        if (!string.IsNullOrEmpty(s.Type)) formType = s.Type!;
        formRequiresAck = s.RequiresAcknowledgement;
        formAckDueAt = s.AckDueAt?.ToLocalTime();
        pinOn = s.IsPinned;
        scheduleOn = s.PublishAt is not null;
        publishAt = s.PublishAt?.ToLocalTime();
        coverMode = string.IsNullOrEmpty(s.CoverMode) ? "auto" : s.CoverMode;
        coverMediaId = s.CoverMediaId;
        attachments.Clear();
        // Only ids survive a reload: names/sizes are not part of the snapshot.
        foreach (var a in s.AttachmentIds ?? []) attachments.Add(new NewsComposerAttachment(a, "Attachment", "application/octet-stream", 0));
        formTargets.Clear();
        formTargets.AddRange(s.Targets ?? []);
    }

    private void SetClean()
    {
        dirty = false;
        saveState = NewsSaveState.Saved;
        lastSavedAt = DateTime.Now;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Edit handlers → dirty + debounce
    // ─────────────────────────────────────────────────────────────────────────────

    private Task MarkDirty()
    {
        // While a publish is in flight the promoted snapshot must not drift: controls are disabled,
        // and any stray change event is ignored rather than queued behind the promote call.
        if (disposed || conflict || PublishBusy) return Task.CompletedTask;
        dirty = true;
        editSeq++;
        saveState = NewsSaveState.Dirty;
        RestartDebounce();
        return Task.CompletedTask;
    }

    private void RestartDebounce()
    {
        debounce?.Dispose();
        debounce = new System.Threading.Timer(_ => _ = InvokeAsync(SaveAsync), null, 1500, Timeout.Infinite);
    }

    private async Task AfterTitle()
    {
        try { await JS.InvokeVoidAsync("ipop.measure", titleRef); } catch { }
        await MarkDirty();
    }

    /// Clearing acknowledgements is destructive and the checkbox sits next to a Publish button, so a
    /// deliberate confirm stands between the toggle and the reset.
    private async Task OnAckAgainChanged()
    {
        if (!ackAgain)
        {
            _ = MarkDirty();
            return;
        }
        var ok = await Confirm.AskAsync(
            "Request acknowledgement again?",
            "This clears every existing acknowledgement on the published post and asks the audience to confirm the updated version. It cannot be undone.",
            "Yes, request again");
        if (!ok) ackAgain = false;
        _ = MarkDirty();
    }

