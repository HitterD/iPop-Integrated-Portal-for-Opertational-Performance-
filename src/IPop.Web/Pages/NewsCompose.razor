    private string? CoverUrl
    {
        get
        {
            if (coverMode == "none") return null;
            if (coverMode == "manual" && coverMediaId is { } manual && mediaUrls.TryGetValue(manual, out var u)) return u;
            foreach (var mid in BodyMediaIds("image"))
                if (mediaUrls.TryGetValue(mid, out var url)) return url;
            return null;
        }
    }

    private string CoverNoteText => coverMode switch
    {
        "manual" => "Custom cover image. The body image is ignored.",
        "none" => "No cover — this post shows as a text card in the feed.",
        _ => "Cover follows the first image in the body."
    };

    private IEnumerable<Guid> BodyMediaIds(string? kind = null)
    {
        var html = body ?? "";
        var pattern = kind is null
            ? "data-news-media=\"([0-9a-fA-F-]{36})\""
            : $"data-news-media=\"([0-9a-fA-F-]{{36}})\"[^>]*data-news-kind=\"{kind}\"|data-news-kind=\"{kind}\"[^>]*data-news-media=\"([0-9a-fA-F-]{{36}})\"";
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(html, pattern))
        {
            var raw = m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value;
            if (Guid.TryParse(raw, out var g)) yield return g;
        }
    }

    private void RemoveCover()
    {
        coverMode = "none";
        coverMediaId = null;
        _ = MarkDirty();
        Toasts.Show("Cover removed. The post will show as a text card.", ToastKind.Info);
    }

    private void UseAutoCover()
    {
        coverMode = "auto";
        coverMediaId = null;
        _ = MarkDirty();
    }

    private async Task OnCoverPick(InputFileChangeEventArgs e)
    {
        if (e.File is not { } file) return;
        // Guard on Size BEFORE OpenReadStream: a stream opened with a max throws once the file
        // exceeds it, and that throw would surface as a raw exception instead of a message.
        if (file.Size > MaxInlineImageBytes)
        {
            Toasts.Show($"{file.Name} is larger than the 5 MB image limit.", ToastKind.Warning);
            return;
        }
        if (draftId is not { } id) return;
        using var ms = new MemoryStream();
        await using (var src = file.OpenReadStream(MaxInlineImageBytes, lifetimeCts?.Token ?? default))
            await src.CopyToAsync(ms, lifetimeCts?.Token ?? default);
        await UploadCoverBytesAsync(id, file.Name, file.ContentType, ms.ToArray());
    }

    private async Task UploadCoverBytesAsync(Guid id, string name, string? contentType, byte[] data)
    {
        if (!ImageExts.Contains(Path.GetExtension(name.ToLowerInvariant())))
        {
            Toasts.Show("Only PNG, JPEG, GIF or WebP images can be a cover.", ToastKind.Warning);
            return;
        }
        if (data.LongLength > MaxInlineImageBytes)
        {
            Toasts.Show($"{name} is larger than the 5 MB image limit.", ToastKind.Warning);
            return;
        }

        coverUploading = true;
        try
        {
            var dto = await PostMediaAsync(id, name, contentType, data, "image");
            if (dto is null) return;
            coverMediaId = dto.MediaId;
            coverMode = "manual";
            _ = MarkDirty();
            Toasts.Show($"Cover set: {name}", ToastKind.Success);
        }
        finally
        {
            coverUploading = false;
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    private void SyncMediaFromBody()
    {
        var ids = new HashSet<Guid>(BodyMediaIds());
        foreach (var gone in mediaRefs.Keys.Where(k => !ids.Contains(k) && k != coverMediaId).ToList())
        {
            mediaRefs.Remove(gone);
            mediaUrls.Remove(gone);
        }
        _ = ResolveMissingAsync(ids);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Uploads
    // ─────────────────────────────────────────────────────────────────────────────

    /// Multipart POST of one file's bytes to the composer media endpoint.
    private async Task<AppDtos.NewsComposerMediaDto?> PostMediaAsync(Guid id, string fileName, string? contentType, byte[] data, string kind)
    {
        uploadsInFlight++;
        try
        {
            using var content = new MultipartFormDataContent();
            var bc = new ByteArrayContent(data);
            bc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrEmpty(contentType) ? "application/octet-stream" : contentType);
            content.Add(bc, "file", fileName);

            var res = await Auth.SendMultipartAsync($"/api/news/composer/drafts/{id}/media?kind={kind}", content);
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show(MediaError(res.StatusCode, fileName), ToastKind.Error);
                return null;
            }
            var dto = await SafeReadAsync<AppDtos.NewsComposerMediaDto>(res);
            if (dto is null || dto.MediaId == Guid.Empty)
            {
                Toasts.Show($"The server did not confirm the upload of {fileName}.", ToastKind.Error);
                return null;
            }
            TrackMedia(dto);
            return dto;
        }
        finally
        {
            uploadsInFlight--;
        }
    }

    private void TrackMedia(AppDtos.NewsComposerMediaDto dto)
    {
        if (!string.IsNullOrEmpty(dto.StreamUrl)) mediaUrls[dto.MediaId] = dto.StreamUrl!;
        mediaRefs[dto.MediaId] = new NewsComposerMediaRef(dto.MediaId, dto.Kind, dto.StreamUrl, dto.FileName, dto.Size);
    }

    /// Absolute URL the editor's XHR posts one file to. The kind is in the query string because the
/// media endpoint reads it from there. Relative to the API origin, not the page origin.
    private string? MediaUploadUrl(string kind)
        => draftId is { } id ? $"{Http.BaseAddress}api/news/composer/drafts/{id}/media?kind={kind}" : null;

    /// The editor finished an upload itself (its XHR path). Record the id/URL and mark the draft
    /// dirty so the ref is autosaved. No bytes ever cross into C# on this path.
    private Task OnMediaUploaded(NewsRichEditor.NewsMediaRef media)
    {
        if (media is null || media.MediaId == Guid.Empty) return Task.CompletedTask;
        if (!string.IsNullOrEmpty(media.Url)) mediaUrls[media.MediaId] = media.Url!;
        mediaRefs[media.MediaId] = new NewsComposerMediaRef(media.MediaId, media.Kind, media.Url, media.Name, 0);
        _ = MarkDirty();
        return Task.CompletedTask;
    }

    /// The editor's XHR reports each inline upload's progress. Held so save/publish can wait for it
/// (a save mid-upload would drop the media ref the editor is about to insert).
    private readonly HashSet<string> rteUploadsInFlight = [];

    private Task OnRteUploadProgress(NewsRichEditor.NewsUploadProgress p)
    {
        if (p is null) return Task.CompletedTask;
        var key = p.Kind + ":" + p.Name;
        if (p.State == "uploading") rteUploadsInFlight.Add(key);
        else rteUploadsInFlight.Remove(key);
        return Task.CompletedTask;
    }

    private void OnRteNotice(string message)
    {
        if (!string.IsNullOrWhiteSpace(message)) Toasts.Show(message, ToastKind.Warning);
    }

    private static string MediaError(System.Net.HttpStatusCode status, string name) => status switch
    {
        System.Net.HttpStatusCode.RequestEntityTooLarge => $"{name}: the file is too large for this post.",
        System.Net.HttpStatusCode.Conflict => $"{name}: only one video per post is allowed, or storage is unavailable.",
        System.Net.HttpStatusCode.Forbidden => "You cannot attach media to this post.",
        System.Net.HttpStatusCode.UnprocessableEntity => $"{name}: that file type isn't allowed.",
        System.Net.HttpStatusCode.NotFound => "This draft no longer exists.",
        _ => $"Could not upload {name}."
    };

    private async Task ResolveMissingAsync(IEnumerable<Guid> ids)
    {
        if (draftId is not { } id) return;
        var missing = ids.Where(i => !mediaUrls.ContainsKey(i)).ToList();
        if (missing.Count == 0) return;
        var list = await Auth.GetAsync<List<AppDtos.NewsComposerMediaDto>>($"/api/news/composer/drafts/{id}/media");
        if (list is null) return;
        foreach (var m in list) TrackMedia(m);
        if (rte is not null) await rte.SetMediaAsync(mediaUrls);
        await InvokeAsync(StateHasChanged);
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Regular attachments
    // ─────────────────────────────────────────────────────────────────────────────

    private string AttachmentFoot
    {
        get
        {
            var ready = attachments.Where(a => a.IsReady).ToList();
            return ready.Count == 0
                ? $"No files yet · up to {MaxFiles} files"
                : $"{ready.Count} of {MaxFiles} files · {NewsUiHelper.FileSize(ready.Sum(a => a.Size))}";
        }
    }

    private async Task OnFilesPicked(InputFileChangeEventArgs e)
    {
        if (draftId is not { } id) { Toasts.Show("The draft is not ready yet.", ToastKind.Error); return; }
        var rows = new List<DroppedFile>();
        foreach (var file in e.GetMultipleFiles(MaxFiles))
        {
            if (file.Size > MaxFileBytes)
            {
                Toasts.Show($"{file.Name} is larger than the 25 MB attachment limit.", ToastKind.Warning);
                continue;
            }
            using var ms = new MemoryStream();
            await using (var src = file.OpenReadStream(MaxFileBytes, lifetimeCts?.Token ?? default))
                await src.CopyToAsync(ms, lifetimeCts?.Token ?? default);
            rows.Add(new DroppedFile(file.Name,
                string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType, ms.ToArray()));
        }
        await AddFileBytesAsync(id, rows);
    }

    private async Task AddFileBytesAsync(Guid id, IReadOnlyList<DroppedFile> files)
    {
        var changed = false;
        foreach (var file in files)
        {
            if (attachments.Count(a => a.IsReady) >= MaxFiles)
            {
                Toasts.Show($"{file.Name}: up to {MaxFiles} attachments per post.", ToastKind.Warning);
                continue;
            }
            if (file.Data.LongLength > MaxFileBytes)
            {
                Toasts.Show($"{file.Name} is larger than the 25 MB attachment limit.", ToastKind.Warning);
                continue;
            }
            var row = new NewsComposerAttachment(null, file.Name, file.ContentType, file.Data.LongLength, 0);
            attachments.Add(row);
            StateHasChanged();
            try
            {
                using var content = new MultipartFormDataContent();
                var bc = new ByteArrayContent(file.Data);
                bc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(row.ContentType);
                content.Add(bc, "file", file.Name);
                var url = Id is { } pid ? $"/api/news/attachments?postId={pid}" : "/api/news/attachments";
                var res = await Auth.SendMultipartAsync(url, content);
                var index = attachments.IndexOf(row);
                if (index < 0) continue;
                if (!res.IsSuccessStatusCode)
                    attachments[index] = row with { Error = AttachmentError(res.StatusCode) };
                else if (await SafeReadAsync<NewsAttachmentDto>(res) is { } dto)
                    attachments[index] = new NewsComposerAttachment(dto.Id, dto.FileName, dto.ContentType, dto.Size);
            }
            catch (Exception ex)
            {
                var index = attachments.IndexOf(row);
                if (index >= 0) attachments[index] = row with { Error = ex.Message };
            }
            changed = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        if (changed) await MarkDirty();
    }

    private static string AttachmentError(System.Net.HttpStatusCode status) => status switch
    {
        System.Net.HttpStatusCode.UnprocessableEntity => "This file type isn't allowed.",
        System.Net.HttpStatusCode.Forbidden => "Only the post's author, HR or Admin can attach files.",
        System.Net.HttpStatusCode.BadGateway => "File storage is unavailable right now.",
        _ => "Upload failed."
    };

    private static string AttIcon(string name) => NewsUiHelper.FileIcon(name);

    // ─────────────────────────────────────────────────────────────────────────────
    // Autosave
    // ─────────────────────────────────────────────────────────────────────────────

    private AppDtos.NewsDraftSnapshotDto BuildSnapshot()
    {
        var refs = new List<AppDtos.NewsDraftMediaRefDto>();
        var order = 0;
        foreach (var id in BodyMediaIds()) refs.Add(new AppDtos.NewsDraftMediaRefDto(id, "inline", order++));
        foreach (var kv in mediaRefs)
            if (refs.All(r => r.MediaId != kv.Key))
                refs.Add(new AppDtos.NewsDraftMediaRefDto(kv.Key, "inline", order++));

        return new AppDtos.NewsDraftSnapshotDto(
            Type: string.IsNullOrEmpty(formType) ? "news" : formType,
            Title: title,
            Body: body,
            BodyFormat: "html",
            RequiresAcknowledgement: formRequiresAck,
            AckDueAt: formRequiresAck ? formAckDueAt?.ToUniversalTime() : null,
            IsPinned: pinOn,
            PublishAt: scheduleOn ? publishAt?.ToUniversalTime() : null,
            CoverMediaId: coverMode == "manual" ? coverMediaId : null,
            CoverMode: coverMode,
            Targets: formTargets.ToList(),
            AttachmentIds: attachments.Where(a => a.IsReady).Select(a => a.Id!.Value).ToList(),
            Media: refs);
    }

    /// Debounced, serialized, generation-checked autosave. A response may only clear `dirty` when no
    /// newer edit happened while it was in flight — an edit made mid-save is never marked saved.
    private async Task SaveAsync()
    {
        if (disposed || conflict || loading || draftId is not { } id) return;
        await saveGate.WaitAsync();
        try
        {
            if (disposed || conflict || !dirty) return;
            // Never snapshot while an upload is still resolving: an id that lands after this save
            // would be dropped from the refs and the next save would then hit media_ref_mismatch.
            if (attachments.Any(a => !a.IsReady && a.Error is null) || uploadsInFlight > 0 || rteUploadsInFlight.Count > 0) return;
            var gen = editSeq;
            var conflictsBefore = generation;
            inflight = true;
            saveState = NewsSaveState.Saving;
            saveError = null;
            await InvokeAsync(StateHasChanged);

            var req = new AppDtos.SaveNewsDraftRequest(baseVersion, BuildSnapshot(), baseContentVersion);
            var res = await Auth.SendAsync(HttpMethod.Put, $"/api/news/composer/drafts/{id}", req);
            var result = await SafeReadAsync<AppDtos.NewsDraftResultDto>(res);

            if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                EnterConflict(result?.Error);
            }
            else if (result is { Success: true, Draft: not null })
            {
                baseVersion = result.Draft.Version;
                baseContentVersion = result.Draft.BaseContentVersion;
                if (gen == editSeq && conflictsBefore == generation) { dirty = false; saveState = NewsSaveState.Saved; lastSavedAt = DateTime.Now; }
                else saveState = NewsSaveState.Dirty;
            }
            else
            {
                saveError = DraftError(result?.Error);
                saveState = NewsSaveState.Failed;
            }
        }
        catch (Exception ex)
        {
            saveError = ex.Message;
            saveState = NewsSaveState.Failed;
        }
        finally
        {
            inflight = false;
            saveGate.Release();
            await InvokeAsync(StateHasChanged);
            // The debounce may have fired while this save was queued, or while an upload blocked it.
            // Re-arm whenever work is still pending so a save is never silently dropped.
            if (!disposed && !conflict && dirty) RestartDebounce();
        }
    }

    /// Waits until every attachment and media upload has resolved, so a save/publish never snapshots
    /// a body whose media ids are still in flight (that would drop refs and hit media_ref_mismatch).
    private async Task<bool> WaitForUploadsAsync(int timeoutMs = 180000)
    {
        var deadline = Environment.TickCount64 + timeoutMs;
        while (!disposed && (uploadsInFlight > 0 || attachments.Any(a => !a.IsReady && a.Error is null) || rteUploadsInFlight.Count > 0))
        {
            if (Environment.TickCount64 > deadline) return false;
            await Task.Delay(150, lifetimeCts?.Token ?? default);
        }
        return !disposed;
    }

    private void EnterConflict(string? code)
    {
        conflict = true;
        conflictCopy = code == "version_conflict";
        saveState = NewsSaveState.Conflict;
        Toasts.Show("Autosave stopped: this draft changed elsewhere. Reload or copy your work — nothing was overwritten.", ToastKind.Error);
    }

    /// Internal navigation away from dirty/in-flight/failed work: ask via ConfirmService first.
    /// A one-shot approval flag lets the approved navigation pass without re-entering this guard.
    private async Task OnBeforeInternalNavigation(LocationChangingContext ctx)
    {
        if (disposed) return;
        if (navigationApproved) { navigationApproved = false; return; }
        // Freeze navigation while a publish is in flight: leaving mid-promote would drop the result
        // (and the toast) and could navigate away from a post that just went live.
        if (PublishBusy) { ctx.PreventNavigation(); return; }
        if (!dirty && !inflight && saveState != NewsSaveState.Failed) return;
        ctx.PreventNavigation();
        var ok = await Confirm.AskAsync("Leave without saving?",
            dirty || inflight
                ? "Your latest changes are still saving or unsaved. Leaving now keeps the last saved version only."
                : "The last autosave failed. Leaving now keeps the last saved version only.",
            "Leave", danger: true);
        if (!ok) return;
        dirty = false;
        editSeq++;
        generation++;              // invalidate any in-flight save so its result cannot clear the flag
        navigationApproved = true;
        Nav.NavigateTo(ctx.TargetLocation);
    }

    /// The browser tab-close guard asks this before letting the page unload. A conflict counts as
    /// unsaved work: the newer version must not be lost silently by closing the tab. A publish in
    /// flight likewise blocks the unload (its result is still coming).
    public bool HasUnsavedChanges() => !disposed && (dirty || inflight || conflict || PublishBusy);

    private async Task BackAsync()
    {
        if (PublishBusy) { Toasts.Show("Finishing the publish — one moment.", ToastKind.Info); return; }
        if ((dirty || inflight || conflict))
        {
            var ok = await Confirm.AskAsync("Leave without saving?", "Your latest changes are still saving or unsaved.", "Leave", danger: true);
            if (!ok) return;
            dirty = false;
            editSeq++;
            generation++;
        }
        navigationApproved = true;
        Nav.NavigateTo("/news");
    }

    private async Task ReloadAfterConflictAsync()
    {
        conflict = false;
        dirty = false;
        generation++;
        if (draftId is { } id) await ResumeDraftAsync(id);
        else await LoadAsync();
        if (loadError is null)
        {
            SetClean();
            Toasts.Show("Reloaded the newer version.", ToastKind.Info);
        }
        StateHasChanged();
    }

    private async Task CopyConflictAsync()
    {
        var text = title + "\n\n" + (rte is null ? body : await rte.GetHtmlAsync());
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toasts.Show("Copied your title and body to the clipboard.", ToastKind.Success);
        }
        catch
        {
            Toasts.Show("Could not copy automatically — select and copy your text manually.", ToastKind.Warning);
        }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Preview
    // ─────────────────────────────────────────────────────────────────────────────

    private void TogglePreview()
    {
        if (PublishBusy) return;
        previewOpen = !previewOpen;
        if (previewOpen) _ = RefreshPreviewAsync();
    }

    private void RefreshPreviewIfOpen() { if (previewOpen) _ = RefreshPreviewAsync(); }

    /// Preview runs the same sanitizer the reader will: flush the editor, save, then read the
    /// sanitized HTML back from the server, so what the author sees is what a reader gets.
    private async Task RefreshPreviewAsync()
    {
        if (draftId is not { } id) return;
        previewError = null;
        if (!await FlushAndSaveAsync())
        {
            // Never show a stale body as if it were the current one.
            previewError = saveState == NewsSaveState.Conflict
                ? "Resolve the conflict, then reload to preview the newer version."
                : "Your latest changes could not be saved, so the preview would be out of date.";
            previewHtml = null;
            await InvokeAsync(StateHasChanged);
            return;
        }
        var preview = await Auth.GetAsync<AppDtos.NewsPreviewDto>($"/api/news/composer/drafts/{id}/preview");
        if (preview is null)
        {
            previewError = "Could not load the preview.";
            previewHtml = null;
        }
        else
        {
            previewHtml = preview.Html;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// Flushes the editor and saves. Returns false when the draft is not in a state that could be
    /// promoted/previewed safely: a conflict, a failed save, or an edit that arrived mid-save.
    private async Task<bool> FlushAndSaveAsync()
    {
        try
        {
            if (rte is not null)
            {
                var html = await rte.GetHtmlAsync();
                if (!string.IsNullOrEmpty(html) && html != body) body = html;
            }
        }
        catch { }
        if (conflict) return false;
        if (draftId is null) return true;
        if (!dirty && saveState is NewsSaveState.Saved or NewsSaveState.Idle) return true;
        await SaveAsync();
        return !conflict && !dirty && saveState != NewsSaveState.Failed;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Publish / update / schedule (real endpoint — no fake success)
    // ─────────────────────────────────────────────────────────────────────────────

    private string PublishLabel => scheduleOn ? "Schedule" : IsRevision && postStatus == "published" ? "Update published" : "Publish post";

    private async Task PublishAsync()
    {
        if (draftId is not { } id || PublishBusy || conflict) return;

        // Take the lock BEFORE any await: the form freezes now, so the snapshot the promote call
        // reads cannot drift and a double-click cannot start a second publish.
        PublishBusy = true;
        try
        {
            // Every attachment and inline media upload must have resolved before promoting, or the
            // published post would reference ids the snapshot dropped.
            if (!await WaitForUploadsAsync())
            {
                Toasts.Show("Still uploading — try again once the uploads finish.", ToastKind.Warning);
                return;
            }

            // Flush the editor and land one last save so the promoted version is exactly what is on
            // screen. If that save did not settle cleanly, publishing would push the OLDER server
            // snapshot — so refuse instead.
            if (!await FlushAndSaveAsync())
            {
                Toasts.Show(saveState == NewsSaveState.Conflict
                    ? "Resolve the conflict before publishing."
                    : "Could not save your latest changes. Publishing now would send an older version.",
                    ToastKind.Error);
                return;
            }
            if (!await WaitForUploadsAsync())
            {
                Toasts.Show("Still uploading — try again once the uploads finish.", ToastKind.Warning);
                return;
            }

            var err = Validate();
            if (err is not null) { Toasts.Show(err, ToastKind.Warning); return; }

            var mode = scheduleOn ? "schedule" : "publish";
            var promoteVersion = baseVersion;
            var promoteContentVersion = baseContentVersion;
            var req = new AppDtos.PromoteNewsDraftRequest(promoteVersion, promoteContentVersion, ackAgain, mode);
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/news/composer/drafts/{id}/publish", req);

            var result = await SafeReadAsync<AppDtos.NewsPostResultDto>(res);
            if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                EnterConflict(result?.Error);
                return;
            }
            if (!(result is { Success: true }))
            {
                Toasts.Show(PublishError(result?.Error), ToastKind.Error);
                return;
            }

            dirty = false;
            if (mode == "schedule")
            {
                // A schedule is a freeze: the live post is untouched (and News is null). The worker
                // applies it when due, so leave the composer and list the frozen draft instead.
                Toasts.Show($"Scheduled for {publishAt:dd MMM yyyy HH:mm}. It publishes automatically when due.", ToastKind.Success);
                Nav.NavigateTo("/news/drafts");
            }
            else if (result.News is not null)
            {
                Toasts.Show(IsRevision ? "Published post updated." : "Post published.", ToastKind.Success);
                Nav.NavigateTo($"/news/{result.News.Id}");
            }
            else
            {
                Nav.NavigateTo("/news/drafts");
            }
        }
        catch (Exception ex)
        {
            Toasts.Show("Publish failed: " + ex.Message, ToastKind.Error);
        }
        finally
        {
            PublishBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(title)) return "A post needs a title before it can be published.";
        // A body of media only (an image or video with no caption) is still a body.
        if (string.IsNullOrWhiteSpace(Strip(body)) && !BodyMediaIds().Any()) return "The post body is empty.";
        return null;
    }

    private static string Strip(string? html) =>
        System.Text.RegularExpressions.Regex.Replace(html ?? "", "<[^>]*>", " ").Replace("&nbsp;", " ").Trim();

    private static string PublishError(string? code) => code switch
    {
        "title_required" => "A post needs a title before it can be published.",
        "body_required" => "The post body is empty.",
        "title_too_long" => "The title is too long.",
        "body_too_long" => "The body is too long.",
        "schedule_requires_future_time" => "Choose a publish time in the future.",
        "invalid_target_kind" or "invalid_target_value" => "One of the audience entries is not valid.",
        "invalid_media" or "media_ref_mismatch" => "One of the images or videos is not valid for this post.",
        "invalid_attachment" => "One of the attachments is not valid for this post.",
        "forbidden" => "Only HR and Admin can publish news and memos.",
        "not_found" => "This draft no longer exists.",
        _ => "Could not publish the post."
    };

    private static string DraftError(string? code) => code switch
    {
        "forbidden" => "You do not have permission to edit this post.",
        "not_found" or "not_active" => "This draft is no longer available.",
        "invalid_media" => "One of the media items is not valid for this draft.",
        "invalid_attachment" => "One of the attachments is not valid for this draft.",
        "media_ref_mismatch" => "The body references media the draft does not own.",
        "body_too_long" => "The body is too long to save.",
        "title_too_long" => "The title is too long.",
        _ => "Could not save the draft."
    };

    private static async Task<T?> SafeReadAsync<T>(HttpResponseMessage res) where T : class
    {
        try { return await res.Content.ReadFromJsonAsync<T>(); } catch { return null; }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // Status pill
    // ─────────────────────────────────────────────────────────────────────────────

    private string StatusClass => saveState switch
    {
        NewsSaveState.Saving => "saving",
        NewsSaveState.Saved => "saved",
        NewsSaveState.Dirty => "dirty",
        NewsSaveState.Failed => "failed",
        NewsSaveState.Conflict => "conflict",
        _ => ""
    };

    private string StatusIcon => saveState switch
    {
        NewsSaveState.Saving => "loader-circle",
        NewsSaveState.Saved => "circle-check",
        NewsSaveState.Dirty => "circle-dot",
        NewsSaveState.Failed => "cloud-off",
        NewsSaveState.Conflict => "triangle-alert",
        _ => "cloud"
    };

    private string StatusText => saveState switch
    {
        NewsSaveState.Saving => "Saving…",
        NewsSaveState.Saved => lastSavedAt is { } t
            ? (IsRevision && postStatus == "published" ? $"Live post updated {t:HH:mm}" : $"Draft saved {t:HH:mm}")
            : "Saved",
        NewsSaveState.Dirty => "Unsaved changes",
        NewsSaveState.Failed => saveError ?? "Autosave failed",
        NewsSaveState.Conflict => "Not saved — conflict",
        _ => loading ? "Loading…" : "Autosave on"
    };

    // ─────────────────────────────────────────────────────────────────────────────
    // Dispose
    // ─────────────────────────────────────────────────────────────────────────────

    public void Dispose()
    {
        if (disposed) return;
        disposed = true;
        try { debounce?.Dispose(); } catch { }
        try { lifetimeCts?.Cancel(); } catch { }
        try { lifetimeCts?.Dispose(); } catch { }
        try { if (guardModule is not null) _ = guardModule.InvokeVoidAsync("remove"); } catch { }
        try { if (guardModule is not null) _ = guardModule.DisposeAsync(); } catch { }
        try { selfRef?.Dispose(); } catch { }
    }
}