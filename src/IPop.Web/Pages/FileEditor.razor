@page "/files/editor"
@layout EmptyLayout
@implements IDisposable
@inject AuthState Auth
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PhoneState Phone

<PageTitle>@(string.IsNullOrWhiteSpace(fileName) ? "Document Editor" : fileName) - iPop Docs</PageTitle>

<div class="@(Phone.IsPhone ? "m-files-editor" : "editor-page ed")">
    @if (Phone.IsPhone)
    {
        @if (!Embedded) { <header class="m-files-editor-head"><button type="button" @onclick="BackToPhoneFiles"><i data-lucide="chevron-left"></i>Files</button><strong>@fileName</strong><button type="button" @onclick="DownloadFile" disabled="isDownloading" aria-label="Download"><i data-lucide="download"></i></button></header> }
    }
    else
    {
    <header class="ed-bar">
        <button type="button" class="ed-btn icon" title="Back to Files" aria-label="Back to Files" @onclick="CloseEditor"><i data-lucide="chevron-left"></i></button>
        <span class="ed-file">
            <i data-lucide="@GetFileIcon(fileName)" style="color:@GetFileIconColor(fileName)"></i>
            <span class="ed-name" title="@fileName">@(string.IsNullOrWhiteSpace(fileName) ? "Document" : fileName)</span>
            @if (!string.IsNullOrWhiteSpace(ServerParam)) { <span class="ed-site">@ServerParam.ToUpperInvariant()</span> }
        </span>
        <span class="ed-status @StatusPillClass" title="@StatusPillTooltip"><span class="ed-dot"></span>@StatusPillText</span>
        <span class="ed-spacer"></span>
        <button type="button" class="ed-btn" title="Download a copy" @onclick="DownloadFile" disabled="@isDownloading">
            <i data-lucide="@(isDownloading ? "loader-circle" : "download")" class="@(isDownloading ? "spin" : "")"></i><span>Download</span>
        </button>
        <button type="button" class="ed-btn" title="Close and return to Files" @onclick="CloseEditor"><span>Done</span></button>
    </header>
    }

    <main class="@(Phone.IsPhone ? "m-files-editor-canvas" : "editor-canvas-container")">
        <div class="editor-overlay-msg @(isConnecting ? "show" : "hide")">
            <div class="ed-msg">
                <i data-lucide="loader-circle" class="spin ed-spin"></i>
                <strong>Opening @(string.IsNullOrWhiteSpace(fileName) ? "document" : fileName)…</strong>
                <span>Starting a shared editing session.</span>
            </div>
        </div>

        <div class="editor-overlay-msg @(!string.IsNullOrEmpty(errorMessage) ? "show" : "hide")" style="z-index:30">
            <div class="ed-msg">
                <div class="ed-art"><i data-lucide="file-warning"></i></div>
                <strong>Can't open the editor</strong>
                <span>@errorMessage</span>
                <div class="ed-acts">
                    <button type="button" class="ed-btn primary" @onclick="LoadEditorConfig"><i data-lucide="rotate-cw"></i><span>Try again</span></button>
                    <button type="button" class="ed-btn" @onclick="DownloadFile"><i data-lucide="download"></i><span>Download instead</span></button>
                </div>
            </div>
        </div>

        <div id="@PlaceholderId" class="editor-frame-host"></div>
    </main>
</div>

@code {
    private const string PlaceholderId = "ipop-onlyoffice-root";
    [SupplyParameterFromQuery(Name = "embedded")] public string? EmbeddedParam { get; set; }
    private bool Embedded => EmbeddedParam == "1";
    private void BackToPhoneFiles() => Nav.NavigateTo($"/files?server={Uri.EscapeDataString(ServerParam ?? "")}&path={Uri.EscapeDataString(System.IO.Path.GetDirectoryName(PathParam ?? "/")?.Replace('\\', '/') ?? "/")}");

    [SupplyParameterFromQuery(Name = "server")]
    public string? ServerParam { get; set; }

    [SupplyParameterFromQuery(Name = "path")]
    public string? PathParam { get; set; }

    private string fileName => string.IsNullOrWhiteSpace(PathParam) ? "" : System.IO.Path.GetFileName(PathParam);
    private bool isConnecting = true;
    private bool isSaving = false;
    private bool isDownloading = false;
    private string? errorMessage;
    private DotNetObjectReference<FileEditor>? dotNetRef;

    private string StatusPillClass =>
        isConnecting ? "connecting" :
        !string.IsNullOrEmpty(errorMessage) ? "error" :
        isSaving ? "saving" : "saved";

    private string StatusPillText =>
        isConnecting ? "Connecting…" :
        !string.IsNullOrEmpty(errorMessage) ? "Not connected" :
        isSaving ? "Saving…" : "Saved to NAS";

    private string StatusPillTooltip =>
        isConnecting ? "Connecting to collaboration server..." :
        !string.IsNullOrEmpty(errorMessage) ? (errorMessage ?? "") :
        isSaving ? "Changes are being saved periodically to Synology NAS..." :
        "All changes saved to Synology NAS";

    protected override async Task OnInitializedAsync()
    {
        await Phone.StartAsync();
        dotNetRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ServerParam) || string.IsNullOrWhiteSpace(PathParam))
        {
            errorMessage = "Invalid server or document path parameters.";
            isConnecting = false;
            return;
        }

        await LoadEditorConfig();
    }

    private async Task LoadEditorConfig()
    {
        isConnecting = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var cleanServer = ServerParam?.Trim() ?? "";
            var cleanPath = PathParam?.Trim() ?? "";

            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/onlyoffice/config?server={Uri.EscapeDataString(cleanServer)}&path={Uri.EscapeDataString(cleanPath)}");
            if (!res.IsSuccessStatusCode)
            {
                string? msg = null;
                try
                {
                    var errJson = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (errJson.TryGetProperty("message", out var m)) msg = m.GetString();
                }
                catch { }

                errorMessage = msg ?? $"Failed to initialize editor (HTTP {(int)res.StatusCode}). Please ensure Synology account is connected.";
                isConnecting = false;
                StateHasChanged();
                await JS.InvokeVoidAsync("ipop.icons");
                return;
            }

            var configJson = await res.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            var serverUrl = configJson.TryGetProperty("serverUrl", out var s) ? s.GetString() ?? "http://localhost:8088" : "http://localhost:8088";

            // Sedikit delay agar DOM siap
            await Task.Delay(50);
            var ok = await JS.InvokeAsync<bool>("ipop.initOnlyOffice", PlaceholderId, serverUrl, configJson, dotNetRef, Phone.IsPhone);
            if (!ok)
            {
                // The usual cause behind the proxy: an https page may not load the editor from a plain-http
                // address, or that port isn't published. Say which address was tried so IT can fix it.
                var pageHttps = Nav.BaseUri.StartsWith("https:", StringComparison.OrdinalIgnoreCase);
                errorMessage = pageHttps && serverUrl.StartsWith("http:", StringComparison.OrdinalIgnoreCase)
                    ? $"The document server at {serverUrl} is plain http, which the browser blocks on this secure page. Ask IT to publish it over https (OnlyOffice:PublicServerUrl)."
                    : $"The document server at {serverUrl} didn't answer. It may be offline or not reachable from this network.";
                isConnecting = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading document: {ex.Message}";
            isConnecting = false;
        }
        finally
        {
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    [JSInvokable]
    public void OnEditorReady()
    {
        isConnecting = false;
        isSaving = false;
        errorMessage = null;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    [JSInvokable]
    public void OnDocumentStateChange(bool hasUnsavedChanges)
    {
        isSaving = hasUnsavedChanges;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnEditorError(string errorMsg)
    {
        errorMessage = $"ONLYOFFICE error: {errorMsg}";
        isConnecting = false;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task DownloadFile()
    {
        if (string.IsNullOrWhiteSpace(ServerParam) || string.IsNullOrWhiteSpace(PathParam) || isDownloading) return;
        isDownloading = true;
        StateHasChanged();

        try
        {
            var cleanServer = ServerParam.Trim();
            var cleanPath = PathParam.Trim();
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/files/download?server={Uri.EscapeDataString(cleanServer)}&path={Uri.EscapeDataString(cleanPath)}");
            if (res.IsSuccessStatusCode)
            {
                var bytes = await res.Content.ReadAsByteArrayAsync();
                var mime = GetMimeType(fileName);
                await JS.InvokeVoidAsync("ipop.downloadBlob", Convert.ToBase64String(bytes), mime, fileName);
            }
            else
            {
                errorMessage = "Failed to download file from Synology.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Download error: {ex.Message}";
        }
        finally
        {
            isDownloading = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

    private async Task CloseEditor()
    {
        await JS.InvokeVoidAsync("ipop.closeOrNavigate", "/files");
    }

    private static string GetFileExt(string name) => System.IO.Path.GetExtension(name).ToLowerInvariant();

    private static string GetFileIcon(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "table",
        ".doc" or ".docx" or ".rtf" => "file-text",
        ".ppt" or ".pptx" => "presentation",
        _ => "file-text"
    };

    private static string GetFileIconColor(string name) => GetFileExt(name) switch
    {
        ".xls" or ".xlsx" or ".csv" => "#1b7a3d",
        ".doc" or ".docx" or ".rtf" => "#1a56c4",
        ".ppt" or ".pptx" => "#c2410c",
        _ => "var(--accent)"
    };

    private static string GetMimeType(string name) => GetFileExt(name) switch
    {
        ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        ".doc" => "application/msword",
        ".rtf" => "application/rtf",
        ".pptx" => "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        ".ppt" => "application/vnd.ms-powerpoint",
        ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        ".xls" => "application/vnd.ms-excel",
        ".csv" => "text/csv",
        _ => "application/octet-stream"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("ipop.destroyOnlyOffice", PlaceholderId);
        dotNetRef?.Dispose();
    }
}
