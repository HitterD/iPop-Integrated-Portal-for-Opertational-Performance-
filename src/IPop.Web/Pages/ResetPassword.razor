@page "/forgot-password"
@page "/reset-password"
@layout EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthState Auth

<PageTitle>@(HasToken ? "Reset password" : "Forgot password") — IPop</PageTitle>

@* One page, two steps: without ?token= it asks for the ID/email; with it, sets the new password. *@
<div class="auth-wrap">
    <AuthSlides />

    <div class="auth-card tray rise rise-1">
        <div class="core">
            <AuthBrand />

            @if (!HasToken)
            {
                <h2>Forgot password</h2>
                <p class="sub">We'll email you a link to choose a new one</p>
                @if (!sent)
                {
                    <form @onsubmit="Request" @onsubmit:preventDefault>
                        <div class="field">
                            <label for="ident">Employee ID or email</label>
                            <input id="ident" type="text" autocomplete="username" @bind="identifier" @bind:event="oninput" disabled="@busy" />
                        </div>
                        <button class="btn" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(identifier))">@(busy ? "Sending…" : "Send reset link") <span class="orb"><i data-lucide="arrow-right"></i></span></button>
                    </form>
                }
                <div class="note @RequestNoteClass" @key="RequestNoteClass">
                    <i data-lucide="@RequestNoteIcon"></i>
                    <span>@RequestNoteText</span>
                </div>
            }
            else if (done)
            {
                <h2>Password updated</h2>
                <p class="sub">Every device signed in with this account has been signed out</p>
                <div class="note ok" style="margin:0 0 20px"><i data-lucide="check-circle-2"></i><span>Please sign in again using the new password you just set.</span></div>
                <button class="btn" type="button" @onclick="GoToLogin">Sign in <span class="orb"><i data-lucide="arrow-right"></i></span></button>
            }
            else
            {
                <h2>Choose a new password</h2>
                <p class="sub">This link works once</p>
                <form @onsubmit="Reset" @onsubmit:preventDefault>
                    <div class="field">
                        <label for="np">New password</label>
                        <input id="np" type="password" autocomplete="new-password" @bind="newPassword" @bind:event="oninput" disabled="@busy" />
                        @foreach (var m in FieldErrors("newPassword"))
                        {
                            <span class="field-err">@m</span>
                        }
                    </div>
                    <div class="field">
                        <label for="cp">Confirm new password</label>
                        <input id="cp" type="password" autocomplete="new-password" @bind="confirmPassword" @bind:event="oninput" disabled="@busy" />
                        @foreach (var m in FieldErrors("confirmPassword"))
                        {
                            <span class="field-err">@m</span>
                        }
                    </div>
                    <ul class="req">
                        <li @key="@("r1-" + r1)" class="@(r1 ? "ok" : "")"><i data-lucide="@Tick(r1)"></i> At least 8 characters</li>
                        <li @key="@("r2-" + r2)" class="@(r2 ? "ok" : "")"><i data-lucide="@Tick(r2)"></i> One uppercase letter and one number</li>
                        <li @key="@("r3-" + r3)" class="@(r3 ? "ok" : "")"><i data-lucide="@Tick(r3)"></i> Different from the default password</li>
                        <li @key="@("r4-" + r4)" class="@(r4 ? "ok" : "")"><i data-lucide="@Tick(r4)"></i> Both fields match</li>
                    </ul>
                    <button class="btn" type="submit" disabled="@(!allOk || busy)">@(busy ? "Updating…" : "Update password") <span class="orb"><i data-lucide="arrow-right"></i></span></button>
                </form>
                @if (error is not null)
                {
                    <div class="note err"><i data-lucide="alert-circle"></i><span>@error</span></div>
                }
            }
            <a class="auth-link" href="/login">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }
    private bool HasToken => !string.IsNullOrEmpty(Token);

    private string identifier = "", newPassword = "", confirmPassword = "";
    private bool busy, sent, done;
    private string? error;
    private Dictionary<string, string[]>? fields;

    private string RequestNoteClass => error is not null ? "err" : sent ? "ok" : "";
    private string RequestNoteIcon => error is not null ? "alert-circle" : sent ? "mail-check" : "info";
    private string RequestNoteText => error ?? (sent
        ? "If that account exists and has an email address, a reset link is on its way. It expires in 30 minutes."
        : "No email on your account? Ask IT to reset your password.");

    private bool r1 => newPassword.Length >= 8;
    private bool r2 => newPassword.Any(char.IsUpper) && newPassword.Any(char.IsDigit);
    private bool r3 => newPassword != "1234" && newPassword.Length > 0;
    private bool r4 => newPassword == confirmPassword && newPassword.Length > 0;
    private bool allOk => r1 && r2 && r3 && r4;
    private static string Tick(bool ok) => ok ? "check-circle-2" : "circle";

    private string[] FieldErrors(string key) =>
        fields is not null && fields.TryGetValue(key, out var m) ? m : [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
        => await JS.InvokeVoidAsync("ipop.icons");

    private void GoToLogin() => Nav.NavigateTo("/login?changed=1", forceLoad: true);

    private async Task Request()
    {
        if (busy || string.IsNullOrWhiteSpace(identifier)) return;
        busy = true; error = null;
        try
        {
            var (ok, err) = await Auth.RequestPasswordResetAsync(identifier.Trim());
            if (ok) sent = true; else error = err;
        }
        catch { error = "Could not reach the server. Check your connection and try again."; }
        finally { busy = false; }
    }

    private async Task Reset()
    {
        if (!allOk || busy) return;
        busy = true; error = null; fields = null;
        try
        {
            var (ok, serverFields, message) = await Auth.ResetPasswordAsync(Token!, newPassword, confirmPassword);
            if (ok) { done = true; newPassword = confirmPassword = ""; }
            else { fields = serverFields; error = message; }
        }
        catch { error = "Could not reach the server. Check your connection and try again."; }
        finally { busy = false; }
    }

}
