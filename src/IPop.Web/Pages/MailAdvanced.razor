@page "/mail/advanced"
@inject NavigationManager Nav

@* Legacy route. Mail settings now live in modals opened from the Mail page's
   "Mail settings" popover; old links land on the matching modal. *@

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    protected override void OnInitialized()
    {
        var section = Tab switch
        {
            "rules" => "rules",
            "templates" => "templates",
            "autoreply" or "ooo" => "ooo",
            "signature" => "signature",
            _ => "labels"
        };
        Nav.NavigateTo($"/mail?settings={section}", replace: true);
    }
}
