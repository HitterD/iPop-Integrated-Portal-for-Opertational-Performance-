@page "/"
@page "/login"
@layout EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthState Auth
@inject PhoneState Phone
@implements IDisposable

<PageTitle>Sign in — IPop</PageTitle>

<div class="auth-wrap @(success ? "success" : "") @(Phone.IsPhone ? "m-login" : "")">
    <button class="theme-btn auth-theme-btn" title="Toggle dark / light mode" @onclick="ToggleTheme" @onclick:stopPropagation><i data-lucide="@(IsDark ? "sun" : "moon")"></i></button>
    @if (!Phone.IsPhone) { <AuthSlides /> }

    <div class="auth-card tray rise rise-1" @ref="cardRef">
        <div class="core">
            <AuthBrand />
            <h2>Sign in</h2>
            <p class="sub">Use your employee ID and password</p>
            <form @onsubmit="TryLogin" @onsubmit:preventDefault>
                <div class="field">
                    <label for="nik">Employee ID</label>
                    <input id="nik" type="text" placeholder="e.g. 20140312" autocomplete="username" @bind="nik" disabled="@(locked || busy)" />
                </div>
                <div class="field">
                    <label for="pwd">Password</label>
                    <div class="auth-password-field"><input id="pwd" type="@(showPassword ? "text" : "password")" placeholder="Your password" autocomplete="current-password" @bind="password" disabled="@(locked || busy)" /><button type="button" title="@(showPassword ? "Hide password" : "Show password")" aria-label="@(showPassword ? "Hide password" : "Show password")" @onclick="() => showPassword = !showPassword"><i data-lucide="@(showPassword ? "eye-off" : "eye")"></i></button></div>
                </div>
                <div class="auth-options">
                    <label class="auth-remember"><input type="checkbox" @bind="keepSignedIn" /> Keep me signed in</label>
                    <a class="auth-link" href="/forgot-password">Forgot password?</a>
                </div>
                <button class="btn" type="submit" disabled="@(locked || busy)">@(success ? "Signed in" : busy ? "Signing in…" : "Sign in") <span class="orb" @key="success"><i data-lucide="@(success ? "check" : "arrow-right")"></i></span></button>
            </form>
            <div class="note @(isError ? "err" : isSuccess ? "ok" : "")" @key="noteIcon">
                <i data-lucide="@noteIcon"></i>
                <span>@noteText</span>
            </div>
        </div>
    </div>

    @if (Phone.IsPhone)
    {
        <a class="m-login-install" href="/app"><img src="img/brand/ipop-mark.webp" alt="" width="44" height="44" /><span><b>Install iPop</b><small>Faster, full screen, with notifications</small></span><span>Install</span></a>
    }
    @if (success)
    {
        <div class="auth-welcome" aria-live="polite">
            <img src="img/brand/ipop-mark.webp" alt="" width="72" height="72" />
            <div class="t">Welcome to iPop</div>
            <div class="s">Preparing your workspace…</div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string nik = "", password = "";
    private string noteText = "First time? Sign in with the default password 1234, then set your own.";
    private string noteIcon = "info";
    private bool isError, isSuccess, locked, busy, success;
    private bool showPassword, keepSignedIn = true;
    private ElementReference cardRef;

    // Set / reset password sign the user out and land here with ?changed=1.
    [SupplyParameterFromQuery(Name = "changed")] public string? Changed { get; set; }

    protected override void OnInitialized()
    {
        Phone.Changed += PhoneChanged;
        if (string.IsNullOrEmpty(Changed)) return;
        isSuccess = true; noteIcon = "check-circle-2";
        noteText = "Password updated. Please sign in again with the new password you just set.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await Phone.StartAsync(); IsDark = await JS.InvokeAsync<string>("ipop.theme") == "dark"; }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task ToggleTheme()
    {
        IsDark = await JS.InvokeAsync<string>("ipop.toggleTheme") == "dark";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private bool IsDark { get; set; }
    private void PhoneChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Phone.Changed -= PhoneChanged;

    private async Task TryLogin()
    {
        if (locked || busy) return;

        async Task Fail(string icon, string msg)
        {
            isError = true; isSuccess = false; noteIcon = icon; noteText = msg;
            await JS.InvokeVoidAsync("ipop.shake", cardRef);
        }

        if (string.IsNullOrWhiteSpace(nik) || string.IsNullOrWhiteSpace(password))
        {
            await Fail("alert-circle", "Enter your employee ID and password.");
            return;
        }

        busy = true;
        try
        {
            var fingerprint = await JS.InvokeAsync<string>("ipop.fingerprint");
            var (ok, error, isLocked) = await Auth.LoginAsync(nik.Trim(), password, fingerprint, keepSignedIn);

            if (!ok)
            {
                locked = isLocked;
                await Fail(isLocked ? "lock" : "alert-circle", error!);
                return;
            }

            password = "";
            if (Auth.MustChangePassword) { Nav.NavigateTo("/set-password"); return; }

            // Exit: check on the button, card lifts away, welcome mark; then the shell animates in.
            success = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipopAuthMotion.exit", 1300);
            await JS.InvokeVoidAsync("ipopAuthMotion.enterApp");
            Nav.NavigateTo(App.SafeReturn(ReturnUrl) ?? "/dashboard");
        }
        catch
        {
            // ipop-46: API down / network blip throws out of LoginAsync. Surface the real
            // reason instead of leaving busy latched (all inputs + button disabled) or
            // letting Blazor's generic banner be the only signal.
            await Fail("wifi-off", "Could not reach the server. Check your connection and try again.");
        }
        finally
        {
            busy = false;
        }
    }

}
