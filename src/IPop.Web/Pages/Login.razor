@page "/"
@page "/login"
@implements IDisposable
@layout EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthState Auth

<PageTitle>Sign in — IPop</PageTitle>

<div class="auth-wrap">
    <button class="theme-btn auth-theme-btn" title="Toggle dark / light mode" @onclick="ToggleTheme" @onclick:stopPropagation><i data-lucide="@(IsDark ? "sun" : "moon")"></i></button>
    <div class="slides" id="slides">
        @for (var i = 0; i < SlideCount; i++)
        {
            var n = i;
            <div class="slide @(activeSlide == n ? "on" : "")" style="background-image:url('img/slides/slide-@(n + 1).jpg')"></div>
        }
    </div>

    <div class="auth-card tray rise rise-1" @ref="cardRef">
        <div class="core">
            <div class="brand-row">
                <img class="mark" src="img/logo.png" alt="IPop" />
                <div><div class="t">IPop</div><div class="s">Internal operations portal</div></div>
            </div>
            <h2>Sign in</h2>
            <p class="sub">Use your employee ID and password</p>
            <form @onsubmit="TryLogin" @onsubmit:preventDefault>
                <div class="field">
                    <label for="nik">Employee ID</label>
                    <input id="nik" type="text" placeholder="e.g. 20140312" autocomplete="username" @bind="nik" disabled="@(locked || busy)" />
                </div>
                <div class="field">
                    <label for="pwd">Password</label>
                    <div class="auth-password-field"><input id="pwd" type="@(showPassword ? "text" : "password")" placeholder="Your password" autocomplete="current-password" @bind="password" disabled="@(locked || busy)" /><button type="button" title="@(showPassword ? "Hide password" : "Show password")" aria-label="@(showPassword ? "Hide password" : "Show password")" @onclick="() => showPassword = !showPassword"><i data-lucide="@(showPassword ? "eye-off" : "eye")"></i></button></div>
                </div>
                <label class="auth-remember"><input type="checkbox" @bind="keepSignedIn" /> Keep me signed in</label>
                <button class="btn" type="submit" disabled="@(locked || busy)">@(busy ? "Signing in…" : "Sign in") <span class="orb"><i data-lucide="arrow-right"></i></span></button>
            </form>
            <a class="auth-link" href="/forgot-password">Forgot password?</a>
            <div class="note @(isError ? "err" : "")" @key="noteIcon">
                <i data-lucide="@noteIcon"></i>
                <span>@noteText</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string nik = "", password = "";
    private string noteText = "First time? Sign in with the default password from HR, then set your own.";
    private string noteIcon = "info";
    private bool isError, locked, busy;
    private bool showPassword, keepSignedIn = true;
    private int activeSlide;
    private const int SlideCount = 5;
    private ElementReference cardRef;
    private System.Timers.Timer? slideTimer;

    protected override void OnInitialized()
    {
        slideTimer = new System.Timers.Timer(5000);
        slideTimer.Elapsed += async (_, _) =>
        {
            activeSlide = (activeSlide + 1) % SlideCount;
            await InvokeAsync(StateHasChanged);
        };
        slideTimer.AutoReset = true;
        slideTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) IsDark = await JS.InvokeAsync<string>("ipop.theme") == "dark";
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task ToggleTheme()
    {
        IsDark = await JS.InvokeAsync<string>("ipop.toggleTheme") == "dark";
        await InvokeAsync(StateHasChanged);
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private bool IsDark { get; set; }

    private async Task TryLogin()
    {
        if (locked || busy) return;

        async Task Fail(string icon, string msg)
        {
            isError = true; noteIcon = icon; noteText = msg;
            await JS.InvokeVoidAsync("ipop.shake", cardRef);
        }

        if (string.IsNullOrWhiteSpace(nik) || string.IsNullOrWhiteSpace(password))
        {
            await Fail("alert-circle", "Enter your employee ID and password.");
            return;
        }

        busy = true;
        try
        {
            var fingerprint = await JS.InvokeAsync<string>("ipop.fingerprint");
            var (ok, error, isLocked) = await Auth.LoginAsync(nik.Trim(), password, fingerprint, keepSignedIn);

            if (!ok)
            {
                locked = isLocked;
                await Fail(isLocked ? "lock" : "alert-circle", error!);
                return;
            }

            password = "";
            Nav.NavigateTo(Auth.MustChangePassword ? "/set-password" : "/dashboard");
        }
        catch
        {
            // ipop-46: API down / network blip throws out of LoginAsync. Surface the real
            // reason instead of leaving busy latched (all inputs + button disabled) or
            // letting Blazor's generic banner be the only signal.
            await Fail("wifi-off", "Could not reach the server. Check your connection and try again.");
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose() => slideTimer?.Dispose();
}
