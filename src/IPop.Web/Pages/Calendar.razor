@page "/calendar"
@page "/calendar/person/{PersonNik}"
@using IPop.Web.Services
@implements IDisposable
@inject AuthState Auth
@inject NotificationState Notifs
@inject ChatState ChatSvc
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject IJSRuntime JS
@inject PeopleLinks PLinks

@* Unified calendar: one feed (GET /api/calendar/feed) from personal events, meetings, chat
   groups, projects (my tasks, milestones, off days), scheduled mail and news. Clicking an item
   opens its source module; own events and meetings open the event drawer. *@

<PageTitle>Calendar — IPop</PageTitle>

<div class="cal-page">
    <aside class="cal-rail">
        <div class="cal-rail-strip">
        <button class="cal-create" disabled="@(!CanCreate)" title="@(CanCreate ? null : "You can view this calendar but not change it")" @onclick="() => OpenCreate(DefaultStart())"><i data-lucide="plus"></i> New event</button>

        <div class="cal-mini" aria-label="Mini calendar">
            <div class="cal-mini-head">
                <span>@miniMonth.ToString("MMMM yyyy")</span>
                <button class="cal-icon" title="Previous month" aria-label="Previous month" @onclick="() => miniMonth = miniMonth.AddMonths(-1)"><i data-lucide="chevron-left"></i></button>
                <button class="cal-icon" title="Next month" aria-label="Next month" @onclick="() => miniMonth = miniMonth.AddMonths(1)"><i data-lucide="chevron-right"></i></button>
            </div>
            <div class="cal-mini-grid">
                @foreach (var d in WeekdayShort) { <span class="cal-mini-dow">@d</span> }
                @foreach (var day in MonthCells(miniMonth))
                {
                    var dd = day;
                    <button class="cal-mini-day @(dd.Month != miniMonth.Month ? "out" : "") @(dd == DateTime.Today ? "today" : "") @(InRange(dd) ? "in-range" : "") @(dd == anchor ? "sel" : "")"
                            @onclick="() => PickDate(dd)" aria-label="@dd.ToString("dddd d MMMM yyyy")">
                        @dd.Day
                        @if (HasItems(dd)) { <span class="cal-mini-dot"></span> }
                    </button>
                }
            </div>
        </div>

        @if (!PersonMode)
        {
        <div class="cal-sources">
            <div class="cal-rail-title">Show on my calendar</div>
            @foreach (var s in Sources)
            {
                var src = s;
                var on = !hidden.Contains(src.Key);
                <label class="cal-source src-@src.Key">
                    <input type="checkbox" checked="@on" @onchange="() => ToggleSourceAsync(src.Key)" />
                    <span class="cal-check" aria-hidden="true">@if (on) { <i data-lucide="check"></i> }</span>
                    <i data-lucide="@src.Icon" class="cal-source-icon"></i>
                    <span class="cal-source-name">@src.Label</span>
                    <span class="cal-source-count">@items.Count(i => i.Source == src.Key)</span>
                </label>
            }
        </div>
        }

        @if (showIntro && !PersonMode)
        {
            <div class="cal-intro mi-rise" role="note">
                <span class="cal-intro-ic"><i data-lucide="shield-check"></i></span>
                <b>Your calendar now shows only busy times</b>
                <p>To protect important schedules, people no longer see your event titles unless you share them.@if (introFollowers.Count > 0) { <text> <b>@introFollowers.Count @(introFollowers.Count == 1 ? "person follows" : "people follow")</b> your calendar.</text> }</p>
                @if (introFollowers.Count > 0)
                {
                    <div class="cal-intro-faces">
                        @foreach (var f in introFollowers.Take(5)) { <PersonAvatar Nik="@f.Nik" Name="@f.Name" Size="22" Decorative="true" /> }
                        @if (introFollowers.Count > 5) { <span class="more">+@(introFollowers.Count - 5)</span> }
                    </div>
                }
                <div class="cal-intro-actions">
                    @if (introFollowers.Count > 0)
                    {
                        <button class="cal-btn primary" disabled="@introBusy" @onclick="IntroShareTitlesAsync">@(introBusy ? "Sharing…" : "Let them see titles")</button>
                    }
                    <button class="cal-btn" @onclick="IntroChooseAsync">Choose people…</button>
                    <button class="cal-btn ghost" @onclick="DismissIntroAsync">Keep busy only</button>
                </div>
            </div>
        }

        @if (UpcomingPending.Count > 0 && !PersonMode)
        {
            <div class="cal-invites">
                <div class="cal-rail-title">@(managing is null ? "Awaiting your reply" : $"Awaiting {managing.Name}'s reply")</div>
                @foreach (var inv in UpcomingPending)
                {
                    var it = inv;
                    <button class="cal-invite" @onclick="() => OpenItemAsync(it)">
                        <span class="cal-invite-title">@it.Title</span>
                        <span class="cal-invite-when">@When(it)</span>
                    </button>
                }
            </div>
        }
        </div>

        @* One "Calendars" list: me, calendars I manage, calendars I follow (mockup §1). *@
        <div class="cal-others cal-list">
            <div class="cal-rail-title cal-others-head">
                <span>Calendars</span>
                <button type="button" class="cal-icon sm" title="Layout" aria-label="Calendars options" aria-expanded="@(listMenu ? "true" : "false")" @onclick="() => listMenu = !listMenu"><i data-lucide="more-horizontal"></i></button>
                @if (listMenu)
                {
                    <div class="cal-other-menu cal-list-menu" role="menu" aria-label="Calendars options">
                        <div class="cal-menu-cap">Day view with other calendars</div>
                        <button role="menuitemradio" aria-checked="@(!sideBySide ? "true" : "false")" class="@(!sideBySide ? "on" : "")" @onclick="() => SetSideBySideAsync(false)"><i data-lucide="layers"></i> Overlay @if (!sideBySide) { <i data-lucide="check" class="ck"></i> }</button>
                        <button role="menuitemradio" aria-checked="@(sideBySide ? "true" : "false")" class="@(sideBySide ? "on" : "")" @onclick="() => SetSideBySideAsync(true)"><i data-lucide="columns-3"></i> Side by side @if (sideBySide) { <i data-lucide="check" class="ck"></i> }</button>
                        <hr />
                        <button role="menuitem" @onclick="() => { listMenu = false; OpenSettings(); }"><i data-lucide="settings"></i> Calendar settings</button>
                    </div>
                }
            </div>
            <button type="button" class="cal-list-row me @(managing is null && !PersonMode ? "cur" : "")" @onclick="() => ManageAsync(null)">
                <span class="cal-check me" aria-hidden="true"><i data-lucide="check"></i></span>
                <span class="cal-source-name">My calendar</span>
            </button>
            @foreach (var m in managed)
            {
                var mc = m;
                <button type="button" class="cal-list-row @(managing?.Nik == mc.Nik ? "cur" : "")" aria-pressed="@(managing?.Nik == mc.Nik ? "true" : "false")" @onclick="() => ManageAsync(mc)">
                    <PersonAvatar Nik="@mc.Nik" Name="@mc.Name" Size="20" Class="cal-other-av" Decorative="true" />
                    <span class="cal-source-name">@mc.Name<small>@LevelLabel(mc.Level)</small></span>
                    <span class="cal-pill">Manage</span>
                </button>
            }
            @foreach (var o in others)
            {
                var oc = o;
                <div class="cal-other oc-@oc.Color @(otherMenu == oc.Nik ? "menu-on" : "")" @key="oc.Nik">
                    <div class="cal-other-row">
                    <label class="cal-source">
                        <input type="checkbox" aria-label="Show @oc.Name calendar" checked="@oc.IsVisible" @onchange="() => ToggleOtherAsync(oc)" />
                        <span class="cal-check" aria-hidden="true">@if (oc.IsVisible) { <i data-lucide="check"></i> }</span>
                        <span class="cal-source-name" title="@(oc.Department is null ? oc.Name : $"{oc.Name} · {oc.Department}")">@oc.Name<small>@AccessShort(oc.Access)</small></span>
                    </label>
                    <button class="cal-icon sm cal-other-more" title="Options" aria-label="Options for @oc.Name" aria-expanded="@(otherMenu == oc.Nik ? "true" : "false")" @onclick="() => otherMenu = otherMenu == oc.Nik ? null : oc.Nik"><i data-lucide="more-horizontal"></i></button>
                    </div>
                    @if (otherMenu == oc.Nik)
                    {
                        <div class="cal-other-menu" role="menu" aria-label="Calendar options for @oc.Name">
                            <a role="menuitem" href="@PLinks.Calendar(oc.Nik)"><i data-lucide="calendar-search"></i> View calendar</a>
                            <button role="menuitem" @onclick="() => MeetWithAsync(oc.Nik, oc.Name)"><i data-lucide="calendar-plus"></i> Invite to meeting</button>
                            <a role="menuitem" href="@PLinks.Chat(oc.Nik)"><i data-lucide="message-circle"></i> Chat</a>
                            <div class="cal-menu-cap">Colour</div>
                            <div class="cal-swatches">
                                @foreach (var c in OtherPalette)
                                {
                                    var cc = c;
                                    <button class="cal-swatch oc-@cc @(oc.Color == cc ? "on" : "")" title="Colour" aria-label="Colour @cc" @onclick="() => SetOtherColorAsync(oc, cc)"></button>
                                }
                            </div>
                            <button role="menuitem" class="danger" @onclick="() => RemoveOtherAsync(oc)"><i data-lucide="eye-off"></i> Stop following</button>
                        </div>
                    }
                </div>
            }
            <button type="button" class="cal-btn cal-add-colleagues" @onclick="OpenColleaguesAsync"><i data-lucide="plus"></i> Add calendar</button>
        </div>

    </aside>

    <section class="cal-main">
        @if (PersonMode && person is not null)
        {
            var pp = person;
            <div class="cal-who mi-rise" role="region" aria-label="@pp.Name's calendar">
                <a class="cal-icon" href="/calendar" title="Back to my calendar" aria-label="Back to my calendar"><i data-lucide="arrow-left"></i></a>
                <PersonAvatar Nik="@pp.Nik" Name="@pp.Name" Size="44" Class="cal-who-av" Viewable="true" />
                <div class="cal-who-t">
                    <b>@pp.Name</b>
                    <span>@(pp.Department ?? pp.Site ?? "")@(pp.Department is not null || pp.Site is not null ? " · " : "")<span class="cal-acc"><i data-lucide="@PersonAccessIcon"></i>@PersonPronounBusy</span></span>
                    <small class="cal-who-free">@FreeLine(pp)</small>
                </div>
                <span class="cal-who-sp"></span>
                <a class="cal-btn" href="@PLinks.Chat(pp.Nik)"><i data-lucide="message-circle"></i><span>Chat</span></a>
                <button class="cal-btn cal-follow @(pp.Following ? "on" : "") @(followPop ? "mi-pop" : "")" aria-pressed="@(pp.Following ? "true" : "false")" @onclick="FollowPersonAsync" @onanimationend="() => followPop = false">
                    <i data-lucide="@(pp.Following ? "check" : "eye")"></i><span>@(pp.Following ? "Following" : "Follow")</span>
                </button>
                <button class="cal-btn primary" @onclick="() => MeetWithAsync(pp.Nik, pp.Name)"><i data-lucide="calendar-plus"></i><span>Invite to meeting</span></button>
            </div>
        }
        @if (managing is not null && !PersonMode)
        {
            <div class="cal-onbehalf" role="status">
                <i data-lucide="user-cog"></i>
                <span>You're managing <b>@managing.Name's</b> calendar.@(CanCreate ? " New events and invites are created in their name." : " You can view it but not change it.")</span>
                <button class="cal-btn" @onclick="() => ManageAsync(null)">Back to my calendar</button>
            </div>
        }
        <header class="cal-toolbar">
            <button class="cal-btn" @onclick="GoToday">Today</button>
            <div class="cal-nav">
                <button class="cal-icon" title="Previous" aria-label="Previous" @onclick="() => ShiftAsync(-1)"><i data-lucide="chevron-left"></i></button>
                <button class="cal-icon" title="Next" aria-label="Next" @onclick="() => ShiftAsync(1)"><i data-lucide="chevron-right"></i></button>
            </div>
            <h2 class="cal-range">@RangeLabel</h2>
            @if (loadingFeed) { <i data-lucide="loader-circle" class="cal-spin"></i> }
            @if (PersonMode)
            {
                <label class="cal-mine-toggle"><button type="button" role="switch" aria-checked="@(showMineBehind ? "true" : "false")" class="cs-switch sm @(showMineBehind ? "on" : "")" @onclick="() => showMineBehind = !showMineBehind" aria-label="Show my calendar too"></button> Show my calendar too</label>
            }
            <div class="cal-seg" role="tablist" aria-label="View">
                @foreach (var (key, label) in Views)
                {
                    var k = key;
                    if (PersonMode && k is "agenda") continue;
                    <button role="tab" aria-selected="@(view == k ? "true" : "false")" class="cal-seg-item @(view == k ? "on" : "")" @onclick="() => SetViewAsync(k)">@label</button>
                }
            </div>
            <button class="cal-icon cal-gear" title="Calendar settings" aria-label="Calendar settings" @onclick="() => OpenSettings()"><i data-lucide="settings"></i></button>
        </header>

        @if (loadError)
        {
            <div class="cal-error" role="alert"><i data-lucide="alert-triangle"></i> Could not load the calendar. <button class="cal-link" @onclick="LoadAsync">Retry</button></div>
        }

        @if (view is "day" or "week")
        {
            var days = VisibleDays().ToList();
            var cols = GridColumns(days);
            <div class="cal-grid-wrap @(SideBySideActive ? "split" : "")" style="--cal-days:@cols.Count">
                <div class="cal-grid-head">
                    <div class="cal-gutter"></div>
                    @foreach (var c in cols)
                    {
                        var dd = c.Day;
                        if (c.Split)
                        {
                            <div class="cal-col-head person @(c.Person is null ? "me" : $"oc-{c.Person.Color}")">
                                @if (c.Person is null) { <span class="cal-col-name">You</span> }
                                else
                                {
                                    <PersonAvatar Nik="@c.Person.Nik" Name="@c.Person.Name" Size="22" Class="cal-other-av" Decorative="true" />
                                    <span class="cal-col-name" title="@c.Person.Name">@c.Person.Name</span>
                                }
                            </div>
                            continue;
                        }
                        <button class="cal-col-head @(dd == DateTime.Today ? "today" : "")" @onclick="() => PickDayView(dd)">
                            <span class="cal-dow">@dd.ToString("ddd")</span><span class="cal-dnum">@dd.Day</span>
                        </button>
                    }
                </div>
                <div class="cal-allday">
                    <div class="cal-gutter">all-day</div>
                    @foreach (var c in cols)
                    {
                        var dd = c.Day; var col = c;
                        <div class="cal-allday-cell" @ondblclick="() => OpenCreate(dd, allDay: true)">
                            @foreach (var it in AllDayOn(dd, col))
                            {
                                var item = it;
                                <button class="cal-chip src-@item.Source kind-@item.Kind @OtherClass(item) @(item.Rsvp == "pending" ? "pending" : "") @JustSaved(item)" title="@Tooltip(item)" @onclick="e => OpenItemAsync(item, e)" @onclick:stopPropagation="true">
                                    <i data-lucide="@IconFor(item)"></i><span>@item.Title</span>
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="cal-grid-scroll" id="cal-grid-scroll">
                    <div class="cal-grid-body">
                        <div class="cal-hours">
                            @for (var h = 0; h < 24; h++) { <div class="cal-hour-label">@(h == 0 ? "" : $"{h:00}:00")</div> }
                        </div>
                        @foreach (var c in cols)
                        {
                            var dd = c.Day; var col = c;
                            <div class="cal-day-col @(dd == DateTime.Today && !c.Split ? "today" : "") @(c.Person is { } cp ? $"oc-{cp.Color} person" : "")">
                                @for (var h = 0; h < 24; h++)
                                {
                                    var hh = h;
                                    if (col.Person is { } who)
                                    {
                                        <div class="cal-slot" @onclick="() => MeetWithAsync(who.Nik, who.Name, dd.AddHours(hh))" title="New meeting with @who.Name at @($"{hh:00}:00")"></div>
                                        continue;
                                    }
                                    if (PersonMode && person is { } pw)
                                    {
                                        <div class="cal-slot invite" data-label="Meeting with @(pw.Name.Split(' ')[0]) · @($"{hh:00}:00")" @onclick="() => MeetWithAsync(pw.Nik, pw.Name, dd.AddHours(hh))" title="Invite @pw.Name at @($"{hh:00}:00")"></div>
                                        continue;
                                    }
                                    <div class="cal-slot" @onclick="() => OpenCreate(dd.AddHours(hh))" title="New event at @($"{hh:00}:00")"></div>
                                }
                                @foreach (var p in LayoutDay(dd, col))
                                {
                                    if (p.Item is null)
                                    {
                                        <button class="cal-event cal-overflow" style="top:@Px(p.Top);height:@Px(p.Height);left:calc(@Pct(p.Col, p.Cols) + 2px);width:calc(@Pct(1, p.Cols) - 4px)"
                                                title="Show all in Agenda" @onclick="() => ShowAgendaAsync(dd)" @onclick:stopPropagation="true">+@p.Hidden more</button>
                                        continue;
                                    }
                                    var item = p.Item;
                                    <button class="cal-event src-@item.Source kind-@item.Kind @OtherClass(item) @(item.Rsvp == "pending" ? "pending" : "") @(item.Rsvp == "decline" ? "declined" : "") @JustSaved(item)"
                                            style="top:@Px(p.Top);height:@Px(p.Height);left:calc(@Pct(p.Col, p.Cols) + 2px);width:calc(@Pct(1, p.Cols) - 4px)"
                                            title="@Tooltip(item)" @onclick="e => OpenItemAsync(item, e)" @onclick:stopPropagation="true">
                                        <span class="cal-event-title"><i data-lucide="@IconFor(item)"></i>@item.Title</span>
                                        @if (p.Height >= 34) { <span class="cal-event-time">@TimeRange(item)@(item.OwnerNik is not null && !SideBySideActive ? $" · {item.Subtitle}" : "")</span> }
                                    </button>
                                }
                                @if (dd == DateTime.Today)
                                {
                                    <div class="cal-now" style="top:@Px((DateTime.Now - DateTime.Today).TotalHours * HourPx)"><span></span></div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else if (view == "month")
        {
            <div class="cal-month">
                @foreach (var d in WeekdayShort) { <div class="cal-month-dow">@d</div> }
                @foreach (var day in MonthCells(anchor))
                {
                    var dd = day;
                    var dayItems = ItemsOn(dd, true).ToList();
                    <div class="cal-month-cell @(dd.Month != anchor.Month ? "out" : "") @(dd == DateTime.Today ? "today" : "")" @ondblclick="() => OpenCreate(dd.AddHours(9))">
                        <button class="cal-month-num" @onclick="() => PickDayView(dd)" aria-label="Open @dd.ToString("d MMMM")">@dd.Day</button>
                        @foreach (var it in dayItems.Take(3))
                        {
                            var item = it;
                            <button class="cal-chip src-@item.Source kind-@item.Kind @OtherClass(item) @(item.Rsvp == "pending" ? "pending" : "") @JustSaved(item)" title="@Tooltip(item)" @onclick="e => OpenItemAsync(item, e)">
                                @if (!IsAllDayLike(item)) { <span class="cal-chip-time">@item.Start.ToString("HH:mm")</span> }
                                <span>@item.Title</span>
                            </button>
                        }
                        @if (dayItems.Count > 3)
                        {
                            <button class="cal-more" @onclick="() => PickDayView(dd)">+@(dayItems.Count - 3) more</button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            var groups = AgendaDays().ToList();
            <div class="cal-agenda">
                @if (groups.Count == 0 && !loadingFeed)
                {
                    <div class="cal-empty"><i data-lucide="calendar-check"></i><div>Nothing scheduled in the next 30 days.</div></div>
                }
                @foreach (var g in groups)
                {
                    <div class="cal-agenda-day">
                        <div class="cal-agenda-date @(g.Day == DateTime.Today ? "today" : "")">
                            <span class="cal-dnum">@g.Day.Day</span>
                            <span><b>@g.Day.ToString("dddd")</b><small>@g.Day.ToString("MMMM yyyy")</small></span>
                        </div>
                        <div class="cal-agenda-items">
                            @foreach (var it in g.Items)
                            {
                                var item = it;
                                <button class="cal-agenda-item src-@item.Source kind-@item.Kind @JustSaved(item)" @onclick="() => OpenItemAsync(item)">
                                    <span class="cal-agenda-time">@(IsAllDayLike(item) ? "All day" : TimeRange(item))</span>
                                    <span class="cal-agenda-bar"></span>
                                    <i data-lucide="@IconFor(item)"></i>
                                    <span class="cal-agenda-body">
                                        <span class="cal-agenda-title">@item.Title</span>
                                        <span class="cal-agenda-sub">@SourceLabel(item.Source)@(item.Subtitle is null ? "" : $" · {item.Subtitle}")@(item.Location is null ? "" : $" · {item.Location}")</span>
                                    </span>
                                    @if (item.Rsvp is "pending") { <span class="cal-badge">Reply</span> }
                                    else if (item.Rsvp is "maybe") { <span class="cal-badge soft">Maybe</span> }
                                    else if (item.Rsvp is "decline") { <span class="cal-badge soft">Declined</span> }
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@* ---- Event drawer: view / create / edit ---- *@
@if (drawerOpen || drawerClosing)
{
    <div class="cal-drawer-backdrop @(drawerOpen ? "" : "closing")" @onclick="CloseDrawer"></div>
    <aside class="cal-drawer @(drawerOpen ? "" : "closing")" role="dialog" aria-modal="true" aria-label="@(editing ? (form.Id is null ? "New event" : "Edit event") : "Event")" @onkeydown="DrawerKey">
        <header class="cal-drawer-head">
            <h3>@(editing ? (form.Id is null ? "New event" : "Edit event") : "Event")</h3>
            @if (!editing && detail is { CanEdit: true })
            {
                <button class="cal-icon" title="Edit" aria-label="Edit" @onclick="StartEdit"><i data-lucide="pencil"></i></button>
                <button class="cal-icon danger" title="@(detail.MeetingId is null ? "Delete" : "Cancel meeting")" aria-label="Delete" @onclick="DeleteAsync"><i data-lucide="trash-2"></i></button>
            }
            <button class="cal-icon" title="Close" aria-label="Close" @onclick="CloseDrawer"><i data-lucide="x"></i></button>
        </header>

        @if (!editing && detail is not null)
        {
            <div class="cal-drawer-body">
                <div class="cal-detail-title"><span class="cal-dot src-@(detail.RoomId is not null ? "chat" : detail.MeetingId is not null ? "meetings" : "personal")"></span>@detail.Title</div>
                <div class="cal-detail-row"><i data-lucide="clock"></i><span>@DetailWhen(detail)</span></div>
                @if (detail.RecurrenceText is { } rt) { <div class="cal-detail-row"><i data-lucide="repeat"></i><span>@rt</span></div> }
                @if (detail.MeetingStatus is "cancelled") { <div class="cal-detail-row warn"><i data-lucide="ban"></i><span>This meeting was cancelled.</span></div> }
                @if (detail.MeetingId is not null && CallsSchedule.IsOnline(detail.Location) && detail.MeetingStatus != "cancelled")
                {
                    <div class="cal-detail-row"><i data-lucide="video"></i>
                        @if (CanJoinDetail) { <a class="cal-btn primary" href="@DetailJoinUrl">Join meeting</a> }
                        else { <span>@(DateTime.UtcNow >= detail.EndAt ? "Meeting has ended" : CallsSchedule.JoinTooltip)</span> }
                    </div>
                }
                @if (detail.Location is not null) { <div class="cal-detail-row"><i data-lucide="map-pin"></i><span>@detail.Location</span></div> }
                @if (detail.Link is not null) { <div class="cal-detail-row"><i data-lucide="video"></i><a href="@detail.Link" target="_blank" rel="noopener">@detail.Link</a></div> }
                @if (detail.RoomName is not null) { <div class="cal-detail-row"><i data-lucide="users"></i><a href="/chat/@detail.RoomId">@detail.RoomName</a></div> }
                @if (detail.ReminderMinutes is > 0) { <div class="cal-detail-row"><i data-lucide="bell"></i><span>@ReminderLabel(detail.ReminderMinutes.Value) before</span></div> }
                <div class="cal-detail-row"><i data-lucide="user"></i><span>Organizer: @detail.OwnerName</span></div>
                @if (detail.SentBy is not null)
                {
                    <div class="cal-detail-row behalf"><i data-lucide="user-cog"></i><span>Sent by <b>@detail.SentBy</b> on behalf of <b>@detail.OwnerName</b></span></div>
                }
                else if (detail.CreatedBy is not null)
                {
                    <div class="cal-detail-row behalf"><i data-lucide="user-cog"></i><span>Created by <b>@detail.CreatedBy</b> on behalf of <b>@detail.OwnerName</b></span></div>
                }
                @if (detail.UpdatedBy is not null)
                {
                    <div class="cal-detail-row behalf"><i data-lucide="history"></i><span>Last changed by <b>@detail.UpdatedBy</b> on behalf of <b>@detail.OwnerName</b></span></div>
                }
                @if (detail.CanEdit) { <div class="cal-detail-row"><i data-lucide="@VisIcon(detail.Visibility)"></i><span>@VisLabel(detail.Visibility)</span></div> }
                @if (detail.Notes is not null) { <div class="cal-detail-notes">@detail.Notes</div> }

                @if (detail.MeetingId is not null && detail.MeetingStatus is not "cancelled" && MyRsvp is not null && !detail.CanEdit)
                {
                    <div class="cal-rsvp">
                        <span>Going?</span>
                        @foreach (var (key, label) in RsvpOptions)
                        {
                            var k = key;
                            <button class="cal-rsvp-btn @(MyRsvp == k ? "on" : "")" @onclick="() => RsvpAsync(k)">@label</button>
                        }
                    </div>
                }
                @if (detail.MeetingId is not null && detail.MeetingStatus is not "cancelled" && BehalfRow is { } behalf)
                {
                    <div class="cal-rsvp behalf">
                        <span>Reply for @behalf.Name</span>
                        @foreach (var (key, label) in RsvpOptions)
                        {
                            var k = key;
                            <button class="cal-rsvp-btn @(behalf.Rsvp == k ? "on" : "")" @onclick="() => RsvpForAsync(k)">@label</button>
                        }
                    </div>
                }
                @if (detail.Attendees.Count > 0)
                {
                    <div class="cal-rail-title">Participants · @detail.Attendees.Count</div>
                    <ul class="cal-people">
                        @foreach (var p in detail.Attendees)
                        {
                            <li><PersonAvatar Nik="@p.Nik" Name="@p.Name" Size="26" Class="cal-person-av" Decorative="true" /><span>@p.Name@if (p.RespondedBy is not null) { <small class="cal-set-by">set by @p.RespondedBy</small> }</span><span class="cal-rsvp-tag rsvp-@p.Rsvp">@RsvpLabel(p.Rsvp)</span></li>
                        }
                    </ul>
                }
                @if (detail.MeetingId is not null)
                {
                    <a class="cal-btn" href="@(detail.RoomId is not null ? $"/chat/{detail.RoomId}" : $"/calls?tab=scheduled&meeting={detail.MeetingId}")"><i data-lucide="external-link"></i> Open in @(detail.RoomId is not null ? "Chat" : "Calls")</a>
                }
            </div>
        }
        else if (editing)
        {
            <div class="cal-drawer-body cal-form">
                @if (prefillSource is not null)
                {
                    <div class="cal-prefill" role="status"><i data-lucide="sparkles"></i><span>@prefillSource</span>
                        <button type="button" class="cal-icon sm" title="Clear what was filled in" aria-label="Clear what was filled in" @onclick="ClearPrefill"><i data-lucide="x"></i></button></div>
                }
                <input class="cal-title-input" placeholder="Event title" @bind="form.Title" @bind:event="oninput" maxlength="200" aria-label="Title" />

                @* ── When ── *@
                <div class="cal-group">
                    <label class="cal-row cal-switch-row">
                        <i data-lucide="sun"></i><span class="cal-row-label">All day</span>
                        <input type="checkbox" class="cal-switch" role="switch" @bind="form.AllDay" />
                    </label>
                    <div class="cal-row">
                        <i data-lucide="clock"></i><span class="cal-row-label">Starts</span>
                        <div class="cal-row-ctl"><AppDatePicker @bind-Value="form.StartDate" AriaLabel="Start date" Compact="true" />@if (!form.AllDay) { <AppTimePicker @bind-Value="form.StartTime" AriaLabel="Start time" /> }</div>
                    </div>
                    <div class="cal-row">
                        <i data-lucide="clock-4"></i><span class="cal-row-label">Ends</span>
                        <div class="cal-row-ctl"><AppDatePicker @bind-Value="form.EndDate" AriaLabel="End date" Compact="true" />@if (!form.AllDay) { <AppTimePicker @bind-Value="form.EndTime" AriaLabel="End time" /> }</div>
                    </div>
                    <div class="cal-row cal-repeat-row">
                        <i data-lucide="repeat"></i><span class="cal-row-label">Repeat</span>
                        <div class="cal-row-ctl">
                            @if (form.Id is not null)
                            {
                                <span class="cal-repeat-static">@(detail?.RecurrenceText ?? "Doesn't repeat")</span>
                            }
                            else
                            {
                                <button type="button" class="cal-repeat-btn @(repeatFreq != "" ? "on" : "")" aria-expanded="@(repeatOpen ? "true" : "false")" @onclick="() => repeatOpen = !repeatOpen">
                                    <span>@RepeatLabel</span><i data-lucide="chevron-down"></i>
                                </button>
                            }
                        </div>
                        @if (repeatOpen && form.Id is null)
                        {
                            <div class="cal-repeat-pop" role="dialog" aria-label="Repeat">
                                <div class="cal-seg sm" role="radiogroup" aria-label="How often">
                                    @foreach (var (k, l) in new[] { ("", "Never"), ("D", "Daily"), ("W", "Weekly"), ("M", "Monthly") })
                                    {
                                        var kk = k;
                                        <button type="button" role="radio" aria-checked="@(repeatFreq == kk ? "true" : "false")" class="cal-seg-item @(repeatFreq == kk ? "on" : "")" @onclick="() => SetRepeatFreq(kk)">@l</button>
                                    }
                                </div>
                                @if (repeatFreq == "W")
                                {
                                    <div class="cal-repeat-days" role="group" aria-label="On these days">
                                        @foreach (var (iso, s) in WeekDays)
                                        {
                                            var d = iso;
                                            <button type="button" class="@(repeatDays.Contains(d) ? "on" : "")" aria-pressed="@(repeatDays.Contains(d) ? "true" : "false")" aria-label="@DayNames[d]" @onclick="() => ToggleRepeatDay(d)">@s</button>
                                        }
                                    </div>
                                }
                                @if (repeatFreq == "M")
                                {
                                    <div class="cal-repeat-monthly" role="radiogroup" aria-label="Monthly pattern">
                                        <label><input type="radio" name="cal-rep-month" checked='@(repeatMonthly == "date")' @onchange='() => repeatMonthly = "date"' /> On the @form.StartDate.Day@Ord(form.StartDate.Day)</label>
                                        <label><input type="radio" name="cal-rep-month" checked='@(repeatMonthly == "weekday")' @onchange='() => repeatMonthly = "weekday"' /> On the @(((form.StartDate.Day - 1) / 7 + 1).ToString() + Ord((form.StartDate.Day - 1) / 7 + 1)) @form.StartDate.ToString("dddd")</label>
                                        <label><input type="radio" name="cal-rep-month" checked='@(repeatMonthly == "last")' @onchange='() => repeatMonthly = "last"' /> On the last @form.StartDate.ToString("dddd")</label>
                                    </div>
                                }
                                @if (repeatFreq != "")
                                {
                                    <div class="cal-repeat-ends">
                                        <span class="cal-hint">Ends</span>
                                        <label><input type="radio" name="cal-rep-end" checked="@(repeatEnd == "never")" @onchange='() => repeatEnd = "never"' /> After a year</label>
                                        <label><input type="radio" name="cal-rep-end" checked="@(repeatEnd == "until")" @onchange='() => repeatEnd = "until"' /> On <AppDatePicker @bind-Value="repeatUntil" AriaLabel="Repeat until" Compact="true" /></label>
                                        <label><input type="radio" name="cal-rep-end" checked="@(repeatEnd == "count")" @onchange='() => repeatEnd = "count"' /> After <input class="cal-repeat-count" type="number" min="2" max="100" @bind="repeatCount" @onfocus='() => repeatEnd = "count"' aria-label="Number of times" /> times</label>
                                    </div>
                                    <div class="cal-repeat-sum" @key="RepeatLabel + RepeatOccurrences">@RepeatLabel · @RepeatOccurrences @(form.People.Count > 0 || form.RoomIdText != "" ? "meetings" : "events")</div>
                                }
                                <div class="cal-repeat-foot"><button type="button" class="cal-btn primary" @onclick="() => repeatOpen = false">Done</button></div>
                            </div>
                        }
                    </div>
                    <div class="cal-row">
                        <i data-lucide="bell"></i><span class="cal-row-label">Alert</span>
                        <div class="cal-row-ctl"><AppSelect Label="Reminder" Block="true" Value="@form.Reminder.ToString()" ValueChanged='v => form.Reminder = int.TryParse(v, out var m) ? m : 0' Options="ReminderSelect" /></div>
                    </div>
                </div>

                @* ── Who ── *@
                <div class="cal-group">
                    <div class="cal-row">
                        <i data-lucide="users"></i><span class="cal-row-label">Chat group</span>
                        <div class="cal-row-ctl"><AppSelect Label="Chat group" Block="true" Value="@form.RoomIdText" ValueChanged='v => form.RoomIdText = v ?? ""' Options="ChatGroupSelect"
                                                             Disabled="@(form.Id is not null && form.MeetingId is not null)" /></div>
                    </div>
                    <div class="cal-row cal-row-stack">
                        <div class="cal-row-head"><i data-lucide="eye"></i><span class="cal-row-label">Who can see it</span></div>
                        <div class="cal-seg cal-vis-seg" role="radiogroup" aria-label="Who can see it">
                            @foreach (var v in VisibilityOptions)
                            {
                                var vk = v.Key;
                                <button type="button" role="radio" aria-checked="@(form.Visibility == vk ? "true" : "false")" class="cal-seg-item @(form.Visibility == vk ? "on" : "")"
                                        title="@v.Hint" @onclick="() => form.Visibility = vk"><i data-lucide="@v.Icon"></i> @v.Label</button>
                            }
                        </div>
                        <small class="cal-hint" @key="form.Visibility">@((VisibilityOptions.FirstOrDefault(v => v.Key == form.Visibility) is { Key: not null } vo ? vo : VisibilityOptions[0]).Hint). People you invite always see the meeting.</small>
                    </div>
                </div>
                @if (string.IsNullOrEmpty(form.RoomIdText))
                {
                    <div class="cal-field">
                        <span>Participants</span>
                        @if (form.People.Count > 0)
                        {
                            <div class="cal-people-chips">
                                @foreach (var p in form.People)
                                {
                                    var person = p;
                                    <span class="cal-person-chip"><PersonAvatar Nik="@person.Nik" Name="@person.Name" Size="22" Class="cal-person-av" Decorative="true" />@person.Name
                                        <button title="Remove" aria-label="Remove @person.Name" @onclick="() => RemovePerson(person)"><i data-lucide="x"></i></button></span>
                                }
                            </div>
                        }
                        <div class="cal-people-add">
                            <PeoplePicker Placeholder="Invite people by name" ValueChanged="AddPerson" />
                            <button type="button" class="cal-book" title="Address book" aria-label="Address book" @onclick="OpenAddressBookAsync"><i data-lucide="book-user"></i></button>
                        </div>
                        <small>Inviting people or a group turns this into a meeting with RSVP.</small>
                    </div>
                    @if (ShowFindATime)
                    {
                        <div class="cal-fat" aria-label="Find a time">
                            <div class="cal-fat-head">
                                <b><i data-lucide="calendar-search"></i> Find a time</b>
                                <button type="button" class="cal-icon sm" title="Previous day" aria-label="Previous day" disabled="@(fatDay <= DateTime.Today)" @onclick="() => FatShiftAsync(-1)"><i data-lucide="chevron-left"></i></button>
                                <span class="cal-fat-day">@(fatDay == default ? "" : fatDay.ToString("ddd d MMM"))</span>
                                <button type="button" class="cal-icon sm" title="Next day" aria-label="Next day" @onclick="() => FatShiftAsync(1)"><i data-lucide="chevron-right"></i></button>
                                @if (fatLoading) { <i data-lucide="loader-circle" class="cal-spin"></i> }
                                @if (fat is null && !fatLoading) { <button type="button" class="cal-link" @onclick="() => LoadFreeBusyAsync()">Check availability</button> }
                            </div>
                            @if (fat is not null)
                            {
                                var prop = FatProposal();
                                <div class="cal-fat-grid">
                                    <div class="cal-fat-scale"><span class="cal-fat-who"></span><div class="cal-fat-track">@for (var h = FatFromHour; h < FatFromHour + FatHours; h += 2) { <span style="left:@Pct(h - FatFromHour, FatHours)">@h.ToString("00")</span> }</div></div>
                                    @foreach (var lane in fat.Lanes)
                                    {
                                        var clash = ProposalClashes(lane);
                                        <div class="cal-fat-lane">
                                            <span class="cal-fat-who" title="@lane.Name">@(lane.Nik == Auth.Me?.Nik ? "You" : lane.Name)@if (clash) { <i data-lucide="alert-circle" class="cal-fat-warn" aria-label="Busy at the proposed time"></i> }</span>
                                            <div class="cal-fat-track">
                                                @foreach (var b in lane.Blocks)
                                                {
                                                    if (FatSpan(b.StartAt, b.EndAt) is { } sp)
                                                    {
                                                        <span class="cal-fat-busy @(b.Tentative ? "tentative" : "")" style="left:@sp.Left;width:@sp.Width" title="@(b.Tentative ? "Tentative" : "Busy") @b.StartAt.ToLocalTime().ToString("HH:mm")–@b.EndAt.ToLocalTime().ToString("HH:mm")"></span>
                                                    }
                                                }
                                                @if (prop is { } pp) { <span class="cal-fat-prop @(clash ? "clash" : "")" style="left:@pp.Left;width:@pp.Width"></span> }
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="cal-fat-legend"><span class="busy"></span>Busy <span class="tentative"></span>Tentative <span class="prop"></span>Proposed</div>
                                @if (fat.Suggestions.Count > 0)
                                {
                                    <div class="cal-fat-sugg-title">Free for everyone</div>
                                    <div class="cal-fat-sugg">
                                        @foreach (var sg in fat.Suggestions)
                                        {
                                            var slot = sg;
                                            <button type="button" class="cal-fat-slot" @onclick="() => ApplySlot(slot)">@slot.ToLocalTime().ToString("ddd d MMM, HH:mm")</button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <small class="cal-hint">No common free slot between 08:00 and 17:00 this week.</small>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <small class="cal-hint">All group members are invited; the meeting appears in the group chat.</small>
                }
                @* ── Details ── *@
                <div class="cal-group">
                    <div class="cal-row">
                        <i data-lucide="map-pin"></i><span class="cal-row-label">Where</span>
                        <div class="cal-seg sm" role="radiogroup" aria-label="Meeting location">
                            <button type="button" role="radio" aria-checked='@(form.Online ? "true" : "false")' class="cal-seg-item @(form.Online ? "on" : "")" @onclick="() => form.Online = true">Online</button>
                            <button type="button" role="radio" aria-checked='@(!form.Online ? "true" : "false")' class="cal-seg-item @(!form.Online ? "on" : "")" @onclick="() => form.Online = false">Room</button>
                        </div>
                    </div>
                    @if (form.Online && !(form.People.Count > 0 || form.RoomIdText != ""))
                    {
                        <div class="cal-row cal-online-hint"><i data-lucide="video"></i><span>Invite people or a group to get an iPop Meeting link. Without anyone it stays a normal event.</span></div>
                    }
                    else if (form.Online)
                    {
                        <div class="cal-row cal-online-hint"><i data-lucide="video"></i><span>iPop Meeting · a join link is available after inviting people or a group.</span></div>
                    }
                    else
                    {
                        <label class="cal-row"><i data-lucide="map-pin"></i><input class="cal-row-input" placeholder="Room or location" aria-label="Location" @bind="form.Location" maxlength="300" /></label>
                        <label class="cal-row"><i data-lucide="video"></i><input class="cal-row-input" placeholder="External meeting link (optional)" aria-label="Meeting link" @bind="form.Link" maxlength="1000" /></label>
                    }
                    <label class="cal-row cal-row-top"><i data-lucide="align-left"></i><textarea class="cal-row-input" rows="3" @bind="form.Notes" maxlength="4000" placeholder="Notes, agenda…" aria-label="Notes"></textarea></label>
                </div>
                @if (formError is not null) { <div class="cal-form-error" role="alert">@formError</div> }
            </div>
            <footer class="cal-drawer-foot">
                <button class="cal-btn" @onclick="CancelEdit">Cancel</button>
                <button class="cal-btn primary" disabled="@(saving || string.IsNullOrWhiteSpace(form.Title))" @onclick="SaveAsync">@(saving ? "Saving…" : "Save")</button>
            </footer>
        }
        else
        {
            <div class="cal-drawer-body"><div class="cal-empty"><i data-lucide="loader-circle" class="cal-spin"></i></div></div>
        }
    </aside>
}

@if (pop is not null)
{
    var po = pop;
    <div class="cal-pop-backdrop" @onclick="() => pop = null"></div>
    <div class="cal-pop oc-@ColorOf(po.OwnerNik)" role="dialog" aria-label="@OtherName(po.OwnerNik)" style="left:min(@Px(popX), calc(100vw - 320px));top:max(8px, min(@Px(popY), calc(100vh - 330px)))">
        <div class="cal-pop-who"><PersonAvatar Nik="@po.OwnerNik" Name="@OtherName(po.OwnerNik)" Size="28" Class="cal-other-av" Decorative="true" /><b>@OtherName(po.OwnerNik)</b>
            <button class="cal-icon sm" title="Close" aria-label="Close" @onclick="() => pop = null"><i data-lucide="x"></i></button></div>
        <div class="cal-pop-title">@po.Title</div>
        <div class="cal-detail-row"><i data-lucide="clock"></i><span>@(IsAllDayLike(po) ? When(po) + " · all day" : $"{po.Start:ddd d MMM, HH:mm} – {po.End:HH:mm}")</span></div>
        @if (po.Location is not null) { <div class="cal-detail-row"><i data-lucide="map-pin"></i><span>@po.Location</span></div> }
        @if (po.Kind == "busy-tentative") { <div class="cal-detail-row"><i data-lucide="help-circle"></i><span>Hasn't replied to this invitation yet</span></div> }
        else if (po.Visibility != "public" && po.Title is "Busy" && PopMine is null)
        {
            <div class="cal-pop-why">
                <i data-lucide="@(po.Visibility == "private" ? "lock" : "eye-off")"></i>
                <span>@WhyBusy(po, OtherName(po.OwnerNik))</span>
                @if (po.Visibility != "private")
                {
                    var askNik = po.OwnerNik!;
                    <button class="cal-link" disabled="@askedFor.Contains(askNik)" @onclick="() => AskForDetailsAsync(askNik, OtherName(askNik))">@(askedFor.Contains(askNik) ? "Asked" : "Ask to see details")</button>
                }
            </div>
        }
        <div class="cal-pop-actions">
            @if (PopMine is not null) { <button class="cal-btn" @onclick="OpenPopMineAsync"><i data-lucide="calendar"></i> Open</button> }
            <button class="cal-btn primary" @onclick="() => MeetWithAsync(po.OwnerNik!, OtherName(po.OwnerNik))"><i data-lucide="calendar-plus"></i> Meet another time</button>
            <a class="cal-btn" href="@PLinks.Chat(po.OwnerNik!)"><i data-lucide="message-circle"></i> Chat</a>
        </div>
    </div>
}

<CalendarSettingsSheet Open="settingsOpen" OpenChanged="v => settingsOpen = v" Changed="OnSettingsChangedAsync" AllowFor="allowFor" />

@if (scopeTcs is not null)
{
    <div class="cal-scope-backdrop" @onclick="() => AnswerScope(null)"></div>
    <div class="cal-scope" role="dialog" aria-modal="true" aria-label="@scopeVerb a repeating @(detail?.MeetingId is null ? "event" : "meeting")">
        <h4>@scopeVerb a repeating @(detail?.MeetingId is null ? "event" : "meeting")</h4>
        <p>“@detail?.Title” @((detail?.RecurrenceText ?? "repeats").ToLowerInvariant().Replace("every", "repeats every")).</p>
        @foreach (var (k, t, h) in new[] { ("this", detail?.MeetingId is null ? "This event" : "This meeting", $"Only {detail?.StartAt.ToLocalTime():ddd d MMM}"),
                                            ("following", "This and following", $"From {detail?.StartAt.ToLocalTime():ddd d MMM} on"),
                                            ("all", detail?.MeetingId is null ? "All events" : "All meetings", "Every one in the series") })
        {
            var kk = k;
            <button type="button" class="cal-scope-opt @(scopeChoice == kk ? "on" : "")" role="radio" aria-checked="@(scopeChoice == kk ? "true" : "false")" @onclick="() => scopeChoice = kk">
                <span class="rd"></span><span><b>@t</b><small>@h</small></span>
            </button>
        }
        <div class="cal-scope-foot">
            <button type="button" class="cal-btn" @onclick="() => AnswerScope(null)">Back</button>
            <button type="button" class="cal-btn primary @(scopeVerb != "Change" ? "danger" : "")" @onclick="() => AnswerScope(scopeChoice)">@(scopeVerb == "Change" ? "Save" : scopeVerb)</button>
        </div>
    </div>
}

@* Outside the drawer form so its .cal-form label/input rules never reach the dialog. *@
<AddressBookDialog @ref="addressBook" />
