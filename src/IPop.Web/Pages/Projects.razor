    private async Task<List<ProjectListDto>> GetAllProjects()
    {
        var list = new List<ProjectListDto>();
        for (var page = 1; page <= 100; page++)
        {
            var result = await Auth.GetAsync<PagedResult<ProjectListDto>>($"/api/projects?page={page}&pageSize=100");
            if (result is null) break;
            list.AddRange(result.Items);
            if (list.Count >= result.TotalCount || result.Items.Count == 0) break;
        }
        return list;
    }

    private async Task ReloadProjects()
    {
        // Last-seen project list renders at once (no skeleton); the fetch below replaces it.
        if (projects.Count == 0 && Cache.Peek<List<ProjectListDto>>("projects") is { Count: > 0 } cached)
        {
            projects = cached;
            ApplyProjectFilter();
        }
        loading = projects.Count == 0;
        StateHasChanged();

        var fresh = await GetAllProjects();
        if (fresh.Count > 0 || projects.Count == 0) projects = fresh;
        Cache.Put("projects", projects, persist: true);
        Layout?.SetSubtitle($"{projects.Count} {(projects.Count == 1 ? "project" : "projects")} · {projects.Sum(p => p.TaskCount)} tasks");
        ApplyProjectFilter();

        availableYears = projects.Select(p => p.Year).Distinct().OrderByDescending(y => y).ToList();

        if (!portfolioSelected && selectedProjectId == Guid.Empty && filteredProjects.Count > 0)
        {
            await SelectProject(filteredProjects[0]);
        }

        loading = false;
        StateHasChanged();
    }

