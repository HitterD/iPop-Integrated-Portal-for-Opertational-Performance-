    private async Task HandleCalendarMove((CalendarTaskDto Task, DateOnly Day) arg)
    {
        var (start, due) = ProjectCalendarLayout.MoveTo(arg.Task, arg.Day);
        var oldStart = arg.Task.StartDate;
        var oldDue = arg.Task.DueDate;
        if (!await SaveTaskDates(arg.Task.Id, start, due)) { Toasts.Show("Couldn't change the task dates.", ToastKind.Error); return; }
        Toasts.ShowUndo($"\"{arg.Task.Title}\" moved to {DatePickerMath.FormatDateCompact(arg.Day)}.", async () =>
        {
            if (!await SaveTaskDates(arg.Task.Id, oldStart, oldDue)) Toasts.Show("Couldn't restore the dates.", ToastKind.Error);
            await InvokeAsync(StateHasChanged);
        }, "Undo", 8000);
    }

    private async Task<bool> SaveTaskDates(Guid taskId, DateTime? start, DateTime? due)
    {
