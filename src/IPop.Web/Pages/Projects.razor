    /// "Start from: Template" in New project: the server copies the template's tasks, then the
    /// new project opens.
    private async Task CreateProjectFromTemplate(ProjectCreateModal.CreateProjectModel m, Guid templateId)
    {
        if (creatingProject) return;
        creatingProject = true;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, "/api/projects/from-template", new
            {
                templateId, name = m.Name, description = m.Description, year = m.Year,
                deadline = m.Deadline is { } d ? DateTime.SpecifyKind(d.Date, DateTimeKind.Utc) : (DateTime?)null,
                ownerNik = m.OwnerNik, color = m.Color,
            });
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show($"Failed to create project: {(res.StatusCode == System.Net.HttpStatusCode.NotFound ? "that template no longer exists." : await ProjectErrorAsync(res))}", ToastKind.Error);
                return;
            }
            ProjectDto? created = null;
            try { created = await res.Content.ReadFromJsonAsync<ProjectDto>(); } catch { }
            showCreateModal = false;
            await ReloadProjects();
            Toasts.Show($"Project \"{m.Name}\" created from template.", ToastKind.Success);
            if (created is not null)
            {
                // The route change selects and loads it (OnParametersSetAsync).
                tab = 4;
                Nav.NavigateTo($"/projects/{created.Id}");
            }
        }
        catch { Toasts.Show("Failed to create project. Check your connection.", ToastKind.Error); }
        finally { creatingProject = false; }
    }

    /// The server's own reason for a failed project write. "check permissions" is only
    /// claimed on a real 403 — a 500 used to be reported as a permission problem too.
    private static async Task<string> ProjectErrorAsync(HttpResponseMessage res)
    {
        var status = (int)res.StatusCode;
        if (res.StatusCode == System.Net.HttpStatusCode.Forbidden)
            return "you don't have permission (check permissions).";
        string? code = null, message = null;
        try
        {
            var b = await res.Content.ReadFromJsonAsync<Dictionary<string, object>>();
            code = b?.GetValueOrDefault("code")?.ToString();
            message = b?.GetValueOrDefault("message")?.ToString();
        }
        catch { }
        return (code ?? message) switch
        {
            "invalid_name" => "a name is required (max 200 characters).",
            "invalid_year" => "the year must be between 2000 and 2100.",
            "invalid_owner" => "the selected owner was not found or is inactive.",
            "invalid_status" => "that status is not valid.",
            "project_not_found" => "the project no longer exists.",
            _ when !string.IsNullOrWhiteSpace(message) => message!,
            _ => status >= 500 ? $"server error ({status}). Please try again." : $"request failed ({status}).",
        };
    }

