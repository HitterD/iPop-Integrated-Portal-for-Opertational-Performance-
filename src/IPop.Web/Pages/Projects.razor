    private async Task LoadTaskList()
    {
        if (selectedProjectId == Guid.Empty) return;
        var url = $"/api/projects/{selectedProjectId}/tasks/list?page=1&pageSize=200{GroupQuery}";
        if (tab == 1 && listAssigneeId is { } memberId)
            url += $"&assigneeId={memberId}";
        else if (tab == 1 && listUnassignedOnly)
            url += "&unassigned=true";
        var first = await Auth.GetAsync<PagedResult<ProjectTaskDto>>(url);
        if (first is null) { taskList = new([], 0, 1, 50); return; }
        var all = first.Items.ToList();
        var pages = (int)Math.Ceiling(first.TotalCount / 200d);
        for (var page = 2; page <= pages; page++)
        {
            var nextUrl = url.Replace("page=1&", $"page={page}&");
            var next = await Auth.GetAsync<PagedResult<ProjectTaskDto>>(nextUrl);
            if (next is null) break;
            all.AddRange(next.Items);
        }
        taskList = new(all, first.TotalCount, 1, 200);
        if (projectFields.Count > 0)
        {
            var ids = all.Select(t => t.Id).ToList();
            for (var i = 0; i < ids.Count; i += 100)
            {
                var query = string.Join("&", ids.Skip(i).Take(100).Select(id => $"taskIds={id}"));
                var values = await Auth.GetAsync<List<ProjectTaskFieldValuesDto>>($"/api/projects/{selectedProjectId}/fields/values?{query}") ?? [];
                foreach (var row in values) taskFieldValues[row.TaskId] = row.Values.ToDictionary(v => v.FieldId, v => v.Value);
            }
        }
        if (!string.IsNullOrEmpty(listStatusFilter) && !taskList.Items.Any(t => t.Status == listStatusFilter))
            listStatusFilter = "";
    }

