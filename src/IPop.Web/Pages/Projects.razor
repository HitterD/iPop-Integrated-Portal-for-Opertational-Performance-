    private async Task LoadPortfolio()
    {
        portfolioLoading = true;
        try
        {
            portfolioData = await Auth.GetAsync<PortfolioDto>($"/api/projects/portfolio?localToday={DateTime.Today:yyyy-MM-dd}&page={portfolioData?.Projects.Page ?? 1}&pageSize=20");
            if (portfolioData is null) Toasts.Show("Couldn't load the project summary.", ToastKind.Error);
            if (portfolioTaskFilter is not null) await LoadPortfolioTaskPage(portfolioTasks?.Page ?? 1);
        }
        catch { portfolioData = null; Toasts.Show("Couldn't load the project summary.", ToastKind.Error); }
        finally { portfolioLoading = false; StateHasChanged(); }
    }

    private async Task LoadPortfolioProjectPage(int page)
    {
        var next = await Auth.GetAsync<PortfolioDto>($"/api/projects/portfolio?localToday={DateTime.Today:yyyy-MM-dd}&page={page}&pageSize=20");
        if (next is not null) portfolioData = next;
        StateHasChanged();
    }

    private async Task OpenPortfolioProject(Guid id)
    {
        Nav.NavigateTo($"/projects/{id}");
        var project = projects.FirstOrDefault(p => p.Id == id);
        if (project is not null) await SelectProjectFromList(project);
        else
        {
            selectedProjectId = id;
            selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{id}");
            portfolioSelected = false;
            await ReloadCurrentView();
            mDetail = true;
        }
