    private async Task HandleRemoveTeamMember(Guid userId)
    {
        if (selectedProjectId == Guid.Empty || !CanManageMembers) return;
        var member = projectMembers.FirstOrDefault(m => m.UserId == userId);
        if (member is null || member.Role == "owner") return;
        var assigned = workloadData?.ByAssignee.FirstOrDefault(a => a.UserId == userId)?.TaskCount ??
            AllCurrentTasks.Count(t => t.Assignees.Any(a => a.UserId == userId));
        var confirmed = await Confirm.AskAsync("Remove project member",
            $"Remove {member.Name} from this project? They will be unassigned from {assigned} task(s).",
            "Remove", danger: true);
        if (!confirmed) return;

        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/{selectedProjectId}/members/{userId}");
        if (res.IsSuccessStatusCode)
        {
            await ReloadCurrentView();
            Toasts.Show($"{member.Name} removed from the project.", ToastKind.Success);
            StateHasChanged();
        }
        else
        {
            Toasts.Show("Failed to remove member.", ToastKind.Error);
        }
    }

