    private Dictionary<string, object> CurrentViewState()
    {
        var state = new Dictionary<string, object> { ["tab"] = tab.ToString() };
        if (!string.IsNullOrWhiteSpace(priorityFilter)) state["priority"] = priorityFilter;
        if (!string.IsNullOrWhiteSpace(taskSearchQuery)) state["search"] = taskSearchQuery.Trim();
        if (myTasksOnly) state["myTasks"] = true;
        if (overdueOnly) state["overdue"] = true;
        if (selectedGroupId is { } g) state["groupId"] = g.ToString();
        if (tab == 1 && listAssigneeId is { } a) state["assigneeId"] = a.ToString();
        return state;
    }

    private static string StateKey(IDictionary<string, object> state) =>
        string.Join("|", state.Where(kv => kv.Key != "tab").OrderBy(kv => kv.Key).Select(kv => $"{kv.Key}={kv.Value}".ToLowerInvariant()));

    private bool FiltersDifferFromDefault => CurrentViewState().Count > 1;

    private Guid? ActiveSavedViewId
    {
        get
        {
            var key = StateKey(CurrentViewState());
            if (key.Length == 0) return null;
            return savedViews.FirstOrDefault(v => ParseViewState(v.StateJson) is { } st && StateKey(st) == key
                && (!st.TryGetValue("tab", out var t) || t.ToString() == tab.ToString()))?.Id;
        }
    }

    private static Dictionary<string, object>? ParseViewState(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return doc.RootElement.EnumerateObject().ToDictionary(p => p.Name, p => (object)(p.Value.ValueKind switch
            {
                System.Text.Json.JsonValueKind.True => true,
                System.Text.Json.JsonValueKind.False => false,
                _ => p.Value.ToString(),
            }));
        }
        catch { return null; }
    }

    private async Task ApplySavedView(ProjectSavedViewDto view)
    {
        if (ParseViewState(view.StateJson) is not { } st) return;
        string Str(string k) => st.TryGetValue(k, out var v) ? v.ToString() ?? "" : "";
        bool Flag(string k) => st.TryGetValue(k, out var v) && v is true;
        Guid? Id(string k) => Guid.TryParse(Str(k), out var g) ? g : null;

        priorityFilter = Str("priority");
        taskSearchQuery = Str("search");
        myTasksOnly = Flag("myTasks");
        overdueOnly = Flag("overdue");
        selectedGroupId = Id("groupId") is { } gid && projectGroups.Any(g => g.Id == gid) ? gid : null;
        listUnassignedOnly = false;
        listAssigneeId = Id("assigneeId") is { } aid && projectMembers.Any(m => m.UserId == aid) ? aid : null;
        selectedTaskIds = new HashSet<Guid>();
        if (int.TryParse(Str("tab"), out var t) && t is >= 0 and <= 6) tab = t;
        await LoadKanban();
        await LoadTaskList();
        await LoadTimeline();
        if (tab == 3) await LoadWorkloadData();
        await ReloadCalendar();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

