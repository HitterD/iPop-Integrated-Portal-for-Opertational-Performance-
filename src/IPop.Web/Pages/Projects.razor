    private async Task ExecuteTaskMove(Guid taskId, string targetStatus)
    {
        // #37: completing from the List remembers row positions so the row can pop, strike, then glide.
        var animateDone = tab == 1 && targetStatus == "done";
        if (animateDone) { try { await JS.InvokeVoidAsync("ipopTaskMotion.prepare"); } catch { } }
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/projects/tasks/{taskId}/move", new TaskMoveRequest(targetStatus, null));
        if (res.IsSuccessStatusCode)
        {
            ProjectTaskDto? moved = null;
            try { moved = await res.Content.ReadFromJsonAsync<ProjectTaskDto>(); } catch { }
            await LoadKanban();
            await LoadTaskList();
            if (tab == 6) await ReloadCalendar();
            if (selectedProjectId != Guid.Empty)
                selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{selectedProjectId}");
            RefreshEditingTask();
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            if (animateDone) { try { await JS.InvokeVoidAsync("ipopTaskMotion.completed", taskId.ToString()); } catch { } }
            NotifyRecurringSpawn(moved);
        }
        else
        {
            var body = await res.Content.ReadAsStringAsync();
            if (body.Contains("unmet_dependencies"))
                Toasts.Show("Cannot move to Done — task dependencies are incomplete.", ToastKind.Error);
            else
                Toasts.Show("Failed to move task.", ToastKind.Error);
        }
    }

    private async Task HandleEvidenceConfirm((ProjectTaskDto Task, string TargetStatus, TaskEvidenceData Evidence) arg)
    {
        showEvidenceModal = false;
        if (bulkEvidenceStatus is { } bulkStatus)
        {
            bulkEvidenceStatus = null;
            evidenceTask = null;
            await RunBulk("status", bulkStatus, TaskEvidenceHelper.Serialize("", arg.Evidence));
            return;
        }
        var parsed = TaskEvidenceHelper.Parse(arg.Task.Description);
        var newDesc = TaskEvidenceHelper.Serialize(parsed.CleanDescription, arg.Evidence);

        // Evidence only; the status changes through /move below so its dependency guard applies
        // (a PUT with the target status would already set "done" and skip the guard).
        var updateReq = new UpdateTaskRequest(
            arg.Task.Title, newDesc, arg.Task.Status, arg.Task.Priority, arg.Task.StartDate, arg.Task.DueDate,
            arg.Task.EstimatedHours, arg.Task.ActualHours, null, null, null, null, null, arg.Task.Tags
        );
        await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{arg.Task.Id}", updateReq);
        await ExecuteTaskMove(arg.Task.Id, arg.TargetStatus);
        evidenceTask = null;
        Toasts.Show(arg.TargetStatus switch
        {
            "doing" => "Task moved to In Progress with progress notes.",
            "review" => "Task moved to Review with progress notes.",
            _ => "Task completed with deliverables evidence.",
        }, ToastKind.Success);
    }

