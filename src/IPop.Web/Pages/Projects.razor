    private async Task ExportSelected()
    {
        if (selectedProjectId == Guid.Empty) return;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Get, $"/api/projects/{selectedProjectId}/export.csv");
            if (!res.IsSuccessStatusCode)
            {
                Toasts.Show($"Export failed ({(int)res.StatusCode}).", ToastKind.Error);
                return;
            }
            var bytes = await res.Content.ReadAsByteArrayAsync();
            var stamp = DateTime.Now.ToString("yyyyMMdd-HHmm");
            var name = selectedProject?.Name ?? "tasks";
            await JS.InvokeVoidAsync("ipop.download", Convert.ToBase64String(bytes), $"project-{name}-{stamp}.csv");
            Toasts.Show("Project tasks exported to CSV successfully.", ToastKind.Success);
        }
        catch (Exception ex)
        {
            Toasts.Show($"Export failed: {ex.Message}", ToastKind.Error);
        }
    }

