    private async Task OpenPortfolioTasks((string Filter, Guid? ProjectId, Guid? AssigneeId) filter)
    {
        portfolioTaskFilter = filter;
        await LoadPortfolioTaskPage(1);
    }

    private async Task LoadPortfolioTaskPage(int page)
    {
        if (portfolioTaskFilter is not { } filter) return;
        var url = $"/api/projects/portfolio/tasks?filter={filter.Filter}&page={page}&pageSize=25&localToday={DateTime.Today:yyyy-MM-dd}";
        if (filter.ProjectId is { } projectId) url += $"&projectId={projectId}";
        if (filter.AssigneeId is { } assigneeId) url += $"&assigneeId={assigneeId}";
        portfolioTasks = await Auth.GetAsync<PagedResult<PortfolioTaskDto>>(url);
        StateHasChanged();
    }

    private Task ClosePortfolioTasks()
    {
        portfolioTasks = null;
        portfolioTaskFilter = null;
        return Task.CompletedTask;
    }

    private async Task OpenPortfolioTask((Guid ProjectId, Guid TaskId) target)
    {
        await OpenPortfolioProject(target.ProjectId);
        Nav.NavigateTo($"/projects/{target.ProjectId}?task={target.TaskId}");
        var task = await Auth.GetAsync<ProjectTaskDto>($"/api/projects/tasks/{target.TaskId}");
        if (task is not null) await OpenTaskEditor(task);
    }

    // ---- Phone layout (<= 767px): the project list is screen 1, the workspace is the detail ----
    // `m-detail` only changes layout inside the mobile media query; on desktop it is inert and
    // ipop.mobile.pushDetail is a no-op, so no history entries are added there.
    private bool mDetail;
    private DotNetObjectReference<Projects>? _mRef;

    private async Task SelectProjectFromList(ProjectListDto p)
    {
        await SelectProject(p);
        await OpenMobileDetail();
    }

    private async Task OpenMobileDetail()
    {
        mDetail = true;
        try
        {
            _mRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", _mRef, nameof(CloseMobileDetailFromHistory));
        }
        catch { /* mobile.js missing: the in-app back button still works */ }
    }

    private async Task CloseMobileDetail()
    {
        mDetail = false;
        try { await JS.InvokeVoidAsync("ipop.mobile.popDetail"); } catch { }
    }

    [JSInvokable]
    public void CloseMobileDetailFromHistory()
    {
        if (_disposed) return;
        mDetail = false;
        StateHasChanged();
    }

    private IDisposable? _projectSub;
    public void Dispose()
    {
        _disposed = true;
        try { _ = JS.InvokeVoidAsync("ipop.mobile.clearDetail"); } catch { }
        _mRef?.Dispose();
        _projectSub?.Dispose();
        Auth.HubReconnected -= OnHubReconnected;
        _liveCts?.Cancel();
        _liveCts?.Dispose();
    }
