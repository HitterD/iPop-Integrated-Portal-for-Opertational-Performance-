    // ---- Fase 2c: bulk actions on the List selection ----
    private IReadOnlySet<Guid> selectedTaskIds = new HashSet<Guid>();
    private bool bulkBusy;
    private string? bulkEvidenceStatus;

    private void ClearSelection() => selectedTaskIds = new HashSet<Guid>();

    private async Task HandleBulkAction((string Action, string? Value) arg)
    {
        if (selectedTaskIds.Count == 0) return;
        if (arg.Action == "status" && arg.Value is "doing" or "review" or "done")
        {
            // One shared evidence for every selected task; the modal only needs a task to title itself.
            var first = AllCurrentTasks.FirstOrDefault(t => selectedTaskIds.Contains(t.Id));
            if (first is null) return;
            bulkEvidenceStatus = arg.Value;
            evidenceTargetStatus = arg.Value;
            evidenceTask = first with { Id = Guid.Empty, Title = $"{selectedTaskIds.Count} selected {(selectedTaskIds.Count == 1 ? "task" : "tasks")}", Description = null };
            showEvidenceModal = true;
            return;
        }
        if (arg.Action == "delete"
            && !await Confirm.AskAsync("Delete selected tasks?", $"{selectedTaskIds.Count} {(selectedTaskIds.Count == 1 ? "task" : "tasks")} and their subtasks will be deleted. You can undo this for 8 seconds.", "Delete"))
            return;
        await RunBulk(arg.Action, arg.Value, null);
    }

    private async Task RunBulk(string action, string? value, string? evidence)
    {
        if (bulkBusy || selectedProjectId == Guid.Empty || selectedTaskIds.Count == 0) return;
        bulkBusy = true;
        var projectId = selectedProjectId;
        try
        {
            var res = await Auth.SendAsync(HttpMethod.Post, $"/api/projects/{projectId}/tasks/bulk",
                new BulkTaskRequest(selectedTaskIds.ToList(), action, value, evidence));
            BulkTaskResultDto? result = null;
            try { result = await res.Content.ReadFromJsonAsync<BulkTaskResultDto>(); } catch { }
            if (!res.IsSuccessStatusCode || result is null || !result.Success)
            {
                Toasts.Show(result?.Error switch
                {
                    "forbidden" => "You don't have access to do this.",
                    "invalid_tasks" => "Some tasks no longer exist. Reload and try again.",
                    _ => "Couldn't run the bulk action.",
                }, ToastKind.Error);
                return;
            }
            if (action == "delete") await LeaveTasks(selectedTaskIds.ToList());
            selectedTaskIds = new HashSet<Guid>();
            await ReloadCurrentView();
            RefreshEditingTask();
            if (action == "delete" && result.BatchId is { } batchId)
                Toasts.ShowUndo($"{result.Updated} {(result.Updated == 1 ? "task" : "tasks")} deleted.", () => RestoreTasks(projectId, batchId), "Undo", 8000);
            else
                Toasts.Show($"{result.Updated} {(result.Updated == 1 ? "task" : "tasks")} updated.", ToastKind.Success);
            var blocked = result.Skipped.Count(x => x.Reason == "unmet_dependencies");
            var tooLong = result.Skipped.Count(x => x.Reason == "description_too_long");
            var parentFirst = result.Skipped.Count(x => x.Reason == "move_parent_instead");
            if (blocked > 0) Toasts.Show($"{blocked} {(blocked == 1 ? "task" : "tasks")} skipped: waiting on other tasks.", ToastKind.Warning);
            if (tooLong > 0) Toasts.Show($"{tooLong} {(tooLong == 1 ? "task" : "tasks")} skipped: description too long for evidence.", ToastKind.Warning);
            if (parentFirst > 0) Toasts.Show($"{parentFirst} {(parentFirst == 1 ? "subtask" : "subtasks")} skipped: move the parent task instead.", ToastKind.Warning);
        }
        finally
        {
            bulkBusy = false;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
    }

