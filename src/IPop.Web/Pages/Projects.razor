@page "/projects"
@page "/projects/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@using IPop.Web.Services
@using IPop.Application.Projects
@using IPop.Web.Components.Projects
@attribute [Authorize]
@implements IDisposable
@inject AuthState Auth
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Project Management - iPop</PageTitle>

<div class="proj-workspace">
    @* Left Project Navigator Sidebar *@
    <ProjectSidebar
        Projects="filteredProjects"
        SelectedProjectId="selectedProjectId"
        SelectedYear="selectedYear"
        AvailableYears="availableYears"
        SearchQuery="@searchProjectQuery"
        IsCollapsed="sidebarCollapsed"
        Loading="loading"
        OnSelectProject="SelectProject"
        OnToggleSidebar="() => sidebarCollapsed = !sidebarCollapsed"
        OnYearChanged="SetYearFilter"
        OnSearchChanged="HandleProjectSearch"
        OnCreateClick="() => showCreateModal = true" />

    @* Main Project Workspace Canvas *@
    <main class="proj-canvas" id="project-detail" role="region" aria-label="Project Workspace">
        @if (selectedProjectId == Guid.Empty || selectedProject is null)
        {
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center">
                <div style="width:64px;height:64px;border-radius:18px;background:var(--accent-soft);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;margin-bottom:16px">
                    <i data-lucide="layers" style="width:32px;height:32px"></i>
                </div>
                <h3 style="font-size:18px;font-weight:700;margin:0 0 6px">Select or Create a Project</h3>
                <p style="font-size:13px;color:var(--ink-2);max-width:380px;line-height:1.5;margin:0 0 20px">
                    Manage team tasks with Kanban Boards, Structured Tables, Visual Timelines, and Workload Distribution.
                </p>
                <button class="btn-sm accent" style="padding:8px 16px;font-size:13px" @onclick="() => showCreateModal = true">
                    <i data-lucide="plus"></i> Create New Project
                </button>
            </div>
        }
        else
        {
            @* Canvas Header *@
            <ProjectHeader
                Project="selectedProject"
                Members="projectMembers"
                OnOpenTeamModal="() => showTeamModal = true"
                OnOpenEditModal="() => showEditModal = true"
                OnOpenChatRoom="OpenProjectRoom"
                OnExport="ExportSelected"
                OnStatusChanged="HandleProjectStatusChange"
                OnCopyLink="CopyProjectLink"
                OnDeleteProject="HandleDeleteProject"
                OnMarkCompleted="HandleMarkProjectCompleted" />

            @* Canvas View Switcher Bar (Overview / Board / List / Timeline / Workload) *@
            <div class="proj-canvas-bar">
                <div class="proj-tabs">
                    <button class="proj-tab-btn @(tab == 4 ? "active" : "")" @onclick="() => SwitchTab(4)" title="Overview & Progress">
                        <i data-lucide="pie-chart"></i> Overview
                    </button>
                    <button class="proj-tab-btn @(tab == 0 ? "active" : "")" @onclick="() => SwitchTab(0)">
                        <i data-lucide="kanban"></i> Board
                    </button>
                    <button class="proj-tab-btn @(tab == 1 ? "active" : "")" @onclick="() => SwitchTab(1)">
                        <i data-lucide="list"></i> List
                    </button>
                    <button class="proj-tab-btn @(tab == 2 ? "active" : "")" @onclick="() => SwitchTab(2)">
                        <i data-lucide="clock"></i> Timeline
                    </button>
                    <button class="proj-tab-btn @(tab == 3 ? "active" : "")" @onclick="() => SwitchTab(3)">
                        <i data-lucide="bar-chart-2"></i> Workload
                    </button>
                    <button class="proj-tab-btn @(tab == 5 ? "active" : "")" @onclick="() => SwitchTab(5)" title="Plans & Reports: templates, milestones, burndown, velocity">
                        <i data-lucide="clipboard-list"></i> Plans &amp; Reports
                    </button>
                </div>

                <div class="proj-bar-right">
                    <div class="v6-search proj-task-search">
                        <i data-lucide="search"></i>
                        <input type="search" placeholder="Search tasks or tags" aria-label="Search tasks" @bind="taskSearchQuery" @bind:event="oninput" />
                    </div>
                    <div class="proj-filter-wrap">
                        <button type="button" class="ghost-btn @(ActiveTaskFilterCount > 0 ? "on" : "")" aria-expanded="@filterOpen" @onclick="() => filterOpen = !filterOpen">
                            <i data-lucide="sliders-horizontal"></i>Filter
                            @if (ActiveTaskFilterCount > 0) { <span class="n">@ActiveTaskFilterCount</span> }
                        </button>
                        @if (filterOpen)
                        {
                            <div class="proj-filter-pop" @onclick:stopPropagation="true">
                                <label class="pf-row"><input type="checkbox" @bind="myTasksOnly" /><i data-lucide="user"></i>My tasks</label>
                                <label class="pf-row"><input type="checkbox" @bind="overdueOnly" /><i data-lucide="clock-alert"></i>Overdue only</label>
                                <div class="pf-label">Priority</div>
                                <select class="pf-select" aria-label="Priority" @bind="priorityFilter">
                                    <option value="">All priorities</option>
                                    <option value="urgent">Urgent</option>
                                    <option value="high">High</option>
                                    <option value="normal">Normal</option>
                                    <option value="low">Low</option>
                                </select>
                                <div class="pf-sep"></div>
                                <button type="button" class="pf-row btn" @onclick="() => { filterOpen = false; ToggleQuickViewerToolbar(); }"><i data-lucide="panel-right-open"></i>@(quickViewerTaskId.HasValue ? "Close quick viewer" : "Open quick viewer")</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="proj-bar-2">
                <button type="button" class="btn-primary" @onclick='() => HandleQuickAdd(("todo", "New Task"))'>
                    <i data-lucide="plus"></i>Add task
                </button>
                <span class="meta">@VisibleTaskCount tasks</span>
            </div>

            @* Canvas Body Content *@
            <div class="proj-canvas-body">
                @if (myTasksOnly || overdueOnly || !string.IsNullOrWhiteSpace(priorityFilter) || !string.IsNullOrWhiteSpace(taskSearchQuery))
                {
                    <div style="display:flex;align-items:center;gap:6px;padding:6px 14px;background:var(--surface-sunken);border-radius:10px;margin-bottom:10px;flex-wrap:wrap">
                        <span style="font-size:11.5px;color:var(--ink-3);font-weight:600">@VisibleTaskCount tasks matching:</span>
                        @if (myTasksOnly)
                        {
                            <span class="chip" style="font-size:11px;background:var(--surface);border:1px solid var(--line);padding:2px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px">
                                My Tasks <button type="button" style="border:none;background:none;cursor:pointer;padding:0;color:var(--ink-3)" @onclick="() => myTasksOnly = false">×</button>
                            </span>
                        }
                        @if (overdueOnly)
                        {
                            <span class="chip" style="font-size:11px;background:var(--surface);border:1px solid var(--line);padding:2px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px">
                                Overdue <button type="button" style="border:none;background:none;cursor:pointer;padding:0;color:var(--ink-3)" @onclick="() => overdueOnly = false">×</button>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(priorityFilter))
                        {
                            <span class="chip" style="font-size:11px;background:var(--surface);border:1px solid var(--line);padding:2px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px">
                                @priorityFilter <button type="button" style="border:none;background:none;cursor:pointer;padding:0;color:var(--ink-3)" @onclick='() => priorityFilter = ""'>×</button>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(taskSearchQuery))
                        {
                            <span class="chip" style="font-size:11px;background:var(--surface);border:1px solid var(--line);padding:2px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px">
                                "@taskSearchQuery" <button type="button" style="border:none;background:none;cursor:pointer;padding:0;color:var(--ink-3)" @onclick='() => taskSearchQuery = ""'>×</button>
                            </span>
                        }
                        <button type="button" class="ghost-btn" style="height:22px;font-size:11px;padding:0 8px;margin-left:auto" @onclick="ClearTaskFilters">Clear all</button>
                    </div>
                }

                @if (tab == 4)
                {
                    <ProjectExecutiveDashboard
                        Project="selectedProject"
                        AllTasks="AllCurrentTasks"
                        Members="projectMembers"
                        OnInspectTask="OpenQuickViewer"
                        OnRequestExtension="OpenExtensionModal" />
                }
                else
                {
                    <div class="proj-canvas-split-container">
                        <div class="proj-canvas-split-main">
                            @if (tab == 0)
                            {
                                <ProjectKanbanBoard
                                    Kanban="kanban"
                                    Members="projectMembers"
                                    SearchQuery="@taskSearchQuery"
                                    MyTasksOnly="myTasksOnly"
                                    OverdueOnly="overdueOnly"
                                    PriorityFilter="@priorityFilter"
                                    CurrentUserNik="@currentUserNik"
                                    HighlightTaskId="highlightTaskId"
                                    OnTaskClick="OpenTaskEditor"
                                    OnTaskMove="HandleTaskMove"
                                    OnToggleComplete="ToggleTaskComplete"
                                    OnQuickAdd="HandleQuickAdd"
                                    OnToggleAssignee="HandleToggleAssignee"
                                    OnRequestExtension="OpenExtensionModal"
                                    OnQuickViewTask="OpenQuickViewer" />
                            }
                            else if (tab == 1)
                            {
                                <ProjectTableView
                                    Tasks="taskList.Items.ToList()"
                                    Members="projectMembers"
                                    SearchQuery="@taskSearchQuery"
                                    MyTasksOnly="myTasksOnly"
                                    OverdueOnly="overdueOnly"
                                    PriorityFilter="@priorityFilter"
                                    CurrentUserNik="@currentUserNik"
                                    StatusFilter="@listStatusFilter"
                                    OnTaskClick="OpenTaskEditor"
                                    OnFilterChanged="s => listStatusFilter = s"
                                    OnStatusChangeDirect="HandleStatusChangeDirect"
                                    OnPriorityChangeDirect="HandlePriorityChangeDirect"
                                    OnDueDateChangeDirect="HandleDueDateChangeDirect"
                                    OnEstimateChangeDirect="HandleEstimateChangeDirect"
                                    OnQuickAddSubtask="HandleQuickAddSubtask"
                                    OnQuickAdd="HandleQuickAdd"
                                    OnToggleAssignee="HandleToggleAssignee"
                                    OnRequestExtension="OpenExtensionModal"
                                    OnQuickViewTask="OpenQuickViewer" />
                            }
                            else if (tab == 2)
                            {
                                <ProjectTimelineView
                                    Timeline="timeline"
                                    AllTasks="AllCurrentTasks"
                                    CriticalPathTaskIds="criticalPathIds"
                                    OnTaskClick="OpenTimelineTaskEditor"
                                    OnAddTask='() => HandleQuickAdd(("todo", "New Task"))' />
                            }
                            else if (tab == 3)
                            {
                                <ProjectWorkloadView
                                    Workload="workloadData"
                                    AllTasks="AllCurrentTasks"
                                    OnTaskClick="OpenTaskEditor"
                                    OnUnassign="HandleWorkloadUnassign"
                                    OnReassign="HandleWorkloadReassign" />
                            }
                            else if (tab == 5)
                            {
                                <ProjectReportsPanel Project="selectedProject" AllTasks="AllCurrentTasks" />
                            }
                        </div>

                        @if (quickViewerTaskId.HasValue && quickViewerTask is not null)
                        {
                            <ProjectTaskQuickViewer
                                Task="quickViewerTask"
                                AllTasks="AllCurrentTasks"
                                Members="projectMembers"
                                OnSelectTask="SelectQuickViewerTask"
                                OnSave="HandleSaveTask"
                                OnOpenFullDrawer="OpenTaskEditor"
                                OnRequestExtension="OpenExtensionModal"
                                OnClose="() => quickViewerTaskId = null" />
                        }
                    </div>
                }
            </div>
        }
    </main>
</div>

@* Modals & Drawers *@
@if (showEvidenceModal && evidenceTask is not null)
{
    <ProjectStatusEvidenceModal
        IsOpen="showEvidenceModal"
        Task="evidenceTask"
        TargetStatus="@evidenceTargetStatus"
        OnConfirm="HandleEvidenceConfirm"
        OnCancel="() => { showEvidenceModal = false; evidenceTask = null; }" />
}

@if (showExtensionModal && extensionTask is not null)
{
    <ProjectDeadlineExtensionModal
        IsOpen="showExtensionModal"
        Task="extensionTask"
        OnConfirm="HandleExtensionConfirm"
        OnCancel="() => { showExtensionModal = false; extensionTask = null; }" />
}

@if (showTaskEditor && editingTask is not null)
{
    <ProjectTaskDrawer
        Task="editingTask"
        Members="projectMembers"
        Subtasks="subtasks"
        OnClose="CloseTaskEditor"
        OnSave="HandleSaveTask"
        OnDelete="HandleDeleteTask"
        OnToggleAssignee="HandleToggleAssignee"
        OnAddSubtask="HandleAddSubtask"
        OnToggleSubtask="HandleToggleSubtask"
        OnDeleteSubtask="HandleDeleteSubtask" />
}

@if (showCreateModal)
{
    <ProjectCreateModal
        OnClose="() => showCreateModal = false"
        OnSubmit="HandleSubmitCreateProject" />
}

@if (showEditModal && selectedProject is not null)
{
    <ProjectEditModal
        Project="selectedProject"
        OnClose="() => showEditModal = false"
        OnSubmit="HandleSubmitEditProject" />
}

@if (showTeamModal && selectedProject is not null)
{
    <ProjectTeamModal
        Members="projectMembers"
        OnClose="() => showTeamModal = false"
        OnAddMember="HandleAddTeamMember"
        OnRemoveMember="HandleRemoveTeamMember" />
}

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    [Parameter] public Guid? ProjectId { get; set; }

    private bool loading = true;
    private bool sidebarCollapsed = false;
    private bool myTasksOnly = false;
    private bool overdueOnly = false;
    private string priorityFilter = "";
    private HashSet<Guid> criticalPathIds = [];
    private string? currentUserNik;

    private int VisibleTaskCount
    {
        get
        {
            var tasks = AllCurrentTasks.AsEnumerable();
            if (myTasksOnly)
                tasks = tasks.Where(t => ProjectUiHelpers.IsAssignedToUser(t, currentUserNik));
            if (overdueOnly)
                tasks = tasks.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "done");
            if (!string.IsNullOrWhiteSpace(priorityFilter))
                tasks = tasks.Where(t => string.Equals(t.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(taskSearchQuery))
            {
                var q = taskSearchQuery.Trim().ToLowerInvariant();
                tasks = tasks.Where(t => t.Title.ToLowerInvariant().Contains(q) || (t.Tags != null && t.Tags.ToLowerInvariant().Contains(q)));
            }
            return tasks.Count();
        }
    }

    private void ClearTaskFilters()
    {
        myTasksOnly = false;
        overdueOnly = false;
        priorityFilter = "";
        taskSearchQuery = "";
    }

    private List<ProjectListDto> projects = [];
    private List<ProjectListDto> filteredProjects = [];
    private int? selectedYear;
    private List<int> availableYears = [];
    private string searchProjectQuery = "";

    private ProjectDto? selectedProject;
    private Guid selectedProjectId;
    private KanbanBoardDto? kanban;
    private PagedResult<ProjectTaskDto> taskList = new([], 0, 1, 50);
    private ProjectTimelineDto? timeline;
    private ProjectWorkloadDto? workloadData;
    private List<ProjectMemberDto> projectMembers = [];

    private int tab = 0; // 0=Board, 1=Table, 2=Timeline, 3=Workload
    private string taskSearchQuery = "";
    private string listStatusFilter = "";
    private Guid? highlightTaskId;

    // Task Inspector Drawer state
    private ProjectTaskDto? editingTask;
    private bool showTaskEditor;
    private List<ProjectTaskDto> subtasks = [];

    // Task Evidence Modal state
    private bool showEvidenceModal;
    private ProjectTaskDto? evidenceTask;
    private string evidenceTargetStatus = "doing";

    private bool filterOpen;
    private int ActiveTaskFilterCount => (myTasksOnly ? 1 : 0) + (overdueOnly ? 1 : 0) + (string.IsNullOrWhiteSpace(priorityFilter) ? 0 : 1);

    // Quick Viewer state
    private Guid? quickViewerTaskId;
    private ProjectTaskDto? quickViewerTask => quickViewerTaskId.HasValue ? AllCurrentTasks.FirstOrDefault(t => t.Id == quickViewerTaskId.Value) : null;

    // Deadline Extension Modal state
    private bool showExtensionModal;
    private ProjectTaskDto? extensionTask;

    // Modals state
    private bool showCreateModal;
    private bool showEditModal;
    private bool showTeamModal;

    private List<ProjectTaskDto> AllCurrentTasks =>
        taskList.Items.Concat(kanban?.Todo ?? []).Concat(kanban?.Doing ?? []).Concat(kanban?.Done ?? []).DistinctBy(x => x.Id).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await Auth.GetAsync<DirectoryEmployeeDto>("/api/directory/me");
            if (me is not null) currentUserNik = me.Nik;
        }
        catch { }

        await ReloadProjects();
        _projectSub = Auth.On<Guid>(IPop.Application.Realtime.RealtimeEvents.ProjectChanged, async pid =>
        {
            if (pid == selectedProjectId)
            {
                await InvokeAsync(async () =>
                {
                    await ReloadCurrentView();
                    StateHasChanged();
                });
            }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId is not null && ProjectId != selectedProjectId)
        {
            var found = projects.FirstOrDefault(p => p.Id == ProjectId.Value);
            if (found is not null)
            {
                await SelectProject(found);
            }
            else
            {
                var proj = await Auth.GetAsync<ProjectDto>($"/api/projects/{ProjectId.Value}");
                if (proj is not null)
                {
                    selectedProjectId = ProjectId.Value;
                    selectedProject = proj;
                    await LoadMembers();
                    await LoadKanban();
                    await LoadTaskList();
                    await LoadTimeline();
                    StateHasChanged();
                }
                else
                {
                    Toasts.Show("Project not found or you are not a member.");
                    Nav.NavigateTo("/projects", replace: true);
                    return;
                }
            }

            await Task.Delay(50);
            await JS.InvokeVoidAsync("ipop.scrollIntoView", "project-detail");

            var taskIdStr = QueryValue("task");
            if (!string.IsNullOrEmpty(taskIdStr) && Guid.TryParse(taskIdStr, out var targetTask))
            {
                await HighlightTask(targetTask);
                Nav.NavigateTo($"/projects/{ProjectId.Value}", replace: true);
            }
        }
        else if (ProjectId is null)
        {
            highlightTaskId = null;
            if (selectedProjectId == Guid.Empty && filteredProjects.Count > 0)
            {
                await SelectProject(filteredProjects[0]);
            }

            var taskIdStr = QueryValue("task");
            if (!string.IsNullOrEmpty(taskIdStr) && Guid.TryParse(taskIdStr, out var targetTask))
            {
                await HighlightTask(targetTask);
                Nav.NavigateTo("/projects", replace: true);
            }
        }

        if (QueryValue("newTask") == "1")
        {
            if (selectedProjectId != Guid.Empty)
            {
                tab = 0;
                await HandleQuickAdd(("todo", "New Task"));
            }
            else
            {
                showCreateModal = true;
            }
            Nav.NavigateTo(ProjectId is null ? "/projects" : $"/projects/{ProjectId.Value}", replace: true);
        }
    }

    private async Task HighlightTask(Guid taskId)
    {
        var inKanban = (kanban?.Todo ?? []).Any(t => t.Id == taskId)
            || (kanban?.Doing ?? []).Any(t => t.Id == taskId)
            || (kanban?.Done ?? []).Any(t => t.Id == taskId);
        if (!inKanban) return;

        tab = 0;
        highlightTaskId = taskId;
        var foundTask = AllCurrentTasks.FirstOrDefault(t => t.Id == taskId);
        if (foundTask != null)
        {
            await OpenTaskEditor(foundTask);
        }
        StateHasChanged();
        await Task.Delay(80);
        try { await JS.InvokeVoidAsync("ipop.scrollIntoView", $"task-card-{taskId}"); } catch { }

        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            highlightTaskId = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private string? QueryValue(string key)
    {
        var q = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) continue;
            if (!part[..eq].Equals(key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(part[(eq + 1)..]);
        }
        return null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Layout is not null)
        {
            Layout.SetHeader("Projects", "Kanban · Table · Timeline · Workload");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task ReloadProjects()
    {
        loading = true;
        StateHasChanged();

        var url = "/api/projects?page=1&pageSize=200";
        if (selectedYear.HasValue) url += $"&year={selectedYear.Value}";

        var res = await Auth.GetAsync<PagedResult<ProjectListDto>>(url);
        projects = res?.Items?.ToList() ?? [];
        Layout?.SetSubtitle($"{projects.Count} {(projects.Count == 1 ? "project" : "projects")} · {projects.Sum(p => p.TaskCount)} tasks");
        ApplyProjectFilter();

        availableYears = projects.Select(p => p.Year).Distinct().OrderByDescending(y => y).ToList();

        if (selectedProjectId == Guid.Empty && filteredProjects.Count > 0)
        {
            await SelectProject(filteredProjects[0]);
        }

        loading = false;
        StateHasChanged();
    }

    private void SetYearFilter(int? year)
    {
        selectedYear = year;
        ApplyProjectFilter();
    }

    private void HandleProjectSearch(string q)
    {
        searchProjectQuery = q;
        ApplyProjectFilter();
    }

    private void ApplyProjectFilter()
    {
        var list = projects.AsEnumerable();
        if (selectedYear.HasValue)
            list = list.Where(p => p.Year == selectedYear.Value);
        if (!string.IsNullOrWhiteSpace(searchProjectQuery))
            list = list.Where(p => p.Name.Contains(searchProjectQuery, StringComparison.OrdinalIgnoreCase) || p.OwnerName.Contains(searchProjectQuery, StringComparison.OrdinalIgnoreCase));
        filteredProjects = list.ToList();
    }

    private async Task SelectProject(ProjectListDto p)
    {
        selectedProjectId = p.Id;
        var proj = await Auth.GetAsync<ProjectDto>($"/api/projects/{p.Id}");
        if (p.Id != selectedProjectId) return;
        selectedProject = proj;

        await LoadMembers();
        await LoadKanban();
        await LoadTaskList();
        await LoadTimeline();
        if (tab == 3) await LoadWorkloadData();

        StateHasChanged();
    }

    private async Task SwitchTab(int newTab)
    {
        tab = newTab;
        if (tab == 3) await LoadWorkloadData();
        StateHasChanged();
    }

    private async Task ReloadCurrentView()
    {
        if (selectedProjectId == Guid.Empty) return;
        await LoadMembers();
        await LoadKanban();
        await LoadTaskList();
        await LoadTimeline();
        if (tab == 3) await LoadWorkloadData();
    }

    private async Task LoadWorkloadData()
    {
        if (selectedProjectId == Guid.Empty) return;
        workloadData = await Auth.GetAsync<ProjectWorkloadDto>($"/api/projects/{selectedProjectId}/workload");
        StateHasChanged();
    }

    private async Task OpenProjectRoom()
    {
        if (selectedProjectId == Guid.Empty) return;
        var room = await Auth.GetAsync<ProjectChatRoomDto>($"/api/projects/{selectedProjectId}/chat-room");
        if (room is null || room.RoomId == Guid.Empty)
        {
            Toasts.Show("Project chat room is unavailable.");
            return;
        }
        if (!room.IsActive)
        {
            Toasts.Show("Project chat room is inactive.");
            return;
        }
        Nav.NavigateTo($"/chat/{room.RoomId}");
    }

    private async Task LoadKanban()
    {
        if (selectedProjectId == Guid.Empty) return;
        kanban = await Auth.GetAsync<KanbanBoardDto>($"/api/projects/{selectedProjectId}/kanban");
    }

    private async Task LoadTaskList()
    {
        if (selectedProjectId == Guid.Empty) return;
        taskList = await Auth.GetAsync<PagedResult<ProjectTaskDto>>($"/api/projects/{selectedProjectId}/tasks/list?page=1&pageSize=100") ?? new([], 0, 1, 50);
        if (!string.IsNullOrEmpty(listStatusFilter) && !taskList.Items.Any(t => t.Status == listStatusFilter))
        {
            listStatusFilter = "";
        }
    }

    private async Task LoadTimeline()
    {
        if (selectedProjectId == Guid.Empty) return;
        timeline = await Auth.GetAsync<ProjectTimelineDto>($"/api/projects/{selectedProjectId}/timeline");
        try
        {
            var gantt = await Auth.GetAsync<ProjectGanttDto>($"/api/projects/{selectedProjectId}/gantt");
            criticalPathIds = gantt?.CriticalPathTaskIds?.ToHashSet() ?? [];
        }
        catch { }
    }

    private async Task HandleProjectStatusChange(string newStatus)
    {
        if (selectedProject == null) return;
        var res = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/{selectedProject.Id}", new
        {
            name = selectedProject.Name,
            status = newStatus
        });
        if (res.IsSuccessStatusCode)
        {
            Toasts.Show($"Project status updated to {newStatus}.", ToastKind.Success);
            await ReloadProjects();
        }
        else
        {
            Toasts.Show("Could not update project status.", ToastKind.Error);
        }
    }

    private async Task HandleMarkProjectCompleted()
    {
