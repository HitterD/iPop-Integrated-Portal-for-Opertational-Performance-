    private async Task ReorderGroup((Guid Id, int Offset) change)
    {
        var groups = projectGroups.OrderBy(g => g.SortOrder).ToList();
        var index = groups.FindIndex(g => g.Id == change.Id);
        var target = index + change.Offset;
        if (index < 0 || target < 0 || target >= groups.Count) return;
        (groups[index], groups[target]) = (groups[target], groups[index]);
        var result = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/{selectedProjectId}/groups/order", new ReorderProjectGroupsRequest(groups.Select(g => g.Id).ToList()));
        if (!result.IsSuccessStatusCode) Toasts.Show("Couldn't save the group order.", ToastKind.Error);
        await LoadGroups();
        StateHasChanged();
    }

    private async Task DeleteGroup(Guid id)
    {
        var group = projectGroups.FirstOrDefault(g => g.Id == id);
        if (group is null || projectGroups.Count <= 1) return;
        var result = await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/groups/{id}");
        if (!result.IsSuccessStatusCode) { Toasts.Show("Couldn't delete the group.", ToastKind.Error); return; }
        var deleted = (await result.Content.ReadFromJsonAsync<DeleteGroupResultDto>())?.Deleted;
        await ReloadCurrentView();
        StateHasChanged();
        if (deleted is null) return;
        var moved = deleted.TaskIds.Count;
        Toasts.ShowUndo(moved == 0 ? $"Group \"{deleted.Name}\" deleted." : $"Group \"{deleted.Name}\" deleted, {moved} {(moved == 1 ? "task" : "tasks")} moved.",
            () => RestoreGroup(deleted), "Undo", 8000);
    }

    private async Task RestoreGroup(DeletedProjectGroupDto deleted)
    {
        var result = await Auth.SendAsync(HttpMethod.Post, $"/api/projects/{deleted.ProjectId}/groups/restore", deleted);
        if (!result.IsSuccessStatusCode) { Toasts.Show("Couldn't restore the group.", ToastKind.Error); return; }
        if (deleted.ProjectId == selectedProjectId) await ReloadCurrentView();
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleTaskMove((Guid TaskId, string TargetStatus) arg)
    {
        var task = AllCurrentTasks.FirstOrDefault(t => t.Id == arg.TaskId);
        if (task != null && (arg.TargetStatus == "doing" || arg.TargetStatus == "review" || arg.TargetStatus == "done") && task.Status != arg.TargetStatus)
        {
            evidenceTask = task;
            evidenceTargetStatus = arg.TargetStatus;
            showEvidenceModal = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
