    private async Task HandleDeleteProject()
    {
        if (selectedProject == null) return;
        var confirmed = await Confirm.AskAsync("Delete Project", $"Are you sure you want to delete project \"{selectedProject.Name}\"?", "Delete", danger: true);
        if (!confirmed) return;
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/{selectedProject.Id}", null);
        if (res.IsSuccessStatusCode)
        {
            Toasts.Show("Project deleted.", ToastKind.Success);
            selectedProjectId = Guid.Empty;
            selectedProject = null;
            await ReloadProjects();
        }
        else
        {
            Toasts.Show("Could not delete project.", ToastKind.Error);
        }
    }

    private async Task CopyProjectLink()
