    private async Task HandleSaveTask(ProjectTaskDrawer.TaskSaveModel m)
    {
        var targetTask = editingTask ?? AllCurrentTasks.FirstOrDefault(t => t.Id == m.Id);
        if (targetTask is null) return;
        var req = new UpdateTaskRequest(
            m.Title, m.Description, m.Status, m.Priority, m.StartDate, m.DueDate,
            m.EstimatedHours, m.ActualHours, null, null, null, null, null, m.Tags
        );
        var res = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{m.Id}", req);
        if (res.IsSuccessStatusCode)
        {
            ProjectTaskDto? saved = null;
            try { saved = await res.Content.ReadFromJsonAsync<ProjectTaskDto>(); } catch { }
            NotifyRecurringSpawn(saved);
            if (tab == 6) await ReloadCalendar();
            await LoadKanban();
            await LoadTaskList();
            await LoadTimeline();
            if (tab == 3) await LoadWorkloadData();
            if (selectedProjectId != Guid.Empty)
                selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{selectedProjectId}");
            if (showTaskEditor) CloseTaskEditor();
            Toasts.Show("Task saved successfully.", ToastKind.Success);
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        else
        {
            Toasts.Show("Failed to save task.", ToastKind.Error);
        }
    }

