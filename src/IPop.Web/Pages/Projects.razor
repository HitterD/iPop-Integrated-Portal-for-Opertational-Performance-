    private async Task HandleToggleAssignee((Guid TaskId, Guid UserId, bool IsAssigned) arg)
    {
        if (selectedProjectId == Guid.Empty) return;
        HttpResponseMessage res = arg.IsAssigned
            ? await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/tasks/{arg.TaskId}/assignees/{arg.UserId}")
            : await Auth.SendAsync(HttpMethod.Post, $"/api/projects/tasks/{arg.TaskId}/assignees", new AddProjectMemberRequest(arg.UserId, "assignee"));

        if (res.IsSuccessStatusCode)
        {
            await LoadKanban();
            await LoadTaskList();
            await LoadTimeline();

            if (editingTask != null && editingTask.Id == arg.TaskId)
            {
                var refreshed = AllCurrentTasks.FirstOrDefault(x => x.Id == arg.TaskId);
                if (refreshed != null) editingTask = refreshed;
            }

            Toasts.Show(arg.IsAssigned ? "Member unassigned from task." : "Member assigned to task.");
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        else
        {
            Toasts.Show("Failed to update task assignment.");
        }
    }

