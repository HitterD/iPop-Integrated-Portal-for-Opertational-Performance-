    private async Task HandleExtensionConfirm((ProjectTaskDto Task, DateTime NewDueDate, string Reason, string? AttachmentName, string? AttachmentDataUrl) arg)
    {
        showExtensionModal = false;
        var (task, newDue, reason, attName, attDataUrl) = arg;
        var parsed = TaskEvidenceHelper.Parse(task.Description);
        var extRecord = new TaskExtensionRecord
        {
            OriginalDueDate = task.DueDate,
            NewDueDate = newDue,
            Reason = reason,
            AttachmentName = attName,
            AttachmentDataUrl = attDataUrl,
            RequestedAt = DateTime.UtcNow
        };
        parsed.Evidence.ExtensionHistory.Add(extRecord);

        if (!string.IsNullOrEmpty(attDataUrl))
        {
            try
            {
                await Auth.SetUserSettingAsync($"ipop_evidence_{extRecord.Id}", attDataUrl);
            }
            catch {}
        }

        var newDesc = TaskEvidenceHelper.Serialize(parsed.CleanDescription, parsed.Evidence);
        var req = new UpdateTaskRequest(
            task.Title, newDesc, task.Status, task.Priority, task.StartDate, newDue,
            task.EstimatedHours, task.ActualHours, null, null, null, null, null, task.Tags
        );

        var res = await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{task.Id}", req);
        if (res.IsSuccessStatusCode)
        {
            await LoadKanban();
            await LoadTaskList();
            if (selectedProjectId != Guid.Empty)
                selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{selectedProjectId}");
            RefreshEditingTask();
            Toasts.Show($"Deadline extended to {newDue:dd MMM yyyy}.", ToastKind.Success);
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        else
        {
            Toasts.Show("Failed to save deadline extension.", ToastKind.Error);
        }
        extensionTask = null;
    }

    private async Task HandleDeleteTask(Guid taskId)
    {
        var res = await Auth.SendAsync(HttpMethod.Delete, $"/api/projects/tasks/{taskId}");
        if (res.IsSuccessStatusCode)
        {
            CloseTaskEditor();
            StateHasChanged();
            await LeaveTasks([taskId]); // #9 row exit before the list drops it
            await ReloadCurrentView();
            if (selectedProjectId != Guid.Empty)
                selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{selectedProjectId}");
            StateHasChanged();
            ShowDeleteUndo(await ReadDeleteResult(res), "Task deleted.");
        }
        else
        {
            Toasts.Show("Failed to delete task.", ToastKind.Error);
        }
    }

