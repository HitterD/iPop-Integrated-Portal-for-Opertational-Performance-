@page "/projects"
@page "/projects/overview"
@page "/projects/{ProjectId:guid}"
@using Microsoft.AspNetCore.Authorization
@using IPop.Web.Services
@using IPop.Application.Projects
@using IPop.Web.Components.Projects
@attribute [Authorize]
@implements IDisposable
@inject AuthState Auth
@inject NotificationState Notifs
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IPop.Web.Services.PageCache Cache

<PageTitle>Project Management - iPop</PageTitle>

<div class="proj-workspace @(mDetail ? "m-detail" : "")">
    @* Left Project Navigator Sidebar *@
    <ProjectSidebar
        Projects="filteredProjects"
        SelectedProjectId="selectedProjectId"
        SelectedYear="selectedYear"
        AvailableYears="availableYears"
        SearchQuery="@searchProjectQuery"
        IsCollapsed="sidebarCollapsed"
        Loading="loading"
        PortfolioSelected="portfolioSelected"
        OnSelectPortfolio="SelectPortfolio"
        OnSelectProject="SelectProjectFromList"
        OnToggleSidebar="() => sidebarCollapsed = !sidebarCollapsed"
        OnYearChanged="SetYearFilter"
        OnSearchChanged="HandleProjectSearch"
        OnCreateClick="() => showCreateModal = true" />

    @* Main Project Workspace Canvas *@
    <main class="proj-canvas" id="project-detail" role="region" aria-label="Project Workspace">
        @if (portfolioSelected)
        {
            <ProjectPortfolioView Data="portfolioData" Loading="portfolioLoading" Tasks="portfolioTasks"
                                  OnRetry="LoadPortfolio" OnOpenProject="OpenPortfolioProject"
                                  OnOpenTasks="OpenPortfolioTasks" OnOpenTask="OpenPortfolioTask"
                                  OnTaskPage="LoadPortfolioTaskPage" OnProjectPage="LoadPortfolioProjectPage"
                                  OnCloseTasks="ClosePortfolioTasks" />
        }
        else if (selectedProjectId == Guid.Empty || selectedProject is null)
        {
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px;text-align:center">
                <div style="width:64px;height:64px;border-radius:18px;background:var(--accent-soft);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;margin-bottom:16px">
                    <i data-lucide="layers" style="width:32px;height:32px"></i>
                </div>
                <h3 style="font-size:18px;font-weight:700;margin:0 0 6px">Select or Create a Project</h3>
                <p style="font-size:13px;color:var(--ink-2);max-width:380px;line-height:1.5;margin:0 0 20px">
                    Manage team tasks with Kanban Boards, Structured Tables, Visual Timelines, and Workload Distribution.
                </p>
                <button class="btn-sm accent" style="padding:8px 16px;font-size:13px" @onclick="() => showCreateModal = true">
                    <i data-lucide="plus"></i> Create New Project
                </button>
            </div>
        }
        else
        {
            @* Canvas Header *@
            <ProjectHeader
                Project="selectedProject"
                Members="projectMembers"
                OnOpenTeamModal="() => showTeamModal = true"
                OnOpenEditModal="() => showEditModal = true"
                OnOpenChatRoom="OpenProjectRoom"
                OnExport="ExportSelected"
                OnStatusChanged="HandleProjectStatusChange"
                OnCopyLink="CopyProjectLink"
                OnDeleteProject="HandleDeleteProject"
                OnMarkCompleted="HandleMarkProjectCompleted"
                OnBack="CloseMobileDetail" />

            @* Canvas View Switcher Bar (Overview / Board / List / Timeline / Workload) *@
            <div class="proj-canvas-bar">
                <div class="proj-tabs">
                    <button class="proj-tab-btn @(tab == 4 ? "active" : "")" @onclick="() => SwitchTab(4)" title="Overview & Progress">
                        <i data-lucide="layout-dashboard"></i> Overview
                    </button>
                    <button class="proj-tab-btn @(tab == 0 ? "active" : "")" @onclick="() => SwitchTab(0)">
                        <i data-lucide="kanban"></i> Board
                    </button>
                    <button class="proj-tab-btn @(tab == 1 ? "active" : "")" @onclick="() => SwitchTab(1)">
                        <i data-lucide="list"></i> List
                    </button>
                    <button class="proj-tab-btn @(tab == 2 ? "active" : "")" @onclick="() => SwitchTab(2)">
                        <i data-lucide="calendar-range"></i> Timeline
                    </button>
                    <button class="proj-tab-btn @(tab == 6 ? "active" : "")" @onclick="() => SwitchTab(6)">
                        <i data-lucide="calendar-days"></i> Calendar
                    </button>
                    <button class="proj-tab-btn @(tab == 3 ? "active" : "")" @onclick="() => SwitchTab(3)">
                        <i data-lucide="users"></i> Workload
                    </button>
                    <button class="proj-tab-btn @(tab == 5 ? "active" : "")" @onclick="() => SwitchTab(5)" title="Reports: progress, milestones, burndown, velocity">
                        <i data-lucide="chart-no-axes-combined"></i> Reports
                    </button>
                </div>

                <div class="proj-bar-right">
                    <div class="v6-search proj-task-search">
                        <i data-lucide="search"></i>
                        <input type="search" placeholder="Search tasks or tags" aria-label="Search tasks" @bind="taskSearchQuery" @bind:event="oninput" />
                    </div>
                    <div class="proj-filter-wrap">
                        <button type="button" class="ghost-btn @(ActiveTaskFilterCount > 0 ? "on" : "")" aria-expanded="@(filterOpen ? "true" : "false")" @onclick="() => filterOpen = !filterOpen">
                            <i data-lucide="list-filter"></i>Filter
                            @if (ActiveTaskFilterCount > 0) { <span class="n">@ActiveTaskFilterCount</span> }
                        </button>
                        @if (filterOpen)
                        {
                            <div class="proj-filter-pop" @onclick:stopPropagation="true">
                                <label class="pf-row"><input type="checkbox" @bind="myTasksOnly" /><i data-lucide="user"></i>My tasks</label>
                                <label class="pf-row"><input type="checkbox" @bind="overdueOnly" /><i data-lucide="clock-alert"></i>Overdue only</label>
                                @if (projectGroups.Count > 1)
                                {
                                    <div class="pf-label">Group</div>
                                    <AppSelect Value="@(selectedGroupId?.ToString() ?? "")" ValueChanged="ChangeGroupFilter" Options="GroupFilterOptions" Label="Group" CssClass="pf-sel" Block="true" />
                                }
                                <div class="pf-label">Priority</div>
                                <AppSelect Value="@priorityFilter" ValueChanged="v => priorityFilter = v ?? string.Empty" Options="PriorityFilterOptions" Label="Priority" CssClass="pf-sel" Block="true" />
                            </div>
                        }
                    </div>
                    <button type="button" class="btn-primary proj-add-task" @onclick='() => HandleQuickAdd(("todo", "New Task"))'>
                        <i data-lucide="plus"></i>Add task
                    </button>
                </div>
            </div>

            @* Canvas Body Content *@
            <div class="proj-canvas-body">
                @if (tab != 4 && tab != 5)
                {
                    <ProjectSavedViewsBar Views="savedViews" ActiveViewId="ActiveSavedViewId" CanSave="FiltersDifferFromDefault"
                                          CanManage="CanManageMembers" OnApply="ApplySavedView" OnSave="SaveCurrentView"
                                          OnRename="RenameSavedView" OnShare="ToggleShareSavedView" OnDelete="DeleteSavedView" />
                }
                @if (selectedGroupId.HasValue || myTasksOnly || overdueOnly || !string.IsNullOrWhiteSpace(priorityFilter) || !string.IsNullOrWhiteSpace(taskSearchQuery) || (tab == 1 && HasListAssigneeFilter))
                {
                    <div class="proj-filter-chips">
                        <span class="pfc-count">@VisibleTaskCount tasks</span>
                        @if (selectedGroupId is { } filteredGroup)
                        {
                            <span class="pfc">Group: @projectGroups.FirstOrDefault(g => g.Id == filteredGroup)?.Name
                                <button type="button" @onclick="() => SetGroupFilter(null)" aria-label="Remove group filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        @if (myTasksOnly)
                        {
                            <span class="pfc">
                                My Tasks <button type="button" @onclick="() => myTasksOnly = false" aria-label="Remove filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        @if (overdueOnly)
                        {
                            <span class="pfc">
                                Overdue <button type="button" @onclick="() => overdueOnly = false" aria-label="Remove filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(priorityFilter))
                        {
                            <span class="pfc">
                                @priorityFilter <button type="button" @onclick='() => priorityFilter = ""' aria-label="Remove filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(taskSearchQuery))
                        {
                            <span class="pfc">
                                "@taskSearchQuery" <button type="button" @onclick='() => taskSearchQuery = ""' aria-label="Remove filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        @if (tab == 1 && HasListAssigneeFilter)
                        {
                            <span class="pfc">
                                @ListAssigneeFilterLabel
                                <button type="button" @onclick="ClearListAssigneeFilter" aria-label="Remove assignee filter"><i data-lucide="x"></i></button>
                            </span>
                        }
                        <button type="button" class="pfc-clear" @onclick="ClearTaskFilters">Clear all</button>
                    </div>
                }

                @if (tab == 4)
                {
                    <ProjectExecutiveDashboard
                        Project="selectedProject"
                        AllTasks="AllCurrentTasks"
                        Members="projectMembers"
                        OnInspectTask="OpenTaskEditor"
                        OnRequestExtension="OpenExtensionModal"
                        OnOpenBoard="() => SwitchTab(0)"
                        OnOpenTeamModal="() => showTeamModal = true" />
                }
                else
                {
                    <div class="proj-canvas-split-container">
                        <div class="proj-canvas-split-main">
                            @if (tab == 0)
                            {
                                <ProjectKanbanBoard
                                    Kanban="kanban"
                                    Members="projectMembers"
                                    Groups="projectGroups"
                                    OnMoveToGroup="HandleMoveTaskToGroup"
                                    SearchQuery="@taskSearchQuery"
                                    MyTasksOnly="myTasksOnly"
                                    OverdueOnly="overdueOnly"
                                    PriorityFilter="@priorityFilter"
                                    CurrentUserNik="@currentUserNik"
                                    HighlightTaskId="highlightTaskId"
                                    OnTaskClick="OpenTaskEditor"
                                    OnTaskMove="HandleTaskMove"
                                    OnToggleComplete="ToggleTaskComplete"
                                    OnQuickAdd="HandleQuickAdd"
                                    OnToggleAssignee="HandleToggleAssignee"
                                    OnRequestExtension="OpenExtensionModal" />
                            }
                            else if (tab == 1)
                            {
                                <div class="project-fields-toolbar">
                                    @if (CanManageMembers) { <button type="button" class="project-fields-add" @onclick="() => addingField = !addingField" aria-expanded="@addingField"><i data-lucide="plus"></i>Fields</button> }
                                    @if (addingField && CanManageMembers)
                                    {
                                        <div class="project-fields-create">
                                            <strong>Add field</strong>
                                            <div class="project-field-presets">
                                                <button type="button" @onclick="PresetBiaya">Cost · Rp</button>
                                                <button type="button" @onclick="PresetLokasi">Location · Text</button>
                                                <button type="button" @onclick="PresetVendor">Vendor · Dropdown</button>
                                            </div>
                                            <input aria-label="Field name" maxlength="100" placeholder="Field name" @bind="newFieldName" />
                                            <AppSelect Value="@newFieldType" ValueChanged="v => newFieldType = v ?? newFieldType" Options="FieldTypeOptions" Label="Field type" CssClass="project-field-type" />
                                            @if (newFieldType == "Dropdown") { <input aria-label="Dropdown options" placeholder="Options separated by commas" @bind="newFieldOptions" /> }
                                            <button type="button" @onclick="CreateField">Add field</button>
                                            <button type="button" @onclick="() => addingField = false">Cancel</button>
                                        </div>
                                    }
                                </div>
                                <ProjectTableView
                                    Tasks="taskList.Items.ToList()"
                                    Members="projectMembers"
                                    Groups="projectGroups"
                                    Fields="projectFields"
                                    FieldValues="taskFieldValues"
                                    OnSetFieldValue="SetFieldValue"
                                    OnDeleteField="DeleteField"
                                    PrefKey="@($"projects.cols.{currentUserNik}.{selectedProjectId}")"
                                    CanManageGroups="CanManageMembers"
                                    OnCreateGroup="CreateGroup"
                                    OnUpdateGroup="UpdateGroup"
                                    OnDeleteGroup="DeleteGroup"
                                    OnReorderGroup="ReorderGroup"
                                    OnMoveToGroup="HandleMoveTaskToGroup"
                                    SearchQuery="@taskSearchQuery"
                                    MyTasksOnly="myTasksOnly"
                                    OverdueOnly="overdueOnly"
                                    PriorityFilter="@priorityFilter"
                                    CurrentUserNik="@currentUserNik"
                                    StatusFilter="@listStatusFilter"
                                    OnTaskClick="OpenTaskEditor"
                                    OnFilterChanged="s => listStatusFilter = s"
                                    OnStatusChangeDirect="HandleStatusChangeDirect"
                                    OnPriorityChangeDirect="HandlePriorityChangeDirect"
                                    OnDueDateChangeDirect="HandleDueDateChangeDirect"
                                    OnEstimateChangeDirect="HandleEstimateChangeDirect"
                                    OnQuickAddSubtask="HandleQuickAddSubtask"
                                    OnQuickAdd="HandleQuickAdd"
                                    OnQuickAddInGroup="HandleQuickAddInGroup"
                                    OnToggleAssignee="HandleToggleAssignee"
                                    OnRequestExtension="OpenExtensionModal"
                                    SelectedIds="selectedTaskIds"
                                    OnSelectionChanged="ids => selectedTaskIds = ids" />
                                @if (selectedTaskIds.Count > 0)
                                {
                                    <ProjectBulkBar Count="selectedTaskIds.Count" Members="projectMembers" Groups="projectGroups" Busy="bulkBusy"
                                                    OnAction="HandleBulkAction" OnClear="ClearSelection" />
                                }
                            }
                            else if (tab == 2)
                            {
                                <ProjectTimelineView
                                    Timeline="timeline"
                                    AllTasks="AllCurrentTasks"
                                    CriticalPathTaskIds="criticalPathIds"
                                    SearchQuery="@taskSearchQuery"
                                    MyTasksOnly="myTasksOnly"
                                    OverdueOnly="overdueOnly"
                                    PriorityFilter="@priorityFilter"
                                    CurrentUserNik="@currentUserNik"
                                    OnTaskClick="OpenTimelineTaskEditor"
                                    OnAddTask='() => HandleQuickAdd(("todo", "New Task"))' />
                            }
                            else if (tab == 6)
                            {
                                <ProjectCalendarView @ref="calendarView"
                                    ProjectId="selectedProjectId"
                                    GroupId="selectedGroupId"
                                    Filter="CalendarFilter"
                                    OnTaskClick="OpenTaskById"
                                    OnMoveTask="HandleCalendarMove"
                                    OnQuickAdd="HandleCalendarQuickAdd" />
                            }
                            else if (tab == 3)
                            {
                                <ProjectWorkloadView
                                    Workload="workloadData"
                                    ProjectId="selectedProjectId"
                                    CanManageMembers="CanManageMembers"
                                    OwnerIds="@OwnerMemberIds"
                                    OnAddMember="() => showTeamModal = true"
                                    OnViewTasks="ViewWorkloadTasks"
                                    OnRemoveMember="HandleRemoveTeamMember" />
                            }
                            else if (tab == 5)
                            {
                                <ProjectReportsPanel Project="selectedProject" AllTasks="AllCurrentTasks" OnViewOverdue="ViewOverdueFromReports" />
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </main>
</div>

@* Modals & Drawers *@
@if (showEvidenceModal && evidenceTask is not null)
{
    <ProjectStatusEvidenceModal
        IsOpen="showEvidenceModal"
        Task="evidenceTask"
        TargetStatus="@evidenceTargetStatus"
        Members="projectMembers"
        OnConfirm="HandleEvidenceConfirm"
        OnCancel="() => { showEvidenceModal = false; evidenceTask = null; bulkEvidenceStatus = null; }" />
}

@if (showExtensionModal && extensionTask is not null)
{
    <ProjectDeadlineExtensionModal
        IsOpen="showExtensionModal"
        Task="extensionTask"
        OnConfirm="HandleExtensionConfirm"
        OnCancel="() => { showExtensionModal = false; extensionTask = null; }" />
}

@if (showTaskEditor && editingTask is not null)
{
    <ProjectTaskDrawer
        Task="editingTask"
        ProjectName="@(selectedProject?.Name ?? "Project")"
        ProjectColor="@selectedProject?.Color"
        OnRequestExtension="OpenExtensionModal"
        Members="projectMembers"
        Groups="projectGroups"
        Fields="projectFields"
        FieldValues="taskFieldValues.GetValueOrDefault(editingTask.Id) ?? new()"
        OnSetFieldValue="SetFieldValue"
        OnMoveToGroup="HandleMoveTaskToGroup"
        Subtasks="subtasks"
        OnClose="CloseTaskEditor"
        OnSave="HandleSaveTask"
        OnDelete="HandleDeleteTask"
        OnToggleAssignee="HandleToggleAssignee"
        OnAddSubtask="HandleAddSubtask"
        OnToggleSubtask="HandleToggleSubtask"
        OnDeleteSubtask="HandleDeleteSubtask"
        NavTasks="DrawerNavTasks"
        OnNavigate="OpenTaskEditor"
        OnStatusChange="HandleStatusChangeDirect"
        AllTasks="AllCurrentTasks"
        OnTaskChanged="HandleDrawerTaskChanged"
        OnSaveEvidenceOnly="SaveEvidenceOnly" />
}

@if (showCreateModal)
{
    <ProjectCreateModal
        OnClose="() => showCreateModal = false"
        Busy="creatingProject"
        OnSubmit="HandleSubmitCreateProject" />
}

@if (showEditModal && selectedProject is not null)
{
    <ProjectEditModal
        Project="selectedProject"
        OnClose="() => showEditModal = false"
        OnSubmit="HandleSubmitEditProject" />
}

@if (showTeamModal && selectedProject is not null)
{
    <ProjectTeamModal
        Members="projectMembers"
        OnClose="() => showTeamModal = false"
        OnAddMember="HandleAddTeamMember"
        OnRemoveMember="HandleRemoveTeamMember" />
}

@code {
    [CascadingParameter] public MainLayout? Layout { get; set; }
    [Parameter] public Guid? ProjectId { get; set; }

    private bool loading = true;
    private bool portfolioSelected;
    private bool portfolioLoading;
    private PortfolioDto? portfolioData;
    private PagedResult<PortfolioTaskDto>? portfolioTasks;
    private (string Filter, Guid? ProjectId, Guid? AssigneeId)? portfolioTaskFilter;
    private bool sidebarCollapsed = false;
    private bool myTasksOnly = false;
    private bool overdueOnly = false;
    private string priorityFilter = "";
    private HashSet<Guid> criticalPathIds = [];
    private string? currentUserNik;

    private int VisibleTaskCount
    {
        get
        {
            var tasks = AllCurrentTasks.AsEnumerable();
            if (selectedGroupId.HasValue) tasks = tasks.Where(t => t.GroupId == selectedGroupId.Value);
            if (myTasksOnly)
                tasks = tasks.Where(t => ProjectUiHelpers.IsAssignedToUser(t, currentUserNik));
            if (overdueOnly)
                tasks = tasks.Where(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "done");
            if (!string.IsNullOrWhiteSpace(priorityFilter))
                tasks = tasks.Where(t => string.Equals(t.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(taskSearchQuery))
            {
                var q = taskSearchQuery.Trim().ToLowerInvariant();
                tasks = tasks.Where(t => t.Title.ToLowerInvariant().Contains(q) || (t.Tags != null && t.Tags.ToLowerInvariant().Contains(q)));
            }
            if (tab == 1 && listUnassignedOnly)
                tasks = tasks.Where(t => t.Assignees.Count == 0);
            else if (tab == 1 && listAssigneeId is Guid assigneeId)
                tasks = tasks.Where(t => t.Assignees.Any(a => a.UserId == assigneeId));
            return tasks.Count();
        }
    }

    private async Task ClearTaskFilters()
    {
        myTasksOnly = false;
        overdueOnly = false;
        priorityFilter = "";
        taskSearchQuery = "";
        selectedGroupId = null;
        await ClearListAssigneeFilter();
        await ReloadCurrentView();
    }

    private bool HasListAssigneeFilter => listAssigneeId.HasValue || listUnassignedOnly;
    private string ListAssigneeFilterLabel => listUnassignedOnly ? "Unassigned"
        : $"Assignee: {projectMembers.FirstOrDefault(m => m.UserId == listAssigneeId)?.Name ?? "Member"}";

    private async Task ClearListAssigneeFilter()
    {
        listAssigneeId = null;
        listUnassignedOnly = false;
        if (tab == 1 && selectedProjectId != Guid.Empty)
            await LoadTaskList();
    }

    private List<ProjectListDto> projects = [];
    private List<ProjectListDto> filteredProjects = [];
    private int? selectedYear;
    private List<int> availableYears = [];
    private string searchProjectQuery = "";

    private ProjectDto? selectedProject;
    private Guid selectedProjectId;
    private KanbanBoardDto? kanban;
    private PagedResult<ProjectTaskDto> taskList = new([], 0, 1, 50);
    private ProjectTimelineDto? timeline;
    private ProjectWorkloadDto? workloadData;
    private List<ProjectMemberDto> projectMembers = [];
    private List<ProjectGroupDto> projectGroups = [];
    private Guid? selectedGroupId;
    private List<ProjectFieldDto> projectFields = [];
    private Dictionary<Guid, Dictionary<Guid, string>> taskFieldValues = [];
    private bool addingField;
    private string newFieldName = "";
    private string newFieldType = "Text";
    private string newFieldOptions = "";

    private int tab = 0; // 0=Board, 1=Table, 2=Timeline, 3=Workload
    private string taskSearchQuery = "";
    private string listStatusFilter = "";
    private Guid? listAssigneeId;
    private bool listUnassignedOnly;
    private Guid? highlightTaskId;

    // Task Inspector Drawer state
    private ProjectTaskDto? editingTask;
    private bool showTaskEditor;
    private List<ProjectTaskDto> subtasks = [];

    // Task Evidence Modal state
    private bool showEvidenceModal;
    private ProjectTaskDto? evidenceTask;
    private string evidenceTargetStatus = "doing";

    private bool filterOpen;
    private int ActiveTaskFilterCount => (myTasksOnly ? 1 : 0) + (overdueOnly ? 1 : 0) + (selectedGroupId.HasValue ? 1 : 0) + (string.IsNullOrWhiteSpace(priorityFilter) ? 0 : 1);

    // Deadline Extension Modal state
    private bool showExtensionModal;
    private ProjectTaskDto? extensionTask;

    // Modals state
    private bool showCreateModal;
    private bool showEditModal;
    private bool showTeamModal;

    private List<ProjectTaskDto> AllCurrentTasks =>
        taskList.Items.Concat(kanban?.Todo ?? []).Concat(kanban?.Doing ?? [])
            .Concat(kanban?.Review ?? []).Concat(kanban?.Done ?? []).DistinctBy(x => x.Id).ToList();

    private static readonly string[] StatusOrder = ["todo", "doing", "review", "done"];

    private bool MatchesTaskFilters(ProjectTaskDto t)
    {
        if (selectedGroupId.HasValue && t.GroupId != selectedGroupId.Value) return false;
        if (myTasksOnly && !ProjectUiHelpers.IsAssignedToUser(t, currentUserNik)) return false;
        if (overdueOnly && !(t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "done")) return false;
        if (!string.IsNullOrWhiteSpace(priorityFilter) && !string.Equals(t.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase)) return false;
        if (!string.IsNullOrWhiteSpace(taskSearchQuery)
            && !t.Title.Contains(taskSearchQuery, StringComparison.OrdinalIgnoreCase)
            && !(t.Tags?.Contains(taskSearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)) return false;
        return true;
    }

    /// The drawer pager's task order: what the current view shows, filtered and in display order
    /// (Board columns top to bottom, List groups, Timeline start dates). If the open task is not in
    /// that list (e.g. opened from Overview or a subtask), the pager hides itself.
    private List<ProjectTaskDto> DrawerNavTasks
    {
        get
        {
            switch (tab)
            {
                case 0:
                    return new[] { kanban?.Todo, kanban?.Doing, kanban?.Review, kanban?.Done }
                        .SelectMany(col => col ?? []).Where(MatchesTaskFilters).ToList();
                case 1:
                    return taskList.Items.Where(MatchesTaskFilters)
                        .Where(t => string.IsNullOrEmpty(listStatusFilter) || t.Status == listStatusFilter)
                        .OrderBy(t => Array.IndexOf(StatusOrder, t.Status) is var i && i < 0 ? StatusOrder.Length : i)
                        .ToList();
                case 2:
                    var lookup = AllCurrentTasks.ToDictionary(t => t.Id);
                    return (timeline?.Tasks ?? [])
                        .OrderBy(t => t.StartDate ?? t.DueDate ?? DateTime.MaxValue)
                        .Select(t => lookup.GetValueOrDefault(t.Id))
                        .OfType<ProjectTaskDto>()
                        .Where(MatchesTaskFilters).ToList();
                default:
                    return AllCurrentTasks.Where(MatchesTaskFilters).ToList();
            }
        }
    }

    // After a move / extension / assignment the board reloads; point the open drawer at the fresh
    // task so its status pills, banner and flags reflect what was saved.
    private void RefreshEditingTask()
    {
        if (editingTask is null) return;
        var fresh = AllCurrentTasks.FirstOrDefault(t => t.Id == editingTask.Id);
        if (fresh is not null) editingTask = fresh;
    }

    private bool CanManageMembers => projectMembers.Any(m => m.Nik == currentUserNik && (m.Role == "owner" || m.Role == "manager"));
    private IReadOnlySet<Guid> OwnerMemberIds => projectMembers.Where(m => m.Role == "owner").Select(m => m.UserId).ToHashSet();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var me = await Auth.GetAsync<DirectoryEmployeeDto>("/api/directory/me");
            if (me is not null) currentUserNik = me.Nik;
        }
        catch { }

        await ReloadProjects();
        _projectSub = Auth.On<Guid>(IPop.Application.Realtime.RealtimeEvents.ProjectChanged, QueueLiveRefresh);
        Auth.HubReconnected += OnHubReconnected;
    }

    // ---- Live updates: projectChanged(projectId) from any user's mutation ----
    // Bursts (a drag across columns, a bulk edit) are coalesced into one refresh ~400ms after the
    // last event. The refresh is silent: no loading flag, no reset of tab, filters, scroll, the
    // open drawer or any modal; child editors merge server values into fields the user hasn't
    // touched (see ProjectTaskDrawer.OnParametersSetAsync).
    private readonly HashSet<Guid> _liveProjectIds = [];
    private CancellationTokenSource? _liveCts;
    private bool _disposed;

    private void QueueLiveRefresh(Guid projectId) => _ = InvokeAsync(() =>
    {
        if (_disposed) return Task.CompletedTask;
        _liveProjectIds.Add(projectId);
        _liveCts?.Cancel();
        _liveCts?.Dispose();
        _liveCts = new CancellationTokenSource();
        return ApplyLiveRefreshAsync(_liveCts.Token);
    });

    // Events pushed while the hub was down are gone: resync the list and the open project.
    private void OnHubReconnected() => QueueLiveRefresh(selectedProjectId);

    private async Task ApplyLiveRefreshAsync(CancellationToken ct)
    {
        try { await Task.Delay(400, ct); }
        catch (OperationCanceledException) { return; }
        if (_disposed || ct.IsCancellationRequested) return;
        var touched = _liveProjectIds.ToHashSet();
        _liveProjectIds.Clear();
        try
        {
            await RefreshProjectListSilently();
            if (portfolioSelected) await LoadPortfolio();
            if (selectedProjectId != Guid.Empty && touched.Contains(selectedProjectId))
                await RefreshSelectedProjectSilently();
            if (_disposed) return;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { /* advisory: the next event, navigation or reconnect resyncs */ }
    }

    /// ReloadProjects without the loading state (which would blank the sidebar) and without
    /// auto-selecting a project.
    private async Task RefreshProjectListSilently()
    {
        var all = await GetAllProjects();
        if (_disposed) return;
        projects = all;
        Layout?.SetSubtitle($"{projects.Count} {(projects.Count == 1 ? "project" : "projects")} · {projects.Sum(p => p.TaskCount)} tasks");
        ApplyProjectFilter();
        availableYears = projects.Select(p => p.Year).Distinct().OrderByDescending(y => y).ToList();
    }

    private async Task RefreshSelectedProjectSilently()
    {
        var id = selectedProjectId;
        var res = await Auth.SendAsync(HttpMethod.Get, $"/api/projects/{id}");
        if (id != selectedProjectId || _disposed) return;
        // 404 covers both "deleted" and "you were removed" (the endpoint is membership-checked).
        if (res.StatusCode is System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Forbidden)
        {
            await HandleSelectedProjectGone();
            return;
        }
        if (!res.IsSuccessStatusCode) return;
        var proj = await res.Content.ReadFromJsonAsync<ProjectDto>();
        if (proj is null || id != selectedProjectId) return;
        selectedProject = proj;

        await ReloadCurrentView();
        if (id != selectedProjectId) return;

        if (showTaskEditor && editingTask is not null)
        {
            var taskId = editingTask.Id;
            var fresh = AllCurrentTasks.FirstOrDefault(t => t.Id == taskId);
            if (fresh is null)
            {
                // Subtasks are not on the board; ask for the task itself before calling it gone.
                var tr = await Auth.SendAsync(HttpMethod.Get, $"/api/projects/tasks/{taskId}");
                if (tr.StatusCode == System.Net.HttpStatusCode.NotFound)
                {
                    if (editingTask?.Id == taskId)
                    {
                        CloseTaskEditor();
                        Toasts.Show("This task was deleted by someone else.", ToastKind.Info);
                    }
                    return;
                }
                if (tr.IsSuccessStatusCode) fresh = await tr.Content.ReadFromJsonAsync<ProjectTaskDto>();
            }
            if (fresh is not null && editingTask?.Id == taskId)
            {
                editingTask = fresh;
                await LoadSubtasks(taskId);
            }
        }

    }

    private async Task HandleSelectedProjectGone()
    {
        Toasts.Show("This project was deleted or you are no longer a member.", ToastKind.Info);
        showTaskEditor = false; editingTask = null; subtasks.Clear();
        showEditModal = false; showTeamModal = false;
        showEvidenceModal = false; evidenceTask = null;
        showExtensionModal = false; extensionTask = null;
        selectedProjectId = Guid.Empty; selectedProject = null;
        mDetail = false;
        kanban = null; taskList = new([], 0, 1, 50); timeline = null; workloadData = null; projectMembers = [];
        if (ProjectId is not null)
            Nav.NavigateTo("/projects", replace: true); // OnParametersSetAsync then selects the first project
        else if (filteredProjects.Count > 0)
            await SelectProject(filteredProjects[0]);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Nav.ToAbsoluteUri(Nav.Uri).AbsolutePath.TrimEnd('/').Equals("/projects/overview", StringComparison.OrdinalIgnoreCase))
        {
            if (!portfolioSelected)
            {
                portfolioSelected = true;
                mDetail = true;
                await LoadPortfolio();
            }
            return;
        }
        if (portfolioSelected) portfolioSelected = false;
        if (ProjectId is null && selectedProjectId != Guid.Empty && selectedProject is null)
        {
            selectedProjectId = Guid.Empty;
        }
        if (ProjectId is not null && ProjectId != selectedProjectId)
        {
            var found = projects.FirstOrDefault(p => p.Id == ProjectId.Value);
            if (found is not null)
            {
                await SelectProject(found);
            }
            else
            {
                var proj = await Auth.GetAsync<ProjectDto>($"/api/projects/{ProjectId.Value}");
                if (proj is not null)
                {
                    listAssigneeId = null;
                    listUnassignedOnly = false;
                    selectedProjectId = ProjectId.Value;
                    selectedGroupId = null;
                    selectedProject = proj;
                    _ = Notifs.MarkReadByTargetAsync("project", proj.Id);
                    await LoadMembers();
                    await LoadGroups();
                    await LoadFields();
                    await LoadKanban();
                    await LoadTaskList();
                    await LoadTimeline();
                    StateHasChanged();
                }
                else
                {
                    Toasts.Show("Project not found or you are not a member.", ToastKind.Error);
                    Nav.NavigateTo("/projects", replace: true);
                    return;
                }
            }

            mDetail = true; // a deep link to one project opens its workspace on phones
            await Task.Delay(50);
            await JS.InvokeVoidAsync("ipop.scrollIntoView", "project-detail");

            var taskIdStr = QueryValue("task");
            if (!string.IsNullOrEmpty(taskIdStr) && Guid.TryParse(taskIdStr, out var targetTask))
            {
                await HighlightTask(targetTask);
                Nav.NavigateTo($"/projects/{ProjectId.Value}", replace: true);
            }
        }
        else if (ProjectId is null)
        {
            highlightTaskId = null;
            if (selectedProjectId == Guid.Empty && filteredProjects.Count > 0)
            {
                await SelectProject(filteredProjects[0]);
            }

            var taskIdStr = QueryValue("task");
            if (!string.IsNullOrEmpty(taskIdStr) && Guid.TryParse(taskIdStr, out var targetTask))
            {
                await HighlightTask(targetTask);
                Nav.NavigateTo("/projects", replace: true);
            }
        }

        if (QueryValue("newTask") == "1")
        {
            if (selectedProjectId != Guid.Empty)
            {
                tab = 0;
                mDetail = true;
                await HandleQuickAdd(("todo", "New Task"));
            }
            else
            {
                showCreateModal = true;
            }
            Nav.NavigateTo(ProjectId is null ? "/projects" : $"/projects/{ProjectId.Value}", replace: true);
        }
    }

    private async Task HighlightTask(Guid taskId)
    {
        var inKanban = (kanban?.Todo ?? []).Any(t => t.Id == taskId)
            || (kanban?.Doing ?? []).Any(t => t.Id == taskId)
            || (kanban?.Review ?? []).Any(t => t.Id == taskId)
            || (kanban?.Done ?? []).Any(t => t.Id == taskId);
        if (!inKanban) return;

        tab = 0;
        highlightTaskId = taskId;
        var foundTask = AllCurrentTasks.FirstOrDefault(t => t.Id == taskId);
        if (foundTask != null)
        {
            await OpenTaskEditor(foundTask);
        }
        StateHasChanged();
        await Task.Delay(80);
        try { await JS.InvokeVoidAsync("ipop.scrollIntoView", $"task-card-{taskId}"); } catch { }

        _ = Task.Run(async () =>
        {
            await Task.Delay(2000);
            highlightTaskId = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private string? QueryValue(string key)
    {
        var q = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        foreach (var part in q.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) continue;
            if (!part[..eq].Equals(key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(part[(eq + 1)..]);
        }
        return null;
    }

