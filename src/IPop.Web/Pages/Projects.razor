    private async Task HandleTaskMove((Guid TaskId, string TargetStatus) arg)
    {
        var task = AllCurrentTasks.FirstOrDefault(t => t.Id == arg.TaskId);
        if (task != null && (arg.TargetStatus == "doing" || arg.TargetStatus == "done") && task.Status != arg.TargetStatus)
        {
            evidenceTask = task;
            evidenceTargetStatus = arg.TargetStatus;
            showEvidenceModal = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
            return;
        }

        await ExecuteTaskMove(arg.TaskId, arg.TargetStatus);
    }

    private async Task ExecuteTaskMove(Guid taskId, string targetStatus)
    {
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/projects/tasks/{taskId}/move", new TaskMoveRequest(targetStatus, null));
        if (res.IsSuccessStatusCode)
        {
            await LoadKanban();
            await LoadTaskList();
            if (selectedProjectId != Guid.Empty)
                selectedProject = await Auth.GetAsync<ProjectDto>($"/api/projects/{selectedProjectId}");
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        else
        {
            var body = await res.Content.ReadAsStringAsync();
            if (body.Contains("unmet_dependencies"))
                Toasts.Show("Cannot move to Done — task dependencies are incomplete.");
            else
                Toasts.Show("Failed to move task.");
        }
    }

    private async Task HandleEvidenceConfirm((ProjectTaskDto Task, string TargetStatus, TaskEvidenceData Evidence) arg)
    {
        showEvidenceModal = false;
        var parsed = TaskEvidenceHelper.Parse(arg.Task.Description);
        var newDesc = TaskEvidenceHelper.Serialize(parsed.CleanDescription, arg.Evidence);

        var updateReq = new UpdateTaskRequest(
            arg.Task.Title, newDesc, arg.TargetStatus, arg.Task.Priority, arg.Task.StartDate, arg.Task.DueDate,
            arg.Task.EstimatedHours, arg.Task.ActualHours, null, arg.Task.Dependencies, null, null, null, arg.Task.Tags
        );
        await Auth.SendAsync(HttpMethod.Put, $"/api/projects/tasks/{arg.Task.Id}", updateReq);
        await ExecuteTaskMove(arg.Task.Id, arg.TargetStatus);
        evidenceTask = null;
        Toasts.Show(arg.TargetStatus == "doing"
            ? "Task moved to In Progress with progress notes."
            : "Task completed with deliverables evidence.");
    }

