    private void OpenCreate() => drawer = new DrawerState { IsCreate = true };
    private void OpenEdit(AdminUserRowDto u) => drawer = new DrawerState
    {
        Nik = u.Nik, Name = u.Name, Email = u.Email, Position = u.Position ?? "",
        DepartmentCode = u.DepartmentCode, SiteCode = u.SiteCode,
        IsAdmin = u.Roles.Contains("Admin"),
    };
    private void CloseDrawer()
    {
        drawer = null;
        groupEditor = null;
        nodeEditor = null;
        divisionEditor = null;
        selectedDirMember = null;
        StateHasChanged();
    }

    private async Task SaveDrawer()
    {
        if (drawer is null) return;
        drawer.Saving = true;
        drawer.Error = null;

        HttpResponseMessage res;
        if (drawer.IsCreate)
        {
            res = await Auth.SendAsync(HttpMethod.Post, "/api/admin/users",
                new { nik = drawer.Nik, name = drawer.Name, email = drawer.Email, position = drawer.Position,
                    location = (string?)null, departmentCode = drawer.DepartmentCode, siteCode = drawer.SiteCode });
        }
        else
        {
            res = await Auth.SendAsync(HttpMethod.Patch, $"/api/admin/users/{Uri.EscapeDataString(drawer.Nik)}",
                new { name = drawer.Name, email = drawer.Email, position = drawer.Position,
                    location = (string?)null, departmentCode = drawer.DepartmentCode, siteCode = drawer.SiteCode });
        }

        if (!res.IsSuccessStatusCode)
        {
            drawer.Error = res.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "A user with this ID already exists." : "Save failed — check the fields.";
            drawer.Saving = false;
            return;
        }

        // Roles remain a separate admin action because the user row is created first.
        if (!drawer.IsCreate)
        {
            var wantedRoles = drawer.IsAdmin ? new[] { "Admin" } : Array.Empty<string>();
            await Auth.SendAsync(HttpMethod.Put, $"/api/admin/users/{Uri.EscapeDataString(drawer.Nik)}/roles",
                new { roles = wantedRoles });
        }

        drawer.Saving = false;
        drawer = null;
        await ReloadUsers(page?.Page ?? 1);
    }

