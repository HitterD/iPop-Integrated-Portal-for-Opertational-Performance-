@page "/admin"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@using IPop.Web.Components.Admin

<PageTitle>Administration — IPop</PageTitle>

@if (!loaded)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray"><div class="core"><div class="skel"></div></div></div>
    </div>
}
else if (!Auth.IsAdmin)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray rise rise-1"><div class="core" style="padding:34px">
            <div class="tree-empty">This page is only available to administrators.</div>
        </div></div>
    </div>
}
else
{
<div class="content" style="grid-template-columns:1fr">
    <div class="admin-tabs rise" role="tablist" aria-label="Administration sections">
        <button class="admin-tab tab-hris @(tab == 0 ? "active" : "")" role="tab" aria-selected="@(tab == 0)" @onclick="() => SetTab(0)"><i data-lucide="refresh-cw"></i> HRIS sync</button>
        <button class="admin-tab tab-sessions @(tab == 1 ? "active" : "")" role="tab" aria-selected="@(tab == 1)" @onclick="() => SetTab(1)"><i data-lucide="laptop"></i> Sessions</button>
        <button class="admin-tab tab-audit @(tab == 2 ? "active" : "")" role="tab" aria-selected="@(tab == 2)" @onclick="() => SetTab(2)"><i data-lucide="scroll-text"></i> Audit trail</button>
        <button class="admin-tab tab-org @(tab == 3 ? "active" : "")" role="tab" aria-selected="@(tab == 3)" @onclick="() => SetTab(3)"><i data-lucide="building-2"></i> Organization</button>
        <button class="admin-tab tab-tree @(tab == 4 ? "active" : "")" role="tab" aria-selected="@(tab == 4)" @onclick="() => SetTab(4)"><i data-lucide="folder-tree"></i> Directory Tree</button>
        <button class="admin-tab tab-chart @(tab == 5 ? "active" : "")" role="tab" aria-selected="@(tab == 5)" @onclick="() => SetTab(5)"><i data-lucide="network"></i> Org Chart</button>
        <button class="admin-tab tab-users @(tab == 6 ? "active" : "")" role="tab" aria-selected="@(tab == 6)" @onclick="() => SetTab(6)"><i data-lucide="users"></i> Users</button>
    </div>

    @switch (tab)
    {
        case 0:
            <AdminHrisSync @ref="hrisRef" />
            break;
        case 1:
            <AdminSessions @ref="sessionsRef" />
            break;
        case 2:
            <AdminAuditTrail @ref="auditRef" />
            break;
        case 3:
            <AdminOrganization @ref="orgRef" />
            break;
        case 4:
            <AdminDirectoryTree @ref="treeRef" />
            break;
        case 5:
            <AdminOrgChart @ref="chartRef" />
            break;
        case 6:
            <AdminUserManagement @ref="userRef" />
            break;
    }
</div>
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    private bool loaded;
    private int tab;

    private AdminHrisSync? hrisRef;
    private AdminSessions? sessionsRef;
    private AdminAuditTrail? auditRef;
    private AdminOrganization? orgRef;
    private AdminDirectoryTree? treeRef;
    private AdminOrgChart? chartRef;
    private AdminUserManagement? userRef;

    protected override void OnInitialized()
    {
        Layout.SetHeader("Administration", "Settings", showSearch: false);
        Layout.EscapePressed += OnEscape;
        Auth.DirectoryChanged += OnDirectoryChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        loaded = true;
    }

    private void SetTab(int newTab)
    {
        tab = newTab;
        StateHasChanged();
    }

    private void OnEscape()
    {
        orgRef?.CloseAllDrawers();
        treeRef?.CloseAllDrawers();
        chartRef?.CloseAllDrawers();
        userRef?.CloseDrawer();
    }

    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
        if (hrisRef is not null) await hrisRef.Reload();
        if (sessionsRef is not null) await sessionsRef.Reload();
        if (auditRef is not null) await auditRef.Reload();
        if (orgRef is not null) await orgRef.Reload();
        if (treeRef is not null) await treeRef.Reload();
        if (chartRef is not null) await chartRef.Reload();
        if (userRef is not null) await userRef.Reload();
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        Layout.EscapePressed -= OnEscape;
        Auth.DirectoryChanged -= OnDirectoryChanged;
    }
}
