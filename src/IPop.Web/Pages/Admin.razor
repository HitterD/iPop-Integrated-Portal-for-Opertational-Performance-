@page "/admin"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Rendering
@inject IJSRuntime JS
@inject AuthState Auth

<PageTitle>Administration — IPop</PageTitle>

@if (!loaded)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray"><div class="core"><div class="skel"></div></div></div>
    </div>
}
else if (!Auth.IsAdmin)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray rise rise-1"><div class="core" style="padding:34px">
            <div class="tree-empty">This page is only available to administrators.</div>
        </div></div>
    </div>
}
else
{
<div class="content" style="grid-template-columns:1fr">

    @* ---- Tab bar: each admin concern is one view, not one long scroll ---- *@
    <div class="admin-tabs rise" role="tablist" aria-label="Administration sections">
        <button class="admin-tab @(Tab == 0 ? "active" : "")" role="tab" aria-selected="@(Tab == 0)" @onclick="() => tab = 0"><i data-lucide="refresh-cw"></i> HRIS sync</button>
        <button class="admin-tab @(Tab == 1 ? "active" : "")" role="tab" aria-selected="@(Tab == 1)" @onclick="() => tab = 1"><i data-lucide="laptop"></i> Sessions</button>
        <button class="admin-tab @(Tab == 2 ? "active" : "")" role="tab" aria-selected="@(Tab == 2)" @onclick="() => tab = 2"><i data-lucide="scroll-text"></i> Audit trail</button>
        <button class="admin-tab @(Tab == 3 ? "active" : "")" role="tab" aria-selected="@(Tab == 3)" @onclick="() => tab = 3"><i data-lucide="building-2"></i> Organization</button>
        <button class="admin-tab @(Tab == 4 ? "active" : "")" role="tab" aria-selected="@(Tab == 4)" @onclick="() => tab = 4"><i data-lucide="folder-tree"></i> Directory Tree</button>
        <button class="admin-tab @(Tab == 5 ? "active" : "")" role="tab" aria-selected="@(Tab == 5)" @onclick="() => tab = 5"><i data-lucide="network"></i> Org Chart</button>
        <button class="admin-tab @(Tab == 6 ? "active" : "")" role="tab" aria-selected="@(Tab == 6)" @onclick="() => tab = 6"><i data-lucide="users"></i> Users</button>
    </div>

    @if (Tab == 0)
    {
        @* ---- HRIS sync card ---- *@
        <div class="tray rise rise-1">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="refresh-cw"></i> <span>HRIS sync</span>
                    <span class="meta">@SyncCaption</span>
                </div>
                <div style="display:flex;align-items:center;gap:14px;padding:14px 18px">
                    <p style="margin:0;color:var(--ink-2);font-size:12.5px;flex:1;line-height:1.5">
                        Pulls employee profiles from HRIS. New hires appear in the directory automatically.
                        Departments and sites are not touched — those are assigned here.
                    </p>
                    <button class="btn" style="width:auto;margin:0;padding:10px 20px" disabled="@syncing" @onclick="SyncNow">
                        @(syncing ? "Syncing..." : "Sync now")
                        <span class="orb"><i data-lucide="download"></i></span>
                    </button>
                </div>
                @if (syncResult is not null)
                {
                    <div class="note" style="margin:0 14px 14px;border-radius:10px">
                        <i data-lucide="check-circle-2"></i>
                        <span>@syncResult</span>
                    </div>
                }
            </div>
        </div>

        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head"><i data-lucide="history"></i><span>Recent syncs</span><span class="meta">@syncHistory.Items.Length runs</span></div>
                <table class="u-table">
                    <thead>
                        <tr><th>Started</th><th>Inserted</th><th>Updated</th><th>Deactivated</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var run in syncHistory.Items)
                        {
                            <tr>
                                <td class="mono">@run.StartedAt.ToLocalTime():dd MMM HH:mm</td>
                                <td class="mono" style="color:var(--accent-ink)">@run.Inserted</td>
                                <td class="mono" style="color:var(--ink-2)">@run.Updated</td>
                                <td class="mono" style="color:var(--danger)">@run.Deactivated</td>
                                <td><span class="dot @(run.Succeeded ? "on" : "busy")">@(run.Succeeded ? "Success" : "Failed")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (syncHistory.Items.Length == 0) { <div class="tree-empty" style="padding:14px">No sync runs yet.</div> }
            </div>
        </div>
    }

    @if (Tab == 1)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head"><i data-lucide="laptop"></i><span>Active sessions</span><span class="meta">@sessions.Count</span>
                    <button class="org-act" title="Refresh sessions" @onclick="LoadSessions"><i data-lucide="refresh-cw"></i></button>
                </div>
                @if (sessions.Count == 0)
                {
                    <div class="tree-empty" style="padding:14px">No active sessions.</div>
                }
                else
                {
                    <table class="u-table">
                        <thead>
                            <tr><th>User</th><th>IP address</th><th>Device</th><th>Expires</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var session in sessions)
                            {
                                <tr>
                                    <td style="font-weight:600">@session.Name</td>
                                    <td class="mono">@(session.IpAddress ?? "—")</td>
                                    <td class="mono" style="font-size:11px;color:var(--ink-3)">@(session.DeviceFingerprint ?? "—")</td>
                                    <td><span class="mono">@(TimeUntil(session.ExpiresAt))</span></td>
                                    <td class="acts">
                                        <button title="Revoke session" @onclick="() => RevokeSession(session)"><i data-lucide="log-out"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (Tab == 2)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head"><i data-lucide="scroll-text"></i><span>Audit trail</span><span class="meta">@audit?.Total.ToString("N0") records</span></div>
                @if (audit is null)
                {
                    <div style="padding:14px"><div class="skel"></div></div>
                }
                else
                {
                    <table class="u-table">
                        <thead>
                            <tr><th>Timestamp</th><th>Action</th><th>Actor</th><th>Entity</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in audit.Items)
                            {
                                <tr>
                                    <td class="mono">@row.CreatedAt.ToLocalTime():dd MMM HH:mm</td>
                                    <td><span class="tag">@row.Action</span></td>
                                    <td>@(row.ActorNik ?? "system")</td>
                                    <td class="mono" style="color:var(--ink-2)">@(row.EntityId ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (Tab == 3)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="building-2"></i> <span>Organization</span>
                    <span class="meta">@org.Departments.Length departments · @org.Sites.Length sites · @divisions.Length divisions</span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:0">
                    <div style="padding:14px 18px;border-right:1px solid var(--line-soft)">
                        <div style="display:flex;gap:8px;margin-bottom:12px">
                            <input class="org-input" placeholder="Code" @bind="newDeptCode" />
                            <input class="org-input" placeholder="Department name" @bind="newDeptName" />
                            <button class="org-add" @onclick="AddDepartment"><i data-lucide="plus"></i></button>
                        </div>
                        @foreach (var d in org.Departments.OrderBy(x => x.Name))
                        {
                            <div class="org-row">
                                <span class="mono" style="color:var(--ink-3);font-size:11px">@d.Code</span>
                                <span style="font-weight:600">@d.Name</span>
                                @if (!d.IsActive) { <span style="color:var(--danger);font-size:11px">inactive</span> }
                                <button class="org-act" title="@(d.IsActive ? "Deactivate" : "Reactivate")"
                                        @onclick="() => ToggleDepartment(d)">
                                    <i data-lucide="@(d.IsActive ? "eye-off" : "eye")"></i>
                                </button>
                            </div>
                        }
                        @if (org.Departments.Length == 0) { <div class="tree-empty">No departments yet — add the first one above.</div> }
                    </div>
                    <div style="padding:14px 18px">
                        <div style="display:flex;gap:8px;margin-bottom:12px">
                            <input class="org-input" placeholder="Code" @bind="newSiteCode" />
                            <input class="org-input" placeholder="Site name" @bind="newSiteName" />
                            <button class="org-add" @onclick="AddSite"><i data-lucide="plus"></i></button>
                        </div>
                        @foreach (var s in org.Sites.OrderBy(x => x.Name))
                        {
                            <div class="org-row">
                                <span class="mono" style="color:var(--ink-3);font-size:11px">@s.Code</span>
                                <span style="font-weight:600">@s.Name</span>
                                @if (!s.IsActive) { <span style="color:var(--danger);font-size:11px">inactive</span> }
                                <button class="org-act" title="@(s.IsActive ? "Deactivate" : "Reactivate")"
                                        @onclick="() => ToggleSite(s)">
                                    <i data-lucide="@(s.IsActive ? "eye-off" : "eye")"></i>
                                </button>
                            </div>
                        }
                        @if (org.Sites.Length == 0) { <div class="tree-empty">No sites yet — add the first one above.</div> }
                    </div>
                </div>
                <div style="padding:14px 18px;border-top:1px solid var(--line-soft)">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px">
                        <span style="font-weight:600;font-size:13px">Divisions</span>
                        <span class="meta" style="margin-left:0;color:var(--ink-3);font-size:12px">admin grouping of one department + one site</span>
                        <button class="btn btn-sm accent" style="margin-left:auto" @onclick="() => OpenDivisionEditor(null)">
                            <i data-lucide="plus" style="width:13px;height:13px"></i> New division
                        </button>
                    </div>
                    @if (divisionsLoading)
                    {
                        <div class="skel"></div>
                    }
                    else if (divisions.Length == 0)
                    {
                        <div class="tree-empty">No divisions yet — create one above.</div>
                    }
                    else
                    {
                        <table class="u-table">
                            <thead>
                                <tr><th>Code</th><th>Name</th><th>Department</th><th>Site</th><th>Active</th><th>Members</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var d in divisions)
                                {
                                    <tr @key="d.Code" class="@(d.IsActive ? "" : "inactive")">
                                        <td class="mono">@d.Code</td>
                                        <td style="font-weight:600">@d.Name</td>
                                        <td>@(d.DepartmentName ?? "—")</td>
                                        <td>@(d.SiteName ?? "—")</td>
                                        <td><span class="dot @(d.IsActive ? "on" : "busy")">@(d.IsActive ? "Active" : "Inactive")</span></td>
                                        <td class="mono">@d.ActiveMemberCount/@d.MemberCount</td>
                                        <td class="acts">
                                            <button title="Edit" @onclick="() => OpenDivisionEditor(d)"><i data-lucide="pencil"></i></button>
                                            <button title="@(d.IsActive ? "Deactivate" : "Reactivate")" @onclick="() => ToggleDivision(d)">
                                                <i data-lucide="@(d.IsActive ? "eye-off" : "eye")"></i>
                                            </button>
                                            <button title="Delete" @onclick="() => DeleteDivision(d)"><i data-lucide="trash-2"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    }

    @if (Tab == 4)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="folder-tree"></i> <span>Directory Tree</span>
                    <span class="meta">@(dirGroupsLoading ? "Loading..." : $"{dirGroups.Length} groups")</span>
                    @if (Auth.IsAdmin)
                    {
                        <button class="btn btn-sm accent" style="margin-left:auto" @onclick="() => OpenGroupEditor(null)">
                            <i data-lucide="plus" style="width:13px;height:13px"></i> New group
                        </button>
                    }
                </div>
                @if (dirGroupsLoading)
                {
                    <div style="padding:14px"><div class="skel"></div></div>
                }
                else if (dirGroups.Length == 0)
                {
                    <div class="tree-empty">No directory groups yet.@(Auth.IsAdmin ? " Create one above." : "")</div>
                }
                else
                {
                    <div class="tree">
                        @RenderDirTree(dirGroups.Where(g => g.ParentId == null).OrderBy(g => g.SortOrder).ToArray(), 0)
                    </div>
                }
            </div>
        </div>
    }

    @if (Tab == 5)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="network"></i> <span>Organization Chart</span>
                    <span class="meta">@(orgNodesLoading ? "Loading..." : $"{orgNodes.Length} nodes")</span>
                    @if (Auth.IsAdmin)
                    {
                        <button class="btn btn-sm accent" style="margin-left:auto" @onclick="() => OpenNodeEditor(null)">
                            <i data-lucide="plus" style="width:13px;height:13px"></i> New node
                        </button>
                    }
                </div>
                @if (orgNodesLoading)
                {
                    <div style="padding:14px"><div class="skel"></div></div>
                }
                else if (orgNodes.Length == 0)
                {
                    <div class="tree-empty">No organization nodes yet.@(Auth.IsAdmin ? " Create one above." : "")</div>
                }
                else
                {
                    <div class="chart">
                        @RenderOrgChart(orgNodes.Where(n => n.ParentId == null).OrderBy(n => n.SortOrder).ToArray(), 0)
                    </div>
                }
            </div>
        </div>
    }

    @if (Tab == 6)
    {
        <div class="tray rise rise-3">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head">
                    <i data-lucide="users"></i> <span>Users</span>
                    <span class="meta">@($"{page?.Total:N0} total")</span>
                </div>
                <div style="display:flex;gap:10px;padding:12px 18px;border-bottom:1px solid var(--line-soft);align-items:center">
                    <div class="search" style="flex:0 1 320px;margin:0">
                        <i data-lucide="search"></i>
                        <input type="text" placeholder="Search by name or ID" @bind="query" @bind:event="oninput" @bind:after="() => ReloadUsers(1)" />
                    </div>
                    <button class="btn" style="width:auto;margin:0 0 0 auto;padding:9px 18px" @onclick="OpenCreate">
                        Add user <span class="orb"><i data-lucide="plus"></i></span>
                    </button>
                </div>

                @if (usersError is not null)
                {
                    <div class="tree-empty">@usersError</div>
                }
                else if (page is null)
                {
                    <div style="padding:14px"><div class="skel"></div></div>
                }
                else
                {
                    <table class="u-table">
                        <thead>
                            <tr><th>ID</th><th>Name</th><th>Position</th><th>Role</th><th>Active</th><th>Presence</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var u in page.Items)
                            {
                                <tr @key="u.Nik" class="@(u.IsActive ? "" : "inactive")">
                                    <td class="mono">@u.Nik</td>
                                    <td style="font-weight:600">@u.Name</td>
                                    <td>@(u.Position ?? "—")</td>
                                    <td>@(u.Roles.Length == 0 ? "—" : string.Join(", ", u.Roles))</td>
                                    <td>@(u.IsActive ? "Yes" : "No")</td>
                                    <td><span class="dot @u.Status">@StatusLabel(u.Status)</span></td>
                                    <td class="acts">
                                        <button title="Edit" @onclick="() => OpenEdit(u)"><i data-lucide="pencil"></i></button>
                                        <button title="Reset password to default flow" @onclick="() => ResetPassword(u)"><i data-lucide="key-round"></i></button>
                                        <button title="@(u.IsActive ? "Deactivate" : "Reactivate")" @onclick="() => ToggleActive(u)">
                                            <i data-lucide="@(u.IsActive ? "user-x" : "user-check")"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (page is { } pg && TotalPages > 1)
                    {
                        <div style="display:flex;gap:10px;align-items:center;justify-content:center;padding:12px">
                            <button class="org-act" disabled="@(pg.Page <= 1)" @onclick="() => ReloadUsers(pg.Page - 1)"><i data-lucide="chevron-left"></i></button>
                            <span style="font-size:12px;color:var(--ink-2)">Page @pg.Page of @TotalPages</span>
                            <button class="org-act" disabled="@(pg.Page >= TotalPages)" @onclick="() => ReloadUsers(pg.Page + 1)"><i data-lucide="chevron-right"></i></button>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@* ---- user drawer: create / edit share one shell ---- *@
<div class="backdrop @(drawer is not null ? "on" : "")" @onclick="CloseDrawer"></div>
<div class="drawer @(drawer is not null ? "on" : "")" role="dialog" aria-label="User">
    <div class="tray">
        <div class="core">
            <div class="drawer-head">
                @(drawer?.IsCreate == true ? "Add user" : $"Edit {drawer?.Nik}")
                <button class="drawer-close" @onclick="CloseDrawer"><i data-lucide="x"></i></button>
            </div>
            @if (drawer is not null)
            {
                <div class="drawer-body">
                    @if (drawer.IsCreate)
                    {
                        <div class="field"><label>Employee ID</label><input @bind="drawer.Nik" placeholder="e.g. 20140312" /></div>
                    }
                    <div class="field"><label>Name</label><input @bind="drawer.Name" /></div>
                    <div class="field"><label>Email</label><input @bind="drawer.Email" /></div>
                    <div class="field"><label>Position</label><input @bind="drawer.Position" /></div>
                    <div class="field">
                        <label>Department</label>
                        <AppSelect Label="Department" Value="@drawer.DepartmentCode" ValueChanged="v => drawer.DepartmentCode = v"
                                   Options="@DeptOptions" />
                    </div>
                    <div class="field">
                        <label>Site</label>
                        <AppSelect Label="Site" Value="@drawer.SiteCode" ValueChanged="v => drawer.SiteCode = v"
                                   Options="@SiteOptions" />
                    </div>
                    @if (!drawer.IsCreate)
                    {
                        <div class="field">
                            <label>Roles</label>
                            <label style="display:flex;gap:8px;align-items:center;font-weight:500;text-transform:none">
                                <input type="checkbox" style="width:auto" @bind="drawer.IsAdmin" /> Administrator
                            </label>
                        </div>
                    }
                    <div class="note">
                        <i data-lucide="info"></i>
                        <span>@(drawer.IsCreate
                            ? "The new user signs in with the default password 1234 and must set their own at first login."
                            : "Profile edits are protected from the next HRIS sync.")</span>
                    </div>
                    @if (drawer.Error is not null)
                    {
                        <div class="note err"><i data-lucide="alert-circle"></i><span>@drawer.Error</span></div>
                    }
                    <button class="btn" style="margin-top:14px" disabled="@drawer.Saving" @onclick="SaveDrawer">
                        @(drawer.Saving ? "Saving..." : drawer.IsCreate ? "Create user" : "Save changes")
                        <span class="orb"><i data-lucide="check"></i></span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@if (groupEditor is not null)
{
    <div class="backdrop on" @onclick="CloseGroupEditor"></div>
    <div class="drawer on" role="dialog" aria-label="Edit group">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                @(groupEditor.IsCreate ? "New group" : $"Edit {groupEditor.Name}")
                <button class="drawer-close" @onclick="CloseGroupEditor"><i data-lucide="x"></i></button>
            </div>
            <div class="drawer-body">
                <div class="field"><label>Name</label><input @bind="groupEditor.Name" placeholder="e.g. Engineering" /></div>
                <div class="field">
                    <label>Parent group</label>
                    <AppSelect Label="Parent" Value="@groupEditor.ParentIdString" ValueChanged="v => groupEditor.ParentIdString = v"
                               Options="@GroupParentOptions(groupEditor.Id)" />
                </div>
                @if (groupEditor.Error is not null)
                {
                    <div class="note err"><i data-lucide="alert-circle"></i><span>@groupEditor.Error</span></div>
                }
                @if (!groupEditor.IsCreate && groupEditor.Members.Length > 0)
                {
                    <div class="field">
                        <label>Members (@groupEditor.Members.Length)</label>
                        <div class="member-list">
                            @foreach (var m in groupEditor.Members)
                            {
                                <div class="member-row">
                                    <span>@m.Name <span class="mono" style="opacity:0.6">@m.Nik</span></span>
                                    <button class="org-act" title="Remove member" @onclick="() => RemoveMember(groupEditor, m.Nik)"><i data-lucide="x"></i></button>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="field">
                    <label>Add member</label>
                    <AppMemberPicker Placeholder="Search by name or NIK..." ValueChanged="r => OnPickMember(r, PickerKind.Group)" />
                </div>
                @if (!groupEditor.IsCreate)
                {
                    <button class="btn" style="margin-top:14px;width:100%;background:var(--danger-soft);color:var(--danger);border:1px solid var(--danger-soft)" @onclick="() => DeleteGroup(groupEditor)">
                        Delete group
                    </button>
                }
                <button class="btn" style="margin-top:14px;width:100%" disabled="@groupEditor.Saving" @onclick="SaveGroup">
                    @(groupEditor.Saving ? "Saving..." : groupEditor.IsCreate ? "Create group" : "Save changes")
                    <span class="orb"><i data-lucide="check"></i></span>
                </button>
            </div>
        </div></div>
    </div>
}

@if (nodeEditor is not null)
{
    <div class="backdrop on" @onclick="CloseNodeEditor"></div>
    <div class="drawer on" role="dialog" aria-label="Edit node">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                @(nodeEditor.IsCreate ? "New node" : $"Edit {nodeEditor.Name}")
                <button class="drawer-close" @onclick="CloseNodeEditor"><i data-lucide="x"></i></button>
            </div>
            <div class="drawer-body">
                <div class="field"><label>Name</label><input @bind="nodeEditor.Name" placeholder="e.g. Engineering Manager" /></div>
                <div class="field"><label>Title (optional)</label><input @bind="nodeEditor.Title" placeholder="e.g. VP Engineering" /></div>
                <div class="field">
                    <label>Parent node</label>
                    <AppSelect Label="Parent" Value="@nodeEditor.ParentIdString" ValueChanged="v => nodeEditor.ParentIdString = v"
                               Options="@NodeParentOptions(nodeEditor.Id)" />
                </div>
                <div class="field">
                    <label>Department</label>
                    <AppSelect Label="Department" Value="@nodeEditor.DepartmentIdString" ValueChanged="v => nodeEditor.DepartmentIdString = v"
                               Options="@NodeDeptOptions" />
                </div>
                @if (nodeEditor.Error is not null)
                {
                    <div class="note err"><i data-lucide="alert-circle"></i><span>@nodeEditor.Error</span></div>
                }
                @if (!nodeEditor.IsCreate && nodeEditor.Members.Length > 0)
                {
                    <div class="field">
                        <label>Members (@nodeEditor.Members.Length)</label>
                        <div class="member-list">
                            @foreach (var m in nodeEditor.Members)
                            {
                                <div class="member-row">
                                    <span>@m.Name <span class="mono" style="opacity:0.6">@m.Nik</span></span>
                                    <button class="org-act" title="Remove member" @onclick="() => RemoveNodeMember(nodeEditor, m.Nik)"><i data-lucide="x"></i></button>
                                </div>
                            }
                        </div>
                    </div>
                }
                <div class="field">
                    <label>Add member</label>
                    <AppMemberPicker Placeholder="Search by name or NIK..." ValueChanged="r => OnPickMember(r, PickerKind.Node)" />
                </div>
                @if (!nodeEditor.IsCreate)
                {
                    <button class="btn" style="margin-top:14px;width:100%;background:var(--danger-soft);color:var(--danger);border:1px solid var(--danger-soft)" @onclick="() => DeleteNode(nodeEditor)">
                        Delete node
                    </button>
                }
                <button class="btn" style="margin-top:14px;width:100%" disabled="@nodeEditor.Saving" @onclick="SaveNode">
                    @(nodeEditor.Saving ? "Saving..." : nodeEditor.IsCreate ? "Create node" : "Save changes")
                    <span class="orb"><i data-lucide="check"></i></span>
                </button>
            </div>
        </div></div>
    </div>
}

@if (divisionEditor is not null)
{
    <div class="backdrop on" @onclick="CloseDivisionEditor"></div>
    <div class="drawer on" role="dialog" aria-label="Edit division">
        <div class="tray"><div class="core" style="display:flex; flex-direction:column; height:100%">
            <div class="drawer-head">
                @(divisionEditor.IsCreate ? "New division" : $"Edit {divisionEditor.Code}")
                <button class="drawer-close" @onclick="CloseDivisionEditor"><i data-lucide="x"></i></button>
            </div>
            <div class="drawer-body">
                @if (divisionEditor.IsCreate)
                {
                    <div class="field"><label>Code</label><input @bind="divisionEditor.Code" placeholder="e.g. ENG-CORE" /></div>
                }
                <div class="field"><label>Name</label><input @bind="divisionEditor.Name" placeholder="e.g. Engineering Core" /></div>
                <div class="field">
                    <label>Department</label>
                    <AppSelect Label="Department" Value="@divisionEditor.DepartmentCode" ValueChanged="v => divisionEditor.DepartmentCode = v"
                               Options="@DeptOptions" />
                </div>
                <div class="field">
                    <label>Site</label>
                    <AppSelect Label="Site" Value="@divisionEditor.SiteCode" ValueChanged="v => divisionEditor.SiteCode = v"
                               Options="@SiteOptions" />
                </div>
                <div class="field">
                    <label>Active</label>
                    <label style="display:flex;gap:8px;align-items:center;font-weight:500;text-transform:none">
                        <input type="checkbox" style="width:auto" @bind="divisionEditor.IsActive" /> This division is active
                    </label>
                </div>
                @if (divisionEditor.Error is not null)
                {
                    <div class="note err"><i data-lucide="alert-circle"></i><span>@divisionEditor.Error</span></div>
                }
                <button class="btn" style="margin-top:14px;width:100%" disabled="@divisionEditor.Saving" @onclick="SaveDivision">
                    @(divisionEditor.Saving ? "Saving..." : divisionEditor.IsCreate ? "Create division" : "Save changes")
                    <span class="orb"><i data-lucide="check"></i></span>
                </button>
            </div>
        </div></div>
    </div>
}

<ProfileDrawer Person="selectedDirMember" OnClose="() => selectedDirMember = null" />
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    private bool loaded, syncing;
    private string query = "";
    private string? usersError, syncResult;
    private AdminUserPageDto? page;
    private OrgViewDto org = new([], []);
    private HrisSyncStatusDto? syncStatus;
    private DrawerState? drawer;

    // Org tree editors (relocated from Directory.razor)
    private DirGroupDto[] dirGroups = [];
    private bool dirGroupsLoading = true;
    private OrgNodeDto[] orgNodes = [];
    private bool orgNodesLoading = true;
    private GroupEditorState? groupEditor;
    private NodeEditorState? nodeEditor;
    private Employee? selectedDirMember;
    private Guid? DragGroupId;      // id being dragged
    private Guid? DragTarget;       // hover target for reparent
    private Guid? OrgDragGroupId;
    private Guid? OrgDragTarget;

    // Divisions
    private AdminDivisionRowDto[] divisions = [];
    private bool divisionsLoading = true;
    private DivisionEditorState? divisionEditor;

    private List<AppOption> DeptOptions => [new("", "(none)"), .. org.Departments.Where(x => x.IsActive).OrderBy(x => x.Name).Select(d => new AppOption(d.Code, d.Name))];
    private List<AppOption> SiteOptions => [new("", "(none)"), .. org.Sites.Where(x => x.IsActive).OrderBy(x => x.Name).Select(s => new AppOption(s.Code, s.Name))];

    private string newDeptCode = "", newDeptName = "", newSiteCode = "", newSiteName = "";

    private int tab;
    private int Tab => tab;

    private int TotalPages => page is null ? 1 : (int)Math.Ceiling(page.Total / (double)page.PageSize);

    private string SyncCaption => syncStatus?.LastSyncedAt is null
        ? "Never synced"
        : $"{syncStatus.EmployeeCount:N0} employees · last {syncStatus.LastSyncedAt.Value.ToLocalTime():dd MMM HH:mm}";

    private static string StatusLabel(string s) => s switch
        { "on" => "Online", "away" => "Away", "busy" => "Busy", _ => "Offline" };

    private static string TimeUntil(DateTime expiresUtc)
    {
        var delta = expiresUtc - DateTime.UtcNow;
        return delta.TotalMinutes < 1 ? "Expiring"
            : delta.TotalHours < 1 ? $"{Math.Ceiling(delta.TotalMinutes)} min left"
            : delta.TotalDays < 1 ? $"{Math.Ceiling(delta.TotalHours)} h left"
            : $"{Math.Ceiling(delta.TotalDays)} d left";
