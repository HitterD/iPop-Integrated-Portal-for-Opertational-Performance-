@page "/admin"
@page "/admin/{Section}"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav
@using IPop.Web.Components.Admin
@using IPop.Web.Components.Phone.Admin
@inject PhoneState Phone

<PageTitle>@(Current?.Label ?? "Administration") — IPop</PageTitle>

@if (!loaded)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray"><div class="core"><div class="skel"></div></div></div>
    </div>
}
else if (Visible.Count == 0)
{
    <div class="content" style="grid-template-columns:1fr">
        <div class="tray rise rise-1"><div class="core" style="padding:34px">
            <div class="tree-empty">This page is only available to administrators.</div>
        </div></div>
    </div>
}
else if (Phone.IsPhone)
{
    @if (string.IsNullOrEmpty(Section)) { <AdminHomePhone IsAdmin="Auth.IsAdmin" /> }
    else if (Current?.Slug == "approval") { <PhoneScreen Title="Approvers" Class="m-admin-approval"><a href="/admin">‹ Administration</a><AdminApproval /></PhoneScreen> }
    else if (Current?.Slug == "users") { <AdminUserManagement @ref="userRef" /> }
    else if (Current?.Slug == "announcements") { <PhoneScreen Title="Announcements" Class="m-admin-announcements"><a href="/admin">‹ Administration</a><AdminAnnouncements @ref="announceRef" /></PhoneScreen> }
    else { <AdminReadOnlyPhone Section="@(Current?.Slug ?? "organization")" Title="@(Current?.Label ?? "Administration")" /> }
}
else if (Current is not null)
{
<div class="content admin-v6 adm-shell">
    @* Settings-style sidebar: one route per section so back/refresh keep the place. *@
    <nav class="adm-side" aria-label="Administration sections">
        @foreach (var g in Visible.GroupBy(x => x.Group))
        {
            <div class="adm-side-group">
                <div class="adm-side-label">@g.Key</div>
                @foreach (var s in g)
                {
                    <a class="adm-side-item @(s == Current ? "on" : "")" href="/admin/@s.Slug"
                       aria-current="@(s == Current ? "page" : null)">
                        <span class="adm-side-ico @s.Tint"><i data-lucide="@s.Icon"></i></span>
                        <span class="adm-side-txt"><b>@s.Label</b><small>@s.Hint</small></span>
                    </a>
                }
            </div>
        }
    </nav>

    <section class="adm-main" aria-labelledby="adm-main-title">
        <header class="adm-main-head">
            <h2 id="adm-main-title">@Current.Label</h2>
            <p>@(Current.Slug == "meeting-rooms" ? "Choose where cameras are allowed and how long server recordings are kept." : Current.Hint)</p>
        </header>

        @switch (Current.Slug)
        {
            case "users":
                <AdminUserManagement @ref="userRef" />
                break;
            case "organization":
                <div class="adm-seg adm-view-seg" role="tablist" aria-label="Organization view">
                    <button type="button" role="tab" class="@(orgView == 0 ? "on" : "")" aria-selected="@(orgView == 0 ? "true" : "false")" @onclick="() => orgView = 0">Tree</button>
                    <button type="button" role="tab" class="@(orgView == 1 ? "on" : "")" aria-selected="@(orgView == 1 ? "true" : "false")" @onclick="() => orgView = 1">Chart</button>
                </div>
                @if (orgView == 0)
                {
                    <AdminDirectoryTree @ref="treeRef" />
                }
                else
                {
                    <AdminOrgChart @ref="chartRef" />
                }
                break;
            case "security":
                <div class="adm-seg adm-view-seg" role="tablist" aria-label="Security view">
                    <button type="button" role="tab" class="@(secView == 0 ? "on" : "")" aria-selected="@(secView == 0 ? "true" : "false")" @onclick="() => secView = 0">Sessions</button>
                    <button type="button" role="tab" class="@(secView == 1 ? "on" : "")" aria-selected="@(secView == 1 ? "true" : "false")" @onclick="() => secView = 1">Audit log</button>
                </div>
                @if (secView == 0)
                {
                    <AdminSessions @ref="sessionsRef" />
                }
                else
                {
                    <AdminAuditTrail @ref="auditRef" />
                }
                break;
            case "announcements":
                <AdminAnnouncements @ref="announceRef" />
                break;
            case "hris":
                <AdminHrisSync @ref="hrisRef" />
                break;
            case "meeting-rooms":
                <AdminMeetingRooms />
                break;
            case "calendar":
                <AdminHolidays />
                break;
            case "notifier":
                <AdminNotifier />
                break;
            case "approval":
                <AdminApproval />
                break;
            case "email":
                <AdminEmail />
                break;
        }
    </section>
</div>
}

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    [Parameter] public string? Section { get; set; }

    private IReadOnlyList<AdminSections.Section> Visible => AdminSections.Visible(Auth.IsAdmin, Auth.Can);

    private AdminSections.Section? Current;
    private bool loaded;
    private int orgView;
    private int secView;

    private AdminHrisSync? hrisRef;
    private AdminAnnouncements? announceRef;
    private AdminSessions? sessionsRef;
    private AdminAuditTrail? auditRef;
    private AdminDirectoryTree? treeRef;
    private AdminOrgChart? chartRef;
    private AdminUserManagement? userRef;

    protected override void OnInitialized()
    {
        Layout?.SetHeader("Administration", "People, structure and system settings");
        if (Layout is not null) Layout.EscapePressed += OnEscape;
        Phone.Changed += OnPhoneChanged;
        Auth.DirectoryChanged += OnDirectoryChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        loaded = true;
        OnParametersSet();
    }

    // Bare /admin and unknown or not-allowed slugs land on the first section this person may open;
    // replace so Back doesn't bounce.
    protected override void OnParametersSet()
    {
        if (!loaded) return;
        var next = Visible.FirstOrDefault(s => string.Equals(s.Slug, Section, StringComparison.OrdinalIgnoreCase));
        if (next is null)
        {
            Current = null;
            if (Phone.IsPhone || !Phone.IsInitialized || Visible.Count == 0) return;
            Nav.NavigateTo($"/admin/{Visible[0].Slug}", replace: true);
            return;
        }
        Current = next;
    }

    private void OnPhoneChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnEscape()
    {
        treeRef?.CloseAllDrawers();
        chartRef?.CloseAllDrawers();
        userRef?.CloseDrawer();
    }

    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
        if (hrisRef is not null) await hrisRef.Reload();
        if (announceRef is not null) await announceRef.Reload();
        if (sessionsRef is not null) await sessionsRef.Reload();
        if (auditRef is not null) await auditRef.Reload();
        if (treeRef is not null) await treeRef.Reload();
        if (chartRef is not null) await chartRef.Reload();
        if (userRef is not null) await userRef.Reload();
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Phone.IsInitialized) { await Phone.StartAsync(); OnParametersSet(); StateHasChanged(); }
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        if (Layout is not null) Layout.EscapePressed -= OnEscape;
        Phone.Changed -= OnPhoneChanged;
        Auth.DirectoryChanged -= OnDirectoryChanged;
    }
}
