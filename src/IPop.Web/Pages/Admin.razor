    private record SyncHistoryDto(HrisSyncRunDto[] Items, int Page, int PageSize);
    private record HrisSyncRunDto(Guid Id, DateTime StartedAt, DateTime FinishedAt, int Inserted,
        int Updated, int Deactivated, bool Succeeded, string? Error);

    private record HrisSyncStatusDto(DateTime? LastSyncedAt, int EmployeeCount);

    private async Task SyncNow()
    {
        syncing = true;
        syncResult = null;
        var res = await Auth.SendAsync(HttpMethod.Post, "/api/admin/hris/sync");
        if (res.IsSuccessStatusCode)
        {
            var r = await res.Content.ReadFromJsonAsync<SyncResultDto>();
            syncResult = r is null ? "Sync finished."
                : $"Sync finished: {r.Inserted} added, {r.Updated} updated, {r.Deactivated} deactivated.";
        }
        else syncResult = "Sync failed — the gateway may be rate-limited. Try again in a minute.";
        syncing = false;
        await ReloadSyncStatus();
    }
    private record SyncResultDto(int Inserted, int Updated, int Deactivated, DateTime SyncedAt);

    private async Task ReloadUsers(int p)
    {
        var url = $"/api/admin/users?page={p}&pageSize=50" + (string.IsNullOrWhiteSpace(query) ? "" : $"&q={Uri.EscapeDataString(query.Trim())}");
        page = await Auth.GetAsync<AdminUserPageDto>(url);
        usersError = page is null ? "Could not load users." : null;
