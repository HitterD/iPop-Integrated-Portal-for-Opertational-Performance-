    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        loaded = true;
        if (!Auth.IsAdmin) return;
        await Task.WhenAll(ReloadUsers(1), ReloadOrg(), ReloadSyncStatus(), LoadSyncHistory(), LoadSessions(), LoadAudit(),
            LoadDirGroups(), LoadOrgNodes(), LoadDivisions());
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadSessions();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private void OnDirectoryChanged() => _ = InvokeAsync(async () =>
    {
