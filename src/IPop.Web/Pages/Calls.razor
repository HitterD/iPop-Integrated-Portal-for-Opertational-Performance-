@page "/calls"
@implements IDisposable
@using IPop.Application.Calls
@using IPop.Web.Components.Calls
@using IPop.Web.Components.Meetings
@inject IJSRuntime JS
@inject NotificationState Notifs
@inject AuthState Auth
@inject CallState CallSvc
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject BadgeState Badges
@inject IPop.Web.Services.PeopleLinks PLinks
@inject IPop.Web.Services.CalendarLinks CalLinks

<PageTitle>Calls &amp; Meetings — IPop</PageTitle>

<div class="calls-v6 @(mDetail ? "m-detail" : "") @(tab == "rooms" ? "calls-rooms" : "")">
    <div class="toolbar calls-toolbar">
        <div class="calls-tabs">
            <button class="@(tab == "recents" ? "active" : "")" @onclick='() => SetTab("recents")'><i data-lucide="history"></i> Recents <span>@history.Total</span></button>
            <button class="@(tab == "scheduled" ? "active" : "")" @onclick='() => SetTab("scheduled")'><i data-lucide="calendar-clock"></i> Scheduled <span>@meetings.Count</span></button>
            <button class="@(tab == "rooms" ? "active" : "")" @onclick='() => SetTab("rooms")'><i data-lucide="door-open"></i> Meeting Rooms <span>5</span></button>
        </div>
        @if (tab == "rooms")
        {
            <span class="calls-toolbar-spacer"></span>
        }
        else
        {
            <div class="v6-search calls-search"><i data-lucide="search"></i><input type="search" aria-label="Search calls or meetings" placeholder="Search calls" @bind="search" @bind:event="oninput" /></div>
        }
        <button type="button" class="ghost-btn" @onclick="() => showDeviceTest = true"><i data-lucide="headphones"></i>Test devices</button>
        @if (tab == "rooms")
        {
            <button type="button" class="ghost-btn calls-book-room" @onclick="BookRoom"><i data-lucide="calendar-plus"></i>Book a room</button>
        }
        else
        {
            <span class="sch-menu-wrap">
                <button type="button" class="@($"ghost-btn sch-btn {(scheduleMenu ? "sch-open" : "")}")" aria-haspopup="menu" aria-expanded="@(scheduleMenu ? "true" : "false")" @onclick="() => scheduleMenu = !scheduleMenu"><i data-lucide="calendar-plus"></i>Schedule<i data-lucide="chevron-down" class="sch-cv"></i></button>
                @if (scheduleMenu)
                {
                    <ScheduleMenu OnVoice="ScheduleVoice" OnRoom="ScheduleRoomAsync" OnClose="() => scheduleMenu = false" />
                }
            </span>
        }
        <button type="button" class="btn-primary" @onclick="FocusCallPicker"><i data-lucide="phone"></i>New call</button>
    </div>

    @* Schedule → Voice call opens the Calendar form on the voice kind; Meeting room opens the booking sheet (v3 §5). *@
    @if (bookingRoom is { } bk)
    {
        <BookingSheet RoomKey="@bk" Mode="@BookingSheet.ModeBook" OnClose="() => bookingRoom = null" OnBooked="BookedAsync" OnJoin="BookedNow" />
    }

    @if (CallSvc.NeedsHttps)
    {
        <div class="calls-https-banner" role="note">
            <i data-lucide="shield-alert"></i>
            <span><strong>Calls need HTTPS.</strong> On this http address the browser blocks the microphone, so the other person won't hear you.</span>
            <a href="@SecureUrl">Open secure version</a>
        </div>
    }
    <CallDeviceTest Open="showDeviceTest" OpenChanged="v => showDeviceTest = v" />

    @if (tab == "rooms")
    {
        <MeetingRoomsTab JoinKey="@roomJoinKey" RecordingId="@roomRecordingId" />
    }
    else
    {
    <div class="@($"calls-split {(tab == "scheduled" ? "sch" : "")}")"><div class="@($"calls-list {(tab == "scheduled" ? "sch-col" : "")}")">
    @if (tab == "recents")
    {
    <div class="calls-favorites">
        <div class="calls-favorites-head"><strong>FAVORITES</strong><a href="/directory">Manage</a></div>
        @if (favorites.Count == 0) { <span>Star people in Directory to add them here.</span> }
        @foreach (var person in favorites)
        {
            <button title="Call @person.Name" @onclick="() => CallAgain(person.Nik)"><PersonAvatar Nik="@person.Nik" Name="@person.Name" Size="44" Class="calls-fav-avatar" Decorative="true" />@person.Name</button>
        }
    </div>
    }


    @if (tab == "recents")
    {
        <div class="calls-history-filters" role="group" aria-label="Filter call history">
            @foreach (var option in new[] { "All", "Missed", "Incoming", "Outgoing" })
            {
                var filter = option.ToLowerInvariant();
                <button type="button" class="@(historyFilter == filter ? "active" : "")" @onclick="() => historyFilter = filter">@option<span>· @(filter == "all" ? history.Total : historyRows.Count(h => HistoryMatches(h, filter)))</span></button>
            }
            @if (historyRows.Any(h => !h.Seen))
            {
                <button type="button" class="calls-mark-seen" @onclick="MarkAllSeen"><i data-lucide="check-check"></i>Mark all as read</button>
            }
        </div>
    }
    @* ---- Header / peer picker ---- *@
    <div class="tray rise rise-1" id="calls-picker" hidden="@(!showPicker && selectedPeer is null)">
        <div class="core" style="padding:0;overflow:hidden">
            <div class="panel-head" style="flex-wrap:wrap;gap:10px">
                <i data-lucide="phone"></i> <span>Calls &amp; Meetings</span>
                <span class="meta conn"><i data-lucide="wifi" style="width:12px;height:12px"></i> @(CallSvc.IsConnected ? "Live" : "Connecting…")</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;flex-wrap:wrap">
                <div style="flex:1 1 260px;min-width:220px">
                    <div style="font-size:12px;font-weight:600;color:var(--ink-2);margin-bottom:6px">Start a call with…</div>
                    <AppMemberPicker Placeholder="Type a name…" Value="@selectedPeer" ValueChanged="OnPickPeer" />
                </div>
                <button class="btn" style="width:auto;margin:0;padding:10px 18px;align-self:end" disabled="@(selectedPeer is null)" @onclick="CallPeer">
                    <i data-lucide="phone-outgoing" style="width:14px;height:14px"></i> Call
                </button>
            </div>
            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="note" style="margin:0 14px 14px;border-radius:10px"><i data-lucide="info"></i><span>@notice</span></div>
            }
        </div>
    </div>

    @if (tab == "scheduled")
    {
        <ScheduledList Meetings="meetings" Me="@Auth.Me?.UserId" SelectedId="@detailMeeting?.Id" Search="@search" Now="clockNow"
                       OnSelect="m => OpenMeeting(m.Id)" OnSelectPast="OpenPastAsync" />
    }
    @* ---- Call history (grouped by date) ---- *@
    @if (tab == "recents")
    {
    <div class="calls-history">
            @if (historyRows.Count == 0)
            {
                <div class="tree-empty" style="padding:20px"><i data-lucide="phone-missed" style="width:18px;height:18px;margin-bottom:6px"></i>
                    <div>No calls yet — start your first call with a teammate.</div>
                </div>
            }
            else
            {
                <div class="calls-history-scroll">
                    @foreach (var g in historyRows.Where(h => HistoryMatches(h, historyFilter) && (string.IsNullOrWhiteSpace(search) || h.PeerName.Contains(search, StringComparison.OrdinalIgnoreCase))).GroupBy(h => h.StartedAt.ToLocalTime().Date).OrderByDescending(g => g.Key))
                    {
                        <div class="calls-date">@DateGroupLabel(g.Key)</div>
                        @foreach (var h in g)
                        {
                            <div class="calls-history-row @(detailCall?.CallId == h.CallId ? "selected" : "") @(h.Seen ? "" : "unseen")" role="button" tabindex="0" @onclick="() => OpenCall(h)" @onkeydown="e => SelectCallOnKey(e, h)">
                                <PersonAvatar Nik="@h.PeerNik" Name="@h.PeerName" Size="40" Class="calls-history-av" Decorative="true" />
                                <span class="calls-history-info">
                                    <strong class="@(h.Result == "missed" ? "missed" : "")">@h.PeerName</strong>
                                    <small class="calls-result @ResultClass(h)"><i data-lucide="@CallIcon(h)"></i> @HistoryDirection(h) · @ResultLabel(h)</small>
                                </span>
                                @if (!h.Seen)
                                {
                                    <span class="calls-unseen-dot" title="New missed call" aria-label="Unread"></span>
                                }
                                <time>@h.StartedAt.ToLocalTime().ToString("HH:mm")</time>
                                <span class="calls-row-actions">
                                    <button type="button" title="Call @h.PeerName" aria-label="Call @h.PeerName" disabled="@(string.IsNullOrWhiteSpace(h.PeerNik))" @onclick="() => CallAgain(h.PeerNik!)" @onclick:stopPropagation="true"><i data-lucide="phone"></i></button>
                                    @if (!string.IsNullOrWhiteSpace(h.PeerNik))
                                    {
                                        <a href="@ChatHref(h.PeerNik)" title="Message @h.PeerName" aria-label="Message @h.PeerName" @onclick:stopPropagation="true"><i data-lucide="message-circle"></i></a>
                                    }
                                </span>
                            </div>
                        }
                    }
                    @if (HasMoreHistory)
                    {
                        @* ipop-49: sits OUTSIDE the GroupBy loop so an appended page keeps its own
                           date headings instead of splitting a day across two groups. *@
                        <div style="display:flex;justify-content:center;padding:6px 0 2px">
                            <button class="btn-sm surface" @onclick="LoadMoreHistory" disabled="@historyLoadingMore">
                                @(historyLoadingMore ? "Loading…" : $"Show {history.Total - historyRows.Count} more")
                            </button>
                        </div>
                    }
                </div>
            }
    </div>

    }
    </div>
    <aside class="@($"calls-detail {(tab == "scheduled" ? "sch-detail" : "")}")">
        <button type="button" class="m-back" aria-label="Back" @onclick="MobileBack"><i data-lucide="chevron-left"></i></button>
        @if (detailMeeting is { } m)
        {
            @* Phone (v3 Task 10, mockup "1 · Meeting detail"): the detail is its own screen; Back returns to the list. Hidden on desktop. *@
            @if (tab == "scheduled")
            {
                <div class="sch-mnav"><button type="button" class="sch-back" aria-label="Back to Scheduled" @onclick="MobileBack"><i data-lucide="chevron-left"></i>Scheduled</button></div>
            }
            var model = MeetingDetailModel.FromMeeting(m, Auth.Me?.UserId);
            if (detailPast is { } past && past.Meeting.Id == m.Id) model = model with { Attended = past.Attended, Recordings = past.Recordings };
            <MeetingDetail Model="model" Now="clockNow" OnJoin="() => JoinMeeting(m)" OnEdit="() => EditMeeting(m)" OnCancel="() => CancelMeeting(m)"
                           OnOpenCalendar="() => OpenInCalendarAsync(m.Id)" OnChangeRoom="() => EditMeeting(m)" OnRespond="v => Respond(m.Id, v)" />
        }
        else if (detailCall is { } h)
        {
            <div class="calls-detail-hero">
                <PersonAvatar Nik="@h.PeerNik" Name="@h.PeerName" Size="84" Class="calls-detail-avatar" Viewable="true" />
                <h2>@h.PeerName</h2>
                <p><span class="calls-result-chip @ResultClass(h)"><i data-lucide="@CallIcon(h)"></i> @HistoryDirection(h) · @ResultLabel(h)</span></p>
                <p>@h.StartedAt.ToLocalTime().ToString("dddd, MMM d, yyyy · HH:mm", System.Globalization.CultureInfo.InvariantCulture)</p>
            </div>
            <div class="calls-detail-actions call-actions">
                <button type="button" disabled="@(string.IsNullOrWhiteSpace(h.PeerNik) || CallSvc.HasLiveCall)" @onclick="() => CallAgain(h.PeerNik!)"><i data-lucide="phone"></i>Call</button>
                @if (!string.IsNullOrWhiteSpace(h.PeerNik))
                {
                    <a href="@ChatHref(h.PeerNik)"><i data-lucide="message-circle"></i>Chat</a>
                    <a href="@PLinks.Profile(h.PeerNik)"><i data-lucide="contact-round"></i>Profile</a>
                }
            </div>
            var withPeer = historyRows.Where(x => !string.IsNullOrWhiteSpace(h.PeerNik) && x.PeerNik == h.PeerNik).ToList();
            var talked = withPeer.Where(x => x.Result == "completed").Sum(x => x.DurationSeconds);
            <div class="calls-detail-stats">
                <div><strong>@withPeer.Count</strong><span>Calls</span></div>
                <div><strong>@withPeer.Count(x => x.Result == "completed")</strong><span>Connected</span></div>
                <div><strong>@withPeer.Count(x => x.Result == "missed")</strong><span>Missed</span></div>
                <div><strong>@FormatSeconds(talked)</strong><span>Talk time</span></div>
            </div>
            <div class="calls-detail-block calls-contact-history"><strong>CALL HISTORY</strong><span>@historyRows.Count(x => x.PeerNik == h.PeerNik && !string.IsNullOrWhiteSpace(h.PeerNik)) calls</span>
                @foreach (var entry in historyRows.Where(x => x.PeerNik == h.PeerNik && !string.IsNullOrWhiteSpace(h.PeerNik)).Take(5))
                {
                    <div class="calls-contact-row @ResultClass(entry)"><i data-lucide="@CallIcon(entry)"></i><span>@HistoryDirection(entry) · @ResultLabel(entry)<small>@entry.StartedAt.ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</small></span><time>@(entry.Result == "completed" ? DurationLabel(entry) : "—")</time></div>
                }
            </div>
            <div class="calls-detail-block calls-note">
                <strong>NOTES</strong>
                <div class="calls-note-unavailable">Private notes are not saved yet.</div>
            </div>
        }
        else { <div class="calls-empty">@(tab == "scheduled" ? "Select a meeting to see its details." : "Select a call or meeting to see its details.")</div> }
    </aside></div>
    }
</div>

@code {
    /// Null only in component tests (no MainLayout cascade).
    [CascadingParameter] public MainLayout? Layout { get; set; }
    private bool showDeviceTest;
    private CallHistoryPage history = new([], 0, 1, 50);
    // ipop-49: the loader fetched one page of 50 and dropped the rest, while the panel head at
    // :109 renders the server's true Total. CallHistories gets a row PER PARTICIPANT per call and
    // is never pruned, so any active user passes 50 and then sees e.g. "312 calls" above exactly
    // 50 rows with no way to reach the others. Same shape as ipop-47 (archived rooms) and ipop-48
    // (thread replies); same remedy. Server side was already correct (CallService.cs:146 — true
    // CountAsync, clamps, honours Skip/Take), so this is client-only.
    private List<CallHistoryDto> historyRows = [];
    private int historyPage = 1;
    private bool historyLoadingMore;
    private bool HasMoreHistory => historyRows.Count < history.Total;
    private MemberSearchRow? selectedPeer;
    private string notice = "";
    private string tab = "recents";
    private string? roomJoinKey;
    private Guid? roomRecordingId;
    private string search = "";
    private string historyFilter = "all";
    private bool showPicker;
    private bool rsvpBusy;
    private System.Threading.Timer? clock;
    private bool scheduleMenu;
    private string? bookingRoom;
    /// The clock the countdowns and the Join window read; ticks every 30 s.
    private DateTime clockNow = DateTime.UtcNow;
    private MeetingInfo? detailMeeting;
    private PastMeetingInfo? detailPast;
    private CallHistoryDto? detailCall;
    private List<MeetingInfo> meetings = [];
    private List<DirectoryEmployeeDto> favorites = [];

    /// Same page on the https port run.ps1 -Https opens (7103).
    private string SecureUrl
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            return $"https://{uri.Host}:7103{uri.PathAndQuery}";
        }
    }

    protected override void OnInitialized()
    {
        Layout?.SetHeader("Calls & Meetings", "Direct calls · meeting rooms · history");
        CallSvc.StateChanged += OnStateChanged;
        CallSvc.CallEnded += OnCallEnded;
        // ipop-32d: ProfileDrawer's Call button deep-links /calls?callee=…; the drawer is
        // rendered on pages other than this one, but a same-page re-navigation would not
        // remount us, so parse per URL change too. PRESELECT only — never auto-ring.
        Nav.LocationChanged += OnLocationChanged;
        // "Join" opens 10 minutes before the start: re-evaluate the window while the page is open.
        clock = new System.Threading.Timer(_ => InvokeAsync(() => { clockNow = DateTime.UtcNow; StateHasChanged(); }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
        meetingSub = Auth.On<Guid>(IPop.Application.Realtime.RealtimeEvents.MeetingChanged, OnMeetingChanged);
    }

    // ── Live refresh (meetingChanged) ──
    // A meeting I organise/attend was created, edited, cancelled or answered. Reload the
    // scheduled list quietly (debounced; bursts collapse) and re-read the open detail when it
    // is one of the changed meetings.
    private IDisposable? meetingSub;
    private CancellationTokenSource? meetingLiveCts;
    private readonly HashSet<Guid> changedMeetings = [];

    private void OnMeetingChanged(Guid meetingId)
    {
        _ = InvokeAsync(() =>
        {
            changedMeetings.Add(meetingId);
            meetingLiveCts?.Cancel(); meetingLiveCts?.Dispose();
            var t = new CancellationTokenSource(); meetingLiveCts = t;
            _ = InvokeAsync(async () =>
            {
                try { await Task.Delay(400, t.Token); } catch (OperationCanceledException) { return; }
                await LiveRefreshMeetingsAsync();
            });
        });
    }

    private async Task LiveRefreshMeetingsAsync()
    {
        var changed = changedMeetings.ToHashSet();
        changedMeetings.Clear();
        try
        {
            await LoadMeetings();
            // LoadMeetings keeps the detail in sync for meetings still upcoming; one that left the
            // list (cancelled/ended) or changed is re-read so the detail shows its new state.
            if (detailMeeting is { } open && changed.Contains(open.Id))
            {
                var fresh = meetings.FirstOrDefault(m => m.Id == open.Id)
                    ?? await Auth.GetAsync<MeetingInfo>($"/api/meetings/{open.Id}");
                if (detailMeeting?.Id == open.Id && fresh is not null) detailMeeting = fresh;
            }
            Layout?.SetSubtitle($"{history.Total} calls · {meetings.Count} upcoming meetings");
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        }
        catch { /* background refresh — the next event or navigation will catch up */ }
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        await LoadMeetings();
        await LoadFavorites();
        await HandleDeeplinkAsync();
    }

    private string? _lastHandledQuery;

    /// Same-page navigation (a notification's /calls?tab=rooms&join=... while already on /calls) does not
    /// re-render by itself: re-render once the link has set the tab and the room deep-link values.
    /// Leaving /calls (e.g. "More options…" to /calendar?new=1…) is not a Calls deep link: its query must not be acted on.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!IsCallsPath(e.Location)) return;
        _ = InvokeAsync(async () =>
        {
            await HandleDeeplinkAsync();
            StateHasChanged();
        });
    }

    private bool IsCallsPath(string location)
    {
        var path = Nav.ToAbsoluteUri(location).AbsolutePath.TrimEnd('/');
        return path.Equals("/calls", StringComparison.OrdinalIgnoreCase);
    }

    private async Task HandleDeeplinkAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (query["tab"] is "recents" or "scheduled" or "rooms") tab = query["tab"]!;
        if (tab == "rooms")
        {
            // Rooms deep links: ?join={key} joins once; ?recording={id} scrolls to it and opens the player.
            roomJoinKey = string.IsNullOrWhiteSpace(query["join"]) ? null : query["join"];
            roomRecordingId = Guid.TryParse(query["recording"], out var rec) ? rec : null;
        }
        if (Guid.TryParse(query["meeting"], out var id))
        {
            tab = "scheduled";
            await OpenMeeting(id);
        }
        if (query["new"] == "1") { OpenSchedule(); return; }
        await HandleCalleeDeeplinkAsync();
    }

    /// ipop-32d: /calls?callee={Nik} preselects the peer with the Call button armed.
    /// Deliberately NOT auto-ring: a mis-click must not interrupt someone who never
    /// clicked anything (reversibility test — every other deeplink costs the clicker only).
    private async Task HandleCalleeDeeplinkAsync()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query.TrimStart('?');
        if (string.IsNullOrEmpty(query) || _lastHandledQuery == query) return;
        string? callee = null;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = part.IndexOf('=');
            if (eq < 0) continue;
            if (!part[..eq].Equals("callee", StringComparison.OrdinalIgnoreCase)) continue;
            callee = Uri.UnescapeDataString(part[(eq + 1)..]);
            break;
        }
        callee = PLinks.Nik(callee);
        if (string.IsNullOrWhiteSpace(callee)) return;
        _lastHandledQuery = query;
        selectedPeer = new MemberSearchRow(callee, await ResolvePeerNameAsync(callee), null, null);
        notice = "";
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    /// Resolve a display name for a NIK arriving via ?callee= — cosmetic label only,
    /// send path resolves by NIK server-side; falls back to the raw NIK.
    private async Task<string> ResolvePeerNameAsync(string nik)
    {
        try
        {
            var hit = await Auth.GetAsync<DirectoryEmployeeDto>($"/api/chat/users/{Uri.EscapeDataString(nik)}");
            if (hit is not null) return hit.Name;
        }
        catch { /* bounded: fall through to a neutral label */ }
        return "Unknown person";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("ipop.icons");
        if (firstRender)
        {
            await CallSvc.ConnectAsync();
            await LoadHistory();
            // Opening /calls counts as seeing the missed calls: clear the sidebar badge now,
            // but keep this visit's "new" dots until the user dismisses them.
            if (historyRows.Any(h => !h.Seen)) await PostSeenAsync(null);
        }
    }

    // The ringing / in-call UI lives in GlobalCallOverlay; this page only reflects it.
    private void OnStateChanged() => _ = InvokeAsync(() =>
    {
        // "Calling…" only while our outgoing call rings; the overlay shows the rest.
        if (!CallSvc.IsOutgoingRing) notice = "";
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    });

    /// A call just closed: its history row exists now, so reload page 1 and show it.
    private void OnCallEnded() => _ = InvokeAsync(async () =>
    {
        detailCall = null;
        detailMeeting = null;
        if (mDetail) await MobileBack();
        await LoadHistory();
        await JS.InvokeVoidAsync("ipop.icons");
    });

    private void OnPickPeer(MemberSearchRow? r)
    {
        selectedPeer = r;
        notice = "";
        StateHasChanged();
    }

    private async Task CallPeer()
    {
        if (selectedPeer is null) return;
        var room = await CallSvc.CreateAsync(selectedPeer.Nik);
        if (room is null) { Toasts.Show(CallSvc.LastError ?? "Couldn't start the call. Try again.", ToastKind.Error); return; }
        notice = $"Calling {selectedPeer.Name}…";
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task LoadHistory()
    {
        var page = await Auth.GetAsync<CallHistoryPage>("/api/calls/history?page=1&pageSize=50");
        history = page ?? new([], 0, 1, 50);
        // ipop-49: every caller of LoadHistory is a post-call refresh, which legitimately resets
        // to page 1 — a just-ended call belongs at the top. Reset the paging cursor with it.
        historyRows = history.Items.ToList();
        Layout?.SetSubtitle($"{history.Total} calls · {meetings.Count} upcoming meetings");
        if (detailCall is null && detailMeeting is null && historyRows.Count > 0) detailCall = historyRows[0];
        historyPage = 1;
        StateHasChanged();
    }

    /// "Mark all as read": server-side it is usually done already (page open), this clears the dots.
    private async Task MarkAllSeen()
    {
        historyRows = historyRows.Select(h => h.Seen ? h : h with { Seen = true }).ToList();
        if (detailCall is { Seen: false } d) detailCall = d with { Seen = true };
        await PostSeenAsync(null);
    }

    private void ReplaceRow(Guid callId, Func<CallHistoryDto, CallHistoryDto> change)
    {
        var i = historyRows.FindIndex(r => r.CallId == callId);
        if (i >= 0) historyRows[i] = change(historyRows[i]);
    }

    private async Task PostSeenAsync(Guid? callId)
    {
        try
        {
            var url = callId is { } id ? $"/api/calls/history/{id}/seen" : "/api/calls/history/seen";
            using var res = await Auth.SendAsync(HttpMethod.Post, url);
            // The hub pushes badgeChanged too; re-reading covers a disconnected hub.
            if (res.IsSuccessStatusCode) await Badges.RefreshAsync();
        }
        catch { /* the badge re-seeds on the next navigation */ }
    }

    /// ipop-49: append the next page of call history.
    private async Task LoadMoreHistory()
    {
        if (historyLoadingMore) return;
        historyLoadingMore = true;
        try
        {
            var next = historyPage + 1;
            var page = await Auth.GetAsync<CallHistoryPage>($"/api/calls/history?page={next}&pageSize=50");
            if (page is null) return;
            historyPage = next;
            // The server's figure is authoritative for what remains.
            history = history with { Total = page.Total };
            // A call completing between page 1 and page 2 shifts every row down one, so the last
            // row of page 1 comes back as the first of page 2. CallId is unique within ONE user's
            // history (CallService.cs:198 excludes the creator from the incoming rows, so a user
            // gets exactly one row per call they were in), which makes it a safe dedup key here.
            var seen = historyRows.Select(h => h.CallId).ToHashSet();
            foreach (var row in page.Items)
                if (seen.Add(row.CallId))
                    historyRows.Add(row);
        }
        finally
        {
            historyLoadingMore = false;
            StateHasChanged();
        }
    }

