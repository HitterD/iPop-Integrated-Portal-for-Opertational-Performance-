    private async Task OpenInCalendarAsync(Guid meetingId)
    {
        var r = await Auth.GetAsync<CalEventRef>($"/api/calendar/meetings/{meetingId}/event");
        Nav.NavigateTo(r is null ? "/calendar" : CalendarLinks.Event(r.EventId, r.StartAt));
    }

    private sealed record CalEventRef(Guid EventId, DateTime StartAt);

    private async Task JoinMeeting(MeetingInfo m)
    {
        var kind = CallsSchedule.KindOf(m.Kind, m.Location, m.Attendees.Count > 0);
        if (kind == MeetingKinds.Room && (m.RoomKey ?? IPop.Application.Hall.HallBooking.RoomKey(m.Location)) is { } key)
        {
            // Room meetings are joined in the Meeting Rooms tab (same as CalendarRoomJoin).
            SetTab("rooms");
            roomJoinKey = key;
            return;
        }
        if (m.RoomName is null) return;
        if (!await CallSvc.JoinMeetingAsync(m.RoomName))
            Toasts.Show(CallSvc.LastError ?? "Couldn't join the meeting.", ToastKind.Error);
    }

    private async Task CancelMeeting(MeetingInfo m)
    {
        if (!await Confirm.AskAsync("Cancel meeting?", $"\"{m.Title}\" will be cancelled and all attendees notified.", "Cancel meeting", true)) return;
        var res = await Auth.SendAsync(HttpMethod.Post, $"/api/meetings/{m.Id}/cancel", new { });
        if (res.IsSuccessStatusCode)
        {
            Toasts.Show("Meeting cancelled.", ToastKind.Success);
            await LoadMeetings();
            // The cancelled meeting leaves /upcoming; re-read it so the detail shows its new state.
            detailCall = null;
            detailMeeting = await Auth.GetAsync<MeetingInfo>($"/api/meetings/{m.Id}");
        }
        else
        {
            Toasts.Show("Couldn't cancel the meeting.", ToastKind.Error);
        }
    }

    private async Task Respond(Guid id, string response)
    {
        if (rsvpBusy) return;
        rsvpBusy = true;
        try
        {
            var result = await Auth.SendAsync(HttpMethod.Post, $"/api/meetings/{id}/rsvp", new { response });
            if (!result.IsSuccessStatusCode) Toasts.Show("Couldn't save your response.", ToastKind.Error);
            else
            {
                await LoadMeetings();
                if (detailMeeting?.Id == id && meetings.All(x => x.Id != id))
                    detailMeeting = await Auth.GetAsync<MeetingInfo>($"/api/meetings/{id}") ?? detailMeeting;
            }
        }
        finally { rsvpBusy = false; }
    }

    private static string DurationLabel(CallHistoryDto h) =>
        h.DurationSeconds < 60 ? $"{h.DurationSeconds}s"
        : h.DurationSeconds < 3600 ? $"{h.DurationSeconds / 60}m {h.DurationSeconds % 60}s"
        : $"{h.DurationSeconds / 3600}h {(h.DurationSeconds % 3600) / 60}m";

    private string ChatHref(string nik) => PLinks.Chat(nik);

    private async Task CallAgain(string peerNik)
    {
        var room = await CallSvc.CreateAsync(peerNik);
        if (room is null)
        {
            var msg = !string.IsNullOrWhiteSpace(CallSvc.LastError) ? CallSvc.LastError : "Couldn't start the call.";
            Toasts.Show(msg, ToastKind.Error);
            return;
        }
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        clock?.Dispose();
        CallSvc.StateChanged -= OnStateChanged;
        CallSvc.CallEnded -= OnCallEnded;
        meetingSub?.Dispose();
        meetingLiveCts?.Cancel();
        meetingLiveCts?.Dispose();
        if (mRef is not null)
        {
            _ = JS.InvokeVoidAsync("ipop.mobile.clearDetail").AsTask().ContinueWith(_ => { });
            mRef.Dispose();
        }
    }
