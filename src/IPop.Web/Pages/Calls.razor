@page "/calls"
@implements IDisposable
@using IPop.Application.Calls
@using IPop.Web.Components.Calls
@inject IJSRuntime JS
@inject AuthState Auth
@inject CallState CallSvc
@inject NavigationManager Nav
@inject ToastService Toasts
@inject ConfirmService Confirm
@inject BadgeState Badges
@inject IPop.Web.Services.PeopleLinks PLinks

<PageTitle>Calls — IPop</PageTitle>

<div class="calls-v6 @(mDetail ? "m-detail" : "")">
    <div class="toolbar calls-toolbar">
        <div class="calls-tabs">
            <button class="@(tab == "recents" ? "active" : "")" @onclick='() => SetTab("recents")'><i data-lucide="history"></i> Recents <span>@history.Total</span></button>
            <button class="@(tab == "scheduled" ? "active" : "")" @onclick='() => SetTab("scheduled")'><i data-lucide="calendar-clock"></i> Scheduled <span>@meetings.Count</span></button>
        </div>
        <div class="v6-search calls-search"><i data-lucide="search"></i><input type="search" aria-label="Search calls or meetings" placeholder="Search calls" @bind="search" @bind:event="oninput" /></div>
        <button type="button" class="ghost-btn" @onclick="() => showDeviceTest = true"><i data-lucide="headphones"></i>Test devices</button>
        <button type="button" class="ghost-btn" @onclick="OpenSchedule"><i data-lucide="calendar-plus"></i>Schedule</button>
        <button type="button" class="btn-primary" @onclick="FocusCallPicker"><i data-lucide="phone"></i>New call</button>
    </div>

    <Modal IsOpen="showSchedule" IsOpenChanged="v => showSchedule = v" Wide="true" CloseOnBackdrop="false"
           Title="@(editingMeetingId is null ? "Schedule a meeting" : "Edit meeting")"
           Subtitle="@(editingMeetingId is null ? "Invite people or a group — attendees are notified right away." : "Newly added attendees will be notified.")">
        <ChildContent>
            <div class="mtg-form">
                <label class="mtg-field"><span class="mtg-label">Title</span>
                    <input class="mtg-input" @bind="formTitle" @bind:event="oninput" maxlength="300" placeholder="e.g. Sprint review" aria-label="Meeting title" /></label>
                <div class="mtg-grid">
                    <div class="mtg-field"><span class="mtg-label">Start</span>
                        <AppDateTimePicker TValue="DateTime" Value="formStart" ValueChanged="OnStartChanged" Min="@(editingMeetingId is null ? DateTime.Now : null)" Class="dp-block" AriaLabel="Start time" /></div>
                    <div class="mtg-field"><span class="mtg-label">Reminder</span>
                        <AppSelect Value="@formReminder" ValueChanged="OnReminderChanged" Options="ReminderOptions" Label="Reminder" CssClass="mtg-select" /></div>
                </div>
                <div class="mtg-field"><span class="mtg-label">Duration</span>
                    <div class="mtg-chips" role="group" aria-label="Duration">
                        @foreach (var minutes in CallsSchedule.DurationChoices)
                        {
                            var d = minutes;
                            <button type="button" class="mtg-chip @(durationChip == d ? "on" : "")" aria-pressed="@(durationChip == d ? "true" : "false")" @onclick="() => PickDuration(d)">@CallsSchedule.DurationLabel(TimeSpan.FromMinutes(d))</button>
                        }
                        <button type="button" class="mtg-chip @(durationChip is null ? "on" : "")" aria-pressed="@(durationChip is null ? "true" : "false")" @onclick="PickCustomDuration">Custom</button>
                    </div>
                    @if (durationChip is null)
                    {
                        <div class="mtg-end"><span class="mtg-label">End</span>
                            <AppDateTimePicker TValue="DateTime" Value="formEnd" ValueChanged="OnEndChanged" Min="formStart" Class="dp-block" AriaLabel="End time" /></div>
                    }
                    else
                    {
                        <small class="mtg-hint">Ends at @formEnd.ToString("HH:mm")</small>
                    }
                </div>
                <div class="mtg-field"><span class="mtg-label">Location</span>
                    <div class="mtg-loc">
                        <input class="mtg-input" @bind="formLocation" @bind:event="oninput" disabled="@formOnline" placeholder="@(formOnline ? CallsSchedule.OnlineLocation : "Meeting room, building…")" aria-label="Location" />
                        <button type="button" class="mtg-toggle @(formOnline ? "on" : "")" role="switch" aria-checked="@(formOnline ? "true" : "false")" @onclick="() => formOnline = !formOnline">
                            <span class="mtg-switch"></span><i data-lucide="video"></i>Online · iPop Meeting
                        </button>
                    </div>
                </div>
                <label class="mtg-field"><span class="mtg-label">Agenda</span>
                    <textarea class="mtg-input" rows="3" @bind="formAgenda" maxlength="4000" placeholder="Points to discuss" aria-label="Agenda"></textarea></label>
                <div class="mtg-field"><span class="mtg-label">Attendees <em>@formInvitees.Count</em></span>
                    <div class="mtg-invite-tabs" role="tablist">
                        <button type="button" role="tab" class="@(inviteMode == "people" ? "on" : "")" aria-selected="@(inviteMode == "people" ? "true" : "false")" @onclick='() => inviteMode = "people"'><i data-lucide="user-plus"></i>People</button>
                        <button type="button" role="tab" class="@(inviteMode == "group" ? "on" : "")" aria-selected="@(inviteMode == "group" ? "true" : "false")" @onclick="OpenGroupInvite"><i data-lucide="users"></i>Invite group</button>
                    </div>
                    @if (inviteMode == "people")
                    {
                        <PeoplePicker Placeholder="Search name…" ValueChanged="AddInvitee" />
                    }
                    else
                    {
                        <div class="mtg-groups" role="listbox" aria-label="My groups">
                            @if (groupsLoading) { <div class="mtg-groups-empty">Loading groups…</div> }
                            else if (myGroups.Count == 0) { <div class="mtg-groups-empty">You're not in any groups yet.</div> }
                            @foreach (var grp in myGroups)
                            {
                                var g = grp;
                                <button type="button" role="option" class="mtg-group @(formRoomId == g.Id ? "on" : "")" aria-selected="@(formRoomId == g.Id ? "true" : "false")" disabled="@(expandingGroup is not null)" @onclick="() => InviteGroup(g)">
                                    <span class="mtg-av" style="background:@(g.AvatarColor ?? AvatarPalette.For(g.Name ?? ""))">@AvatarPhotos.Initials(g.Name)</span>
                                    <span class="mtg-group-name">@g.Name</span>
                                    @if (expandingGroup == g.Id) { <i data-lucide="loader-2" class="spin"></i> }
                                    else if (formRoomId == g.Id) { <i data-lucide="check"></i> }
                                </button>
                            }
                        </div>
                    }
                    @if (formRoomName is not null)
                    {
                        <div class="mtg-linked"><i data-lucide="users"></i>Linked to group <strong>@formRoomName</strong>
                            <button type="button" title="Unlink group" aria-label="Unlink group" @onclick="() => { formRoomId = null; formRoomName = null; }"><i data-lucide="x"></i></button></div>
                    }
                    @if (formInvitees.Count > 0)
                    {
                        <div class="mtg-invitees">
                            @foreach (var person in formInvitees)
                            {
                                var who = person;
                                <span class="mtg-invitee"><PersonAvatar Nik="@who.Nik" Name="@who.Name" Size="20" Class="mtg-av sm" Decorative="true" />@who.Name
                                    <button type="button" title="Remove @who.Name" aria-label="Remove @who.Name" @onclick="() => formInvitees.Remove(who)"><i data-lucide="x"></i></button></span>
                            }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(formError)) { <p class="mtg-error" role="alert"><i data-lucide="alert-circle"></i>@formError</p> }
            </div>
        </ChildContent>
        <Footer>
            <button type="button" class="btn-sm surface" @onclick="() => showSchedule = false">Cancel</button>
            <button type="button" class="btn-primary" disabled="@savingMeeting" @onclick="SaveMeeting">@(savingMeeting ? "Saving…" : editingMeetingId is null ? "Schedule" : "Save changes")</button>
        </Footer>
    </Modal>

    @if (CallSvc.NeedsHttps)
    {
        <div class="calls-https-banner" role="note">
            <i data-lucide="shield-alert"></i>
            <span><strong>Calls need HTTPS.</strong> On this http address the browser blocks the microphone, so the other person won't hear you.</span>
            <a href="@SecureUrl">Open secure version</a>
        </div>
    }
    <CallDeviceTest Open="showDeviceTest" OpenChanged="v => showDeviceTest = v" />

    <div class="calls-split"><div class="calls-list">
    <div class="calls-favorites">
        <div class="calls-favorites-head"><strong>FAVORITES</strong><a href="/directory">Manage</a></div>
        @if (favorites.Count == 0) { <span>Star people in Directory to add them here.</span> }
        @foreach (var person in favorites)
        {
            <button title="Call @person.Name" @onclick="() => CallAgain(person.Nik)"><PersonAvatar Nik="@person.Nik" Name="@person.Name" Size="44" Class="calls-fav-avatar" Decorative="true" />@person.Name</button>
        }
    </div>


    @if (tab == "recents")
    {
        <div class="calls-history-filters" role="group" aria-label="Filter call history">
            @foreach (var option in new[] { "All", "Missed", "Incoming", "Outgoing" })
            {
                var filter = option.ToLowerInvariant();
                <button type="button" class="@(historyFilter == filter ? "active" : "")" @onclick="() => historyFilter = filter">@option<span>· @(filter == "all" ? history.Total : historyRows.Count(h => HistoryMatches(h, filter)))</span></button>
            }
            @if (historyRows.Any(h => !h.Seen))
            {
                <button type="button" class="calls-mark-seen" @onclick="MarkAllSeen"><i data-lucide="check-check"></i>Mark all as read</button>
            }
        </div>
    }
    @* ---- Header / peer picker ---- *@
    <div class="tray rise rise-1" id="calls-picker" hidden="@(!showPicker && selectedPeer is null)">
        <div class="core" style="padding:0;overflow:hidden">
            <div class="panel-head" style="flex-wrap:wrap;gap:10px">
                <i data-lucide="phone"></i> <span>Calls</span>
                <span class="meta conn"><i data-lucide="wifi" style="width:12px;height:12px"></i> @(CallSvc.IsConnected ? "Live" : "Connecting…")</span>
            </div>
            <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;flex-wrap:wrap">
                <div style="flex:1 1 260px;min-width:220px">
                    <div style="font-size:12px;font-weight:600;color:var(--ink-2);margin-bottom:6px">Start a call with…</div>
                    <AppMemberPicker Placeholder="Type a name…" Value="@selectedPeer" ValueChanged="OnPickPeer" />
                </div>
                <button class="btn" style="width:auto;margin:0;padding:10px 18px;align-self:end" disabled="@(selectedPeer is null)" @onclick="CallPeer">
                    <i data-lucide="phone-outgoing" style="width:14px;height:14px"></i> Call
                </button>
            </div>
            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="note" style="margin:0 14px 14px;border-radius:10px"><i data-lucide="info"></i><span>@notice</span></div>
            }
        </div>
    </div>

    @if (tab == "scheduled")
    {
        var nowUtc = DateTime.UtcNow;
        var visibleMeetings = meetings.Where(m => string.IsNullOrWhiteSpace(search) || m.Title.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
        <section class="calls-meetings mtg-list">
            @foreach (var day in visibleMeetings.GroupBy(m => m.StartAt.ToLocalTime().Date).OrderBy(g => g.Key))
            {
                <div class="calls-date">@CallsSchedule.DayLabel(day.Key, DateTime.Today)</div>
                @foreach (var meeting in day)
                {
                    var mt = meeting;
                    var mine = mt.OrganizerNik == Auth.Me?.Nik;
                    var canJoin = CallsSchedule.CanJoin(mt.StartAt, mt.EndAt, nowUtc);
                    var others = mt.Attendees.Where(a => a.Nik != Auth.Me?.Nik).ToList();
                    <div class="mtg-row @(detailMeeting?.Id == mt.Id ? "selected" : "") @(canJoin ? "live" : "")" role="button" tabindex="0" @onclick="() => OpenMeeting(mt.Id)" @onkeydown="e => SelectMeetingOnKey(e, mt.Id)">
                        <div class="mtg-time"><strong>@mt.StartAt.ToLocalTime().ToString("HH:mm")</strong><small>@CallsSchedule.DurationLabel(mt.EndAt - mt.StartAt)</small></div>
                        <div class="mtg-main">
                            <strong class="mtg-title">@mt.Title</strong>
                            <div class="mtg-meta">
                                @if (CallsSchedule.IsOnline(mt.Location)) { <span class="mtg-badge online"><i data-lucide="video"></i>Online</span> }
                                else { <span class="mtg-place"><i data-lucide="map-pin"></i>@mt.Location</span> }
                                <span class="mtg-stack" title="@string.Join(", ", mt.Attendees.Select(a => a.Name))">
                                    @foreach (var a in mt.Attendees.Take(4)) { <PersonAvatar Nik="@a.Nik" Name="@a.Name" Size="22" Class="mtg-av xs" Decorative="true" /> }
                                    @if (mt.Attendees.Count > 4) { <span class="mtg-av xs more">+@(mt.Attendees.Count - 4)</span> }
                                </span>
                                @if (!mine) { <span class="mtg-host">by @mt.OrganizerName</span> }
                            </div>
                        </div>
                        <div class="mtg-side" @onclick:stopPropagation="true">
                            @if (mine)
                            {
                                <span class="mtg-rsvp host">Organizer</span>
                                <span class="mtg-icon-btns">
                                    <button type="button" class="mtg-icon" title="Edit" aria-label="Edit @mt.Title" @onclick="() => EditMeeting(mt)"><i data-lucide="pencil"></i></button>
                                    <button type="button" class="mtg-icon danger" title="Cancel" aria-label="Cancel @mt.Title" @onclick="() => CancelMeeting(mt)"><i data-lucide="calendar-x"></i></button>
                                </span>
                            }
                            else
                            {
                                <span class="mtg-rsvp rsvp-@mt.MyResponse">@CallsSchedule.RsvpLabel(mt.MyResponse)</span>
                                <span class="mtg-rsvp-btns" role="group" aria-label="Respond to invitation">
                                    @foreach (var r in RsvpChoices)
                                    {
                                        var choice = r;
                                        <button type="button" class="@(mt.MyResponse == choice.Value ? "on " + choice.Value : "")" aria-pressed="@(mt.MyResponse == choice.Value ? "true" : "false")" disabled="@rsvpBusy" title="@choice.Label" @onclick="() => Respond(mt.Id, choice.Value)">@choice.Label</button>
                                    }
                                </span>
                            }
                            <span class="mtg-join-wrap" title="@(canJoin ? "Join the meeting" : CallsSchedule.JoinTooltip)">
                                <button type="button" class="mtg-join" disabled="@(!canJoin || mt.RoomName is null)" @onclick="() => JoinMeeting(mt)"><i data-lucide="video"></i>Join</button>
                            </span>
                        </div>
                    </div>
                }
            }
            @if (visibleMeetings.Count == 0)
            {
                <div class="calls-empty mtg-empty"><i data-lucide="calendar-clock"></i><p>@(meetings.Count == 0 ? "No scheduled meetings yet." : "No matching meetings.")</p>
                    <button type="button" class="btn-sm accent" @onclick="OpenSchedule"><i data-lucide="calendar-plus"></i>Schedule a meeting</button></div>
            }
        </section>
    }
    @* ---- Call history (grouped by date) ---- *@
    @if (tab == "recents")
    {
    <div class="calls-history">
            @if (historyRows.Count == 0)
            {
                <div class="tree-empty" style="padding:20px"><i data-lucide="phone-missed" style="width:18px;height:18px;margin-bottom:6px"></i>
                    <div>No calls yet — start your first call with a teammate.</div>
                </div>
            }
            else
            {
                <div class="calls-history-scroll">
                    @foreach (var g in historyRows.Where(h => HistoryMatches(h, historyFilter) && (string.IsNullOrWhiteSpace(search) || h.PeerName.Contains(search, StringComparison.OrdinalIgnoreCase))).GroupBy(h => h.StartedAt.ToLocalTime().Date).OrderByDescending(g => g.Key))
                    {
                        <div class="calls-date">@DateGroupLabel(g.Key)</div>
                        @foreach (var h in g)
                        {
                            <div class="calls-history-row @(detailCall?.CallId == h.CallId ? "selected" : "") @(h.Seen ? "" : "unseen")" role="button" tabindex="0" @onclick="() => OpenCall(h)" @onkeydown="e => SelectCallOnKey(e, h)">
                                <PersonAvatar Nik="@h.PeerNik" Name="@h.PeerName" Size="40" Class="calls-history-av" Decorative="true" />
                                <span class="calls-history-info">
                                    <strong class="@(h.Result == "missed" ? "missed" : "")">@h.PeerName</strong>
                                    <small class="calls-result @ResultClass(h)"><i data-lucide="@CallIcon(h)"></i> @HistoryDirection(h) · @ResultLabel(h)</small>
                                </span>
                                @if (!h.Seen)
                                {
                                    <span class="calls-unseen-dot" title="New missed call" aria-label="Unread"></span>
                                }
                                <time>@h.StartedAt.ToLocalTime().ToString("HH:mm")</time>
                                <span class="calls-row-actions">
                                    <button type="button" title="Call @h.PeerName" aria-label="Call @h.PeerName" disabled="@(string.IsNullOrWhiteSpace(h.PeerNik))" @onclick="() => CallAgain(h.PeerNik!)" @onclick:stopPropagation="true"><i data-lucide="phone"></i></button>
                                    @if (!string.IsNullOrWhiteSpace(h.PeerNik))
                                    {
                                        <a href="@ChatHref(h.PeerNik)" title="Message @h.PeerName" aria-label="Message @h.PeerName" @onclick:stopPropagation="true"><i data-lucide="message-circle"></i></a>
                                    }
                                </span>
                            </div>
                        }
                    }
                    @if (HasMoreHistory)
                    {
                        @* ipop-49: sits OUTSIDE the GroupBy loop so an appended page keeps its own
                           date headings instead of splitting a day across two groups. *@
                        <div style="display:flex;justify-content:center;padding:6px 0 2px">
                            <button class="btn-sm surface" @onclick="LoadMoreHistory" disabled="@historyLoadingMore">
                                @(historyLoadingMore ? "Loading…" : $"Show {history.Total - historyRows.Count} more")
                            </button>
                        </div>
                    }
                </div>
            }
    </div>

    }
    </div>
    <aside class="calls-detail">
        <button type="button" class="m-back" aria-label="Back" @onclick="MobileBack"><i data-lucide="chevron-left"></i></button>
        @if (detailMeeting is { } m)
        {
            var cancelled = m.Status == MeetingCancelled;
            var detailCanJoin = !cancelled && CallsSchedule.CanJoin(m.StartAt, m.EndAt, DateTime.UtcNow);
            <div class="calls-detail-hero"><span class="tag @(cancelled ? "mtg-tag-cancelled" : "")">@(cancelled ? "Cancelled" : CallsSchedule.DayLabel(m.StartAt.ToLocalTime(), DateTime.Today))</span><h2>@m.Title</h2><p>@m.StartAt.ToLocalTime().ToString("dddd, MMM d, yyyy · HH:mm", System.Globalization.CultureInfo.InvariantCulture) – @m.EndAt.ToLocalTime().ToString("HH:mm")</p></div>
            <div class="calls-detail-actions">
                @if (m.EndAt > DateTime.UtcNow && !cancelled)
                {
                    <span class="mtg-join-wrap" title="@(detailCanJoin ? "Join the meeting" : CallsSchedule.JoinTooltip)">
                        <button type="button" class="mtg-join" disabled="@(!detailCanJoin || m.RoomName is null)" @onclick="() => JoinMeeting(m)"><i data-lucide="video"></i>Join</button>
                    </span>
                }
                <button type="button" class="btn-sm surface" @onclick="() => CopyMeetingLink(m)"><i data-lucide="link"></i> Copy link</button>
                <a class="btn-sm surface" href="@PLinks.Chat(m.OrganizerNik)"><i data-lucide="message-circle"></i> Message host</a>
                @if (m.OrganizerNik == Auth.Me?.Nik && !cancelled)
                {
                    <button class="btn-sm surface" @onclick="() => EditMeeting(m)"><i data-lucide="pencil"></i> Edit</button>
                    <button class="btn-sm surface" style="color:var(--danger)" @onclick="() => CancelMeeting(m)"><i data-lucide="calendar-x"></i> Cancel</button>
                }
            </div>
            @if (m.OrganizerNik != Auth.Me?.Nik && !cancelled)
            {
                <div class="calls-rsvp">Your response: <strong class="mtg-rsvp rsvp-@m.MyResponse">@CallsSchedule.RsvpLabel(m.MyResponse)</strong>
                    <span class="mtg-rsvp-btns" role="group" aria-label="Respond to invitation">
                        @foreach (var r in RsvpChoices)
                        {
                            var choice = r;
                            <button type="button" class="@(m.MyResponse == choice.Value ? "on " + choice.Value : "")" aria-pressed="@(m.MyResponse == choice.Value ? "true" : "false")" disabled="@rsvpBusy" @onclick="() => Respond(m.Id, choice.Value)">@choice.Label</button>
                        }
                    </span>
                </div>
            }
            <div class="calls-detail-block"><strong>MEETING DETAILS</strong><p>Organizer: @m.OrganizerName</p><p>Location: @(CallsSchedule.IsOnline(m.Location) ? CallsSchedule.OnlineLocation : m.Location)</p><p>Agenda: @(m.Agenda ?? "No agenda")</p><p>Reminder: @(m.ReminderMinutes is { } rm ? ReminderLabel(rm) : "No reminder")</p><p>Link: <a href="/meet/@m.RoomName">Open meeting</a></p></div>
            <div class="calls-detail-block"><strong>ATTENDEES · @m.Attendees.Count</strong>
                @foreach (var person in m.Attendees) { <p>@person.Name · @CallsSchedule.RsvpLabel(person.RsvpStatus)</p> }
            </div>
        }
        else if (detailCall is { } h)
        {
            <div class="calls-detail-hero">
                <PersonAvatar Nik="@h.PeerNik" Name="@h.PeerName" Size="84" Class="calls-detail-avatar" Viewable="true" />
                <h2>@h.PeerName</h2>
                <p><span class="calls-result-chip @ResultClass(h)"><i data-lucide="@CallIcon(h)"></i> @HistoryDirection(h) · @ResultLabel(h)</span></p>
                <p>@h.StartedAt.ToLocalTime().ToString("dddd, MMM d, yyyy · HH:mm", System.Globalization.CultureInfo.InvariantCulture)</p>
            </div>
            <div class="calls-detail-actions call-actions">
                <button type="button" disabled="@(string.IsNullOrWhiteSpace(h.PeerNik) || CallSvc.HasLiveCall)" @onclick="() => CallAgain(h.PeerNik!)"><i data-lucide="phone"></i>Call</button>
                @if (!string.IsNullOrWhiteSpace(h.PeerNik))
                {
                    <a href="@ChatHref(h.PeerNik)"><i data-lucide="message-circle"></i>Chat</a>
                    <a href="@PLinks.Profile(h.PeerNik)"><i data-lucide="contact-round"></i>Profile</a>
                }
            </div>
            var withPeer = historyRows.Where(x => !string.IsNullOrWhiteSpace(h.PeerNik) && x.PeerNik == h.PeerNik).ToList();
            var talked = withPeer.Where(x => x.Result == "completed").Sum(x => x.DurationSeconds);
            <div class="calls-detail-stats">
                <div><strong>@withPeer.Count</strong><span>Calls</span></div>
                <div><strong>@withPeer.Count(x => x.Result == "completed")</strong><span>Connected</span></div>
                <div><strong>@withPeer.Count(x => x.Result == "missed")</strong><span>Missed</span></div>
                <div><strong>@FormatSeconds(talked)</strong><span>Talk time</span></div>
            </div>
            <div class="calls-detail-block calls-contact-history"><strong>CALL HISTORY</strong><span>@historyRows.Count(x => x.PeerNik == h.PeerNik && !string.IsNullOrWhiteSpace(h.PeerNik)) calls</span>
                @foreach (var entry in historyRows.Where(x => x.PeerNik == h.PeerNik && !string.IsNullOrWhiteSpace(h.PeerNik)).Take(5))
                {
                    <div class="calls-contact-row @ResultClass(entry)"><i data-lucide="@CallIcon(entry)"></i><span>@HistoryDirection(entry) · @ResultLabel(entry)<small>@entry.StartedAt.ToLocalTime().ToString("MMM d, HH:mm", System.Globalization.CultureInfo.InvariantCulture)</small></span><time>@(entry.Result == "completed" ? DurationLabel(entry) : "—")</time></div>
                }
            </div>
            <div class="calls-detail-block calls-note">
                <strong>NOTES</strong>
                <div class="calls-note-unavailable">Private notes are not saved yet.</div>
            </div>
        }
        else { <div class="calls-empty">Select a call or meeting to see its details.</div> }
    </aside></div>
</div>

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;
    private bool showDeviceTest;
    private CallHistoryPage history = new([], 0, 1, 50);
    // ipop-49: the loader fetched one page of 50 and dropped the rest, while the panel head at
    // :109 renders the server's true Total. CallHistories gets a row PER PARTICIPANT per call and
    // is never pruned, so any active user passes 50 and then sees e.g. "312 calls" above exactly
