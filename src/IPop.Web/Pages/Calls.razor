    /// "Invite group": expand the group to its members and link the meeting to it (RoomId).
    private async Task InviteGroup(IPop.Application.Chat.RoomListDto group)
    {
        expandingGroup = group.Id;
        try
        {
            var room = await Auth.GetAsync<IPop.Application.Chat.ChatRoomDto>($"/api/chat/rooms/{group.Id}");
            if (room is null) { Toasts.Show("Couldn't load the group members.", ToastKind.Error); return; }
            var added = 0;
            foreach (var member in room.Members)
            {
                if (member.Nik == Auth.Me?.Nik || formInvitees.Any(p => p.Nik == member.Nik)) continue;
                formInvitees.Add(new MemberSearchRow(member.Nik, member.Name, null, null));
                added++;
            }
            if (editingMeetingId is null) { formRoomId = group.Id; formRoomName = group.Name; }
            if (string.IsNullOrWhiteSpace(formTitle)) formTitle = $"{group.Name} meeting";
            Toasts.Show(added == 0 ? "All group members are already invited." : $"Added {added} {(added == 1 ? "member" : "members")} of {group.Name}.", ToastKind.Success);
        }
        catch { Toasts.Show("Couldn't load the group members.", ToastKind.Error); }
        finally { expandingGroup = null; }
    }

    private async Task SaveMeeting()
    {
        if (savingMeeting) return;
        var isNew = editingMeetingId is null;
        formError = CallsSchedule.Validate(formTitle, formStart, formEnd, DateTime.Now, isNew);
        if (formError is not null) return;
        savingMeeting = true;
        try
        {
            var body = new
            {
                title = formTitle.Trim(), startAt = formStart.ToUniversalTime(), endAt = formEnd.ToUniversalTime(),
                location = formOnline ? CallsSchedule.OnlineLocation : string.IsNullOrWhiteSpace(formLocation) ? null : formLocation.Trim(),
                agenda = formAgenda, attendeeNiks = formInvitees.Select(p => p.Nik).Distinct().ToArray(),
                reminderMinutes = CallsSchedule.ReminderPayload(formReminder, isNew),
                roomId = isNew ? formRoomId : null, link = (string?)null,
                timeZone = TimeZoneInfo.Local.Id,
            };
            var response = await Auth.SendAsync(isNew ? HttpMethod.Post : HttpMethod.Put,
                editingMeetingId is { } id ? $"/api/meetings/{id}" : "/api/meetings", body);
            if (!response.IsSuccessStatusCode)
            {
                formError = (int)response.StatusCode == 403
                    ? "You don't have permission to schedule this meeting."
                    : "Couldn't save the meeting. Check the form and try again.";
                return;
            }
            var saved = await response.Content.ReadFromJsonAsync<MeetingDto>();
            showSchedule = false;
            await LoadMeetings();
            if (saved is not null) await SelectMeeting(saved.Id);
            Toasts.Show(isNew ? (formInvitees.Count > 0 ? $"Meeting scheduled · {formInvitees.Count} {(formInvitees.Count == 1 ? "invitation" : "invitations")} sent." : "Meeting scheduled.") : "Meeting updated.", ToastKind.Success);
        }
        catch { formError = "Couldn't save the meeting. Try again."; }
        finally { savingMeeting = false; }
    }

