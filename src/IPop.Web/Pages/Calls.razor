    private static bool HistoryMatches(CallHistoryDto h, string filter) => filter switch
    {
        // Calls I did not pick up — the ones worth calling back.
        "missed" => h.Direction.Equals("incoming", StringComparison.OrdinalIgnoreCase)
                    && h.Result.Equals("missed", StringComparison.OrdinalIgnoreCase),
        "incoming" => h.Direction.Equals("incoming", StringComparison.OrdinalIgnoreCase),
        "outgoing" => h.Direction.Equals("outgoing", StringComparison.OrdinalIgnoreCase),
        _ => true,
    };

    private static string HistoryDirection(CallHistoryDto h) => h.Direction.Equals("outgoing", StringComparison.OrdinalIgnoreCase) ? "Outgoing" : "Incoming";
    private static string CallIcon(CallHistoryDto h) => h.Result switch
    {
        "missed" => "phone-missed",
        "declined" or "canceled" or "no-answer" => "phone-off",
        _ => h.Direction.Equals("outgoing", StringComparison.OrdinalIgnoreCase) ? "phone-outgoing" : "phone-incoming",
    };

    /// History result as the user reads it; the raw values come from CallService.RecordHistory.
    private static string ResultLabel(CallHistoryDto h) => h.Result switch
    {
        "completed" => DurationLabel(h),
        "missed" => "Missed",
        "declined" => "Declined",
        "canceled" => "Canceled",
        "no-answer" => "No answer",
        _ => h.Result,
    };

    private static string ResultClass(CallHistoryDto h) => h.Result switch
    {
        "completed" => "ok",
        "missed" => "bad",
        "declined" => "bad",
        _ => "muted",
    };

    private static string FormatSeconds(int s) =>
        s < 60 ? $"{s}s" : s < 3600 ? $"{s / 60}m {s % 60}s" : $"{s / 3600}h {(s % 3600) / 60}m";
    private static string DateGroupLabel(DateTime date) => date.Date == DateTime.Today ? "Today" : date.Date == DateTime.Today.AddDays(-1) ? "Yesterday" : date.ToString("dddd, MMM d", System.Globalization.CultureInfo.InvariantCulture);

    private void SelectCallOnKey(KeyboardEventArgs e, CallHistoryDto h)
    {
        if (e.Key is "Enter" or " ") _ = OpenCall(h);
    }

    private void SelectCall(CallHistoryDto h)
    {
        detailCall = h;
        detailMeeting = null;
    }

    private async Task SelectMeeting(Guid id)
    {
        detailCall = null;
        detailPast = null;
        detailMeeting = meetings.FirstOrDefault(m => m.Id == id)
            ?? await Auth.GetAsync<MeetingInfo>($"/api/meetings/{id}");
        _ = Notifs.MarkReadByTargetAsync("meeting", id);
    }

    // Phone layout: list and detail swap; the detail owns a history entry so phone Back closes it.
    private bool mDetail;
    private DotNetObjectReference<Calls>? mRef;

    private async Task OpenCall(CallHistoryDto h)
    {
        if (!h.Seen)
        {
            ReplaceRow(h.CallId, r => r with { Seen = true });
            h = h with { Seen = true };
            await PostSeenAsync(h.CallId);
        }
        SelectCall(h);
        await OpenMobileDetail();
    }

    /// A past meeting: its detail ends with Watch recording / attended from the past list.
    private async Task OpenPastAsync(PastMeetingInfo p)
    {
        detailCall = null;
        detailMeeting = p.Meeting;
        detailPast = p;
        await OpenMobileDetail();
    }

    private async Task OpenMeeting(Guid id)
    {
        await SelectMeeting(id);
        await OpenMobileDetail();
    }

    private async Task OpenMobileDetail()
    {
        mRef ??= DotNetObjectReference.Create(this);
        try { mDetail = await JS.InvokeAsync<bool>("ipop.mobile.pushDetail", mRef, nameof(CloseMobileDetail)); }
        catch (JSException) { mDetail = false; }
    }

    [JSInvokable]
    public void CloseMobileDetail()
    {
        mDetail = false;
        StateHasChanged();
    }

    private async Task MobileBack()
    {
        mDetail = false;
        try { await JS.InvokeVoidAsync("ipop.mobile.popDetail"); } catch (JSException) { }
    }

    private async Task LoadMeetings()
    {
        meetings = await Auth.GetAsync<List<MeetingInfo>>("/api/meetings/upcoming") ?? [];
        if (detailMeeting is not null)
            detailMeeting = meetings.FirstOrDefault(m => m.Id == detailMeeting.Id) ?? detailMeeting;
    }

    private async Task LoadFavorites()
    {
        var niks = await Auth.GetAsync<List<string>>("/api/directory/favorites") ?? [];
        var people = new List<DirectoryEmployeeDto>();
        foreach (var nik in niks.Take(4))
        {
            DirectoryEmployeeDto? person = null;
            try { person = await Auth.GetAsync<DirectoryEmployeeDto>($"/api/chat/users/{Uri.EscapeDataString(nik)}"); } catch { }
            if (person is not null) people.Add(person);
        }
        favorites = people;
    }

