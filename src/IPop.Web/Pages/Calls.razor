    /// Schedule → Meeting room: the booking sheet on the first room free in the next hour (switchable inside the sheet).
    private async Task ScheduleRoomAsync()
    {
        scheduleMenu = false;
        List<IPop.Application.MeetingRooms.RoomFreeDto>? free = null;
        try
        {
            var from = DateTime.UtcNow; var to = from.AddHours(1);
            free = await Auth.GetAsync<List<IPop.Application.MeetingRooms.RoomFreeDto>>(
                $"/api/meeting-rooms/free?from={Uri.EscapeDataString(from.ToString("o"))}&to={Uri.EscapeDataString(to.ToString("o"))}");
        }
        catch { /* the sheet shows the default room's day either way */ }
        bookingRoom = CallsSchedule.DefaultRoom(free);
    }

