@page "/mail/new-mail"
@using IPop.Web.Components.Mail
@using IPop.Web.Services
@inject NavigationManager Nav

@* New Mail demo page (Phase 2) — renders the mail composer with mock attachments
   for UI verification without backend. *@

<PageTitle>New Mail (Demo) — IPop</PageTitle>

<div class="mail-demo-page" style="padding:24px;display:flex;flex-direction:column;gap:16px;min-height:60vh">
    <div style="display:flex;align-items:center;gap:12px">
        <a href="/mail" class="btn-sm surface"><i data-lucide="arrow-left" style="width:12px;height:12px"></i> Back to Mail</a>
        <h2 style="margin:0;font-size:18px">Compose New Mail</h2>
        <span class="meta" style="font-size:12px;color:var(--ink-3)">composer demo with mock attachments</span>
    </div>

    <div class="tray" style="max-width:720px">
        <div class="core" style="padding:16px">
            <p style="font-size:13px;color:var(--ink-2);margin:0 0 12px">
                Click the button below to open the mail composer (docked at bottom, supports
                minimize/maximize) pre-filled with mock attachments — use this to test the
                interface without actually sending.
            </p>
            <button class="btn-sm accent" @onclick="OpenDemo">
                <i data-lucide="file-plus" style="width:13px;height:13px"></i> Open composer with mock attachments
            </button>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;max-width:720px">
        @foreach (var a in _demoAttachments)
        {
            <div class="proj-tpl-card" style="display:flex;gap:10px;align-items:center">
                <i data-lucide="paperclip" style="width:16px;height:16px;color:var(--ink-3)"></i>
                <div style="flex:1;min-width:0">
                    <div style="font-size:12.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@a.FileName</div>
                    <div style="font-size:11px;color:var(--ink-3)">@HumanSize(a.FileSize) · @a.MimeType</div>
                </div>
            </div>
        }
    </div>
</div>

<MailComposer @ref="_composer" IsOpen="@_open" IsOpenChanged="v => _open = v" />

@code {
    private MailComposer? _composer;
    private bool _open;

    // Mock attachments matching MailAttachment(Id, FileName, FileSize, MimeType, ThumbnailUrl).
    private static readonly MailAttachment[] _demoAttachments =
    [
        new(Guid.NewGuid(), "Meeting Minutes Q3.pdf", 248_320, "application/pdf", null),
        new(Guid.NewGuid(), "Project Site Photo.jpg", 1_862_400, "image/jpeg", null),
        new(Guid.NewGuid(), "Budget Summary 2026.xlsx", 96_800, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", null),
    ];

    private void OpenDemo()
    {
        _composer?.OpenNew(initialSubject: "Demo: mock attachments", initialBody: "Test email with mock attachments.");
        _open = true;
    }

    private static string HumanSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
