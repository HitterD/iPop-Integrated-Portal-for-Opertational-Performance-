@page "/chat"
@page "/chat/{RoomId:guid}"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject ChatState ChatSvc
@inject ChatAttachments Att
@inject NavigationManager Nav
@inject HttpClient Http
@inject IPop.Web.Services.DraftStore Drafts
@inject IPop.Web.Services.ToastService Toasts
@inject IPop.Web.Services.ConfirmService Confirm
@inject IPop.Web.Services.OverlayStack Overlays
@inject IPop.Web.Services.CallState CallStateSvc
@inject IPop.Web.Services.FavoriteContacts Favorites
@inject IPop.Web.Services.PhotoViewerState PhotoViewer
@using IPop.Application.Chat.Mentions
@using Microsoft.JSInterop
@using IPop.Application.Chat
@using IPop.Web.Components
@using IPop.Web.Components.Chat

<PageTitle>Messages — IPop</PageTitle>

<div class="chat-area @(mobileRoomsOpen ? "rooms-open" : "") @(ChatSvc.ActiveRoomId is not null && !newChatOpen ? "m-detail" : "") @(drawerOpen ? "with-drawer" : "") @(globalDrawerView is not null ? "with-global-drawer" : "")" @onclick="CloseCtx">
    @* ============ ROOM PANE ============ *@
    <div class="room-pane rise rise-1 @(newChatOpen ? "nc-open" : "")">
        @* New chat / New group: takes over this column (WhatsApp Web style); the list below
           is hidden by CSS while it is open so its scroll position and state survive. *@
        @if (newChatOpen)
        {
            <NewChatPanel @key="newChatKey" @ref="newChatPanel" GroupMode="newChatGroupMode" Preselected="newChatPreselected"
                          OnClose="CloseNewChat" OnStartDm="StartDmFromPanel" OnCreateGroup="CreateGroupFromPanel" />
        }
        @* Top bar: search field + compose button *@
        <div class="room-top-bar">
            <div class="room-search-box">
                <i data-lucide="search"></i>
                <input type="text" placeholder="Search conversations..." value="@roomSearchQuery" @oninput="OnRoomSearchChanged" />
                @if (!string.IsNullOrEmpty(roomSearchQuery))
                {
                    <button type="button" class="room-search-clear" @onclick='() => { roomSearchQuery = ""; _ = ChatSvc.SearchRoomsAsync(""); }' title="Clear search" aria-label="Clear search">
                        <i data-lucide="x"></i>
                    </button>
                }
            </div>
            @* Opens the New chat panel; "New group" is its first row. *@
            <button type="button" class="compose-btn" title="New message" aria-label="New message" @onclick="StartNewDm" @onclick:stopPropagation>
                <i data-lucide="square-pen"></i>
            </button>
        </div>

        @* Compact navigation rows *@
        <div class="room-nav-links">
            <button type="button" class="room-nav-btn @(globalDrawerView == GlobalDrawerView.Pinned ? "active" : "")" @onclick="() => ToggleGlobalDrawer(GlobalDrawerView.Pinned)">
                <div class="rnb-icon"><i data-lucide="pin"></i></div>
                <span class="rnb-label">Pinned messages</span>
                <i data-lucide="chevron-right" class="rnb-chev"></i>
            </button>
            <button type="button" class="room-nav-btn @(globalDrawerView == GlobalDrawerView.Saved ? "active" : "")" @onclick="() => ToggleGlobalDrawer(GlobalDrawerView.Saved)">
                <div class="rnb-icon"><i data-lucide="bookmark"></i></div>
                <span class="rnb-label">Saved messages</span>
                <i data-lucide="chevron-right" class="rnb-chev"></i>
            </button>
            <button type="button" class="room-nav-btn @(globalDrawerView == GlobalDrawerView.Search ? "active" : "")" @onclick="() => ToggleGlobalDrawer(GlobalDrawerView.Search)">
                <div class="rnb-icon"><i data-lucide="text-search"></i></div>
                <span class="rnb-label">Search all conversations</span>
                <i data-lucide="chevron-right" class="rnb-chev"></i>
            </button>
            <button type="button" class="room-nav-btn @(globalDrawerView == GlobalDrawerView.Mentions ? "active" : "")" @onclick="() => ToggleGlobalDrawer(GlobalDrawerView.Mentions)">
                <div class="rnb-icon"><i data-lucide="at-sign"></i></div>
                <span class="rnb-label">Unread mentions</span>
                @if (GlobalMentionCount > 0)
                {
                    <span class="rnb-badge">@GlobalMentionCount</span>
                }
                <i data-lucide="chevron-right" class="rnb-chev"></i>
            </button>
        </div>

        @* Segmented control: Direct / Groups *@
        <div class="room-segmented">
            <button type="button" class="seg-item @(activeTab == RoomTab.Direct ? "active" : "")" @onclick="() => SetTab(RoomTab.Direct)">
                <span>Direct</span>
                @if (DirectUnread > 0)
                {
                    <span class="seg-badge">@DirectUnread</span>
                }
            </button>
            <button type="button" class="seg-item @(activeTab == RoomTab.Groups ? "active" : "")" @onclick="() => SetTab(RoomTab.Groups)">
                <span>Groups</span>
                @if (GroupUnread > 0)
                {
                    <span class="seg-badge">@GroupUnread</span>
                }
            </button>
        </div>

        @if (ChatSvc.ArchivedRooms.Any() || ChatSvc.ArchivedCount > 0)
        {
            <button type="button" class="room-archived-toggle" @onclick="() => archivedOpen = !archivedOpen">
                <i data-lucide="archive"></i>
                <span>Archived (@ChatSvc.ArchivedCount)</span>
                <i data-lucide="@(archivedOpen ? "chevron-up" : "chevron-down")"></i>
            </button>
            @if (archivedOpen)
            {
                <div class="archived-list">
                    @foreach (var ar in ChatSvc.ArchivedRooms)
                    {
                        var room = ar;
                        <div class="room-item" @onclick="() => OpenArchivedRoom(room.Id)" title="Open conversation history">
                            <div class="room-av @(room.Type == "dm" ? "person-av" : "group-av")" style="background:@GetRoomColor(room)">@if (room.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(room.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> } else { @GetRoomInitials(room) }</div>
                            <div class="room-info">
                                <div class="room-row-top">
                                    <span class="room-name">@GetRoomName(room)</span>
                                </div>
                                <div class="room-row-sub">
                                    <span class="room-preview">@(room.LastMessage ?? "")</span>
                                    <button class="room-unarchive-btn" title="Unarchive" @onclick="() => UnarchiveRoom(room.Id)" @onclick:stopPropagation>Unarchive</button>
                                </div>
                            </div>
                        </div>
                    }
                    @if (ChatSvc.HasMoreArchived)
                    {
                        <button type="button" class="room-load-more" @onclick="LoadMoreArchived">
                            <i data-lucide="chevron-down"></i> Load more archived (@(ChatSvc.ArchivedTotal - ChatSvc.ArchivedRooms.Count) more)
                        </button>
                    }
                </div>
            }
        }

        <div class="room-list">
            @{ var rooms = FilteredRooms; }
            @{ var pinned = rooms.Where(r => r.IsPinned).ToList(); }
            @{ var recent = rooms.Where(r => !r.IsPinned).ToList(); }

            @* Groups tab: the count + "New group" header always leads the list, even when
               every group is pinned (it used to ride on the unpinned section's label). *@
            @if (activeTab == RoomTab.Groups)
            {
                <div class="room-section-label room-groups-head">
                    <span>Groups · @rooms.Count</span>
                    <button type="button" class="room-new-group" @onclick="StartNewGroup">+ New group</button>
                </div>
            }

            @if (pinned.Any())
            {
                <div class="room-section-label room-pinned-head"><i data-lucide="arrow-up-to-line"></i><span>Pinned chats</span></div>
                @foreach (var room in pinned)
                {
                    var isActiveP = room.Id == ChatSvc.ActiveRoomId;
                    <div class="room-item @(isActiveP ? "active" : "") @(isActiveP && ChatSvc.IsOpening ? "busy" : "")" @onclick="() => OpenRoom(room.Id)">
                        <div class="room-av-wrap">
                            <div class="room-av @(room.Type == "dm" ? "person-av" : "group-av")" style="background:@GetRoomColor(room)">
                                @if (room.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(room.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> }
                                else { @GetRoomInitials(room) }
                            </div>
                            @if (room.Type == "dm" && !string.IsNullOrWhiteSpace(room.PresenceStatus))
                            {
                                <span class="presence-dot @room.PresenceStatus"></span>
                            }
                        </div>
                        <div class="room-info">
                            <div class="room-row-top">
                                <span class="room-name">@GetRoomName(room)</span>
                                <span class="room-time">@FormatTime(room.LastMessageAt)</span>
                            </div>
                            <div class="room-row-sub">
                                <span class="room-preview @(room.HasUnreadMention ? "mention-hl" : "")">
                                    @(room.LastMessage ?? "")
                                </span>
                                <div class="room-badges" style="position:relative">
                                    <button type="button" class="icon-btn" style="border:none;background:transparent;padding:0;width:16px;height:16px;color:var(--accent);cursor:pointer" title="Unpin conversation" @onclick="() => TogglePin(room)" @onclick:stopPropagation="true">
                                        <i data-lucide="arrow-up-to-line" class="room-pin-ic"></i>
                                    </button>
                                    <button type="button" class="icon-btn room-more-btn" style="border:none;background:transparent;padding:0;width:22px;height:22px;color:var(--ink-4);cursor:pointer" title="More" @onclick="() => menuRoomId = (menuRoomId == room.Id ? null : room.Id)" @onclick:stopPropagation="true">
                                        <i data-lucide="more-horizontal" style="width:12px;height:12px"></i>
                                    </button>
                                    @if (room.IsMuted)
                                    {
                                        <i data-lucide="bell-off" class="room-muted-ic"></i>
                                    }
                                    @if (room.UnreadCount > 0)
                                    {
                                        <span class="room-unread-pill">@room.UnreadCount</span>
                                    }
                                    @if (menuRoomId == room.Id)
                                    {
                                        <div class="app-select-pop on" style="right:0;top:20px;z-index:100;min-width:130px" @onclick:stopPropagation="true">
                                            <button type="button" class="app-select-opt" @onclick="() => { menuRoomId = null; TogglePin(room); }">
                                                <i data-lucide="arrow-down-to-line" style="width:12px;height:12px"></i> Unpin chat
                                            </button>
                                            <button type="button" class="app-select-opt" @onclick="() => { menuRoomId = null; ToggleMuteRoom(room); }">
                                                <i data-lucide="bell-off" style="width:12px;height:12px"></i> @(room.IsMuted ? "Unmute" : "Mute")
                                            </button>
                                            <button type="button" class="app-select-opt" style="color:var(--danger)" @onclick="() => { menuRoomId = null; ArchiveRoomById(room.Id); }">
                                                <i data-lucide="archive" style="width:12px;height:12px"></i> Archive
                                            </button>
                                            <button type="button" class="app-select-opt" style="color:var(--danger)" @onclick="async () => { menuRoomId = null; await OpenDeleteRoom(room); }">
                                                <i data-lucide="trash-2" style="width:12px;height:12px"></i> Hapus chat
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (recent.Any())
            {
                @* Groups: the header above already names the list, so the unpinned block
                   only needs a plain label to split it from the pinned ones. *@
                @if (activeTab != RoomTab.Groups)
                {
                    <div class="room-section-label @(pinned.Any() ? "has-pinned-above" : "")"><span>Recent</span></div>
                }
                else if (pinned.Any())
                {
                    <div class="room-section-label has-pinned-above">Others</div>
                }
                @foreach (var room in recent)
                {
                    var isActiveR = room.Id == ChatSvc.ActiveRoomId;
                    <div class="room-item @(isActiveR ? "active" : "") @(isActiveR && ChatSvc.IsOpening ? "busy" : "")" @onclick="() => OpenRoom(room.Id)">
                        <div class="room-av-wrap">
                            <div class="room-av @(room.Type == "dm" ? "person-av" : "group-av")" style="background:@GetRoomColor(room)">
                                @if (room.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(room.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> }
                                else { @GetRoomInitials(room) }
                            </div>
                            @if (room.Type == "dm" && !string.IsNullOrWhiteSpace(room.PresenceStatus))
                            {
                                <span class="presence-dot @room.PresenceStatus"></span>
                            }
                        </div>
                        <div class="room-info">
                            <div class="room-row-top">
                                <span class="room-name">@GetRoomName(room)</span>
                                <span class="room-time">@FormatTime(room.LastMessageAt)</span>
                            </div>
                            <div class="room-row-sub">
                                <span class="room-preview @(room.HasUnreadMention ? "mention-hl" : "")">
                                    @(room.LastMessage ?? "")
                                </span>
                                <div class="room-badges" style="position:relative">
                                    <button type="button" class="icon-btn room-pin-hover" style="border:none;background:transparent;padding:0;width:16px;height:16px;color:var(--ink-4);cursor:pointer" title="Pin conversation" @onclick="() => TogglePin(room)" @onclick:stopPropagation="true">
                                        <i data-lucide="arrow-up-to-line" style="width:12px;height:12px"></i>
                                    </button>
                                    <button type="button" class="icon-btn room-more-btn" style="border:none;background:transparent;padding:0;width:22px;height:22px;color:var(--ink-4);cursor:pointer" title="More" @onclick="() => menuRoomId = (menuRoomId == room.Id ? null : room.Id)" @onclick:stopPropagation="true">
                                        <i data-lucide="more-horizontal" style="width:12px;height:12px"></i>
                                    </button>
                                    @if (room.IsMuted)
                                    {
                                        <i data-lucide="bell-off" class="room-muted-ic"></i>
                                    }
                                    @if (room.UnreadCount > 0)
                                    {
                                        <span class="room-unread-pill">@room.UnreadCount</span>
                                    }
                                    @if (menuRoomId == room.Id)
                                    {
                                        <div class="app-select-pop on" style="right:0;top:20px;z-index:100;min-width:130px" @onclick:stopPropagation="true">
                                            <button type="button" class="app-select-opt" @onclick="() => { menuRoomId = null; TogglePin(room); }">
                                                <i data-lucide="arrow-up-to-line" style="width:12px;height:12px"></i> Pin chat to top
                                            </button>
                                            <button type="button" class="app-select-opt" @onclick="() => { menuRoomId = null; ToggleMuteRoom(room); }">
                                                <i data-lucide="bell-off" style="width:12px;height:12px"></i> @(room.IsMuted ? "Unmute" : "Mute")
                                            </button>
                                            <button type="button" class="app-select-opt" style="color:var(--danger)" @onclick="() => { menuRoomId = null; ArchiveRoomById(room.Id); }">
                                                <i data-lucide="archive" style="width:12px;height:12px"></i> Archive
                                            </button>
                                            <button type="button" class="app-select-opt" style="color:var(--danger)" @onclick="async () => { menuRoomId = null; await OpenDeleteRoom(room); }">
                                                <i data-lucide="trash-2" style="width:12px;height:12px"></i> Hapus chat
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            @if (!rooms.Any())
            {
                <div class="empty-state">
                    <i data-lucide="message-circle"></i>
                    <div class="sub">@(searchActive ? "No conversations match your search." : "No conversations yet")</div>
                </div>
            }

            @if (!searchActive)
            {
                @if (activeTab == RoomTab.Direct && ChatSvc.HasMoreDirectRooms)
                {
                    <button type="button" class="room-load-more" @onclick="LoadMoreDirectRooms"><i data-lucide="chevron-down"></i> Load more conversations</button>
                }
                @if (activeTab == RoomTab.Groups && ChatSvc.HasMoreGroupRooms)
                {
                    <button type="button" class="room-load-more" @onclick="LoadMoreGroupRooms"><i data-lucide="chevron-down"></i> Load more groups</button>
                }
            }
        </div>
    </div>

    @* ============ CONVERSATION PANE ============ *@
    <div class="conv-pane rise rise-2">
        @if (ChatSvc.ActiveRoomId is not null && ChatSvc.ActiveRoom is not null)
        {
            @* ---- Conversation Header ---- *@
            <div class="conv-header">
                <button type="button" class="conv-back" title="Conversations" aria-label="Back to conversations" @onclick="() => mobileRoomsOpen = true">
                    <i data-lucide="arrow-left"></i>
                </button>
                <button type="button" class="m-back" aria-label="Back" @onclick="MobileBackToList" @onclick:stopPropagation>
                    <i data-lucide="chevron-left"></i>
                </button>
                @if (ChatSvc.ActiveRoom.Type == "dm")
                {
                    var dmMember = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                    var hasPhoto = IPop.Web.Models.AvatarPhotos.Url(dmMember?.Nik) is not null;
                    <button type="button" class="header-avatar-btn person-av @(hasPhoto ? "avatar-viewable" : "")" style="background:@GetActiveRoomColor()" title="@(hasPhoto ? "Lihat foto" : "View profile")" aria-label="@(hasPhoto ? "Lihat foto" : "View profile")" @onclick="() => OpenHeaderAvatar(dmMember?.Nik, dmMember?.Name)">
                        @GetActiveRoomInitials()
                    </button>
                }
                else
                {
                    <button type="button" class="header-avatar-btn" style="background:@GetActiveRoomColor()" title="Group info" aria-label="Group info" @onclick="ToggleDetailPanel">
                        @if (ChatSvc.ActiveRoom?.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(ChatSvc.ActiveRoom.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> } else { @GetActiveRoomInitials() }
                    </button>
                }
                <div class="header-info">
                    <div class="header-name-row">
                        <span class="header-name">@GetActiveRoomName()</span>
                        @if (IsActiveRoomMuted)
                        {
                            <span class="mute-chip" title="Notifications muted"><i data-lucide="bell-off"></i></span>
                        }
                    </div>
                    <div class="header-status-line">
                        @if (ChatSvc.ActiveRoom.Type == "dm")
                        {
                            var dmMember = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                            if (dmMember is not null)
                            {
                                <span class="status-dot @(dmMember.PresenceStatus ?? "off")"></span>
                                <span class="status-txt">@PresenceLabel(dmMember.PresenceStatus)@(dmPerson is not null && !string.IsNullOrWhiteSpace(dmPerson.Position) && dmPerson.Position != "—" ? $" · {dmPerson.Position}" : "")</span>
                            }
                        }
                        else
                        {
                            <span class="status-txt">@ChatSvc.ActiveRoom.MemberCount members · @ChatSvc.ActiveRoom.OnlineCount online · @string.Join(", ", ChatSvc.ActiveRoom.Members.Take(3).Select(m => m.Nik == GetCurrentUserNik() ? "You" : m.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? m.Name))</span>
                        }
                    </div>
                </div>
                <div class="header-actions">
                    <button type="button" class="header-icon-btn m-opt @(searchOpen ? "on" : "")" title="Search messages" aria-label="Search messages" @onclick="() => searchOpen = !searchOpen">
                        <i data-lucide="search"></i>
                    </button>
                    @if (ChatSvc.ActiveRoom.Type == "dm")
                    {
                        var dmMember = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                        if (dmMember is not null)
                        {
                            <button type="button" class="header-icon-btn" title="Call" aria-label="Start call" @onclick="() => StartCallWith(dmMember.Nik)">
                                <i data-lucide="phone"></i>
                            </button>
                        }
                    }
                    @{
                        var activeRoomList = ChatSvc.GroupRooms.Concat(ChatSvc.DirectRooms).FirstOrDefault(r => r.Id == ChatSvc.ActiveRoom.Id);
                        var isActPinned = activeRoomList?.IsPinned ?? false;
                    }
                    <button type="button" class="header-icon-btn m-opt @(isActPinned ? "on" : "")" title="@(isActPinned ? "Unpin conversation" : "Pin conversation")" aria-label="Pin conversation" @onclick="() => { if (activeRoomList != null) TogglePin(activeRoomList); }">
                        <i data-lucide="arrow-up-to-line"></i>
                    </button>
                    <button type="button" class="header-icon-btn m-opt @(drawerOpen && panelView == DetailPanelView.Pinned ? "on" : "")" title="Pinned messages" aria-label="Pinned messages" @onclick="OpenPinnedSection">
                        <i data-lucide="pin"></i>
                    </button>
                    <button type="button" class="header-icon-btn m-opt @(drawerOpen && panelView == DetailPanelView.Media ? "on" : "")" title="Shared files & media" aria-label="Shared files & media" @onclick="OpenMediaSection">
                        <i data-lucide="paperclip"></i>
                    </button>
                    @if (ChatSvc.ActiveRoom.Type == "group")
                    {
                        <button type="button" class="header-icon-btn" title="Panggilan grup" aria-label="Mulai panggilan grup" disabled="@(groupCallBusy || CallStateSvc.IsInGroupCall)" @onclick="StartGroupCall">
                            <i data-lucide="phone"></i>
                        </button>
                        <button type="button" class="header-icon-btn @(drawerOpen && panelView == DetailPanelView.Members ? "on" : "")" title="Members" aria-label="Members" @onclick="OpenMembersSection">
                            <i data-lucide="users"></i>
                        </button>
                        <button type="button" class="header-icon-btn m-opt @(drawerOpen && panelView == DetailPanelView.GroupSettings ? "on" : "")" title="Group settings" aria-label="Group settings" @onclick="OpenGroupSettings">
                            <i data-lucide="settings"></i>
                        </button>
                    }
                    <button type="button" class="header-icon-btn m-opt @(drawerOpen && panelView == DetailPanelView.Main ? "on" : "")" title="Conversation details" aria-label="Conversation details" @onclick="ToggleDetailPanel">
                        <i data-lucide="panel-right"></i>
                    </button>
                    @* Phone only (hidden on desktop by chat.css): the m-opt buttons above collapse into this menu. *@
                    <button type="button" class="header-icon-btn m-hdr-more @(mHeaderMenuOpen ? "on" : "")" title="More" aria-label="More conversation actions" aria-haspopup="menu" aria-expanded="@(mHeaderMenuOpen ? "true" : "false")"
                            @onclick="() => mHeaderMenuOpen = !mHeaderMenuOpen" @onclick:stopPropagation>
                        <i data-lucide="ellipsis"></i>
                    </button>
                </div>
                @if (mHeaderMenuOpen)
                {
                    <div class="m-hdr-backdrop" @onclick="() => mHeaderMenuOpen = false" @onclick:stopPropagation></div>
                    <div class="m-hdr-menu" role="menu" @onclick="() => mHeaderMenuOpen = false" @onclick:stopPropagation>
                        <button type="button" role="menuitem" @onclick="ToggleDetailPanel"><i data-lucide="info"></i> @(ChatSvc.ActiveRoom.Type == "dm" ? "Contact info" : "Group info")</button>
                        <button type="button" role="menuitem" @onclick="() => searchOpen = !searchOpen"><i data-lucide="search"></i> Search messages</button>
                        <button type="button" role="menuitem" @onclick="OpenPinnedSection"><i data-lucide="pin"></i> Pinned messages</button>
                        <button type="button" role="menuitem" @onclick="OpenMediaSection"><i data-lucide="paperclip"></i> Files &amp; media</button>
                        <button type="button" role="menuitem" @onclick="() => { if (activeRoomList != null) TogglePin(activeRoomList); }"><i data-lucide="arrow-up-to-line"></i> @(isActPinned ? "Unpin conversation" : "Pin conversation")</button>
                        @if (ChatSvc.ActiveRoom.Type == "group")
                        {
                            <button type="button" role="menuitem" @onclick="OpenGroupSettings"><i data-lucide="settings"></i> Group settings</button>
                        }
                    </div>
                }
            </div>

            @* ---- Slim Sticky Pinned Announcement Bar ---- *@
            @if (pinnedMessages.Count > 0)
            {
                var latestPin = pinnedMessages.OrderByDescending(p => p.PinnedAt).First();
                <div class="sticky-pinned-bar" @onclick="() => JumpToMessage(latestPin.MessageId)">
                    <div class="pin-ic"><i data-lucide="pin"></i></div>
                    <div class="pin-body">
                        <span class="pin-tag">Pinned message @(pinnedMessages.Count > 1 ? $"({pinnedMessages.Count})" : "") · By @latestPin.SenderName</span>
                        <span class="pin-text">@(!string.IsNullOrEmpty(latestPin.Content) ? TruncateStr(latestPin.Content, 90) : "Pinned announcement")</span>
                    </div>
                    <button type="button" class="pin-all-btn" @onclick="OpenPinnedSection" @onclick:stopPropagation>
                        View all
                    </button>
                </div>
            }

            @* ---- Live group call banner (Chat.GroupCall.cs) ---- *@
            @if (ActiveGroupCallBanner is { } liveGroupCall)
            {
                var inCall = liveGroupCall.Participants.Count(p => p.Status == IPop.Application.Calls.CallParticipantStatus.Accepted);
                <div class="group-call-banner" role="status">
                    <i data-lucide="phone-call"></i>
                    <span><strong>Panggilan grup sedang berlangsung</strong> · @inCall orang</span>
                    <button type="button" disabled="@(groupCallBusy || CallStateSvc.HasLiveCall && CallStateSvc.Current?.Id != liveGroupCall.Id)" @onclick="() => JoinGroupCall(liveGroupCall.Id)"><i data-lucide="phone"></i> Gabung</button>
                </div>
            }

            @* ---- Offline banner ---- *@
            @if (!ChatSvc.IsConnected)
            {
                <div class="offline-banner">
                    <i data-lucide="wifi-off"></i>
                    <span>Offline — messages will be sent when reconnected</span>
                </div>
            }

            <div class="conv-body-flex">
                <div class="conv-chat-flow">
                    @* ---- In-conversation Search ---- *@
                    @if (searchOpen)
                    {
                        <div class="conv-search-bar">
                            <i data-lucide="search"></i>
                            <input type="text" placeholder="Search messages..." @bind="searchQuery" @bind:event="oninput" @bind:after="DoSearch" />
                            <button class="comp-btn" @onclick="() => { searchOpen = false; searchResults = []; searchQuery = string.Empty; }" title="Close search" aria-label="Close search">
                                <i data-lucide="x"></i>
                            </button>
                        </div>
                        @if (searchResults.Any())
                        {
                            <div class="search-results">
                                @foreach (var result in searchResults.Take(20))
                                {
                                    var r = result;
                                    <button type="button" class="sr-item" @onclick="() => JumpToMessage(r.Id)">
                                        <span class="sr-head">
                                            <span class="who">@r.SenderName</span>
                                            <span class="when">@r.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                                        </span>
                                        <span class="sr-text">@TruncateStr(r.Content, 110)</span>
                                    </button>
                                }
                            </div>
                        }
                        else if (searchQuery.Length >= 2)
                        {
                            <div class="search-results empty">No messages match “@searchQuery”.</div>
                        }
                    }

                    @* ---- Messages ---- *@
                    <div class="messages" @ref="messagesRef">
                        @if (ChatSvc.HasOlderMessages)
                        {
                            <div class="load-older">
                                <button type="button" @onclick="LoadOlder"><i data-lucide="chevron-up"></i> Load older messages</button>
                            </div>
                        }
                        else if (ChatSvc.ActiveRoom is not null)
                        {
                            <div class="conv-start-card">
                                <div class="conv-start-avatar" style="background:@GetActiveRoomColor()">
                                    @if (ChatSvc.ActiveRoom?.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(ChatSvc.ActiveRoom.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> } else { @GetActiveRoomInitials() }
                                </div>
                                <h3 class="conv-start-title">@GetActiveRoomName()</h3>
                                <p class="conv-start-sub">
                                    @(ChatSvc.ActiveRoom.Type == "dm"
                                        ? $"This is the beginning of your direct message history with {GetActiveRoomName()}."
                                        : $"Welcome to the beginning of the #{ChatSvc.ActiveRoom.Name} group conversation.")
                                </p>
                                @if (ChatSvc.ActiveRoom.Type == "dm")
                                {
                                    var otherDm = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                                    if (otherDm is not null)
                                    {
                                        <div class="conv-start-actions">
                                            <button type="button" class="conv-start-btn" @onclick="() => OpenUserProfile(otherDm.Nik)">
                                                <i data-lucide="user"></i> View Profile
                                            </button>
                                        </div>
                                    }
                                }
                            </div>
                        }
                        @{
                            DateTime? lastDate = null;
                            string? prevSenderNik = null;
                            DateTime prevSentAt = DateTime.MinValue;
                            string? prevType = null;
                        }
                        @foreach (var msg in ChatSvc.ActiveMessages)
                        {
                            var msgDate = msg.CreatedAt.ToLocalTime().Date;
                            var startsNewDay = lastDate is null || lastDate != msgDate;
                            if (startsNewDay)
                            {
                                <div class="date-sep">@FormatDateSep(msg.CreatedAt)</div>
                                lastDate = msgDate;
                            }

                            var startsUnread = unreadDividerMsgId == msg.Id;
                            if (startsUnread)
                            {
                                <div class="unread-sep"><span class="unread-tag">New messages</span></div>
                            }

                            var isSent = msg.SenderNik == GetCurrentUserNik();
                            var isPending = ChatSvc.IsPending(msg.Id);
                            var isFailed = ChatSvc.IsFailed(msg.Id);
                            var msgClass = msg.Type switch
                            {
                                "system" => "msg system",
                                "emergency" => "msg emergency",
                                _ => isSent ? "msg sent" : "msg recv"
                            };
                            if (isPending) msgClass += " pending";
                            if (isFailed) msgClass += " failed";

                            var isGrouped = prevSenderNik is not null
                                && prevSenderNik == msg.SenderNik
                                && !startsNewDay && !startsUnread
                                && msg.Type is not ("system" or "emergency")
                                && prevType is not ("system" or "emergency")
                                && (msg.CreatedAt - prevSentAt).TotalMinutes < GroupWindowMinutes;
                            if (isGrouped) msgClass += " grouped";
                            prevSenderNik = msg.SenderNik;
                            prevSentAt = msg.CreatedAt;
                            prevType = msg.Type;
                            var currentMsg = msg;

                            <div @key="msg.Id" data-msg-id="@msg.Id" class="@msgClass @(mToolsMsgId == msg.Id ? "m-tools" : "") @(editingMsgId == msg.Id ? "editing" : "")" @onclick="() => ToggleMobileTools(currentMsg.Id)" @oncontextmenu="(e) => ShowCtx(currentMsg.Id, e)" @oncontextmenu:preventDefault>
                                @if (msg.Type != "system" && msg.Type != "emergency" && editingMsgId != msg.Id)
                                {
                                    var pinnedMsg = IsMsgPinned(currentMsg.Id);
                                    <div class="msg-hover-actions v6-msg-tools @(reactPickerMsgId == msg.Id ? "keep" : "")">
                                        <button type="button" class="act-btn" title="React" aria-label="React" @onclick="() => reactPickerMsgId = reactPickerMsgId == currentMsg.Id ? null : currentMsg.Id" @onclick:stopPropagation>
                                            <i data-lucide="smile-plus"></i>
                                        </button>
                                        <button type="button" class="act-btn" title="Reply" aria-label="Reply" @onclick="() => StartReply(currentMsg.Id)" @onclick:stopPropagation>
                                            <i data-lucide="reply"></i>
                                        </button>
                                        @if (CanTogglePin(currentMsg.Id))
                                        {
                                            <button type="button" class="act-btn @(pinnedMsg ? "pinned" : "")" title="@(pinnedMsg ? "Unpin message" : "Pin message")" aria-label="@(pinnedMsg ? "Unpin message" : "Pin message")" @onclick="() => PinMessage(currentMsg.Id)" @onclick:stopPropagation>
                                                <i data-lucide="pin"></i>
                                            </button>
                                        }
                                        <button type="button" class="act-btn" title="More" aria-label="More options" @onclick="(e) => ShowCtx(currentMsg.Id, e)" @onclick:stopPropagation>
                                            <i data-lucide="ellipsis"></i>
                                        </button>
                                        @if (reactPickerMsgId == msg.Id)
                                        {
                                            <div class="v6-react-pop" @onclick:stopPropagation>
                                                @foreach (var em in ReactEmoji)
                                                {
                                                    var emo = em;
                                                    <button type="button" @onclick="() => { reactPickerMsgId = null; return QuickReact(currentMsg.Id, emo); }">@emo</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (editingMsgId == msg.Id)
                                {
                                    @* stopPropagation: taps and right-clicks inside the editor must not toggle the
                                       message tools or swallow the textarea's native context menu. *@
                                    <div class="bubble-wrap edit-wrap" @onclick:stopPropagation @oncontextmenu:stopPropagation>
                                        <textarea @ref="editRef" class="input-wrap edit-textarea" aria-label="Edit message"
                                                  @bind="editText" @bind:event="oninput" @onkeydown="OnEditKeyDown"></textarea>
                                        <div class="edit-actions">
                                            <button class="comp-btn" @onclick="SaveEdit">Save</button>
                                            <button class="comp-btn" @onclick="CancelEdit">Cancel</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <MessageBubble Message="currentMsg"
                                                   IsPinned="@IsMsgPinned(currentMsg.Id)"
                                                   ShowDeliveryStatus="@(isSent && msg.Id == LastOwnMessageId)"
                                                   IsGroup="@(ChatSvc.ActiveRoom?.Type == "group" && currentMsg.Type != "system" && !currentMsg.IsDeleted)"
                                                   OnCtx="t => ShowCtx(t.Item1, t.Item2)"
                                                   OnProfile="OpenUserProfile"
                                                   OnReact="t => QuickReact(t.Item1, t.Item2)"
                                                   OnThread="ToggleThread"
                                                   OnAttachmentOpen="a => OpenAttachment(a, currentMsg.Attachments)" />

                                    @if (isSent && !isPending && !isFailed && !currentMsg.IsDeleted
                                         && msg.Type != "system" && ChatSvc.ActiveRoom?.Type == "group")
                                    {
                                        <SeenIndicator @key="msg.Id" Message="currentMsg"
                                                       CurrentUserNik="@GetCurrentUserNik()"
                                                       RoomType="@(ChatSvc.ActiveRoom?.Type ?? "group")" />
                                    }

                                    @if (isFailed)
                                    {
                                        <div class="msg-retry">
                                            <span>Not sent</span>
                                            <button type="button" @onclick="() => ChatSvc.RetryAsync(currentMsg.Id)" @onclick:stopPropagation>
                                                <i data-lucide="rotate-ccw"></i> Retry
                                            </button>
                                        </div>
                                    }
                                }

                                @if (expandedThreadId == msg.Id)
                                {
                                    <ThreadPanel ParentId="msg.Id" />
                                }
                            </div>
                        }

                        @if (ChatSvc.TypingUsers.Any())
                        {
                            <div class="typing-indicator">
                                <span class="dots"><span></span><span></span><span></span></span>
                                @FormatTypingLabel()
                            </div>
                        }
                    </div>

                    @if (showJumpToLatest)
                    {
                        <button type="button" class="jump-latest" title="Jump to latest" aria-label="Jump to latest" @onclick="JumpToLatest">
                            <i data-lucide="arrow-down"></i>
                        </button>
                    }

                    @* ---- Apple-style Composer ---- *@
                    <div class="composer-wrap" @ref="composerWrapRef">
                        @* v6: emoji popover (smile inside the input) and the "+" menu; stickers live under "+". *@
                        @if (pickerOpen)
                        {
                            <div class="v6-pop v6-emoji-pop" @onclick:stopPropagation>
                                <div class="v6-emoji-grid">
                                    @foreach (var emoji in ComposerEmoji)
                                    {
                                        var e = emoji;
                                        <button type="button" class="v6-emoji" @onclick="() => InsertEmoji(e)">@e</button>
                                    }
                                </div>
                            </div>
                        }
                        @if (stickerOpen)
                        {
                            <StickerPicker OnSend="SendStickerKey" OnClose="() => stickerOpen = false" OnCreate="OpenStickerEditor" OnRemove="RemoveSticker" OnSave="SaveStickerFromMessage" Error="@stickerError" />
                        }
                        @if (plusMenuOpen)
                        {
                            <div class="v6-pop v6-plus-menu" role="menu" @onclick:stopPropagation>
                                <button type="button" role="menuitem" @onclick="() => { plusMenuOpen = false; return TriggerFileUpload(); }">
                                    <span class="pm-ic" style="--pm:#0A84FF"><i data-lucide="image"></i></span> File or photo
                                </button>
                                <button type="button" role="menuitem" @onclick="() => { plusMenuOpen = false; pickerOpen = false; return OpenStickers(); }">
                                    <span class="pm-ic" style="--pm:#FF9F0A"><i data-lucide="sticker"></i></span> Sticker
                                </button>
                                @if (ChatSvc.ActiveRoom!.Type == "group")
                                {
                                    <button type="button" role="menuitem" @onclick="() => { plusMenuOpen = false; _ = OpenMention(); }">
                                        <span class="pm-ic" style="--pm:#7657C4"><i data-lucide="at-sign"></i></span> Mention
                                    </button>
                                    <button type="button" role="menuitem" @onclick="() => { plusMenuOpen = false; pollModalOpen = true; }">
                                        <span class="pm-ic" style="--pm:#2E9E5B"><i data-lucide="bar-chart-2"></i></span> Poll
                                    </button>
                                }
                                @if (IsGroupAdmin)
                                {
                                    <button type="button" role="menuitem" class="danger" @onclick="() => { plusMenuOpen = false; emergencyConfirmOpen = true; }">
                                        <span class="pm-ic" style="--pm:#C4271C"><i data-lucide="alert-triangle"></i></span> Emergency broadcast
                                    </button>
                                }
                            </div>
                        }

                        @{
                            var isTaskTrigger = mentionTrigger == '#' && !string.IsNullOrEmpty(mentionTaskProject?.Id.ToString());
                            if (isTaskTrigger && tasksLoadedForProject != mentionTaskProject!.Id.ToString("N"))
                                _ = EnsureTaskCandidatesAsync();
                            var projectMatches = mentionTrigger == '@' ? CurrentProjectMatches() : new List<IPop.Application.Projects.ProjectListDto>();
                            var taskMatches = isTaskTrigger ? CurrentTaskMatches() : new List<IPop.Application.Projects.ProjectTaskDto>();
                        }
                        @if (mentionPopupOpen && activeMention is not null)
                        {
                            <MentionPopup @ref="mentionPopupRef"
                                          IsOpen="mentionPopupOpen"
                                          Query="@mentionFilter"
                                          Candidates="@mentionSuggestions"
                                          CurrentUserNik="@GetCurrentUserNik()"
                                          ShowAll="mentionShowAll"
                                          AllCount="MentionAllCount"
                                          OnPick="HandleMentionPick" />
                        }
                        else if (projectMatches.Any() || taskMatches.Any())
                        {
                            <div class="mention-popup">
                                @if (isTaskTrigger)
                                {
                                    @for (var ti = 0; ti < taskMatches.Count; ti++)
                                    {
                                        var task = taskMatches[ti];
                                        <div class="mi @(ti == mentionAltIndex ? "sel" : "")" @onclick="() => SelectTaskMention(task)">
                                            <div class="avatar avatar-28 chip-avatar"><i data-lucide="square-check"></i></div>
                                            <div><div class="name">@task.Title</div><div class="role">Task · @(task.Status ?? "todo")@(task.Priority is not null ? $" · {task.Priority}" : "")</div></div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    @for (var pi = 0; pi < projectMatches.Count; pi++)
                                    {
                                        var proj = projectMatches[pi];
                                        <div class="mi @(pi == mentionAltIndex ? "sel" : "")" @onclick="() => SelectProjectMention(proj)">
                                            <div class="avatar avatar-28 chip-avatar chip-contextual"><i data-lucide="folder"></i></div>
                                            <div><div class="name">@proj.Name</div><div class="role">Project · @proj.Status</div></div>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        @if (replyToMsg is not null)
                        {
                            <div class="reply-bar">
                                <i data-lucide="reply" class="reply-bar-ic"></i>
                                <div class="rq"><div class="rq-name">Replying to @replyToMsg.SenderName</div><div class="rq-text">@TruncateStr(replyToMsg.Content, 100)</div></div>
                                <button class="close-reply" title="Cancel reply" aria-label="Cancel reply" @onclick="CancelReply"><i data-lucide="x"></i></button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(uploadError))
                        {
                            <div class="upload-error">@uploadError</div>
                        }

                        @if (pendingAttachments.Count > 0)
                        {
                            <div class="pending-strip">
                                @foreach (var att in pendingAttachments)
                                {
                                    var a = att;
                                    var dto = a.AsDto();
                                    <div class="pending-item @(a.PreviewUrl is not null ? "has-thumb" : "")" title="@a.FileName">
                                        @if (a.PreviewUrl is not null)
                                        {
                                            <img src="@a.PreviewUrl" alt="@a.FileName" />
                                        }
                                        else
                                        {
                                            <span class="ic attachment-icon" style="--attachment-accent:@ChatAttachments.Accent(dto)">
                                                <i data-lucide="@ChatAttachments.Icon(dto)"></i>
                                            </span>
                                            <span class="txt">
                                                <span class="nm">@a.FileName</span>
                                                <span class="sz">@ChatAttachments.TypeLabel(dto) · @ChatAttachments.FormatSize(a.FileSize)</span>
                                            </span>
                                        }
                                        <button type="button" class="rm" title="Remove" aria-label="Remove attachment" @onclick="() => RemovePending(a.Id)" @onclick:stopPropagation>
                                            <i data-lucide="x"></i>
                                        </button>
                                    </div>
                                }
                                @if (uploading)
                                {
                                    <div class="pending-item uploading"><span class="att-skeleton"></span></div>
                                }
                            </div>
                        }

                        <div class="composer v6-composer">
                            <InputFile @ref="fileInput" OnChange="OnFileSelected" class="hidden-input" accept="*/*" multiple />
                            @if (isRecordingVoice)
                            {
                                <button type="button" class="v6-rec-trash" title="Discard recording" aria-label="Discard recording" @onclick="CancelVoiceRecord">
                                    <i data-lucide="trash-2"></i>
                                </button>
                                <div class="v6-rec-pill">
                                    <span class="rec-dot"></span>
                                    <span>Recording voice message…</span>
                                </div>
                                <button type="button" class="v6-send on" title="Send voice message" aria-label="Send voice message" @onclick="StopAndSendVoiceRecord">
                                    <i data-lucide="arrow-up"></i>
                                </button>
                            }
                            else
                            {
                                var hasDraft = !string.IsNullOrWhiteSpace(messageText) || pendingAttachments.Count > 0;
                                <button type="button" class="v6-plus @(plusMenuOpen ? "on" : "") @(uploading ? "busy" : "")"
                                        title="Attach, sticker, more" aria-label="More composer actions" aria-haspopup="menu" aria-expanded="@(plusMenuOpen ? "true" : "false")"
                                        disabled="@uploading"
                                        @onclick="() => { plusMenuOpen = !plusMenuOpen; pickerOpen = false; stickerOpen = false; }" @onclick:stopPropagation>
                                    <i data-lucide="@(uploading ? "loader" : "plus")"></i>
                                </button>
                                <div class="v6-input">
                                    <textarea @ref="composerRef" class="input-wrap"
                                              data-mention-open="@(MentionListVisible ? "1" : "0")"
                                              aria-autocomplete="list" aria-expanded="@(MentionListVisible ? "true" : "false")"
                                              placeholder="@ComposerPlaceholder"
                                              @bind="messageText"
                                              @bind:event="oninput"
                                              @bind:after="OnComposerInput"
                                              @onblur="OnComposerBlur"
                                              rows="1"></textarea>
                                    <button type="button" class="v6-smile @(pickerOpen ? "on" : "")" title="Emoji" aria-label="Emoji"
                                            @onclick="() => { pickerOpen = !pickerOpen; plusMenuOpen = false; stickerOpen = false; }" @onclick:stopPropagation>
                                        <i data-lucide="smile"></i>
                                    </button>
                                    @if (hasDraft)
                                    {
                                        <button type="button" class="v6-send on" title="Send" aria-label="Send message" @onclick="SendMessage">
                                            <i data-lucide="arrow-up"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="v6-send mic" title="Record voice message" aria-label="Record voice message" @onclick="StartVoiceRecord">
                                            <i data-lucide="mic"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ---- Single-Column Apple Detail Panel ---- *@
                @if (drawerOpen && ChatSvc.ActiveRoom is not null)
                {
                    <div class="chat-panel-backdrop @(drawerOpen ? "on" : "")" @onclick="CloseDetail"></div>
                    <aside class="chat-detail-panel @(drawerOpen ? "on" : "")">
                        <div class="panel-header">
                            @if (CanGoBackDetail)
                            {
                                <button type="button" class="panel-back-btn" @onclick="GoBackDetail" title="Back to @BackLabel" aria-label="Back to @BackLabel">
                                    <i data-lucide="chevron-left"></i>
                                    <span>@BackLabel</span>
                                </button>
                            }
                            <span class="panel-header-title">@DetailViewTitle(panelView)</span>
                            <button type="button" class="panel-close-btn" title="Close" aria-label="Close" @onclick="CloseDetail">
                                <i data-lucide="x"></i>
                            </button>
                        </div>

                        <div class="panel-body">
                            @if (panelView == DetailPanelView.Person)
                            {
                                <div class="panel-person-view">
                                    @if (profilePerson is not null)
                                    {
                                        <ContactCard Person="profilePerson"
                                                     OnMessage="() => MessagePerson(profilePerson?.Nik)"
                                                     OnMail="() => MailPerson(profilePerson?.Nik)"
                                                     OnCall="() => StartCallWith(profilePerson?.Nik)" />
                                    }
                                    else
                                    {
                                        <div class="panel-loading"><i data-lucide="loader-circle"></i> Loading contact info…</div>
                                    }
                                </div>
                            }
                            else if (panelView == DetailPanelView.Members)
                            {
                                <div class="panel-sub-view">
                                    <div class="pane-search">
                                        <i data-lucide="search"></i>
                                        <input type="text" placeholder="Search members…" @bind="memberFilter" @bind:event="oninput" />
                                    </div>

                                    @if (CanManageMembers)
                                    {
                                        <div class="add-member-bar">
                                            <button type="button" class="add-member-toggle-btn" @onclick="() => addMemberOpen = !addMemberOpen">
                                                <i data-lucide="user-plus"></i> Add new member
                                            </button>
                                            @if (addMemberOpen)
                                            {
                                                <div class="add-member-popup">
                                                    <input type="text" placeholder="Type name or ID…" @bind="addMemberQuery" @bind:event="oninput" @bind:after="SearchAddMember" />
                                                    <div class="add-member-results">
                                                        @foreach (var user in addMemberResults.Take(6))
                                                        {
                                                            var u = user;
                                                            <div class="add-user-item" @onclick="() => AddMemberToGroup(u)">
                                                                <PersonAvatar Nik="@u.Nik" Name="@u.Name" Size="26" Class="avatar avatar-26" Decorative="true" />
                                                                <span class="name">@u.Name</span>
                                                                <i data-lucide="plus" class="plus-icon"></i>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    <div class="member-list-scroll">
                                        @{
                                            var members = ChatSvc.ActiveRoom.Members
                                                .Where(m => string.IsNullOrWhiteSpace(memberFilter) ||
                                                            m.Name.Contains(memberFilter, StringComparison.OrdinalIgnoreCase) ||
                                                            m.Nik.Contains(memberFilter, StringComparison.OrdinalIgnoreCase))
                                                .OrderBy(m => RoleRank(m.Role)).ThenBy(m => m.Name)
                                                .ToList();
                                        }
                                        @foreach (var m in members)
                                        {
                                            var member = m;
                                            <MemberRow Member="member"
                                                       CurrentUserNik="@GetCurrentUserNik()"
                                                       CurrentUserRole="@(ChatSvc.ActiveRoom?.CurrentUserRole ?? "")"
                                                       ShowActions="@(ChatSvc.ActiveRoom?.Type == "group")"
                                                       OnRemove="RemoveGroupMember"
                                                       OnChangeRole="ChangeGroupMemberRole"
                                                       OnProfile="OpenUserProfile" />
                                        }
                                        @if (!members.Any())
                                        {
                                            <div class="empty-media-state">No members match "@memberFilter"</div>
                                        }
                                    </div>

                                    @if (CanManageMembers)
                                    {
                                        <div class="member-history">
                                            <button type="button" class="member-history-toggle" aria-expanded="@(memberHistoryOpen ? "true" : "false")"
                                                    @onclick="() => memberHistoryOpen = !memberHistoryOpen">
                                                <i data-lucide="history"></i> Membership history
                                                <i data-lucide="@(memberHistoryOpen ? "chevron-up" : "chevron-down")" class="mh-chev"></i>
                                            </button>
                                            @if (memberHistoryOpen)
                                            {
                                                <div class="member-history-list">
                                                    <MembershipAuditList RoomId="ChatSvc.ActiveRoom.Id" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (panelView == DetailPanelView.Pinned)
                            {
                                <div class="panel-sub-view">
                                    <PinnedPanel RoomId="@(ChatSvc.ActiveRoom?.Id ?? Guid.Empty)"
                                                 IsOpen="true"
                                                 Items="pinnedMessages"
                                                 CanUnpin="CanUnpin"
                                                 Scope="pinnedScope"
                                                 OnJumpTo="JumpToMessage"
                                                 OnOpenPin="OpenPinFromPanel"
                                                 OnChanged="LoadPinnedMessagesAsync" />
                                </div>
                            }
                            else if (panelView == DetailPanelView.GroupSettings)
                            {
                                <div class="panel-sub-view">
                                    <IPop.Web.Components.Chat.GroupSettingsPanel RoomId="ChatSvc.ActiveRoom.Id"
                                                                                 OnChanged="OnGroupSettingsChanged"
                                                                                 OnRoomRemoved="OnGroupSettingsRoomRemoved" />
                                </div>
                            }
                            else if (panelView == DetailPanelView.Media)
                            {
                                <div class="panel-sub-view">
                                    <div class="media-subtabs">
                                        <button type="button" class="subtab @(mediaSubTab == "all" ? "active" : "")" @onclick='() => mediaSubTab = "all"'>All</button>
                                        <button type="button" class="subtab @(mediaSubTab == "photos" ? "active" : "")" @onclick='() => mediaSubTab = "photos"'>Photos & Videos</button>
                                        <button type="button" class="subtab @(mediaSubTab == "docs" ? "active" : "")" @onclick='() => mediaSubTab = "docs"'>Documents</button>
                                    </div>

                                    <div class="media-list-scroll">
                                        @{
                                            var allAtts = ChatSvc.ActiveMessages
                                                .SelectMany(m => m.Attachments)
                                                .DistinctBy(a => a.Id)
                                                .ToList();
                                            var filteredAtts = mediaSubTab switch
                                            {
                                                "photos" => allAtts.Where(a => ChatAttachments.IsImage(a) || ChatAttachments.Kind(a) == AttachmentKind.Video).ToList(),
                                                "docs" => allAtts.Where(a => !ChatAttachments.IsImage(a) && ChatAttachments.Kind(a) != AttachmentKind.Video).ToList(),
                                                _ => allAtts
                                            };
                                        }
                                        @if (mediaSubTab == "photos" || (mediaSubTab == "all" && filteredAtts.Any(a => ChatAttachments.IsImage(a) || ChatAttachments.Kind(a) == AttachmentKind.Video)))
                                        {
                                            var visualAtts = (mediaSubTab == "photos" ? filteredAtts : filteredAtts.Where(a => ChatAttachments.IsImage(a) || ChatAttachments.Kind(a) == AttachmentKind.Video)).ToList();
                                            @if (visualAtts.Any())
                                            {
                                                <div class="media-grid-3">
                                                    @foreach (var att in visualAtts)
                                                    {
                                                        var a = att;
                                                        <div class="media-thumb-box" @onclick="() => OpenAttachment(a, visualAtts)">
                                                            <ChatAttachment Attachment="a" OnOpen="attDto => OpenAttachment(attDto, visualAtts)" />
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        @if (mediaSubTab == "docs" || (mediaSubTab == "all" && filteredAtts.Any(a => !ChatAttachments.IsImage(a) && ChatAttachments.Kind(a) != AttachmentKind.Video)))
                                        {
                                            var docAtts = (mediaSubTab == "docs" ? filteredAtts : filteredAtts.Where(a => !ChatAttachments.IsImage(a) && ChatAttachments.Kind(a) != AttachmentKind.Video)).ToList();
                                            @if (docAtts.Any())
                                            {
                                                <div class="doc-list-col">
                                                    @foreach (var att in docAtts)
                                                    {
                                                        var a = att;
                                                        <ChatAttachment Attachment="a" Layout="row" OnOpen="attDto => OpenAttachment(attDto, docAtts)" />
                                                    }
                                                </div>
                                            }
                                        }
                                        @if (!filteredAtts.Any())
                                        {
                                            <div class="empty-media-state">
                                                <i data-lucide="paperclip"></i>
                                                <span>No shared files found in this conversation yet.</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else if (panelView == DetailPanelView.Events)
                            {
                                <div class="panel-sub-view">
                                    <div class="drawer-cal">
                                        <div class="drawer-cal-head">
                                            <i data-lucide="calendar"></i>
                                            <span>Room Events</span>
                                            <button class="btn-sm accent" style="margin-left:auto" @onclick="ToggleRoomEventForm">
                                                <i data-lucide="plus" style="width:12px;height:12px"></i> Event
                                            </button>
                                        </div>

                                        @if (roomEventFormOpen)
                                        {
                                            <div class="drawer-cal-form">
                                                <input class="org-input" style="height:30px;font-size:12.5px" placeholder="Event title…" @bind="roomEventTitle" />
                                                <AppDateTimePicker @bind-Value="roomEventStart" Compact="true" Class="dp-block" AriaLabel="Event start" />
                                                <div class="drawer-cal-attendees">
                                                    <i data-lucide="users" style="width:12px;height:12px"></i>
                                                    <span>Attendees: @(ChatSvc.ActiveRoom?.MemberCount ?? 0) room members (auto)</span>
                                                </div>
                                                <div style="display:flex;gap:6px">
                                                    <button class="btn-sm accent" disabled="@(string.IsNullOrWhiteSpace(roomEventTitle) || roomEventSaving)" @onclick="SaveRoomEvent">
                                                        @(roomEventSaving ? "Saving…" : "Save")
                                                    </button>
                                                    <button class="btn-sm surface" @onclick="ToggleRoomEventForm">Cancel</button>
                                                </div>
                                            </div>
                                        }

                                        @if (roomEventsLoading)
                                        {
                                            <div class="drawer-cal-empty"><i data-lucide="loader-circle"></i> Loading events…</div>
                                        }
                                        else if (roomEvents.Count == 0)
                                        {
                                            <div class="drawer-cal-empty">
                                                <i data-lucide="calendar-x" style="width:22px;height:22px"></i>
                                                <div>No events in this room</div>
                                                <div class="meta" style="font-size:11px;color:var(--ink-3)">Add meetings for room members.</div>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var ev in roomEvents)
                                            {
                                                <button type="button" class="drawer-cal-event" @onclick="() => OpenRoomEventDetail(ev)">
                                                    <span class="cal-dot"></span>
                                                    <span class="cal-t">@ev.Title</span>
                                                    <span class="cal-w">@ev.StartAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                @* ---- Single Scroll Column (Main) ---- *@
                                <div class="panel-main-col">
                                    <!-- Hero: a DM shows the shared contact card; a group keeps the room hero -->
                                    @if (ChatSvc.ActiveRoom.Type == "dm")
                                    {
                                        var cardOther = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                                        var cardPerson = DmCardPerson(cardOther);
                                        @if (cardPerson is not null)
                                        {
                                            <ContactCard Person="cardPerson"
                                                         OnMessage="() => MessagePerson(cardPerson.Nik)"
                                                         OnMail="() => MailPerson(cardPerson.Nik)"
                                                         OnCall="() => StartCallWith(cardPerson.Nik)" />
                                        }
                                    }
                                    else
                                    {
                                        <div class="panel-hero">
                                            <div class="panel-hero-av @(ChatSvc.ActiveRoom.Type == "group" ? "group-av" : "person-av")" style="background:@GetActiveRoomColor()">
                                                @if (ChatSvc.ActiveRoom?.AvatarUrl is not null) { <img class="room-photo" src="@PhotoUrl(ChatSvc.ActiveRoom.AvatarUrl)" alt="" style="width:100%;height:100%;border-radius:inherit" /> } else { @GetActiveRoomInitials() }
                                            </div>
                                            <div class="panel-hero-name">@GetActiveRoomName()</div>
                                            @if (ChatSvc.ActiveRoom.Type == "dm" && dmPerson is not null && !string.IsNullOrWhiteSpace(dmPerson.Position) && dmPerson.Position != "—")
                                            {
                                                <div class="panel-hero-position">@dmPerson.Position</div>
                                            }
                                            @if (ChatSvc.ActiveRoom.Type == "group" && !string.IsNullOrWhiteSpace(ChatSvc.ActiveRoom.Description))
                                            {
                                                <div class="panel-hero-position">@ChatSvc.ActiveRoom.Description</div>
                                            }
                                            <div class="panel-hero-meta">
                                                @if (ChatSvc.ActiveRoom.Type == "dm")
                                                {
                                                    var dmOther = ChatSvc.ActiveRoom.Members.FirstOrDefault(m => m.Nik != GetCurrentUserNik());
                                                    <span class="presence-badge @(dmOther?.PresenceStatus ?? "off")">
                                                        <span class="dot"></span> @PresenceLabel(dmOther?.PresenceStatus)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>@ChatSvc.ActiveRoom.MemberCount members · @ChatSvc.ActiveRoom.OnlineCount online</span>
                                                }
                                            </div>

                                            <!-- Three 44px round labelled buttons -->
                                            <div class="hero-actions">
                                                @if (ChatSvc.ActiveRoom.Type == "group")
                                                {
                                                    <button type="button" class="hero-btn" @onclick="StartGroupCall" title="Panggilan grup" aria-label="Mulai panggilan grup" disabled="@(groupCallBusy || CallStateSvc.IsInGroupCall)">
                                                        <div class="hero-btn-ic"><i data-lucide="phone"></i></div>
                                                        <span>Call</span>
                                                    </button>
                                                    <button type="button" class="hero-btn" @onclick="OpenAddMember" title="Add" aria-label="Add members" disabled="@(!CanManageMembers)">
                                                        <div class="hero-btn-ic"><i data-lucide="user-plus"></i></div>
                                                        <span>Add</span>
                                                    </button>
                                                    <button type="button" class="hero-btn" @onclick="ToggleMuteRoom" title="@(IsActiveRoomMuted ? "Unmute" : "Mute")" aria-label="@(IsActiveRoomMuted ? "Unmute" : "Mute")">
                                                        <div class="hero-btn-ic"><i data-lucide="@(IsActiveRoomMuted ? "bell-off" : "bell")"></i></div>
                                                        <span>@(IsActiveRoomMuted ? "Unmute" : "Mute")</span>
                                                    </button>
                                                    <button type="button" class="hero-btn" @onclick="() => searchOpen = !searchOpen" title="Search" aria-label="Search conversation">
                                                        <div class="hero-btn-ic"><i data-lucide="search"></i></div>
                                                        <span>Search</span>
                                                    </button>
                                                    <button type="button" class="hero-btn" @onclick="() => NavigateDetail(DetailPanelView.Members)" title="Members" aria-label="View members">
                                                        <div class="hero-btn-ic"><i data-lucide="users"></i></div>
                                                        <span>Members</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Inset Grouped Lists -->
                                    <div class="inset-groups">
                                        @if (ChatSvc.ActiveRoom.Type == "group")
                                        {
                                            <!-- Group Members -->
                                            <div class="inset-group">
                                                <div class="inset-sec-header">
                                                    <span class="inset-sec-title">Members (@ChatSvc.ActiveRoom.MemberCount)</span>
                                                    <button type="button" class="inset-see-all" @onclick="() => NavigateDetail(DetailPanelView.Members)">See all</button>
                                                </div>
                                                <div class="inset-box">
                                                    @foreach (var m in ChatSvc.ActiveRoom.Members.Take(5))
                                                    {
                                                        var member = m;
                                                        <MemberRow Member="member"
                                                                   CurrentUserNik="@GetCurrentUserNik()"
                                                                   CurrentUserRole="@(ChatSvc.ActiveRoom?.CurrentUserRole ?? "")"
                                                                   ShowActions="false"
                                                                   OnProfile="OpenUserProfile" />
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Pinned Section -->
                                        @if (pinnedMessages.Count > 0)
                                        {
                                            <div class="inset-group">
                                                <div class="inset-sec-header">
                                                    <span class="inset-sec-title">Pinned (@pinnedMessages.Count)</span>
                                                    <button type="button" class="inset-see-all" @onclick="() => NavigateDetail(DetailPanelView.Pinned)">See all</button>
                                                </div>
                                                <div class="inset-box">
                                                    @foreach (var pin in pinnedMessages.Take(3))
                                                    {
                                                        var p = pin;
                                                        <div class="inset-row clickable" @onclick="() => JumpToMessage(p.MessageId)">
                                                            <div class="inset-pin-info">
                                                                <span class="inset-pin-sender">@p.SenderName</span>
                                                                <span class="inset-pin-txt">@TruncateStr(p.Content, 60)</span>
                                                            </div>
                                                            <i data-lucide="chevron-right" class="inset-action-chev"></i>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <!-- Files & Media Section -->
                                        @{
                                            var recentMedia = ChatSvc.ActiveMessages
                                                .SelectMany(m => m.Attachments)
                                                .DistinctBy(a => a.Id)
                                                .Take(6)
                                                .ToList();
                                        }
                                        @if (recentMedia.Any())
                                        {
                                            <div class="inset-group">
                                                <div class="inset-sec-header">
                                                    <span class="inset-sec-title">Files & Media</span>
                                                    <button type="button" class="inset-see-all" @onclick="() => NavigateDetail(DetailPanelView.Media)">See all</button>
                                                </div>
                                                <div class="inset-box" style="padding:10px">
                                                    <div class="media-grid-3">
                                                        @foreach (var att in recentMedia)
                                                        {
                                                            var a = att;
                                                            <div class="media-thumb-box" @onclick="() => OpenAttachment(a, recentMedia)">
                                                                <ChatAttachment Attachment="a" OnOpen="attDto => OpenAttachment(attDto, recentMedia)" />
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Events Section -->
                                        <div class="inset-group">
                                            <div class="inset-sec-header">
                                                <span class="inset-sec-title">Events</span>
                                                <button type="button" class="inset-see-all" @onclick="() => NavigateDetail(DetailPanelView.Events)">See all</button>
                                            </div>
                                            <div class="inset-box">
                                                @if (roomEvents.Count > 0)
                                                {
                                                    @foreach (var ev in roomEvents.Take(3))
                                                    {
                                                        <button type="button" class="inset-action-row" @onclick="() => OpenRoomEventDetail(ev)">
                                                            <div class="inset-action-left">
                                                                <span class="cal-dot"></span>
                                                                <span>@ev.Title</span>
                                                            </div>
                                                            <span class="inset-dim" style="font-size:11.5px">@ev.StartAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                                                        </button>
                                                    }
                                                }
                                                else
                                                {
                                                    <button type="button" class="inset-action-row" @onclick="() => NavigateDetail(DetailPanelView.Events)">
                                                        <div class="inset-action-left">
                                                            <i data-lucide="calendar-plus"></i>
                                                            <span>New event</span>
                                                        </div>
                                                        <i data-lucide="chevron-right" class="inset-action-chev"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>

                                        <!-- Options Section -->
                                        <div class="inset-group">
                                            <div class="inset-sec-title">Settings</div>
                                            <div class="inset-box">
                                                <button type="button" class="inset-action-row" @onclick="ToggleMuteRoom">
                                                    <div class="inset-action-left">
                                                        <i data-lucide="@(IsActiveRoomMuted ? "bell-off" : "bell")"></i>
                                                        <span>Mute notifications</span>
                                                    </div>
                                                    <span class="apple-switch @(IsActiveRoomMuted ? "on" : "")">
                                                        <span class="apple-switch-knob"></span>
                                                    </span>
                                                </button>
                                                @{ var panelRoom = ChatSvc.GroupRooms.Concat(ChatSvc.DirectRooms).FirstOrDefault(r => r.Id == ChatSvc.ActiveRoom!.Id); }
                                                @if (panelRoom is not null)
                                                {
                                                    <button type="button" class="inset-action-row" @onclick="() => TogglePin(panelRoom)">
                                                        <div class="inset-action-left"><i data-lucide="arrow-up-to-line"></i><span>Pin @(ChatSvc.ActiveRoom!.Type == "group" ? "group" : "conversation")</span></div>
                                                        <span class="apple-switch @(panelRoom.IsPinned ? "on" : "")"><span class="apple-switch-knob"></span></span>
                                                    </button>
                                                }
                                                <button type="button" class="inset-action-row" @onclick="ToggleReadReceiptsRoom">
                                                    <div class="inset-action-left">
                                                        <i data-lucide="@(IsActiveRoomReadReceiptsEnabled ? "check-check" : "eye-off")"></i>
                                                        <span>Read receipts</span>
                                                    </div>
                                                    <span class="apple-switch @(IsActiveRoomReadReceiptsEnabled ? "on" : "")">
                                                        <span class="apple-switch-knob"></span>
                                                    </span>
                                                </button>
                                                <button type="button" class="inset-action-row" @onclick="ArchiveRoom">
                                                    <div class="inset-action-left">
                                                        <i data-lucide="archive"></i>
                                                        <span>Archive conversation</span>
                                                    </div>
                                                    <i data-lucide="chevron-right" class="inset-action-chev"></i>
                                                </button>
                                                <button type="button" class="inset-action-row" @onclick="ClearRoomHistory">
                                                    <div class="inset-action-left"><i data-lucide="eraser"></i><span>Clear my history</span></div>
                                                </button>
                                                @if (ChatSvc.ActiveRoom?.Type == "dm" && ChatSvc.ActiveRoom.Members.Any(m => m.Nik != GetCurrentUserNik()))
                                                {
                                                    <button type="button" class="inset-action-row" @onclick="ToggleBlockDmUser">
                                                        <div class="inset-action-left"><i data-lucide="user-x"></i><span>@(dmUserBlocked ? "Unblock contact" : "Block contact")</span></div>
                                                    </button>
                                                }
                                                @if (ChatSvc.ActiveRoom?.Type == "group")
                                                {
                                                    <button type="button" class="inset-action-row" @onclick="() => NavigateDetail(DetailPanelView.GroupSettings)">
                                                        <div class="inset-action-left">
                                                            <i data-lucide="settings"></i>
                                                            <span>Group settings</span>
                                                        </div>
                                                        <i data-lucide="chevron-right" class="inset-action-chev"></i>
                                                    </button>
                                                    <button type="button" class="inset-action-row danger" @onclick="LeaveGroup">
                                                        <div class="inset-action-left">
                                                            <i data-lucide="log-out"></i>
                                                            <span>Leave group</span>
                                                        </div>
                                                        <i data-lucide="chevron-right" class="inset-action-chev"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </aside>
                }
            </div>

            @* ---- Detail Event Ruang ---- *@
            <EventDetailModal IsOpen="@roomEventModalOpen"
                              IsOpenChanged="v => roomEventModalOpen = v"
                              Event="@roomEventDetail" />

            @* ---- Forward Modal ---- *@
            <ChatForwardDialog IsOpen="@forwardOpen"
                               IsOpenChanged="v => forwardOpen = v"
                               Rooms="ChatSvc.DirectRooms.Concat(ChatSvc.GroupRooms).ToList()"
                               OnForward="ForwardTo"
                               GetRoomName="GetRoomName"
                               GetRoomInitials="GetRoomInitials"
                               GetRoomColor="GetRoomColor" />

            @* ---- Create Poll Modal ---- *@
            <CreatePollDialog IsOpen="@pollModalOpen"
                              IsOpenChanged="v => pollModalOpen = v"
                              OnPollCreated="OnPollCreated" />

            @* ---- Hapus chat (for me / whole group) ---- *@
            <Modal IsOpen="deleteRoom is not null" IsOpenChanged="v => { if (!v) deleteRoom = null; }"
                   Title="Hapus chat" Subtitle="@(deleteRoom is null ? null : GetRoomName(deleteRoom))">
                <ChildContent>
                    @if (deleteRoom is not null)
                    {
                        <div class="delete-room">
                            @if (deleteRoomCanPurge)
                            {
                                <label class="delete-room-opt @(deleteRoomForAll ? "" : "on")">
                                    <input type="radio" name="delete-room-scope" checked="@(!deleteRoomForAll)" @onchange="() => deleteRoomForAll = false" />
                                    <span><strong>Hapus untuk saya</strong><small>Riwayat dikosongkan dan grup hilang dari daftar Anda sampai ada pesan baru.</small></span>
                                </label>
                                <label class="delete-room-opt danger @(deleteRoomForAll ? "on" : "")">
                                    <input type="radio" name="delete-room-scope" checked="@deleteRoomForAll" @onchange="() => deleteRoomForAll = true" />
                                    <span><strong>Hapus grup untuk semua anggota</strong><small>Grup, semua pesan, dan file lampirannya dihapus permanen. Tidak bisa dibatalkan.</small></span>
                                </label>
                                @if (deleteRoomForAll)
                                {
                                    <label class="delete-room-confirm">
                                        Ketik <strong>@deleteRoom.Name</strong> untuk konfirmasi
                                        <input class="fx-input" aria-label="Nama grup" @bind="deleteRoomConfirm" @bind:event="oninput" autocomplete="off" />
                                    </label>
                                }
                            }
                            else
                            {
                                <p class="delete-room-note">
                                    @(deleteRoom.Type == "dm"
                                        ? "Riwayat chat ini dihapus dan percakapan hilang dari daftar Anda. Lawan bicara tetap menyimpan riwayatnya. Percakapan muncul lagi bila ada pesan baru."
                                        : "Riwayat chat ini dihapus dan grup hilang dari daftar Anda sampai ada pesan baru. Anggota lain tidak terpengaruh.")
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(deleteRoomError)) { <p class="delete-room-error" role="alert">@deleteRoomError</p> }
                        </div>
                    }
                </ChildContent>
                <Footer>
                    <button type="button" class="comp-btn" @onclick="() => deleteRoom = null">Batal</button>
                    <button type="button" class="cm-btn primary danger" disabled="@(deleteRoomBusy || !DeleteRoomReady)" @onclick="ConfirmDeleteRoom">
                        @(deleteRoomBusy ? "Menghapus…" : deleteRoomForAll ? "Hapus untuk semua" : "Hapus chat")
                    </button>
                </Footer>
            </Modal>

            @* ---- Leave Group Confirm ---- *@
            @if (leaveConfirmOpen)
            {
                <ConfirmDialog Title="Leave group" Message="@leaveConfirmMessage" ConfirmText="Leave" CancelText="Cancel"
                               OnConfirm="ConfirmLeaveGroup" OnCancel="() => leaveConfirmOpen = false" />
            }

            @* ---- Emergency Broadcast Modal ---- *@
            @if (emergencyConfirmOpen)
            {
                <div class="backdrop on" @onclick="() => emergencyConfirmOpen = false"></div>
                <div class="cm-center">
                    <div class="em-card">
                        <div class="em-head">
                            <i data-lucide="alert-triangle" class="em-icon"></i>
                            <h3 class="em-title">Emergency Broadcast</h3>
                        </div>
                        <p class="em-desc">This message will be sent to ALL members regardless of mute settings.</p>
                        <textarea class="input-wrap em-textarea" placeholder="Type emergency message..." @bind="emergencyContent"></textarea>
                        <div class="em-actions">
                            <button class="comp-btn" @onclick="() => emergencyConfirmOpen = false">Cancel</button>
                            <button class="cm-btn danger" @onclick="SendEmergency">Send Emergency</button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            @* ---- Empty state ---- *@
            <div class="empty-state chat-empty">
                <span class="ce-glyph"><i data-lucide="message-circle"></i></span>
                <div class="title">No conversation selected</div>
                <div class="sub">Pick a chat from the list, or start a new one.</div>
                <div class="empty-acts">
                    <button type="button" class="ghost mobile-only" @onclick="() => mobileRoomsOpen = true">
                        <i data-lucide="list"></i> Browse conversations
                    </button>
                    <button type="button" class="ce-primary" @onclick="StartNewDm"><i data-lucide="square-pen"></i> New message</button>
                    <button type="button" @onclick="StartNewGroup"><i data-lucide="users"></i> New group</button>
                </div>
            </div>
        }
    </div>

    @* ---- v6 global drawer: pinned / saved / search / mentions, beside the conversation ---- *@
    @if (globalDrawerView is not null)
    {
        <div class="chat-global-backdrop on" @onclick="CloseGlobalDrawer"></div>
        <aside class="chat-global-drawer" role="complementary" aria-label="@GlobalDrawerTitle">
            <div class="cgd-header">
                <i data-lucide="@GlobalDrawerIcon" class="cgd-ic"></i>
                <span class="cgd-title">@GlobalDrawerTitle</span>
                <button type="button" class="cgd-close" title="Close" aria-label="Close @GlobalDrawerTitle" @onclick="CloseGlobalDrawer">
                    <i data-lucide="x"></i>
                </button>
            </div>

            @if (globalDrawerView == GlobalDrawerView.Search)
            {
                <div class="cgd-search">
                    <i data-lucide="search"></i>
                    <input type="text" placeholder="Search keywords across all chat rooms…"
                           @bind="globalSearchQuery" @bind:event="oninput" @bind:after="OnGlobalSearchInput" />
                    @if (globalSearching)
                    {
                        <i data-lucide="loader-circle" class="cgd-spin"></i>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(GlobalDrawerHint))
            {
                <div class="cgd-hint">@GlobalDrawerHint</div>
            }

            <div class="cgd-body">
                @if (globalDrawerView == GlobalDrawerView.Pinned)
                {
                    @* Same panel as the room drawer's Pinned view; the sidebar entry defaults to All. *@
                    <PinnedPanel RoomId="@(ChatSvc.ActiveRoom?.Id ?? Guid.Empty)"
                                 IsOpen="true"
                                 Items="pinnedMessages"
                                 CanUnpin="CanUnpin"
                                 Scope="PinnedPanel.PinnedScope.All"
                                 OnJumpTo="JumpToMessageFromGlobalPinned"
                                 OnOpenPin="OpenPinFromPanel"
                                 OnChanged="LoadPinnedMessagesAsync" />
                }
                else if (globalDrawerLoading)
                {
                    <div class="cgd-empty"><i data-lucide="loader-circle" class="cgd-spin"></i><span>Loading…</span></div>
                }
                else if (globalDrawerError is not null)
                {
                    <div class="cgd-empty">
                        <i data-lucide="circle-alert"></i>
                        <span>@globalDrawerError</span>
                        <button type="button" class="cgd-retry" @onclick="LoadGlobalDrawerAsync">Try again</button>
                    </div>
                }
                else if (globalDrawerCards.Count == 0)
                {
                    <div class="cgd-empty"><i data-lucide="@GlobalDrawerIcon"></i><span>@GlobalDrawerEmptyText</span></div>
                }
                else
                {
                    @foreach (var card in globalDrawerCards)
                    {
                        var c = card;
                        <div class="cgd-card" role="button" tabindex="0" @onclick="() => OpenGlobalCard(c)" @onkeydown="e => OnGlobalCardKey(c, e)">
                            <span class="cgd-av" style="background:@c.Color">@c.Initials</span>
                            <div class="cgd-main">
                                <div class="cgd-top">
                                    <span class="cgd-sender">@c.SenderName</span>
                                    <span class="cgd-room">@c.RoomLabel</span>
                                    <span class="cgd-when">@FormatTime(c.When)</span>
                                </div>
                                <div class="cgd-text">@c.Text</div>
                            </div>
                            @if (c.ActionLabel is not null)
                            {
                                <button type="button" class="cgd-action" title="@c.ActionLabel" aria-label="@($"{c.ActionLabel} this message")"
                                        @onclick="() => GlobalCardAction(c)" @onclick:stopPropagation>
                                    <i data-lucide="x"></i>
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </aside>
    }
</div>

@* ---- Attachment viewer ---- *@
<AttachmentViewer Attachment="viewerAttachment" Siblings="viewerSiblings"
                  OnNavigate="a => viewerAttachment = a"
                  OnClose="CloseAttachment" />

@* ---- Ctrl+K Quick Switcher ---- *@
@if (qsOpen)
{
    <div class="quick-switcher" @onclick="CloseQuickSwitcher">
        <div class="qs-panel" @onclick:stopPropagation>
            <div class="qs-input-row">
                <i data-lucide="search"></i>
                <input @ref="qsInputRef" type="text" placeholder="Jump to a conversation..." value="@qsQuery" @oninput="OnQsInput" @onkeydown="OnQsKey" />
                <span class="qs-kbd">ESC</span>
            </div>
            <div class="qs-list">
                @{
                    var matches = QsMatches.ToList();
                    var direct = matches.Where(m => m.IsDirect).ToList();
                    var groups = matches.Where(m => !m.IsDirect).ToList();
                }
                @if (direct.Any())
                {
                    <div class="qs-section">Direct</div>
                    @for (int i = 0; i < direct.Count; i++)
                    {
                        var m = direct[i];
                        var idx = matches.IndexOf(m);
                        <button type="button" class="qs-row @(idx == qsSel ? "sel" : "")" @onclick="() => OpenFromQs(m.Room)">
                            <div class="avatar @(m.Room.Type == "dm" ? "round" : "")" style="background:@GetRoomColor(m.Room)">@GetRoomInitials(m.Room)</div>
                            <div class="qs-name">@m.Room.Name</div>
                            @if (m.Room.UnreadCount > 0)
                            {
                                <span class="qs-unread">@m.Room.UnreadCount</span>
                            }
                        </button>
                    }
                }
                @if (groups.Any())
                {
                    <div class="qs-section">Groups</div>
                    @for (int i = 0; i < groups.Count; i++)
                    {
                        var m = groups[i];
                        var idx = matches.IndexOf(m);
                        <button type="button" class="qs-row @(idx == qsSel ? "sel" : "")" @onclick="() => OpenFromQs(m.Room)">
                            <div class="avatar" style="background:@GetRoomColor(m.Room)">@GetRoomInitials(m.Room)</div>
                            <div class="qs-name">@m.Room.Name</div>
                            @if (m.Room.UnreadCount > 0)
                            {
                                <span class="qs-unread">@m.Room.UnreadCount</span>
                            }
                        </button>
                    }
                }
                @if (!matches.Any())
                {
                    <div class="qs-empty">No matches. Try a different name.</div>
                }
            </div>
            <div class="qs-foot">
                <span class="qs-hint"><span class="qs-kbd">↑↓</span> navigate</span>
                <span class="qs-hint"><span class="qs-kbd">↵</span> open</span>
                <span class="qs-hint"><span class="qs-kbd">ESC</span> close</span>
            </div>
        </div>
    </div>
}

@* ---- Context Menu ---- *@
@* Sticker editor modal: "+ Create" in the picker and "Make sticker" on chat images. *@
<StickerEditor @ref="stickerEditor" OnSaved="OnStickerEditorSaved" />

@if (ctxMsgId is not null)
{
    <div class="ctx-menu-backdrop" @onclick="CloseCtx" @oncontextmenu="CloseCtx" @oncontextmenu:preventDefault></div>
    <div class="ctx-menu on" @ref="ctxMenuRef" style="position:fixed;top:@(ctxY)px;left:@(ctxX)px;z-index:9999" @onclick:stopPropagation>
        <button @onclick="() => StartReply(ctxMsgId.Value)"><i data-lucide="reply"></i> Reply</button>
        @if (CanEditMsg(ctxMsgId.Value))
        {
            <button @onclick="() => StartEdit(ctxMsgId.Value)"><i data-lucide="pencil"></i> Edit</button>
        }
        @{ var ctxMsg = ChatSvc.ActiveMessages.FirstOrDefault(m => m.Id == ctxMsgId.Value); }
        @if (ctxMsg is not null && !string.IsNullOrEmpty(ctxMsg.Content) && !IsAttachmentPlaceholder(ctxMsg))
        {
            <button @onclick="async () => { var t = ctxMsg.Content; ctxMsgId = null; await CopyMessageText(t); }"><i data-lucide="copy"></i> Copy text</button>
        }
        @if (ctxMsg is not null && ctxMsg.Type == "sticker" && !ctxMsg.IsDeleted && StickerLimits.IsValidKey(ctxMsg.Content))
        {
            var ctxKey = ctxMsg.Content;
            var ctxFav = ChatSvc.IsStickerFavorite(ctxKey);
            <button @onclick="() => ToggleStickerFavorite(ctxKey, !ctxFav)"><i data-lucide="@(ctxFav ? "star-off" : "star")"></i> @(ctxFav ? "Remove from favorites" : "Add to favorites")</button>
        }
        @if (ctxMsg is not null && StickerLimits.CustomId(ctxMsg.Type, ctxMsg.Content) is { } ctxSticker)
        {
            @if (!ChatSvc.IsStickerMine(ctxSticker))
            {
                <button @onclick="() => SaveStickerFromMessage(ctxSticker)"><i data-lucide="sticker"></i> Add to my stickers</button>
            }
            @if (Auth.IsAdmin)
            {
                var official = ChatSvc.Stickers.Official.Any(s => s.Id == ctxSticker);
                <button @onclick="() => SetStickerOfficial(ctxSticker, !official)"><i data-lucide="@(official ? "badge-minus" : "badge-check")"></i> @(official ? "Remove from official" : "Make official")</button>
            }
        }
        @if (ctxMsg is not null && ctxMsg.Attachments.FirstOrDefault(IsStickerableImage) is { } ctxImage)
        {
            <button @onclick="() => MakeStickerFromAttachment(ctxImage)"><i data-lucide="sticker"></i> Make sticker</button>
        }
        <button @onclick="() => StartForward(ctxMsgId.Value)"><i data-lucide="forward"></i> Forward</button>
        <button @onclick="() => SaveMessage(ctxMsgId.Value)"><i data-lucide="bookmark"></i> Save</button>
        @if (CanTogglePin(ctxMsgId.Value))
        {
            <button @onclick="() => PinMessage(ctxMsgId.Value)"><i data-lucide="@(IsMsgPinned(ctxMsgId.Value) ? "pin-off" : "pin")"></i> @(IsMsgPinned(ctxMsgId.Value) ? "Unpin" : "Pin")</button>
        }
        <button @onclick="() => QuickReact(ctxMsgId.Value, LikeEmoji)"><i data-lucide="thumbs-up"></i> Like</button>
        <button class="danger" @onclick="() => ConfirmDelete(ctxMsgId.Value)"><i data-lucide="trash-2"></i> Delete</button>
    </div>
}
