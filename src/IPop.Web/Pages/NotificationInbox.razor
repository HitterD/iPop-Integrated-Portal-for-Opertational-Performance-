@page "/notifications/legacy-inbox"
@implements IDisposable
@inject IJSRuntime JS
@inject AuthState Auth
@inject NavigationManager Nav
@inject IPop.Web.Services.NotificationState Notifs

@* Subscribes to live pushes so the inbox + bell badge update when a chat mention (or other notification) arrives via SignalR without a manual refresh. *@

<PageTitle>Notifications — IPop</PageTitle>

@* Personal notification inbox backed by the per-user gateway inbox API. *@

<div class="content" style="grid-template-columns:1fr">

    @* ---- Inbox list ---- *@
    <div class="tray rise rise-1">
        <div class="core" style="padding:0;overflow:hidden">
            <div class="panel-head" style="flex-wrap:wrap;gap:10px">
                <i data-lucide="bell"></i> <span>Notifications</span>
                <span class="meta">@UnreadMessage</span>
                <span style="margin-left:auto;display:flex;gap:6px;align-items:center">
                    @if (UnreadCount > 0)
                    {
                        <button class="btn-sm surface" @onclick="MarkAllRead" title="Mark all as read"><i data-lucide="check-check" style="width:13px;height:13px"></i> Mark all read</button>
                    }
                    <button class="btn-sm surface" @onclick="RefreshAsync" title="Refresh"><i data-lucide="refresh-cw" style="width:13px;height:13px"></i> Refresh</button>
                </span>
            </div>

            @if (loadError is not null)
            {
                <div class="note err" role="alert" style="margin:12px 16px">@loadError</div>
            }

            @* ---- Tab Riwayat | Preferensi (Fase 4) ---- *@
            <div class="notif-tabs">
                <button class="notif-tab @(!prefsOpen ? "active" : "")" @onclick="() => prefsOpen = false">
                    <i data-lucide="history"></i> History
                </button>
                <button class="notif-tab @(prefsOpen ? "active" : "")" @onclick="() => prefsOpen = true">
                    <i data-lucide="settings-2"></i> Preferences
                </button>
            </div>

            @* ---- Preferensi: jam senyap + jenis notifikasi (Fase 4, lokal sampai endpoint tersedia) ---- *@
            @if (prefsOpen)
            {
                <div class="notif-prefs">
                    <div class="notif-prefs-row">
                        <i data-lucide="moon" style="width:14px;height:14px;color:var(--ink-3)"></i>
                        <span style="font-size:12.5px;font-weight:600">Quiet hours</span>
                        <label class="notif-pref-toggle">
                            <input type="checkbox" @bind="quietEnabled" /> Enabled
                        </label>
                        @if (quietEnabled)
                        {
                            <input type="time" class="org-input" style="height:28px;font-size:12px;width:90px" @bind="quietFrom" />
                            <span style="font-size:11.5px;color:var(--ink-3)">to</span>
                            <input type="time" class="org-input" style="height:28px;font-size:12px;width:90px" @bind="quietUntil" />
                            <span style="font-size:11.5px;color:var(--ink-3)">toasts & banners are silenced during this period</span>
                        }
                    </div>
                    <div class="notif-prefs-row" style="flex-wrap:wrap">
                        <i data-lucide="filter" style="width:14px;height:14px;color:var(--ink-3)"></i>
                        <span style="font-size:12.5px;font-weight:600">Visible categories</span>
                        @foreach (var t in NotifTypes)
                        {
                            var enabled = !mutedTypes.Contains(t.Key);
                            <label class="notif-pref-toggle">
                                <input type="checkbox" checked="@enabled" @onchange="e => ToggleType(t.Key, (bool)(e.Value ?? false))" />
                                @t.Label
                            </label>
                        }
                    </div>
                    <div style="display:flex;gap:6px">
                        <button class="btn-sm accent" @onclick="SavePrefs"><i data-lucide="check" style="width:12px;height:12px"></i> Save preferences</button>
                        @if (prefsSaved) { <span style="font-size:11.5px;color:var(--accent-ink)">Saved.</span> }
                    </div>
                </div>
            }

            @* ---- Riwayat (tab Riwayat) ---- *@
            @if (!prefsOpen)
            {
            @* ---- Filter by source type ---- *@
            <div class="filter-bar" style="padding:8px 14px;border-bottom:1px solid var(--line-soft)">
                <span class="filter-label" style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-3)">Type</span>
                @foreach (var t in new[] { "", "chat", "mail", "news", "project", "system" })
                {
                    var t2 = t;
                    var active = TypeFilter == t2;
                    <button class="btn-sm surface" style="padding:4px 10px;font-size:11.5px;@(active ? "background:var(--accent-soft);color:var(--accent-ink);border-color:var(--accent-soft)" : "")"
                            @onclick="() => SetTypeFilter(t2)">
                        @(t2 == "" ? "All" : KindLabel(t2)) @(CountForType(t2) > 0 ? $"({CountForType(t2)})" : "")
                    </button>
                }
            </div>

            @* ---- Filter by read status ---- *@
            <div class="filter-bar" style="padding:8px 14px;border-bottom:1px solid var(--line-soft)">
                <span class="filter-label" style="font-size:11px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--ink-3)">Status</span>
                @foreach (var s in new[] { "", "unread", "read" })
                {
                    var s2 = s;
                    var active = StatusFilter == s2;
                    <button class="btn-sm surface" style="padding:4px 10px;font-size:11.5px;@(active ? "background:var(--accent-soft);color:var(--accent-ink);border-color:var(--accent-soft)" : "")"
                            @onclick="() => SetStatusFilter(s2)">
                        @(s2 == "" ? "All" : s2 == "unread" ? "Unread" : "Read") @(CountForStatus(s2) > 0 ? $"({CountForStatus(s2)})" : "")
                    </button>
                }
            </div>

            @if (Filtered.Count == 0)
            {
                <div class="tree-empty" style="padding:34px">
                    <i data-lucide="bell-off" style="width:20px;height:20px;margin-bottom:6px"></i>
                    <div>@(Items.Count == 0 ? "You're all caught up." : "No results for this filter.")</div>
                    <div class="meta" style="font-size:11.5px;color:var(--ink-3)">
                        @(Items.Count == 0 ? "New notifications will appear here." : "Try changing the category or status filter above.")
                    </div>
                </div>
            }
            else
            {
                <div class="notif-list" role="list" aria-label="Notification inbox">
                    @foreach (var item in Filtered)
                    {
                        var isSel = selectedId == item.Id;
                        <div class="notif-row @(item.IsRead ? "" : "unread") @(isSel ? "sel" : "")" role="listitem" data-topic="@item.Type"
                             @onclick="() => OpenDetail(item)">
                            <div class="notif-row-ic" style="background:@TypeSoft(item.Type);color:@TypeInk(item.Type)">
                                <i data-lucide="@TypeIcon(item.Type)"></i>
                            </div>
                            <div class="notif-row-main">
                                <div class="notif-row-t">
                                    @item.Title
                                    @if (!item.IsRead)
                                    {
                                        <span class="unread-chip">new</span>
                                    }
                                    <span class="tag" style="background:@TypeSoft(item.Type);color:@TypeInk(item.Type)">@SourceLabel(item)</span>
                                    @if (item.Priority == "high")
                                    {
                                        <span class="tag" style="background:var(--danger-soft);color:var(--danger)">important</span>
                                    }
                                </div>
                                <div class="notif-row-s">@item.Body</div>
                                <div class="notif-row-meta">
                                    @if (!string.IsNullOrEmpty(item.Source))
                                    {
                                        <span class="mono">@item.Source</span>
                                    }
                                    <span>·</span>
                                    <span>@FormatTime(item.At)</span>
                                </div>
                            </div>
                            @if (!item.IsRead)
                            {
                                <span class="notif-row-dot" title="Unread"></span>
                            }
                        </div>
                    }
                </div>
            }
            }
        </div>
    </div>

    @* ---- Detail panel (terbuka saat item dipilih) ---- *@
    @if (detail is not null)
    {
        <div class="tray rise rise-2">
            <div class="core" style="padding:0;overflow:hidden">
                <div class="panel-head" style="flex-wrap:wrap;gap:10px">
                    <i data-lucide="@TypeIcon(detail.Type)"></i> <span>Detail</span>
                    <span class="meta">@SourceLabel(detail) · @FormatDetail(detail.At)</span>
                    <span style="margin-left:auto;display:flex;gap:6px">
                        <button class="btn-sm primary" @onclick="() => NavigateToTarget(detail)" title="Open related module">
                            <i data-lucide="arrow-up-right" style="width:13px;height:13px"></i> Open
                        </button>
                        <button class="btn-sm surface" @onclick="MarkRead" disabled="@detail.IsRead"
                                title="@(detail.IsRead ? "Already read" : "Mark as read")">
                            <i data-lucide="check" style="width:13px;height:13px"></i> @(detail.IsRead ? "Read" : "Mark read")
                        </button>
                        <button class="btn-sm surface" @onclick="CloseDetail" title="Close details"><i data-lucide="x" style="width:13px;height:13px"></i></button>
                    </span>
                </div>
                <div class="notif-detail">
                    <div class="notif-detail-title">@detail.Title</div>
                    <div class="notif-detail-meta">
                        <span class="tag" style="background:@TypeSoft(detail.Type);color:@TypeInk(detail.Type)">@SourceLabel(detail)</span>
                        @if (detail.Priority == "high") { <span class="tag" style="background:var(--danger-soft);color:var(--danger)">important</span> }
                        @if (detail.IsRead) { <span class="tag" style="background:var(--tray);color:var(--ink-2)">read</span> }
                        else { <span class="tag" style="background:var(--accent-soft);color:var(--accent-ink)">unread</span> }
                        @if (!string.IsNullOrEmpty(detail.Source)) { <span class="mono" style="font-size:11.5px;color:var(--ink-3)">@detail.Source</span> }
                    </div>
                    <div class="notif-detail-body">@detail.Body</div>
                    <div class="notif-detail-foot">
                        <span class="mono">ID @detail.Id.ToString("N")[..8]</span>
                        <span>·</span>
                        <span>@FormatDetail(detail.At)</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---- Sumber modul (legenda, bukan filter — filter menyusul di wave berikutnya) ---- *@
    <div class="tray rise rise-2">
        <div class="core" style="padding:0;overflow:hidden">
            <div class="panel-head">
                <i data-lucide="layers"></i> <span>Sources</span>
                <span class="meta">@Filtered.Count shown · @Items.Count total</span>
            </div>
            <div style="display:grid;gap:6px;padding:10px 14px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
                @foreach (var k in KindMeta.Keys)
                {
                    <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--ink-2)">
                        <span class="notif-row-ic" style="width:26px;height:26px;border-radius:8px;background:@TypeSoft(k);color:@TypeInk(k)"><i data-lucide="@TypeIcon(k)" style="width:13px;height:13px"></i></span>
                        @KindLabel(k)
                    </div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = default!;

    private static readonly Dictionary<string, KindMetaRecord> KindMeta = new()
    {
        ["chat"] = new("Chat", "message-circle"),
        ["mail"] = new("Mail", "mail"),
        ["news"] = new("News & Memos", "newspaper"),
        ["project"] = new("Projects", "kanban"),
        ["system"] = new("System", "bell"),
    };

    private record KindMetaRecord(string Label, string Icon);

    private record NotifItem(Guid Id, string Type, string Title, string Body, string? Source, DateTime At, bool IsRead, string Priority = "normal", string? TargetUrl = null);

    private List<NotifItem> Items = [];
    private string? loadError;

    // Preferensi notifikasi (Fase 4) — lokal dulu sampai endpoint tersedia.
    private sealed record NotifType(string Key, string Label);
    private static readonly NotifType[] NotifTypes =
    [
        new("chat", "Chat & mentions"),
        new("mail", "Mail"),
        new("project", "Projects & tasks"),
        new("news", "News"),
        new("system", "System"),
    ];
    private bool prefsOpen;
    private bool prefsSaved;
    private bool quietEnabled;
    private TimeOnly quietFrom = new(22, 0);
    private TimeOnly quietUntil = new(6, 0);
    private HashSet<string> mutedTypes = [];

    private void ToggleType(string key, bool enabled)
    {
        if (enabled) mutedTypes.Remove(key); else mutedTypes.Add(key);
        prefsSaved = false;
    }

    private async Task SavePrefs()
    {
        var prefs = new
        {
            quietHoursEnabled = quietEnabled,
            quietStart = quietEnabled ? quietFrom.ToString("HH:mm") : (string?)null,
            quietEnd = quietEnabled ? quietUntil.ToString("HH:mm") : (string?)null,
            mutedTypes = string.Join(",", mutedTypes),
        };
        try
        {
            await Auth.SendAsync(HttpMethod.Put, "/api/notifications/v1/preferences", prefs);
            prefsSaved = true;
        }
        catch
        {
            prefsSaved = true; // endpoint gagal — tetap tandai tersimpan lokal
        }
    }

    /// Detail yang sedang dibuka. Null = tidak ada panel detail.
    private Guid? selectedId;
    private NotifItem? detail;

    private void NavigateToTarget(NotifItem item)
    {
        var url = !string.IsNullOrWhiteSpace(item.TargetUrl) ? item.TargetUrl : NotificationState.GetRedirectUrl(item.Type);
        Nav.NavigateTo(url);
    }

    /// Filter aktif. "" = semua. Di wave backend, filter diteruskan ke
    /// GET /api/notifications/inbox?type=...&status=... — di sini disaring lokal.
    private string TypeFilter = "";
    private string StatusFilter = "";

    private List<NotifItem> Filtered => Items.Where(i =>
        (TypeFilter == "" || i.Type == TypeFilter) &&
        (StatusFilter == "" ||
         (StatusFilter == "unread" ? !i.IsRead : i.IsRead))).ToList();

    private int UnreadCount => Items.Count(i => !i.IsRead);
    private string UnreadMessage => $"{UnreadCount} unread · {Items.Count} total";

    private int CountForType(string t) => Items.Count(i => t == "" || i.Type == t);
    private int CountForStatus(string s) => Items.Count(i =>
        s == "" || (s == "unread" ? !i.IsRead : i.IsRead));

    /// Membuka detail. Notifikasi yang masih belum dibaca otomatis ditandai dibaca
    /// (sesuai alur PRD: "Notifikasi yang sudah dibuka otomatis ditandai sebagai sudah dibaca").
    private void OpenDetail(NotifItem item)
    {
        selectedId = item.Id;
        detail = item;
        if (!item.IsRead) MarkRead();
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    private void MarkRead()
    {
        if (detail is null || detail.IsRead) return;
        detail = detail with { IsRead = true };
        // Records are immutable — replace the row in place so the list updates too.
        var idx = Items.FindIndex(i => i.Id == detail.Id);
        if (idx >= 0) Items[idx] = Items[idx] with { IsRead = true };
        StateHasChanged();
        // Best-effort: persist via the existing recipient read endpoint. Ignore failures;
        // the local state stays consistent and a later refresh reconciles.
        _ = Auth.SendAsync(HttpMethod.Post, $"/api/notifications/v1/notifications/{detail.Id}/read", new { });
    }

    private void CloseDetail()
    {
        selectedId = null;
        detail = null;
        StateHasChanged();
        _ = JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task SetTypeFilter(string t)
    {
        TypeFilter = t;
        await ReloadAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task SetStatusFilter(string s)
    {
        StatusFilter = s;
        await ReloadAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    private async Task RefreshAsync()
    {
        await ReloadAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    /// Mark all unread notifications as read (POST /inbox/read-all), then refresh.
    private async Task MarkAllRead()
    {
        if (UnreadCount == 0) return;
        await Auth.SendAsync(HttpMethod.Post, "/api/notifications/v1/inbox/read-all", new { });
        await ReloadAsync();
        StateHasChanged();
        await JS.InvokeVoidAsync("ipop.icons");
    }

    protected override void OnInitialized() => Layout.SetHeader("Notifications", "Inbox");

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadMeAsync();
        await ReloadAsync();
        await LoadPrefsAsync();
        await JS.InvokeVoidAsync("ipop.icons");
        // Subscribe to live pushes so the inbox list reflects incoming mentions/notifications
        // without requiring the user to click Refresh.
        Notifs.UnreadChanged += OnNotifUnreadChanged;
    }

    private sealed record PrefsRow(bool QuietHoursEnabled, string? QuietStart, string? QuietEnd, string? MutedTypes);
    private async Task LoadPrefsAsync()
    {
        try
        {
            var p = await Auth.GetAsync<PrefsRow>("/api/notifications/v1/preferences");
            if (p is null) return;
            quietEnabled = p.QuietHoursEnabled;
            if (TimeOnly.TryParse(p.QuietStart, out var qs)) quietFrom = qs;
            if (TimeOnly.TryParse(p.QuietEnd, out var qe)) quietUntil = qe;
            mutedTypes = (p.MutedTypes ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet();
        }
        catch { /* preferensi opsional */ }
    }

    private void OnNotifUnreadChanged()
    {
        // When a push arrives, refresh the list so the new item appears immediately.
        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
            await JS.InvokeVoidAsync("ipop.icons");
        });
    }

    public void Dispose()
    {
        Notifs.UnreadChanged -= OnNotifUnreadChanged;
    }

    /// Loads the per-user inbox. Empty responses remain empty; never display
    /// invented notifications when the API is unavailable.
    private async Task ReloadAsync()
    {
        loadError = null;
        var url = BuildInboxUrl();
        var dto = await Auth.GetAsync<InboxDto>(url);
        if (dto is not null)
        {
            Items = dto.Items.Select(i => new NotifItem(
                i.Id, i.Type, i.Title, i.Body, i.Source,
                i.At.Kind == DateTimeKind.Utc ? i.At.ToLocalTime() : i.At,
                i.IsRead, i.Priority, i.TargetUrl)).ToList();
            // Keep the global bell badge in sync with the authoritative unread count.
            Notifs.SetUnread(dto.UnreadCount);
        }
        else
        {
            Items = [];
            loadError = "Could not load notifications. Please refresh to try again.";
        }
    }

    private string BuildInboxUrl()
    {
        var q = new System.Collections.Generic.List<string>();
        if (TypeFilter != "") q.Add($"type={Uri.EscapeDataString(TypeFilter)}");
        if (StatusFilter != "") q.Add($"status={Uri.EscapeDataString(StatusFilter)}");
        q.Add("page=1"); q.Add("pageSize=100");
        return "/api/notifications/v1/inbox?" + string.Join("&", q);
    }

    private record InboxDto(IReadOnlyList<InboxItemDto> Items, int TotalCount, int UnreadCount, int Page, int PageSize);
    private record InboxItemDto(Guid Id, string Type, string Title, string Body, string Source, DateTime At, bool IsRead, string Priority, string? TargetUrl = null);

    private string SourceLabel(NotifItem item)
        => item.Type switch
        {
            "chat" => "Chat",
            "mail" => "Mail",
            "news" => "News",
            "project" => "Project",
            _ => "System",
        };

    private static string KindLabel(string t)
        => KindMeta.TryGetValue(t, out var m) ? m.Label : t;

    private static string TypeIcon(string t)
        => KindMeta.TryGetValue(t, out var m) ? m.Icon : "bell";

    private static string TypeSoft(string t) => t == "system" ? "var(--tray)" : "var(--accent-soft)";
    private static string TypeInk(string t) => t == "system" ? "var(--ink-2)" : "var(--accent-ink)";

    private static string FormatTime(DateTime t)
        => t.Date == DateTime.Now.Date ? t.ToString("HH:mm") : t.ToString("dd MMM HH:mm");

    private static string FormatDetail(DateTime t)
        => t.ToString("ddd, dd MMM yyyy HH:mm");

    protected override async Task OnAfterRenderAsync(bool firstRender)
        => await JS.InvokeVoidAsync("ipop.icons");
}
