<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Production host for the IPop.Web WebAssembly client. Replaces the Blazor DevServer
       (pentest H-01/H-03/H-04): no .pdb files, no Server/"Blazor-Environment: Development"
       headers, and CSP / framing / nosniff / HSTS on every response. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IPop.Web\IPop.Web.csproj" />
  </ItemGroup>

</Project>
