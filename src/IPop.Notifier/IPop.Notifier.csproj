<Project Sdk="Microsoft.NET.Sdk">

  <!-- iPop Notifier: Windows tray app (docs/notifier/PLAN.md, mockups docs/mockups/notifier). Per-user install,
       no admin rights. UI inside windows is HTML rendered by one shared WebView2 environment. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>iPopNotifier</AssemblyName>
    <RootNamespace>IPop.Notifier</RootNamespace>
    <ApplicationIcon>Assets\ipop.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Canonical release version. Scripts read this default; -Version overrides both build and packaging. -->
    <Version>1.4.1</Version>
    <Product>iPop Notifier</Product>
    <AssemblyTitle>iPop Notifier</AssemblyTitle>
    <Company>PT Santos Jaya Abadi</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefineConstants Condition="'$(Trial)' == 'true'">$(DefineConstants);TRIAL</DefineConstants>
    <!-- Keep the install light: English only, no symbol helper; the per-user install is then ~70 MB on disk
         and the Velopack package compresses to ~35 MB (updates ship as small deltas). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Served to WebView2 through a virtual host (https://notifier.ipop/) mapped onto the app folder. -->
    <Content Include="Ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Same settings model as the server (ui-prefs key "notifier"), so both normalise identically. -->
    <Compile Include="..\IPop.Application\Notifier\NotifierSettings.cs" Link="Core\NotifierSettings.cs" />
    <!-- When a downloaded update is offered / installed (tested in IPop.Tests). -->
    <Compile Include="..\IPop.Application\Notifier\NotifierUpdatePolicy.cs" Link="Core\NotifierUpdatePolicy.cs" />
    <Compile Include="..\IPop.Application\Notifier\NotifierUpdateState.cs" Link="Core\NotifierUpdateState.cs" />
  </ItemGroup>

</Project>
